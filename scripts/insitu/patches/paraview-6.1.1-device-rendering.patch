+bool vtkOpenGLBufferObject::UploadDevice(const void* pointer, size_t bytes, ObjectType type)
+{
+#ifdef ASTR_VTK_DEVICE_RENDERING
+  cudaPointerAttributes attributes{};
+  int device = -1;
+  auto status = cudaPointerGetAttributes(&attributes, pointer);
+  if (!pointer || !bytes || status != cudaSuccess || cudaGetDevice(&device) != cudaSuccess ||
+    attributes.type != cudaMemoryTypeDevice || attributes.device != device)
+  {
+    this->Error = "CUDA display buffer must reside on the current device";
+    return false;
+  }
+  if (!this->Internal->Handle || this->GetType() != type || this->Internal->Size < bytes)
+  {
+    if (!this->Allocate(bytes, type, DynamicDraw))
+    {
+      return false;
+    }
+  }
+  if (!this->Internal->CudaResource)
+  {
+    status = cudaGraphicsGLRegisterBuffer(&this->Internal->CudaResource,
+      this->Internal->Handle, cudaGraphicsRegisterFlagsWriteDiscard);
+    if (status != cudaSuccess)
+    {
+      this->Error = cudaGetErrorString(status);
+      return false;
+    }
+  }
+  status = cudaGraphicsMapResources(1, &this->Internal->CudaResource);
+  if (status != cudaSuccess)
+  {
+    this->Error = cudaGetErrorString(status);
+    return false;
+  }
+  void* destination = nullptr;
+  size_t capacity = 0;
+  status = cudaGraphicsResourceGetMappedPointer(&destination, &capacity, this->Internal->CudaResource);
+  if (status == cudaSuccess && capacity >= bytes && destination)
+  {
+    status = cudaMemcpy(destination, pointer, bytes, cudaMemcpyDeviceToDevice);
+  }
+  else if (status == cudaSuccess)
+  {
+    status = cudaErrorInvalidValue;
+  }
+  const auto unmap = cudaGraphicsUnmapResources(1, &this->Internal->CudaResource);
+  if (status != cudaSuccess || unmap != cudaSuccess)
+  {
+    this->Error = cudaGetErrorString(status != cudaSuccess ? status : unmap);
+    return false;
+  }
+  this->Dirty = false;
+  return true;
+#else
+  (void)pointer;
+  (void)bytes;
+  (void)type;
+  this->Error = "CUDA device rendering was not built";
+  return false;
+#endif
+}
