&case_options
  flowtype = 'air5hbl'
  ltimrpt = .true.
  use_gpu = .true.
  iomode = 'h'
/

&mesh
  ia = 31
  ja = 63
  ka = 15
  lihomo = .false.
  ljhomo = .false.
  lkhomo = .true.
  lreadgrid = .false.
  lfftk = .false.
  gridfile = 'datin/grid.h5'
/

&physics
  nondimen = .false.
  diffterm = .true.
  lcomb = .true.
  ref_tem = 1500.d0
  ref_vel = 3.11235677152851986d3
  ref_len = 3.75482142813887026d-4
  ref_den = 4.62486717815898674d-2
  num_species = 5
  turbmode = 'none'
/

&numerics
  lfilter = .true.
  alfa_filter = 0.49d0
  kcutoff = 48
  conschm = '643e'
  difschm = '643e'
  rkscheme = 'rk3'
  recon_schem = 3
  lchardecomp = .false.
  bfacmpld = 0.3d0
  shkcrt = 0.05d0
/

&boundary
  bctype = 11, 50, 41, 51, 1, 1
  twall = 0, 0, 3000.d0, 0, 0, 0
  turbinf = 'free'
/

&initialization
  limmbou = .false.
  lrestart = .false.
  ninit = 0
/

&sponge
  spg_i0 = 0
  spg_im = 0
  spg_j0 = 0
  spg_jm = 0
  spg_k0 = 0
  spg_km = 0
  spg_def = 'layer'
/

&species_transport
  schmidt = 1.d0, 1.d0, 1.d0, 1.d0, 1.d0
/

&chemistry
  source_mode = 'coupled'
  convection_limiter = 'symmetric_species'
  diffusion_limiter = 'layered'
  compensation = 'on'
  top_mode = 'prescribed'
/
