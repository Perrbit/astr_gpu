! Basic completed-step output for the nonreacting quickstart cases.
! Frequencies and budgets are startup examples, not production recommendations.
&output
 directory='outdat/output', buffer_bytes=4096,
 host_budget_bytes=67108864, device_budget_bytes=67108864
/
&checkpoint
 enabled=.true., mode='steps', interval_steps=100, keep=2
/
&volume
 enabled=.false.
/
&slices
 enabled=.false.
/
