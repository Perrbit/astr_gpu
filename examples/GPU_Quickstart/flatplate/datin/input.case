&case_options
  flowtype = 'bl'
  ltimrpt = .true.
  use_gpu = .true.
  iomode = 'h'
/

&mesh
  ia = 32
  ja = 64
  ka = 16
  lihomo = .false.
  ljhomo = .false.
  lkhomo = .true.
  lreadgrid = .true.
  lfftk = .false.
  gridfile = 'datin/grid.h5'
/

&physics
  nondimen = .true.
  diffterm = .true.
  lcomb = .false.
  ref_tem = 273.15d0
  reynolds = 1000.d0
  mach = 0.3d0
  num_species = 0
  turbmode = 'none'
/

&numerics
  lfilter = .true.
  alfa_filter = 0.49d0
  kcutoff = 48
  conschm = '543e'
  difschm = '643e'
  rkscheme = 'rk3'
  recon_schem = 3
  lchardecomp = .false.
  bfacmpld = 0.1d0
  shkcrt = 0.001d0
/

&boundary
  bctype = 11, 21, 41, 51, 1, 1
  twall = 0, 0, 1.d0, 0, 0, 0
  turbinf = 'prof'
  pout = 1
/

&initialization
  limmbou = .false.
  lrestart = .false.
  ninit = 0
/

&sponge
  spg_i0 = 0
  spg_im = 0
  spg_j0 = 0
  spg_jm = 0
  spg_k0 = 0
  spg_km = 0
  spg_def = 'layer'
/

&boundary_options
  profile_inflow_mode = 'complete_state'
/
