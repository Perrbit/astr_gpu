&case_options
  flowtype = 'airreactor'
  ltimrpt = .false.
  use_gpu = .false.
  iomode = 'h'
/

&mesh
  ia = 8
  ja = 8
  ka = 8
  lihomo = .true.
  ljhomo = .true.
  lkhomo = .true.
  lreadgrid = .false.
  lfftk = .false.
  gridfile = 'datin/grid.h5'
/

&physics
  nondimen = .false.
  diffterm = .false.
  lcomb = .true.
  ref_tem = 6000.d0
  ref_vel = 2.d0
  ref_len = 2.5d-4
  ref_den = 0.89785d0
  odetype = 'rk3'
  turbmode = 'none'
  chemfile = './datin/airNASA9noions_noc.yaml'
/

&numerics
  lfilter = .true.
  alfa_filter = 0.49d0
  kcutoff = 48
  conschm = '643e'
  difschm = '643e'
  rkscheme = 'rk3'
  recon_schem = 5
  lchardecomp = .true.
  bfacmpld = 0.3d0
  shkcrt = 0.03d0
/

&boundary
  bctype = 1, 1, 1, 1, 1, 1
  twall = 0, 0, 0, 0, 0, 0
/

&initialization
  limmbou = .false.
  lrestart = .false.
  ninit = 0
/

&sponge
  spg_i0 = 0
  spg_im = 0
  spg_j0 = 0
  spg_jm = 0
  spg_k0 = 0
  spg_km = 0
  spg_def = 'layer'
/
