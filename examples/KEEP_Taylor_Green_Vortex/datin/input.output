&output
  directory = 'outdat/new'
  restore_directory = ''
  exact_restart = .true.
  host_budget_bytes = -1
  device_budget_bytes = -1
  buffer_bytes = 67108864
/

&checkpoint
  enabled = .true.
  mode = 'steps'
  interval_steps = 2
  keep = 2
  initial_frame = .false.
/

&volume
  enabled = .false.
/

&slices
  enabled = .false.
/
