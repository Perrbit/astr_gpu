&case_options
  flowtype = 'tgv'
  ltimrpt = .true.
  use_gpu = .true.
  iomode = 'h'
/

&mesh
  ia = 16
  ja = 16
  ka = 16
  lihomo = .true.
  ljhomo = .true.
  lkhomo = .true.
  lreadgrid = .false.
  lfftk = .false.
/

&physics
  nondimen = .true.
  diffterm = .true.
  lcomb = .false.
  ref_tem = 273.15d0
  reynolds = 1600.d0
  mach = 0.1d0
  num_species = 0
  turbmode = 'none'
/

&numerics
  convection_form = 'standard'
  viscous_form = 'me6_opti'
  conschm = '543e'
  difschm = '643c'
  rkscheme = 'rk3'
  lfilter = .false.
  alfa_filter = 0.49d0
  kcutoff = 48
  recon_schem = 3
  lchardecomp = .false.
  bfacmpld = 0.3d0
  shkcrt = 0.05d0
/

&boundary
  bctype = 1, 1, 1, 1, 1, 1
  twall = 0, 0, 0, 0, 0, 0
/

&initialization
  limmbou = .false.
  lrestart = .false.
  ninit = 0
/

&sponge
  spg_i0 = 0
  spg_im = 0
  spg_j0 = 0
  spg_jm = 0
  spg_k0 = 0
  spg_km = 0
  spg_def = 'layer'
/

&precision_options
  gpu_precision_mode = 'fp64'
/
