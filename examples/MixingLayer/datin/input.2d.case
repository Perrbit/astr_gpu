&case_options
  flowtype = 'mixlayer'
  ltimrpt = .true.
  use_gpu = .false.
  iomode = 'h'
/

&mesh
  ia = 4050
  ja = 300
  ka = 0
  lihomo = .false.
  ljhomo = .false.
  lkhomo = .true.
  lreadgrid = .true.
  lfftk = .false.
  gridfile = './datin/grid.2d'
/

&physics
  nondimen = .true.
  diffterm = .true.
  lcomb = .false.
  ref_tem = 273.15d0
  reynolds = 1500.d0
  mach = 0.3d0
  num_species = 0
  turbmode = 'none'
/

&numerics
  lfilter = .true.
  alfa_filter = 0.49d0
  kcutoff = 48
  conschm = '643c'
  difschm = '643c'
  rkscheme = 'rk3'
  recon_schem = 5
  lchardecomp = .true.
  bfacmpld = 0.3d0
  shkcrt = 0.001d0
/

&boundary
  bctype = 11, 22, 52, 52, 1, 1
  twall = 0, 0, 0, 0, 0, 0
  turbinf = 'prof'
  pout = 1
/

&initialization
  limmbou = .false.
  lrestart = .false.
  ninit = 0
/

&sponge
  spg_i0 = 0
  spg_im = 20
  spg_j0 = 0
  spg_jm = 0
  spg_k0 = 0
  spg_km = 0
  spg_def = 'layer'
/
