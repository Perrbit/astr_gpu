&case_options
 flowtype='channel',ltimrpt=t,use_gpu=$use_gpu,iomode='h'
/
&mesh
 ia=$intervals,ja=$intervals,ka=$intervals,lihomo=t,ljhomo=f,lkhomo=t,
 lreadgrid=t,gridfile='datin/grid.h5',lfftk=f
/
&physics
 nondimen=t,diffterm=t,lcomb=f,ref_tem=273.15d0,reynolds=3000.d0,mach=.3d0,
 num_species=0,turbmode='none'
/
&numerics
 convection_form='keep',viscous_form='standard',conschm='643e',difschm='643e',
 rkscheme='rk3',lfilter=f,filter_scheme='explicit10',alfa_filter=.49d0,kcutoff=48,
 recon_schem=3,lchardecomp=f,bfacmpld=.3d0,shkcrt=.01d0
/
&boundary
 bctype=1,1,41,41,1,1,twall=0,0,1,1,0,0
/
&boundary_options
 high_order_wall_mode='keep_sbp63'
/
&initialization
 limmbou=f,lrestart=f,ninit=3
/
&sponge
 spg_i0=0,spg_im=0,spg_j0=0,spg_jm=0,spg_k0=0,spg_km=0,spg_def='layer'
/
&precision_options
 gpu_precision_mode='fp64'
/
&transport_options
 channel_force_mode='fixed',channel_force_fixed=0.d0
/
