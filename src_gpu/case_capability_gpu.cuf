module case_capability_gpu
  implicit none
  integer,parameter :: GPU_SOURCE_NONE=0
  integer,parameter :: GPU_SOURCE_CHANNEL=1
  integer,parameter :: GPU_SOURCE_RTI=2
contains
  integer function gpu_case_source_kind()
    use commvar, only: flowtype,lihomo
    implicit none

    gpu_case_source_kind = GPU_SOURCE_NONE
    select case(trim(flowtype))
    case('channel')
      if(lihomo) gpu_case_source_kind = GPU_SOURCE_CHANNEL
    case('rti')
      gpu_case_source_kind = GPU_SOURCE_RTI
    end select
  end function gpu_case_source_kind

  logical function gpu_case_has_source()
    implicit none

    gpu_case_has_source = gpu_case_source_kind() /= GPU_SOURCE_NONE
  end function gpu_case_has_source

  logical function gpu_sod_s0a1_supported()
    use commvar, only: flowtype,conschm,difschm,recon_schem,lchardecomp, &
         lfilter,diffterm,lihomo,ljhomo,lkhomo,nondimen
    use parallel, only: mpisize,isize,jsize,ksize
    implicit none

    gpu_sod_s0a1_supported = trim(flowtype) == 'sod' .and. &
         trim(conschm) == '543e' .and. trim(difschm) == '643e' .and. &
         recon_schem == -1 .and. (.not.lchardecomp) .and. &
         (.not.lfilter) .and. (.not.diffterm) .and. &
         lihomo .and. ljhomo .and. lkhomo .and. nondimen .and. mpisize == 1
  end function gpu_sod_s0a1_supported

  logical function gpu_sod_s0a2_supported()
    use commvar, only: flowtype,conschm,difschm,recon_schem,lchardecomp, &
         lfilter,diffterm,lihomo,ljhomo,lkhomo,nondimen
    use parallel, only: mpisize,isize,jsize,ksize
    implicit none

    gpu_sod_s0a2_supported = trim(flowtype) == 'sod' .and. &
         trim(conschm) == '543e' .and. trim(difschm) == '643e' .and. &
         recon_schem == 1 .and. (.not.lchardecomp) .and. &
         (.not.lfilter) .and. (.not.diffterm) .and. &
         lihomo .and. ljhomo .and. lkhomo .and. nondimen .and. mpisize == 1
  end function gpu_sod_s0a2_supported

  logical function gpu_sod_s0a3_supported()
    use commvar, only: flowtype,conschm,difschm,recon_schem,lchardecomp, &
         lfilter,diffterm,lihomo,ljhomo,lkhomo,nondimen
    use parallel, only: mpisize
    implicit none

    gpu_sod_s0a3_supported = trim(flowtype) == 'sod' .and. &
         trim(conschm) == '543e' .and. trim(difschm) == '643e' .and. &
         recon_schem == 3 .and. (.not.lchardecomp) .and. &
         (.not.lfilter) .and. (.not.diffterm) .and. &
         lihomo .and. ljhomo .and. lkhomo .and. nondimen .and. mpisize == 1
  end function gpu_sod_s0a3_supported

  logical function gpu_sod_s0b0_xphysical_supported()
    use commvar, only: flowtype,conschm,difschm,recon_schem,lchardecomp, &
         lfilter,diffterm,lihomo,ljhomo,lkhomo,nondimen
    use bc, only: bctype
    use parallel, only: mpisize,isize,jsize,ksize
    implicit none

    gpu_sod_s0b0_xphysical_supported = trim(flowtype) == 'sod' .and. &
         trim(conschm) == '543e' .and. trim(difschm) == '643e' .and. &
         recon_schem == 3 .and. (.not.lchardecomp) .and. &
         (.not.lfilter) .and. (.not.diffterm) .and. &
         (.not.lihomo) .and. ljhomo .and. lkhomo .and. nondimen .and. &
         all(bctype(1:2) == 50) .and. all(bctype(3:6) == 1) .and. &
         (mpisize == 1 .or. (mpisize == 2 .and. isize == 2 .and. jsize == 1 .and. ksize == 1))
  end function gpu_sod_s0b0_xphysical_supported

  logical function gpu_open_shock_s0b1_supported()
    use commvar, only: flowtype,conschm,difschm,recon_schem,lchardecomp, &
         lfilter,diffterm,lihomo,ljhomo,lkhomo,nondimen
    use bc, only: bctype,turbinf
    use parallel, only: mpisize,isize,jsize,ksize
    implicit none

    gpu_open_shock_s0b1_supported = trim(flowtype) == 'openshock' .and. &
         trim(conschm) == '543e' .and. trim(difschm) == '643e' .and. &
         recon_schem == 3 .and. (.not.lchardecomp) .and. &
         (.not.lfilter) .and. (.not.diffterm) .and. &
         (.not.lihomo) .and. ljhomo .and. lkhomo .and. nondimen .and. &
         bctype(1) == 11 .and. bctype(2) == 21 .and. all(bctype(3:6) == 1) .and. &
         trim(turbinf) == 'free' .and. &
         (mpisize == 1 .or. (mpisize == 2 .and. isize == 2 .and. jsize == 1 .and. ksize == 1))
  end function gpu_open_shock_s0b1_supported

  logical function gpu_open_shock_s0b2_nscbc_supported()
    use commvar, only: flowtype,conschm,difschm,recon_schem,lchardecomp, &
         lfilter,diffterm,lihomo,ljhomo,lkhomo,nondimen
    use bc, only: bctype
    use sponge_layer, only: spg_i0,spg_im,spg_j0,spg_jm,spg_k0,spg_km
    use parallel, only: mpisize,isize,jsize,ksize
    implicit none

    gpu_open_shock_s0b2_nscbc_supported = trim(flowtype) == 'openshock' .and. &
         trim(conschm) == '543e' .and. trim(difschm) == '643e' .and. &
         recon_schem == 3 .and. (.not.lchardecomp) .and. &
         (.not.lfilter) .and. (.not.diffterm) .and. &
         (.not.lihomo) .and. ljhomo .and. lkhomo .and. nondimen .and. &
         spg_i0 == 0 .and. spg_im == 0 .and. spg_j0 == 0 .and. spg_jm == 0 .and. &
         spg_k0 == 0 .and. spg_km == 0 .and. &
         bctype(1) == 12 .and. bctype(2) == 22 .and. all(bctype(3:6) == 1) .and. &
         (mpisize == 1 .or. (mpisize == 2 .and. isize == 2 .and. jsize == 1 .and. ksize == 1))
  end function gpu_open_shock_s0b2_nscbc_supported

  logical function gpu_open_shock_s0b3_sponge_supported()
    use commvar, only: flowtype,conschm,difschm,recon_schem,lchardecomp, &
         lfilter,diffterm,lihomo,ljhomo,lkhomo,nondimen,spg_def
    use bc, only: bctype
    use sponge_layer, only: spg_i0,spg_im,spg_j0,spg_jm,spg_k0,spg_km
    use parallel, only: mpisize,isize,jsize,ksize
