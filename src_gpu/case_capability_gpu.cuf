    gpu_open_shock_s0b3_sponge_supported = trim(flowtype) == 'openshock' .and. &
         trim(conschm) == '543e' .and. trim(difschm) == '643e' .and. &
         recon_schem == 3 .and. (.not.lchardecomp) .and. &
         (.not.lfilter) .and. (.not.diffterm) .and. &
         (.not.lihomo) .and. ljhomo .and. lkhomo .and. nondimen .and. &
         trim(spg_def) == 'layer' .and. spg_i0 == 0 .and. spg_im > 0 .and. &
         spg_j0 == 0 .and. spg_jm == 0 .and. spg_k0 == 0 .and. spg_km == 0 .and. &
         bctype(1) == 12 .and. bctype(2) == 22 .and. all(bctype(3:6) == 1) .and. &
         (mpisize == 1 .or. (mpisize == 2 .and. isize == 2 .and. jsize == 1 .and. ksize == 1))
  end function gpu_open_shock_s0b3_sponge_supported

  logical function gpu_open_shock_s0b4_sponge_mpi_supported()
    use commvar, only: flowtype,conschm,difschm,recon_schem,lchardecomp, &
