         trim(conschm) == '543e' .and. trim(difschm) == '643e' .and. &
         recon_schem == 3 .and. (.not.lchardecomp) .and. lfilter .and. nondimen .and. &
         (.not.lihomo) .and. (.not.ljhomo) .and. lkhomo .and. &
         spg_i0 == 0 .and. spg_im == 0 .and. spg_j0 == 0 .and. &
         spg_jm == 0 .and. spg_k0 == 0 .and. spg_km == 0 .and. &
         trim(turbmode) == 'none' .and. trim(turbinf) == 'prof' .and. &
         bctype(1) == 11 .and. bctype(2) == 21 .and. bctype(3) == 41 .and. &
         bctype(4) == 51 .and. all(bctype(5:6) == 1) .and. &
         (mpisize == 1 .or. (mpisize == 2 .and. &
          ((isize == 2 .and. jsize == 1 .and. ksize == 1) .or. &
           (isize == 1 .and. jsize == 2 .and. ksize == 1) .or. &
           (isize == 1 .and. jsize == 1 .and. ksize == 2))) .or. &
          (mpisize == 4 .and. isize == 2 .and. jsize == 2 .and. ksize == 1))
  end function gpu_s1_flatplate_explicit_filter_supported

  logical function gpu_shock_sensor_s0a4_supported()
    use commvar, only: flowtype,conschm,difschm,recon_schem,lchardecomp, &
         lfilter,diffterm,lihomo,ljhomo,lkhomo,nondimen
    use commcal, only: shock_sensor_validation_enabled
    use parallel, only: mpisize
    implicit none

    gpu_shock_sensor_s0a4_supported = shock_sensor_validation_enabled() .and. &
         trim(flowtype) == 'shuosher' .and. &
         trim(conschm) == '543e' .and. trim(difschm) == '643e' .and. &
         recon_schem == 3 .and. (.not.lchardecomp) .and. &
         (.not.lfilter) .and. (.not.diffterm) .and. &
         lihomo .and. ljhomo .and. lkhomo .and. nondimen .and. mpisize == 1
