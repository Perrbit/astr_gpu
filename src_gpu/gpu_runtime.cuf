module gpu_runtime
  implicit none
  logical,save :: prepared_halo_ready = .false.
  logical,save :: stats_snapshot_ready = .false.
  logical,save :: rk_timing_configured = .false.
  logical,save :: rk_timing_enabled = .false.
  logical,save :: rank_rk_timing_enabled = .false.
  logical,save :: complete_step_timing_configured = .false.
  logical,save :: complete_step_timing_enabled = .false.
  real(8),save :: rk_prepare_start = 0.d0
  real(8),save :: rk_prepare_seconds = 0.d0
  real(8),save :: complete_step_start = 0.d0
contains
  subroutine configure_complete_step_timing()
    implicit none
    character(len=16) :: value
    integer :: length,status

    if(complete_step_timing_configured) return
    value=''
    call get_environment_variable('ASTR_GPU_COMPLETE_STEP_TIMING',value, &
                                  length=length,status=status)
    if(status==0 .and. length>0) then
      select case(trim(adjustl(value)))
      case('1','t','T','true','TRUE','on','ON')
        complete_step_timing_enabled=.true.
      end select
    endif
    complete_step_timing_configured=.true.
  end subroutine configure_complete_step_timing

  subroutine gpu_begin_complete_step_timing()
    use parallel, only: ptime
    implicit none

    call configure_complete_step_timing()
    if(complete_step_timing_enabled) complete_step_start=ptime()
  end subroutine gpu_begin_complete_step_timing

  subroutine gpu_end_complete_step_timing()
    use commvar, only: nstep
    use parallel, only: lio,ptime
    implicit none
    real(8) :: elapsed

    if(.not.complete_step_timing_enabled) return
    elapsed=ptime()-complete_step_start
    if(lio) write(*,'(A,1X,I0,1X,ES24.16E3)') &
      'ASTR_GPU_COMPLETE_STEP_TIMING',nstep,elapsed
  end subroutine gpu_end_complete_step_timing

  subroutine configure_rk_timing()
    implicit none
    character(len=16) :: value
    integer :: length,status

    if(rk_timing_configured) return
    value=''
    call get_environment_variable('ASTR_GPU_RK_TIMING',value,        &
                                  length=length,status=status)
    if(status == 0 .and. length > 0) then
      select case(trim(adjustl(value)))
      case('1','t','T','true','TRUE','on','ON')
        rk_timing_enabled=.true.
      case default
        rk_timing_enabled=.false.
      end select
    endif
    value=''
    call get_environment_variable('ASTR_GPU_RANK_RK_TIMING',value, &
                                  length=length,status=status)
    if(status == 0 .and. length > 0) then
      select case(trim(adjustl(value)))
      case('1','t','T','true','TRUE','on','ON')
        rank_rk_timing_enabled=.true.
        rk_timing_enabled=.true.
      end select
    endif
    rk_timing_configured=.true.
  end subroutine configure_rk_timing

  subroutine begin_rk_prepare_timing()
    use parallel, only: ptime
    implicit none

    call configure_rk_timing()
    rk_prepare_seconds=0.d0
    if(rk_timing_enabled) rk_prepare_start=ptime()
  end subroutine begin_rk_prepare_timing

  subroutine end_rk_prepare_timing()
    use parallel, only: ptime
    use gpu_check, only: sync_gpu_boundary
    implicit none

    if(rk_timing_enabled) then
      call sync_gpu_boundary('complete_rk_prepare_timing')
      rk_prepare_seconds=ptime()-rk_prepare_start
    endif
  end subroutine end_rk_prepare_timing

  subroutine gpu_bind_device()
    use device_runtime_gpu, only: bind_gpu_device
    implicit none

    call bind_gpu_device()
  end subroutine gpu_bind_device

  subroutine gpu_after_refcal()
    use commvar_gpu, only: copy_commvar_to_gpu
    implicit none

    call copy_commvar_to_gpu()
  end subroutine gpu_after_refcal

  subroutine gpu_after_alloc()
    use commarray_gpu, only: alloc_gpu_arrays
    implicit none

    call alloc_gpu_arrays()
  end subroutine gpu_after_alloc

  subroutine gpu_after_flowinit()
    use halo_exchange_gpu, only: init_halo_transport_gpu
    use mainloop_gpu, only: init_gpu
    use sponge_gpu, only: init_sponge_gpu
    use boundary_gpu, only: init_s1_flatplate_profile_gpu,init_wall_blowing_gpu
    use inflow_timeseries_gpu, only: init_dynamic_inflow_gpu
    use commvar, only: flowtype,ndims,lihomo,ljhomo,lkhomo
    use gpu_check, only: configure_gpu_sync_mode,gpu_selective_sync_enabled
    use parallel, only: lio
    use conservative_boundary_runtime, only: conservative_boundary
    use conservative_boundary_stage_gpu, only: initialize_conservative_stage_gpu
    use commvar_gpu, only: set_metric_consistent_eps_gpu
    use production_statistics_gpu, only: initialize_compact_statistics_gpu
    implicit none
    logical :: allow_selective

    allow_selective = trim(flowtype) == 'tgv' .and. ndims == 3 .and. &
                      lihomo .and. ljhomo .and. lkhomo
    call configure_gpu_sync_mode(allow_selective)
    if(lio) then
      if(gpu_selective_sync_enabled()) then
        write(*,'(A)') ' ** GPU synchronization mode: selective'
      else
        write(*,'(A)') ' ** GPU synchronization mode: explicit'
      endif
    endif
    call init_halo_transport_gpu()
    call init_gpu()
    if(conservative_boundary%enabled) then
      call initialize_conservative_stage_gpu()
      call set_metric_consistent_eps_gpu(.true.)
    endif
    call init_wall_blowing_gpu()
    call init_s1_flatplate_profile_gpu()
    call init_dynamic_inflow_gpu()
    call init_sponge_gpu()
    call initialize_compact_statistics_gpu()
  end subroutine gpu_after_flowinit

  subroutine gpu_before_finalize()
    use halo_transport_gpu, only: release_host_buffers
    use inflow_timeseries_gpu, only: release_dynamic_inflow_gpu
    use production_statistics_gpu, only: release_compact_statistics_gpu
    use boundary_gpu, only: release_boundary_gpu
    use sponge_gpu, only: release_sponge_gpu
    use conservative_boundary_stage_gpu, only: release_conservative_stage_gpu
    use halo_exchange_gpu, only: release_halo_exchange_buffers_gpu
    use commarray_gpu, only: release_gpu_arrays
    implicit none
    call release_compact_statistics_gpu()
    call release_dynamic_inflow_gpu()
    call release_boundary_gpu()
    call release_sponge_gpu()
    call release_conservative_stage_gpu()
    call release_host_buffers()
    call release_halo_exchange_buffers_gpu()
    call release_gpu_arrays()
  end subroutine gpu_before_finalize

  logical function gpu_compact_statistics_requested()
    use production_statistics_gpu, only: compact_statistics_requested
    implicit none

    gpu_compact_statistics_requested=compact_statistics_requested()
  end function gpu_compact_statistics_requested

  subroutine gpu_accumulate_compact_statistics()
    use production_statistics_gpu, only: accumulate_compact_statistics_gpu
    implicit none

    call accumulate_compact_statistics_gpu()
  end subroutine gpu_accumulate_compact_statistics

  subroutine gpu_prepare_compact_statistics_checkpoint()
    use production_statistics_gpu, only: prepare_compact_statistics_checkpoint
    implicit none

    call prepare_compact_statistics_checkpoint()
  end subroutine gpu_prepare_compact_statistics_checkpoint

  subroutine gpu_commit_compact_statistics_checkpoint()
    use production_statistics_gpu, only: commit_compact_statistics_checkpoint
    implicit none

    call commit_compact_statistics_checkpoint()
  end subroutine gpu_commit_compact_statistics_checkpoint

  subroutine gpu_sync_flow_to_device()
    use commarray_gpu, only: copy_flow_to_gpu
    implicit none

    call copy_flow_to_gpu()
  end subroutine gpu_sync_flow_to_device

  subroutine gpu_sync_flow_to_host()
    use commarray_gpu, only: copy_flow_from_gpu
    implicit none

    call copy_flow_from_gpu()
  end subroutine gpu_sync_flow_to_host

  subroutine gpu_sync_output_boundary_to_host()
    use commarray_gpu, only: copy_output_boundary_from_gpu
    implicit none

    call copy_output_boundary_from_gpu()
  end subroutine gpu_sync_output_boundary_to_host

  subroutine gpu_exchange_solution_halo()
    use halo_exchange_gpu, only: exchange_solution_halo_gpu
    implicit none

    if(prepared_halo_ready) return
    call exchange_solution_halo_gpu()
  end subroutine gpu_exchange_solution_halo

  subroutine gpu_prepare_rkfirst_stats()
    use mainloop_gpu, only: prepare_rkfirst_stats_gpu
    use boundary_gpu, only: gpu_s1_flatplate_nscbc_farfield_case
    use commarray_gpu, only: save_q_stats_snapshot_gpu
    use commvar, only: time
    use inflow_timeseries_gpu, only: prepare_dynamic_inflow_gpu
    implicit none

    call begin_rk_prepare_timing()
    call prepare_dynamic_inflow_gpu(time)
    stats_snapshot_ready = gpu_s1_flatplate_nscbc_farfield_case()
    if(stats_snapshot_ready) call save_q_stats_snapshot_gpu()
    call prepare_rkfirst_stats_gpu()
    prepared_halo_ready = .true.
    call end_rk_prepare_timing()
  end subroutine gpu_prepare_rkfirst_stats

  subroutine gpu_restore_stats_snapshot()
    use commarray_gpu, only: restore_q_stats_snapshot_gpu
    implicit none

    if(.not.stats_snapshot_ready) return
    call restore_q_stats_snapshot_gpu()
    stats_snapshot_ready = .false.
    prepared_halo_ready = .false.
  end subroutine gpu_restore_stats_snapshot

  subroutine gpu_time_integration_rk(first_stage_prepared,copy_back)
    use mainloop_gpu, only: time_integration_rk_gpu
    use commvar, only: nstep
    use gpu_check, only: sync_gpu_boundary
    use parallel, only: lio,ptime,mpirank
    implicit none
    logical,intent(in),optional :: first_stage_prepared
    logical,intent(in),optional :: copy_back
    real(8) :: integration_start,integration_seconds,total_seconds

    if(rk_timing_enabled) integration_start=ptime()
    call time_integration_rk_gpu(first_stage_prepared,copy_back)
    call sync_gpu_boundary('complete_rk')
    if(rk_timing_enabled) then
      integration_seconds=ptime()-integration_start
      total_seconds=rk_prepare_seconds+integration_seconds
      if(lio) write(*,'(A,1X,I0,3(1X,ES24.16E3))')                  &
        'ASTR_GPU_RK_TIMING',nstep,rk_prepare_seconds,              &
        integration_seconds,total_seconds
      if(rank_rk_timing_enabled) write(*,'(A,2(1X,I0),3(1X,ES24.16E3))') &
        'ASTR_GPU_RANK_RK_TIMING',mpirank,nstep,rk_prepare_seconds, &
        integration_seconds,total_seconds
    endif
    prepared_halo_ready = .false.
  end subroutine gpu_time_integration_rk

  subroutine gpu_write_kenergy()
    use statistic_gpu, only: statistic_gpu_write_kenergy => gpu_write_kenergy
    implicit none

    call statistic_gpu_write_kenergy()
  end subroutine gpu_write_kenergy

  subroutine gpu_write_gradcal_dvel_compare()
    use gradcal_gpu, only: write_gradcal_dvel_compare
    implicit none

    call write_gradcal_dvel_compare()
  end subroutine gpu_write_gradcal_dvel_compare

  subroutine gpu_write_tgv_statistics()
    use gradcal_gpu, only: compute_gradcal_gpu
    use statistic_gpu, only: gpu_write_kenergy,gpu_write_enstophy, &
                             gpu_write_dissipation,gpu_write_flowstate
    implicit none

    call compute_gradcal_gpu()
    call gpu_write_flowstate()
    call gpu_write_kenergy()
    call gpu_write_enstophy()
    call gpu_write_dissipation()
  end subroutine gpu_write_tgv_statistics

  subroutine gpu_write_flow_statistics()
    use commvar, only: flowtype
    use gradcal_gpu, only: compute_gradcal_gpu
    use statistic_gpu, only: gpu_write_channel_flowstate,gpu_write_s1_bl_flowstate, &
                             gpu_write_generic_flowstate
    implicit none

    if(trim(flowtype) == 'tgv' .or. trim(flowtype) == 'hit') then
      call gpu_write_tgv_statistics()
    elseif(trim(flowtype) == 'channel') then
      call compute_gradcal_gpu()
      call gpu_write_channel_flowstate()
    elseif(trim(flowtype) == 'bl') then
      call compute_gradcal_gpu()
      call gpu_write_s1_bl_flowstate()
    else
      call gpu_write_generic_flowstate()
    endif
  end subroutine gpu_write_flow_statistics
end module gpu_runtime
