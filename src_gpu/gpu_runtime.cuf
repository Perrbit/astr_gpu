module gpu_runtime
  implicit none
  logical,save :: prepared_halo_ready = .false.
  logical,save :: c4_stats_snapshot_ready = .false.
contains
  subroutine gpu_bind_device()
    use device_runtime_gpu, only: bind_gpu_device
    implicit none

    call bind_gpu_device()
  end subroutine gpu_bind_device

  subroutine gpu_after_refcal()
    use commvar_gpu, only: copy_commvar_to_gpu
    implicit none

    call copy_commvar_to_gpu()
  end subroutine gpu_after_refcal

  subroutine gpu_after_alloc()
    use commarray_gpu, only: alloc_gpu_arrays
    implicit none

    call alloc_gpu_arrays()
  end subroutine gpu_after_alloc

  subroutine gpu_after_flowinit()
    use mainloop_gpu, only: init_gpu
    use sponge_gpu, only: init_sponge_gpu
    use boundary_gpu, only: init_s1_flatplate_profile_gpu,init_wall_blowing_gpu
    implicit none

    call init_gpu()
    call init_wall_blowing_gpu()
    call init_s1_flatplate_profile_gpu()
    call init_sponge_gpu()
  end subroutine gpu_after_flowinit

  subroutine gpu_sync_flow_to_device()
    use commarray_gpu, only: copy_flow_to_gpu
    implicit none

    call copy_flow_to_gpu()
  end subroutine gpu_sync_flow_to_device

  subroutine gpu_sync_flow_to_host()
    use commarray_gpu, only: copy_flow_from_gpu
    implicit none

    call copy_flow_from_gpu()
  end subroutine gpu_sync_flow_to_host

  subroutine gpu_sync_output_boundary_to_host()
    use commarray_gpu, only: copy_output_boundary_from_gpu
    implicit none

    call copy_output_boundary_from_gpu()
  end subroutine gpu_sync_output_boundary_to_host

  subroutine gpu_exchange_solution_halo()
    use halo_exchange_gpu, only: exchange_solution_halo_gpu
    implicit none

    if(prepared_halo_ready) return
    call exchange_solution_halo_gpu()
  end subroutine gpu_exchange_solution_halo

  subroutine gpu_prepare_rkfirst_stats()
    use mainloop_gpu, only: prepare_rkfirst_stats_gpu
    use case_capability_gpu, only: gpu_s2_hbl_selective_roe_s2c4_supported, &
         gpu_s2_hbl_selective_roe_s2c4_sponge_supported, &
         gpu_s2_hbl_selective_roe_s2c4_diffusion_supported, &
         gpu_s2_hbl_selective_roe_s2c5_diffusion_supported
    use commarray_gpu, only: save_q_stats_snapshot_gpu
    implicit none

    c4_stats_snapshot_ready = gpu_s2_hbl_selective_roe_s2c4_supported() .or. &
         gpu_s2_hbl_selective_roe_s2c4_sponge_supported() .or. &
         gpu_s2_hbl_selective_roe_s2c4_diffusion_supported() .or. &
         gpu_s2_hbl_selective_roe_s2c5_diffusion_supported()
    if(c4_stats_snapshot_ready) call save_q_stats_snapshot_gpu()
    call prepare_rkfirst_stats_gpu()
    prepared_halo_ready = .true.
  end subroutine gpu_prepare_rkfirst_stats

  subroutine gpu_restore_c4_stats_snapshot()
    use commarray_gpu, only: restore_q_stats_snapshot_gpu
    implicit none

    if(.not.c4_stats_snapshot_ready) return
    call restore_q_stats_snapshot_gpu()
    c4_stats_snapshot_ready = .false.
    prepared_halo_ready = .false.
  end subroutine gpu_restore_c4_stats_snapshot

  subroutine gpu_time_integration_rk(first_stage_prepared,copy_back)
    use mainloop_gpu, only: time_integration_rk_gpu
    implicit none
    logical,intent(in),optional :: first_stage_prepared
    logical,intent(in),optional :: copy_back

    call time_integration_rk_gpu(first_stage_prepared,copy_back)
    prepared_halo_ready = .false.
  end subroutine gpu_time_integration_rk

  subroutine gpu_write_kenergy()
    use statistic_gpu, only: statistic_gpu_write_kenergy => gpu_write_kenergy
    implicit none

    call statistic_gpu_write_kenergy()
  end subroutine gpu_write_kenergy

  subroutine gpu_write_gradcal_dvel_compare()
    use gradcal_gpu, only: write_gradcal_dvel_compare
    implicit none

    call write_gradcal_dvel_compare()
  end subroutine gpu_write_gradcal_dvel_compare

  subroutine gpu_write_tgv_statistics()
    use gradcal_gpu, only: compute_gradcal_gpu
    use statistic_gpu, only: gpu_write_kenergy,gpu_write_enstophy, &
                             gpu_write_dissipation,gpu_write_flowstate
    implicit none

    call compute_gradcal_gpu()
    call gpu_write_flowstate()
    call gpu_write_kenergy()
    call gpu_write_enstophy()
    call gpu_write_dissipation()
  end subroutine gpu_write_tgv_statistics

  subroutine gpu_write_flow_statistics()
    use commvar, only: flowtype
    use gradcal_gpu, only: compute_gradcal_gpu
    use statistic_gpu, only: gpu_write_channel_flowstate,gpu_write_s1_bl_flowstate, &
                             gpu_write_generic_flowstate
    implicit none

    if(trim(flowtype) == 'tgv' .or. trim(flowtype) == 'hit') then
      call gpu_write_tgv_statistics()
    elseif(trim(flowtype) == 'channel') then
      call compute_gradcal_gpu()
      call gpu_write_channel_flowstate()
    elseif(trim(flowtype) == 'bl') then
      call compute_gradcal_gpu()
      call gpu_write_s1_bl_flowstate()
    else
      call gpu_write_generic_flowstate()
    endif
  end subroutine gpu_write_flow_statistics
end module gpu_runtime
