module index_slice_gpu
  use astr_precision, only: real_kind,real_bytes
  use iso_fortran_env, only: int64
  use iso_c_binding, only: c_f_pointer,c_loc,c_size_t,c_int
  use cudafor
  use gpu_check, only: sync_after_kernel
  implicit none
  private
  public :: allocate_index_slice_gpu,release_index_slice_gpu,fill_index_slice_gpu
  public :: sample_remote_slice_gpu,receive_index_slice_gpu,evaluate_index_slice_gpu,download_index_slice_gpu
  public :: index_slice_device_view
  public :: download_index_neighborhood_gpu
  public :: begin_index_slice_exchange_gpu,exchange_index_slice_gpu,end_index_slice_exchange_gpu,index_slice_exchange_usage
  public :: validate_index_slice_transport
  real(real_kind),pointer,contiguous,device,save :: neighborhood(:,:)=>null(),result_d(:,:)=>null()
  real(real_kind),pointer,contiguous,device,save :: coordinates_d(:,:)=>null()
  integer,device,save :: raw_ids_d(12),fields_d(27)
  real(real_kind),device,save :: weights_d(7,0:6)
  integer,save :: raw_count=0,field_count=0
  real(real_kind),pointer,contiguous,device,save :: send_slot(:,:)=>null(),receive_slot(:,:)=>null()
  integer,pointer,contiguous,device,save :: exchange_indices(:,:)=>null(),exchange_positions(:,:)=>null()
  real(real_kind),allocatable,target,save :: send_host(:),receive_host(:)
  logical,save :: send_registered=.false.,receive_registered=.false.
  integer,save :: exchange_mode=0
  integer(int64),save :: exchange_download=0,exchange_upload=0
#ifdef ASTR_MPI_CUDA_AWARE_QUERY
  interface
    integer(c_int) function query_cuda_support() bind(C,name='MPIX_Query_cuda_support')
      import c_int
    end function
  end interface
#endif
contains
  subroutine validate_index_slice_transport(mode,ok,message)
    character(*),intent(in) :: mode
    logical,intent(out) :: ok
    character(*),intent(out) :: message
    integer :: status,i,environment_status
    character(32) :: runtime_cuda
    ok=.false.;message=''
    if(mode/='pinned'.and.mode/='device-aware') then
      message='private image strips require explicit pinned or device-aware transport';return
    endif
    if(mode=='device-aware') then
      status=0
#ifdef ASTR_MPI_CUDA_AWARE_QUERY
      status=int(query_cuda_support())
#endif
      ! The extension can report build capability even when the launcher disables CUDA buffers.
      call get_environment_variable('OMPI_MCA_opal_cuda_support',runtime_cuda,status=environment_status)
      if(environment_status==0) then
        do i=1,len_trim(runtime_cuda)
          if(runtime_cuda(i:i)>='A'.and.runtime_cuda(i:i)<='Z') runtime_cuda(i:i)=achar(iachar(runtime_cuda(i:i))+32)
        enddo
        select case(trim(runtime_cuda))
        case('0','false','f','no','off')
          status=0
        end select
      endif
      if(status/=1) then
        message='CUDA-aware MPI is unavailable for the requested private image transport';return
      endif
    endif
    ok=.true.
  end subroutine

  subroutine begin_index_slice_exchange_gpu(capacity,mode,ok,message)
    integer,intent(in) :: capacity
    character(*),intent(in) :: mode
    logical,intent(out) :: ok
    character(*),intent(out) :: message
    integer :: words,status,ignored
    call end_index_slice_exchange_gpu()
    exchange_download=0;exchange_upload=0
    call validate_index_slice_transport(mode,ok,message)
    if(.not.ok) return
    words=max(1,capacity*raw_count)
    ok=allocate_real2(send_slot,words,1)
    if(ok) ok=allocate_real2(receive_slot,words,1)
    if(ok) ok=allocate_int2(exchange_indices,3,max(1,capacity))
    if(ok) ok=allocate_int2(exchange_positions,max(1,capacity),1)
    if(.not.ok) then
      message='cannot allocate private image MPI device slots';return
    endif
    exchange_mode=1
    if(mode=='device-aware') return
    exchange_mode=2
    allocate(send_host(words),receive_host(words),stat=status)
    ok=status==0
    if(.not.ok) then
      message='cannot allocate private image pinned host slots';return
    endif
    status=cudaHostRegister(c_loc(send_host),int(words,int64)*real_bytes,0)
    ok=registered(status);send_registered=ok
    if(ok) then
      status=cudaHostRegister(c_loc(receive_host),int(words,int64)*real_bytes,0)
      ok=registered(status);receive_registered=ok
    endif
    if(.not.ok) message='cannot register private image pinned host slots; no pageable fallback'
  contains
    logical function registered(code) result(valid)
      integer,intent(in) :: code
      if(code==cudaErrorNotSupported) then
        ignored=cudaGetLastError();valid=.false.
      else
        valid=allocation_succeeded(code)
      endif
    end function
  end subroutine

  subroutine end_index_slice_exchange_gpu()
    if(send_registered) call require_slice_transfer(cudaHostUnregister(c_loc(send_host)))
    if(receive_registered) call require_slice_transfer(cudaHostUnregister(c_loc(receive_host)))
    send_registered=.false.;receive_registered=.false.
    if(allocated(send_host)) deallocate(send_host)
    if(allocated(receive_host)) deallocate(receive_host)
    call free_real2(send_slot);call free_real2(receive_slot)
    call free_int2(exchange_indices);call free_int2(exchange_positions)
    exchange_mode=0
  end subroutine

  subroutine index_slice_exchange_usage(download,upload)
    integer(int64),intent(out) :: download,upload
    download=exchange_download;upload=exchange_upload
  end subroutine

  subroutine exchange_index_slice_gpu(indices,positions,source,count,destination,sender,comm)
    use mpi
    use astr_precision_mpi, only: mpi_real_type
    integer,intent(in) :: indices(:,:),positions(:),source,destination,sender,comm
    integer(int64),intent(in) :: count
    real(real_kind),pointer,contiguous,device :: send_data(:,:),receive_data(:,:)
    real(real_kind),pointer,contiguous :: send_buffer(:,:),receive_buffer(:,:)
    integer,pointer,contiguous,device :: scatter_positions(:)
    integer :: ns,nr,err,ignored
    ns=size(indices,2);nr=size(positions)
    call c_f_pointer(c_devloc(send_slot),send_data,[ns,raw_count])
    call c_f_pointer(c_devloc(receive_slot),receive_data,[nr,raw_count])
    call c_f_pointer(c_devloc(exchange_positions),scatter_positions,[nr])
    if(ns>0) then
      exchange_indices(:,:ns)=indices
      call sample_kernel<<<(ns+255)/256,256>>>(exchange_indices(:,:ns),send_data,ns,raw_count,source,count)
      call sync_after_kernel('private image MPI send strip',.true.)
    endif
    if(exchange_mode==1) then
      call MPI_Sendrecv(send_data,ns*raw_count,mpi_real_type,destination,1, &
        receive_data,nr*raw_count,mpi_real_type,sender,1,comm,MPI_STATUS_IGNORE,err)
      if(err/=MPI_SUCCESS) call MPI_Abort(comm,err,ignored)
    else
      call c_f_pointer(c_loc(send_host),send_buffer,[ns,raw_count])
      call c_f_pointer(c_loc(receive_host),receive_buffer,[nr,raw_count])
      if(ns>0) call require_slice_transfer(cudaMemcpy(send_buffer,send_data,int(ns,int64)*raw_count,cudaMemcpyDeviceToHost))
      call MPI_Sendrecv(send_buffer,ns*raw_count,mpi_real_type,destination,1, &
        receive_buffer,nr*raw_count,mpi_real_type,sender,1,comm,MPI_STATUS_IGNORE,err)
      if(err/=MPI_SUCCESS) call MPI_Abort(comm,err,ignored)
      if(nr>0) call require_slice_transfer(cudaMemcpy(receive_data,receive_buffer,int(nr,int64)*raw_count,cudaMemcpyHostToDevice))
      exchange_download=exchange_download+int(ns,int64)*raw_count*real_bytes
      exchange_upload=exchange_upload+int(nr,int64)*raw_count*real_bytes
    endif
    if(nr>0) then
      scatter_positions=positions
      call scatter_kernel<<<(nr+255)/256,256>>>(scatter_positions,receive_data,nr,raw_count,neighborhood)
      call sync_after_kernel('private image MPI received strip',.true.)
    endif
  end subroutine
  attributes(device) function source_value(i,j,k,field,source,count) result(value)
    use commarray_gpu, only: rho_d,vel_d,prs_d,tmp_d
    use insitu_statistics_gpu, only: slice_statistics_gpu_value
#ifdef ASTR_AIR5_CHEMISTRY
    use commarray_gpu, only: tve_d,spc_d
    use chemistry_mean_statistics_gpu, only: slice_air5_mean_value_gpu
#endif
    integer,value :: i,j,k,field,source
    integer(int64),value :: count
    real(real_kind) :: value
    if(source==1.or.source==2) then
      value=slice_statistics_gpu_value(i,j,k,field,source==2);return
    endif
#ifdef ASTR_AIR5_CHEMISTRY
    if(source==3.or.source==4) then
      value=slice_air5_mean_value_gpu(i,j,k,field,source==4,count);return
    endif
#endif
    select case(field)
    case(1)
      value=rho_d(i,j,k)
    case(2:4)
      value=vel_d(i,j,k,field-1)
    case(5)
      value=prs_d(i,j,k)
    case(6)
      value=tmp_d(i,j,k)
#ifdef ASTR_AIR5_CHEMISTRY
    case(7)
      value=tve_d(i,j,k)
    case(8:12)
      value=spc_d(i,j,k,field-7)
#endif
    end select
  end function

  subroutine allocate_index_slice_gpu(nodes,output_nodes,raw_ids,fields,weights,ok,device_geometry)
    integer,intent(in) :: nodes,output_nodes,raw_ids(:),fields(:)
    real(real_kind),intent(in) :: weights(7,0:6)
    logical,intent(out) :: ok
    logical,optional,intent(in) :: device_geometry
    call release_index_slice_gpu()
    exchange_download=0;exchange_upload=0
    raw_count=size(raw_ids);field_count=size(fields)
    ok=allocate_real2(neighborhood,max(1,nodes),max(1,raw_count))
    if(ok) ok=allocate_real2(result_d,max(1,output_nodes),field_count)
    if(present(device_geometry)) then
      if(ok.and.device_geometry) ok=allocate_real2(coordinates_d,3,max(1,output_nodes))
    endif
    if(.not.ok) then
      call release_index_slice_gpu();return
    endif
    raw_ids_d(:raw_count)=raw_ids;fields_d(:field_count)=fields;weights_d=weights
  end subroutine

  subroutine release_index_slice_gpu()
    call end_index_slice_exchange_gpu()
    call free_real2(neighborhood)
    call free_real2(result_d)
    call free_real2(coordinates_d)
    raw_count=0;field_count=0
  end subroutine

  subroutine index_slice_device_view(values,coordinates)
    type(c_devptr),intent(out) :: values,coordinates
    values=c_devloc(result_d);coordinates=c_devloc(coordinates_d)
  end subroutine

  attributes(global) subroutine fill_kernel(indices,positions,n,nraw,source,count,neighborhood)
    integer,value :: n,nraw,source
    integer(int64),value :: count
    integer,device,intent(in) :: indices(3,n),positions(n)
    real(real_kind),device,intent(out) :: neighborhood(:,:)
    integer :: node,m
    node=(blockidx%x-1)*blockdim%x+threadidx%x
    if(node>n) return
    do m=1,nraw
      neighborhood(positions(node),m)=source_value(indices(1,node),indices(2,node),indices(3,node), &
        raw_ids_d(m),source,count)
    enddo
  end subroutine

  subroutine fill_index_slice_gpu(indices,positions,source,count,ok)
    integer,intent(in) :: indices(:,:),positions(:),source
    integer(int64),intent(in) :: count
    logical,intent(out) :: ok
    integer,pointer,contiguous,device :: idx(:,:)=>null()
    integer,allocatable,device :: pos(:)
    integer :: status,n
    n=size(positions);ok=.true.
    if(n==0) return
    ok=allocate_int2(idx,3,n)
    if(ok) ok=allocation_succeeded(cudaMalloc(pos,n))
    if(ok) then
      idx=indices;pos=positions
      call fill_kernel<<<(n+255)/256,256>>>(idx,pos,n,raw_count,source,count,neighborhood)
      call sync_after_kernel('index slice local neighborhood',.true.)
    endif
    call free_int2(idx)
    if(allocated(pos)) call require_slice_transfer(cudaFree(pos))
  end subroutine

  attributes(global) subroutine sample_kernel(indices,values,n,nraw,source,count)
    integer,value :: n,nraw,source
    integer(int64),value :: count
    integer,device,intent(in) :: indices(3,n)
    real(real_kind),device,intent(out) :: values(n,nraw)
    integer :: node,m
    node=(blockidx%x-1)*blockdim%x+threadidx%x
    if(node>n) return
    do m=1,nraw
      values(node,m)=source_value(indices(1,node),indices(2,node),indices(3,node),raw_ids_d(m),source,count)
    enddo
  end subroutine

  subroutine sample_remote_slice_gpu(indices,source,count,values,ok)
    integer,intent(in) :: indices(:,:),source
    integer(int64),intent(in) :: count
    real(real_kind),intent(out) :: values(:,:)
    logical,intent(out) :: ok
    integer,pointer,contiguous,device :: idx(:,:)=>null()
    real(real_kind),pointer,contiguous,device :: data(:,:)=>null()
    integer :: status,n
    n=size(indices,2);ok=.true.
    if(n==0) return
    ok=allocate_int2(idx,3,n)
    if(ok) ok=allocate_real2(data,n,raw_count)
    if(ok) then
      idx=indices
      call sample_kernel<<<(n+255)/256,256>>>(idx,data,n,raw_count,source,count)
      call sync_after_kernel('index slice private remote strip',.true.)
      status=cudaMemcpy(values,data,size(values,kind=int64),cudaMemcpyDeviceToHost)
      call require_slice_transfer(status)
    endif
    call free_int2(idx)
    call free_real2(data)
  end subroutine

  attributes(global) subroutine scatter_kernel(positions,values,n,nraw,neighborhood)
    integer,value :: n,nraw
    integer,device,intent(in) :: positions(n)
    real(real_kind),device,intent(in) :: values(n,nraw)
    real(real_kind),device,intent(inout) :: neighborhood(:,:)
    integer :: node,m
    node=(blockidx%x-1)*blockdim%x+threadidx%x
    if(node>n) return
    do m=1,nraw
      neighborhood(positions(node),m)=values(node,m)
    enddo
  end subroutine

  subroutine receive_index_slice_gpu(positions,values,ok)
    integer,intent(in) :: positions(:)
    real(real_kind),intent(in) :: values(:,:)
    logical,intent(out) :: ok
    integer,allocatable,device :: pos(:)
    real(real_kind),pointer,contiguous,device :: data(:,:)=>null()
    integer :: status,n
    n=size(positions);ok=.true.
    if(n==0) return
    ok=allocation_succeeded(cudaMalloc(pos,n))
    if(ok) ok=allocate_real2(data,n,raw_count)
    if(ok) then
      pos=positions;data=values
      call scatter_kernel<<<(n+255)/256,256>>>(pos,data,n,raw_count,neighborhood)
      call sync_after_kernel('index slice received neighborhood',.true.)
    endif
    if(allocated(pos)) call require_slice_transfer(cudaFree(pos))
    call free_real2(data)
  end subroutine

  attributes(global) subroutine evaluate_kernel(first,extent,lower,shape,origin,intervals,periodic,n,nraw,nfields, &
                                               source,count,neighborhood,result_d)
    use commarray_gpu, only: dxi_d
    integer,value :: n,nraw,nfields,source
    integer(int64),value :: count
    integer,device,intent(in) :: first(3),extent(3),lower(3),shape(3),origin(3),intervals(3)
    logical,device,intent(in) :: periodic(3)
    real(real_kind),device,intent(in) :: neighborhood(:,:)
    real(real_kind),device,intent(out) :: result_d(:,:)
    integer :: node,point(3),local(3),stencil(3),offset(3),sample(3),center,d,c,s,m,slot,field,pos
    real(real_kind) :: directional(4,3),gradient(3,3),density_gradient(3),diagnostic(15),v
    node=(blockidx%x-1)*blockdim%x+threadidx%x-1
    if(node>=n) return
    point=first+[mod(node,extent(1)),mod(node/extent(1),extent(2)),node/(extent(1)*extent(2))]
    local=point-origin
    directional=0;gradient=0;density_gradient=0
    if(any(fields_d(:nfields)>=13)) then
      stencil=point-3
      do d=1,3
        if(.not.periodic(d)) stencil(d)=min(max(stencil(d),0),intervals(d)-6)
      enddo
      offset=point-stencil
      do d=1,3
        do s=0,6
          sample=point-lower;sample(d)=stencil(d)+s-lower(d)
          pos=1+sample(1)+shape(1)*(sample(2)+shape(2)*sample(3))
          do m=1,nraw
            field=raw_ids_d(m)
            if(field>4) cycle
            directional(field,d)=directional(field,d)+weights_d(s+1,offset(d))*neighborhood(pos,m)
          enddo
        enddo
      enddo
      do d=1,3
        do c=1,3
          gradient(c,d)=sum(directional(c+1,:)*dxi_d(local(1),local(2),local(3),:,d))
        enddo
        density_gradient(d)=sum(directional(1,:)*dxi_d(local(1),local(2),local(3),:,d))
      enddo
    endif
    diagnostic(:9)=reshape(gradient,[9])
    diagnostic(10)=-0.5_real_kind*sum(gradient*transpose(gradient))
    diagnostic(11)=gradient(1,1)+gradient(2,2)+gradient(3,3)
    diagnostic(12)=gradient(3,2)-gradient(2,3)
    diagnostic(13)=gradient(1,3)-gradient(3,1)
    diagnostic(14)=gradient(2,1)-gradient(1,2)
    diagnostic(15)=sqrt(sum(density_gradient*density_gradient))
    sample=point-lower;center=1+sample(1)+shape(1)*(sample(2)+shape(2)*sample(3))
    do m=1,nfields
      field=fields_d(m)
      if(field>=13) then
        v=diagnostic(field-12)
      elseif(source==0) then
        v=source_value(local(1),local(2),local(3),field,source,count)
      else
        slot=1
        do c=1,nraw
          if(raw_ids_d(c)==field) slot=c
        enddo
        v=neighborhood(center,slot)
      endif
      result_d(node+1,m)=v
    enddo
  end subroutine

  attributes(global) subroutine coordinate_kernel(first,extent,origin,n,coordinates)
    use commarray_gpu, only: x_d
    integer,value :: n
    integer,device,intent(in) :: first(3),extent(3),origin(3)
    real(real_kind),device,intent(out) :: coordinates(:,:)
    integer :: node,local(3)
    node=(blockidx%x-1)*blockdim%x+threadidx%x-1
    if(node>=n) return
    local=first-origin+[mod(node,extent(1)),mod(node/extent(1),extent(2)),node/(extent(1)*extent(2))]
    coordinates(:,node+1)=x_d(local(1),local(2),local(3),:)
  end subroutine

  subroutine evaluate_index_slice_gpu(first,extent,lower,shape,origin,intervals,periodic,source,count)
    integer,intent(in) :: first(3),extent(3),lower(3),shape(3),origin(3),intervals(3),source
    logical,intent(in) :: periodic(3)
    integer(int64),intent(in) :: count
    integer,device :: first_d(3),extent_d(3),lower_d(3),shape_d(3),origin_d(3),intervals_d(3)
    logical,device :: periodic_d(3)
    integer :: n
    n=product(extent)
    if(n==0) return
    first_d=first;extent_d=extent;lower_d=lower;shape_d=shape;origin_d=origin;intervals_d=intervals
    periodic_d=periodic
    call evaluate_kernel<<<(n+255)/256,256>>>(first_d,extent_d,lower_d,shape_d,origin_d,intervals_d,periodic_d, &
      n,raw_count,field_count,source,count,neighborhood,result_d)
    call sync_after_kernel('index slice physical diagnostics',.true.)
    if(associated(coordinates_d)) then
      call coordinate_kernel<<<(n+255)/256,256>>>(first_d,extent_d,origin_d,n,coordinates_d)
      call sync_after_kernel('index slice retained geometry',.true.)
    endif
  end subroutine

  subroutine download_index_slice_gpu(values,ok)
    real(real_kind),intent(out) :: values(:,:)
    logical,intent(out) :: ok
    integer :: status
    ok=.true.
    if(size(values)==0) return
    status=cudaMemcpy(values,result_d,size(values,kind=int64),cudaMemcpyDeviceToHost)
    call require_slice_transfer(status)
  end subroutine

  subroutine download_index_neighborhood_gpu(values,ok)
    real(real_kind),intent(out) :: values(:,:)
    logical,intent(out) :: ok
    integer :: status
    ok=.true.
    if(size(values)==0) return
    status=cudaMemcpy(values,neighborhood,size(values,kind=int64),cudaMemcpyDeviceToHost)
    call require_slice_transfer(status)
  end subroutine

  subroutine require_slice_transfer(status)
    use mpi, only: MPI_COMM_WORLD,MPI_Abort
    integer,intent(in) :: status
    integer :: ignored
    if(status/=cudaSuccess) then
      print *, 'index slice CUDA transfer failed; device context is not assumed recoverable: ',status
      call MPI_Abort(MPI_COMM_WORLD,status,ignored)
    endif
  end subroutine

  logical function allocation_succeeded(status) result(ok)
    integer,intent(in) :: status
    integer :: code
    ok=status==0
    if(ok) return
    if(status/=cudaErrorMemoryAllocation) call require_slice_transfer(status)
    ! Consume only a recoverable allocation error, not an earlier invalid context.
    code=cudaGetLastError()
    if(code/=cudaSuccess.and.code/=cudaErrorMemoryAllocation) call require_slice_transfer(code)
  end function

  logical function allocate_real2(array,n1,n2) result(ok)
    real(real_kind),pointer,contiguous,device,intent(inout) :: array(:,:)
    integer,intent(in) :: n1,n2
    type(c_devptr) :: address
    ok=allocation_succeeded(cudaMalloc(address,int(n1,int64)*n2*real_bytes))
    if(ok) call c_f_pointer(address,array,[n1,n2])
  end function

  logical function allocate_int2(array,n1,n2) result(ok)
    integer,pointer,contiguous,device,intent(inout) :: array(:,:)
    integer,intent(in) :: n1,n2
    type(c_devptr) :: address
    ok=allocation_succeeded(cudaMalloc(address,int(n1,int64)*n2*(storage_size(0)/8)))
    if(ok) call c_f_pointer(address,array,[n1,n2])
  end function

  subroutine free_real2(array)
    real(real_kind),pointer,contiguous,device,intent(inout) :: array(:,:)
    if(associated(array)) call require_slice_transfer(cudaFree(c_devloc(array)))
    nullify(array)
  end subroutine

  subroutine free_int2(array)
    integer,pointer,contiguous,device,intent(inout) :: array(:,:)
    if(associated(array)) call require_slice_transfer(cudaFree(c_devloc(array)))
    nullify(array)
  end subroutine
end module
