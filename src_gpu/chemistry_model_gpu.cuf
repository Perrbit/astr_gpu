module chemistry_model_gpu
  use iso_fortran_env, only: real64
  use chemistry_air5_data, only: air5_num_species, air5_pressure_min_pa, &
    air5_pressure_max_pa
  use chemistry_model, only: chemistry_status_ok, chemistry_status_invalid_composition, &
    chemistry_status_invalid_density, chemistry_status_nonfinite
  implicit none
  private

  public :: air5_finite_gpu
  public :: air5_validate_partial_densities_gpu
  public :: air5_validate_physical_species_state_gpu
  public :: air5_pressure_is_in_domain_gpu

contains

  attributes(device) logical function air5_finite_gpu(value)
    real(real64), intent(in) :: value

    air5_finite_gpu = value == value .and. abs(value) <= huge(value)
  end function air5_finite_gpu

  attributes(device) subroutine air5_validate_partial_densities_gpu(rho_species,status)
    real(real64), intent(in) :: rho_species(air5_num_species)
    integer, intent(out) :: status
    real(real64) :: density_sum
    integer :: species

    status = chemistry_status_ok
    density_sum = 0.0_real64
    do species = 1, air5_num_species
      if (.not.air5_finite_gpu(rho_species(species))) then
        status = chemistry_status_nonfinite
        return
      end if
      if (rho_species(species) < 0.0_real64) then
        status = chemistry_status_invalid_composition
        return
      end if
      density_sum = density_sum+rho_species(species)
    end do
    if (density_sum <= tiny(1.0_real64)) status = chemistry_status_invalid_composition
  end subroutine air5_validate_partial_densities_gpu

  attributes(device) subroutine air5_validate_physical_species_state_gpu(rho, &
      rho_species,status)
    real(real64), intent(in) :: rho, rho_species(air5_num_species)
    integer, intent(out) :: status
    real(real64) :: density_sum, tolerance
    integer :: species

    if (.not.air5_finite_gpu(rho)) then
      status = chemistry_status_nonfinite
      return
    end if
    if (rho <= 0.0_real64) then
      status = chemistry_status_invalid_density
      return
    end if
    call air5_validate_partial_densities_gpu(rho_species,status)
    if (status /= chemistry_status_ok) return
    density_sum = 0.0_real64
    do species = 1, air5_num_species
      density_sum = density_sum+rho_species(species)
    end do
    tolerance = 1.0e-10_real64*max(rho,1.0_real64)
    if (abs(density_sum-rho) > tolerance) then
      status = chemistry_status_invalid_composition
    else
      status = chemistry_status_ok
    end if
  end subroutine air5_validate_physical_species_state_gpu

  attributes(device) logical function air5_pressure_is_in_domain_gpu(pressure)
    real(real64), intent(in) :: pressure
    real(real64) :: bound_tolerance

    bound_tolerance = 64.0_real64*epsilon(1.0_real64)* &
      max(abs(air5_pressure_max_pa),1.0_real64)
    air5_pressure_is_in_domain_gpu = air5_finite_gpu(pressure) .and. &
      pressure >= air5_pressure_min_pa-bound_tolerance .and. &
      pressure <= air5_pressure_max_pa+bound_tolerance
  end function air5_pressure_is_in_domain_gpu

end module chemistry_model_gpu
