module chemistry_model_gpu
  use iso_fortran_env, only: real64
  use chemistry_air5_data, only: air5_num_species, air5_pressure_min_pa, &
    air5_pressure_max_pa
  use chemistry_model, only: chemistry_status_ok, chemistry_status_invalid_composition, &
    chemistry_status_invalid_density, chemistry_status_nonfinite
  implicit none
  private

  public :: air5_finite_gpu
  public :: air5_validate_partial_densities_gpu
  public :: air5_validate_physical_species_state_gpu
  public :: air5_pressure_is_in_domain_gpu

contains

  attributes(device) logical function air5_finite_gpu(value)
    real(real64), intent(in) :: value

    air5_finite_gpu = value == value .and. abs(value) <= huge(value)
  end function air5_finite_gpu

  attributes(device) subroutine air5_validate_partial_densities_gpu(rho_species,status)
    real(real64), intent(in) :: rho_species(air5_num_species)
    integer, intent(out) :: status
    real(real64) :: density_sum
    integer :: species

    status = chemistry_status_ok
    density_sum = 0.0_real64
    do species = 1, air5_num_species
      if (.not.air5_finite_gpu(rho_species(species))) then
        status = chemistry_status_nonfinite
        return
      end if
      if (rho_species(species) < 0.0_real64) then
        status = chemistry_status_invalid_composition
        return
      end if
      density_sum = density_sum+rho_species(species)
    end do
    if (density_sum <= tiny(1.0_real64)) status = chemistry_status_invalid_composition
  end subroutine air5_validate_partial_densities_gpu

  attributes(device) subroutine air5_validate_physical_species_state_gpu(rho, &
      rho_species,status)
    real(real64), intent(in) :: rho, rho_species(air5_num_species)
    integer, intent(out) :: status
    real(real64) :: density_sum, tolerance
    integer :: species

    if (.not.air5_finite_gpu(rho)) then
      status = chemistry_status_nonfinite
      return
    end if
    if (rho <= 0.0_real64) then
      status = chemistry_status_invalid_density
      return
    end if
    call air5_validate_partial_densities_gpu(rho_species,status)
    if (status /= chemistry_status_ok) return
    density_sum = 0.0_real64
    do species = 1, air5_num_species
      density_sum = density_sum+rho_species(species)
    end do
    tolerance = 1.0e-10_real64*max(rho,1.0_real64)
    if (abs(density_sum-rho) > tolerance) then
      status = chemistry_status_invalid_composition
    else
      status = chemistry_status_ok
    end if
  end subroutine air5_validate_physical_species_state_gpu

  attributes(device) logical function air5_pressure_is_in_domain_gpu(pressure)
    real(real64), intent(in) :: pressure
    real(real64) :: bound_tolerance

    bound_tolerance = 64.0_real64*epsilon(1.0_real64)* &
      max(abs(air5_pressure_max_pa),1.0_real64)
    air5_pressure_is_in_domain_gpu = air5_finite_gpu(pressure) .and. &
      pressure >= air5_pressure_min_pa-bound_tolerance .and. &
      pressure <= air5_pressure_max_pa+bound_tolerance
  end function air5_pressure_is_in_domain_gpu

end module chemistry_model_gpu

module chemistry_thermo_gpu
  use iso_fortran_env, only: real64
  use chemistry_air5_data, only: air5_num_species, air5_molar_mass, &
    air5_formation_energy, air5_cv_tr_factor, air5_theta_v, air5_ru, &
    air5_temperature_min_k, air5_temperature_max_k
  use chemistry_model, only: chemistry_status_ok, chemistry_status_invalid_density, &
    chemistry_status_invalid_composition, chemistry_status_out_of_domain, &
    chemistry_status_no_vibrational_capacity, chemistry_status_nonconverged, &
    chemistry_status_nonfinite
  use chemistry_model_gpu, only: air5_finite_gpu, &
    air5_validate_partial_densities_gpu
  implicit none
  private

  public :: air5_species_gas_constant_gpu
  public :: air5_species_cv_tr_gpu
  public :: air5_species_vibrational_energy_gpu
  public :: air5_species_vibrational_cv_gpu
  public :: air5_tv_from_ev_gpu
  public :: air5_ev_from_tv_gpu
  public :: air5_q5_from_state_gpu
  public :: air5_temperature_from_q5_gpu
  public :: air5_temperature_derivatives_gpu
  public :: air5_tv_derivatives_gpu
  public :: air5_pressure_gpu

contains

  attributes(device) real(real64) function air5_species_gas_constant_gpu(species)
    integer, intent(in) :: species

    air5_species_gas_constant_gpu = air5_ru/air5_molar_mass(species)
  end function air5_species_gas_constant_gpu

  attributes(device) real(real64) function air5_species_cv_tr_gpu(species)
    integer, intent(in) :: species

    air5_species_cv_tr_gpu = air5_cv_tr_factor(species)* &
      air5_species_gas_constant_gpu(species)
  end function air5_species_cv_tr_gpu

  attributes(device) real(real64) function air5_species_vibrational_energy_gpu(species,tv)
    integer, intent(in) :: species
    real(real64), intent(in) :: tv
    real(real64) :: theta

    theta = air5_theta_v(species)
    if (theta > 0.0_real64) then
      air5_species_vibrational_energy_gpu = air5_species_gas_constant_gpu(species)* &
        theta/(exp(theta/tv)-1.0_real64)
    else
      air5_species_vibrational_energy_gpu = 0.0_real64
    end if
  end function air5_species_vibrational_energy_gpu

  attributes(device) real(real64) function air5_species_vibrational_cv_gpu(species,tv)
    integer, intent(in) :: species
    real(real64), intent(in) :: tv
    real(real64) :: theta, x, exponential

    theta = air5_theta_v(species)
    if (theta > 0.0_real64) then
      x = theta/tv
      exponential = exp(x)
      air5_species_vibrational_cv_gpu = air5_species_gas_constant_gpu(species)* &
        x*x*exponential/((exponential-1.0_real64)*(exponential-1.0_real64))
    else
      air5_species_vibrational_cv_gpu = 0.0_real64
    end if
  end function air5_species_vibrational_cv_gpu

  attributes(device) subroutine air5_ev_from_tv_gpu(rho_species,tv,ev,status)
    real(real64), intent(in) :: rho_species(air5_num_species), tv
    real(real64), intent(out) :: ev
    integer, intent(out) :: status
    real(real64) :: vibrating_density
    integer :: species

    ev = 0.0_real64
    call air5_validate_partial_densities_gpu(rho_species,status)
    if (status /= chemistry_status_ok) return
    if (.not.air5_finite_gpu(tv)) then
      status = chemistry_status_nonfinite
      return
    end if
    if (tv < air5_temperature_min_k .or. tv > air5_temperature_max_k) then
      status = chemistry_status_out_of_domain
      return
    end if
    vibrating_density = 0.0_real64
    do species = 1, air5_num_species
      if (air5_theta_v(species) > 0.0_real64) &
        vibrating_density = vibrating_density+rho_species(species)
    end do
    if (vibrating_density <= tiny(1.0_real64)) then
      status = chemistry_status_no_vibrational_capacity
      return
    end if
    do species = 1, air5_num_species
      ev = ev+rho_species(species)*air5_species_vibrational_energy_gpu(species,tv)
    end do
    status = chemistry_status_ok
  end subroutine air5_ev_from_tv_gpu

  attributes(device) subroutine air5_tv_from_ev_gpu(rho_species,ev,tv,status)
    real(real64), intent(in) :: rho_species(air5_num_species), ev
    real(real64), intent(out) :: tv
    integer, intent(out) :: status
    real(real64) :: ev_lower, ev_upper, ev_trial, lower, upper
    real(real64) :: residual_tolerance, vibrating_density
    integer :: iteration, trial_status, species

    tv = air5_temperature_min_k
    call air5_validate_partial_densities_gpu(rho_species,status)
    if (status /= chemistry_status_ok) return
    if (.not.air5_finite_gpu(ev)) then
      status = chemistry_status_nonfinite
      return
    end if
    vibrating_density = 0.0_real64
    do species = 1, air5_num_species
      if (air5_theta_v(species) > 0.0_real64) &
        vibrating_density = vibrating_density+rho_species(species)
    end do
    if (vibrating_density <= tiny(1.0_real64)) then
      status = chemistry_status_no_vibrational_capacity
      return
    end if
    call air5_ev_from_tv_gpu(rho_species,air5_temperature_min_k,ev_lower,trial_status)
    if (trial_status /= chemistry_status_ok) then
      status = trial_status
      return
    end if
    call air5_ev_from_tv_gpu(rho_species,air5_temperature_max_k,ev_upper,trial_status)
    if (trial_status /= chemistry_status_ok) then
      status = trial_status
      return
    end if
    residual_tolerance = 8.0_real64*epsilon(1.0_real64)* &
      max(abs(ev_lower),abs(ev),1.0_real64)
    if (ev < ev_lower-residual_tolerance .or. ev > ev_upper+residual_tolerance) then
      status = chemistry_status_out_of_domain
      return
    end if
    if (abs(ev-ev_lower) <= residual_tolerance) then
      tv = air5_temperature_min_k
      status = chemistry_status_ok
      return
    end if
    if (abs(ev-ev_upper) <= residual_tolerance) then
      tv = air5_temperature_max_k
      status = chemistry_status_ok
      return
    end if
    lower = air5_temperature_min_k
    upper = air5_temperature_max_k
    do iteration = 1, 96
      tv = 0.5_real64*(lower+upper)
      call air5_ev_from_tv_gpu(rho_species,tv,ev_trial,trial_status)
      if (trial_status /= chemistry_status_ok) then
        status = trial_status
        return
      end if
      if (abs(ev_trial-ev) <= residual_tolerance) then
        status = chemistry_status_ok
        return
      end if
      if (ev_trial < ev) then
        lower = tv
      else
        upper = tv
      end if
      if (upper-lower <= 8.0_real64*epsilon(1.0_real64)*max(tv,1.0_real64)) then
        status = chemistry_status_ok
        return
      end if
    end do
    status = chemistry_status_nonconverged
  end subroutine air5_tv_from_ev_gpu

  attributes(device) subroutine air5_q5_from_state_gpu(rho,momentum, &
      rho_species,ev,temperature,q5,status)
    real(real64), intent(in) :: rho,momentum(3),rho_species(air5_num_species)
    real(real64), intent(in) :: ev,temperature
    real(real64), intent(out) :: q5
    integer, intent(out) :: status
    real(real64) :: cv_density,formation_density,kinetic_density
    integer :: species

    q5=0.0_real64
    if(.not.air5_finite_gpu(rho) .or. .not.air5_finite_gpu(ev) .or. &
       .not.air5_finite_gpu(temperature)) then
      status=chemistry_status_nonfinite
      return
    endif
    do species=1,3
      if(.not.air5_finite_gpu(momentum(species))) then
        status=chemistry_status_nonfinite
        return
      endif
    enddo
    if(rho<=0.0_real64) then
      status=chemistry_status_invalid_density
      return
    endif
    call air5_validate_partial_densities_gpu(rho_species,status)
    if(status/=chemistry_status_ok) return
    if(ev<0.0_real64 .or. temperature<air5_temperature_min_k .or. &
       temperature>air5_temperature_max_k) then
      status=chemistry_status_out_of_domain
      return
    endif
    cv_density=0.0_real64
    formation_density=0.0_real64
    do species=1,air5_num_species
      cv_density=cv_density+rho_species(species)*air5_species_cv_tr_gpu(species)
      formation_density=formation_density+rho_species(species)*air5_formation_energy(species)
    enddo
    kinetic_density=(momentum(1)*momentum(1)+momentum(2)*momentum(2)+ &
      momentum(3)*momentum(3))/(2.0_real64*rho)
    q5=kinetic_density+cv_density*temperature+ev+formation_density
    status=chemistry_status_ok
  end subroutine air5_q5_from_state_gpu

  attributes(device) subroutine air5_temperature_from_q5_gpu(rho,momentum, &
      rho_species,ev,q5,temperature,status)
    real(real64), intent(in) :: rho, momentum(3), rho_species(air5_num_species)
    real(real64), intent(in) :: ev, q5
    real(real64), intent(out) :: temperature
    integer, intent(out) :: status
    real(real64) :: cv_density, formation_density, kinetic_density, bound_tolerance
    integer :: species

    temperature = air5_temperature_min_k
    if (.not.air5_finite_gpu(rho) .or. .not.air5_finite_gpu(ev) .or. &
        .not.air5_finite_gpu(q5)) then
      status = chemistry_status_nonfinite
      return
    end if
    do species = 1, 3
      if (.not.air5_finite_gpu(momentum(species))) then
        status = chemistry_status_nonfinite
        return
      end if
    end do
    if (rho <= 0.0_real64) then
      status = chemistry_status_invalid_density
      return
    end if
    call air5_validate_partial_densities_gpu(rho_species,status)
    if (status /= chemistry_status_ok) return
    if (ev < 0.0_real64) then
      status = chemistry_status_out_of_domain
      return
    end if
    cv_density = 0.0_real64
    formation_density = 0.0_real64
    do species = 1, air5_num_species
      cv_density = cv_density+rho_species(species)*air5_species_cv_tr_gpu(species)
      formation_density = formation_density+rho_species(species)*air5_formation_energy(species)
    end do
    if (cv_density <= tiny(1.0_real64)) then
      status = chemistry_status_invalid_composition
      return
    end if
    kinetic_density = (momentum(1)*momentum(1)+momentum(2)*momentum(2)+ &
      momentum(3)*momentum(3))/(2.0_real64*rho)
    temperature = (q5-kinetic_density-ev-formation_density)/cv_density
    bound_tolerance = 64.0_real64*epsilon(1.0_real64)*air5_temperature_max_k
    if (.not.air5_finite_gpu(temperature)) then
      status = chemistry_status_nonfinite
    else if (temperature < air5_temperature_min_k-bound_tolerance .or. &
             temperature > air5_temperature_max_k+bound_tolerance) then
      status = chemistry_status_out_of_domain
    else
      temperature = min(max(temperature,air5_temperature_min_k),air5_temperature_max_k)
      status = chemistry_status_ok
    end if
  end subroutine air5_temperature_from_q5_gpu

  attributes(device) subroutine air5_temperature_derivatives_gpu(rho_species, &
      temperature,dt_dz,dt_dev,status)
    real(real64), intent(in) :: rho_species(air5_num_species), temperature
    real(real64), intent(out) :: dt_dz(air5_num_species), dt_dev
    integer, intent(out) :: status
    real(real64) :: cv_density
    integer :: species

    dt_dz = 0.0_real64
    dt_dev = 0.0_real64
    call air5_validate_partial_densities_gpu(rho_species,status)
    if (status /= chemistry_status_ok) return
    if (.not.air5_finite_gpu(temperature)) then
      status = chemistry_status_nonfinite
      return
    end if
    if (temperature < air5_temperature_min_k .or. &
        temperature > air5_temperature_max_k) then
      status = chemistry_status_out_of_domain
      return
    end if
    cv_density = 0.0_real64
    do species = 1, air5_num_species
      cv_density = cv_density+rho_species(species)*air5_species_cv_tr_gpu(species)
    end do
    if (cv_density <= tiny(1.0_real64)) then
      status = chemistry_status_invalid_composition
      return
    end if
    do species = 1, air5_num_species
      dt_dz(species) = -(air5_formation_energy(species)+ &
        air5_species_cv_tr_gpu(species)*temperature)/cv_density
    end do
    dt_dev = -1.0_real64/cv_density
    status = chemistry_status_ok
  end subroutine air5_temperature_derivatives_gpu

  attributes(device) subroutine air5_tv_derivatives_gpu(rho_species,tv, &
      dtv_dz,dtv_dev,status)
    real(real64), intent(in) :: rho_species(air5_num_species), tv
    real(real64), intent(out) :: dtv_dz(air5_num_species), dtv_dev
    integer, intent(out) :: status
    real(real64) :: cv_v_density
    integer :: species

    dtv_dz = 0.0_real64
    dtv_dev = 0.0_real64
    call air5_validate_partial_densities_gpu(rho_species,status)
    if (status /= chemistry_status_ok) return
    if (.not.air5_finite_gpu(tv)) then
      status = chemistry_status_nonfinite
      return
    end if
    if (tv < air5_temperature_min_k .or. tv > air5_temperature_max_k) then
      status = chemistry_status_out_of_domain
      return
    end if
    cv_v_density = 0.0_real64
    do species = 1, air5_num_species
      cv_v_density = cv_v_density+rho_species(species)* &
        air5_species_vibrational_cv_gpu(species,tv)
    end do
    if (cv_v_density <= tiny(1.0_real64)) then
      status = chemistry_status_no_vibrational_capacity
      return
    end if
    do species = 1, air5_num_species
      dtv_dz(species) = -air5_species_vibrational_energy_gpu(species,tv)/cv_v_density
    end do
    dtv_dev = 1.0_real64/cv_v_density
    status = chemistry_status_ok
  end subroutine air5_tv_derivatives_gpu

  attributes(device) subroutine air5_pressure_gpu(rho_species,temperature,pressure,status)
    real(real64), intent(in) :: rho_species(air5_num_species), temperature
    real(real64), intent(out) :: pressure
    integer, intent(out) :: status
    integer :: species

    pressure = 0.0_real64
    call air5_validate_partial_densities_gpu(rho_species,status)
    if (status /= chemistry_status_ok) return
    if (.not.air5_finite_gpu(temperature)) then
      status = chemistry_status_nonfinite
      return
    end if
    if (temperature < air5_temperature_min_k .or. &
        temperature > air5_temperature_max_k) then
      status = chemistry_status_out_of_domain
      return
    end if
    do species = 1, air5_num_species
      pressure = pressure+rho_species(species)* &
        air5_species_gas_constant_gpu(species)*temperature
    end do
    status = chemistry_status_ok
  end subroutine air5_pressure_gpu

end module chemistry_thermo_gpu
