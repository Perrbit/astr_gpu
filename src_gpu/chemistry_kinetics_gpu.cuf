module chemistry_linear6_gpu
  use iso_fortran_env, only: real64
  use chemistry_model, only: chemistry_status_ok, chemistry_status_linear_failure, &
    chemistry_status_nonfinite
  use chemistry_model_gpu, only: air5_finite_gpu
  implicit none
  private

  integer, parameter :: linear_size = 6

  public :: air5_lu_factor_6_gpu
  public :: air5_lu_solve_6_gpu

contains

  attributes(device) subroutine air5_lu_factor_6_gpu(matrix,lu,pivots,status)
    real(real64), intent(in) :: matrix(linear_size,linear_size)
    real(real64), intent(out) :: lu(linear_size,linear_size)
    integer, intent(out) :: pivots(linear_size), status
    real(real64) :: row_scale(linear_size), scaled_pivot, best_scaled_pivot
    real(real64) :: value, scale_buffer
    integer :: column, pivot, row, item

    do row = 1, linear_size
      pivots(row) = row
      row_scale(row) = 0.0_real64
      do column = 1, linear_size
        value = matrix(row,column)
        lu(row,column) = value
        if (.not.air5_finite_gpu(value)) then
          status = chemistry_status_nonfinite
          return
        end if
        row_scale(row) = max(row_scale(row),abs(value))
      end do
      if (row_scale(row) == 0.0_real64) then
        status = chemistry_status_linear_failure
        return
      end if
    end do

    do column = 1, linear_size-1
      pivot = column
      best_scaled_pivot = abs(lu(column,column))/row_scale(column)
      do row = column+1, linear_size
        scaled_pivot = abs(lu(row,column))/row_scale(row)
        if (scaled_pivot > best_scaled_pivot) then
          pivot = row
          best_scaled_pivot = scaled_pivot
        end if
      end do
      if (best_scaled_pivot <= 64.0_real64*epsilon(1.0_real64)) then
        status = chemistry_status_linear_failure
        return
      end if
      pivots(column) = pivot
      if (pivot /= column) then
        do item = 1, linear_size
          value = lu(column,item)
          lu(column,item) = lu(pivot,item)
          lu(pivot,item) = value
        end do
        scale_buffer = row_scale(column)
        row_scale(column) = row_scale(pivot)
        row_scale(pivot) = scale_buffer
      end if
      do row = column+1, linear_size
        lu(row,column) = lu(row,column)/lu(column,column)
        do item = column+1, linear_size
          lu(row,item) = lu(row,item)-lu(row,column)*lu(column,item)
        end do
      end do
    end do
    if (abs(lu(linear_size,linear_size))/row_scale(linear_size) <= &
        64.0_real64*epsilon(1.0_real64)) then
      status = chemistry_status_linear_failure
      return
    end if
    do row = 1, linear_size
      do column = 1, linear_size
        if (.not.air5_finite_gpu(lu(row,column))) then
          status = chemistry_status_linear_failure
          return
        end if
      end do
    end do
    status = chemistry_status_ok
  end subroutine air5_lu_factor_6_gpu

  attributes(device) subroutine air5_lu_solve_6_gpu(lu,pivots,rhs,solution,status)
    real(real64), intent(in) :: lu(linear_size,linear_size), rhs(linear_size)
    integer, intent(in) :: pivots(linear_size)
    real(real64), intent(out) :: solution(linear_size)
    integer, intent(out) :: status
    real(real64) :: value
    integer :: column, pivot, row, item

    do row = 1, linear_size
      solution(row) = 0.0_real64
      if (pivots(row) < 1 .or. pivots(row) > linear_size) then
        status = chemistry_status_linear_failure
        return
      end if
      if (.not.air5_finite_gpu(rhs(row))) then
        status = chemistry_status_nonfinite
        return
      end if
      do column = 1, linear_size
        if (.not.air5_finite_gpu(lu(row,column))) then
          status = chemistry_status_nonfinite
          return
        end if
      end do
    end do

    solution = rhs
    do column = 1, linear_size-1
      pivot = pivots(column)
      if (pivot /= column) then
        value = solution(column)
        solution(column) = solution(pivot)
        solution(pivot) = value
      end if
    end do
    do row = 2, linear_size
      value = 0.0_real64
      do item = 1, row-1
        value = value+lu(row,item)*solution(item)
      end do
      solution(row) = solution(row)-value
    end do
    do row = linear_size, 1, -1
      if (lu(row,row) == 0.0_real64) then
        solution = 0.0_real64
        status = chemistry_status_linear_failure
        return
      end if
      value = 0.0_real64
      do item = row+1, linear_size
        value = value+lu(row,item)*solution(item)
      end do
      solution(row) = (solution(row)-value)/lu(row,row)
    end do
    do row = 1, linear_size
      if (.not.air5_finite_gpu(solution(row))) then
        solution = 0.0_real64
        status = chemistry_status_nonfinite
        return
      end if
    end do
    status = chemistry_status_ok
  end subroutine air5_lu_solve_6_gpu

end module chemistry_linear6_gpu

module chemistry_source_gpu
  use iso_fortran_env, only: real64
  use cudafor
  use chemistry_air5_data, only: air5_num_species, air5_num_reactions, &
    air5_molar_mass, air5_nu_reactant, air5_nu_product, &
    air5_third_body_efficiency, air5_has_third_body, air5_rate_uses_tv, &
    air5_arrhenius_a, air5_arrhenius_b, air5_activation_temperature, &
    air5_ln_kc_coefficient, air5_psi_coefficient, air5_psi_bounds
  use chemistry_model, only: chemistry_status_ok, chemistry_status_out_of_domain, &
    chemistry_status_nonfinite, chemistry_status_invalid_source_mode
  use chemistry_source, only: air5_source_mode_coupled, &
    air5_source_mode_chemical, air5_source_mode_vt
  use chemistry_model_gpu, only: air5_finite_gpu, &
    air5_validate_partial_densities_gpu, air5_pressure_is_in_domain_gpu
  use chemistry_thermo_gpu, only: air5_temperature_from_q5_gpu, &
    air5_tv_from_ev_gpu, air5_temperature_derivatives_gpu, &
    air5_tv_derivatives_gpu, air5_pressure_gpu, air5_species_gas_constant_gpu, &
    air5_species_vibrational_energy_gpu, air5_species_vibrational_cv_gpu
  use chemistry_relaxation_gpu, only: air5_vt_relaxation_source_derivatives_gpu
  use gpu_check, only: sync_after_kernel
  implicit none
  private

  public :: air5_instantaneous_source_jacobian_gpu
  public :: air5_instantaneous_source_gpu
  public :: launch_air5_source_batch_gpu

contains

  attributes(device) real(real64) function air5_mass_action_gpu(concentration, &
      stoichiometry)
    real(real64), intent(in) :: concentration(air5_num_species)
    integer, intent(in) :: stoichiometry(air5_num_species)
    integer :: species, exponent

    air5_mass_action_gpu = 1.0_real64
    do species = 1, air5_num_species
      do exponent = 1, stoichiometry(species)
        air5_mass_action_gpu = air5_mass_action_gpu*concentration(species)
      end do
    end do
  end function air5_mass_action_gpu

  attributes(device) real(real64) function air5_mass_action_derivative_gpu( &
      concentration,stoichiometry,variable)
    real(real64), intent(in) :: concentration(air5_num_species)
    integer, intent(in) :: stoichiometry(air5_num_species), variable
    real(real64) :: reduced_product
    integer :: species, exponent, reduced_exponent

    air5_mass_action_derivative_gpu = 0.0_real64
    if (variable > air5_num_species) return
    if (stoichiometry(variable) == 0) return
    reduced_product = 1.0_real64
    do species = 1, air5_num_species
      reduced_exponent = stoichiometry(species)
      if (species == variable) reduced_exponent = reduced_exponent-1
      do exponent = 1, reduced_exponent
        reduced_product = reduced_product*concentration(species)
      end do
    end do
    air5_mass_action_derivative_gpu = real(stoichiometry(variable),real64)* &
      reduced_product/air5_molar_mass(variable)
  end function air5_mass_action_derivative_gpu

  attributes(device) subroutine air5_preferential_factor_gpu(species,temperature, &
      factor,derivative)
    integer, intent(in) :: species
    real(real64), intent(in) :: temperature
    real(real64), intent(out) :: factor, derivative
    real(real64) :: exponent, raw_factor, raw_derivative

    exponent = air5_psi_coefficient(1,species)/temperature+ &
      air5_psi_coefficient(2,species)+ &
      air5_psi_coefficient(3,species)*log(temperature)+ &
      air5_psi_coefficient(4,species)*temperature+ &
      air5_psi_coefficient(5,species)*temperature*temperature
    raw_factor = exp(exponent)
    raw_derivative = raw_factor*(-air5_psi_coefficient(1,species)/( &
      temperature*temperature)+air5_psi_coefficient(3,species)/temperature+ &
      air5_psi_coefficient(4,species)+ &
      2.0_real64*air5_psi_coefficient(5,species)*temperature)
    if (raw_factor <= air5_psi_bounds(1,species)) then
      factor = air5_psi_bounds(1,species)
      derivative = 0.0_real64
    else if (raw_factor >= air5_psi_bounds(2,species)) then
      factor = air5_psi_bounds(2,species)
      derivative = 0.0_real64
    else
      factor = raw_factor
      derivative = raw_derivative
    end if
  end subroutine air5_preferential_factor_gpu

  attributes(device) subroutine air5_instantaneous_source_jacobian_gpu(rho, &
      momentum,q5,state,source,jacobian,reaction_progress,status,source_mode)
    real(real64), intent(in) :: rho, momentum(3), q5, state(6)
    real(real64), intent(out) :: source(6), jacobian(6,6)
    real(real64), intent(out) :: reaction_progress(air5_num_reactions)
    integer, intent(out) :: status
    integer, intent(in) :: source_mode
    real(real64) :: temperature, tv, pressure, concentration(air5_num_species)
    real(real64) :: dtemperature(6), dtv(6), dt_dz(air5_num_species)
    real(real64) :: dtv_dz(air5_num_species), dt_dev, dtv_dev
    real(real64) :: third_body, dthird_body, forward_product, reverse_product
    real(real64) :: forward_coefficient, reverse_coefficient, equilibrium_constant
    real(real64) :: forward_rate, reverse_rate, progress_rate
    real(real64) :: dforward_product, dreverse_product, dforward_coefficient
    real(real64) :: dreverse_coefficient, dforward_rate, dreverse_rate
    real(real64) :: dprogress_rate(6), rate_temperature, drate_temperature
    real(real64) :: z10000, ln_kc, dln_kc_dtemperature, dln_kc
    real(real64) :: energy_per_mass, denergy_per_mass, psi, dpsi_dtemperature
    real(real64) :: mass_factor, vt_source, vt_derivatives(6)
    integer :: reaction, species, variable, local_status, net_stoichiometry
    logical :: include_chemical, include_vt

    source = 0.0_real64
    jacobian = 0.0_real64
    reaction_progress = 0.0_real64
    if (source_mode < air5_source_mode_coupled .or. &
        source_mode > air5_source_mode_vt) then
      status = chemistry_status_invalid_source_mode
      return
    end if
    include_chemical = source_mode == air5_source_mode_coupled .or. &
      source_mode == air5_source_mode_chemical
    include_vt = source_mode == air5_source_mode_coupled .or. &
      source_mode == air5_source_mode_vt
    call air5_validate_partial_densities_gpu(state(1:air5_num_species),status)
    if (status /= chemistry_status_ok) return
    do variable = 1, 6
      if (.not.air5_finite_gpu(state(variable))) then
        status = chemistry_status_nonfinite
        return
      end if
    end do
    if (state(6) < 0.0_real64) then
      status = chemistry_status_out_of_domain
      return
    end if
    call air5_temperature_from_q5_gpu(rho,momentum,state(1:air5_num_species), &
      state(6),q5,temperature,status)
    if (status /= chemistry_status_ok) return
    call air5_tv_from_ev_gpu(state(1:air5_num_species),state(6),tv,status)
    if (status /= chemistry_status_ok) return
    call air5_pressure_gpu(state(1:air5_num_species),temperature,pressure,status)
    if (status /= chemistry_status_ok) return
    if (.not.air5_pressure_is_in_domain_gpu(pressure)) then
      status = chemistry_status_out_of_domain
      return
    end if
    call air5_temperature_derivatives_gpu(state(1:air5_num_species),temperature, &
      dt_dz,dt_dev,status)
    if (status /= chemistry_status_ok) return
    call air5_tv_derivatives_gpu(state(1:air5_num_species),tv,dtv_dz,dtv_dev,status)
    if (status /= chemistry_status_ok) return
    dtemperature(1:air5_num_species) = dt_dz
    dtemperature(6) = dt_dev
    dtv(1:air5_num_species) = dtv_dz
    dtv(6) = dtv_dev

    if (include_chemical) then
      do species = 1, air5_num_species
        concentration(species) = state(species)/air5_molar_mass(species)
      end do
      do reaction = 1, air5_num_reactions
        third_body = 1.0_real64
        if (air5_has_third_body(reaction)) then
          third_body = 0.0_real64
          do species = 1, air5_num_species
            third_body = third_body+air5_third_body_efficiency(species,reaction)* &
              concentration(species)
          end do
        end if
        forward_product = air5_mass_action_gpu(concentration, &
          air5_nu_reactant(:,reaction))
        reverse_product = air5_mass_action_gpu(concentration, &
          air5_nu_product(:,reaction))
        if (air5_rate_uses_tv(reaction)) then
          rate_temperature = sqrt(temperature*tv)
        else
          rate_temperature = temperature
        end if
        forward_coefficient = air5_arrhenius_a(reaction)* &
          rate_temperature**air5_arrhenius_b(reaction)* &
          exp(-air5_activation_temperature(reaction)/rate_temperature)
        z10000 = 10000.0_real64/temperature
        ln_kc = air5_ln_kc_coefficient(1,reaction)/z10000+ &
          air5_ln_kc_coefficient(2,reaction)+ &
          air5_ln_kc_coefficient(3,reaction)*log(z10000)+ &
          air5_ln_kc_coefficient(4,reaction)*z10000+ &
          air5_ln_kc_coefficient(5,reaction)*z10000*z10000
        equilibrium_constant = exp(ln_kc)
        reverse_coefficient = air5_arrhenius_a(reaction)* &
          temperature**air5_arrhenius_b(reaction)* &
          exp(-air5_activation_temperature(reaction)/temperature)/equilibrium_constant
        forward_rate = forward_coefficient*third_body*forward_product
        reverse_rate = reverse_coefficient*third_body*reverse_product
        progress_rate = forward_rate-reverse_rate
        reaction_progress(reaction) = progress_rate

        dln_kc_dtemperature = (-air5_ln_kc_coefficient(1,reaction)/(z10000*z10000)+ &
          air5_ln_kc_coefficient(3,reaction)/z10000+ &
          air5_ln_kc_coefficient(4,reaction)+ &
          2.0_real64*air5_ln_kc_coefficient(5,reaction)*z10000)* &
          (-z10000/temperature)
        do variable = 1, 6
          if (air5_rate_uses_tv(reaction)) then
            drate_temperature = 0.5_real64*rate_temperature*( &
              dtemperature(variable)/temperature+dtv(variable)/tv)
          else
            drate_temperature = dtemperature(variable)
          end if
          dforward_coefficient = forward_coefficient*( &
            air5_arrhenius_b(reaction)/rate_temperature+ &
            air5_activation_temperature(reaction)/(rate_temperature*rate_temperature))* &
            drate_temperature
          dln_kc = dln_kc_dtemperature*dtemperature(variable)
          dreverse_coefficient = reverse_coefficient*(( &
            air5_arrhenius_b(reaction)/temperature+ &
            air5_activation_temperature(reaction)/(temperature*temperature))* &
            dtemperature(variable)-dln_kc)
          dthird_body = 0.0_real64
          if (air5_has_third_body(reaction) .and. variable <= air5_num_species) then
            dthird_body = air5_third_body_efficiency(variable,reaction)/ &
              air5_molar_mass(variable)
          end if
          dforward_product = air5_mass_action_derivative_gpu(concentration, &
            air5_nu_reactant(:,reaction),variable)
          dreverse_product = air5_mass_action_derivative_gpu(concentration, &
            air5_nu_product(:,reaction),variable)
          dforward_rate = dforward_coefficient*third_body*forward_product+ &
            forward_coefficient*dthird_body*forward_product+ &
            forward_coefficient*third_body*dforward_product
          dreverse_rate = dreverse_coefficient*third_body*reverse_product+ &
            reverse_coefficient*dthird_body*reverse_product+ &
            reverse_coefficient*third_body*dreverse_product
          dprogress_rate(variable) = dforward_rate-dreverse_rate
        end do

        do species = 1, air5_num_species
          net_stoichiometry = air5_nu_product(species,reaction)- &
            air5_nu_reactant(species,reaction)
          if (net_stoichiometry == 0) cycle
          mass_factor = air5_molar_mass(species)*real(net_stoichiometry,real64)
          source(species) = source(species)+mass_factor*progress_rate
          do variable = 1, 6
            jacobian(species,variable) = jacobian(species,variable)+ &
              mass_factor*dprogress_rate(variable)
          end do
          if (air5_psi_bounds(2,species) <= 0.0_real64) cycle
          if (air5_rate_uses_tv(reaction)) then
            call air5_preferential_factor_gpu(species,temperature,psi, &
              dpsi_dtemperature)
            energy_per_mass = psi*air5_species_gas_constant_gpu(species)* &
              air5_activation_temperature(reaction)
            source(6) = source(6)+mass_factor*progress_rate*energy_per_mass
            do variable = 1, 6
              denergy_per_mass = dpsi_dtemperature*dtemperature(variable)* &
                air5_species_gas_constant_gpu(species)* &
                air5_activation_temperature(reaction)
              jacobian(6,variable) = jacobian(6,variable)+mass_factor*( &
                dprogress_rate(variable)*energy_per_mass+ &
                progress_rate*denergy_per_mass)
            end do
          else
            energy_per_mass = air5_species_vibrational_energy_gpu(species,tv)
            source(6) = source(6)+mass_factor*progress_rate*energy_per_mass
            do variable = 1, 6
              denergy_per_mass = air5_species_vibrational_cv_gpu(species,tv)*dtv(variable)
              jacobian(6,variable) = jacobian(6,variable)+mass_factor*( &
                dprogress_rate(variable)*energy_per_mass+ &
                progress_rate*denergy_per_mass)
            end do
          end if
        end do
      end do
    end if

    if (include_vt) then
      call air5_vt_relaxation_source_derivatives_gpu(state(1:air5_num_species), &
        temperature,tv,dtemperature,dtv,vt_source,vt_derivatives,local_status)
      if (local_status /= chemistry_status_ok) then
        status = local_status
        return
      end if
      source(6) = source(6)+vt_source
      do variable = 1, 6
        jacobian(6,variable) = jacobian(6,variable)+vt_derivatives(variable)
      end do
    end if
    do variable = 1, 6
      if (.not.air5_finite_gpu(source(variable))) then
        status = chemistry_status_nonfinite
        return
      end if
      do species = 1, 6
        if (.not.air5_finite_gpu(jacobian(species,variable))) then
          status = chemistry_status_nonfinite
          return
        end if
      end do
    end do
    do reaction = 1, air5_num_reactions
      if (.not.air5_finite_gpu(reaction_progress(reaction))) then
        status = chemistry_status_nonfinite
        return
      end if
    end do
    status = chemistry_status_ok
  end subroutine air5_instantaneous_source_jacobian_gpu

  attributes(device) subroutine air5_instantaneous_source_gpu(rho,momentum,q5, &
      state,source,status,source_mode)
    real(real64), intent(in) :: rho, momentum(3), q5, state(6)
    real(real64), intent(out) :: source(6)
    integer, intent(out) :: status
    integer, intent(in) :: source_mode
    real(real64) :: jacobian(6,6), reaction_progress(air5_num_reactions)

    call air5_instantaneous_source_jacobian_gpu(rho,momentum,q5,state,source, &
      jacobian,reaction_progress,status,source_mode)
  end subroutine air5_instantaneous_source_gpu

  attributes(global) subroutine air5_source_batch_kernel(rho,momentum,q5,state, &
      source,total_energy_source,jacobian,reaction_progress,status,count,source_mode)
    integer, value :: count, source_mode
    real(real64), device, intent(in) :: rho(count), momentum(3,count), q5(count)
    real(real64), device, intent(in) :: state(6,count)
    real(real64), device, intent(out) :: source(6,count), total_energy_source(count)
    real(real64), device, intent(out) :: jacobian(6,6,count)
    real(real64), device, intent(out) :: reaction_progress(air5_num_reactions,count)
    integer, device, intent(out) :: status(count)
    integer :: index

    index = (blockIdx%x-1)*blockDim%x+threadIdx%x
    if (index > count) return
    total_energy_source(index) = 0.0_real64
    call air5_instantaneous_source_jacobian_gpu(rho(index),momentum(:,index), &
      q5(index),state(:,index),source(:,index),jacobian(:,:,index), &
      reaction_progress(:,index),status(index),source_mode)
  end subroutine air5_source_batch_kernel

  subroutine launch_air5_source_batch_gpu(rho,momentum,q5,state,source, &
      total_energy_source,jacobian,reaction_progress,status,count,source_mode)
    integer, intent(in) :: count, source_mode
    real(real64), device, intent(in) :: rho(count), momentum(3,count), q5(count)
    real(real64), device, intent(in) :: state(6,count)
    real(real64), device, intent(out) :: source(6,count), total_energy_source(count)
    real(real64), device, intent(out) :: jacobian(6,6,count)
    real(real64), device, intent(out) :: reaction_progress(air5_num_reactions,count)
    integer, device, intent(out) :: status(count)
    type(dim3) :: block, grid

    if (count <= 0) return
    block = dim3(128,1,1)
    grid = dim3((count+block%x-1)/block%x,1,1)
    call air5_source_batch_kernel<<<grid,block>>>(rho,momentum,q5,state,source, &
      total_energy_source,jacobian,reaction_progress,status,count,source_mode)
    call sync_after_kernel('air5_source_batch_kernel',force_sync=.true.)
  end subroutine launch_air5_source_batch_gpu

end module chemistry_source_gpu

module chemistry_ros2_gpu
  use iso_fortran_env, only: real64
  use cudafor
  use chemistry_air5_data, only: air5_num_species, air5_num_reactions
  use chemistry_model, only: chemistry_status_ok, chemistry_status_out_of_domain, &
    chemistry_status_nonfinite, chemistry_status_invalid_timestep, &
    chemistry_status_invalid_tolerance, chemistry_status_step_limit
  use chemistry_ros2, only: air5_ros2_gamma, air5_ros2_a21, air5_ros2_c21, &
    air5_ros2_m1, air5_ros2_m2, air5_ros2_e1, air5_ros2_e2
  use chemistry_model_gpu, only: air5_finite_gpu, &
    air5_validate_physical_species_state_gpu, air5_pressure_is_in_domain_gpu
  use chemistry_thermo_gpu, only: air5_temperature_from_q5_gpu, &
    air5_tv_from_ev_gpu, air5_pressure_gpu
  use chemistry_source_gpu, only: air5_instantaneous_source_gpu, &
    air5_instantaneous_source_jacobian_gpu
  use chemistry_linear6_gpu, only: air5_lu_factor_6_gpu, air5_lu_solve_6_gpu
  use gpu_check, only: sync_after_kernel
  implicit none
  private

  public :: air5_ros2_advance_gpu
  public :: launch_air5_ros2_batch_gpu

contains

  attributes(device) subroutine air5_validate_ros2_candidate_gpu(rho,momentum, &
      q5,state,status)
    real(real64), intent(in) :: rho, momentum(3), q5, state(6)
    integer, intent(out) :: status
    real(real64) :: temperature, tv, pressure

    call air5_validate_physical_species_state_gpu(rho, &
      state(1:air5_num_species),status)
    if (status /= chemistry_status_ok) return
    if (.not.air5_finite_gpu(state(6))) then
      status = chemistry_status_nonfinite
      return
    end if
    if (state(6) < 0.0_real64) then
      status = chemistry_status_out_of_domain
      return
    end if
    call air5_temperature_from_q5_gpu(rho,momentum,state(1:air5_num_species), &
      state(6),q5,temperature,status)
    if (status /= chemistry_status_ok) return
    call air5_tv_from_ev_gpu(state(1:air5_num_species),state(6),tv,status)
    if (status /= chemistry_status_ok) return
    call air5_pressure_gpu(state(1:air5_num_species),temperature,pressure,status)
    if (status /= chemistry_status_ok) return
    if (.not.air5_pressure_is_in_domain_gpu(pressure)) then
      status = chemistry_status_out_of_domain
    else
      status = chemistry_status_ok
    end if
  end subroutine air5_validate_ros2_candidate_gpu

  attributes(device) subroutine air5_ros2_fixed_step_gpu(rho,momentum,q5,state, &
      step,candidate,error_estimate,status,retryable,rhs_evaluations, &
      jacobian_evaluations,source_mode,compensation)
    real(real64), intent(in) :: rho, momentum(3), q5, state(6), step
    real(real64), intent(out) :: candidate(6), error_estimate(6)
    integer, intent(out) :: status, rhs_evaluations, jacobian_evaluations
    logical, intent(out) :: retryable
    integer, intent(in) :: source_mode
    real(real64), intent(inout), optional :: compensation(6)
    real(real64) :: carry(6), adjusted, updated
    real(real64) :: source(6), jacobian(6,6)
    real(real64) :: reaction_progress(air5_num_reactions)
    real(real64) :: matrix(6,6), lu(6,6), stage_state(6)
    real(real64) :: stage_source(6), k1(6), k2(6), rhs(6)
    integer :: pivots(6), index, row

    candidate = state
    error_estimate = 0.0_real64
    retryable = .false.
    rhs_evaluations = 0
    jacobian_evaluations = 0
    if (present(compensation)) then
      do index = 1, 6
        if (.not.air5_finite_gpu(compensation(index))) then
          status = chemistry_status_nonfinite
          return
        end if
      end do
    end if
    if (.not.air5_finite_gpu(step) .or. step <= 0.0_real64) then
      status = chemistry_status_invalid_timestep
      return
    end if
    call air5_instantaneous_source_jacobian_gpu(rho,momentum,q5,state,source, &
      jacobian,reaction_progress,status,source_mode)
    rhs_evaluations = 1
    jacobian_evaluations = 1
    if (status /= chemistry_status_ok) return
    retryable = .true.

    do row = 1, 6
      do index = 1, 6
        matrix(row,index) = -step*air5_ros2_gamma*jacobian(row,index)
      end do
      matrix(row,row) = matrix(row,row)+1.0_real64
      rhs(row) = step*air5_ros2_gamma*source(row)
    end do
    call air5_lu_factor_6_gpu(matrix,lu,pivots,status)
    if (status /= chemistry_status_ok) return
    call air5_lu_solve_6_gpu(lu,pivots,rhs,k1,status)
    if (status /= chemistry_status_ok) return

    do index = 1, 6
      stage_state(index) = state(index)+air5_ros2_a21*k1(index)
    end do
    call air5_instantaneous_source_gpu(rho,momentum,q5,stage_state,stage_source, &
      status,source_mode)
    rhs_evaluations = 2
    if (status /= chemistry_status_ok) return

    do index = 1, 6
      rhs(index) = step*air5_ros2_gamma*stage_source(index)+ &
        air5_ros2_gamma*air5_ros2_c21*k1(index)
    end do
    call air5_lu_solve_6_gpu(lu,pivots,rhs,k2,status)
    if (status /= chemistry_status_ok) return
    do index = 1, 6
      candidate(index) = state(index)+air5_ros2_m1*k1(index)+air5_ros2_m2*k2(index)
      if (present(compensation)) then
        adjusted = air5_ros2_m1*k1(index)-compensation(index)
        updated = state(index)+adjusted
        carry(index) = (updated-state(index))-adjusted
        adjusted = air5_ros2_m2*k2(index)-carry(index)
        candidate(index) = updated+adjusted
        carry(index) = (candidate(index)-updated)-adjusted
      end if
      error_estimate(index) = air5_ros2_e1*k1(index)+air5_ros2_e2*k2(index)
      if (.not.air5_finite_gpu(candidate(index)) .or. &
          .not.air5_finite_gpu(error_estimate(index))) then
        candidate = state
        error_estimate = 0.0_real64
        status = chemistry_status_nonfinite
        return
      end if
    end do
    call air5_validate_ros2_candidate_gpu(rho,momentum,q5,candidate,status)
    if (status /= chemistry_status_ok) then
      candidate = state
      error_estimate = 0.0_real64
    end if
    if (status == chemistry_status_ok .and. present(compensation)) compensation = carry
  end subroutine air5_ros2_fixed_step_gpu

  attributes(device) subroutine air5_ros2_weighted_error_norm_gpu(state,candidate, &
      estimate,rtol,atol,error_norm)
    real(real64), intent(in) :: state(6), candidate(6), estimate(6), rtol, atol(6)
    real(real64), intent(out) :: error_norm
    real(real64) :: scaled(6), maximum_scaled, sum_squares
    integer :: index

    maximum_scaled = 0.0_real64
    do index = 1, 6
      scaled(index) = abs(estimate(index))/(atol(index)+ &
        rtol*max(abs(state(index)),abs(candidate(index))))
      maximum_scaled = max(maximum_scaled,scaled(index))
    end do
    if (.not.air5_finite_gpu(maximum_scaled)) then
      error_norm = huge(1.0_real64)
    else if (maximum_scaled == 0.0_real64) then
      error_norm = 0.0_real64
    else
      sum_squares = 0.0_real64
      do index = 1, 6
        sum_squares = sum_squares+(scaled(index)/maximum_scaled)**2
      end do
      error_norm = maximum_scaled*sqrt(sum_squares/6.0_real64)
    end if
  end subroutine air5_ros2_weighted_error_norm_gpu

  attributes(device) subroutine air5_ros2_advance_gpu(rho,momentum,q5,state, &
      duration,initial_step,rtol,atol,max_attempts,final_state,suggested_step, &
      accepted_steps,rejected_steps,rhs_evaluations,jacobian_evaluations,status, &
      source_mode,compensation)
    real(real64), intent(in) :: rho, momentum(3), q5, state(6), duration
    real(real64), intent(in) :: initial_step, rtol, atol(6)
    integer, intent(in) :: max_attempts, source_mode
    real(real64), intent(inout), optional :: compensation(6)
    real(real64) :: current_carry(6), trial_carry(6)
    real(real64), intent(out) :: final_state(6), suggested_step
    integer, intent(out) :: accepted_steps, rejected_steps
    integer, intent(out) :: rhs_evaluations, jacobian_evaluations, status
    real(real64), parameter :: safety = 0.9_real64
    real(real64), parameter :: minimum_factor = 0.2_real64
    real(real64), parameter :: maximum_factor = 5.0_real64
    real(real64) :: current(6), candidate(6), error_estimate(6)
    real(real64) :: elapsed, step, remaining, error_norm, factor
    integer :: attempt, attempt_rhs, attempt_jac, attempt_status, index
    logical :: retryable, previous_rejected

    final_state = state
    suggested_step = 0.0_real64
    accepted_steps = 0
    rejected_steps = 0
    rhs_evaluations = 0
    jacobian_evaluations = 0
    status = chemistry_status_ok
    if (.not.air5_finite_gpu(duration) .or. .not.air5_finite_gpu(initial_step)) then
      status = chemistry_status_invalid_timestep
      return
    end if
    if (duration <= 0.0_real64 .or. initial_step <= 0.0_real64) then
      status = chemistry_status_invalid_timestep
      return
    end if
    if (.not.air5_finite_gpu(rtol)) then
      status = chemistry_status_invalid_tolerance
      return
    end if
    do index = 1, 6
      if (.not.air5_finite_gpu(atol(index)) .or. atol(index) <= 0.0_real64) then
        status = chemistry_status_invalid_tolerance
        return
      end if
    end do
    if (rtol <= 0.0_real64) then
      status = chemistry_status_invalid_tolerance
      return
    end if
    if (max_attempts <= 0) then
      status = chemistry_status_step_limit
      return
    end if
    if (present(compensation)) then
      do index = 1, 6
        if (.not.air5_finite_gpu(compensation(index))) then
          status = chemistry_status_nonfinite
          return
        end if
      end do
      current_carry = compensation
    end if
    call air5_validate_ros2_candidate_gpu(rho,momentum,q5,state,status)
    if (status /= chemistry_status_ok) return

    current = state
    elapsed = 0.0_real64
    step = min(initial_step,duration)
    previous_rejected = .false.
    do attempt = 1, max_attempts
      remaining = duration-elapsed
      step = min(step,remaining)
      if (step <= 0.0_real64 .or. elapsed+step == elapsed) then
        final_state = state
        suggested_step = step
        status = chemistry_status_step_limit
        return
      end if
      if (present(compensation)) then
        trial_carry = current_carry
        call air5_ros2_fixed_step_gpu(rho,momentum,q5,current,step,candidate, &
          error_estimate,attempt_status,retryable,attempt_rhs,attempt_jac,source_mode,trial_carry)
      else
        call air5_ros2_fixed_step_gpu(rho,momentum,q5,current,step,candidate, &
          error_estimate,attempt_status,retryable,attempt_rhs,attempt_jac,source_mode)
      end if
      rhs_evaluations = rhs_evaluations+attempt_rhs
      jacobian_evaluations = jacobian_evaluations+attempt_jac
      if (attempt_status == chemistry_status_ok) then
        call air5_ros2_weighted_error_norm_gpu(current,candidate,error_estimate, &
          rtol,atol,error_norm)
        if (error_norm <= 1.0_real64) then
          current = candidate
          if (present(compensation)) current_carry = trial_carry
          elapsed = elapsed+step
          accepted_steps = accepted_steps+1
          if (error_norm == 0.0_real64) then
            factor = maximum_factor
          else
            factor = min(maximum_factor,max(minimum_factor, &
              safety/sqrt(error_norm)))
          end if
          if (previous_rejected) factor = min(1.0_real64,factor)
          suggested_step = step*factor
          previous_rejected = .false.
          if (elapsed >= duration) then
            final_state = current
            if (present(compensation)) compensation = current_carry
            status = chemistry_status_ok
            return
          end if
          step = min(suggested_step,duration-elapsed)
          cycle
        end if
        if (air5_finite_gpu(error_norm)) then
          factor = max(minimum_factor,min(1.0_real64,safety/sqrt(error_norm)))
        else
          factor = minimum_factor
        end if
        step = step*factor
      else if (retryable) then
        step = 0.5_real64*step
      else
        final_state = state
        suggested_step = step
        status = attempt_status
        return
      end if
      rejected_steps = rejected_steps+1
      suggested_step = step
      previous_rejected = .true.
    end do

    final_state = state
    status = chemistry_status_step_limit
  end subroutine air5_ros2_advance_gpu

  attributes(global) subroutine air5_ros2_batch_kernel(rho,momentum,q5,state, &
      duration,initial_step,rtol,atol,max_attempts,final_state,suggested_step, &
      accepted_steps,rejected_steps,rhs_evaluations,jacobian_evaluations,status, &
      count,source_mode)
    integer, value :: count, max_attempts, source_mode
    real(real64), value :: duration, rtol
    real(real64), device, intent(in) :: rho(count), momentum(3,count), q5(count)
    real(real64), device, intent(in) :: state(6,count), initial_step(count)
    real(real64), device, intent(in) :: atol(6,count)
    real(real64), device, intent(out) :: final_state(6,count), suggested_step(count)
    integer, device, intent(out) :: accepted_steps(count), rejected_steps(count)
    integer, device, intent(out) :: rhs_evaluations(count), jacobian_evaluations(count)
    integer, device, intent(out) :: status(count)
    integer :: index

    index = (blockIdx%x-1)*blockDim%x+threadIdx%x
    if (index > count) return
    call air5_ros2_advance_gpu(rho(index),momentum(:,index),q5(index), &
      state(:,index),duration,initial_step(index),rtol,atol(:,index),max_attempts, &
      final_state(:,index),suggested_step(index),accepted_steps(index), &
      rejected_steps(index),rhs_evaluations(index),jacobian_evaluations(index), &
      status(index),source_mode)
  end subroutine air5_ros2_batch_kernel

  subroutine launch_air5_ros2_batch_gpu(rho,momentum,q5,state,duration, &
      initial_step,rtol,atol,max_attempts,final_state,suggested_step, &
      accepted_steps,rejected_steps,rhs_evaluations,jacobian_evaluations,status, &
      count,source_mode)
    integer, intent(in) :: count, max_attempts, source_mode
    real(real64), intent(in) :: duration, rtol
    real(real64), device, intent(in) :: rho(count), momentum(3,count), q5(count)
    real(real64), device, intent(in) :: state(6,count), initial_step(count)
    real(real64), device, intent(in) :: atol(6,count)
    real(real64), device, intent(out) :: final_state(6,count), suggested_step(count)
    integer, device, intent(out) :: accepted_steps(count), rejected_steps(count)
    integer, device, intent(out) :: rhs_evaluations(count), jacobian_evaluations(count)
    integer, device, intent(out) :: status(count)
    type(dim3) :: block, grid

    if (count <= 0) return
    block = dim3(128,1,1)
    grid = dim3((count+block%x-1)/block%x,1,1)
    call air5_ros2_batch_kernel<<<grid,block>>>(rho,momentum,q5,state,duration, &
      initial_step,rtol,atol,max_attempts,final_state,suggested_step,accepted_steps, &
      rejected_steps,rhs_evaluations,jacobian_evaluations,status,count,source_mode)
    call sync_after_kernel('air5_ros2_batch_kernel',force_sync=.true.)
  end subroutine launch_air5_ros2_batch_gpu

end module chemistry_ros2_gpu
