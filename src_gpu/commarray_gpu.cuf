module commarray_gpu
  use cudafor
  implicit none
  integer,parameter :: GPU_FILTER_WORKSPACE_FULL=0
  integer,parameter :: GPU_FILTER_WORKSPACE_SCALAR=1
  integer,save :: gpu_filter_workspace_mode=GPU_FILTER_WORKSPACE_FULL
  logical,save :: gpu_filter_workspace_configured=.false.
  real(8),allocatable,device :: q_d(:,:,:,:),qrhs_d(:,:,:,:),qsave_d(:,:,:,:),qwork_d(:,:,:,:)
  real(8),allocatable,device :: filter_work_d(:,:,:)
  real(8),allocatable,device :: rho_d(:,:,:),prs_d(:,:,:),tmp_d(:,:,:)
  real(8),allocatable,device :: vel_d(:,:,:,:),jacob_d(:,:,:),x_d(:,:,:,:)
  real(8),allocatable,device :: dxi_d(:,:,:,:,:)
  real(8),allocatable,device :: bnorm_i0_d(:,:,:),bnorm_im_d(:,:,:), &
                                bnorm_j0_d(:,:,:),bnorm_jm_d(:,:,:), &
                                bnorm_k0_d(:,:,:),bnorm_km_d(:,:,:)
  real(8),allocatable,device :: dvel_d(:,:,:,:,:),dtmp_d(:,:,:,:)
  real(8),allocatable,device :: sigma_d(:,:,:,:),qflux_d(:,:,:,:)
  real(4),allocatable,device :: dvel_sp_d(:,:,:,:,:),dtmp_sp_d(:,:,:,:)
  real(4),allocatable,device :: sigma_sp_d(:,:,:,:),qflux_sp_d(:,:,:,:)
  real(8),allocatable,device :: flux_work_d(:,:,:),flux_characteristic_work_d(:,:,:,:)
  real(4),allocatable,device :: flux_work_sp_d(:,:,:)
  real(4),allocatable,device :: flux_characteristic_work_sp_d(:,:,:,:)
  real(8),allocatable,device :: shock_sensor_d(:,:,:,:)
  integer(1),allocatable,device :: shock_mask_d(:,:,:)
contains
  subroutine configure_gpu_filter_workspace()
    use mpi
    use parallel, only: lio
    implicit none
    character(len=16) :: value
    integer :: choice,lowest,highest,status,ierr

    if(gpu_filter_workspace_configured) return
    value=''
    call get_environment_variable('ASTR_GPU_FILTER_WORKSPACE',value,status=status)
    choice=-1
    if(status==1 .or. (status==0 .and. len_trim(value)==0)) choice=GPU_FILTER_WORKSPACE_FULL
    if(status==0) then
      select case(trim(adjustl(value)))
      case('full')
        choice=GPU_FILTER_WORKSPACE_FULL
      case('scalar')
        choice=GPU_FILTER_WORKSPACE_SCALAR
      end select
    endif
    call mpi_allreduce(choice,lowest,1,MPI_INTEGER,MPI_MIN,MPI_COMM_WORLD,ierr)
    if(ierr/=MPI_SUCCESS) call mpi_abort(MPI_COMM_WORLD,ierr,status)
    call mpi_allreduce(choice,highest,1,MPI_INTEGER,MPI_MAX,MPI_COMM_WORLD,ierr)
    if(ierr/=MPI_SUCCESS) call mpi_abort(MPI_COMM_WORLD,ierr,status)
    if(lowest<0 .or. lowest/=highest) then
      if(lio) write(*,'(A)') 'Invalid or inconsistent ASTR_GPU_FILTER_WORKSPACE: expected full or scalar'
      call mpi_abort(MPI_COMM_WORLD,1,ierr)
    endif
    gpu_filter_workspace_mode=choice
    gpu_filter_workspace_configured=.true.
  end subroutine configure_gpu_filter_workspace

  logical function gpu_scalar_filter_workspace_enabled()
    implicit none
    gpu_scalar_filter_workspace_enabled = &
      gpu_filter_workspace_mode==GPU_FILTER_WORKSPACE_SCALAR
  end function gpu_scalar_filter_workspace_enabled

  logical function gpu_mixed_flux_workspace_enabled()
    use commvar, only: conschm,recon_schem,lchardecomp,lihomo,ljhomo,lkhomo
    use precision_mode_gpu, only: gpu_mixed_workspace_requested
    use mixed_candidate_gpu, only: gpu_mixed_candidate_requested,GPU_MIXED_FLUX
    implicit none

    gpu_mixed_flux_workspace_enabled = gpu_mixed_workspace_requested() .and. &
      gpu_mixed_candidate_requested(GPU_MIXED_FLUX) .and. &
      trim(conschm)=='543e' .and. (recon_schem==1 .or. recon_schem==3) .and. &
      (.not.lchardecomp) .and. lihomo .and. ljhomo .and. lkhomo
  end function gpu_mixed_flux_workspace_enabled

  logical function gpu_mixed_derivative_workspace_enabled()
    use precision_mode_gpu, only: gpu_mixed_workspace_requested
    use mixed_candidate_gpu, only: gpu_mixed_candidate_requested,GPU_MIXED_DERIVATIVE
    implicit none

    gpu_mixed_derivative_workspace_enabled = gpu_mixed_workspace_requested() .and. &
      gpu_mixed_candidate_requested(GPU_MIXED_DERIVATIVE)
  end function gpu_mixed_derivative_workspace_enabled

  logical function gpu_mixed_viscous_flux_workspace_enabled()
    use precision_mode_gpu, only: gpu_mixed_workspace_requested
    use mixed_candidate_gpu, only: gpu_mixed_candidate_requested,GPU_MIXED_VISCOUS_FLUX
    implicit none

    gpu_mixed_viscous_flux_workspace_enabled = gpu_mixed_workspace_requested() .and. &
      gpu_mixed_candidate_requested(GPU_MIXED_VISCOUS_FLUX)
  end function gpu_mixed_viscous_flux_workspace_enabled

  logical function gpu_mixed_characteristic_flux_workspace_enabled()
    use commvar, only: conschm,recon_schem,lchardecomp,lihomo,ljhomo,lkhomo, &
         diffterm,lfilter,numq,num_species,num_modequ,rkscheme
    use case_capability_gpu, only: gpu_shock_characteristic_s0b0_xphysical_supported
    use precision_mode_gpu, only: gpu_mixed_workspace_requested
    use mixed_candidate_gpu, only: gpu_mixed_candidate_requested, &
         GPU_MIXED_CHARACTERISTIC_FLUX
    implicit none
    logical :: periodic_case,xphysical_case

    periodic_case=lihomo .and. ljhomo .and. lkhomo
    xphysical_case=gpu_shock_characteristic_s0b0_xphysical_supported()

    gpu_mixed_characteristic_flux_workspace_enabled = &
      gpu_mixed_workspace_requested() .and. &
      gpu_mixed_candidate_requested(GPU_MIXED_CHARACTERISTIC_FLUX) .and. &
      trim(conschm)=='543e' .and. recon_schem==3 .and. lchardecomp .and. &
      (periodic_case .or. xphysical_case) .and. &
      (.not.diffterm) .and. (.not.lfilter) .and. &
      numq==5 .and. num_species==0 .and. num_modequ==0 .and. &
      trim(rkscheme)=='rk3'
  end function gpu_mixed_characteristic_flux_workspace_enabled

  subroutine validate_gpu_mixed_candidate_eligibility()
    use mpi
    use commvar, only: diffterm,difschm,numq,num_species,num_modequ,rkscheme,lchardecomp
    use commcal, only: shock_sensor_validation_enabled
    use parallel, only: lio
    use precision_mode_gpu, only: gpu_mixed_workspace_requested
    implicit none
    logical :: invalid
    character(len=160) :: reason
    integer :: ierr

    if(.not.gpu_mixed_workspace_requested()) return
    invalid=.false.
    reason=''
    if(gpu_mixed_flux_workspace_enabled()) then
      return
    elseif(gpu_mixed_characteristic_flux_workspace_enabled()) then
      return
    elseif(gpu_mixed_derivative_workspace_enabled() .or. &
           gpu_mixed_viscous_flux_workspace_enabled()) then
      if((.not.diffterm) .or. trim(difschm)/='643e') then
        invalid=.true.
        reason='derivative and viscous_flux require diffterm=t and difschm=643e'
      elseif(numq/=5 .or. num_species/=0 .or. num_modequ/=0) then
        invalid=.true.
        reason='derivative and viscous_flux require numq=5, num_species=0, and num_modequ=0'
      elseif(trim(rkscheme)/='rk3') then
        invalid=.true.
        reason='derivative and viscous_flux require rkscheme=rk3'
      elseif(gpu_mixed_derivative_workspace_enabled() .and. &
             (shock_sensor_validation_enabled() .or. lchardecomp)) then
        invalid=.true.
        reason='derivative is unavailable when shock-sensor or characteristic paths consume dvel'
      endif
    else
      invalid=.true.
      reason='requested mixed candidate is ineligible for this case'
    endif
    if(invalid) then
      if(lio) write(*,'(A,A)') 'Invalid ASTR_GPU_MIXED_CANDIDATE case: ',trim(reason)
      call mpi_abort(MPI_COMM_WORLD,1,ierr)
    endif
  end subroutine validate_gpu_mixed_candidate_eligibility

  subroutine alloc_gpu_arrays()
    use commvar, only: im,jm,km,hm,numq,conschm,recon_schem,lchardecomp,lfilter
    use commcal, only: shock_sensor_validation_enabled
    use parallel, only: lio
    use precision_mode_gpu, only: configure_gpu_precision_mode,gpu_precision_mode_name
    use mixed_candidate_gpu, only: configure_gpu_mixed_candidate
    implicit none
    integer(8) :: workspace_bytes,flux_workspace_bytes,mixed_workspace_bytes, &
                  fp64_workspace_bytes,interior_points,halo_points
    logical :: derivative_active,viscous_active,characteristic_active
    character(len=32) :: active_workspace

    call configure_gpu_precision_mode()
    call configure_gpu_mixed_candidate()
    call configure_gpu_filter_workspace()
    call validate_gpu_mixed_candidate_eligibility()
    derivative_active=gpu_mixed_derivative_workspace_enabled()
    viscous_active=gpu_mixed_viscous_flux_workspace_enabled()
    characteristic_active=gpu_mixed_characteristic_flux_workspace_enabled()
    mixed_workspace_bytes=0_8
    fp64_workspace_bytes=0_8
    active_workspace='none'
    if(lio) write(*,'(A,A)') 'ASTR_GPU_PRECISION_MODE=',trim(gpu_precision_mode_name())
    if(.not.allocated(q_d))      allocate(q_d(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:numq))
    if(gpu_scalar_filter_workspace_enabled() .and. lfilter) then
      if(.not.allocated(filter_work_d)) &
        allocate(filter_work_d(-hm:im+hm,-hm:jm+hm,-hm:km+hm))
      workspace_bytes=int(im+2*hm+1,8)*int(jm+2*hm+1,8)*int(km+2*hm+1,8)*8_8
      if(lio) write(*,'(A)') ' ** GPU filter workspace storage: scalar'
    else
      if(.not.allocated(qwork_d)) allocate(qwork_d(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:numq))
      workspace_bytes=int(im+2*hm+1,8)*int(jm+2*hm+1,8)*int(km+2*hm+1,8)*int(numq,8)*8_8
      if(lio .and. gpu_scalar_filter_workspace_enabled()) then
        write(*,'(A)') ' ** GPU filter workspace storage: full compatibility (lfilter=f)'
      elseif(lio) then
        write(*,'(A)') ' ** GPU filter workspace storage: full'
      endif
    endif
    if(lio) write(*,'(A,I0)') ' ** GPU filter workspace bytes: ',workspace_bytes
    if(.not.allocated(qrhs_d))   allocate(qrhs_d(0:im,0:jm,0:km,1:numq))
    if(.not.allocated(qsave_d))  allocate(qsave_d(0:im,0:jm,0:km,1:numq))
    if(.not.allocated(rho_d))    allocate(rho_d(-hm:im+hm,-hm:jm+hm,-hm:km+hm))
    if(.not.allocated(prs_d))    allocate(prs_d(-hm:im+hm,-hm:jm+hm,-hm:km+hm))
    if(.not.allocated(tmp_d))    allocate(tmp_d(-hm:im+hm,-hm:jm+hm,-hm:km+hm))
    if(.not.allocated(vel_d))    allocate(vel_d(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:3))
    if(.not.allocated(jacob_d))  allocate(jacob_d(-hm:im+hm,-hm:jm+hm,-hm:km+hm))
    if(.not.allocated(x_d))      allocate(x_d(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:3))
    if(.not.allocated(dxi_d))    allocate(dxi_d(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:3,1:3))
    if(.not.allocated(bnorm_i0_d)) allocate(bnorm_i0_d(0:jm,0:km,1:3))
    if(.not.allocated(bnorm_im_d)) allocate(bnorm_im_d(0:jm,0:km,1:3))
    if(.not.allocated(bnorm_j0_d)) allocate(bnorm_j0_d(0:im,0:km,1:3))
    if(.not.allocated(bnorm_jm_d)) allocate(bnorm_jm_d(0:im,0:km,1:3))
    if(.not.allocated(bnorm_k0_d)) allocate(bnorm_k0_d(0:im,0:jm,1:3))
    if(.not.allocated(bnorm_km_d)) allocate(bnorm_km_d(0:im,0:jm,1:3))
    interior_points=int(im+1,8)*int(jm+1,8)*int(km+1,8)
    halo_points=int(im+2*hm+1,8)*int(jm+2*hm+1,8)*int(km+2*hm+1,8)
    if(derivative_active) then
      if(.not.allocated(dvel_sp_d)) allocate(dvel_sp_d(0:im,0:jm,0:km,1:3,1:3))
      if(.not.allocated(dtmp_sp_d)) allocate(dtmp_sp_d(0:im,0:jm,0:km,1:3))
      mixed_workspace_bytes=interior_points*12_8*4_8
      fp64_workspace_bytes=interior_points*12_8*8_8
      active_workspace='derivative'
    else
      if(.not.allocated(dvel_d)) allocate(dvel_d(0:im,0:jm,0:km,1:3,1:3))
      if(.not.allocated(dtmp_d)) allocate(dtmp_d(0:im,0:jm,0:km,1:3))
    endif
    if(viscous_active) then
      if(.not.allocated(sigma_sp_d)) &
        allocate(sigma_sp_d(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:6))
      if(.not.allocated(qflux_sp_d)) &
        allocate(qflux_sp_d(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:3))
      mixed_workspace_bytes=halo_points*9_8*4_8
      fp64_workspace_bytes=halo_points*9_8*8_8
      active_workspace='viscous_flux'
    else
      if(.not.allocated(sigma_d)) &
        allocate(sigma_d(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:6))
      if(.not.allocated(qflux_d)) &
        allocate(qflux_d(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:3))
    endif
    flux_workspace_bytes=0_8
    if(trim(conschm) == '543e' .and. (recon_schem == 1 .or. recon_schem == 3)) then
      if(gpu_mixed_flux_workspace_enabled()) then
        if(.not.allocated(flux_work_sp_d)) &
          allocate(flux_work_sp_d(-hm:im+hm,-hm:jm+hm,-hm:km+hm))
        flux_workspace_bytes=int(im+2*hm+1,8)*int(jm+2*hm+1,8)* &
          int(km+2*hm+1,8)*4_8
        mixed_workspace_bytes=flux_workspace_bytes
        fp64_workspace_bytes=halo_points*8_8
        active_workspace='flux_work'
      else
        if(.not.allocated(flux_work_d)) &
          allocate(flux_work_d(-hm:im+hm,-hm:jm+hm,-hm:km+hm))
        flux_workspace_bytes=int(im+2*hm+1,8)*int(jm+2*hm+1,8)* &
          int(km+2*hm+1,8)*8_8
      endif
      if(lio) write(*,'(A,I0)') 'ASTR_GPU_FLUX_WORKSPACE_BYTES=',flux_workspace_bytes
    endif
    if(lchardecomp) then
      if(characteristic_active) then
        if(.not.allocated(flux_characteristic_work_sp_d)) &
          allocate(flux_characteristic_work_sp_d(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:5))
        mixed_workspace_bytes=halo_points*5_8*4_8
        fp64_workspace_bytes=halo_points*5_8*8_8
        active_workspace='characteristic_flux'
      else
        if(.not.allocated(flux_characteristic_work_d)) &
          allocate(flux_characteristic_work_d(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:5))
      endif
    endif
    if(lio) write(*,'(A,A)') 'ASTR_GPU_ACTIVE_MIXED_WORKSPACE=',trim(active_workspace)
    if(lio) write(*,'(A,I0)') 'ASTR_GPU_MIXED_WORKSPACE_BYTES=',mixed_workspace_bytes
    if(lio) write(*,'(A,I0)') 'ASTR_GPU_FP64_WORKSPACE_BYTES=',fp64_workspace_bytes
    if(shock_sensor_validation_enabled() .or. lchardecomp) then
      if(.not.allocated(shock_sensor_d)) &
        allocate(shock_sensor_d(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:1))
      if(.not.allocated(shock_mask_d)) allocate(shock_mask_d(0:im,0:jm,0:km))
    endif
  end subroutine alloc_gpu_arrays

  subroutine release_gpu_arrays()
    implicit none

    if(allocated(shock_mask_d)) deallocate(shock_mask_d)
    if(allocated(shock_sensor_d)) deallocate(shock_sensor_d)
    if(allocated(flux_characteristic_work_sp_d)) deallocate(flux_characteristic_work_sp_d)
    if(allocated(flux_characteristic_work_d)) deallocate(flux_characteristic_work_d)
    if(allocated(flux_work_sp_d)) deallocate(flux_work_sp_d)
    if(allocated(flux_work_d)) deallocate(flux_work_d)
    if(allocated(qflux_sp_d)) deallocate(qflux_sp_d)
    if(allocated(sigma_sp_d)) deallocate(sigma_sp_d)
    if(allocated(qflux_d)) deallocate(qflux_d)
    if(allocated(sigma_d)) deallocate(sigma_d)
    if(allocated(dtmp_sp_d)) deallocate(dtmp_sp_d)
    if(allocated(dvel_sp_d)) deallocate(dvel_sp_d)
    if(allocated(dtmp_d)) deallocate(dtmp_d)
    if(allocated(dvel_d)) deallocate(dvel_d)
    if(allocated(bnorm_km_d)) deallocate(bnorm_km_d)
    if(allocated(bnorm_k0_d)) deallocate(bnorm_k0_d)
    if(allocated(bnorm_jm_d)) deallocate(bnorm_jm_d)
    if(allocated(bnorm_j0_d)) deallocate(bnorm_j0_d)
    if(allocated(bnorm_im_d)) deallocate(bnorm_im_d)
    if(allocated(bnorm_i0_d)) deallocate(bnorm_i0_d)
    if(allocated(dxi_d)) deallocate(dxi_d)
    if(allocated(x_d)) deallocate(x_d)
    if(allocated(jacob_d)) deallocate(jacob_d)
    if(allocated(vel_d)) deallocate(vel_d)
    if(allocated(tmp_d)) deallocate(tmp_d)
    if(allocated(prs_d)) deallocate(prs_d)
    if(allocated(rho_d)) deallocate(rho_d)
    if(allocated(qsave_d)) deallocate(qsave_d)
    if(allocated(qrhs_d)) deallocate(qrhs_d)
    if(allocated(filter_work_d)) deallocate(filter_work_d)
    if(allocated(qwork_d)) deallocate(qwork_d)
    if(allocated(q_d)) deallocate(q_d)
  end subroutine release_gpu_arrays

  subroutine copy_flow_to_gpu()
    use commarray, only: q,rho,vel,prs,tmp,jacob,x,dxi,bnorm_i0,bnorm_im, &
                         bnorm_j0,bnorm_jm,bnorm_k0,bnorm_km
    implicit none

    q_d = q
    rho_d = rho
    vel_d = vel
    prs_d = prs
    tmp_d = tmp
    jacob_d = jacob
    x_d = x
    dxi_d = dxi
    bnorm_i0_d = 0.d0
    bnorm_im_d = 0.d0
    bnorm_j0_d = 0.d0
    bnorm_jm_d = 0.d0
    bnorm_k0_d = 0.d0
    bnorm_km_d = 0.d0
    if(allocated(bnorm_i0)) bnorm_i0_d = bnorm_i0
    if(allocated(bnorm_im)) bnorm_im_d = bnorm_im
    if(allocated(bnorm_j0)) bnorm_j0_d = bnorm_j0
    if(allocated(bnorm_jm)) bnorm_jm_d = bnorm_jm
    if(allocated(bnorm_k0)) bnorm_k0_d = bnorm_k0
    if(allocated(bnorm_km)) bnorm_km_d = bnorm_km
  end subroutine copy_flow_to_gpu

  subroutine copy_flow_from_gpu()
    use commarray, only: q,rho,vel,prs,tmp
    use gpu_check, only: sync_gpu_boundary
    implicit none

    call sync_gpu_boundary('copy_flow_from_gpu')
    q = q_d
    rho = rho_d
    vel = vel_d
    prs = prs_d
    tmp = tmp_d
  end subroutine copy_flow_from_gpu

  subroutine copy_rhs_from_gpu()
    use commarray, only: qrhs
    use gpu_check, only: sync_gpu_boundary
    implicit none

    call sync_gpu_boundary('copy_rhs_from_gpu')
    qrhs=qrhs_d
  end subroutine copy_rhs_from_gpu

  attributes(global) subroutine save_q_stats_snapshot_kernel(q,qsave,im,jm,km,hm,numq)
    implicit none
    integer,value :: im,jm,km,hm,numq
    real(8),device :: q(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:numq)
    real(8),device :: qsave(0:im,0:jm,0:km,1:numq)
    integer :: id,n,i,j,k,m

    id=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    n=(im+1)*(jm+1)*(km+1)*numq
    if(id>=n) return
    i=mod(id,im+1)
    j=mod(id/(im+1),jm+1)
    k=mod(id/((im+1)*(jm+1)),km+1)
    m=id/((im+1)*(jm+1)*(km+1))+1
    qsave(i,j,k,m)=q(i,j,k,m)
  end subroutine save_q_stats_snapshot_kernel

  attributes(global) subroutine restore_q_stats_snapshot_kernel(q,qsave,im,jm,km,hm,numq)
    implicit none
    integer,value :: im,jm,km,hm,numq
    real(8),device :: q(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:numq)
    real(8),device :: qsave(0:im,0:jm,0:km,1:numq)
    integer :: id,n,i,j,k,m

    id=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    n=(im+1)*(jm+1)*(km+1)*numq
    if(id>=n) return
    i=mod(id,im+1)
    j=mod(id/(im+1),jm+1)
    k=mod(id/((im+1)*(jm+1)),km+1)
    m=id/((im+1)*(jm+1)*(km+1))+1
    q(i,j,k,m)=qsave(i,j,k,m)
  end subroutine restore_q_stats_snapshot_kernel

  subroutine save_q_stats_snapshot_gpu()
    use commvar, only: im,jm,km,hm,numq
    use gpu_check, only: sync_after_kernel
    implicit none
    type(dim3) :: block,grid
    integer :: n

    block=dim3(256,1,1)
    n=(im+1)*(jm+1)*(km+1)*numq
    grid=dim3((n+block%x-1)/block%x,1,1)
    call save_q_stats_snapshot_kernel<<<grid,block>>>(q_d,qsave_d,im,jm,km,hm,numq)
    call sync_after_kernel('save_q_stats_snapshot_kernel')
  end subroutine save_q_stats_snapshot_gpu

  subroutine restore_q_stats_snapshot_gpu()
    use commvar, only: im,jm,km,hm,numq
    use gpu_check, only: sync_after_kernel
    implicit none
    type(dim3) :: block,grid
    integer :: n

    block=dim3(256,1,1)
    n=(im+1)*(jm+1)*(km+1)*numq
    grid=dim3((n+block%x-1)/block%x,1,1)
    call restore_q_stats_snapshot_kernel<<<grid,block>>>(q_d,qsave_d,im,jm,km,hm,numq)
    call sync_after_kernel('restore_q_stats_snapshot_kernel')
  end subroutine restore_q_stats_snapshot_gpu

  subroutine copy_output_boundary_from_gpu()
    use commvar, only: im,jm,km
    use commarray, only: rho,vel,prs,tmp
    use gpu_check, only: sync_gpu_boundary
    implicit none

    call sync_gpu_boundary('copy_output_boundary_from_gpu')
    rho(0,:,:) = rho_d(0,:,:)
    rho(im,:,:) = rho_d(im,:,:)
    rho(:,0,:) = rho_d(:,0,:)
    rho(:,jm,:) = rho_d(:,jm,:)
    rho(:,:,0) = rho_d(:,:,0)
    rho(:,:,km) = rho_d(:,:,km)

    prs(0,:,:) = prs_d(0,:,:)
    prs(im,:,:) = prs_d(im,:,:)
    prs(:,0,:) = prs_d(:,0,:)
    prs(:,jm,:) = prs_d(:,jm,:)
    prs(:,:,0) = prs_d(:,:,0)
    prs(:,:,km) = prs_d(:,:,km)

    tmp(0,:,:) = tmp_d(0,:,:)
    tmp(im,:,:) = tmp_d(im,:,:)
    tmp(:,0,:) = tmp_d(:,0,:)
    tmp(:,jm,:) = tmp_d(:,jm,:)
    tmp(:,:,0) = tmp_d(:,:,0)
    tmp(:,:,km) = tmp_d(:,:,km)

    vel(0,:,:,:) = vel_d(0,:,:,:)
    vel(im,:,:,:) = vel_d(im,:,:,:)
    vel(:,0,:,:) = vel_d(:,0,:,:)
    vel(:,jm,:,:) = vel_d(:,jm,:,:)
    vel(:,:,0,:) = vel_d(:,:,0,:)
    vel(:,:,km,:) = vel_d(:,:,km,:)
  end subroutine copy_output_boundary_from_gpu

  subroutine report_gpu_state(label)
    use commvar, only: im,jm,km
    use gpu_check, only: sync_gpu_boundary
    implicit none
    character(len=*),intent(in) :: label
    real(8),allocatable :: qh(:,:,:,:),rhsh(:,:,:,:),qsaveh(:,:,:,:),jh(:,:,:)
    integer :: nan_q,nan_rhs,nan_j

    call sync_gpu_boundary('report_gpu_state')
    allocate(qh(0:im,0:jm,0:km,1:5))
    allocate(rhsh(0:im,0:jm,0:km,1:5))
    allocate(qsaveh(0:im,0:jm,0:km,1:5))
    allocate(jh(0:im,0:jm,0:km))
    qh = q_d(0:im,0:jm,0:km,1:5)
    rhsh = qrhs_d
    qsaveh = qsave_d
    jh = jacob_d(0:im,0:jm,0:km)
    nan_q = count(qh /= qh)
    nan_rhs = count(rhsh /= rhsh)
    nan_j = count(jh /= jh)
    print *, 'GPU state ', trim(label), ' nan_q=', nan_q, ' nan_rhs=', nan_rhs, &
             ' nan_jacob=', nan_j, ' q1=', qh(0,0,0,1), ' rhs1=', rhsh(0,0,0,1), &
             ' jacob=', jh(0,0,0), ' qsave1=', qsaveh(0,0,0,1)
    deallocate(qh,rhsh,qsaveh,jh)
  end subroutine report_gpu_state
end module commarray_gpu
