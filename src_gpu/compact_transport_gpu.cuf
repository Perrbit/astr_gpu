module compact_transport_gpu
  use mpi
  use cudafor
  use iso_c_binding, only: c_int
  use iso_fortran_env, only: int64
  use astr_precision, only: real_kind,real_bytes
  use astr_precision_mpi, only: mpi_real_type
  implicit none
  private
  integer,parameter :: tag_low=24001,tag_high=24002
  public :: compact_transport,prepare_compact_transport,release_compact_transport
  public :: exchange_compact_interfaces,broadcast_compact_interfaces

  type :: compact_transport
    integer :: comm=MPI_COMM_NULL,rank=0,ranks=1,capacity=0
    logical :: device_aware=.false.
    integer(int64) :: sent_bytes=0_int64,host_stage_bytes=0_int64
    real(real_kind),allocatable,pinned :: host(:,:,:)
  end type
#ifdef ASTR_MPI_CUDA_AWARE_QUERY
  interface
    integer(c_int) function query_cuda() bind(C,name='MPIX_Query_cuda_support')
      import c_int
    end function
  end interface
#endif
contains
  subroutine prepare_compact_transport(comm,capacity,transport)
    integer,intent(in) :: comm,capacity
    type(compact_transport),intent(inout) :: transport
    character(32) :: mode
    integer :: ierr,status,choice,lo,hi,istat
    logical :: pinned_ok
    call MPI_Comm_dup(comm,transport%comm,ierr)
    call MPI_Comm_rank(transport%comm,transport%rank,ierr)
    call MPI_Comm_size(transport%comm,transport%ranks,ierr)
    mode='pinned'
    call get_environment_variable('ASTR_GPU_COMPACT_TRANSPORT',mode,status=status)
    if(status==1) mode='pinned'
    choice=-1
    if(trim(mode)=='pinned') choice=0
    if(trim(mode)=='device-aware') choice=1
    call MPI_Allreduce(choice,lo,1,MPI_INTEGER,MPI_MIN,transport%comm,ierr)
    call MPI_Allreduce(choice,hi,1,MPI_INTEGER,MPI_MAX,transport%comm,ierr)
    if(lo<0.or.lo/=hi) then
      write(*,*) 'compact transport must consistently select pinned or device-aware'
      call MPI_Abort(transport%comm,1,ierr)
    endif
    transport%device_aware=choice==1
    transport%capacity=capacity
    if(transport%device_aware) then
      choice=0
#ifdef ASTR_MPI_CUDA_AWARE_QUERY
      choice=query_cuda()
#endif
      call MPI_Allreduce(choice,lo,1,MPI_INTEGER,MPI_MIN,transport%comm,ierr)
      if(lo/=1) then
        write(*,*) 'requested compact device-aware transport is unavailable'
        call MPI_Abort(transport%comm,1,ierr)
      endif
    else
      allocate(transport%host(2,capacity,3),stat=istat,pinned=pinned_ok)
      if(istat/=0.or..not.pinned_ok) then
        write(*,*) 'compact pinned interface allocation failed'
        call MPI_Abort(transport%comm,1,ierr)
      endif
      transport%host=0.e0_real_kind
    endif
  end subroutine

  subroutine exchange_compact_interfaces(transport,send,low,high,nrhs,left_rank,right_rank)
    type(compact_transport),intent(inout) :: transport
    integer,intent(in) :: nrhs,left_rank,right_rank
    real(real_kind),device,intent(in) :: send(2,transport%capacity)
    real(real_kind),device,intent(out) :: low(2,transport%capacity),high(2,transport%capacity)
    integer :: request(4),ierr,cuda_status,peers
    cuda_status=cudaDeviceSynchronize()
    if(cuda_status/=cudaSuccess) error stop 'compact interface pre-exchange CUDA failure'
    if(transport%device_aware) then
      call MPI_Irecv(low,2*nrhs,mpi_real_type,left_rank,tag_high,transport%comm,request(1),ierr)
      call MPI_Irecv(high,2*nrhs,mpi_real_type,right_rank,tag_low,transport%comm,request(2),ierr)
      call MPI_Isend(send,2*nrhs,mpi_real_type,left_rank,tag_low,transport%comm,request(3),ierr)
      call MPI_Isend(send,2*nrhs,mpi_real_type,right_rank,tag_high,transport%comm,request(4),ierr)
      call MPI_Waitall(4,request,MPI_STATUSES_IGNORE,ierr)
    else
      ! Copy the active prefix, not a compiler temporary of the full capacity.
      cuda_status=cudaMemcpy(transport%host(1,1,1),send(1,1),2*nrhs,cudaMemcpyDeviceToHost)
      if(cuda_status/=cudaSuccess) error stop 'compact interface download failed'
      call MPI_Irecv(transport%host(:,:,2),2*nrhs,mpi_real_type,left_rank,tag_high, &
        transport%comm,request(1),ierr)
      call MPI_Irecv(transport%host(:,:,3),2*nrhs,mpi_real_type,right_rank,tag_low, &
        transport%comm,request(2),ierr)
      call MPI_Isend(transport%host(:,:,1),2*nrhs,mpi_real_type,left_rank,tag_low, &
        transport%comm,request(3),ierr)
      call MPI_Isend(transport%host(:,:,1),2*nrhs,mpi_real_type,right_rank,tag_high, &
        transport%comm,request(4),ierr)
      call MPI_Waitall(4,request,MPI_STATUSES_IGNORE,ierr)
      cuda_status=cudaMemcpy(low(1,1),transport%host(1,1,2),2*nrhs,cudaMemcpyHostToDevice)
      if(cuda_status/=cudaSuccess) error stop 'compact lower interface upload failed'
      cuda_status=cudaMemcpy(high(1,1),transport%host(1,1,3),2*nrhs,cudaMemcpyHostToDevice)
      if(cuda_status/=cudaSuccess) error stop 'compact upper interface upload failed'
      transport%host_stage_bytes=transport%host_stage_bytes+6_int64*real_bytes*nrhs
    endif
    peers=0
    if(left_rank/=MPI_PROC_NULL) peers=peers+1
    if(right_rank/=MPI_PROC_NULL) peers=peers+1
    transport%sent_bytes=transport%sent_bytes+2_int64*real_bytes*nrhs*peers
    cuda_status=cudaDeviceSynchronize()
    if(cuda_status/=cudaSuccess) error stop 'compact interface post-exchange CUDA failure'
  end subroutine

  subroutine broadcast_compact_interfaces(transport,values,nrhs,root)
    type(compact_transport),intent(inout) :: transport
    integer,intent(in) :: nrhs,root
    real(real_kind),device,intent(inout) :: values(2,transport%capacity)
    integer :: ierr,cuda_status
    cuda_status=cudaDeviceSynchronize()
    if(cuda_status/=cudaSuccess) error stop 'compact interface pre-broadcast CUDA failure'
    if(transport%device_aware) then
      call MPI_Bcast(values,2*nrhs,mpi_real_type,root,transport%comm,ierr)
    else
      if(transport%rank==root) then
        cuda_status=cudaMemcpy(transport%host(1,1,1),values(1,1),2*nrhs,cudaMemcpyDeviceToHost)
        if(cuda_status/=cudaSuccess) error stop 'compact broadcast download failed'
      endif
      call MPI_Bcast(transport%host(:,:,1),2*nrhs,mpi_real_type,root,transport%comm,ierr)
      cuda_status=cudaMemcpy(values(1,1),transport%host(1,1,1),2*nrhs,cudaMemcpyHostToDevice)
      if(cuda_status/=cudaSuccess) error stop 'compact broadcast upload failed'
      transport%host_stage_bytes=transport%host_stage_bytes+2_int64*real_bytes*nrhs
      if(transport%rank==root) transport%host_stage_bytes=transport%host_stage_bytes+2_int64*real_bytes*nrhs
    endif
    if(transport%rank==root) transport%sent_bytes=transport%sent_bytes+ &
      2_int64*real_bytes*nrhs*(transport%ranks-1)
    cuda_status=cudaDeviceSynchronize()
    if(cuda_status/=cudaSuccess) error stop 'compact interface post-broadcast CUDA failure'
  end subroutine

  subroutine release_compact_transport(transport)
    type(compact_transport),intent(inout) :: transport
    integer :: ierr
    if(allocated(transport%host)) deallocate(transport%host)
    if(transport%comm/=MPI_COMM_NULL) call MPI_Comm_free(transport%comm,ierr)
    transport%capacity=0
  end subroutine
end module
