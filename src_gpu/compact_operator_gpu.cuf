module compact_operator_gpu
  use cudafor
  use compact_derivative_gpu
  use compact_filter_gpu, only: compact_filter_plan,prepare_compact_filter_gpu, &
    apply_compact_filter_gpu,release_compact_filter_gpu
  use gpu_check, only: sync_after_kernel
  use compact_runtime, only: global_compact_enabled,compact_partitions,compact_line_comms
  implicit none
  private
  public :: compact_global_enabled,compact_gradcal_gpu, &
    compact_convection_gpu,compact_diffusion_flux_gpu,compact_diffusion_rhs_gpu, &
    compact_filter_state_gpu,release_compact_operator_gpu
  type(compact_derivative_plan),save :: plans(3)
  type(compact_filter_plan),save :: filters(3)
  logical,save :: configured=.false.,enabled=.false.,prepared=.false.
  logical,save :: filter_prepared=.false.,filter_compared(3,5)=.false.
  logical,save :: compared(3,3)=.false.
contains
  logical function compact_global_enabled() result(active)
    use precision_mode_gpu, only: gpu_mixed_workspace_requested
    use gpu_check, only: gpu_selective_sync_enabled,gpu_dependency_sync_enabled
    use parallel, only: lio
    if(.not.configured) then
      enabled=global_compact_enabled()
      if(enabled) then
        if(gpu_mixed_workspace_requested().or.gpu_selective_sync_enabled().or.gpu_dependency_sync_enabled()) &
          error stop 'Global compact requires FP64 and explicit synchronization'
        if(lio) write(*,'(A)') 'COMPACT GPU: globally coupled two-level PCR'
      endif
      configured=.true.
    endif
    active=enabled
  end function

  subroutine prepare_operator()
    use commvar, only: im,jm,km,hm,npdci,npdcj,npdck
    integer :: dims(3),ntypes(3),axis,lines
    if(prepared) return
    if(.not.compact_global_enabled()) error stop 'compact operator called outside global admission'
    dims=[im,jm,km]
    ntypes=[npdci,npdcj,npdck]
    do axis=1,3
      lines=(im+1)*(jm+1)*(km+1)/(dims(axis)+1)
      call prepare_compact_derivative_gpu(dims(axis),hm,ntypes(axis),5*lines,plans(axis), &
        compact_partitions(axis),compact_line_comms(axis))
    enddo
    prepared=.true.
  end subroutine

  subroutine prepare_filter_operator()
    use commvar, only: im,jm,km,hm,numq
    use filter, only: filter_i,filter_j,filter_k
    use commarray_gpu, only: gpu_scalar_filter_workspace_enabled
    use parallel, only: lio
    integer :: components,axis
    integer(8) :: bytes
    if(filter_prepared) return
    components=numq
    if(gpu_scalar_filter_workspace_enabled()) components=1
    call prepare_compact_filter_gpu(filter_i,hm,components*(jm+1)*(km+1),filters(1), &
      compact_partitions(1),compact_line_comms(1))
    call prepare_compact_filter_gpu(filter_j,hm,components*(im+1)*(km+1),filters(2), &
      compact_partitions(2),compact_line_comms(2))
    call prepare_compact_filter_gpu(filter_k,hm,components*(im+1)*(jm+1),filters(3), &
      compact_partitions(3),compact_line_comms(3))
    bytes=0_8
    do axis=1,3
      bytes=bytes+filters(axis)%global_line%device_bytes+ &
        8_8*(filters(axis)%capacity*(2_8*filters(axis)%dim+2*hm+2+ &
        2_8*filters(axis)%global_line%n)+69_8)
    enddo
    if(lio) write(*,'(A,I0)') 'COMPACT_FILTER_PACKED_DEVICE_BYTES=',bytes
    filter_prepared=.true.
  end subroutine

  ! A column is one complete local line/component; authoritative field layout is unchanged.
  attributes(device) subroutine line_point(axis,position,line,im,jm,i,j,k)
    integer,value :: axis,position,line,im,jm
    integer,intent(out) :: i,j,k
    select case(axis)
    case(1)
      i=position; j=mod(line-1,jm+1); k=(line-1)/(jm+1)
    case(2)
      i=mod(line-1,im+1); j=position; k=(line-1)/(im+1)
    case(3)
      i=mod(line-1,im+1); j=(line-1)/(im+1); k=position
    end select
  end subroutine

  attributes(global) subroutine pack_lines_kernel(axis,kind,im,jm,km,hm,dim,lines,components,first,total,periodic,f)
    use commarray_gpu, only: q_d,vel_d,tmp_d,prs_d,dxi_d,jacob_d,sigma_d,qflux_d
    integer,value :: axis,kind,im,jm,km,hm,dim,lines,components
    integer,value :: first,total
    logical,value :: periodic
    real(8),device,intent(out) :: f(-hm:dim+hm,lines*components)
    integer :: position,column,line,m,i,j,k
    real(8) :: value,uu,p,metric(3)
    position=(blockIdx%x-1)*blockDim%x+threadIdx%x-1-hm
    column=blockIdx%y
    if(position>dim+hm) return
    if(.not.periodic.and.(first+position<0.or.first+position>total)) then
      f(position,column)=0.d0
      return
    endif
    line=mod(column-1,lines)+1
    m=(column-1)/lines+1
    call line_point(axis,position,line,im,jm,i,j,k)
    select case(kind)
    case(1)
      if(m<=3) then
        value=vel_d(i,j,k,m)
      else
        value=tmp_d(i,j,k)
      endif
    case(2)
      metric=dxi_d(i,j,k,axis,:)
      uu=metric(1)*vel_d(i,j,k,1)+metric(2)*vel_d(i,j,k,2)+metric(3)*vel_d(i,j,k,3)
      p=prs_d(i,j,k)
      select case(m)
      case(1)
        value=jacob_d(i,j,k)*q_d(i,j,k,1)*uu
      case(2:4)
        value=jacob_d(i,j,k)*(q_d(i,j,k,m)*uu+metric(m-1)*p)
      case(5)
        value=jacob_d(i,j,k)*(q_d(i,j,k,5)+p)*uu
      end select
    case(3)
      metric=dxi_d(i,j,k,axis,:)
      select case(m)
      case(1)
        value=sigma_d(i,j,k,1)*metric(1)+sigma_d(i,j,k,2)*metric(2)+sigma_d(i,j,k,3)*metric(3)
      case(2)
        value=sigma_d(i,j,k,2)*metric(1)+sigma_d(i,j,k,4)*metric(2)+sigma_d(i,j,k,5)*metric(3)
      case(3)
        value=sigma_d(i,j,k,3)*metric(1)+sigma_d(i,j,k,5)*metric(2)+sigma_d(i,j,k,6)*metric(3)
      case(4)
        value=qflux_d(i,j,k,1)*metric(1)+qflux_d(i,j,k,2)*metric(2)+qflux_d(i,j,k,3)*metric(3)
      end select
      value=value*jacob_d(i,j,k)
    end select
    f(position,column)=value
  end subroutine

  attributes(global) subroutine unpack_lines_kernel(axis,kind,im,jm,km,first,n,dim,lines,components,lo,hi,df)
    use commarray_gpu, only: qrhs_d,dvel_d,dtmp_d,dxi_d
    integer,value :: axis,kind,im,jm,km,first,n,dim,lines,components
    integer,value :: lo,hi
    real(8),device,intent(in) :: df(n,lines*components)
    integer :: position,column,line,m,i,j,k,b
    real(8) :: value,contribution
    position=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    column=blockIdx%y
    if(position>dim) return
    line=mod(column-1,lines)+1
    m=(column-1)/lines+1
    call line_point(axis,position,line,im,jm,i,j,k)
    value=df(position-first+1,column)
    select case(kind)
    case(1)
      do b=1,3
        contribution=value*dxi_d(i,j,k,axis,b)
        if(m<=3) then
          if(axis==1) dvel_d(i,j,k,m,b)=0.d0
          dvel_d(i,j,k,m,b)=dvel_d(i,j,k,m,b)+contribution
        else
          if(axis==1) dtmp_d(i,j,k,b)=0.d0
          dtmp_d(i,j,k,b)=dtmp_d(i,j,k,b)+contribution
        endif
      enddo
    case(2)
      qrhs_d(i,j,k,m)=qrhs_d(i,j,k,m)-value
    case(3)
      if(position<lo.or.position>hi) return
      qrhs_d(i,j,k,m+1)=qrhs_d(i,j,k,m+1)+value
    end select
  end subroutine

  attributes(global) subroutine pack_filter_lines_kernel(axis,im,jm,km,hm,dim,lines,components,offset,first,total,periodic,f)
    use commarray_gpu, only: q_d
    integer,value :: axis,im,jm,km,hm,dim,lines,components,offset
    integer,value :: first,total
    logical,value :: periodic
    real(8),device,intent(out) :: f(-hm:dim+hm,lines*components)
    integer :: position,column,line,m,i,j,k
    position=(blockIdx%x-1)*blockDim%x+threadIdx%x-1-hm
    column=blockIdx%y
    if(position>dim+hm) return
    if(.not.periodic.and.(first+position<0.or.first+position>total)) then
      f(position,column)=0.d0
      return
    endif
    line=mod(column-1,lines)+1
    m=(column-1)/lines+offset
    call line_point(axis,position,line,im,jm,i,j,k)
    f(position,column)=q_d(i,j,k,m)
  end subroutine

  attributes(global) subroutine commit_filter_lines_kernel(axis,im,jm,km,dim,lines,components,offset,filtered)
    use commarray_gpu, only: q_d
    integer,value :: axis,im,jm,km,dim,lines,components,offset
    real(8),device,intent(in) :: filtered(0:dim,lines*components)
    integer :: position,column,line,m,i,j,k
    position=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    column=blockIdx%y
    if(position>dim) return
    line=mod(column-1,lines)+1
    m=(column-1)/lines+offset
    call line_point(axis,position,line,im,jm,i,j,k)
    q_d(i,j,k,m)=filtered(position,column)
  end subroutine

  subroutine compact_filter_state_gpu()
    use commvar, only: im,jm,km,hm,numq
    use commarray_gpu, only: q_d,gpu_scalar_filter_workspace_enabled
    use halo_exchange_gpu, only: exchange_field_halo_gpu
    integer :: axis,lines,components,offset,dim
    call prepare_filter_operator()
    components=numq
    if(gpu_scalar_filter_workspace_enabled()) components=1
    do axis=1,3
      ! Match CPU dataswap: finish the previous axis, then refresh only this axis's halos.
      call exchange_field_halo_gpu(q_d,numq,direction=axis)
      dim=filters(axis)%dim
      lines=(im+1)*(jm+1)*(km+1)/(dim+1)
      do offset=1,numq,components
        call pack_filter_lines_kernel<<<dim3((dim+2*hm+128)/128,lines*components,1),dim3(128,1,1)>>>( &
          axis,im,jm,km,hm,dim,lines,components,offset,compact_partitions(axis)%first, &
          compact_partitions(axis)%intervals,compact_partitions(axis)%periodic,filters(axis)%input)
        call sync_after_kernel('compact_pack_filter_lines_kernel',force_sync=.true.)
        call apply_compact_filter_gpu(filters(axis),lines*components)
#ifdef ASTR_BUILD_TESTING
        call compare_filter_once(axis,offset,components,lines*components)
#endif
        ! This batch no longer reads q: its source and RHS have already been captured.
        call commit_filter_lines_kernel<<<dim3((dim+128)/128,lines*components,1),dim3(128,1,1)>>>( &
          axis,im,jm,km,dim,lines,components,offset,filters(axis)%filtered)
        call sync_after_kernel('compact_commit_filter_lines_kernel',force_sync=.true.)
      enddo
    enddo
  end subroutine

  subroutine apply_directional_operator(kind)
    use commvar, only: im,jm,km,hm,is,ie,js,je,ks,ke
    integer,intent(in) :: kind
    integer :: axis,lines,components,dim,lower(3),upper(3)
    call prepare_operator()
    components=4
    if(kind==2) components=5
    lower=[is,js,ks]
    upper=[ie,je,ke]
    do axis=1,3
      dim=plans(axis)%dim
      lines=(im+1)*(jm+1)*(km+1)/(dim+1)
      call pack_lines_kernel<<<dim3((dim+2*hm+128)/128,lines*components,1),dim3(128,1,1)>>>( &
        axis,kind,im,jm,km,hm,dim,lines,components,compact_partitions(axis)%first, &
        compact_partitions(axis)%intervals,compact_partitions(axis)%periodic,plans(axis)%input)
      call sync_after_kernel('compact_pack_lines_kernel',force_sync=.true.)
      call apply_compact_derivative_gpu(plans(axis),lines*components)
#ifdef ASTR_BUILD_TESTING
      call compare_direction_once(axis,kind,lines*components)
#endif
      call unpack_lines_kernel<<<dim3((dim+128)/128,lines*components,1),dim3(128,1,1)>>>( &
        axis,kind,im,jm,km,plans(axis)%first,dim+1,dim,lines,components,lower(axis),upper(axis),plans(axis)%solution)
      call sync_after_kernel('compact_unpack_lines_kernel',force_sync=.true.)
    enddo
  end subroutine

#ifdef ASTR_BUILD_TESTING
  subroutine compare_filter_once(axis,offset,components,nrhs)
    integer,intent(in) :: axis,offset,components,nrhs
    call compare_global_once(axis,0,offset,components,nrhs)
  end subroutine

  subroutine compare_direction_once(axis,kind,nrhs)
    integer,intent(in) :: axis,kind,nrhs
    call compare_global_once(axis,kind,1,1,nrhs)
  end subroutine

  subroutine compare_global_once(axis,kind,offset,components,nrhs)
    use mpi
    use commvar, only: alfa_filter
    use filter, only: coef6i,coef8i,coef10i,coefb
    use constdef, only: num7d9,num1d36
    use compact_operator, only: compact_cpu_plan,periodic_compact_core,prepare_compact_cpu, &
      solve_compact_cpu,release_compact_cpu,compact_derivative_core,compact_derivative_rhs, &
      compact_filter_core,compact_filter_rhs_global
    use compact_line_solver, only: compact_matrix
    use ieee_arithmetic, only: ieee_is_finite
    use parallel, only: mpirank
    integer,intent(in) :: axis,kind,offset,components,nrhs
    type(compact_cpu_plan) :: cpu
    type(compact_matrix) :: matrix
    character(8) :: flag
    integer :: status,dim,halo,n,j,k,column,rank,ranks,comm,ierr
    real(8),allocatable :: f(:,:),actual(:,:),raw(:,:),rhs(:,:),expected(:,:),reference(:,:),physical(:,:)
    real(8),allocatable :: send(:,:),low(:,:),high(:,:),residual_field(:,:),norms(:,:),global_norms(:,:)
    real(8) :: alpha,edge(2),abs_error,scaled_error,residual,scale,matrix_norm,global_matrix_norm
    if(kind==0) then
      if(filter_compared(axis,offset)) return
    else
      if(compared(axis,kind)) return
    endif
    call get_environment_variable('ASTR_GPU_COMPACT_COMPARE',flag,status=status)
    if(status==1) return
    if(status/=0.or.trim(flag)/='1') error stop 'ASTR_GPU_COMPACT_COMPARE must be 1 when set'
    dim=compact_partitions(axis)%local_intervals
    n=compact_partitions(axis)%owned
    halo=plans(axis)%hm
    if(kind==0) halo=filters(axis)%hm
    allocate(f(-halo:dim+halo,nrhs),actual(dim+1,nrhs),raw(n,nrhs),rhs(n,nrhs), &
      expected(n,nrhs),reference(n,nrhs),physical(dim+1,nrhs))
    alpha=1.d0/3.d0
    if(kind==0) then
      alpha=alfa_filter
      status=cudaMemcpy(f,filters(axis)%input,(dim+2*halo+1)*nrhs,cudaMemcpyDeviceToHost)
      if(status/=cudaSuccess) error stop 'compact compare filter input copy failed'
      status=cudaMemcpy(actual,filters(axis)%filtered,(dim+1)*nrhs,cudaMemcpyDeviceToHost)
      if(status/=cudaSuccess) error stop 'compact compare filter output copy failed'
      status=cudaMemcpy(raw,filters(axis)%solution,n*nrhs,cudaMemcpyDeviceToHost)
      if(status/=cudaSuccess) error stop 'compact compare filter raw copy failed'
      status=cudaMemcpy(rhs,filters(axis)%rhs,n*nrhs,cudaMemcpyDeviceToHost)
    else
      status=cudaMemcpy(f,plans(axis)%input,(dim+2*halo+1)*nrhs,cudaMemcpyDeviceToHost)
      if(status/=cudaSuccess) error stop 'compact compare derivative input copy failed'
      status=cudaMemcpy(actual,plans(axis)%solution,(dim+1)*nrhs,cudaMemcpyDeviceToHost)
      if(status/=cudaSuccess) error stop 'compact compare derivative output copy failed'
      status=cudaMemcpy(raw,plans(axis)%owned_solution,n*nrhs,cudaMemcpyDeviceToHost)
      if(status/=cudaSuccess) error stop 'compact compare derivative raw copy failed'
      status=cudaMemcpy(rhs,plans(axis)%rhs,n*nrhs,cudaMemcpyDeviceToHost)
    endif
    if(status/=cudaSuccess) error stop 'compact compare RHS copy failed'
    if(.not.all(ieee_is_finite(actual)).or..not.all(ieee_is_finite(raw)).or. &
      .not.all(ieee_is_finite(rhs))) error stop 'nonfinite same-state global compact arrays'
    if(kind==0) then
      call compact_filter_rhs_global(compact_partitions(axis),dim,halo,f,coef6i,coef8i,coef10i,coefb(0:2,0:6),expected)
    else
      call compact_derivative_rhs(compact_partitions(axis),dim,halo,f,expected)
    endif
    do column=1,nrhs
      if(maxval(abs(rhs(:,column)-expected(:,column)))>2.d-10*max(1.d0,maxval(abs(expected(:,column))))) &
        error stop 'global compact GPU RHS differs from independent CPU stencil'
    enddo
    comm=compact_line_comms(axis)
    rank=compact_partitions(axis)%rank
    ranks=compact_partitions(axis)%ranks
    if(kind==0) then
      call compact_filter_core(compact_partitions(axis),alpha,matrix,edge)
    else
      call compact_derivative_core(compact_partitions(axis),matrix,edge)
    endif
    call prepare_compact_cpu(matrix,edge,compact_partitions(axis),comm,nrhs,cpu)
    call solve_compact_cpu(cpu,expected,reference,physical,nrhs)
    call release_compact_cpu(cpu)
    if(kind==0.and..not.compact_partitions(axis)%periodic) then
      if(compact_partitions(axis)%first==0) physical(1,:)=f(0,:)
      if(compact_partitions(axis)%first+dim==compact_partitions(axis)%intervals) physical(dim+1,:)=f(dim,:)
    endif
    abs_error=0.d0
    scaled_error=0.d0
    do column=1,nrhs
      scale=max(1.d0,maxval(abs(physical(:,column))))
      abs_error=max(abs_error,maxval(abs(actual(:,column)-physical(:,column))), &
        maxval(abs(raw(:,column)-reference(:,column))))
      scaled_error=max(scaled_error,maxval(abs(actual(:,column)-physical(:,column)))/scale, &
        maxval(abs(raw(:,column)-reference(:,column)))/scale)
    enddo
    allocate(send(2,nrhs),low(2,nrhs),high(2,nrhs),residual_field(n,nrhs),norms(3,nrhs),global_norms(3,nrhs))
    send(1,:)=raw(1,:)
    send(2,:)=raw(n,:)
    call MPI_Sendrecv(send,2*nrhs,MPI_DOUBLE_PRECISION,modulo(rank-1,ranks),25001, &
      high,2*nrhs,MPI_DOUBLE_PRECISION,modulo(rank+1,ranks),25001,comm,MPI_STATUS_IGNORE,ierr)
    call MPI_Sendrecv(send,2*nrhs,MPI_DOUBLE_PRECISION,modulo(rank+1,ranks),25002, &
      low,2*nrhs,MPI_DOUBLE_PRECISION,modulo(rank-1,ranks),25002,comm,MPI_STATUS_IGNORE,ierr)
    residual_field=raw-expected
    do j=2,n
      residual_field(j,:)=residual_field(j,:)+matrix%lower(j)*raw(j-1,:)
    enddo
    do j=1,n-1
      residual_field(j,:)=residual_field(j,:)+matrix%upper(j)*raw(j+1,:)
    enddo
    residual_field(1,:)=residual_field(1,:)+edge(1)*low(2,:)
    residual_field(n,:)=residual_field(n,:)+edge(2)*high(1,:)
    matrix_norm=maxval(abs(matrix%diagonal)+abs(matrix%lower)+abs(matrix%upper))
    matrix_norm=max(matrix_norm,1.d0+abs(matrix%upper(1))+abs(edge(1)), &
      1.d0+abs(matrix%lower(n))+abs(edge(2)))
    call MPI_Allreduce(matrix_norm,global_matrix_norm,1,MPI_DOUBLE_PRECISION,MPI_MAX,comm,ierr)
    do column=1,nrhs
      norms(1,column)=maxval(abs(residual_field(:,column)))
      norms(2,column)=maxval(abs(expected(:,column)))
      norms(3,column)=maxval(abs(raw(:,column)))
    enddo
    call MPI_Allreduce(norms,global_norms,3*nrhs,MPI_DOUBLE_PRECISION,MPI_MAX,comm,ierr)
    residual=0.d0
    do column=1,nrhs
      scale=global_norms(2,column)+global_matrix_norm*global_norms(3,column)
      if(scale>0.d0) residual=max(residual,global_norms(1,column)/scale)
    enddo
    if(kind==0) then
      write(*,'(A,3(I0,1X),3(ES24.16,1X))') 'COMPACT_FILTER_SAME_STATE rank/axis/component abs/scaled/residual: ', &
        mpirank,axis,offset,abs_error,scaled_error,residual
      filter_compared(axis,offset:offset+components-1)=.true.
    else
      write(*,'(A,3(I0,1X),3(ES24.16,1X))') 'COMPACT_SAME_STATE rank/kind/axis abs/scaled/residual: ', &
        mpirank,kind,axis,abs_error,scaled_error,residual
      compared(axis,kind)=.true.
    endif
    if(scaled_error>2.d-10.or.residual>1.d-12) error stop 'global compact same-state CPU/GPU gate failed'
  end subroutine
#endif

  subroutine compact_gradcal_gpu()
    call apply_directional_operator(1)
  end subroutine

  subroutine compact_convection_gpu()
    call apply_directional_operator(2)
  end subroutine

  subroutine compact_diffusion_rhs_gpu()
    call apply_directional_operator(3)
  end subroutine

  attributes(global) subroutine compact_stress_kernel(im,jm,km,reynolds,prandtl,const5,tempconst,tempconst1)
    use commarray_gpu, only: vel_d,tmp_d,dvel_d,dtmp_d,sigma_d,qflux_d
    use constdef, only: num1d3
    integer,value :: im,jm,km
    real(8),value :: reynolds,prandtl,const5,tempconst,tempconst1
    integer :: i,j,k
    real(8) :: miu,miu2,hcc,tloc,s11,s12,s13,s22,s23,s33,skk,t11,t12,t13,t22,t23,t33
    i=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    j=(blockIdx%y-1)*blockDim%y+threadIdx%y-1
    k=(blockIdx%z-1)*blockDim%z+threadIdx%z-1
    if(i>im.or.j>jm.or.k>km) return
    tloc=tmp_d(i,j,k)
    miu=tloc*sqrt(tloc)*tempconst1/(tloc+tempconst)/reynolds
    miu2=2.d0*miu
    hcc=(miu/prandtl)/const5
    s11=dvel_d(i,j,k,1,1)
    s12=0.5d0*(dvel_d(i,j,k,1,2)+dvel_d(i,j,k,2,1))
    s13=0.5d0*(dvel_d(i,j,k,1,3)+dvel_d(i,j,k,3,1))
    s22=dvel_d(i,j,k,2,2)
    s23=0.5d0*(dvel_d(i,j,k,2,3)+dvel_d(i,j,k,3,2))
    s33=dvel_d(i,j,k,3,3)
    skk=num1d3*(s11+s22+s33)
    t11=miu2*(s11-skk); t12=miu2*s12; t13=miu2*s13
    t22=miu2*(s22-skk); t23=miu2*s23; t33=miu2*(s33-skk)
    sigma_d(i,j,k,1)=t11; sigma_d(i,j,k,2)=t12; sigma_d(i,j,k,3)=t13
    sigma_d(i,j,k,4)=t22; sigma_d(i,j,k,5)=t23; sigma_d(i,j,k,6)=t33
    qflux_d(i,j,k,1)=hcc*dtmp_d(i,j,k,1)+t11*vel_d(i,j,k,1)+t12*vel_d(i,j,k,2)+t13*vel_d(i,j,k,3)
    qflux_d(i,j,k,2)=hcc*dtmp_d(i,j,k,2)+t12*vel_d(i,j,k,1)+t22*vel_d(i,j,k,2)+t23*vel_d(i,j,k,3)
    qflux_d(i,j,k,3)=hcc*dtmp_d(i,j,k,3)+t13*vel_d(i,j,k,1)+t23*vel_d(i,j,k,2)+t33*vel_d(i,j,k,3)
  end subroutine

  subroutine compact_diffusion_flux_gpu()
    use commvar, only: im,jm,km,reynolds,prandtl,const5,tempconst,tempconst1
    call compact_gradcal_gpu()
    call compact_stress_kernel<<<dim3((im+8)/8,(jm+8)/8,(km+8)/8),dim3(8,8,8)>>>( &
      im,jm,km,reynolds,prandtl,const5,tempconst,tempconst1)
    call sync_after_kernel('compact_stress_kernel',force_sync=.true.)
  end subroutine

  subroutine release_compact_operator_gpu()
    integer :: axis
    do axis=1,3
      call release_compact_derivative_gpu(plans(axis))
      call release_compact_filter_gpu(filters(axis))
    enddo
    prepared=.false.
    filter_prepared=.false.
  end subroutine
end module
