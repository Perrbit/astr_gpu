module compact_operator_gpu
  use astr_precision, only: real_kind,real_bytes
  use astr_precision_mpi, only: mpi_real_type
  use cudafor
  use constdef, only: num1d3
  use compact_derivative_gpu
  use compact_filter_gpu, only: compact_filter_plan,prepare_compact_filter_gpu, &
    apply_compact_filter_gpu,release_compact_filter_gpu
  use compact_line_solver_gpu, only: compact_after_kernel,compact_batch_rhs
  use compact_runtime, only: global_compact_enabled,global_compact_filter_enabled,compact_partitions,compact_line_comms
  use compact_runtime, only: global_compact_gradient_enabled
  use keep_operator, only: keep_split_plan,build_keep_split_plan
  implicit none
  private
  public :: compact_global_enabled,compact_gradcal_gpu, &
    compact_convection_gpu,compact_diffusion_flux_gpu,compact_diffusion_rhs_gpu, &
    compact_filter_state_gpu,release_compact_operator_gpu,compact_keep_convection_gpu,compact_diffusion_boundary_rhs_gpu
  public :: compact_gradient_enabled
  type(compact_derivative_plan),save :: plans(3)
  type(compact_filter_plan),save :: filters(3)
  logical,save :: configured=.false.,enabled=.false.,prepared=.false.
  logical,save :: filter_prepared=.false.,filter_compared(3,5)=.false.
  logical,save :: compared(3,3)=.false.
  integer,device,allocatable,save :: keep_left_d(:,:),keep_right_d(:,:),keep_component_d(:),keep_basis_d(:)
  real(real_kind),device,allocatable,save :: keep_weight_d(:)
  integer,save :: keep_terms=0,keep_bases=0
contains
  attributes(device) subroutine keep_point_variables(axis,i,j,k,gamma,variables)
    use commarray_gpu, only: rho_d,vel_d,prs_d,jacob_d,dxi_d
    integer,value :: axis,i,j,k
    real(real_kind),value :: gamma
    real(real_kind),intent(out) :: variables(9)
    integer :: c
    variables(1)=rho_d(i,j,k)
    do c=1,3
      variables(1+c)=vel_d(i,j,k,c)
      variables(6+c)=jacob_d(i,j,k)*dxi_d(i,j,k,axis,c)
    enddo
    variables(5)=prs_d(i,j,k)/rho_d(i,j,k)/(gamma-1.e0_real_kind)
    variables(6)=prs_d(i,j,k)
  end subroutine

  attributes(global) subroutine keep_pack_split_kernel(axis,im,jm,km,hm,dim,lines,nrhs,start,valid_first,valid_last,gamma,f)
    integer,value :: axis,im,jm,km,hm,dim,lines,nrhs,start,valid_first,valid_last
    real(real_kind),value :: gamma
    real(real_kind),device,intent(out) :: f(-hm:dim+hm,nrhs)
    real(real_kind) :: variables(9),value
    integer :: position,column,index,line,basis,i,j,k,c,power
    position=(blockIdx%x-1)*blockDim%x+threadIdx%x-1-hm
    column=blockIdx%y
    if(position>dim+hm) return
    if(position<valid_first.or.position>valid_last) then
      f(position,column)=0.e0_real_kind
      return
    endif
    index=start+column-1
    line=mod(index,lines)+1
    basis=index/lines+1
    call line_point(axis,position,line,im,jm,i,j,k)
    call keep_point_variables(axis,i,j,k,gamma,variables)
    value=1.e0_real_kind
    do c=1,9
      do power=1,keep_right_d(c,basis)
        value=value*variables(c)
      enddo
    enddo
    f(position,column)=value
  end subroutine

  attributes(global) subroutine keep_commit_split_kernel(axis,im,jm,km,dim,lines,nrhs,start,terms, &
      i0,i1,j0,j1,k0,k1,gamma,df)
    use commarray_gpu, only: qrhs_d
    integer,value :: axis,im,jm,km,dim,lines,nrhs,start,terms,i0,i1,j0,j1,k0,k1
    real(real_kind),value :: gamma
    real(real_kind),device,intent(in) :: df(dim+1,nrhs)
    real(real_kind) :: variables(9),result(5),factor
    integer :: index,i,j,k,line,position,t,column,c,power
    index=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    if(index>=(im+1)*(jm+1)*(km+1)) return
    i=mod(index,im+1);j=mod(index/(im+1),jm+1);k=index/((im+1)*(jm+1))
    if(i<i0.or.i>i1.or.j<j0.or.j>j1.or.k<k0.or.k>k1) return
    select case(axis)
    case(1);position=i;line=j+(jm+1)*k
    case(2);position=j;line=i+(im+1)*k
    case(3);position=k;line=i+(im+1)*j
    end select
    call keep_point_variables(axis,i,j,k,gamma,variables)
    result=qrhs_d(i,j,k,1:5)
    do t=1,terms
      column=(keep_basis_d(t)-1)*lines+line-start+1
      if(column<1.or.column>nrhs) cycle
      factor=keep_weight_d(t)
      do c=1,9
        do power=1,keep_left_d(c,t)
          factor=factor*variables(c)
        enddo
      enddo
      c=keep_component_d(t)
      result(c)=result(c)-factor*df(position+1,column)
    enddo
    qrhs_d(i,j,k,1:5)=result
  end subroutine

  subroutine compact_keep_convection_gpu()
    use commvar, only: im,jm,km,hm,gamma,is,ie,js,je,ks,ke
    integer :: axis,dim,lines,start,nrhs,total,valid_first,valid_last
    call prepare_operator()
    if(keep_terms==0) then
      block
      type(keep_split_plan) :: split
      call build_keep_split_plan(split)
      keep_terms=split%terms;keep_bases=split%bases
      allocate(keep_left_d(9,keep_terms),keep_right_d(9,keep_bases), &
        keep_component_d(keep_terms),keep_basis_d(keep_terms),keep_weight_d(keep_terms))
      keep_left_d=split%left(:,1:keep_terms)
      keep_right_d=split%right(:,1:keep_bases)
      keep_component_d=split%component(1:keep_terms)
      keep_basis_d=split%derivative(1:keep_terms)
      keep_weight_d=split%weight(1:keep_terms)
      end block
    endif
    total=(im+1)*(jm+1)*(km+1)
    do axis=1,3
      dim=plans(axis)%dim
      lines=total/(dim+1)
      valid_first=-hm;valid_last=dim+hm
      if(.not.compact_partitions(axis)%periodic) then
        valid_first=max(valid_first,-compact_partitions(axis)%first)
        valid_last=min(valid_last,compact_partitions(axis)%intervals-compact_partitions(axis)%first)
      endif
      do start=0,lines*keep_bases-1,plans(axis)%capacity
        nrhs=min(plans(axis)%capacity,lines*keep_bases-start)
        call keep_pack_split_kernel<<<dim3((dim+2*hm+128)/128,nrhs,1),128>>>( &
          axis,im,jm,km,hm,dim,lines,nrhs,start,valid_first,valid_last,gamma,plans(axis)%input)
        call compact_after_kernel('keep compact pack')
        call apply_compact_derivative_gpu(plans(axis),nrhs)
        call keep_commit_split_kernel<<<(total+511)/512,512>>>( &
          axis,im,jm,km,dim,lines,nrhs,start,keep_terms,is,ie,js,je,ks,ke,gamma,plans(axis)%solution)
        call compact_after_kernel('keep compact accumulate')
      enddo
    enddo
  end subroutine

  logical function compact_global_enabled() result(active)
    use precision_mode_gpu, only: gpu_mixed_workspace_requested
    use gpu_check, only: gpu_selective_sync_enabled,gpu_dependency_sync_enabled
    use parallel, only: lio
    if(.not.configured) then
      enabled=global_compact_enabled()
      if(enabled.or.global_compact_filter_enabled()) then
        if(gpu_mixed_workspace_requested().or.gpu_selective_sync_enabled().or.gpu_dependency_sync_enabled()) &
          error stop 'Global compact requires native precision and explicit synchronization'
        if(lio) write(*,'(A)') 'COMPACT GPU: globally coupled two-level PCR'
      endif
      configured=.true.
    endif
    active=enabled
  end function

  logical function compact_gradient_enabled() result(active)
    logical :: admitted
    admitted=compact_global_enabled()
    active=admitted.and.global_compact_gradient_enabled()
  end function

  subroutine prepare_operator()
    use commvar, only: im,jm,km,hm,npdci,npdcj,npdck
    use parallel, only: lio
    integer :: dims(3),ntypes(3),axis,lines
    integer(8) :: bytes
    if(prepared) return
    if(.not.compact_global_enabled()) error stop 'compact operator called outside global admission'
    dims=[im,jm,km]
    ntypes=[npdci,npdcj,npdck]
    bytes=0_8
    do axis=1,3
      lines=(im+1)*(jm+1)*(km+1)/(dims(axis)+1)
      call prepare_compact_derivative_gpu(dims(axis),hm,ntypes(axis),min(5*lines,compact_batch_rhs()),plans(axis), &
        compact_partitions(axis),compact_line_comms(axis))
      bytes=bytes+plans(axis)%global_line%device_bytes+ &
        int(real_bytes,8)*plans(axis)%capacity*(2_8*dims(axis)+2*hm+2+2_8*plans(axis)%global_line%n)
    enddo
    if(lio) write(*,'(A,I0)') 'COMPACT_DERIVATIVE_PACKED_DEVICE_BYTES=',bytes
    prepared=.true.
  end subroutine

  subroutine prepare_filter_operator()
    use commvar, only: im,jm,km,hm,numq
    use filter, only: filter_i,filter_j,filter_k
    use commarray_gpu, only: gpu_scalar_filter_workspace_enabled
    use parallel, only: lio
    integer :: components,axis
    integer(8) :: bytes
    if(filter_prepared) return
    components=numq
    if(gpu_scalar_filter_workspace_enabled()) components=1
    call prepare_compact_filter_gpu(filter_i,hm,min(components*(jm+1)*(km+1),compact_batch_rhs()),filters(1), &
      compact_partitions(1),compact_line_comms(1))
    call prepare_compact_filter_gpu(filter_j,hm,min(components*(im+1)*(km+1),compact_batch_rhs()),filters(2), &
      compact_partitions(2),compact_line_comms(2))
    call prepare_compact_filter_gpu(filter_k,hm,min(components*(im+1)*(jm+1),compact_batch_rhs()),filters(3), &
      compact_partitions(3),compact_line_comms(3))
    bytes=0_8
    do axis=1,3
      bytes=bytes+filters(axis)%global_line%device_bytes+ &
        int(real_bytes,8)*(filters(axis)%capacity*(2_8*filters(axis)%dim+2*hm+2+ &
        2_8*filters(axis)%global_line%n)+69_8)
    enddo
    if(lio) write(*,'(A,I0)') 'COMPACT_FILTER_PACKED_DEVICE_BYTES=',bytes
    filter_prepared=.true.
  end subroutine

  ! A column is one complete local line/component; authoritative field layout is unchanged.
  attributes(device) subroutine line_point(axis,position,line,im,jm,i,j,k)
    integer,value :: axis,position,line,im,jm
    integer,intent(out) :: i,j,k
    select case(axis)
    case(1)
      i=position; j=mod(line-1,jm+1); k=(line-1)/(jm+1)
    case(2)
      i=mod(line-1,im+1); j=position; k=(line-1)/(im+1)
    case(3)
      i=mod(line-1,im+1); j=(line-1)/(im+1); k=position
    end select
  end subroutine

  attributes(global) subroutine pack_lines_kernel(axis,kind,im,jm,km,hm,dim,lines,nrhs,start,first,total,periodic,f)
    use commarray_gpu, only: q_d,vel_d,tmp_d,prs_d,dxi_d,jacob_d,sigma_d,qflux_d
    integer,value :: axis,kind,im,jm,km,hm,dim,lines,nrhs,start
    integer,value :: first,total
    logical,value :: periodic
    real(real_kind),device,intent(out) :: f(-hm:dim+hm,nrhs)
    integer :: position,column,line,m,i,j,k,index
    real(real_kind) :: value,uu,p,metric(3)
    position=(blockIdx%x-1)*blockDim%x+threadIdx%x-1-hm
    column=blockIdx%y
    if(position>dim+hm) return
    if(.not.periodic.and.(first+position<0.or.first+position>total)) then
      f(position,column)=0.e0_real_kind
      return
    endif
    index=start+column-1
    line=mod(index,lines)+1
    m=index/lines+1
    call line_point(axis,position,line,im,jm,i,j,k)
    select case(kind)
    case(1)
      if(m<=3) then
        value=vel_d(i,j,k,m)
      else
        value=tmp_d(i,j,k)
      endif
    case(2)
      metric=dxi_d(i,j,k,axis,:)
      uu=metric(1)*vel_d(i,j,k,1)+metric(2)*vel_d(i,j,k,2)+metric(3)*vel_d(i,j,k,3)
      p=prs_d(i,j,k)
      select case(m)
      case(1)
        value=jacob_d(i,j,k)*q_d(i,j,k,1)*uu
      case(2:4)
        value=jacob_d(i,j,k)*(q_d(i,j,k,m)*uu+metric(m-1)*p)
      case(5)
        value=jacob_d(i,j,k)*(q_d(i,j,k,5)+p)*uu
      end select
    case(3,4)
      metric=dxi_d(i,j,k,axis,:)
      select case(m)
      case(1)
        value=sigma_d(i,j,k,1)*metric(1)+sigma_d(i,j,k,2)*metric(2)+sigma_d(i,j,k,3)*metric(3)
      case(2)
        value=sigma_d(i,j,k,2)*metric(1)+sigma_d(i,j,k,4)*metric(2)+sigma_d(i,j,k,5)*metric(3)
      case(3)
        value=sigma_d(i,j,k,3)*metric(1)+sigma_d(i,j,k,5)*metric(2)+sigma_d(i,j,k,6)*metric(3)
      case(4)
        value=qflux_d(i,j,k,1)*metric(1)+qflux_d(i,j,k,2)*metric(2)+qflux_d(i,j,k,3)*metric(3)
      end select
      value=value*jacob_d(i,j,k)
    end select
    f(position,column)=value
  end subroutine

  attributes(global) subroutine unpack_lines_kernel(axis,kind,im,jm,km,first,n,dim,lines,nrhs,start,lo,hi, &
      inner_i0,inner_i1,inner_j0,inner_j1,inner_k0,inner_k1,df)
    use commarray_gpu, only: qrhs_d,dvel_d,dtmp_d,dxi_d
    integer,value :: axis,kind,im,jm,km,first,n,dim,lines,nrhs,start
    integer,value :: lo,hi
    integer,value :: inner_i0,inner_i1,inner_j0,inner_j1,inner_k0,inner_k1
    real(real_kind),device,intent(in) :: df(n,nrhs)
    integer :: position,column,line,m,i,j,k,b,index
    real(real_kind) :: value,contribution
    position=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    column=blockIdx%y
    if(position>dim) return
    index=start+column-1
    line=mod(index,lines)+1
    m=index/lines+1
    call line_point(axis,position,line,im,jm,i,j,k)
    value=df(position-first+1,column)
    select case(kind)
    case(1)
      do b=1,3
        contribution=value*dxi_d(i,j,k,axis,b)
        if(m<=3) then
          if(axis==1) dvel_d(i,j,k,m,b)=0.e0_real_kind
          dvel_d(i,j,k,m,b)=dvel_d(i,j,k,m,b)+contribution
        else
          if(axis==1) dtmp_d(i,j,k,b)=0.e0_real_kind
          dtmp_d(i,j,k,b)=dtmp_d(i,j,k,b)+contribution
        endif
      enddo
    case(2)
      if(i<inner_i0.or.i>inner_i1.or.j<inner_j0.or.j>inner_j1.or.k<inner_k0.or.k>inner_k1) return
      qrhs_d(i,j,k,m)=qrhs_d(i,j,k,m)-value
    case(3,4)
      if(position<lo.or.position>hi) return
      if(kind==4) then
        if(i>=inner_i0.and.i<=inner_i1.and.j>=inner_j0.and.j<=inner_j1.and.k>=inner_k0.and.k<=inner_k1) return
      endif
      qrhs_d(i,j,k,m+1)=qrhs_d(i,j,k,m+1)+value
    end select
  end subroutine

  attributes(global) subroutine pack_filter_lines_kernel(axis,im,jm,km,hm,dim,lines,nrhs,start,offset,first,total,periodic,f)
    use commarray_gpu, only: q_d
    integer,value :: axis,im,jm,km,hm,dim,lines,nrhs,start,offset
    integer,value :: first,total
    logical,value :: periodic
    real(real_kind),device,intent(out) :: f(-hm:dim+hm,nrhs)
    integer :: position,column,line,m,i,j,k,index
    position=(blockIdx%x-1)*blockDim%x+threadIdx%x-1-hm
    column=blockIdx%y
    if(position>dim+hm) return
    if(.not.periodic.and.(first+position<0.or.first+position>total)) then
      f(position,column)=0.e0_real_kind
      return
    endif
    index=start+column-1
    line=mod(index,lines)+1
    m=index/lines+offset
    call line_point(axis,position,line,im,jm,i,j,k)
    f(position,column)=q_d(i,j,k,m)
  end subroutine

  attributes(global) subroutine commit_filter_lines_kernel(axis,im,jm,km,dim,lines,nrhs,start,offset,filtered)
    use commarray_gpu, only: q_d
    integer,value :: axis,im,jm,km,dim,lines,nrhs,start,offset
    real(real_kind),device,intent(in) :: filtered(0:dim,nrhs)
    integer :: position,column,line,m,i,j,k,index
    position=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    column=blockIdx%y
    if(position>dim) return
    index=start+column-1
    line=mod(index,lines)+1
    m=index/lines+offset
    call line_point(axis,position,line,im,jm,i,j,k)
    q_d(i,j,k,m)=filtered(position,column)
  end subroutine

  subroutine compact_filter_state_gpu()
    use commvar, only: im,jm,km,hm,numq
    use commarray_gpu, only: q_d,gpu_scalar_filter_workspace_enabled
    use halo_exchange_gpu, only: exchange_field_halo_gpu
    integer :: axis,lines,components,offset,dim,start,nrhs
    call prepare_filter_operator()
    components=numq
    if(gpu_scalar_filter_workspace_enabled()) components=1
    do axis=1,3
      ! Match CPU dataswap: finish the previous axis, then refresh only this axis's halos.
      call exchange_field_halo_gpu(q_d,numq,direction=axis)
      dim=filters(axis)%dim
      lines=(im+1)*(jm+1)*(km+1)/(dim+1)
      do offset=1,numq,components
      do start=0,lines*components-1,filters(axis)%capacity
        nrhs=min(filters(axis)%capacity,lines*components-start)
        call pack_filter_lines_kernel<<<dim3((dim+2*hm+128)/128,nrhs,1),dim3(128,1,1)>>>( &
          axis,im,jm,km,hm,dim,lines,nrhs,start,offset,compact_partitions(axis)%first, &
          compact_partitions(axis)%intervals,compact_partitions(axis)%periodic,filters(axis)%input)
        call compact_after_kernel('compact_pack_filter_lines_kernel')
        call apply_compact_filter_gpu(filters(axis),nrhs)
#ifdef ASTR_BUILD_TESTING
        call compare_filter_once(axis,offset,components,nrhs)
#endif
        ! This batch no longer reads q: its source and RHS have already been captured.
        call commit_filter_lines_kernel<<<dim3((dim+128)/128,nrhs,1),dim3(128,1,1)>>>( &
          axis,im,jm,km,dim,lines,nrhs,start,offset,filters(axis)%filtered)
        call compact_after_kernel('compact_commit_filter_lines_kernel', &
          complete=axis==3.and.offset+components>numq.and.start+nrhs==lines*components)
      enddo
      enddo
    enddo
  end subroutine

  subroutine apply_directional_operator(kind)
    use commvar, only: im,jm,km,hm,is,ie,js,je,ks,ke,ia,ja,ka,lihomo,ljhomo,lkhomo
    use parallel, only: ig0,jg0,kg0
    integer,intent(in) :: kind
    integer :: axis,lines,components,dim,lower(3),upper(3),start,nrhs,inner_first(3),inner_last(3),offset(3),total(3)
    logical :: periodic(3)
    call prepare_operator()
    components=4
    if(kind==2) components=5
    lower=[is,js,ks]
    upper=[ie,je,ke]
    inner_first=0;inner_last=[im,jm,km]
    if(kind==2) then
      inner_first=lower;inner_last=upper
    endif
    if(kind==4) then
      offset=[ig0,jg0,kg0];total=[ia,ja,ka];periodic=[lihomo,ljhomo,lkhomo]
      do axis=1,3
        if(periodic(axis)) cycle
        inner_first(axis)=max(0,4-offset(axis))
        inner_last(axis)=min(inner_last(axis),total(axis)-4-offset(axis))
      enddo
    endif
    do axis=1,3
      dim=plans(axis)%dim
      lines=(im+1)*(jm+1)*(km+1)/(dim+1)
      do start=0,lines*components-1,plans(axis)%capacity
      nrhs=min(plans(axis)%capacity,lines*components-start)
      call pack_lines_kernel<<<dim3((dim+2*hm+128)/128,nrhs,1),dim3(128,1,1)>>>( &
        axis,kind,im,jm,km,hm,dim,lines,nrhs,start,compact_partitions(axis)%first, &
        compact_partitions(axis)%intervals,compact_partitions(axis)%periodic,plans(axis)%input)
      call compact_after_kernel('compact_pack_lines_kernel')
      call apply_compact_derivative_gpu(plans(axis),nrhs)
#ifdef ASTR_BUILD_TESTING
      call compare_direction_once(axis,min(kind,3),nrhs)
#endif
      call unpack_lines_kernel<<<dim3((dim+128)/128,nrhs,1),dim3(128,1,1)>>>( &
        axis,kind,im,jm,km,plans(axis)%first,dim+1,dim,lines,nrhs,start,lower(axis),upper(axis), &
        inner_first(1),inner_last(1),inner_first(2),inner_last(2),inner_first(3),inner_last(3),plans(axis)%solution)
      call compact_after_kernel('compact_unpack_lines_kernel',complete=axis==3.and.start+nrhs==lines*components)
      enddo
    enddo
  end subroutine

#ifdef ASTR_BUILD_TESTING
  subroutine compare_filter_once(axis,offset,components,nrhs)
    integer,intent(in) :: axis,offset,components,nrhs
    call compare_global_once(axis,0,offset,components,nrhs)
  end subroutine

  subroutine compare_direction_once(axis,kind,nrhs)
    integer,intent(in) :: axis,kind,nrhs
    call compare_global_once(axis,kind,1,1,nrhs)
  end subroutine

  subroutine compare_global_once(axis,kind,offset,components,nrhs)
    use mpi
    use commvar, only: alfa_filter
    use filter, only: coef6i,coef8i,coef10i,coefb
    use constdef, only: num7d9,num1d36
    use compact_operator, only: compact_cpu_plan,periodic_compact_core,prepare_compact_cpu, &
      solve_compact_cpu,release_compact_cpu,compact_derivative_core,compact_derivative_rhs, &
      compact_filter_core,compact_filter_rhs_global
    use compact_line_solver, only: compact_matrix
    use ieee_arithmetic, only: ieee_is_finite
    use parallel, only: mpirank
    integer,intent(in) :: axis,kind,offset,components,nrhs
    type(compact_cpu_plan) :: cpu
    type(compact_matrix) :: matrix
    character(8) :: flag
    integer :: status,dim,halo,n,j,k,column,rank,ranks,comm,ierr
    real(real_kind),allocatable :: f(:,:),actual(:,:),raw(:,:),rhs(:,:),expected(:,:),reference(:,:),physical(:,:)
    real(real_kind),allocatable :: send(:,:),low(:,:),high(:,:),residual_field(:,:),norms(:,:),global_norms(:,:)
    real(real_kind) :: alpha,edge(2),abs_error,scaled_error,residual,scale,matrix_norm,global_matrix_norm
    real(real_kind) :: rhs_abs_error,rhs_scaled_error
    if(kind==0) then
      if(filter_compared(axis,offset)) return
    else
      if(compared(axis,kind)) return
    endif
    call get_environment_variable('ASTR_GPU_COMPACT_COMPARE',flag,status=status)
    if(status==1) return
    if(status/=0.or.trim(flag)/='1') error stop 'ASTR_GPU_COMPACT_COMPARE must be 1 when set'
    dim=compact_partitions(axis)%local_intervals
    n=compact_partitions(axis)%owned
    halo=plans(axis)%hm
    if(kind==0) halo=filters(axis)%hm
    allocate(f(-halo:dim+halo,nrhs),actual(dim+1,nrhs),raw(n,nrhs),rhs(n,nrhs), &
      expected(n,nrhs),reference(n,nrhs),physical(dim+1,nrhs))
    alpha=1.e0_real_kind/3.e0_real_kind
    if(kind==0) then
      alpha=alfa_filter
      status=cudaMemcpy(f,filters(axis)%input,(dim+2*halo+1)*nrhs,cudaMemcpyDeviceToHost)
      if(status/=cudaSuccess) error stop 'compact compare filter input copy failed'
      status=cudaMemcpy(actual,filters(axis)%filtered,(dim+1)*nrhs,cudaMemcpyDeviceToHost)
      if(status/=cudaSuccess) error stop 'compact compare filter output copy failed'
      status=cudaMemcpy(raw,filters(axis)%solution,n*nrhs,cudaMemcpyDeviceToHost)
      if(status/=cudaSuccess) error stop 'compact compare filter raw copy failed'
      status=cudaMemcpy(rhs,filters(axis)%rhs,n*nrhs,cudaMemcpyDeviceToHost)
    else
      status=cudaMemcpy(f,plans(axis)%input,(dim+2*halo+1)*nrhs,cudaMemcpyDeviceToHost)
      if(status/=cudaSuccess) error stop 'compact compare derivative input copy failed'
      status=cudaMemcpy(actual,plans(axis)%solution,(dim+1)*nrhs,cudaMemcpyDeviceToHost)
      if(status/=cudaSuccess) error stop 'compact compare derivative output copy failed'
      status=cudaMemcpy(raw,plans(axis)%owned_solution,n*nrhs,cudaMemcpyDeviceToHost)
      if(status/=cudaSuccess) error stop 'compact compare derivative raw copy failed'
      status=cudaMemcpy(rhs,plans(axis)%rhs,n*nrhs,cudaMemcpyDeviceToHost)
    endif
    if(status/=cudaSuccess) error stop 'compact compare RHS copy failed'
    if(.not.all(ieee_is_finite(actual)).or..not.all(ieee_is_finite(raw)).or. &
      .not.all(ieee_is_finite(rhs))) error stop 'nonfinite same-state global compact arrays'
    if(kind==0) then
      call compact_filter_rhs_global(compact_partitions(axis),dim,halo,f,coef6i,coef8i,coef10i,coefb(0:2,0:6),expected)
    else
      call compact_derivative_rhs(compact_partitions(axis),dim,halo,f,expected)
    endif
    if(.not.all(ieee_is_finite(expected))) error stop 'nonfinite compact CPU stencil reference'
    rhs_abs_error=0.e0_real_kind; rhs_scaled_error=0.e0_real_kind
    do column=1,nrhs
      scale=max(1.e0_real_kind,maxval(abs(expected(:,column))))
      rhs_abs_error=max(rhs_abs_error,maxval(abs(rhs(:,column)-expected(:,column))))
      rhs_scaled_error=max(rhs_scaled_error,maxval(abs(rhs(:,column)-expected(:,column)))/scale)
    enddo
    write(*,'(A,3(I0,1X),2(ES24.16,1X))') 'COMPACT_RHS_SAME_STATE rank/kind/axis abs/scaled: ', &
      mpirank,kind,axis,rhs_abs_error,rhs_scaled_error
    if(real_bytes==8.and.rhs_scaled_error>2.e-10_real_kind) &
      error stop 'global compact GPU RHS differs from independent CPU stencil'
    comm=compact_line_comms(axis)
    rank=compact_partitions(axis)%rank
    ranks=compact_partitions(axis)%ranks
    if(kind==0) then
      call compact_filter_core(compact_partitions(axis),alpha,matrix,edge)
    else
      call compact_derivative_core(compact_partitions(axis),matrix,edge)
    endif
    call prepare_compact_cpu(matrix,edge,compact_partitions(axis),comm,nrhs,cpu)
    call solve_compact_cpu(cpu,expected,reference,physical,nrhs)
    call release_compact_cpu(cpu)
    if(.not.all(ieee_is_finite(reference)).or..not.all(ieee_is_finite(physical))) &
      error stop 'nonfinite same-state compact CPU solution'
    if(kind==0.and..not.compact_partitions(axis)%periodic) then
      if(compact_partitions(axis)%first==0) physical(1,:)=f(0,:)
      if(compact_partitions(axis)%first+dim==compact_partitions(axis)%intervals) physical(dim+1,:)=f(dim,:)
    endif
    abs_error=0.e0_real_kind
    scaled_error=0.e0_real_kind
    do column=1,nrhs
      scale=max(1.e0_real_kind,maxval(abs(physical(:,column))))
      abs_error=max(abs_error,maxval(abs(actual(:,column)-physical(:,column))), &
        maxval(abs(raw(:,column)-reference(:,column))))
      scaled_error=max(scaled_error,maxval(abs(actual(:,column)-physical(:,column)))/scale, &
        maxval(abs(raw(:,column)-reference(:,column)))/scale)
    enddo
    allocate(send(2,nrhs),low(2,nrhs),high(2,nrhs),residual_field(n,nrhs),norms(3,nrhs),global_norms(3,nrhs))
    send(1,:)=raw(1,:)
    send(2,:)=raw(n,:)
    call MPI_Sendrecv(send,2*nrhs,mpi_real_type,modulo(rank-1,ranks),25001, &
      high,2*nrhs,mpi_real_type,modulo(rank+1,ranks),25001,comm,MPI_STATUS_IGNORE,ierr)
    call MPI_Sendrecv(send,2*nrhs,mpi_real_type,modulo(rank+1,ranks),25002, &
      low,2*nrhs,mpi_real_type,modulo(rank-1,ranks),25002,comm,MPI_STATUS_IGNORE,ierr)
    residual_field=raw-expected
    do j=2,n
      residual_field(j,:)=residual_field(j,:)+matrix%lower(j)*raw(j-1,:)
    enddo
    do j=1,n-1
      residual_field(j,:)=residual_field(j,:)+matrix%upper(j)*raw(j+1,:)
    enddo
    residual_field(1,:)=residual_field(1,:)+edge(1)*low(2,:)
    residual_field(n,:)=residual_field(n,:)+edge(2)*high(1,:)
    matrix_norm=maxval(abs(matrix%diagonal)+abs(matrix%lower)+abs(matrix%upper))
    matrix_norm=max(matrix_norm,1.e0_real_kind+abs(matrix%upper(1))+abs(edge(1)), &
      1.e0_real_kind+abs(matrix%lower(n))+abs(edge(2)))
    call MPI_Allreduce(matrix_norm,global_matrix_norm,1,mpi_real_type,MPI_MAX,comm,ierr)
    do column=1,nrhs
      norms(1,column)=maxval(abs(residual_field(:,column)))
      norms(2,column)=maxval(abs(expected(:,column)))
      norms(3,column)=maxval(abs(raw(:,column)))
    enddo
    call MPI_Allreduce(norms,global_norms,3*nrhs,mpi_real_type,MPI_MAX,comm,ierr)
    residual=0.e0_real_kind
    do column=1,nrhs
      scale=global_norms(2,column)+global_matrix_norm*global_norms(3,column)
      if(scale>0.e0_real_kind) residual=max(residual,global_norms(1,column)/scale)
    enddo
    if(kind==0) then
      write(*,'(A,3(I0,1X),3(ES24.16,1X))') 'COMPACT_FILTER_SAME_STATE rank/axis/component abs/scaled/residual: ', &
        mpirank,axis,offset,abs_error,scaled_error,residual
      filter_compared(axis,offset:offset+components-1)=.true.
    else
      write(*,'(A,3(I0,1X),3(ES24.16,1X))') 'COMPACT_SAME_STATE rank/kind/axis abs/scaled/residual: ', &
        mpirank,kind,axis,abs_error,scaled_error,residual
      compared(axis,kind)=.true.
    endif
    if(.not.all(ieee_is_finite([scaled_error,residual]))) error stop 'nonfinite same-state compact diagnostics'
    if(real_bytes==8.and.(scaled_error>2.e-10_real_kind.or.residual>1.e-12_real_kind)) &
      error stop 'global compact same-state CPU/GPU gate failed'
  end subroutine
#endif

  subroutine compact_gradcal_gpu()
    call apply_directional_operator(1)
  end subroutine

  subroutine compact_convection_gpu()
    call apply_directional_operator(2)
  end subroutine

  subroutine compact_diffusion_rhs_gpu()
    call apply_directional_operator(3)
  end subroutine

  subroutine compact_diffusion_boundary_rhs_gpu()
    call apply_directional_operator(4)
  end subroutine

  attributes(global) subroutine compact_stress_kernel(im,jm,km,reynolds,prandtl,const5,tempconst,tempconst1)
    use commarray_gpu, only: vel_d,tmp_d,dvel_d,dtmp_d,sigma_d,qflux_d
    integer,value :: im,jm,km
    real(real_kind),value :: reynolds,prandtl,const5,tempconst,tempconst1
    integer :: i,j,k
    real(real_kind) :: miu,miu2,hcc,tloc,s11,s12,s13,s22,s23,s33,skk,t11,t12,t13,t22,t23,t33
    i=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    j=(blockIdx%y-1)*blockDim%y+threadIdx%y-1
    k=(blockIdx%z-1)*blockDim%z+threadIdx%z-1
    if(i>im.or.j>jm.or.k>km) return
    tloc=tmp_d(i,j,k)
    miu=tloc*sqrt(tloc)*tempconst1/(tloc+tempconst)/reynolds
    miu2=2.e0_real_kind*miu
    hcc=(miu/prandtl)/const5
    s11=dvel_d(i,j,k,1,1)
    s12=0.5e0_real_kind*(dvel_d(i,j,k,1,2)+dvel_d(i,j,k,2,1))
    s13=0.5e0_real_kind*(dvel_d(i,j,k,1,3)+dvel_d(i,j,k,3,1))
    s22=dvel_d(i,j,k,2,2)
    s23=0.5e0_real_kind*(dvel_d(i,j,k,2,3)+dvel_d(i,j,k,3,2))
    s33=dvel_d(i,j,k,3,3)
    skk=num1d3*(s11+s22+s33)
    t11=miu2*(s11-skk); t12=miu2*s12; t13=miu2*s13
    t22=miu2*(s22-skk); t23=miu2*s23; t33=miu2*(s33-skk)
    sigma_d(i,j,k,1)=t11; sigma_d(i,j,k,2)=t12; sigma_d(i,j,k,3)=t13
    sigma_d(i,j,k,4)=t22; sigma_d(i,j,k,5)=t23; sigma_d(i,j,k,6)=t33
    qflux_d(i,j,k,1)=hcc*dtmp_d(i,j,k,1)+t11*vel_d(i,j,k,1)+t12*vel_d(i,j,k,2)+t13*vel_d(i,j,k,3)
    qflux_d(i,j,k,2)=hcc*dtmp_d(i,j,k,2)+t12*vel_d(i,j,k,1)+t22*vel_d(i,j,k,2)+t23*vel_d(i,j,k,3)
    qflux_d(i,j,k,3)=hcc*dtmp_d(i,j,k,3)+t13*vel_d(i,j,k,1)+t23*vel_d(i,j,k,2)+t33*vel_d(i,j,k,3)
  end subroutine

  subroutine compact_diffusion_flux_gpu()
    use commvar, only: im,jm,km,reynolds,prandtl,const5,tempconst,tempconst1
    call compact_gradcal_gpu()
    call compact_stress_kernel<<<dim3((im+8)/8,(jm+8)/8,(km+8)/8),dim3(8,8,8)>>>( &
      im,jm,km,reynolds,prandtl,const5,tempconst,tempconst1)
    call compact_after_kernel('compact_stress_kernel',complete=.true.)
  end subroutine

  subroutine release_compact_operator_gpu()
    integer :: axis
    do axis=1,3
      call release_compact_derivative_gpu(plans(axis))
      call release_compact_filter_gpu(filters(axis))
    enddo
    prepared=.false.
    filter_prepared=.false.
    if(allocated(keep_left_d)) deallocate(keep_left_d,keep_right_d,keep_component_d,keep_basis_d,keep_weight_d)
    keep_terms=0;keep_bases=0
  end subroutine
end module
