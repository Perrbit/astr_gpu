            sigma_d(i,j,k,3)*dxi_d(i,j,k,idir,3))*jacob_d(i,jj,jk)
    f(3) = (sigma_d(i,j,k,2)*dxi_d(i,j,k,idir,1) + &
            sigma_d(i,j,k,4)*dxi_d(i,j,k,idir,2) + &
            sigma_d(i,j,k,5)*dxi_d(i,j,k,idir,3))*jacob_d(i,jj,jk)
    f(4) = (sigma_d(i,j,k,3)*dxi_d(i,j,k,idir,1) + &
