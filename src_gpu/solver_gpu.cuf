    if(i > 0    .or. apply_left  == 0) call flux_at_xyphysical_global(i-1,j,k,1,im,jm,km,fm1)
    if(i < im-1 .or. apply_right == 0) call flux_at_xyphysical_global(i+2,j,k,1,im,jm,km,fp2)
    if(i > 1    .or. apply_left  == 0) call flux_at_xyphysical_global(i-2,j,k,1,im,jm,km,fm2)
