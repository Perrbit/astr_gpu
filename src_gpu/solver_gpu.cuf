  attributes(global) subroutine characteristic_upwind_flux_x_global_kernel( &
       im,jm,km,reconstruction_scheme,gamma)
    use commarray_gpu, only: flux_characteristic_work_d
    implicit none
    integer,value :: im,jm,km,reconstruction_scheme
    real(8),value :: gamma
    integer :: i,j,k,m
    real(8) :: fh(5)

    i=(blockIdx%x-1)*blockDim%x+threadIdx%x-2
    j=blockIdx%y-1
    k=blockIdx%z-1
    if(i < -1 .or. i > im .or. j < 0 .or. j > jm .or. k < 0 .or. k > km) return
    call characteristic_reconstruction_interface_flux( &
         i,j,k,1,im,jm,km,reconstruction_scheme,gamma,0,0,0,fh)
    do m=1,5
      flux_characteristic_work_d(i,j,k,m)=fh(m)
    enddo
  end subroutine characteristic_upwind_flux_x_global_kernel

