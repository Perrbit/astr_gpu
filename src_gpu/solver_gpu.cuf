  attributes(global) subroutine explicit_upwind_rhs_x_global_kernel(im,jm,km,ivar)
    use commarray_gpu, only: flux_work_d,qrhs_d
    implicit none
    integer,value :: im,jm,km,ivar
    integer :: i,j,k

    i = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    j = blockIdx%y - 1
    k = blockIdx%z - 1
    if(i < 0 .or. i > im .or. j < 0 .or. j > jm .or. k < 0 .or. k > km) return
    qrhs_d(i,j,k,ivar) = qrhs_d(i,j,k,ivar) &
         - (flux_work_d(i,j,k) - flux_work_d(i-1,j,k))
