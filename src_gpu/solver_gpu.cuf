    real(8),value :: gamma
    integer :: i,j,k
    real(8) :: fh

    i = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    j = (blockIdx%y - 1) * blockDim%y + threadIdx%y - 2
    k = blockIdx%z - 1
    if(i < 0 .or. i > im .or. j < -1 .or. j > jm .or. k < 0 .or. k > km) return
    fh = explicit_reconstruction_interface_flux( &
         i,j,k,2,ivar,split_sign,im,jm,km,reconstruction_scheme,gamma)
    if(split_sign > 0) then
      flux_work_d(i,j,k) = fh
    else
      flux_work_d(i,j,k) = flux_work_d(i,j,k) + fh
    endif
