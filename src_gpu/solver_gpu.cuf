module solver_gpu
  use cudafor
  implicit none
contains
  attributes(device) integer function wrap_periodic(idx,n)
    implicit none
    integer,value :: idx,n

    wrap_periodic = mod(idx,n)
    if(wrap_periodic < 0) wrap_periodic = wrap_periodic + n
  end function wrap_periodic

  attributes(device) integer function idx_periodic(idx,n)
    implicit none
    integer,value :: idx,n

    if(idx == n) then
      idx_periodic = 0
    else
      idx_periodic = wrap_periodic(idx,n)
    endif
  end function idx_periodic

  attributes(global) subroutine q_to_primitive_kernel(q,rho,vel,prs,tmp,const2,const6,im,jm,km,hm)
    implicit none
    integer,value :: im,jm,km,hm
    real(8),value :: const2,const6
    real(8),device :: q(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:5)
    real(8),device :: rho(-hm:im+hm,-hm:jm+hm,-hm:km+hm)
    real(8),device :: vel(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:3)
    real(8),device :: prs(-hm:im+hm,-hm:jm+hm,-hm:km+hm)
    real(8),device :: tmp(-hm:im+hm,-hm:jm+hm,-hm:km+hm)
    integer :: i,j,k
    real(8) :: den,ke

    i = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    j = (blockIdx%y - 1) * blockDim%y + threadIdx%y - 1
    k = (blockIdx%z - 1) * blockDim%z + threadIdx%z - 1
    if(i < 0 .or. i > im .or. j < 0 .or. j > jm .or. k < 0 .or. k > km) return

    den = q(i,j,k,1)
    rho(i,j,k) = den
    vel(i,j,k,1) = q(i,j,k,2) / den
    vel(i,j,k,2) = q(i,j,k,3) / den
    vel(i,j,k,3) = q(i,j,k,4) / den
    ke = 0.5d0 * den * (vel(i,j,k,1)**2 + vel(i,j,k,2)**2 + vel(i,j,k,3)**2)
    prs(i,j,k) = (q(i,j,k,5) - ke) / const6
    tmp(i,j,k) = prs(i,j,k) / den * const2
  end subroutine q_to_primitive_kernel

  attributes(global) subroutine periodic_copy_kernel(q,rho,vel,prs,tmp,im,jm,km,hm)
    implicit none
    integer,value :: im,jm,km,hm
    real(8),device :: q(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:5)
    real(8),device :: rho(-hm:im+hm,-hm:jm+hm,-hm:km+hm)
    real(8),device :: vel(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:3)
    real(8),device :: prs(-hm:im+hm,-hm:jm+hm,-hm:km+hm)
    real(8),device :: tmp(-hm:im+hm,-hm:jm+hm,-hm:km+hm)
    integer :: id,n,i,j,k,m,ii,jj,kk,ntot

    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    ntot = (im + 1) * (jm + 1) * (km + 1)
    if(id >= ntot) return

    i = mod(id,im+1)
    j = mod(id/(im+1),jm+1)
    k = id/((im+1)*(jm+1))

    if(i == 0 .or. j == 0 .or. k == 0) then
      ii = i
      jj = j
      kk = k
      if(i == 0) ii = im
      if(j == 0) jj = jm
      if(k == 0) kk = km
      do m=1,5
        q(i,j,k,m) = q(ii,jj,kk,m)
      enddo
      rho(i,j,k) = rho(ii,jj,kk)
      prs(i,j,k) = prs(ii,jj,kk)
      tmp(i,j,k) = tmp(ii,jj,kk)
      do m=1,3
        vel(i,j,k,m) = vel(ii,jj,kk,m)
      enddo
    endif
  end subroutine periodic_copy_kernel

  attributes(global) subroutine zero_rhs_kernel(qrhs,im,jm,km)
    implicit none
    integer,value :: im,jm,km
    real(8),device :: qrhs(0:im,0:jm,0:km,1:5)
    integer :: id,i,j,k,m,ntot

    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    ntot = (im + 1) * (jm + 1) * (km + 1)
    if(id >= ntot) return

    i = mod(id,im+1)
    j = mod(id/(im+1),jm+1)
    k = id/((im+1)*(jm+1))
    do m=1,5
      qrhs(i,j,k,m) = 0.d0
    enddo
  end subroutine zero_rhs_kernel

  attributes(global) subroutine channel_bulk_partial_kernel(q,x,partial,im,jm,km,hm)
    implicit none
    integer,value :: im,jm,km,hm
    real(8),device :: q(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:5)
    real(8),device :: x(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:3)
    real(8),device :: partial(:,:)
    real(8),shared :: scratch_ro(256),scratch_u1(256),scratch_u2(256),scratch_u3(256)
    integer :: tid,id,stride,ncell,i,j,k
    real(8) :: local_ro,local_u1,local_u2,local_u3,dy

    tid = threadIdx%x
    id = (blockIdx%x - 1) * blockDim%x + tid - 1
    stride = gridDim%x * blockDim%x
    ncell = im * jm * km
    local_ro = 0.d0
    local_u1 = 0.d0
    local_u2 = 0.d0
    local_u3 = 0.d0

    do while(id < ncell)
      i = mod(id,im) + 1
      j = mod(id/im,jm) + 1
      k = id/(im*jm) + 1
      dy = x(i,j,k,2) - x(i,j-1,k,2)
      local_ro = local_ro + 0.5d0 * (q(i,j-1,k,1) + q(i,j,k,1)) * dy
      local_u1 = local_u1 + 0.5d0 * (q(i,j-1,k,2) + q(i,j,k,2)) * dy
      local_u2 = local_u2 + 0.5d0 * (q(i,j-1,k,3) + q(i,j,k,3)) * dy
      local_u3 = local_u3 + 0.5d0 * (q(i,j-1,k,4) + q(i,j,k,4)) * dy
      id = id + stride
    enddo

    scratch_ro(tid) = local_ro
    scratch_u1(tid) = local_u1
    scratch_u2(tid) = local_u2
    scratch_u3(tid) = local_u3
    call syncthreads()

    stride = blockDim%x / 2
    do while(stride > 0)
      if(tid <= stride) then
        scratch_ro(tid) = scratch_ro(tid) + scratch_ro(tid + stride)
        scratch_u1(tid) = scratch_u1(tid) + scratch_u1(tid + stride)
        scratch_u2(tid) = scratch_u2(tid) + scratch_u2(tid + stride)
        scratch_u3(tid) = scratch_u3(tid) + scratch_u3(tid + stride)
      endif
      call syncthreads()
      stride = stride / 2
    enddo

    if(tid == 1) then
      partial(blockIdx%x,1) = scratch_ro(1)
      partial(blockIdx%x,2) = scratch_u1(1)
      partial(blockIdx%x,3) = scratch_u2(1)
      partial(blockIdx%x,4) = scratch_u3(1)
    endif
  end subroutine channel_bulk_partial_kernel

  attributes(global) subroutine channel_source_kernel(qrhs,im,jm,km,force1,force2,force3, &
       u1bulk,u2bulk,u3bulk)
    use commarray_gpu, only: jacob_d
    implicit none
    integer,value :: im,jm,km
    real(8),value :: force1,force2,force3,u1bulk,u2bulk,u3bulk
    real(8),device :: qrhs(0:im,0:jm,0:km,1:5)
    integer :: id,ntot,i,j,k
    real(8) :: src_energy,jloc

    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    ntot = (im + 1) * (jm + 1) * (km + 1)
    if(id >= ntot) return

    i = mod(id,im+1)
    j = mod(id/(im+1),jm+1)
    k = id/((im+1)*(jm+1))
    jloc = jacob_d(i,j,k)
    src_energy = force1*u1bulk + force2*u2bulk + force3*u3bulk
    qrhs(i,j,k,2) = qrhs(i,j,k,2) + force1*jloc
    qrhs(i,j,k,3) = qrhs(i,j,k,3) + force2*jloc
    qrhs(i,j,k,4) = qrhs(i,j,k,4) + force3*jloc
    qrhs(i,j,k,5) = qrhs(i,j,k,5) + src_energy*jloc
  end subroutine channel_source_kernel

  subroutine apply_channel_source_gpu()
    use mpi
    use commvar, only: im,jm,km,hm,force
    use commarray_gpu, only: q_d,x_d,qrhs_d
    use gpu_check, only: sync_after_kernel
    use parallel, only: mpisize
    implicit none
    integer,parameter :: block_size = 256
    integer :: ncell,ntot,nblocks,ierr
    real(8) :: local_sum(4),global_sum(4),robulk,u1bulk,u2bulk,u3bulk
    real(8),allocatable,device :: partial_d(:,:)
    real(8),allocatable :: partial_h(:,:)

    ncell = im * jm * km
    nblocks = max(1,(ncell + block_size - 1) / block_size)
    allocate(partial_d(nblocks,4))
    allocate(partial_h(nblocks,4))

    call channel_bulk_partial_kernel<<<nblocks,block_size>>>(q_d,x_d,partial_d,im,jm,km,hm)
    call sync_after_kernel('channel_bulk_partial_kernel')
    partial_h = partial_d
    local_sum(1) = sum(partial_h(:,1))
    local_sum(2) = sum(partial_h(:,2))
    local_sum(3) = sum(partial_h(:,3))
    local_sum(4) = sum(partial_h(:,4))

    if(mpisize > 1) then
      call mpi_allreduce(local_sum,global_sum,4,mpi_real8,mpi_sum,mpi_comm_world,ierr)
    else
      global_sum = local_sum
    endif

    robulk = global_sum(1)
    if(abs(robulk) < 1.d-300) stop 'GPU channel source encountered zero bulk density'
    u1bulk = global_sum(2) / robulk
    u2bulk = global_sum(3) / robulk
    u3bulk = global_sum(4) / robulk

    ntot = (im + 1) * (jm + 1) * (km + 1)
    nblocks = max(1,(ntot + block_size - 1) / block_size)
    call channel_source_kernel<<<nblocks,block_size>>>(qrhs_d,im,jm,km, &
         force(1),force(2),force(3),u1bulk,u2bulk,u3bulk)
    call sync_after_kernel('channel_source_kernel')

    deallocate(partial_d,partial_h)
  end subroutine apply_channel_source_gpu

  attributes(device) subroutine flux_at(q,vel,prs,jacob,dxi,im,jm,km,hm,i,j,k,idir,f)
    implicit none
    integer,value :: im,jm,km,hm,i,j,k,idir
    real(8),device :: q(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:5)
    real(8),device :: vel(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:3)
    real(8),device :: prs(-hm:im+hm,-hm:jm+hm,-hm:km+hm)
    real(8),device :: jacob(0:im,0:jm,0:km)
    real(8),device :: dxi(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:3,1:3)
    real(8) :: f(5)
    integer :: ii,jj,kk
    real(8) :: uu

    ii = idx_periodic(i,im)
    jj = idx_periodic(j,jm)
    kk = idx_periodic(k,km)
    uu = dxi(ii,jj,kk,idir,1)*vel(ii,jj,kk,1) + &
         dxi(ii,jj,kk,idir,2)*vel(ii,jj,kk,2) + &
         dxi(ii,jj,kk,idir,3)*vel(ii,jj,kk,3)
    f(1) = jacob(ii,jj,kk) * q(ii,jj,kk,1) * uu
    f(2) = jacob(ii,jj,kk) * (q(ii,jj,kk,2) * uu + dxi(ii,jj,kk,idir,1) * prs(ii,jj,kk))
    f(3) = jacob(ii,jj,kk) * (q(ii,jj,kk,3) * uu + dxi(ii,jj,kk,idir,2) * prs(ii,jj,kk))
    f(4) = jacob(ii,jj,kk) * (q(ii,jj,kk,4) * uu + dxi(ii,jj,kk,idir,3) * prs(ii,jj,kk))
    f(5) = jacob(ii,jj,kk) * (q(ii,jj,kk,5) + prs(ii,jj,kk)) * uu
  end subroutine flux_at

  attributes(global) subroutine convective_rhs_kernel(q,vel,prs,jacob,dxi,qrhs,im,jm,km,hm)
    implicit none
    integer,value :: im,jm,km,hm
    real(8),device :: q(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:5)
    real(8),device :: vel(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:3)
    real(8),device :: prs(-hm:im+hm,-hm:jm+hm,-hm:km+hm)
    real(8),device :: jacob(0:im,0:jm,0:km)
    real(8),device :: dxi(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:3,1:3)
    real(8),device :: qrhs(0:im,0:jm,0:km,1:5)
    integer :: i,j,k,m
    real(8) :: fp1(5),fm1(5),fp2(5),fm2(5),fp3(5),fm3(5),df

    i = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    j = (blockIdx%y - 1) * blockDim%y + threadIdx%y - 1
    k = (blockIdx%z - 1) * blockDim%z + threadIdx%z - 1
    if(i < 0 .or. i > im .or. j < 0 .or. j > jm .or. k < 0 .or. k > km) return

    call flux_at(q,vel,prs,jacob,dxi,im,jm,km,hm,i+1,j,k,1,fp1)
    call flux_at(q,vel,prs,jacob,dxi,im,jm,km,hm,i-1,j,k,1,fm1)
    call flux_at(q,vel,prs,jacob,dxi,im,jm,km,hm,i+2,j,k,1,fp2)
    call flux_at(q,vel,prs,jacob,dxi,im,jm,km,hm,i-2,j,k,1,fm2)
    call flux_at(q,vel,prs,jacob,dxi,im,jm,km,hm,i+3,j,k,1,fp3)
    call flux_at(q,vel,prs,jacob,dxi,im,jm,km,hm,i-3,j,k,1,fm3)
    do m=1,5
      df = 0.75d0*(fp1(m)-fm1(m)) - 0.15d0*(fp2(m)-fm2(m)) + (fp3(m)-fm3(m))/60.d0
      qrhs(i,j,k,m) = qrhs(i,j,k,m) - df
    enddo

    call flux_at(q,vel,prs,jacob,dxi,im,jm,km,hm,i,j+1,k,2,fp1)
    call flux_at(q,vel,prs,jacob,dxi,im,jm,km,hm,i,j-1,k,2,fm1)
    call flux_at(q,vel,prs,jacob,dxi,im,jm,km,hm,i,j+2,k,2,fp2)
    call flux_at(q,vel,prs,jacob,dxi,im,jm,km,hm,i,j-2,k,2,fm2)
    call flux_at(q,vel,prs,jacob,dxi,im,jm,km,hm,i,j+3,k,2,fp3)
    call flux_at(q,vel,prs,jacob,dxi,im,jm,km,hm,i,j-3,k,2,fm3)
    do m=1,5
      df = 0.75d0*(fp1(m)-fm1(m)) - 0.15d0*(fp2(m)-fm2(m)) + (fp3(m)-fm3(m))/60.d0
      qrhs(i,j,k,m) = qrhs(i,j,k,m) - df
    enddo

    call flux_at(q,vel,prs,jacob,dxi,im,jm,km,hm,i,j,k+1,3,fp1)
    call flux_at(q,vel,prs,jacob,dxi,im,jm,km,hm,i,j,k-1,3,fm1)
    call flux_at(q,vel,prs,jacob,dxi,im,jm,km,hm,i,j,k+2,3,fp2)
    call flux_at(q,vel,prs,jacob,dxi,im,jm,km,hm,i,j,k-2,3,fm2)
    call flux_at(q,vel,prs,jacob,dxi,im,jm,km,hm,i,j,k+3,3,fp3)
    call flux_at(q,vel,prs,jacob,dxi,im,jm,km,hm,i,j,k-3,3,fm3)
    do m=1,5
      df = 0.75d0*(fp1(m)-fm1(m)) - 0.15d0*(fp2(m)-fm2(m)) + (fp3(m)-fm3(m))/60.d0
      qrhs(i,j,k,m) = qrhs(i,j,k,m) - df
    enddo
  end subroutine convective_rhs_kernel

  attributes(global) subroutine convective_rhs_x_kernel(q,vel,prs,jacob,dxi,qrhs,im,jm,km,hm)
    implicit none
    integer,value :: im,jm,km,hm
    real(8),device :: q(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:5)
    real(8),device :: vel(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:3)
    real(8),device :: prs(-hm:im+hm,-hm:jm+hm,-hm:km+hm)
    real(8),device :: jacob(0:im,0:jm,0:km)
    real(8),device :: dxi(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:3,1:3)
    real(8),device :: qrhs(0:im,0:jm,0:km,1:5)
    integer :: i,j,k,m
    real(8) :: fp1(5),fm1(5),fp2(5),fm2(5),fp3(5),fm3(5),df

    i = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    j = blockIdx%y - 1
    k = blockIdx%z - 1
    if(i < 0 .or. i > im .or. j < 0 .or. j > jm .or. k < 0 .or. k > km) return

    call flux_at(q,vel,prs,jacob,dxi,im,jm,km,hm,i+1,j,k,1,fp1)
    call flux_at(q,vel,prs,jacob,dxi,im,jm,km,hm,i-1,j,k,1,fm1)
    call flux_at(q,vel,prs,jacob,dxi,im,jm,km,hm,i+2,j,k,1,fp2)
    call flux_at(q,vel,prs,jacob,dxi,im,jm,km,hm,i-2,j,k,1,fm2)
    call flux_at(q,vel,prs,jacob,dxi,im,jm,km,hm,i+3,j,k,1,fp3)
    call flux_at(q,vel,prs,jacob,dxi,im,jm,km,hm,i-3,j,k,1,fm3)
    do m=1,5
      df = 0.75d0*(fp1(m)-fm1(m)) - 0.15d0*(fp2(m)-fm2(m)) + (fp3(m)-fm3(m))/60.d0
      qrhs(i,j,k,m) = qrhs(i,j,k,m) - df
    enddo
  end subroutine convective_rhs_x_kernel

  attributes(global) subroutine convective_rhs_y_kernel(q,vel,prs,jacob,dxi,qrhs,im,jm,km,hm)
    implicit none
    integer,value :: im,jm,km,hm
    real(8),device :: q(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:5)
    real(8),device :: vel(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:3)
    real(8),device :: prs(-hm:im+hm,-hm:jm+hm,-hm:km+hm)
    real(8),device :: jacob(0:im,0:jm,0:km)
    real(8),device :: dxi(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:3,1:3)
    real(8),device :: qrhs(0:im,0:jm,0:km,1:5)
    integer :: i,j,k,m
    real(8) :: fp1(5),fm1(5),fp2(5),fm2(5),fp3(5),fm3(5),df

    i = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    j = (blockIdx%y - 1) * blockDim%y + threadIdx%y - 1
    k = blockIdx%z - 1
    if(i < 0 .or. i > im .or. j < 0 .or. j > jm .or. k < 0 .or. k > km) return

    call flux_at(q,vel,prs,jacob,dxi,im,jm,km,hm,i,j+1,k,2,fp1)
    call flux_at(q,vel,prs,jacob,dxi,im,jm,km,hm,i,j-1,k,2,fm1)
    call flux_at(q,vel,prs,jacob,dxi,im,jm,km,hm,i,j+2,k,2,fp2)
    call flux_at(q,vel,prs,jacob,dxi,im,jm,km,hm,i,j-2,k,2,fm2)
    call flux_at(q,vel,prs,jacob,dxi,im,jm,km,hm,i,j+3,k,2,fp3)
    call flux_at(q,vel,prs,jacob,dxi,im,jm,km,hm,i,j-3,k,2,fm3)
    do m=1,5
      df = 0.75d0*(fp1(m)-fm1(m)) - 0.15d0*(fp2(m)-fm2(m)) + (fp3(m)-fm3(m))/60.d0
      qrhs(i,j,k,m) = qrhs(i,j,k,m) - df
    enddo
  end subroutine convective_rhs_y_kernel

  attributes(global) subroutine convective_rhs_z_kernel(q,vel,prs,jacob,dxi,qrhs,im,jm,km,hm)
    implicit none
    integer,value :: im,jm,km,hm
    real(8),device :: q(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:5)
    real(8),device :: vel(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:3)
    real(8),device :: prs(-hm:im+hm,-hm:jm+hm,-hm:km+hm)
    real(8),device :: jacob(0:im,0:jm,0:km)
    real(8),device :: dxi(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:3,1:3)
    real(8),device :: qrhs(0:im,0:jm,0:km,1:5)
    integer :: i,j,k,m
    real(8) :: fp1(5),fm1(5),fp2(5),fm2(5),fp3(5),fm3(5),df

    i = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    j = blockIdx%y - 1
    k = (blockIdx%z - 1) * blockDim%z + threadIdx%z - 1
    if(i < 0 .or. i > im .or. j < 0 .or. j > jm .or. k < 0 .or. k > km) return

    call flux_at(q,vel,prs,jacob,dxi,im,jm,km,hm,i,j,k+1,3,fp1)
    call flux_at(q,vel,prs,jacob,dxi,im,jm,km,hm,i,j,k-1,3,fm1)
    call flux_at(q,vel,prs,jacob,dxi,im,jm,km,hm,i,j,k+2,3,fp2)
    call flux_at(q,vel,prs,jacob,dxi,im,jm,km,hm,i,j,k-2,3,fm2)
    call flux_at(q,vel,prs,jacob,dxi,im,jm,km,hm,i,j,k+3,3,fp3)
    call flux_at(q,vel,prs,jacob,dxi,im,jm,km,hm,i,j,k-3,3,fm3)
    do m=1,5
      df = 0.75d0*(fp1(m)-fm1(m)) - 0.15d0*(fp2(m)-fm2(m)) + (fp3(m)-fm3(m))/60.d0
      qrhs(i,j,k,m) = qrhs(i,j,k,m) - df
    enddo
  end subroutine convective_rhs_z_kernel

  attributes(device) subroutine flux_at_global(i,j,k,idir,im,jm,km,f)
    use commarray_gpu, only: q_d,vel_d,prs_d,jacob_d,dxi_d
    implicit none
    integer,value :: i,j,k,idir,im,jm,km
    real(8) :: f(5)
    integer :: ji,jj,jk
    real(8) :: uu

    ji = idx_periodic(i,im)
    jj = idx_periodic(j,jm)
    jk = idx_periodic(k,km)
    uu = dxi_d(i,j,k,idir,1)*vel_d(i,j,k,1) + &
         dxi_d(i,j,k,idir,2)*vel_d(i,j,k,2) + &
         dxi_d(i,j,k,idir,3)*vel_d(i,j,k,3)
    f(1) = jacob_d(ji,jj,jk) * q_d(i,j,k,1) * uu
    f(2) = jacob_d(ji,jj,jk) * (q_d(i,j,k,2) * uu + dxi_d(i,j,k,idir,1) * prs_d(i,j,k))
    f(3) = jacob_d(ji,jj,jk) * (q_d(i,j,k,3) * uu + dxi_d(i,j,k,idir,2) * prs_d(i,j,k))
    f(4) = jacob_d(ji,jj,jk) * (q_d(i,j,k,4) * uu + dxi_d(i,j,k,idir,3) * prs_d(i,j,k))
    f(5) = jacob_d(ji,jj,jk) * (q_d(i,j,k,5) + prs_d(i,j,k)) * uu
  end subroutine flux_at_global

  attributes(device) subroutine flux_at_xphysical_global(i,j,k,idir,im,jm,km,f)
    use commarray_gpu, only: q_d,vel_d,prs_d,jacob_d,dxi_d
    implicit none
    integer,value :: i,j,k,idir,im,jm,km
    real(8) :: f(5)
    integer :: jj,jk
    real(8) :: uu

    jj = idx_periodic(j,jm)
    jk = idx_periodic(k,km)
    uu = dxi_d(i,j,k,idir,1)*vel_d(i,j,k,1) + &
         dxi_d(i,j,k,idir,2)*vel_d(i,j,k,2) + &
         dxi_d(i,j,k,idir,3)*vel_d(i,j,k,3)
    f(1) = jacob_d(i,jj,jk) * q_d(i,j,k,1) * uu
    f(2) = jacob_d(i,jj,jk) * (q_d(i,j,k,2) * uu + dxi_d(i,j,k,idir,1) * prs_d(i,j,k))
    f(3) = jacob_d(i,jj,jk) * (q_d(i,j,k,3) * uu + dxi_d(i,j,k,idir,2) * prs_d(i,j,k))
    f(4) = jacob_d(i,jj,jk) * (q_d(i,j,k,4) * uu + dxi_d(i,j,k,idir,3) * prs_d(i,j,k))
    f(5) = jacob_d(i,jj,jk) * (q_d(i,j,k,5) + prs_d(i,j,k)) * uu
  end subroutine flux_at_xphysical_global

  attributes(device) subroutine flux_at_yphysical_global(i,j,k,idir,im,jm,km,f)
    use commarray_gpu, only: q_d,vel_d,prs_d,jacob_d,dxi_d
    implicit none
    integer,value :: i,j,k,idir,im,jm,km
    real(8) :: f(5)
    integer :: ii,kk
    real(8) :: uu

    ii = idx_periodic(i,im)
    kk = idx_periodic(k,km)
    uu = dxi_d(i,j,k,idir,1)*vel_d(i,j,k,1) + &
         dxi_d(i,j,k,idir,2)*vel_d(i,j,k,2) + &
         dxi_d(i,j,k,idir,3)*vel_d(i,j,k,3)
    f(1) = jacob_d(ii,j,kk) * q_d(i,j,k,1) * uu
    f(2) = jacob_d(ii,j,kk) * (q_d(i,j,k,2) * uu + dxi_d(i,j,k,idir,1) * prs_d(i,j,k))
    f(3) = jacob_d(ii,j,kk) * (q_d(i,j,k,3) * uu + dxi_d(i,j,k,idir,2) * prs_d(i,j,k))
    f(4) = jacob_d(ii,j,kk) * (q_d(i,j,k,4) * uu + dxi_d(i,j,k,idir,3) * prs_d(i,j,k))
    f(5) = jacob_d(ii,j,kk) * (q_d(i,j,k,5) + prs_d(i,j,k)) * uu
  end subroutine flux_at_yphysical_global

  attributes(device) subroutine flux_at_zphysical_global(i,j,k,idir,im,jm,km,f)
    use commarray_gpu, only: q_d,vel_d,prs_d,jacob_d,dxi_d
    implicit none
    integer,value :: i,j,k,idir,im,jm,km
    real(8) :: f(5)
    integer :: ii,jj
    real(8) :: uu

    ii = idx_periodic(i,im)
    jj = idx_periodic(j,jm)
    uu = dxi_d(i,j,k,idir,1)*vel_d(i,j,k,1) + &
         dxi_d(i,j,k,idir,2)*vel_d(i,j,k,2) + &
         dxi_d(i,j,k,idir,3)*vel_d(i,j,k,3)
    f(1) = jacob_d(ii,jj,k) * q_d(i,j,k,1) * uu
    f(2) = jacob_d(ii,jj,k) * (q_d(i,j,k,2) * uu + dxi_d(i,j,k,idir,1) * prs_d(i,j,k))
    f(3) = jacob_d(ii,jj,k) * (q_d(i,j,k,3) * uu + dxi_d(i,j,k,idir,2) * prs_d(i,j,k))
    f(4) = jacob_d(ii,jj,k) * (q_d(i,j,k,4) * uu + dxi_d(i,j,k,idir,3) * prs_d(i,j,k))
    f(5) = jacob_d(ii,jj,k) * (q_d(i,j,k,5) + prs_d(i,j,k)) * uu
  end subroutine flux_at_zphysical_global

  attributes(global) subroutine convective_rhs_x_global_kernel(im,jm,km)
    use commarray_gpu, only: qrhs_d
    implicit none
    integer,value :: im,jm,km
    integer :: i,j,k,m
    real(8) :: fp1(5),fm1(5),fp2(5),fm2(5),fp3(5),fm3(5),df

    i = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    j = blockIdx%y - 1
    k = blockIdx%z - 1
    if(i < 0 .or. i > im .or. j < 0 .or. j > jm .or. k < 0 .or. k > km) return

    call flux_at_global(i+1,j,k,1,im,jm,km,fp1)
    call flux_at_global(i-1,j,k,1,im,jm,km,fm1)
    call flux_at_global(i+2,j,k,1,im,jm,km,fp2)
    call flux_at_global(i-2,j,k,1,im,jm,km,fm2)
    call flux_at_global(i+3,j,k,1,im,jm,km,fp3)
    call flux_at_global(i-3,j,k,1,im,jm,km,fm3)
    do m=1,5
      df = 0.75d0*(fp1(m)-fm1(m)) - 0.15d0*(fp2(m)-fm2(m)) + (fp3(m)-fm3(m))/60.d0
      qrhs_d(i,j,k,m) = qrhs_d(i,j,k,m) - df
    enddo
  end subroutine convective_rhs_x_global_kernel

  attributes(global) subroutine convective_rhs_y_global_kernel(im,jm,km)
    use commarray_gpu, only: qrhs_d
    implicit none
    integer,value :: im,jm,km
    integer :: i,j,k,m
    real(8) :: fp1(5),fm1(5),fp2(5),fm2(5),fp3(5),fm3(5),df

    i = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    j = (blockIdx%y - 1) * blockDim%y + threadIdx%y - 1
    k = blockIdx%z - 1
    if(i < 0 .or. i > im .or. j < 0 .or. j > jm .or. k < 0 .or. k > km) return

    call flux_at_global(i,j+1,k,2,im,jm,km,fp1)
    call flux_at_global(i,j-1,k,2,im,jm,km,fm1)
    call flux_at_global(i,j+2,k,2,im,jm,km,fp2)
    call flux_at_global(i,j-2,k,2,im,jm,km,fm2)
    call flux_at_global(i,j+3,k,2,im,jm,km,fp3)
    call flux_at_global(i,j-3,k,2,im,jm,km,fm3)
    do m=1,5
      df = 0.75d0*(fp1(m)-fm1(m)) - 0.15d0*(fp2(m)-fm2(m)) + (fp3(m)-fm3(m))/60.d0
      qrhs_d(i,j,k,m) = qrhs_d(i,j,k,m) - df
    enddo
  end subroutine convective_rhs_y_global_kernel

  attributes(global) subroutine convective_rhs_z_global_kernel(im,jm,km)
    use commarray_gpu, only: qrhs_d
    implicit none
    integer,value :: im,jm,km
    integer :: i,j,k,m
    real(8) :: fp1(5),fm1(5),fp2(5),fm2(5),fp3(5),fm3(5),df

    i = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    j = blockIdx%y - 1
    k = (blockIdx%z - 1) * blockDim%z + threadIdx%z - 1
    if(i < 0 .or. i > im .or. j < 0 .or. j > jm .or. k < 0 .or. k > km) return

    call flux_at_global(i,j,k+1,3,im,jm,km,fp1)
    call flux_at_global(i,j,k-1,3,im,jm,km,fm1)
    call flux_at_global(i,j,k+2,3,im,jm,km,fp2)
    call flux_at_global(i,j,k-2,3,im,jm,km,fm2)
    call flux_at_global(i,j,k+3,3,im,jm,km,fp3)
    call flux_at_global(i,j,k-3,3,im,jm,km,fm3)
    do m=1,5
      df = 0.75d0*(fp1(m)-fm1(m)) - 0.15d0*(fp2(m)-fm2(m)) + (fp3(m)-fm3(m))/60.d0
      qrhs_d(i,j,k,m) = qrhs_d(i,j,k,m) - df
    enddo
  end subroutine convective_rhs_z_global_kernel

  attributes(device) subroutine deriv6_x_physical(i,im,apply_left,apply_right, &
                                                  fp0,fp1,fm1,fp2,fm2,fp3,fm3,df)
    implicit none
    integer,value :: i,im,apply_left,apply_right
    real(8) :: fp0(5),fp1(5),fm1(5),fp2(5),fm2(5),fp3(5),fm3(5),df(5)
    integer :: m

    if(apply_left /= 0 .and. i == 0) then
      do m=1,5
        df(m) = -0.5d0*fp2(m) + 2.d0*fp1(m) - 1.5d0*fp0(m)
      enddo
    elseif(apply_left /= 0 .and. i == 1) then
      do m=1,5
        df(m) = 0.5d0*(fp1(m)-fm1(m))
      enddo
    elseif(apply_left /= 0 .and. i == 2) then
      do m=1,5
        df(m) = (2.d0/3.d0)*(fp1(m)-fm1(m)) - (1.d0/12.d0)*(fp2(m)-fm2(m))
      enddo
    elseif(apply_right /= 0 .and. i == im-2) then
      do m=1,5
        df(m) = (2.d0/3.d0)*(fp1(m)-fm1(m)) - (1.d0/12.d0)*(fp2(m)-fm2(m))
      enddo
    elseif(apply_right /= 0 .and. i == im-1) then
      do m=1,5
        df(m) = 0.5d0*(fp1(m)-fm1(m))
      enddo
    elseif(apply_right /= 0 .and. i == im) then
      do m=1,5
        df(m) = 0.5d0*fm2(m) - 2.d0*fm1(m) + 1.5d0*fp0(m)
      enddo
    else
      do m=1,5
        df(m) = 0.75d0*(fp1(m)-fm1(m)) - 0.15d0*(fp2(m)-fm2(m)) + (fp3(m)-fm3(m))/60.d0
      enddo
    endif
  end subroutine deriv6_x_physical

  attributes(global) subroutine convective_rhs_x_xphysical_global_kernel(im,jm,km,is,ie,js,je,ks,ke, &
                                                                         apply_left,apply_right)
    use commarray_gpu, only: qrhs_d
    implicit none
    integer,value :: im,jm,km,is,ie,js,je,ks,ke,apply_left,apply_right
    integer :: i,j,k,m
    real(8) :: f0(5),fp1(5),fm1(5),fp2(5),fm2(5),fp3(5),fm3(5),df(5)

    i = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    j = blockIdx%y - 1
    k = blockIdx%z - 1
    if(i < 0 .or. i > im .or. j < 0 .or. j > jm .or. k < 0 .or. k > km) return
    if(i < is .or. i > ie .or. j < js .or. j > je .or. k < ks .or. k > ke) return

    call flux_at_xphysical_global(i,j,k,1,im,jm,km,f0)
    if(i < im   .or. apply_right == 0) call flux_at_xphysical_global(i+1,j,k,1,im,jm,km,fp1)
    if(i > 0    .or. apply_left  == 0) call flux_at_xphysical_global(i-1,j,k,1,im,jm,km,fm1)
    if(i < im-1 .or. apply_right == 0) call flux_at_xphysical_global(i+2,j,k,1,im,jm,km,fp2)
    if(i > 1    .or. apply_left  == 0) call flux_at_xphysical_global(i-2,j,k,1,im,jm,km,fm2)
    if(i < im-2 .or. apply_right == 0) call flux_at_xphysical_global(i+3,j,k,1,im,jm,km,fp3)
    if(i > 2    .or. apply_left  == 0) call flux_at_xphysical_global(i-3,j,k,1,im,jm,km,fm3)

    call deriv6_x_physical(i,im,apply_left,apply_right,f0,fp1,fm1,fp2,fm2,fp3,fm3,df)
    do m=1,5
      qrhs_d(i,j,k,m) = qrhs_d(i,j,k,m) - df(m)
    enddo
  end subroutine convective_rhs_x_xphysical_global_kernel

  attributes(global) subroutine convective_rhs_y_xphysical_global_kernel(im,jm,km,is,ie,js,je,ks,ke)
    use commarray_gpu, only: qrhs_d
    implicit none
    integer,value :: im,jm,km,is,ie,js,je,ks,ke
    integer :: i,j,k,m
    real(8) :: fp1(5),fm1(5),fp2(5),fm2(5),fp3(5),fm3(5),df

    i = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    j = (blockIdx%y - 1) * blockDim%y + threadIdx%y - 1
    k = blockIdx%z - 1
    if(i < 0 .or. i > im .or. j < 0 .or. j > jm .or. k < 0 .or. k > km) return
    if(i < is .or. i > ie .or. j < js .or. j > je .or. k < ks .or. k > ke) return

    call flux_at_xphysical_global(i,j+1,k,2,im,jm,km,fp1)
    call flux_at_xphysical_global(i,j-1,k,2,im,jm,km,fm1)
    call flux_at_xphysical_global(i,j+2,k,2,im,jm,km,fp2)
    call flux_at_xphysical_global(i,j-2,k,2,im,jm,km,fm2)
    call flux_at_xphysical_global(i,j+3,k,2,im,jm,km,fp3)
    call flux_at_xphysical_global(i,j-3,k,2,im,jm,km,fm3)
    do m=1,5
      df = 0.75d0*(fp1(m)-fm1(m)) - 0.15d0*(fp2(m)-fm2(m)) + (fp3(m)-fm3(m))/60.d0
      qrhs_d(i,j,k,m) = qrhs_d(i,j,k,m) - df
    enddo
  end subroutine convective_rhs_y_xphysical_global_kernel

  attributes(global) subroutine convective_rhs_z_xphysical_global_kernel(im,jm,km,is,ie,js,je,ks,ke)
    use commarray_gpu, only: qrhs_d
    implicit none
    integer,value :: im,jm,km,is,ie,js,je,ks,ke
    integer :: i,j,k,m
    real(8) :: fp1(5),fm1(5),fp2(5),fm2(5),fp3(5),fm3(5),df

    i = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    j = blockIdx%y - 1
    k = (blockIdx%z - 1) * blockDim%z + threadIdx%z - 1
    if(i < 0 .or. i > im .or. j < 0 .or. j > jm .or. k < 0 .or. k > km) return
    if(i < is .or. i > ie .or. j < js .or. j > je .or. k < ks .or. k > ke) return

    call flux_at_xphysical_global(i,j,k+1,3,im,jm,km,fp1)
    call flux_at_xphysical_global(i,j,k-1,3,im,jm,km,fm1)
    call flux_at_xphysical_global(i,j,k+2,3,im,jm,km,fp2)
    call flux_at_xphysical_global(i,j,k-2,3,im,jm,km,fm2)
    call flux_at_xphysical_global(i,j,k+3,3,im,jm,km,fp3)
    call flux_at_xphysical_global(i,j,k-3,3,im,jm,km,fm3)
    do m=1,5
      df = 0.75d0*(fp1(m)-fm1(m)) - 0.15d0*(fp2(m)-fm2(m)) + (fp3(m)-fm3(m))/60.d0
      qrhs_d(i,j,k,m) = qrhs_d(i,j,k,m) - df
    enddo
  end subroutine convective_rhs_z_xphysical_global_kernel

  attributes(global) subroutine convective_rhs_x_yphysical_global_kernel(im,jm,km,is,ie,js,je,ks,ke)
    use commarray_gpu, only: qrhs_d
    implicit none
    integer,value :: im,jm,km,is,ie,js,je,ks,ke
    integer :: i,j,k,m
    real(8) :: fp1(5),fm1(5),fp2(5),fm2(5),fp3(5),fm3(5),df

    i = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    j = blockIdx%y - 1
    k = blockIdx%z - 1
    if(i < 0 .or. i > im .or. j < 0 .or. j > jm .or. k < 0 .or. k > km) return
    if(i < is .or. i > ie .or. j < js .or. j > je .or. k < ks .or. k > ke) return

    call flux_at_yphysical_global(i+1,j,k,1,im,jm,km,fp1)
    call flux_at_yphysical_global(i-1,j,k,1,im,jm,km,fm1)
    call flux_at_yphysical_global(i+2,j,k,1,im,jm,km,fp2)
    call flux_at_yphysical_global(i-2,j,k,1,im,jm,km,fm2)
    call flux_at_yphysical_global(i+3,j,k,1,im,jm,km,fp3)
    call flux_at_yphysical_global(i-3,j,k,1,im,jm,km,fm3)
    do m=1,5
      df = 0.75d0*(fp1(m)-fm1(m)) - 0.15d0*(fp2(m)-fm2(m)) + (fp3(m)-fm3(m))/60.d0
      qrhs_d(i,j,k,m) = qrhs_d(i,j,k,m) - df
    enddo
  end subroutine convective_rhs_x_yphysical_global_kernel

  attributes(global) subroutine convective_rhs_y_yphysical_global_kernel(im,jm,km,is,ie,js,je,ks,ke, &
                                                                        apply_down,apply_up)
    use commarray_gpu, only: qrhs_d
    implicit none
    integer,value :: im,jm,km,is,ie,js,je,ks,ke,apply_down,apply_up
    integer :: i,j,k,m
    real(8) :: f0(5),fp1(5),fm1(5),fp2(5),fm2(5),fp3(5),fm3(5),df(5)

    i = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    j = (blockIdx%y - 1) * blockDim%y + threadIdx%y - 1
    k = blockIdx%z - 1
    if(i < 0 .or. i > im .or. j < 0 .or. j > jm .or. k < 0 .or. k > km) return
    if(i < is .or. i > ie .or. j < js .or. j > je .or. k < ks .or. k > ke) return

    call flux_at_yphysical_global(i,j,k,2,im,jm,km,f0)
    if(j < jm   .or. apply_up   == 0) call flux_at_yphysical_global(i,j+1,k,2,im,jm,km,fp1)
    if(j > 0    .or. apply_down == 0) call flux_at_yphysical_global(i,j-1,k,2,im,jm,km,fm1)
    if(j < jm-1 .or. apply_up   == 0) call flux_at_yphysical_global(i,j+2,k,2,im,jm,km,fp2)
    if(j > 1    .or. apply_down == 0) call flux_at_yphysical_global(i,j-2,k,2,im,jm,km,fm2)
    if(j < jm-2 .or. apply_up   == 0) call flux_at_yphysical_global(i,j+3,k,2,im,jm,km,fp3)
    if(j > 2    .or. apply_down == 0) call flux_at_yphysical_global(i,j-3,k,2,im,jm,km,fm3)

    call deriv6_x_physical(j,jm,apply_down,apply_up,f0,fp1,fm1,fp2,fm2,fp3,fm3,df)
    do m=1,5
      qrhs_d(i,j,k,m) = qrhs_d(i,j,k,m) - df(m)
    enddo
  end subroutine convective_rhs_y_yphysical_global_kernel

  attributes(global) subroutine convective_rhs_z_yphysical_global_kernel(im,jm,km,is,ie,js,je,ks,ke)
    use commarray_gpu, only: qrhs_d
    implicit none
    integer,value :: im,jm,km,is,ie,js,je,ks,ke
    integer :: i,j,k,m
    real(8) :: fp1(5),fm1(5),fp2(5),fm2(5),fp3(5),fm3(5),df

    i = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    j = blockIdx%y - 1
    k = (blockIdx%z - 1) * blockDim%z + threadIdx%z - 1
    if(i < 0 .or. i > im .or. j < 0 .or. j > jm .or. k < 0 .or. k > km) return
    if(i < is .or. i > ie .or. j < js .or. j > je .or. k < ks .or. k > ke) return

    call flux_at_yphysical_global(i,j,k+1,3,im,jm,km,fp1)
    call flux_at_yphysical_global(i,j,k-1,3,im,jm,km,fm1)
    call flux_at_yphysical_global(i,j,k+2,3,im,jm,km,fp2)
    call flux_at_yphysical_global(i,j,k-2,3,im,jm,km,fm2)
    call flux_at_yphysical_global(i,j,k+3,3,im,jm,km,fp3)
    call flux_at_yphysical_global(i,j,k-3,3,im,jm,km,fm3)
    do m=1,5
      df = 0.75d0*(fp1(m)-fm1(m)) - 0.15d0*(fp2(m)-fm2(m)) + (fp3(m)-fm3(m))/60.d0
      qrhs_d(i,j,k,m) = qrhs_d(i,j,k,m) - df
    enddo
  end subroutine convective_rhs_z_yphysical_global_kernel

  attributes(global) subroutine convective_rhs_x_zphysical_global_kernel(im,jm,km,is,ie,js,je,ks,ke)
    use commarray_gpu, only: qrhs_d
    implicit none
    integer,value :: im,jm,km,is,ie,js,je,ks,ke
    integer :: i,j,k,m
    real(8) :: fp1(5),fm1(5),fp2(5),fm2(5),fp3(5),fm3(5),df

    i = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    j = blockIdx%y - 1
    k = blockIdx%z - 1
    if(i < 0 .or. i > im .or. j < 0 .or. j > jm .or. k < 0 .or. k > km) return
    if(i < is .or. i > ie .or. j < js .or. j > je .or. k < ks .or. k > ke) return

    call flux_at_zphysical_global(i+1,j,k,1,im,jm,km,fp1)
    call flux_at_zphysical_global(i-1,j,k,1,im,jm,km,fm1)
    call flux_at_zphysical_global(i+2,j,k,1,im,jm,km,fp2)
    call flux_at_zphysical_global(i-2,j,k,1,im,jm,km,fm2)
    call flux_at_zphysical_global(i+3,j,k,1,im,jm,km,fp3)
    call flux_at_zphysical_global(i-3,j,k,1,im,jm,km,fm3)
    do m=1,5
      df = 0.75d0*(fp1(m)-fm1(m)) - 0.15d0*(fp2(m)-fm2(m)) + (fp3(m)-fm3(m))/60.d0
      qrhs_d(i,j,k,m) = qrhs_d(i,j,k,m) - df
    enddo
  end subroutine convective_rhs_x_zphysical_global_kernel

  attributes(global) subroutine convective_rhs_y_zphysical_global_kernel(im,jm,km,is,ie,js,je,ks,ke)
    use commarray_gpu, only: qrhs_d
    implicit none
    integer,value :: im,jm,km,is,ie,js,je,ks,ke
    integer :: i,j,k,m
    real(8) :: fp1(5),fm1(5),fp2(5),fm2(5),fp3(5),fm3(5),df

    i = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    j = (blockIdx%y - 1) * blockDim%y + threadIdx%y - 1
    k = blockIdx%z - 1
    if(i < 0 .or. i > im .or. j < 0 .or. j > jm .or. k < 0 .or. k > km) return
    if(i < is .or. i > ie .or. j < js .or. j > je .or. k < ks .or. k > ke) return

    call flux_at_zphysical_global(i,j+1,k,2,im,jm,km,fp1)
    call flux_at_zphysical_global(i,j-1,k,2,im,jm,km,fm1)
    call flux_at_zphysical_global(i,j+2,k,2,im,jm,km,fp2)
    call flux_at_zphysical_global(i,j-2,k,2,im,jm,km,fm2)
    call flux_at_zphysical_global(i,j+3,k,2,im,jm,km,fp3)
    call flux_at_zphysical_global(i,j-3,k,2,im,jm,km,fm3)
    do m=1,5
      df = 0.75d0*(fp1(m)-fm1(m)) - 0.15d0*(fp2(m)-fm2(m)) + (fp3(m)-fm3(m))/60.d0
      qrhs_d(i,j,k,m) = qrhs_d(i,j,k,m) - df
    enddo
  end subroutine convective_rhs_y_zphysical_global_kernel

  attributes(global) subroutine convective_rhs_z_zphysical_global_kernel(im,jm,km,is,ie,js,je,ks,ke, &
                                                                        apply_back,apply_front)
    use commarray_gpu, only: qrhs_d
    implicit none
    integer,value :: im,jm,km,is,ie,js,je,ks,ke,apply_back,apply_front
    integer :: i,j,k,m
    real(8) :: f0(5),fp1(5),fm1(5),fp2(5),fm2(5),fp3(5),fm3(5),df(5)

    i = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    j = blockIdx%y - 1
    k = (blockIdx%z - 1) * blockDim%z + threadIdx%z - 1
    if(i < 0 .or. i > im .or. j < 0 .or. j > jm .or. k < 0 .or. k > km) return
    if(i < is .or. i > ie .or. j < js .or. j > je .or. k < ks .or. k > ke) return

    call flux_at_zphysical_global(i,j,k,3,im,jm,km,f0)
    if(k < km   .or. apply_front == 0) call flux_at_zphysical_global(i,j,k+1,3,im,jm,km,fp1)
    if(k > 0    .or. apply_back  == 0) call flux_at_zphysical_global(i,j,k-1,3,im,jm,km,fm1)
    if(k < km-1 .or. apply_front == 0) call flux_at_zphysical_global(i,j,k+2,3,im,jm,km,fp2)
    if(k > 1    .or. apply_back  == 0) call flux_at_zphysical_global(i,j,k-2,3,im,jm,km,fm2)
    if(k < km-2 .or. apply_front == 0) call flux_at_zphysical_global(i,j,k+3,3,im,jm,km,fp3)
    if(k > 2    .or. apply_back  == 0) call flux_at_zphysical_global(i,j,k-3,3,im,jm,km,fm3)

    call deriv6_x_physical(k,km,apply_back,apply_front,f0,fp1,fm1,fp2,fm2,fp3,fm3,df)
    do m=1,5
      qrhs_d(i,j,k,m) = qrhs_d(i,j,k,m) - df(m)
    enddo
  end subroutine convective_rhs_z_zphysical_global_kernel

  attributes(global) subroutine save_q_kernel(q,qsave,jacob,im,jm,km,hm)
    implicit none
    integer,value :: im,jm,km,hm
    real(8),device :: q(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:5)
    real(8),device :: qsave(0:im,0:jm,0:km,1:5)
    real(8),device :: jacob(0:im,0:jm,0:km)
    integer :: id,i,j,k,m,ntot

    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    ntot = (im + 1) * (jm + 1) * (km + 1)
    if(id >= ntot) return

    i = mod(id,im+1)
    j = mod(id/(im+1),jm+1)
    k = id/((im+1)*(jm+1))
    do m=1,5
      qsave(i,j,k,m) = q(i,j,k,m) * jacob(i,j,k)
    enddo
  end subroutine save_q_kernel

  attributes(global) subroutine rk3_update_kernel(q,qsave,qrhs,jacob,deltat,a,b,c,im,jm,km,hm)
    implicit none
    integer,value :: im,jm,km,hm
    real(8),value :: deltat,a,b,c
    real(8),device :: q(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:5)
    real(8),device :: qsave(0:im,0:jm,0:km,1:5)
    real(8),device :: qrhs(0:im,0:jm,0:km,1:5)
    real(8),device :: jacob(0:im,0:jm,0:km)
    integer :: id,i,j,k,m,ntot

    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    ntot = (im + 1) * (jm + 1) * (km + 1)
    if(id >= ntot) return

    i = mod(id,im+1)
    j = mod(id/(im+1),jm+1)
    k = id/((im+1)*(jm+1))
    do m=1,5
      q(i,j,k,m) = (a*qsave(i,j,k,m) + b*q(i,j,k,m)*jacob(i,j,k) + c*qrhs(i,j,k,m)*deltat) / jacob(i,j,k)
    enddo
  end subroutine rk3_update_kernel

  attributes(global) subroutine rk3_first_update_kernel(q,qsave,qrhs,jacob,deltat,im,jm,km,hm)
    implicit none
    integer,value :: im,jm,km,hm
    real(8),value :: deltat
    real(8),device :: q(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:5)
    real(8),device :: qsave(0:im,0:jm,0:km,1:5)
    real(8),device :: qrhs(0:im,0:jm,0:km,1:5)
    real(8),device :: jacob(0:im,0:jm,0:km)
    integer :: id,i,j,k,m,ntot
    real(8) :: saved

    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    ntot = (im + 1) * (jm + 1) * (km + 1)
    if(id >= ntot) return

    i = mod(id,im+1)
    j = mod(id/(im+1),jm+1)
    k = id/((im+1)*(jm+1))
    do m=1,5
      saved = q(i,j,k,m) * jacob(i,j,k)
      qsave(i,j,k,m) = saved
      q(i,j,k,m) = (saved + qrhs(i,j,k,m)*deltat) / jacob(i,j,k)
    enddo
  end subroutine rk3_first_update_kernel

  attributes(global) subroutine rk3_first_update_global_kernel(deltat,im,jm,km)
    use commarray_gpu, only: q_d,qsave_d,qrhs_d,jacob_d
    implicit none
    integer,value :: im,jm,km
    real(8),value :: deltat
    integer :: id,i,j,k,m,ntot
    real(8) :: saved

    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    ntot = (im + 1) * (jm + 1) * (km + 1)
    if(id >= ntot) return

    i = mod(id,im+1)
    j = mod(id/(im+1),jm+1)
    k = id/((im+1)*(jm+1))
    do m=1,5
      saved = q_d(i,j,k,m) * jacob_d(i,j,k)
      qsave_d(i,j,k,m) = saved
      q_d(i,j,k,m) = (saved + qrhs_d(i,j,k,m)*deltat) / jacob_d(i,j,k)
    enddo
  end subroutine rk3_first_update_global_kernel

  attributes(global) subroutine rk3_update_global_kernel(deltat,a,b,c,im,jm,km)
    use commarray_gpu, only: q_d,qsave_d,qrhs_d,jacob_d
    implicit none
    integer,value :: im,jm,km
    real(8),value :: deltat,a,b,c
    integer :: id,i,j,k,m,ntot

    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    ntot = (im + 1) * (jm + 1) * (km + 1)
    if(id >= ntot) return

    i = mod(id,im+1)
    j = mod(id/(im+1),jm+1)
    k = id/((im+1)*(jm+1))
    do m=1,5
      q_d(i,j,k,m) = (a*qsave_d(i,j,k,m) + b*q_d(i,j,k,m)*jacob_d(i,j,k) + &
                       c*qrhs_d(i,j,k,m)*deltat) / jacob_d(i,j,k)
    enddo
  end subroutine rk3_update_global_kernel

  attributes(device) real(8) function filter10_value(v0,vp1,vm1,vp2,vm2,vp3,vm3,vp4,vm4,vp5,vm5)
    implicit none
    real(8),value :: v0,vp1,vm1,vp2,vm2,vp3,vm3,vp4,vm4,vp5,vm5

    filter10_value = (386.d0/512.d0)*v0 + &
                     (105.d0/512.d0)*(vp1+vm1) + &
                     (-15.d0/128.d0)*(vp2+vm2) + &
                     (45.d0/1024.d0)*(vp3+vm3) + &
                     (-5.d0/512.d0)*(vp4+vm4) + &
                     (1.d0/1024.d0)*(vp5+vm5)
  end function filter10_value

  attributes(global) subroutine filter_x_global_kernel(im,jm,km)
    use commarray_gpu, only: q_d,qwork_d
    implicit none
    integer,value :: im,jm,km
    integer :: i,j,k,m

    i = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    j = blockIdx%y - 1
    k = blockIdx%z - 1
    if(i < 0 .or. i > im .or. j < 0 .or. j > jm .or. k < 0 .or. k > km) return

    do m=1,5
      qwork_d(i,j,k,m) = filter10_value(q_d(i,j,k,m), &
        q_d(i+1,j,k,m), q_d(i-1,j,k,m), &
        q_d(i+2,j,k,m), q_d(i-2,j,k,m), &
        q_d(i+3,j,k,m), q_d(i-3,j,k,m), &
        q_d(i+4,j,k,m), q_d(i-4,j,k,m), &
        q_d(i+5,j,k,m), q_d(i-5,j,k,m))
    enddo
  end subroutine filter_x_global_kernel

  attributes(global) subroutine filter_y_global_kernel(im,jm,km)
    use commarray_gpu, only: q_d,qwork_d
    implicit none
    integer,value :: im,jm,km
    integer :: i,j,k,m

    i = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    j = (blockIdx%y - 1) * blockDim%y + threadIdx%y - 1
    k = blockIdx%z - 1
    if(i < 0 .or. i > im .or. j < 0 .or. j > jm .or. k < 0 .or. k > km) return

    do m=1,5
      qwork_d(i,j,k,m) = filter10_value(q_d(i,j,k,m), &
        q_d(i,idx_periodic(j+1,jm),k,m), q_d(i,idx_periodic(j-1,jm),k,m), &
        q_d(i,idx_periodic(j+2,jm),k,m), q_d(i,idx_periodic(j-2,jm),k,m), &
        q_d(i,idx_periodic(j+3,jm),k,m), q_d(i,idx_periodic(j-3,jm),k,m), &
        q_d(i,idx_periodic(j+4,jm),k,m), q_d(i,idx_periodic(j-4,jm),k,m), &
        q_d(i,idx_periodic(j+5,jm),k,m), q_d(i,idx_periodic(j-5,jm),k,m))
    enddo
  end subroutine filter_y_global_kernel

