            sigma_d(i,j,k,6)*dxi_d(i,j,k,idir,3))*jacob_d(i,jj,jk)
    f(5) = (qflux_d(i,j,k,1)*dxi_d(i,j,k,idir,1) + &
            qflux_d(i,j,k,2)*dxi_d(i,j,k,idir,2) + &
            qflux_d(i,j,k,3)*dxi_d(i,j,k,idir,3))*jacob_d(i,jj,jk)
  end subroutine stored_diff_flux_at_xphysical

