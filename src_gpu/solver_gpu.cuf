        qwork_d(i,j+1,k,m), qwork_d(i,j-1,k,m), &
        qwork_d(i,j+2,k,m), qwork_d(i,j-2,k,m), &
        qwork_d(i,j+3,k,m), qwork_d(i,j-3,k,m), &
        qwork_d(i,j+4,k,m), qwork_d(i,j-4,k,m), &
