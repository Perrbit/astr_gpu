      qwork_d(i,j,k,m) = filter10_value(q_d(i,j,k,m), &
        q_d(i,j,idx_periodic(k+1,km),m), q_d(i,j,idx_periodic(k-1,km),m), &
        q_d(i,j,idx_periodic(k+2,km),m), q_d(i,j,idx_periodic(k-2,km),m), &
        q_d(i,j,idx_periodic(k+3,km),m), q_d(i,j,idx_periodic(k-3,km),m), &
        q_d(i,j,idx_periodic(k+4,km),m), q_d(i,j,idx_periodic(k-4,km),m), &
        q_d(i,j,idx_periodic(k+5,km),m), q_d(i,j,idx_periodic(k-5,km),m))
    enddo
  end subroutine filter_z_global_kernel

