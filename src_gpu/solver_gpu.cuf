      qwork_d(i,j,k,m) = filter10_value(q_d(i,j,k,m), &
        q_d(i,j,k+1,m), q_d(i,j,k-1,m), &
        q_d(i,j,k+2,m), q_d(i,j,k-2,m), &
        q_d(i,j,k+3,m), q_d(i,j,k-3,m), &
        q_d(i,j,k+4,m), q_d(i,j,k-4,m), &
