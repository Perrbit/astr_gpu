            sigma_d(i,j,k,5)*dxi_d(i,j,k,idir,3))*jacob_d(i,j,kk)
    f(4) = (sigma_d(i,j,k,3)*dxi_d(i,j,k,idir,1) + &
            sigma_d(i,j,k,5)*dxi_d(i,j,k,idir,2) + &
            sigma_d(i,j,k,6)*dxi_d(i,j,k,idir,3))*jacob_d(i,j,kk)
    f(5) = (qflux_d(i,j,k,1)*dxi_d(i,j,k,idir,1) + &
            qflux_d(i,j,k,2)*dxi_d(i,j,k,idir,2) + &
            qflux_d(i,j,k,3)*dxi_d(i,j,k,idir,3))*jacob_d(i,j,kk)
  end subroutine stored_diff_flux_at_xyphysical

  attributes(global) subroutine diffusion_rhs_x_stored_global_kernel(im,jm,km)
    use commarray_gpu, only: qrhs_d
    implicit none
    integer,value :: im,jm,km
    integer :: i,j,k,m
    real(8) :: fp1(5),fm1(5),fp2(5),fm2(5),fp3(5),fm3(5)

    i = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    j = blockIdx%y - 1
    k = blockIdx%z - 1
    if(i < 0 .or. i > im .or. j < 0 .or. j > jm .or. k < 0 .or. k > km) return
    call stored_diff_flux_at(i+1,j,k,1,im,jm,km,fp1)
    call stored_diff_flux_at(i-1,j,k,1,im,jm,km,fm1)
    call stored_diff_flux_at(i+2,j,k,1,im,jm,km,fp2)
    call stored_diff_flux_at(i-2,j,k,1,im,jm,km,fm2)
    call stored_diff_flux_at(i+3,j,k,1,im,jm,km,fp3)
    call stored_diff_flux_at(i-3,j,k,1,im,jm,km,fm3)
    do m=2,5
      qrhs_d(i,j,k,m) = qrhs_d(i,j,k,m) + deriv6(fp1(m),fm1(m),fp2(m),fm2(m),fp3(m),fm3(m))
    enddo
  end subroutine diffusion_rhs_x_stored_global_kernel

  attributes(global) subroutine diffusion_rhs_x_xphysical_stored_global_kernel(im,jm,km,is,ie,js,je,ks,ke, &
                                                                               apply_left,apply_right)
    use commarray_gpu, only: qrhs_d
    implicit none
    integer,value :: im,jm,km,is,ie,js,je,ks,ke,apply_left,apply_right
    integer :: i,j,k,m
    real(8) :: f0(5),fp1(5),fm1(5),fp2(5),fm2(5),fp3(5),fm3(5),df(5)

    i = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    j = blockIdx%y - 1
    k = blockIdx%z - 1
    if(i < 0 .or. i > im .or. j < 0 .or. j > jm .or. k < 0 .or. k > km) return
    if(i < is .or. i > ie) return

    call stored_diff_flux_at_xphysical(i,j,k,1,im,jm,km,f0)
    if(i < im   .or. apply_right == 0) call stored_diff_flux_at_xphysical(i+1,j,k,1,im,jm,km,fp1)
    if(i > 0    .or. apply_left  == 0) call stored_diff_flux_at_xphysical(i-1,j,k,1,im,jm,km,fm1)
    if(i < im-1 .or. apply_right == 0) call stored_diff_flux_at_xphysical(i+2,j,k,1,im,jm,km,fp2)
    if(i > 1    .or. apply_left  == 0) call stored_diff_flux_at_xphysical(i-2,j,k,1,im,jm,km,fm2)
    if(i < im-2 .or. apply_right == 0) call stored_diff_flux_at_xphysical(i+3,j,k,1,im,jm,km,fp3)
    if(i > 2    .or. apply_left  == 0) call stored_diff_flux_at_xphysical(i-3,j,k,1,im,jm,km,fm3)

    call deriv6_x_physical(i,im,apply_left,apply_right,f0,fp1,fm1,fp2,fm2,fp3,fm3,df)
    do m=2,5
      qrhs_d(i,j,k,m) = qrhs_d(i,j,k,m) + df(m)
    enddo
  end subroutine diffusion_rhs_x_xphysical_stored_global_kernel

  attributes(global) subroutine diffusion_rhs_y_stored_global_kernel(im,jm,km)
    use commarray_gpu, only: qrhs_d
    implicit none
    integer,value :: im,jm,km
    integer :: i,j,k,m
    real(8) :: fp1(5),fm1(5),fp2(5),fm2(5),fp3(5),fm3(5)

    i = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    j = (blockIdx%y - 1) * blockDim%y + threadIdx%y - 1
    k = blockIdx%z - 1
    if(i < 0 .or. i > im .or. j < 0 .or. j > jm .or. k < 0 .or. k > km) return
    call stored_diff_flux_at(i,j+1,k,2,im,jm,km,fp1)
    call stored_diff_flux_at(i,j-1,k,2,im,jm,km,fm1)
    call stored_diff_flux_at(i,j+2,k,2,im,jm,km,fp2)
    call stored_diff_flux_at(i,j-2,k,2,im,jm,km,fm2)
    call stored_diff_flux_at(i,j+3,k,2,im,jm,km,fp3)
    call stored_diff_flux_at(i,j-3,k,2,im,jm,km,fm3)
    do m=2,5
      qrhs_d(i,j,k,m) = qrhs_d(i,j,k,m) + deriv6(fp1(m),fm1(m),fp2(m),fm2(m),fp3(m),fm3(m))
    enddo
  end subroutine diffusion_rhs_y_stored_global_kernel

  attributes(global) subroutine diffusion_rhs_z_stored_global_kernel(im,jm,km)
    use commarray_gpu, only: qrhs_d
    implicit none
    integer,value :: im,jm,km
    integer :: i,j,k,m
    real(8) :: fp1(5),fm1(5),fp2(5),fm2(5),fp3(5),fm3(5)

    i = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    j = blockIdx%y - 1
    k = (blockIdx%z - 1) * blockDim%z + threadIdx%z - 1
    if(i < 0 .or. i > im .or. j < 0 .or. j > jm .or. k < 0 .or. k > km) return
    call stored_diff_flux_at(i,j,k+1,3,im,jm,km,fp1)
    call stored_diff_flux_at(i,j,k-1,3,im,jm,km,fm1)
    call stored_diff_flux_at(i,j,k+2,3,im,jm,km,fp2)
    call stored_diff_flux_at(i,j,k-2,3,im,jm,km,fm2)
    call stored_diff_flux_at(i,j,k+3,3,im,jm,km,fp3)
    call stored_diff_flux_at(i,j,k-3,3,im,jm,km,fm3)
    do m=2,5
      qrhs_d(i,j,k,m) = qrhs_d(i,j,k,m) + deriv6(fp1(m),fm1(m),fp2(m),fm2(m),fp3(m),fm3(m))
    enddo
  end subroutine diffusion_rhs_z_stored_global_kernel

  attributes(global) subroutine diffusion_rhs_x_yphysical_stored_global_kernel(im,jm,km,is,ie)
    use commarray_gpu, only: qrhs_d
    implicit none
    integer,value :: im,jm,km,is,ie
    integer :: i,j,k,m
    real(8) :: fp1(5),fm1(5),fp2(5),fm2(5),fp3(5),fm3(5)

    i = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    j = blockIdx%y - 1
    k = blockIdx%z - 1
    if(i < 0 .or. i > im .or. j < 0 .or. j > jm .or. k < 0 .or. k > km) return
    if(i < is .or. i > ie) return
    call stored_diff_flux_at_yphysical(i+1,j,k,1,im,jm,km,fp1)
    call stored_diff_flux_at_yphysical(i-1,j,k,1,im,jm,km,fm1)
    call stored_diff_flux_at_yphysical(i+2,j,k,1,im,jm,km,fp2)
    call stored_diff_flux_at_yphysical(i-2,j,k,1,im,jm,km,fm2)
    call stored_diff_flux_at_yphysical(i+3,j,k,1,im,jm,km,fp3)
    call stored_diff_flux_at_yphysical(i-3,j,k,1,im,jm,km,fm3)
    do m=2,5
      qrhs_d(i,j,k,m) = qrhs_d(i,j,k,m) + deriv6(fp1(m),fm1(m),fp2(m),fm2(m),fp3(m),fm3(m))
    enddo
