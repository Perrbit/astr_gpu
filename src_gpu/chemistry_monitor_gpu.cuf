module chemistry_monitor_gpu
  use cudafor
  implicit none
  integer,allocatable,device,save :: nodes_d(:,:)
  real(8),allocatable,device,save :: packed_d(:,:)
contains
  attributes(global) subroutine pack_monitor(n)
    use commarray_gpu, only: q_d,x_d
    integer,value :: n
    integer :: s,i,j,k
    s=(blockIdx%x-1)*blockDim%x+threadIdx%x
    if(s>n) return
    packed_d(:,s)=0.d0
    i=nodes_d(1,s); j=nodes_d(2,s); k=nodes_d(3,s)
    if(i<0) return
    packed_d(1:3,s)=x_d(i,j,k,:)
    packed_d(4:14,s)=q_d(i,j,k,1:11)
    packed_d(15,s)=1.d0
  end subroutine

  subroutine collect_air5_monitor_gpu(nodes,packed)
    use gpu_check, only: sync_after_kernel
    integer,intent(in) :: nodes(:,:)
    real(8),intent(out) :: packed(:,:)
    integer :: n
    n=size(nodes,2)
    if(.not.allocated(nodes_d)) then
      allocate(nodes_d(3,n),packed_d(15,n))
      nodes_d=nodes
    endif
    call pack_monitor<<<(n+127)/128,128>>>(n)
    call sync_after_kernel('air5 compact monitor',force_sync=.true.)
    packed=packed_d
  end subroutine
end module
