module output_fields_gpu
  use iso_fortran_env, only: int64,real64
  use cudafor
  use commarray_gpu, only: rho_d,vel_d,prs_d,tmp_d
#ifdef ASTR_AIR5_CHEMISTRY
  use commarray_gpu, only: tve_d,spc_d
#endif
  use gpu_check, only: sync_gpu_boundary,sync_after_kernel
  use checkpoint_state_io, only: checkpoint_state_require
  implicit none
  private
  public :: begin_basic_output_gpu,pack_basic_output_gpu,end_basic_output_gpu
  public :: begin_derived_output_gpu,pack_derived_output_gpu,end_derived_output_gpu
  public :: derived_output_workspace_gpu
  real(real64),allocatable,device,save :: packed_d(:)
  real(real64),allocatable,device,save :: private_velocity_d(:,:,:,:)
  integer,device,save :: selected_gpu_d(14)
  integer,save :: selected_gpu_count=0
  integer(int64),save :: transferred=0
contains
  subroutine derived_output_workspace_gpu(host_bytes,device_bytes)
    use commvar, only: im,jm,km,hm
    use halo_exchange_gpu, only: field_halo_workspace_bytes_gpu
    integer(int64),intent(out) :: host_bytes,device_bytes
    integer(int64) :: halo_device
    call field_halo_workspace_bytes_gpu(host_bytes,halo_device)
    device_bytes=product(int([im,jm,km]+2*hm+1,int64))*3*8+halo_device+14*4
  end subroutine

  subroutine begin_derived_output_gpu(capacity,host_budget,device_budget,comm,indices,host_bytes,device_bytes)
    use mpi, only: MPI_COMM_WORLD
    use commvar, only: im,jm,km,hm,difschm,numq,num_species,lihomo,ljhomo,lkhomo
    use bc, only: bctype
    use output_fields, only: agree_derived_selection
    use halo_exchange_gpu, only: exchange_field_halo_gpu,solution_pipeline_active
    use halo_transport_gpu, only: halo_transport_idle
    integer(int64),intent(in) :: capacity,host_budget,device_budget
    integer,intent(in) :: comm,indices(:)
    integer(int64),intent(out) :: host_bytes,device_bytes
    integer(int64) :: nodes,free_bytes,total_bytes
    integer :: status,selection(14)
    call checkpoint_state_require(comm==MPI_COMM_WORLD.and..not.allocated(private_velocity_d).and. &
      .not.allocated(packed_d),comm,'private GPU output lifecycle')
    call agree_derived_selection(indices,selection,comm)
    selected_gpu_count=count(selection>0)
    call checkpoint_state_require(selected_gpu_count>0.and.numq==5.and.num_species==0.and. &
      all(bctype==1).and.lihomo.and.ljhomo.and.lkhomo.and.hm>=3.and. &
      min(im,jm,km)>=hm.and.trim(difschm)=='643e',comm,'private GPU derivatives require periodic perfect gas 643e')
    call checkpoint_state_require(halo_transport_idle().and..not.solution_pipeline_active, &
      comm,'private GPU output requires completed halo transport')
    call derived_output_workspace_gpu(host_bytes,device_bytes)
    nodes=product(int([im,jm,km]+2*hm+1,int64))
    call checkpoint_state_require(host_budget>=host_bytes.and.capacity>0.and.capacity<=huge(status).and. &
      nodes<=huge(status)/3.and.device_budget>=device_bytes.and. &
      capacity<=(device_budget-device_bytes)/8,comm,'private GPU derivative budget')
    status=cudaMemGetInfo(free_bytes,total_bytes)
    call checkpoint_state_require(status==cudaSuccess.and.free_bytes>=device_bytes+capacity*8+1073741824_int64, &
      comm,'private GPU derivative free memory')
    call begin_basic_output_gpu(capacity,device_budget-device_bytes,comm)
    allocate(private_velocity_d(-hm:im+hm,-hm:jm+hm,-hm:km+hm,3),stat=status)
    call checkpoint_state_require(status==0,comm,'private GPU velocity allocation')
    selected_gpu_d=selection
    call copy_private_velocity_kernel<<<(int(nodes)*3+255)/256,256>>>(im,jm,km,hm)
    call sync_after_kernel('private output velocity copy',.true.)
    call exchange_field_halo_gpu(private_velocity_d,3)
    call sync_gpu_boundary('private output velocity halo completion')
  end subroutine

  attributes(global) subroutine copy_private_velocity_kernel(im,jm,km,hm)
    integer,value :: im,jm,km,hm
    integer :: id,node,nodes,i,j,k,c,ni,nj
    ni=im+2*hm+1; nj=jm+2*hm+1
    nodes=ni*nj*(km+2*hm+1)
    id=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    if(id>=nodes*3) return
    node=mod(id,nodes); c=id/nodes+1
    i=mod(node,ni)-hm; j=mod(node/ni,nj)-hm; k=node/(ni*nj)-hm
    private_velocity_d(i,j,k,c)=0.d0
    if(i>=0.and.i<=im.and.j>=0.and.j<=jm.and.k>=0.and.k<=km) &
      private_velocity_d(i,j,k,c)=vel_d(i,j,k,c)
  end subroutine

  attributes(global) subroutine pack_derived_kernel(i0,j0,k0,ni,nj,nk,nselected)
    use commarray_gpu, only: dxi_d
    use gradcal_gpu, only: deriv6
    integer,value :: i0,j0,k0,ni,nj,nk,nselected
    real(real64) :: gradient(3,3),directional(3),fields(14),qvalue
    integer :: node,nodes,i,j,k,c,d,m
    node=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    nodes=ni*nj*nk
    if(node>=nodes) return
    i=i0+mod(node,ni); j=j0+mod(node/ni,nj); k=k0+node/(ni*nj)
    do c=1,3
      directional(1)=deriv6(private_velocity_d(i-3,j,k,c),private_velocity_d(i-2,j,k,c), &
        private_velocity_d(i-1,j,k,c),private_velocity_d(i+1,j,k,c), &
        private_velocity_d(i+2,j,k,c),private_velocity_d(i+3,j,k,c))
      directional(2)=deriv6(private_velocity_d(i,j-3,k,c),private_velocity_d(i,j-2,k,c), &
        private_velocity_d(i,j-1,k,c),private_velocity_d(i,j+1,k,c), &
        private_velocity_d(i,j+2,k,c),private_velocity_d(i,j+3,k,c))
      directional(3)=deriv6(private_velocity_d(i,j,k-3,c),private_velocity_d(i,j,k-2,c), &
        private_velocity_d(i,j,k-1,c),private_velocity_d(i,j,k+1,c), &
        private_velocity_d(i,j,k+2,c),private_velocity_d(i,j,k+3,c))
      do d=1,3
        gradient(c,d)=directional(1)*dxi_d(i,j,k,1,d)+directional(2)*dxi_d(i,j,k,2,d)+ &
          directional(3)*dxi_d(i,j,k,3,d)
        fields(c+3*(d-1))=gradient(c,d)
      enddo
    enddo
    qvalue=0.d0
    do d=1,3
      do c=1,3
        qvalue=qvalue+gradient(c,d)*gradient(d,c)
      enddo
    enddo
    fields(10)=-0.5d0*qvalue
    fields(11)=gradient(1,1)+gradient(2,2)+gradient(3,3)
    fields(12)=gradient(3,2)-gradient(2,3)
    fields(13)=gradient(1,3)-gradient(3,1)
    fields(14)=gradient(2,1)-gradient(1,2)
    do m=1,nselected
      packed_d((5+m)*nodes+node+1)=fields(selected_gpu_d(m))
    enddo
  end subroutine

  subroutine pack_derived_output_gpu(start,extent,components,values)
    use commvar, only: im,jm,km
    integer,intent(in) :: start(3),extent(3),components
    real(real64),intent(out) :: values(:)
    integer :: nodes,count,status
    nodes=product(extent); count=nodes*components
    call local_require(allocated(private_velocity_d).and.allocated(packed_d),'private GPU output not initialized')
    call local_require(all(extent>0).and.all(start>=0).and.all(start+extent<=[im,jm,km]+1).and. &
      count>0.and.count<=size(packed_d).and.size(values)==count.and. &
      components==6+selected_gpu_count,'private GPU derivative tile shape')
    call pack_kernel<<<(nodes*6+255)/256,256>>>(start(1),start(2),start(3),extent(1),extent(2),extent(3),6)
    call sync_after_kernel('private output basic tile',.true.)
    call pack_derived_kernel<<<(nodes+255)/256,256>>>(start(1),start(2),start(3), &
      extent(1),extent(2),extent(3),selected_gpu_count)
    call sync_after_kernel('private output derived tile',.true.)
    status=cudaMemcpy(values,packed_d,int(count,int64),cudaMemcpyDeviceToHost)
    call local_require(status==cudaSuccess,'private derivative tile download')
    transferred=transferred+int(count,int64)*8
  end subroutine

  subroutine end_derived_output_gpu(bytes)
    integer(int64),intent(out) :: bytes
    call end_basic_output_gpu(bytes)
    if(allocated(private_velocity_d)) deallocate(private_velocity_d)
    selected_gpu_count=0
    ! Generic halo buffers belong to the solver transport, not this frame.
  end subroutine

  subroutine begin_basic_output_gpu(capacity,budget,comm)
    integer(int64),intent(in) :: capacity,budget
    integer,intent(in) :: comm
    integer :: status
    call checkpoint_state_require(.not.allocated(packed_d).and.capacity>0.and. &
      capacity<=budget/8.and.capacity<=huge(status),comm,'basic output GPU packing budget')
    allocate(packed_d(int(capacity)),stat=status)
    call checkpoint_state_require(status==0,comm,'basic output GPU packing allocation')
    transferred=0
    call sync_gpu_boundary('basic output device snapshot entry')
  end subroutine

  attributes(global) subroutine pack_kernel(i0,j0,k0,ni,nj,nk,components)
    integer,value :: i0,j0,k0,ni,nj,nk,components
    integer :: id,node,m,i,j,k,nodes
    real(real64) :: value
    id=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    nodes=ni*nj*nk
    if(id>=nodes*components) return
    node=mod(id,nodes); m=id/nodes+1
    i=i0+mod(node,ni); j=j0+mod(node/ni,nj); k=k0+node/(ni*nj)
    select case(m)
    case(1)
      value=rho_d(i,j,k)
    case(2:4)
      value=vel_d(i,j,k,m-1)
    case(5)
      value=prs_d(i,j,k)
    case(6)
      value=tmp_d(i,j,k)
#ifdef ASTR_AIR5_CHEMISTRY
    case(7)
      value=tve_d(i,j,k)
    case(8:12)
      value=spc_d(i,j,k,m-7)
#endif
    end select
    packed_d(id+1)=value
  end subroutine

  subroutine pack_basic_output_gpu(start,extent,components,values)
    integer,intent(in) :: start(3),extent(3),components
    real(real64),intent(out) :: values(:)
    integer :: count,status
    count=product(extent)*components
    ! Empty ranks skip the callback; local failures must abort, not enter a collective.
    call local_require(allocated(packed_d),'basic output GPU packing not initialized')
    call local_require(count>0.and.count<=size(packed_d).and.size(values)==count.and. &
      (components==6.or.components==12),'basic output GPU tile shape')
#ifndef ASTR_AIR5_CHEMISTRY
    call local_require(components==6,'AIR5 output is not built')
#endif
    call pack_kernel<<<(count+255)/256,256>>>(start(1),start(2),start(3),extent(1),extent(2),extent(3),components)
    call sync_after_kernel('basic output tile packing',.true.)
    ! Typed CUDA Fortran arrays take an element count; C pointers take bytes.
    status=cudaMemcpy(values,packed_d,int(count,int64),cudaMemcpyDeviceToHost)
    call local_require(status==cudaSuccess,'basic output tile download')
    transferred=transferred+int(count,int64)*8
  end subroutine

  subroutine local_require(condition,message)
    use mpi, only: MPI_COMM_WORLD,MPI_Abort
    use iso_fortran_env, only: error_unit
    logical,intent(in) :: condition
    character(*),intent(in) :: message
    integer :: ierr
    if(condition) return
    write(error_unit,'(a)') message
    call MPI_Abort(MPI_COMM_WORLD,71,ierr)
    error stop 'GPU field packing rejected'
  end subroutine

  subroutine end_basic_output_gpu(bytes)
    integer(int64),intent(out) :: bytes
    bytes=transferred
    if(allocated(packed_d)) deallocate(packed_d)
  end subroutine
end module
