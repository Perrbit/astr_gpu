module chemistry_postshock_boundary_gpu
  use cudafor
  use iso_fortran_env, only: real64
  use chemistry_state_layout, only: air5_num_conservative
  implicit none
  private

  real(real64), device, save :: left_q_d(air5_num_conservative)
  real(real64), device, save :: right_q_d(air5_num_conservative)
  logical, save :: boundary_configured_gpu=.false.

  public :: initialize_air5_postshock_boundary_gpu
  public :: apply_air5_postshock_boundary_gpu

contains

  subroutine initialize_air5_postshock_boundary_gpu()
    use commvar, only: flowtype
    use chemistry_postshock_boundary, only: get_air5_postshock_boundary
    real(real64) :: left_state(air5_num_conservative)
    real(real64) :: right_state(air5_num_conservative)

    if(trim(flowtype)/='air5postshock' .and. &
       trim(flowtype)/='air5normalshock') return
    call get_air5_postshock_boundary(left_state,right_state)
    left_q_d=left_state
    right_q_d=right_state
    boundary_configured_gpu=.true.
  end subroutine initialize_air5_postshock_boundary_gpu

  attributes(global) subroutine air5_postshock_boundary_kernel(im,jm,km,hm, &
      apply_left,apply_right,normal_shock_case)
    use commarray_gpu, only: q_d
    integer, value :: im,jm,km,hm,apply_left,apply_right,normal_shock_case
    integer :: id,ntot,i,j,k,component

    id=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    ntot=(jm+1)*(km+1)
    if(id>=ntot) return
    j=mod(id,jm+1)
    k=id/(jm+1)
    if(apply_left/=0) then
      do component=1,air5_num_conservative
        do i=-hm,0
          q_d(i,j,k,component)=left_q_d(component)
        enddo
      enddo
    endif
    if(apply_right/=0) then
      if(normal_shock_case/=0) then
        do component=1,air5_num_conservative
          do i=im,im+hm
            q_d(i,j,k,component)=q_d(im-1,j,k,component)
          enddo
        enddo
      else
        do component=1,air5_num_conservative
          do i=im,im+hm
            q_d(i,j,k,component)=right_q_d(component)
          enddo
        enddo
      endif
    endif
  end subroutine air5_postshock_boundary_kernel

  subroutine apply_air5_postshock_boundary_gpu()
    use mpi, only: MPI_PROC_NULL
    use commvar, only: im,jm,km,hm,flowtype
    use parallel, only: mpileft,mpiright
    use gpu_check, only: sync_after_kernel
    integer :: apply_left,apply_right,normal_shock_case,ntot
    type(dim3) :: block,grid

    normal_shock_case=merge(1,0,trim(flowtype)=='air5normalshock')
    if(trim(flowtype)/='air5postshock' .and. normal_shock_case==0) return
    if(.not.boundary_configured_gpu) &
      error stop 'fixed air5 GPU post-shock boundary is not configured'
    apply_left=merge(1,0,mpileft==MPI_PROC_NULL)
    apply_right=merge(1,0,mpiright==MPI_PROC_NULL)
    if(apply_left==0 .and. apply_right==0) return
    ntot=(jm+1)*(km+1)
    block=dim3(256,1,1)
    grid=dim3((ntot+block%x-1)/block%x,1,1)
    call air5_postshock_boundary_kernel<<<grid,block>>>(im,jm,km,hm, &
      apply_left,apply_right,normal_shock_case)
    call sync_after_kernel('air5_postshock_boundary_kernel',.true.)
  end subroutine apply_air5_postshock_boundary_gpu

end module chemistry_postshock_boundary_gpu

module chemistry_hbl_boundary_gpu
  use cudafor
  use iso_fortran_env, only: real64
  use chemistry_air5_data, only: air5_num_species,air5_molar_mass,air5_ru
  use chemistry_model, only: chemistry_status_ok,chemistry_status_invalid_density, &
    chemistry_status_invalid_composition
  use chemistry_state_layout, only: air5_num_conservative,air5_idx_density, &
    air5_idx_momentum_first,air5_idx_total_energy,air5_idx_species_first, &
    air5_idx_species_last
  use chemistry_flow_state_gpu, only: air5_primitive_to_conservative_gpu, &
    air5_conservative_to_primitive_gpu
  implicit none
  private

  real(real64), device, allocatable, save :: inlet_q_d(:,:)
  real(real64), device, save :: farfield_q_d(air5_num_conservative)
  real(real64), device, save :: wall_temperature_d
  real(real64), device, save :: hbl_x_origin_d
  integer, device, save :: hbl_status_d
  logical, save :: boundary_configured_gpu=.false.

  public :: initialize_air5_hbl_boundary_gpu
  public :: apply_air5_hbl_boundary_gpu
  public :: release_air5_hbl_boundary_gpu

contains

  subroutine initialize_air5_hbl_boundary_gpu()
    use commvar, only: flowtype
    use chemistry_hbl_boundary, only: get_air5_hbl_boundary
    real(real64), allocatable :: inlet_state(:,:)
    real(real64) :: farfield_state(air5_num_conservative),wall_temp,x_origin

    if(trim(flowtype)/='air5hbl') return
    call get_air5_hbl_boundary(inlet_state,farfield_state,wall_temp,x_origin)
    if(allocated(inlet_q_d)) deallocate(inlet_q_d)
    allocate(inlet_q_d(0:ubound(inlet_state,1),air5_num_conservative))
    inlet_q_d=inlet_state
    farfield_q_d=farfield_state
    wall_temperature_d=wall_temp
    hbl_x_origin_d=x_origin
    deallocate(inlet_state)
    boundary_configured_gpu=.true.
  end subroutine initialize_air5_hbl_boundary_gpu

  attributes(device) subroutine record_hbl_status(status)
    integer, value :: status
    integer :: ignored

    if(status/=chemistry_status_ok) ignored=atomicMax(hbl_status_d,status)
  end subroutine record_hbl_status

  attributes(device) subroutine build_air5_hbl_outflow_state_gpu(q_inner_one, &
      q_inner_two,q_outflow,status)
    real(real64), intent(in) :: q_inner_one(air5_num_conservative)
    real(real64), intent(in) :: q_inner_two(air5_num_conservative)
    real(real64), intent(out) :: q_outflow(air5_num_conservative)
    integer, intent(out) :: status
    real(real64) :: density,velocity(3),temperature,mass_fraction(air5_num_species)
    real(real64) :: tv,pressure,q_high(air5_num_conservative)
    real(real64) :: q_trial(air5_num_conservative)
    real(real64) :: theta_lower,theta_upper,theta_trial
    integer :: component,iteration,trial_status
    logical :: species_limited

    q_high=(4.0_real64*q_inner_one-q_inner_two)/3.0_real64
    q_outflow=q_high
    call air5_conservative_to_primitive_gpu(q_outflow,density,velocity,temperature, &
      mass_fraction,tv,pressure,status)
    if(status==chemistry_status_ok) return

    q_outflow=q_inner_one
    call air5_conservative_to_primitive_gpu(q_outflow,density,velocity,temperature, &
      mass_fraction,tv,pressure,status)
    if(status/=chemistry_status_ok) then
      q_outflow=0.0_real64
      return
    endif

    q_trial=q_high
    species_limited=.false.
    do component=air5_idx_species_first+1,air5_idx_species_last
      if(q_high(component)<0.0_real64) then
        species_limited=.true.
        if(q_inner_one(component)<=0.0_real64) then
          theta_trial=0.0_real64
        else
          theta_trial=q_inner_one(component)/ &
            (q_inner_one(component)-q_high(component))
          theta_trial=theta_trial*(1.0_real64-256.0_real64*epsilon(1.0_real64))
        endif
        theta_trial=max(0.0_real64,min(1.0_real64,theta_trial))
        q_trial(component)=q_inner_one(component)+theta_trial* &
          (q_high(component)-q_inner_one(component))
      endif
    enddo
    if(species_limited) then
      q_trial(air5_idx_species_first)=q_high(air5_idx_density)
      do component=air5_idx_species_first+1,air5_idx_species_last
        q_trial(air5_idx_species_first)=q_trial(air5_idx_species_first)-q_trial(component)
      enddo
      call air5_conservative_to_primitive_gpu(q_trial,density,velocity,temperature, &
        mass_fraction,tv,pressure,trial_status)
      if(trial_status==chemistry_status_ok) then
        q_outflow=q_trial
        status=chemistry_status_ok
        return
      endif
    endif

    theta_upper=1.0_real64
    do component=air5_idx_species_first,air5_idx_species_last
      if(q_high(component)<0.0_real64) then
        if(q_inner_one(component)<=0.0_real64) then
          theta_upper=0.0_real64
        else
          theta_upper=min(theta_upper,q_inner_one(component)/ &
            (q_inner_one(component)-q_high(component)))
        endif
      endif
    enddo
    theta_upper=max(0.0_real64,min(1.0_real64,theta_upper))
    if(theta_upper<1.0_real64) &
      theta_upper=theta_upper*(1.0_real64-256.0_real64*epsilon(1.0_real64))
    q_trial=q_inner_one+theta_upper*(q_high-q_inner_one)
    call air5_conservative_to_primitive_gpu(q_trial,density,velocity,temperature, &
      mass_fraction,tv,pressure,trial_status)
    if(trial_status==chemistry_status_ok) then
      q_outflow=q_trial
      status=chemistry_status_ok
      return
    endif

    theta_lower=0.0_real64
    do iteration=1,64
      theta_trial=0.5_real64*(theta_lower+theta_upper)
      q_trial=q_inner_one+theta_trial*(q_high-q_inner_one)
      call air5_conservative_to_primitive_gpu(q_trial,density,velocity,temperature, &
        mass_fraction,tv,pressure,trial_status)
      if(trial_status==chemistry_status_ok) then
        theta_lower=theta_trial
        q_outflow=q_trial
      else
        theta_upper=theta_trial
      endif
    enddo
    status=chemistry_status_ok
  end subroutine build_air5_hbl_outflow_state_gpu

  attributes(global) subroutine air5_hbl_outflow_boundary_kernel(im,jm,km,hm)
    use commarray_gpu, only: q_d
    integer, value :: im,jm,km,hm
    integer :: id,ntot,i,j,k,status
    real(real64) :: q_boundary(air5_num_conservative)
    real(real64) :: q_inner_one(air5_num_conservative)
    real(real64) :: q_inner_two(air5_num_conservative)

    id=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    ntot=(jm+1)*(km+1)
    if(id>=ntot) return
    j=mod(id,jm+1)
    k=id/(jm+1)
    q_inner_one=q_d(im-1,j,k,1:air5_num_conservative)
    q_inner_two=q_d(im-2,j,k,1:air5_num_conservative)
    call build_air5_hbl_outflow_state_gpu(q_inner_one,q_inner_two,q_boundary,status)
    if(status/=chemistry_status_ok) then
      call record_hbl_status(status)
      return
    endif
    do i=im,im+hm
      q_d(i,j,k,1:air5_num_conservative)=q_boundary
    enddo
  end subroutine air5_hbl_outflow_boundary_kernel

  attributes(global) subroutine air5_hbl_wall_boundary_kernel(im,jm,km,hm)
    use commarray_gpu, only: q_d
    integer, value :: im,jm,km,hm
    integer :: id,ntot,i,j,k,status
    real(real64) :: q_one(air5_num_conservative),q_two(air5_num_conservative)
    real(real64) :: q_boundary(air5_num_conservative)
    real(real64) :: density_one,density_two,temperature_one,temperature_two
    real(real64) :: velocity_one(3),velocity_two(3),velocity_wall(3)
    real(real64) :: y_one(air5_num_species),y_two(air5_num_species)
    real(real64) :: y_wall(air5_num_species),tv_one,tv_two
    real(real64) :: pressure_one,pressure_two,pressure_wall
    real(real64) :: mixture_gas_constant,density_wall

    id=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    ntot=(im+1)*(km+1)
    if(id>=ntot) return
    i=mod(id,im+1)
    k=id/(im+1)
    q_one=q_d(i,1,k,1:air5_num_conservative)
    q_two=q_d(i,2,k,1:air5_num_conservative)
    call air5_conservative_to_primitive_gpu(q_one,density_one,velocity_one, &
      temperature_one,y_one,tv_one,pressure_one,status)
    if(status/=chemistry_status_ok) then
      call record_hbl_status(status)
      return
    endif
    call air5_conservative_to_primitive_gpu(q_two,density_two,velocity_two, &
      temperature_two,y_two,tv_two,pressure_two,status)
    if(status/=chemistry_status_ok) then
      call record_hbl_status(status)
      return
    endif
    pressure_wall=(4.0_real64*pressure_one-pressure_two)/3.0_real64
    if(pressure_wall<=0.0_real64) then
      call record_hbl_status(chemistry_status_invalid_density)
      return
    endif
    y_wall=y_one
    if(any(y_wall<0.0_real64)) then
      call record_hbl_status(chemistry_status_invalid_composition)
      return
    endif
    mixture_gas_constant=sum(y_wall*air5_ru/air5_molar_mass)
    if(mixture_gas_constant<=0.0_real64) then
      call record_hbl_status(chemistry_status_invalid_composition)
      return
    endif
    density_wall=pressure_wall/(mixture_gas_constant*wall_temperature_d)
    velocity_wall=0.0_real64
    call air5_primitive_to_conservative_gpu(density_wall,velocity_wall, &
      wall_temperature_d,y_wall,wall_temperature_d,q_boundary,status)
    if(status/=chemistry_status_ok) then
      call record_hbl_status(status)
      return
    endif
    do j=-hm,0
      q_d(i,j,k,1:air5_num_conservative)=q_boundary
    enddo
  end subroutine air5_hbl_wall_boundary_kernel

  attributes(global) subroutine air5_hbl_farfield_boundary_kernel(im,jm,km,hm)
    use commarray_gpu, only: q_d,x_d
    integer, value :: im,jm,km,hm
    integer :: id,ntot,i,j,k
    integer, parameter :: normal_momentum_index=air5_idx_momentum_first+1
    real(real64) :: density,normal_momentum,scale
    real(real64) :: q_boundary(air5_num_conservative)

    id=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    ntot=(im+1)*(km+1)
    if(id>=ntot) return
    i=mod(id,im+1)
    k=id/(im+1)
    density=farfield_q_d(air5_idx_density)
    if(density<=0.0_real64 .or. hbl_x_origin_d<=0.0_real64 .or. &
       x_d(i,jm,k,1)<0.0_real64) then
      call record_hbl_status(chemistry_status_invalid_density)
      return
    endif
    scale=sqrt(hbl_x_origin_d/(hbl_x_origin_d+x_d(i,jm,k,1)))
    q_boundary=farfield_q_d
    normal_momentum=farfield_q_d(normal_momentum_index)*scale
    q_boundary(normal_momentum_index)=normal_momentum
    q_boundary(air5_idx_total_energy)=farfield_q_d(air5_idx_total_energy)+ &
      (normal_momentum*normal_momentum- &
       farfield_q_d(normal_momentum_index)*farfield_q_d(normal_momentum_index))/ &
      (2.0_real64*density)
    do j=jm,jm+hm
      q_d(i,j,k,1:air5_num_conservative)=q_boundary
    enddo
  end subroutine air5_hbl_farfield_boundary_kernel

  attributes(global) subroutine air5_hbl_inflow_boundary_kernel(im,jm,km,hm)
    use commarray_gpu, only: q_d
    integer, value :: im,jm,km,hm
    integer :: id,ntot,i,j,k

    id=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    ntot=(jm+1)*(km+1)
    if(id>=ntot) return
    j=mod(id,jm+1)
    k=id/(jm+1)
    do i=-hm,0
      q_d(i,j,k,1:air5_num_conservative)=inlet_q_d(j,:)
    enddo
  end subroutine air5_hbl_inflow_boundary_kernel

  subroutine check_hbl_status(label)
    use mpi
    character(len=*), intent(in) :: label
    integer :: local_status,global_status,ierr

    local_status=hbl_status_d
    call MPI_Allreduce(local_status,global_status,1,MPI_INTEGER,MPI_MAX, &
      MPI_COMM_WORLD,ierr)
    if(ierr/=MPI_SUCCESS) call MPI_Abort(MPI_COMM_WORLD,ierr,local_status)
    if(global_status/=chemistry_status_ok) then
      write(*,'(3A,I0)') 'fixed air5 GPU HBL ',trim(label), &
        ' boundary failed, status=',global_status
      call MPI_Abort(MPI_COMM_WORLD,global_status,ierr)
    endif
  end subroutine check_hbl_status

  subroutine apply_air5_hbl_boundary_gpu()
    use mpi, only: MPI_PROC_NULL
    use commvar, only: im,jm,km,hm,flowtype
    use parallel, only: mpileft,mpiright,mpidown,mpiup
    use gpu_check, only: sync_after_kernel
    integer :: ntot
    type(dim3) :: block,grid

    if(trim(flowtype)/='air5hbl') return
    if(.not.boundary_configured_gpu) &
      error stop 'fixed air5 GPU HBL boundary is not configured'
    block=dim3(256,1,1)

    hbl_status_d=chemistry_status_ok
    if(mpiright==MPI_PROC_NULL) then
      ntot=(jm+1)*(km+1)
      grid=dim3((ntot+block%x-1)/block%x,1,1)
      call air5_hbl_outflow_boundary_kernel<<<grid,block>>>(im,jm,km,hm)
      call sync_after_kernel('air5_hbl_outflow_boundary_kernel',.true.)
    endif
    call check_hbl_status('outflow')
    hbl_status_d=chemistry_status_ok
    if(mpidown==MPI_PROC_NULL) then
      ntot=(im+1)*(km+1)
      grid=dim3((ntot+block%x-1)/block%x,1,1)
      call air5_hbl_wall_boundary_kernel<<<grid,block>>>(im,jm,km,hm)
      call sync_after_kernel('air5_hbl_wall_boundary_kernel',.true.)
    endif
    call check_hbl_status('wall')
    hbl_status_d=chemistry_status_ok
    if(mpiup==MPI_PROC_NULL) then
      ntot=(im+1)*(km+1)
      grid=dim3((ntot+block%x-1)/block%x,1,1)
      call air5_hbl_farfield_boundary_kernel<<<grid,block>>>(im,jm,km,hm)
      call sync_after_kernel('air5_hbl_farfield_boundary_kernel',.true.)
    endif
    call check_hbl_status('farfield')
    if(mpileft==MPI_PROC_NULL) then
      ntot=(jm+1)*(km+1)
      grid=dim3((ntot+block%x-1)/block%x,1,1)
      call air5_hbl_inflow_boundary_kernel<<<grid,block>>>(im,jm,km,hm)
      call sync_after_kernel('air5_hbl_inflow_boundary_kernel',.true.)
    endif
  end subroutine apply_air5_hbl_boundary_gpu

  subroutine release_air5_hbl_boundary_gpu()
    if(allocated(inlet_q_d)) deallocate(inlet_q_d)
    boundary_configured_gpu=.false.
  end subroutine release_air5_hbl_boundary_gpu

end module chemistry_hbl_boundary_gpu
