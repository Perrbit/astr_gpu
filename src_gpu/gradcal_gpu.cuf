module gradcal_gpu
  use cudafor
  implicit none
contains
  attributes(device) real(8) function deriv6(fm3,fm2,fm1,fp1,fp2,fp3)
    implicit none
    real(8),value :: fm3,fm2,fm1,fp1,fp2,fp3

    deriv6 = 0.75d0*(fp1 - fm1) - 0.15d0*(fp2 - fm2) + (fp3 - fm3)/60.d0
  end function deriv6

  attributes(device) real(8) function deriv6_x_vel(i,j,k,a,im,apply_left,apply_right)
    use commarray_gpu, only: vel_d
    implicit none
    integer,value :: i,j,k,a,im,apply_left,apply_right

    if(apply_left /= 0 .and. i == 0) then
      deriv6_x_vel = -0.5d0*vel_d(2,j,k,a) + 2.d0*vel_d(1,j,k,a) - 1.5d0*vel_d(0,j,k,a)
    elseif(apply_left /= 0 .and. i == 1) then
      deriv6_x_vel = 0.5d0*(vel_d(2,j,k,a)-vel_d(0,j,k,a))
    elseif(apply_left /= 0 .and. i == 2) then
      deriv6_x_vel = (2.d0/3.d0)*(vel_d(3,j,k,a)-vel_d(1,j,k,a)) - &
                     (1.d0/12.d0)*(vel_d(4,j,k,a)-vel_d(0,j,k,a))
    elseif(apply_right /= 0 .and. i == im-2) then
      deriv6_x_vel = (2.d0/3.d0)*(vel_d(im-1,j,k,a)-vel_d(im-3,j,k,a)) - &
                     (1.d0/12.d0)*(vel_d(im,j,k,a)-vel_d(im-4,j,k,a))
    elseif(apply_right /= 0 .and. i == im-1) then
      deriv6_x_vel = 0.5d0*(vel_d(im,j,k,a)-vel_d(im-2,j,k,a))
    elseif(apply_right /= 0 .and. i == im) then
      deriv6_x_vel = 0.5d0*vel_d(im-2,j,k,a) - 2.d0*vel_d(im-1,j,k,a) + &
                     1.5d0*vel_d(im,j,k,a)
    else
      deriv6_x_vel = deriv6(vel_d(i-3,j,k,a),vel_d(i-2,j,k,a),vel_d(i-1,j,k,a), &
                            vel_d(i+1,j,k,a),vel_d(i+2,j,k,a),vel_d(i+3,j,k,a))
    endif
  end function deriv6_x_vel

  attributes(device) real(8) function deriv6_x_tmp(i,j,k,im,apply_left,apply_right)
    use commarray_gpu, only: tmp_d
    implicit none
    integer,value :: i,j,k,im,apply_left,apply_right

    if(apply_left /= 0 .and. i == 0) then
      deriv6_x_tmp = -0.5d0*tmp_d(2,j,k) + 2.d0*tmp_d(1,j,k) - 1.5d0*tmp_d(0,j,k)
    elseif(apply_left /= 0 .and. i == 1) then
      deriv6_x_tmp = 0.5d0*(tmp_d(2,j,k)-tmp_d(0,j,k))
    elseif(apply_left /= 0 .and. i == 2) then
      deriv6_x_tmp = (2.d0/3.d0)*(tmp_d(3,j,k)-tmp_d(1,j,k)) - &
                     (1.d0/12.d0)*(tmp_d(4,j,k)-tmp_d(0,j,k))
    elseif(apply_right /= 0 .and. i == im-2) then
      deriv6_x_tmp = (2.d0/3.d0)*(tmp_d(im-1,j,k)-tmp_d(im-3,j,k)) - &
                     (1.d0/12.d0)*(tmp_d(im,j,k)-tmp_d(im-4,j,k))
    elseif(apply_right /= 0 .and. i == im-1) then
      deriv6_x_tmp = 0.5d0*(tmp_d(im,j,k)-tmp_d(im-2,j,k))
    elseif(apply_right /= 0 .and. i == im) then
      deriv6_x_tmp = 0.5d0*tmp_d(im-2,j,k) - 2.d0*tmp_d(im-1,j,k) + &
                     1.5d0*tmp_d(im,j,k)
    else
      deriv6_x_tmp = deriv6(tmp_d(i-3,j,k),tmp_d(i-2,j,k),tmp_d(i-1,j,k), &
                            tmp_d(i+1,j,k),tmp_d(i+2,j,k),tmp_d(i+3,j,k))
    endif
  end function deriv6_x_tmp

  attributes(device) real(8) function deriv6_y_vel(i,j,k,a,jm,apply_down,apply_up)
    use commarray_gpu, only: vel_d
    implicit none
    integer,value :: i,j,k,a,jm,apply_down,apply_up

    if(apply_down /= 0 .and. j == 0) then
      deriv6_y_vel = -0.5d0*vel_d(i,2,k,a) + 2.d0*vel_d(i,1,k,a) - 1.5d0*vel_d(i,0,k,a)
    elseif(apply_down /= 0 .and. j == 1) then
      deriv6_y_vel = 0.5d0*(vel_d(i,2,k,a)-vel_d(i,0,k,a))
    elseif(apply_down /= 0 .and. j == 2) then
      deriv6_y_vel = (2.d0/3.d0)*(vel_d(i,3,k,a)-vel_d(i,1,k,a)) - &
                     (1.d0/12.d0)*(vel_d(i,4,k,a)-vel_d(i,0,k,a))
    elseif(apply_up /= 0 .and. j == jm-2) then
      deriv6_y_vel = (2.d0/3.d0)*(vel_d(i,jm-1,k,a)-vel_d(i,jm-3,k,a)) - &
                     (1.d0/12.d0)*(vel_d(i,jm,k,a)-vel_d(i,jm-4,k,a))
    elseif(apply_up /= 0 .and. j == jm-1) then
      deriv6_y_vel = 0.5d0*(vel_d(i,jm,k,a)-vel_d(i,jm-2,k,a))
    elseif(apply_up /= 0 .and. j == jm) then
      deriv6_y_vel = 0.5d0*vel_d(i,jm-2,k,a) - 2.d0*vel_d(i,jm-1,k,a) + &
                     1.5d0*vel_d(i,jm,k,a)
    else
      deriv6_y_vel = deriv6(vel_d(i,j-3,k,a),vel_d(i,j-2,k,a),vel_d(i,j-1,k,a), &
                            vel_d(i,j+1,k,a),vel_d(i,j+2,k,a),vel_d(i,j+3,k,a))
    endif
  end function deriv6_y_vel

  attributes(device) real(8) function deriv6_y_tmp(i,j,k,jm,apply_down,apply_up)
    use commarray_gpu, only: tmp_d
    implicit none
    integer,value :: i,j,k,jm,apply_down,apply_up

    if(apply_down /= 0 .and. j == 0) then
      deriv6_y_tmp = -0.5d0*tmp_d(i,2,k) + 2.d0*tmp_d(i,1,k) - 1.5d0*tmp_d(i,0,k)
    elseif(apply_down /= 0 .and. j == 1) then
      deriv6_y_tmp = 0.5d0*(tmp_d(i,2,k)-tmp_d(i,0,k))
    elseif(apply_down /= 0 .and. j == 2) then
      deriv6_y_tmp = (2.d0/3.d0)*(tmp_d(i,3,k)-tmp_d(i,1,k)) - &
                     (1.d0/12.d0)*(tmp_d(i,4,k)-tmp_d(i,0,k))
    elseif(apply_up /= 0 .and. j == jm-2) then
      deriv6_y_tmp = (2.d0/3.d0)*(tmp_d(i,jm-1,k)-tmp_d(i,jm-3,k)) - &
                     (1.d0/12.d0)*(tmp_d(i,jm,k)-tmp_d(i,jm-4,k))
    elseif(apply_up /= 0 .and. j == jm-1) then
      deriv6_y_tmp = 0.5d0*(tmp_d(i,jm,k)-tmp_d(i,jm-2,k))
    elseif(apply_up /= 0 .and. j == jm) then
      deriv6_y_tmp = 0.5d0*tmp_d(i,jm-2,k) - 2.d0*tmp_d(i,jm-1,k) + &
                     1.5d0*tmp_d(i,jm,k)
    else
      deriv6_y_tmp = deriv6(tmp_d(i,j-3,k),tmp_d(i,j-2,k),tmp_d(i,j-1,k), &
                            tmp_d(i,j+1,k),tmp_d(i,j+2,k),tmp_d(i,j+3,k))
    endif
  end function deriv6_y_tmp

  attributes(device) real(8) function deriv6_z_vel(i,j,k,a,km,apply_back,apply_front)
    use commarray_gpu, only: vel_d
    implicit none
    integer,value :: i,j,k,a,km,apply_back,apply_front

    if(apply_back /= 0 .and. k == 0) then
      deriv6_z_vel = -0.5d0*vel_d(i,j,2,a) + 2.d0*vel_d(i,j,1,a) - 1.5d0*vel_d(i,j,0,a)
    elseif(apply_back /= 0 .and. k == 1) then
      deriv6_z_vel = 0.5d0*(vel_d(i,j,2,a)-vel_d(i,j,0,a))
    elseif(apply_back /= 0 .and. k == 2) then
      deriv6_z_vel = (2.d0/3.d0)*(vel_d(i,j,3,a)-vel_d(i,j,1,a)) - &
                     (1.d0/12.d0)*(vel_d(i,j,4,a)-vel_d(i,j,0,a))
    elseif(apply_front /= 0 .and. k == km-2) then
      deriv6_z_vel = (2.d0/3.d0)*(vel_d(i,j,km-1,a)-vel_d(i,j,km-3,a)) - &
                     (1.d0/12.d0)*(vel_d(i,j,km,a)-vel_d(i,j,km-4,a))
    elseif(apply_front /= 0 .and. k == km-1) then
      deriv6_z_vel = 0.5d0*(vel_d(i,j,km,a)-vel_d(i,j,km-2,a))
    elseif(apply_front /= 0 .and. k == km) then
      deriv6_z_vel = 0.5d0*vel_d(i,j,km-2,a) - 2.d0*vel_d(i,j,km-1,a) + &
                     1.5d0*vel_d(i,j,km,a)
    else
      deriv6_z_vel = deriv6(vel_d(i,j,k-3,a),vel_d(i,j,k-2,a),vel_d(i,j,k-1,a), &
                            vel_d(i,j,k+1,a),vel_d(i,j,k+2,a),vel_d(i,j,k+3,a))
    endif
  end function deriv6_z_vel

  attributes(device) real(8) function deriv6_z_tmp(i,j,k,km,apply_back,apply_front)
    use commarray_gpu, only: tmp_d
    implicit none
    integer,value :: i,j,k,km,apply_back,apply_front

    if(apply_back /= 0 .and. k == 0) then
      deriv6_z_tmp = -0.5d0*tmp_d(i,j,2) + 2.d0*tmp_d(i,j,1) - 1.5d0*tmp_d(i,j,0)
    elseif(apply_back /= 0 .and. k == 1) then
      deriv6_z_tmp = 0.5d0*(tmp_d(i,j,2)-tmp_d(i,j,0))
    elseif(apply_back /= 0 .and. k == 2) then
      deriv6_z_tmp = (2.d0/3.d0)*(tmp_d(i,j,3)-tmp_d(i,j,1)) - &
                     (1.d0/12.d0)*(tmp_d(i,j,4)-tmp_d(i,j,0))
    elseif(apply_front /= 0 .and. k == km-2) then
      deriv6_z_tmp = (2.d0/3.d0)*(tmp_d(i,j,km-1)-tmp_d(i,j,km-3)) - &
                     (1.d0/12.d0)*(tmp_d(i,j,km)-tmp_d(i,j,km-4))
    elseif(apply_front /= 0 .and. k == km-1) then
      deriv6_z_tmp = 0.5d0*(tmp_d(i,j,km)-tmp_d(i,j,km-2))
    elseif(apply_front /= 0 .and. k == km) then
      deriv6_z_tmp = 0.5d0*tmp_d(i,j,km-2) - 2.d0*tmp_d(i,j,km-1) + &
                     1.5d0*tmp_d(i,j,km)
    else
      deriv6_z_tmp = deriv6(tmp_d(i,j,k-3),tmp_d(i,j,k-2),tmp_d(i,j,k-1), &
                            tmp_d(i,j,k+1),tmp_d(i,j,k+2),tmp_d(i,j,k+3))
    endif
  end function deriv6_z_tmp

  attributes(global) subroutine gradcal_dvel_kernel(im,jm,km,hm)
    use commarray_gpu, only: vel_d,tmp_d,dxi_d,dvel_d,dtmp_d
    implicit none
    integer,value :: im,jm,km,hm
    integer :: i,j,k,a,b
    real(8) :: du_dxi(3,3),dt_dxi(3)

    i = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    j = (blockIdx%y - 1) * blockDim%y + threadIdx%y - 1
    k = (blockIdx%z - 1) * blockDim%z + threadIdx%z - 1
    if(i < 0 .or. i > im .or. j < 0 .or. j > jm .or. k < 0 .or. k > km) return

    do a=1,3
      du_dxi(1,a) = deriv6(vel_d(i-3,j,k,a),vel_d(i-2,j,k,a),vel_d(i-1,j,k,a), &
                           vel_d(i+1,j,k,a),vel_d(i+2,j,k,a),vel_d(i+3,j,k,a))
      du_dxi(2,a) = deriv6(vel_d(i,j-3,k,a),vel_d(i,j-2,k,a),vel_d(i,j-1,k,a), &
                           vel_d(i,j+1,k,a),vel_d(i,j+2,k,a),vel_d(i,j+3,k,a))
      du_dxi(3,a) = deriv6(vel_d(i,j,k-3,a),vel_d(i,j,k-2,a),vel_d(i,j,k-1,a), &
                           vel_d(i,j,k+1,a),vel_d(i,j,k+2,a),vel_d(i,j,k+3,a))
    enddo
    dt_dxi(1) = deriv6(tmp_d(i-3,j,k),tmp_d(i-2,j,k),tmp_d(i-1,j,k), &
                       tmp_d(i+1,j,k),tmp_d(i+2,j,k),tmp_d(i+3,j,k))
    dt_dxi(2) = deriv6(tmp_d(i,j-3,k),tmp_d(i,j-2,k),tmp_d(i,j-1,k), &
                       tmp_d(i,j+1,k),tmp_d(i,j+2,k),tmp_d(i,j+3,k))
    dt_dxi(3) = deriv6(tmp_d(i,j,k-3),tmp_d(i,j,k-2),tmp_d(i,j,k-1), &
                       tmp_d(i,j,k+1),tmp_d(i,j,k+2),tmp_d(i,j,k+3))

    do a=1,3
      do b=1,3
        dvel_d(i,j,k,a,b) = du_dxi(1,a)*dxi_d(i,j,k,1,b) + &
                            du_dxi(2,a)*dxi_d(i,j,k,2,b) + &
                            du_dxi(3,a)*dxi_d(i,j,k,3,b)
      enddo
    enddo
    do b=1,3
      dtmp_d(i,j,k,b) = dt_dxi(1)*dxi_d(i,j,k,1,b) + &
                        dt_dxi(2)*dxi_d(i,j,k,2,b) + &
                        dt_dxi(3)*dxi_d(i,j,k,3,b)
    enddo
  end subroutine gradcal_dvel_kernel

  attributes(global) subroutine gradcal_dvel_xphysical_kernel(im,jm,km,hm,apply_left,apply_right)
    use commarray_gpu, only: vel_d,tmp_d,dxi_d,dvel_d,dtmp_d
    implicit none
    integer,value :: im,jm,km,hm,apply_left,apply_right
    integer :: i,j,k,a,b
    real(8) :: du_dxi(3,3),dt_dxi(3)

    i = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    j = (blockIdx%y - 1) * blockDim%y + threadIdx%y - 1
    k = (blockIdx%z - 1) * blockDim%z + threadIdx%z - 1
    if(i < 0 .or. i > im .or. j < 0 .or. j > jm .or. k < 0 .or. k > km) return

    do a=1,3
      du_dxi(1,a) = deriv6_x_vel(i,j,k,a,im,apply_left,apply_right)
      du_dxi(2,a) = deriv6(vel_d(i,j-3,k,a),vel_d(i,j-2,k,a),vel_d(i,j-1,k,a), &
                           vel_d(i,j+1,k,a),vel_d(i,j+2,k,a),vel_d(i,j+3,k,a))
      du_dxi(3,a) = deriv6(vel_d(i,j,k-3,a),vel_d(i,j,k-2,a),vel_d(i,j,k-1,a), &
                           vel_d(i,j,k+1,a),vel_d(i,j,k+2,a),vel_d(i,j,k+3,a))
    enddo
    dt_dxi(1) = deriv6_x_tmp(i,j,k,im,apply_left,apply_right)
    dt_dxi(2) = deriv6(tmp_d(i,j-3,k),tmp_d(i,j-2,k),tmp_d(i,j-1,k), &
                       tmp_d(i,j+1,k),tmp_d(i,j+2,k),tmp_d(i,j+3,k))
    dt_dxi(3) = deriv6(tmp_d(i,j,k-3),tmp_d(i,j,k-2),tmp_d(i,j,k-1), &
                       tmp_d(i,j,k+1),tmp_d(i,j,k+2),tmp_d(i,j,k+3))

    do a=1,3
      do b=1,3
        dvel_d(i,j,k,a,b) = du_dxi(1,a)*dxi_d(i,j,k,1,b) + &
                            du_dxi(2,a)*dxi_d(i,j,k,2,b) + &
                            du_dxi(3,a)*dxi_d(i,j,k,3,b)
      enddo
    enddo
    do b=1,3
      dtmp_d(i,j,k,b) = dt_dxi(1)*dxi_d(i,j,k,1,b) + &
                        dt_dxi(2)*dxi_d(i,j,k,2,b) + &
                        dt_dxi(3)*dxi_d(i,j,k,3,b)
    enddo
  end subroutine gradcal_dvel_xphysical_kernel

  attributes(global) subroutine gradcal_dvel_yphysical_kernel(im,jm,km,hm,apply_down,apply_up)
    use commarray_gpu, only: vel_d,tmp_d,dxi_d,dvel_d,dtmp_d
    implicit none
    integer,value :: im,jm,km,hm,apply_down,apply_up
    integer :: i,j,k,a,b
    real(8) :: du_dxi(3,3),dt_dxi(3)

    i = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    j = (blockIdx%y - 1) * blockDim%y + threadIdx%y - 1
    k = (blockIdx%z - 1) * blockDim%z + threadIdx%z - 1
    if(i < 0 .or. i > im .or. j < 0 .or. j > jm .or. k < 0 .or. k > km) return

    do a=1,3
      du_dxi(1,a) = deriv6(vel_d(i-3,j,k,a),vel_d(i-2,j,k,a),vel_d(i-1,j,k,a), &
                           vel_d(i+1,j,k,a),vel_d(i+2,j,k,a),vel_d(i+3,j,k,a))
      du_dxi(2,a) = deriv6_y_vel(i,j,k,a,jm,apply_down,apply_up)
      du_dxi(3,a) = deriv6(vel_d(i,j,k-3,a),vel_d(i,j,k-2,a),vel_d(i,j,k-1,a), &
                           vel_d(i,j,k+1,a),vel_d(i,j,k+2,a),vel_d(i,j,k+3,a))
    enddo
    dt_dxi(1) = deriv6(tmp_d(i-3,j,k),tmp_d(i-2,j,k),tmp_d(i-1,j,k), &
                       tmp_d(i+1,j,k),tmp_d(i+2,j,k),tmp_d(i+3,j,k))
    dt_dxi(2) = deriv6_y_tmp(i,j,k,jm,apply_down,apply_up)
    dt_dxi(3) = deriv6(tmp_d(i,j,k-3),tmp_d(i,j,k-2),tmp_d(i,j,k-1), &
                       tmp_d(i,j,k+1),tmp_d(i,j,k+2),tmp_d(i,j,k+3))

    do a=1,3
      do b=1,3
        dvel_d(i,j,k,a,b) = du_dxi(1,a)*dxi_d(i,j,k,1,b) + &
                            du_dxi(2,a)*dxi_d(i,j,k,2,b) + &
                            du_dxi(3,a)*dxi_d(i,j,k,3,b)
      enddo
    enddo
    do b=1,3
      dtmp_d(i,j,k,b) = dt_dxi(1)*dxi_d(i,j,k,1,b) + &
                        dt_dxi(2)*dxi_d(i,j,k,2,b) + &
                        dt_dxi(3)*dxi_d(i,j,k,3,b)
    enddo
  end subroutine gradcal_dvel_yphysical_kernel

  attributes(global) subroutine gradcal_dvel_xyphysical_kernel(im,jm,km,hm,apply_left,apply_right,apply_down,apply_up)
    use commarray_gpu, only: vel_d,tmp_d,dxi_d,dvel_d,dtmp_d
    implicit none
    integer,value :: im,jm,km,hm,apply_left,apply_right,apply_down,apply_up
    integer :: i,j,k,a,b
    real(8) :: du_dxi(3,3),dt_dxi(3)

    i = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    j = (blockIdx%y - 1) * blockDim%y + threadIdx%y - 1
    k = (blockIdx%z - 1) * blockDim%z + threadIdx%z - 1
    if(i < 0 .or. i > im .or. j < 0 .or. j > jm .or. k < 0 .or. k > km) return
    do a=1,3
      du_dxi(1,a) = deriv6_x_vel(i,j,k,a,im,apply_left,apply_right)
      du_dxi(2,a) = deriv6_y_vel(i,j,k,a,jm,apply_down,apply_up)
      du_dxi(3,a) = deriv6(vel_d(i,j,k-3,a),vel_d(i,j,k-2,a),vel_d(i,j,k-1,a), &
                           vel_d(i,j,k+1,a),vel_d(i,j,k+2,a),vel_d(i,j,k+3,a))
    enddo
    dt_dxi(1) = deriv6_x_tmp(i,j,k,im,apply_left,apply_right)
    dt_dxi(2) = deriv6_y_tmp(i,j,k,jm,apply_down,apply_up)
    dt_dxi(3) = deriv6(tmp_d(i,j,k-3),tmp_d(i,j,k-2),tmp_d(i,j,k-1), &
                       tmp_d(i,j,k+1),tmp_d(i,j,k+2),tmp_d(i,j,k+3))
    do a=1,3
      do b=1,3
        dvel_d(i,j,k,a,b) = du_dxi(1,a)*dxi_d(i,j,k,1,b) + &
                            du_dxi(2,a)*dxi_d(i,j,k,2,b) + &
                            du_dxi(3,a)*dxi_d(i,j,k,3,b)
      enddo
    enddo
    do b=1,3
      dtmp_d(i,j,k,b) = dt_dxi(1)*dxi_d(i,j,k,1,b) + &
                        dt_dxi(2)*dxi_d(i,j,k,2,b) + &
                        dt_dxi(3)*dxi_d(i,j,k,3,b)
    enddo
  end subroutine gradcal_dvel_xyphysical_kernel

  attributes(global) subroutine gradcal_dvel_zphysical_kernel(im,jm,km,hm,apply_back,apply_front)
    use commarray_gpu, only: vel_d,tmp_d,dxi_d,dvel_d,dtmp_d
    implicit none
    integer,value :: im,jm,km,hm,apply_back,apply_front
    integer :: i,j,k,a,b
    real(8) :: du_dxi(3,3),dt_dxi(3)

    i = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    j = (blockIdx%y - 1) * blockDim%y + threadIdx%y - 1
    k = (blockIdx%z - 1) * blockDim%z + threadIdx%z - 1
    if(i < 0 .or. i > im .or. j < 0 .or. j > jm .or. k < 0 .or. k > km) return

    do a=1,3
      du_dxi(1,a) = deriv6(vel_d(i-3,j,k,a),vel_d(i-2,j,k,a),vel_d(i-1,j,k,a), &
                           vel_d(i+1,j,k,a),vel_d(i+2,j,k,a),vel_d(i+3,j,k,a))
      du_dxi(2,a) = deriv6(vel_d(i,j-3,k,a),vel_d(i,j-2,k,a),vel_d(i,j-1,k,a), &
                           vel_d(i,j+1,k,a),vel_d(i,j+2,k,a),vel_d(i,j+3,k,a))
      du_dxi(3,a) = deriv6_z_vel(i,j,k,a,km,apply_back,apply_front)
    enddo
    dt_dxi(1) = deriv6(tmp_d(i-3,j,k),tmp_d(i-2,j,k),tmp_d(i-1,j,k), &
                       tmp_d(i+1,j,k),tmp_d(i+2,j,k),tmp_d(i+3,j,k))
    dt_dxi(2) = deriv6(tmp_d(i,j-3,k),tmp_d(i,j-2,k),tmp_d(i,j-1,k), &
                       tmp_d(i,j+1,k),tmp_d(i,j+2,k),tmp_d(i,j+3,k))
    dt_dxi(3) = deriv6_z_tmp(i,j,k,km,apply_back,apply_front)

    do a=1,3
      do b=1,3
        dvel_d(i,j,k,a,b) = du_dxi(1,a)*dxi_d(i,j,k,1,b) + &
                            du_dxi(2,a)*dxi_d(i,j,k,2,b) + &
                            du_dxi(3,a)*dxi_d(i,j,k,3,b)
      enddo
    enddo
    do b=1,3
      dtmp_d(i,j,k,b) = dt_dxi(1)*dxi_d(i,j,k,1,b) + &
                        dt_dxi(2)*dxi_d(i,j,k,2,b) + &
                        dt_dxi(3)*dxi_d(i,j,k,3,b)
    enddo
  end subroutine gradcal_dvel_zphysical_kernel

  subroutine compute_gradcal_gpu()
    use mpi, only: MPI_PROC_NULL
    use commvar, only: im,jm,km,hm
    use boundary_gpu, only: gpu_physical_boundary_axis,gpu_s1_flatplate_boundary_case_pending
    use gpu_check, only: sync_after_kernel
    use parallel, only: mpileft,mpiright,mpidown,mpiup,mpiback,mpifront
    implicit none
    type(dim3) :: block3,grid3

    block3 = dim3(8,8,8)
    grid3 = dim3((im + block3%x)/block3%x, &
                 (jm + block3%y)/block3%y, &
                 (km + block3%z)/block3%z)
    if(gpu_s1_flatplate_boundary_case_pending()) then
      call gradcal_dvel_xyphysical_kernel<<<grid3,block3>>>(im,jm,km,hm, &
           merge(1,0,mpileft == MPI_PROC_NULL),merge(1,0,mpiright == MPI_PROC_NULL), &
           merge(1,0,mpidown == MPI_PROC_NULL),merge(1,0,mpiup == MPI_PROC_NULL))
      call sync_after_kernel('gradcal_dvel_xyphysical_kernel')
      return
    endif
    select case(gpu_physical_boundary_axis())
    case(1)
      call gradcal_dvel_xphysical_kernel<<<grid3,block3>>>(im,jm,km,hm, &
           merge(1,0,mpileft == MPI_PROC_NULL), &
           merge(1,0,mpiright == MPI_PROC_NULL))
      call sync_after_kernel('gradcal_dvel_xphysical_kernel')
    case(2)
      call gradcal_dvel_yphysical_kernel<<<grid3,block3>>>(im,jm,km,hm, &
           merge(1,0,mpidown == MPI_PROC_NULL), &
           merge(1,0,mpiup == MPI_PROC_NULL))
      call sync_after_kernel('gradcal_dvel_yphysical_kernel')
    case(3)
      call gradcal_dvel_zphysical_kernel<<<grid3,block3>>>(im,jm,km,hm, &
           merge(1,0,mpiback == MPI_PROC_NULL), &
           merge(1,0,mpifront == MPI_PROC_NULL))
      call sync_after_kernel('gradcal_dvel_zphysical_kernel')
    case default
      call gradcal_dvel_kernel<<<grid3,block3>>>(im,jm,km,hm)
      call sync_after_kernel('gradcal_dvel_kernel')
    end select
  end subroutine compute_gradcal_gpu

  subroutine write_gradcal_dvel_compare()
    use commvar, only: im,jm,km
    use commarray, only: dvel
    use commarray_gpu, only: dvel_d
    use parallel, only: lio
    implicit none
    real(8),allocatable :: dvel_h(:,:,:,:,:)
    real(8) :: max_abs,max_rel,ref,diff
    integer :: i,j,k,a,b

    if(.not.lio) return
    call compute_gradcal_gpu()
    allocate(dvel_h(0:im,0:jm,0:km,1:3,1:3))
    dvel_h = dvel_d

    max_abs = 0.d0
    max_rel = 0.d0
    do b=1,3
    do a=1,3
    do k=0,km
    do j=0,jm
    do i=0,im
      diff = abs(dvel_h(i,j,k,a,b) - dvel(i,j,k,a,b))
      ref = max(abs(dvel(i,j,k,a,b)),1.d0)
      max_abs = max(max_abs,diff)
      max_rel = max(max_rel,diff/ref)
    enddo
    enddo
    enddo
    enddo
    enddo

    open(unit=991,file='gpu_gradcal_dvel_compare.dat',status='replace',action='write')
    write(991,'(A,1X,ES24.16)') 'max_abs', max_abs
    write(991,'(A,1X,ES24.16)') 'max_rel', max_rel
    close(991)
    deallocate(dvel_h)
  end subroutine write_gradcal_dvel_compare
end module gradcal_gpu
