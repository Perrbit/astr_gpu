module compact_derivative_gpu
  use cudafor
  use constdef, only: num1d3,num1d60,num7d9,num1d36
  use compact_line_solver, only: compact_matrix
  use compact_line_solver_gpu, only: compact_line_gpu_plan,prepare_compact_gpu, &
    solve_compact_gpu,release_compact_gpu
  use gpu_check, only: sync_after_kernel
  use compact_operator, only: compact_line_partition,compact_derivative_core
  use compact_distributed_gpu
  implicit none
  private
  public :: compact_derivative_plan,prepare_compact_derivative_gpu, &
    apply_compact_derivative_gpu,release_compact_derivative_gpu

  type :: compact_derivative_plan
    integer :: dim=0,hm=0,ntype=0,first=0,last=0,capacity=0
    type(compact_line_gpu_plan) :: line
    type(compact_distributed_plan) :: global_line
    logical :: global=.false.
    real(8),allocatable,device :: input(:,:),rhs(:,:),solution(:,:)
    real(8),allocatable,device :: owned_solution(:,:)
  end type
contains
  subroutine prepare_compact_derivative_gpu(dim,hm,ntype,capacity,plan,partition,comm)
    integer,intent(in) :: dim,hm,ntype,capacity
    type(compact_derivative_plan),intent(inout) :: plan
    type(compact_line_partition),intent(in),optional :: partition
    integer,intent(in),optional :: comm
    type(compact_matrix) :: matrix
    integer :: first,last,n
    real(8) :: edge(2)

    if(dim<4.or.hm<4.or.ntype<1.or.ntype>4) error stop 'invalid local compact derivative domain'
    if(plan%capacity/=0) call release_compact_derivative_gpu(plan)
    if(present(partition)) then
      if(.not.present(comm)) error stop 'global derivative requires a line communicator'
      call compact_derivative_core(partition,matrix,edge)
      call prepare_distributed_compact_gpu(matrix,edge,partition,comm,capacity,plan%global_line)
      allocate(plan%input(-hm:dim+hm,capacity),plan%rhs(partition%owned,capacity), &
        plan%owned_solution(partition%owned,capacity),plan%solution(dim+1,capacity))
      plan%dim=dim
      plan%hm=hm
      plan%first=0
      plan%last=dim
      plan%capacity=capacity
      plan%global=.true.
      return
    endif
    first=merge(0,-1,ntype==1.or.ntype==4)
    last=merge(dim,dim+1,ntype==2.or.ntype==4)
    n=last-first+1
    matrix%n=n
    allocate(matrix%lower(n),matrix%diagonal(n),matrix%upper(n))
    matrix%diagonal=1.d0
    matrix%lower=num1d3
    matrix%upper=num1d3
    matrix%upper(1)=0.d0
    matrix%lower(n)=0.d0
    if(ntype==1.or.ntype==4) then
      matrix%upper(1)=2.d0
      matrix%lower(2)=0.25d0
      matrix%upper(2)=0.25d0
    endif
    if(ntype==2.or.ntype==4) then
      matrix%lower(n)=2.d0
      matrix%lower(n-1)=0.25d0
      matrix%upper(n-1)=0.25d0
    endif
    matrix%lower(1)=0.d0
    matrix%upper(n)=0.d0
    call prepare_compact_gpu(matrix,128,capacity,plan%line)
    allocate(plan%input(-hm:dim+hm,capacity),plan%rhs(n,capacity),plan%solution(n,capacity))
    plan%dim=dim
    plan%hm=hm
    plan%ntype=ntype
    plan%first=first
    plan%last=last
    plan%capacity=capacity
  end subroutine

  attributes(global) subroutine global_derivative_rhs_kernel(dim,hm,n,nrhs,first,total,periodic,f,rhs)
    integer,value :: dim,hm,n,nrhs,first,total
    logical,value :: periodic
    real(8),device,intent(in) :: f(-hm:dim+hm,nrhs)
    real(8),device,intent(out) :: rhs(n,nrhs)
    integer :: row,column,j,g
    row=(blockIdx%x-1)*blockDim%x+threadIdx%x
    column=blockIdx%y
    if(row>n) return
    j=row-1
    g=first+j
    if(.not.periodic.and.g==0) then
      rhs(row,column)=2.d0*(f(j+1,column)-f(j,column))+0.5d0*(f(j+2,column)-f(j,column))
    elseif(.not.periodic.and.g==total) then
      rhs(row,column)=2.d0*(f(j,column)-f(j-1,column))+0.5d0*(f(j,column)-f(j-2,column))
    elseif(.not.periodic.and.(g==1.or.g==total-1)) then
      rhs(row,column)=0.75d0*(f(j+1,column)-f(j-1,column))
    else
      rhs(row,column)=num7d9*(f(j+1,column)-f(j-1,column))+num1d36*(f(j+2,column)-f(j-2,column))
    endif
  end subroutine

  attributes(global) subroutine compact_derivative_rhs_kernel(dim,hm,first,last,ntype,nrhs,f,rhs)
    integer,value :: dim,hm,first,last,ntype,nrhs
    real(8),device,intent(in) :: f(-hm:dim+hm,nrhs)
    real(8),device,intent(out) :: rhs(last-first+1,nrhs)
    integer :: row,column,j
    real(8) :: value
    row=(blockIdx%x-1)*blockDim%x+threadIdx%x
    column=blockIdx%y
    if(row>last-first+1) return
    j=first+row-1
    if((ntype==1.or.ntype==4).and.j==first) then
      value=-2.5d0*f(j,column)+2.d0*f(j+1,column)+0.5d0*f(j+2,column)
    elseif((ntype==2.or.ntype==4).and.j==last) then
      value=2.5d0*f(j,column)-2.d0*f(j-1,column)-0.5d0*f(j-2,column)
    elseif(((ntype==1.or.ntype==4).and.j==first+1).or. &
           ((ntype==2.or.ntype==4).and.j==last-1)) then
      value=0.75d0*(f(j+1,column)-f(j-1,column))
    elseif(j==first.or.j==last) then
      value=0.75d0*(f(j+1,column)-f(j-1,column))- &
        0.15d0*(f(j+2,column)-f(j-2,column))+num1d60*(f(j+3,column)-f(j-3,column))
    else
      value=num7d9*(f(j+1,column)-f(j-1,column))+num1d36*(f(j+2,column)-f(j-2,column))
    endif
    rhs(row,column)=value
  end subroutine

  subroutine apply_compact_derivative_gpu(plan,nrhs)
    type(compact_derivative_plan),intent(inout) :: plan
    integer,intent(in) :: nrhs
    if(nrhs<1.or.nrhs>plan%capacity) error stop 'compact derivative batch exceeds prepared capacity'
    if(plan%global) then
      call global_derivative_rhs_kernel<<<dim3((plan%global_line%n+127)/128,nrhs,1),128>>>( &
        plan%dim,plan%hm,plan%global_line%n,nrhs,plan%global_line%partition%first, &
        plan%global_line%partition%intervals,plan%global_line%partition%periodic,plan%input,plan%rhs)
      call sync_after_kernel('global compact derivative RHS',force_sync=.true.)
      call solve_distributed_compact_gpu(plan%global_line,plan%rhs,plan%owned_solution,nrhs)
      call restore_compact_line_nodes_gpu(plan%global_line,plan%owned_solution,plan%solution,nrhs)
      return
    endif
    call compact_derivative_rhs_kernel<<<dim3((plan%line%n+127)/128,nrhs,1),dim3(128,1,1)>>>( &
      plan%dim,plan%hm,plan%first,plan%last,plan%ntype,nrhs,plan%input,plan%rhs)
    call sync_after_kernel('compact_derivative_rhs_kernel',force_sync=.true.)
    call solve_compact_gpu(plan%line,plan%rhs,plan%solution,nrhs)
  end subroutine

  subroutine release_compact_derivative_gpu(plan)
    type(compact_derivative_plan),intent(inout) :: plan
    if(allocated(plan%input)) deallocate(plan%input,plan%rhs,plan%solution)
    if(allocated(plan%owned_solution)) deallocate(plan%owned_solution)
    if(plan%global) call release_distributed_compact_gpu(plan%global_line)
    call release_compact_gpu(plan%line)
    plan%capacity=0
    plan%global=.false.
  end subroutine
end module
