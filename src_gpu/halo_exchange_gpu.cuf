    k = mod(id/(im+1),km+1)
    m = id/((im+1)*(km+1)) + 1

    do h=1,hm
      field(i,-h,k,m) = field(i,jm-h,k,m)
      field(i,jm+h,k,m) = field(i,h,k,m)
    enddo
  end subroutine field_qswap_y_kernel

  attributes(global) subroutine field_qswap_z_kernel(field,im,jm,km,hm,nvar)
