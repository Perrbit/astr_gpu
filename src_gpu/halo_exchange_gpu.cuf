    ncou = hm * (im + 1) * (jm + 1) * nvar
    call mpi_sendrecv(field_send_back_h(:,:,:,1:nvar),ncou,mpi_real8,mpiback, tag_z_first, &
                      field_recv_front_h(:,:,:,1:nvar),ncou,mpi_real8,mpifront,tag_z_first, &
