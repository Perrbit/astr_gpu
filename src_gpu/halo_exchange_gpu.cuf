module halo_exchange_gpu
  use cudafor
  use halo_transport_gpu, only: exchange_host_pair,independent_host_pair_work, &
       halo_pipeline_enabled,begin_host_pair_pipeline,begin_host_pair_device_pack, &
       start_host_pair_mpi,complete_host_pair_mpi,complete_host_pair_d2h, &
       begin_host_pair_device_upload,finish_host_pair_pipeline, &
       check_pipeline_cuda,configure_pipeline_axes,halo_axis_x,halo_axis_y,halo_axis_z
  use halo_transport_gpu, only: device_aware_transport_enabled
  use device_mpi_transport_gpu, only: exchange_device_pair
  implicit none

  integer,parameter :: tag_x_first = 21001
  integer,parameter :: tag_x_second = 21002
  integer,parameter :: tag_y_first = 21003
  integer,parameter :: tag_y_second = 21004
  integer,parameter :: tag_z_first = 21005
  integer,parameter :: tag_z_second = 21006
  integer,parameter :: max_field_vars = 9

  real(8),allocatable,device :: x_send_left_d(:,:,:,:),x_send_right_d(:,:,:,:)
  real(8),allocatable,device :: x_recv_right_d(:,:,:,:),x_recv_left_d(:,:,:,:)
  real(8),allocatable,target :: x_send_left_h(:,:,:,:),x_send_right_h(:,:,:,:)
  real(8),allocatable,target :: x_recv_right_h(:,:,:,:),x_recv_left_h(:,:,:,:)
  real(8),allocatable,device :: x_halo_send_left_d(:,:,:,:),x_halo_send_right_d(:,:,:,:)
  real(8),allocatable,device :: x_halo_recv_right_d(:,:,:,:),x_halo_recv_left_d(:,:,:,:)
  real(8),allocatable,target :: x_halo_send_left_h(:,:,:,:),x_halo_send_right_h(:,:,:,:)
  real(8),allocatable,target :: x_halo_recv_right_h(:,:,:,:),x_halo_recv_left_h(:,:,:,:)
  real(8),allocatable,device :: y_send_down_d(:,:,:,:),y_send_up_d(:,:,:,:)
  real(8),allocatable,device :: y_recv_up_d(:,:,:,:),y_recv_down_d(:,:,:,:)
  real(8),allocatable,target :: y_send_down_h(:,:,:,:),y_send_up_h(:,:,:,:)
  real(8),allocatable,target :: y_recv_up_h(:,:,:,:),y_recv_down_h(:,:,:,:)
  real(8),allocatable,device :: y_halo_send_down_d(:,:,:,:),y_halo_send_up_d(:,:,:,:)
  real(8),allocatable,device :: y_halo_recv_up_d(:,:,:,:),y_halo_recv_down_d(:,:,:,:)
  real(8),allocatable,target :: y_halo_send_down_h(:,:,:,:),y_halo_send_up_h(:,:,:,:)
  real(8),allocatable,target :: y_halo_recv_up_h(:,:,:,:),y_halo_recv_down_h(:,:,:,:)
  real(8),allocatable,device :: z_send_back_d(:,:,:,:),z_send_front_d(:,:,:,:)
  real(8),allocatable,device :: z_recv_front_d(:,:,:,:),z_recv_back_d(:,:,:,:)
  real(8),allocatable,target :: z_send_back_h(:,:,:,:),z_send_front_h(:,:,:,:)
  real(8),allocatable,target :: z_recv_front_h(:,:,:,:),z_recv_back_h(:,:,:,:)
  real(8),allocatable,device :: z_halo_send_back_d(:,:,:,:),z_halo_send_front_d(:,:,:,:)
  real(8),allocatable,device :: z_halo_recv_front_d(:,:,:,:),z_halo_recv_back_d(:,:,:,:)
  real(8),allocatable,target :: z_halo_send_back_h(:,:,:,:),z_halo_send_front_h(:,:,:,:)
  real(8),allocatable,target :: z_halo_recv_front_h(:,:,:,:),z_halo_recv_back_h(:,:,:,:)
  real(8),allocatable,device :: field_send_left_d(:,:,:,:),field_send_right_d(:,:,:,:)
  real(8),allocatable,device :: field_recv_right_d(:,:,:,:),field_recv_left_d(:,:,:,:)
  real(8),allocatable,target :: field_send_left_h(:,:,:,:),field_send_right_h(:,:,:,:)
  real(8),allocatable,target :: field_recv_right_h(:,:,:,:),field_recv_left_h(:,:,:,:)
  real(8),allocatable,device :: field_send_down_d(:,:,:,:),field_send_up_d(:,:,:,:)
  real(8),allocatable,device :: field_recv_up_d(:,:,:,:),field_recv_down_d(:,:,:,:)
  real(8),allocatable,target :: field_send_down_h(:,:,:,:),field_send_up_h(:,:,:,:)
  real(8),allocatable,target :: field_recv_up_h(:,:,:,:),field_recv_down_h(:,:,:,:)
  real(8),allocatable,device :: field_send_back_d(:,:,:,:),field_send_front_d(:,:,:,:)
  real(8),allocatable,device :: field_recv_front_d(:,:,:,:),field_recv_back_d(:,:,:,:)
  real(8),allocatable,target :: field_send_back_h(:,:,:,:),field_send_front_h(:,:,:,:)
  real(8),allocatable,target :: field_recv_front_h(:,:,:,:),field_recv_back_h(:,:,:,:)
  logical,save :: viscous_flux_sp_halo_reported=.false.
  logical,save :: solution_pipeline_active=.false.
  logical,save :: solution_pipeline_preserve_primitives=.false.
  integer,save :: solution_pipeline_axis=0
  logical,save :: x_solution_pipeline_d2h_staged=.false.
  logical,save :: y_solution_pipeline_d2h_staged=.false.
  logical,save :: z_solution_pipeline_d2h_staged=.false.
  logical,save :: x_solution_pipeline_mpi_started=.false.
  logical,save :: y_solution_pipeline_mpi_started=.false.
  logical,save :: z_solution_pipeline_mpi_started=.false.
  logical,save :: x_filter_pipeline_d2h_staged=.false.
  logical,save :: y_filter_pipeline_d2h_staged=.false.
  logical,save :: z_filter_pipeline_d2h_staged=.false.
  integer(kind=cuda_stream_kind),save :: x_solution_pipeline_stream=0_cuda_stream_kind
  integer(kind=cuda_stream_kind),save :: y_solution_pipeline_stream=0_cuda_stream_kind
  integer(kind=cuda_stream_kind),save :: z_solution_pipeline_stream=0_cuda_stream_kind
  integer(kind=cuda_stream_kind),save :: x_filter_pipeline_stream=0_cuda_stream_kind
  integer(kind=cuda_stream_kind),save :: y_filter_pipeline_stream=0_cuda_stream_kind
  integer(kind=cuda_stream_kind),save :: z_filter_pipeline_stream=0_cuda_stream_kind
contains
  subroutine release_halo_exchange_buffers_gpu()
