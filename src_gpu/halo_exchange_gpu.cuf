    n3=km+1
    id=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    if(id>=n1*n2*n3*nvar) return

    i=mod(id,n1)
    h=mod(id/n1,n2)
    k=mod(id/(n1*n2),n3)
    m=id/(n1*n2*n3)+1
    sendbuf(i,h,k,m)=real(field(i,h+1,k,m),8)
  end subroutine pack_field_sp_y_down_kernel

  attributes(global) subroutine pack_field_sp_y_up_kernel(field,sendbuf,im,jm,km,hm,nvar)
    implicit none
    integer,value :: im,jm,km,hm,nvar
    real(4),device :: field(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:nvar)
    real(8),device :: sendbuf(0:im,0:hm-1,0:km,1:nvar)
    integer :: id,i,h,k,m,n1,n2,n3

    n1=im+1
    n2=hm
    n3=km+1
    id=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    if(id>=n1*n2*n3*nvar) return

    i=mod(id,n1)
    h=mod(id/n1,n2)
    k=mod(id/(n1*n2),n3)
    m=id/(n1*n2*n3)+1
    sendbuf(i,h,k,m)=real(field(i,jm-hm+h,k,m),8)
  end subroutine pack_field_sp_y_up_kernel

  attributes(global) subroutine unpack_field_sp_y_kernel(field,recv_up,recv_down, &
                                                          im,jm,km,hm,nvar,has_up,has_down)
    implicit none
    integer,value :: im,jm,km,hm,nvar,has_up,has_down
    real(4),device :: field(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:nvar)
    real(8),device :: recv_up(0:im,0:hm-1,0:km,1:nvar)
    real(8),device :: recv_down(0:im,0:hm-1,0:km,1:nvar)
    integer :: id,i,h,k,m,nplane

    nplane=(im+1)*(km+1)*nvar
    id=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    if(id>=nplane) return

    i=mod(id,im+1)
    k=mod(id/(im+1),km+1)
    m=id/((im+1)*(km+1))+1
    do h=0,hm-1
      if(has_up/=0) field(i,jm+1+h,k,m)=real(recv_up(i,h,k,m),4)
      if(has_down/=0) field(i,-hm+h,k,m)=real(recv_down(i,h,k,m),4)
    enddo
  end subroutine unpack_field_sp_y_kernel

  attributes(global) subroutine pack_field_sp_z_back_kernel(field,sendbuf,im,jm,km,hm,nvar)
    implicit none
    integer,value :: im,jm,km,hm,nvar
    real(4),device :: field(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:nvar)
    real(8),device :: sendbuf(0:im,0:jm,0:hm-1,1:nvar)
    integer :: id,i,j,h,m,n1,n2,n3

    n1=im+1
    n2=jm+1
    n3=hm
    id=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    if(id>=n1*n2*n3*nvar) return

    i=mod(id,n1)
    j=mod(id/n1,n2)
    h=mod(id/(n1*n2),n3)
    m=id/(n1*n2*n3)+1
    sendbuf(i,j,h,m)=real(field(i,j,h+1,m),8)
  end subroutine pack_field_sp_z_back_kernel

  attributes(global) subroutine pack_field_sp_z_front_kernel(field,sendbuf,im,jm,km,hm,nvar)
    implicit none
    integer,value :: im,jm,km,hm,nvar
    real(4),device :: field(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:nvar)
    real(8),device :: sendbuf(0:im,0:jm,0:hm-1,1:nvar)
    integer :: id,i,j,h,m,n1,n2,n3

    n1=im+1
    n2=jm+1
    n3=hm
    id=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    if(id>=n1*n2*n3*nvar) return

    i=mod(id,n1)
    j=mod(id/n1,n2)
    h=mod(id/(n1*n2),n3)
    m=id/(n1*n2*n3)+1
    sendbuf(i,j,h,m)=real(field(i,j,km-hm+h,m),8)
  end subroutine pack_field_sp_z_front_kernel

  attributes(global) subroutine unpack_field_sp_z_kernel(field,recv_front,recv_back, &
                                                          im,jm,km,hm,nvar,has_front,has_back)
    implicit none
    integer,value :: im,jm,km,hm,nvar,has_front,has_back
    real(4),device :: field(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:nvar)
    real(8),device :: recv_front(0:im,0:jm,0:hm-1,1:nvar)
    real(8),device :: recv_back(0:im,0:jm,0:hm-1,1:nvar)
    integer :: id,i,j,h,m,nplane

    nplane=(im+1)*(jm+1)*nvar
    id=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    if(id>=nplane) return

    i=mod(id,im+1)
    j=mod(id/(im+1),jm+1)
    m=id/((im+1)*(jm+1))+1
    do h=0,hm-1
      if(has_front/=0) field(i,j,km+1+h,m)=real(recv_front(i,j,h,m),4)
      if(has_back/=0) field(i,j,-hm+h,m)=real(recv_back(i,j,h,m),4)
    enddo
  end subroutine unpack_field_sp_z_kernel

  attributes(global) subroutine field_sp_qswap_x_kernel(field,im,jm,km,hm,nvar)
    implicit none
    integer,value :: im,jm,km,hm,nvar
    real(4),device :: field(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:nvar)
    integer :: id,j,k,m,h,nplane

    id=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    nplane=(jm+1)*(km+1)*nvar
    if(id>=nplane) return
    j=mod(id,jm+1)
    k=mod(id/(jm+1),km+1)
    m=id/((jm+1)*(km+1))+1
    do h=1,hm
      field(-h,j,k,m)=field(im-h,j,k,m)
      field(im+h,j,k,m)=field(h,j,k,m)
    enddo
  end subroutine field_sp_qswap_x_kernel

  attributes(global) subroutine field_sp_qswap_y_kernel(field,im,jm,km,hm,nvar)
    implicit none
    integer,value :: im,jm,km,hm,nvar
    real(4),device :: field(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:nvar)
    integer :: id,i,k,m,h,nplane

    id=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    nplane=(im+1)*(km+1)*nvar
    if(id>=nplane) return
    i=mod(id,im+1)
    k=mod(id/(im+1),km+1)
    m=id/((im+1)*(km+1))+1
    do h=1,hm
      field(i,-h,k,m)=field(i,jm-h,k,m)
      field(i,jm+h,k,m)=field(i,h,k,m)
    enddo
  end subroutine field_sp_qswap_y_kernel

  attributes(global) subroutine field_sp_qswap_z_kernel(field,im,jm,km,hm,nvar)
    implicit none
    integer,value :: im,jm,km,hm,nvar
    real(4),device :: field(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:nvar)
    integer :: id,i,j,m,h,nplane

    id=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    nplane=(im+1)*(jm+1)*nvar
    if(id>=nplane) return
    i=mod(id,im+1)
    j=mod(id/(im+1),jm+1)
    m=id/((im+1)*(jm+1))+1
    do h=1,hm
      field(i,j,-h,m)=field(i,j,km-h,m)
      field(i,j,km+h,m)=field(i,j,h,m)
    enddo
  end subroutine field_sp_qswap_z_kernel

  attributes(global) subroutine copy_q_to_qwork_y_halo_kernel(im,jm,km,hm,numq)
    use commarray_gpu, only: q_d,qwork_d
    implicit none
    integer,value :: im,jm,km,hm,numq
    integer :: id,i,k,m,h,side,nplane

    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    nplane = (im + 1) * (km + 1) * numq * 2 * hm
    if(id >= nplane) return

    i = mod(id,im+1)
    k = mod(id/(im+1),km+1)
    m = mod(id/((im+1)*(km+1)),numq) + 1
    h = mod(id/((im+1)*(km+1)*numq),hm) + 1
    side = id/((im+1)*(km+1)*numq*hm)

    if(side == 0) then
      qwork_d(i,-h,k,m) = q_d(i,-h,k,m)
    else
      qwork_d(i,jm+h,k,m) = q_d(i,jm+h,k,m)
    endif
  end subroutine copy_q_to_qwork_y_halo_kernel

  subroutine exchange_solution_halo_gpu(preserve_interior_primitives)
#ifdef ASTR_AIR5_CHEMISTRY
    use chemistry_compensation_gpu, only: compensation_gpu_axis,air5_compensated
#endif
    use commvar, only: lihomo,ljhomo,lkhomo
    use parallel, only: isize,jsize,ksize
    use boundary_gpu, only: gpu_axis_is_physical
    use qswap_gpu, only: qswap_single_rank_gpu,qswap_local_x_gpu, &
                         qswap_local_y_gpu,qswap_local_z_gpu, &
                         refresh_primitive_halo_gpu, &
                         refresh_primitive_x_periodic_boundary_gpu, &
                         refresh_primitive_y_periodic_boundary_gpu, &
                         refresh_primitive_z_periodic_boundary_gpu
    implicit none
    logical,intent(in),optional :: preserve_interior_primitives
    logical :: preserve_primitives

    preserve_primitives = .false.
    if(present(preserve_interior_primitives)) preserve_primitives = preserve_interior_primitives

    if(halo_pipeline_enabled) then
#ifdef ASTR_AIR5_CHEMISTRY
      if(air5_compensated) error stop 'AIR5 compensation requires baseline halo sequencing'
#endif
      call begin_solution_halo_pipeline_gpu(preserve_primitives)
      call finish_solution_halo_pipeline_gpu()
      return
    endif

    if(isize==1 .and. jsize==1 .and. ksize==1 .and. &
       lihomo .and. ljhomo .and. lkhomo) then
      if(preserve_primitives) then
        call qswap_local_x_gpu()
        call qswap_local_y_gpu()
        call qswap_local_z_gpu()
        call refresh_primitive_x_periodic_boundary_gpu()
        call refresh_primitive_y_periodic_boundary_gpu()
        call refresh_primitive_z_periodic_boundary_gpu()
      else
        call qswap_single_rank_gpu()
      endif
      return
    endif

#ifdef ASTR_AIR5_CHEMISTRY
    call compensation_gpu_axis(1)
#endif
    if(isize>1) then
      call exchange_x_halo_gpu()
      if(preserve_primitives) call refresh_primitive_x_periodic_boundary_gpu()
    elseif(lihomo) then
      call qswap_local_x_gpu()
      if(preserve_primitives) call refresh_primitive_x_periodic_boundary_gpu()
    elseif(gpu_axis_is_physical(1)) then
      continue
    else
      stop 'GPU halo exchange requires x MPI or homogeneous x direction'
    endif

#ifdef ASTR_AIR5_CHEMISTRY
    call compensation_gpu_axis(2)
#endif
    if(jsize>1) then
      call exchange_y_halo_gpu()
      if(preserve_primitives) call refresh_primitive_y_periodic_boundary_gpu()
    elseif(ljhomo) then
      call qswap_local_y_gpu()
      if(preserve_primitives) call refresh_primitive_y_periodic_boundary_gpu()
    elseif(gpu_axis_is_physical(2)) then
      continue
    else
      stop 'GPU halo exchange requires y MPI or homogeneous y direction'
    endif

#ifdef ASTR_AIR5_CHEMISTRY
    call compensation_gpu_axis(3)
#endif
    if(ksize>1) then
      call exchange_z_halo_gpu()
      if(preserve_primitives) call refresh_primitive_z_periodic_boundary_gpu()
    elseif(lkhomo) then
      call qswap_local_z_gpu()
      if(preserve_primitives) call refresh_primitive_z_periodic_boundary_gpu()
    elseif(gpu_axis_is_physical(3)) then
      continue
    else
      stop 'GPU halo exchange requires z MPI or homogeneous z direction'
    endif

    if(.not.preserve_primitives) call refresh_primitive_halo_gpu()
  end subroutine exchange_solution_halo_gpu

  subroutine begin_solution_halo_pipeline_gpu(preserve_interior_primitives)
    use mpi
    use parallel, only: isize,jsize,ksize
    implicit none
    logical,intent(in),optional :: preserve_interior_primitives
    integer :: ierr

    if(.not.halo_pipeline_enabled .or. solution_pipeline_active) then
      print *, 'GPU solution halo pipeline begin requires one inactive pinned pipeline'
      call mpi_abort(MPI_COMM_WORLD,1,ierr)
      return
    endif
    solution_pipeline_preserve_primitives=.false.
    if(present(preserve_interior_primitives)) &
      solution_pipeline_preserve_primitives=preserve_interior_primitives
    solution_pipeline_active=.true.
    solution_pipeline_axis=0
    if(isize>1) then
      solution_pipeline_axis=halo_axis_x
      call begin_x_halo_pipeline_gpu()
    endif
    if(jsize>1) then
      solution_pipeline_axis=halo_axis_y
      call begin_y_halo_pipeline_gpu()
    endif
    if(ksize>1) then
      solution_pipeline_axis=halo_axis_z
      call begin_z_halo_pipeline_gpu()
    endif
    if(solution_pipeline_axis==0) then
      print *, 'GPU solution halo pipeline requires at least one active MPI axis'
      call mpi_abort(MPI_COMM_WORLD,1,ierr)
    endif
  end subroutine begin_solution_halo_pipeline_gpu

  subroutine stage_solution_halo_d2h_gpu()
    use mpi
    use parallel, only: isize,jsize,ksize
    implicit none
    integer :: ierr

    if(.not.solution_pipeline_active) then
      print *, 'GPU solution halo D2H requires an active transaction'
      call mpi_abort(MPI_COMM_WORLD,1,ierr)
      return
    endif
    if(isize>1) call stage_x_solution_halo_d2h_gpu()
    if(jsize>1) call stage_y_solution_halo_d2h_gpu()
    if(ksize>1) call stage_z_solution_halo_d2h_gpu()
  end subroutine stage_solution_halo_d2h_gpu

  subroutine start_solution_halo_mpi_gpu()
    use mpi
    use parallel, only: isize,jsize,ksize
    implicit none
    integer :: ierr

    if(.not.solution_pipeline_active) then
      print *, 'GPU solution halo MPI start requires an active transaction'
      call mpi_abort(MPI_COMM_WORLD,1,ierr)
      return
    endif
    if(isize>1 .and. .not.x_solution_pipeline_mpi_started) then
      if(.not.x_solution_pipeline_d2h_staged) call stage_x_solution_halo_d2h_gpu()
      call start_host_pair_mpi(halo_axis_x,x_send_left_h,x_send_right_h)
      x_solution_pipeline_mpi_started=.true.
    endif
    if(jsize>1 .and. .not.y_solution_pipeline_mpi_started) then
      if(.not.y_solution_pipeline_d2h_staged) call stage_y_solution_halo_d2h_gpu()
      call start_host_pair_mpi(halo_axis_y,y_send_down_h,y_send_up_h)
      y_solution_pipeline_mpi_started=.true.
    endif
    if(ksize>1 .and. .not.z_solution_pipeline_mpi_started) then
      if(.not.z_solution_pipeline_d2h_staged) call stage_z_solution_halo_d2h_gpu()
      call start_host_pair_mpi(halo_axis_z,z_send_back_h,z_send_front_h)
      z_solution_pipeline_mpi_started=.true.
    endif
  end subroutine start_solution_halo_mpi_gpu

  subroutine finish_solution_halo_pipeline_gpu()
    use mpi
    use parallel, only: isize,jsize,ksize
    use qswap_gpu, only: qswap_local_x_gpu,qswap_local_y_gpu,qswap_local_z_gpu, &
                         refresh_primitive_halo_gpu, &
                         refresh_primitive_x_periodic_boundary_gpu, &
                         refresh_primitive_y_periodic_boundary_gpu, &
                         refresh_primitive_z_periodic_boundary_gpu
    implicit none
    integer :: ierr

    if(.not.solution_pipeline_active) then
      print *, 'GPU solution halo pipeline finish requires an active transaction'
      call mpi_abort(MPI_COMM_WORLD,1,ierr)
      return
    endif
    call start_solution_halo_mpi_gpu()
    if(isize>1) then
      call finish_x_halo_pipeline_gpu()
      if(solution_pipeline_preserve_primitives) call refresh_primitive_x_periodic_boundary_gpu()
    else
      call qswap_local_x_gpu()
      if(solution_pipeline_preserve_primitives) call refresh_primitive_x_periodic_boundary_gpu()
    endif
    if(jsize>1) then
      call finish_y_halo_pipeline_gpu()
      if(solution_pipeline_preserve_primitives) call refresh_primitive_y_periodic_boundary_gpu()
    else
      call qswap_local_y_gpu()
      if(solution_pipeline_preserve_primitives) call refresh_primitive_y_periodic_boundary_gpu()
    endif
    if(ksize>1) then
      call finish_z_halo_pipeline_gpu()
      if(solution_pipeline_preserve_primitives) call refresh_primitive_z_periodic_boundary_gpu()
    else
      call qswap_local_z_gpu()
      if(solution_pipeline_preserve_primitives) call refresh_primitive_z_periodic_boundary_gpu()
    endif
    if(.not.solution_pipeline_preserve_primitives) call refresh_primitive_halo_gpu()
    solution_pipeline_preserve_primitives=.false.
    solution_pipeline_axis=0
    solution_pipeline_active=.false.
  end subroutine finish_solution_halo_pipeline_gpu

  subroutine exchange_solution_filter_halo_gpu()
    use commvar, only: im,jm,km,hm,numq,lihomo
    use gpu_check, only: sync_after_kernel
    use parallel, only: isize,jsize,ksize
    implicit none
    type(dim3) :: block,grid
    integer :: n

    if(isize>1) then
      call exchange_x_filter_halo_gpu()
    elseif(lihomo) then
      block = dim3(256,1,1)
      n = (jm + 1) * (km + 1) * numq
      grid = dim3((n + block%x - 1)/block%x,1,1)
      call q_halo_local_x_kernel<<<grid,block>>>(im,jm,km,hm,numq)
      call sync_after_kernel('q_halo_local_x_kernel')
    endif
  end subroutine exchange_solution_filter_halo_gpu

  subroutine exchange_solution_sponge_halo_gpu()
    use commvar, only: lihomo,ljhomo,lkhomo
    use parallel, only: isize,jsize,ksize
    use boundary_gpu, only: gpu_axis_is_physical
    use qswap_gpu, only: qswap_single_rank_gpu,qswap_local_x_gpu, &
                         qswap_local_y_gpu,qswap_local_z_gpu
    implicit none

    if(isize==1 .and. jsize==1 .and. ksize==1 .and. &
       lihomo .and. ljhomo .and. lkhomo) then
      call qswap_single_rank_gpu()
      return
    endif

    if(isize>1) then
      call exchange_x_halo_gpu()
    elseif(lihomo) then
      call qswap_local_x_gpu()
    elseif(.not.gpu_axis_is_physical(1)) then
      stop 'GPU sponge halo exchange requires x MPI, homogeneous, or physical direction'
    endif

    if(jsize>1) then
      call exchange_y_halo_gpu()
    elseif(ljhomo) then
      call qswap_local_y_gpu()
    elseif(.not.gpu_axis_is_physical(2)) then
      stop 'GPU sponge halo exchange requires y MPI, homogeneous, or physical direction'
    endif

    if(ksize>1) then
      call exchange_z_halo_gpu()
    elseif(lkhomo) then
      call qswap_local_z_gpu()
    elseif(.not.gpu_axis_is_physical(3)) then
      stop 'GPU sponge halo exchange requires z MPI, homogeneous, or physical direction'
    endif
  end subroutine exchange_solution_sponge_halo_gpu

  subroutine exchange_filter_y_work_halo_gpu()
    use mpi
    use commvar, only: im,jm,km,hm,numq
    use gpu_check, only: sync_after_kernel
    use parallel, only: jsize,mpidown,mpiup
    implicit none

    type(dim3) :: block,grid
    integer :: ncou,npack,nunpack

    if(jsize<=1) return

    call ensure_y_filter_buffers()

    npack = hm * (im + 1) * (km + 1) * numq
    block = dim3(256,1,1)
    grid = dim3((npack + block%x - 1)/block%x,1,1)

    call pack_qwork_y_halo_down_kernel<<<grid,block>>>(y_halo_send_down_d,im,jm,km,hm,numq)
    call sync_after_kernel('pack_qwork_y_halo_down_kernel')
    call pack_qwork_y_halo_up_kernel<<<grid,block>>>(y_halo_send_up_d,im,jm,km,hm,numq)
    call sync_after_kernel('pack_qwork_y_halo_up_kernel',.true.)

    ncou = size(y_halo_send_down_d)
    if(device_aware_transport_enabled) then
      call exchange_device_pair(y_halo_send_down_d,y_halo_send_up_d, &
                                y_halo_recv_up_d,y_halo_recv_down_d, &
                                ncou,mpidown,mpiup,tag_y_first,tag_y_second)
    else
      y_halo_send_down_h = y_halo_send_down_d
      y_halo_send_up_h = y_halo_send_up_d
      call exchange_host_pair(y_halo_send_down_h,y_halo_send_up_h, &
                              y_halo_recv_up_h,y_halo_recv_down_h, &
                              ncou,mpidown,mpiup,tag_y_first,tag_y_second)
      if(mpiup /= MPI_PROC_NULL) y_halo_recv_up_d = y_halo_recv_up_h
      if(mpidown /= MPI_PROC_NULL) y_halo_recv_down_d = y_halo_recv_down_h
    endif

    nunpack = (im + 1) * (km + 1) * numq
    grid = dim3((nunpack + block%x - 1)/block%x,1,1)
    call unpack_qwork_y_halo_kernel<<<grid,block>>>(y_halo_recv_up_d,y_halo_recv_down_d, &
                                                    im,jm,km,hm,numq, &
                                                    merge(1,0,mpiup /= MPI_PROC_NULL), &
                                                    merge(1,0,mpidown /= MPI_PROC_NULL))
    call sync_after_kernel('unpack_qwork_y_halo_kernel')
  end subroutine exchange_filter_y_work_halo_gpu

  subroutine refresh_filter_y_work_local_halo_gpu()
    use commarray_gpu, only: qwork_d
    use commvar, only: im,jm,km,hm,numq,ljhomo
    use gpu_check, only: sync_after_kernel
    use boundary_gpu, only: gpu_axis_is_physical
    implicit none

    type(dim3) :: block,grid
    integer :: n

    block = dim3(256,1,1)
    if(ljhomo) then
      n = (im + 1) * (km + 1) * numq
      grid = dim3((n + block%x - 1)/block%x,1,1)
      call field_qswap_y_kernel<<<grid,block>>>(qwork_d,im,jm,km,hm,numq)
      call sync_after_kernel('filter_qwork_local_y_halo_kernel')
    elseif(gpu_axis_is_physical(2)) then
      n = (im + 1) * (km + 1) * numq * 2 * hm
      grid = dim3((n + block%x - 1)/block%x,1,1)
      call copy_q_to_qwork_y_halo_kernel<<<grid,block>>>(im,jm,km,hm,numq)
      call sync_after_kernel('copy_q_to_qwork_y_halo_kernel')
    else
      stop 'GPU filter y local halo requires homogeneous y or y-zeroextrap direction'
    endif
  end subroutine refresh_filter_y_work_local_halo_gpu

  subroutine exchange_filter_z_halo_gpu()
    use mpi
    use commvar, only: im,jm,km,hm,numq
    use gpu_check, only: sync_after_kernel
    use parallel, only: ksize,mpiback,mpifront
    implicit none

    type(dim3) :: block,grid
    integer :: ncou,npack,nunpack

    if(ksize<=1) return

    call ensure_z_filter_buffers()

    npack = hm * (im + 1) * (jm + 1) * numq
    block = dim3(256,1,1)
    grid = dim3((npack + block%x - 1)/block%x,1,1)

    call pack_z_halo_back_kernel<<<grid,block>>>(z_halo_send_back_d,im,jm,km,hm,numq)
    call sync_after_kernel('pack_z_halo_back_kernel')
    call pack_z_halo_front_kernel<<<grid,block>>>(z_halo_send_front_d,im,jm,km,hm,numq)
    call sync_after_kernel('pack_z_halo_front_kernel',.true.)

    ncou = size(z_halo_send_back_d)
    if(device_aware_transport_enabled) then
      call exchange_device_pair(z_halo_send_back_d,z_halo_send_front_d, &
                                z_halo_recv_front_d,z_halo_recv_back_d, &
                                ncou,mpiback,mpifront,tag_z_first,tag_z_second)
    else
      z_halo_send_back_h = z_halo_send_back_d
      z_halo_send_front_h = z_halo_send_front_d
      call exchange_host_pair(z_halo_send_back_h,z_halo_send_front_h, &
                              z_halo_recv_front_h,z_halo_recv_back_h, &
                              ncou,mpiback,mpifront,tag_z_first,tag_z_second)
      if(mpifront /= MPI_PROC_NULL) z_halo_recv_front_d = z_halo_recv_front_h
      if(mpiback /= MPI_PROC_NULL) z_halo_recv_back_d = z_halo_recv_back_h
    endif

    nunpack = (im + 1) * (jm + 1) * numq
    grid = dim3((nunpack + block%x - 1)/block%x,1,1)
    call unpack_z_halo_kernel<<<grid,block>>>(z_halo_recv_front_d,z_halo_recv_back_d, &
                                              im,jm,km,hm,numq, &
                                              merge(1,0,mpifront /= MPI_PROC_NULL), &
                                              merge(1,0,mpiback /= MPI_PROC_NULL))
    call sync_after_kernel('unpack_z_halo_kernel')
  end subroutine exchange_filter_z_halo_gpu

  subroutine refresh_filter_z_local_halo_gpu()
    use commarray_gpu, only: q_d
    use commvar, only: im,jm,km,hm,numq,lkhomo
    use gpu_check, only: sync_after_kernel
    implicit none

    type(dim3) :: block,grid
    integer :: n

    if(.not.lkhomo) return

    block = dim3(256,1,1)
    n = (im + 1) * (jm + 1) * numq
    grid = dim3((n + block%x - 1)/block%x,1,1)
    call field_qswap_z_kernel<<<grid,block>>>(q_d,im,jm,km,hm,numq)
    call sync_after_kernel('filter_q_local_z_halo_kernel')
  end subroutine refresh_filter_z_local_halo_gpu

  subroutine exchange_filter_scalar_y_halo_gpu()
    use mpi
    use commvar, only: im,jm,km,hm
    use gpu_check, only: sync_after_kernel
    use parallel, only: jsize,mpidown,mpiup
    implicit none
    type(dim3) :: block,grid
    integer :: ncou,npack

    if(jsize<=1) return
    call ensure_field_y_buffers(1)
    npack=hm*(im+1)*(km+1)
    block=dim3(256,1,1)
    grid=dim3((npack+block%x-1)/block%x,1,1)
    call pack_filter_scalar_y_down_kernel<<<grid,block>>>(field_send_down_d(:,:,:,1:1),im,jm,km,hm)
    call sync_after_kernel('pack_filter_scalar_y_down_kernel')
    call pack_filter_scalar_y_up_kernel<<<grid,block>>>(field_send_up_d(:,:,:,1:1),im,jm,km,hm)
    call sync_after_kernel('pack_filter_scalar_y_up_kernel',.true.)
    ncou=npack
    if(device_aware_transport_enabled) then
      call exchange_device_pair(field_send_down_d(:,:,:,1:1),field_send_up_d(:,:,:,1:1), &
                                field_recv_up_d(:,:,:,1:1),field_recv_down_d(:,:,:,1:1), &
                                ncou,mpidown,mpiup,tag_y_first,tag_y_second)
    else
      field_send_down_h(:,:,:,1:1)=field_send_down_d(:,:,:,1:1)
      field_send_up_h(:,:,:,1:1)=field_send_up_d(:,:,:,1:1)
      call exchange_host_pair(field_send_down_h(:,:,:,1:1),field_send_up_h(:,:,:,1:1), &
                              field_recv_up_h(:,:,:,1:1),field_recv_down_h(:,:,:,1:1), &
                              ncou,mpidown,mpiup,tag_y_first,tag_y_second)
      if(mpiup/=MPI_PROC_NULL) field_recv_up_d(:,:,:,1:1)=field_recv_up_h(:,:,:,1:1)
      if(mpidown/=MPI_PROC_NULL) field_recv_down_d(:,:,:,1:1)=field_recv_down_h(:,:,:,1:1)
    endif
    call unpack_filter_scalar_y_kernel<<<grid,block>>>(field_recv_up_d(:,:,:,1:1), &
         field_recv_down_d(:,:,:,1:1),im,jm,km,hm,merge(1,0,mpiup/=MPI_PROC_NULL), &
         merge(1,0,mpidown/=MPI_PROC_NULL))
    call sync_after_kernel('unpack_filter_scalar_y_kernel')
  end subroutine exchange_filter_scalar_y_halo_gpu

  subroutine refresh_filter_scalar_y_local_halo_gpu(component)
    use commvar, only: im,jm,km,hm,ljhomo
    use gpu_check, only: sync_after_kernel
    use boundary_gpu, only: gpu_axis_is_physical
    implicit none
    integer,intent(in) :: component
    type(dim3) :: block,grid
    integer :: n

    block=dim3(256,1,1)
    if(ljhomo) then
      n=(im+1)*(km+1)
      grid=dim3((n+block%x-1)/block%x,1,1)
      call filter_scalar_qswap_y_kernel<<<grid,block>>>(im,jm,km,hm)
      call sync_after_kernel('filter_scalar_qswap_y_kernel')
    elseif(gpu_axis_is_physical(2)) then
      n=(im+1)*(km+1)*2*hm
      grid=dim3((n+block%x-1)/block%x,1,1)
      call copy_q_to_filter_scalar_y_halo_kernel<<<grid,block>>>(im,jm,km,hm,component)
      call sync_after_kernel('copy_q_to_filter_scalar_y_halo_kernel')
    else
      stop 'GPU scalar filter y halo requires homogeneous or physical y direction'
    endif
  end subroutine refresh_filter_scalar_y_local_halo_gpu

  subroutine exchange_filter_scalar_z_halo_gpu(component)
    use mpi
    use commvar, only: im,jm,km,hm
    use gpu_check, only: sync_after_kernel
    use parallel, only: ksize,mpiback,mpifront
    implicit none
    integer,intent(in) :: component
    type(dim3) :: block,grid
    integer :: ncou,npack

    if(ksize<=1) return
    call ensure_field_z_buffers(1)
    npack=hm*(im+1)*(jm+1)
    block=dim3(256,1,1)
    grid=dim3((npack+block%x-1)/block%x,1,1)
    call pack_q_component_z_back_kernel<<<grid,block>>>(field_send_back_d(:,:,:,1:1), &
                                                        im,jm,km,hm,component)
    call sync_after_kernel('pack_q_component_z_back_kernel')
    call pack_q_component_z_front_kernel<<<grid,block>>>(field_send_front_d(:,:,:,1:1), &
                                                          im,jm,km,hm,component)
    call sync_after_kernel('pack_q_component_z_front_kernel',.true.)
    ncou=npack
    if(device_aware_transport_enabled) then
      call exchange_device_pair(field_send_back_d(:,:,:,1:1),field_send_front_d(:,:,:,1:1), &
                                field_recv_front_d(:,:,:,1:1),field_recv_back_d(:,:,:,1:1), &
                                ncou,mpiback,mpifront,tag_z_first,tag_z_second)
    else
      field_send_back_h(:,:,:,1:1)=field_send_back_d(:,:,:,1:1)
      field_send_front_h(:,:,:,1:1)=field_send_front_d(:,:,:,1:1)
      call exchange_host_pair(field_send_back_h(:,:,:,1:1),field_send_front_h(:,:,:,1:1), &
                              field_recv_front_h(:,:,:,1:1),field_recv_back_h(:,:,:,1:1), &
                              ncou,mpiback,mpifront,tag_z_first,tag_z_second)
      if(mpifront/=MPI_PROC_NULL) field_recv_front_d(:,:,:,1:1)=field_recv_front_h(:,:,:,1:1)
      if(mpiback/=MPI_PROC_NULL) field_recv_back_d(:,:,:,1:1)=field_recv_back_h(:,:,:,1:1)
    endif
    call unpack_q_component_z_kernel<<<grid,block>>>(field_recv_front_d(:,:,:,1:1), &
         field_recv_back_d(:,:,:,1:1),im,jm,km,hm,component, &
         merge(1,0,mpifront/=MPI_PROC_NULL),merge(1,0,mpiback/=MPI_PROC_NULL))
    call sync_after_kernel('unpack_q_component_z_kernel')
  end subroutine exchange_filter_scalar_z_halo_gpu

  subroutine refresh_filter_scalar_z_local_halo_gpu(component)
    use commvar, only: im,jm,km,hm,lkhomo
    use gpu_check, only: sync_after_kernel
    implicit none
    integer,intent(in) :: component
    type(dim3) :: block,grid
    integer :: n

    if(.not.lkhomo) return
    block=dim3(256,1,1)
    n=(im+1)*(jm+1)
    grid=dim3((n+block%x-1)/block%x,1,1)
    call q_component_qswap_z_kernel<<<grid,block>>>(im,jm,km,hm,component)
    call sync_after_kernel('q_component_qswap_z_kernel')
  end subroutine refresh_filter_scalar_z_local_halo_gpu

  subroutine exchange_x_halo_gpu()
    use mpi
    use commvar, only: im,jm,km,hm,numq
    use gpu_check, only: sync_after_kernel
    use parallel, only: mpileft,mpiright
    implicit none

    type(dim3) :: block,grid
    integer :: ncou,npack,nunpack

    call ensure_x_buffers()

    if(halo_pipeline_enabled) then
      call exchange_x_halo_pipeline_gpu()
      return
    endif

    npack = (hm + 1) * (jm + 1) * (km + 1) * numq
    block = dim3(256,1,1)
    grid = dim3((npack + block%x - 1)/block%x,1,1)

    call pack_x_left_kernel<<<grid,block>>>(x_send_left_d,im,jm,km,hm,numq)
    call sync_after_kernel('pack_x_left_kernel')
    call pack_x_right_kernel<<<grid,block>>>(x_send_right_d,im,jm,km,hm,numq)
    call sync_after_kernel('pack_x_right_kernel',.true.)

    if(device_aware_transport_enabled) then
      ncou = size(x_send_left_d)
      call exchange_device_pair(x_send_left_d,x_send_right_d,x_recv_right_d,x_recv_left_d, &
                                ncou,mpileft,mpiright,tag_x_first,tag_x_second)
    else
      x_send_left_h = x_send_left_d
      x_send_right_h = x_send_right_d
      ncou = size(x_send_left_h)
      call exchange_host_pair(x_send_left_h,x_send_right_h, &
                              x_recv_right_h,x_recv_left_h, &
                              ncou,mpileft,mpiright,tag_x_first,tag_x_second)
      if(mpiright /= MPI_PROC_NULL) x_recv_right_d = x_recv_right_h
      if(mpileft /= MPI_PROC_NULL) x_recv_left_d = x_recv_left_h
    endif

    nunpack = (jm + 1) * (km + 1) * numq
    grid = dim3((nunpack + block%x - 1)/block%x,1,1)
    call unpack_x_kernel<<<grid,block>>>(x_recv_right_d,x_recv_left_d,im,jm,km,hm,numq, &
                                         merge(1,0,mpiright /= MPI_PROC_NULL), &
                                         merge(1,0,mpileft /= MPI_PROC_NULL))
    call sync_after_kernel('unpack_x_kernel')
  end subroutine exchange_x_halo_gpu

  subroutine exchange_x_halo_pipeline_gpu()
    implicit none

    call begin_x_halo_pipeline_gpu()
    call finish_x_halo_pipeline_gpu()
  end subroutine exchange_x_halo_pipeline_gpu

  subroutine begin_x_halo_pipeline_gpu()
    use mpi
    use commvar, only: im,jm,km,hm,numq
    use gpu_check, only: check_kernel_launch
    use parallel, only: mpileft,mpiright
    implicit none

    type(dim3) :: block,grid
    integer :: ncou,npack

    call ensure_x_buffers()

    npack=(hm+1)*(jm+1)*(km+1)*numq
    ncou=size(x_send_left_h)
    block=dim3(256,1,1)
    grid=dim3((npack+block%x-1)/block%x,1,1)

    call begin_host_pair_pipeline(halo_axis_x,x_recv_right_h,x_recv_left_h,ncou, &
                                  mpileft,mpiright,tag_x_first,tag_x_second)
    call begin_host_pair_device_pack(halo_axis_x,x_solution_pipeline_stream)
    call pack_x_left_kernel<<<grid,block,0,x_solution_pipeline_stream>>>(x_send_left_d,im,jm,km,hm,numq)
    call check_kernel_launch('pipeline_pack_x_left_kernel')
    call pack_x_right_kernel<<<grid,block,0,x_solution_pipeline_stream>>>(x_send_right_d,im,jm,km,hm,numq)
    call check_kernel_launch('pipeline_pack_x_right_kernel')
    x_solution_pipeline_d2h_staged=.false.
    x_solution_pipeline_mpi_started=.false.
  end subroutine begin_x_halo_pipeline_gpu

  subroutine stage_x_solution_halo_d2h_gpu()
    use mpi
    implicit none
    integer :: ncou,code,ierr

    if(x_solution_pipeline_d2h_staged) then
      print *, 'GPU x solution halo D2H was staged more than once'
      call mpi_abort(MPI_COMM_WORLD,1,ierr)
      return
    endif
    ncou=size(x_send_left_h)
    code=cudaMemcpyAsync(x_send_left_h,x_send_left_d,ncou,cudaMemcpyDeviceToHost, &
                         x_solution_pipeline_stream)
    call check_pipeline_cuda('x solution left D2H',code)
    code=cudaMemcpyAsync(x_send_right_h,x_send_right_d,ncou,cudaMemcpyDeviceToHost, &
                         x_solution_pipeline_stream)
    call check_pipeline_cuda('x solution right D2H',code)
    x_solution_pipeline_d2h_staged=.true.
  end subroutine stage_x_solution_halo_d2h_gpu

  subroutine finish_x_halo_pipeline_gpu()
    use mpi
    use commvar, only: im,jm,km,hm,numq
    use gpu_check, only: check_kernel_launch
    use parallel, only: mpileft,mpiright
    implicit none

    type(dim3) :: block,grid
    integer(kind=cuda_stream_kind) :: pipeline_stream
    integer :: ncou,nunpack,code

    ncou=size(x_send_left_h)
    block=dim3(256,1,1)
    if(.not.x_solution_pipeline_d2h_staged) call stage_x_solution_halo_d2h_gpu()
    if(.not.x_solution_pipeline_mpi_started) then
      call start_host_pair_mpi(halo_axis_x,x_send_left_h,x_send_right_h)
      x_solution_pipeline_mpi_started=.true.
    endif
    call complete_host_pair_mpi(halo_axis_x)

    call begin_host_pair_device_upload(halo_axis_x,pipeline_stream)
    if(mpiright/=MPI_PROC_NULL) then
      code=cudaMemcpyAsync(x_recv_right_d,x_recv_right_h,ncou,cudaMemcpyHostToDevice,pipeline_stream)
      call check_pipeline_cuda('x solution right H2D',code)
    endif
    if(mpileft/=MPI_PROC_NULL) then
      code=cudaMemcpyAsync(x_recv_left_d,x_recv_left_h,ncou,cudaMemcpyHostToDevice,pipeline_stream)
      call check_pipeline_cuda('x solution left H2D',code)
    endif
    nunpack=(jm+1)*(km+1)*numq
    grid=dim3((nunpack+block%x-1)/block%x,1,1)
    call unpack_x_kernel<<<grid,block,0,pipeline_stream>>>( &
         x_recv_right_d,x_recv_left_d,im,jm,km,hm,numq, &
         merge(1,0,mpiright/=MPI_PROC_NULL),merge(1,0,mpileft/=MPI_PROC_NULL))
    call check_kernel_launch('pipeline_unpack_x_kernel')
    call finish_host_pair_pipeline(halo_axis_x)
    x_solution_pipeline_d2h_staged=.false.
    x_solution_pipeline_mpi_started=.false.
    x_solution_pipeline_stream=0_cuda_stream_kind
  end subroutine finish_x_halo_pipeline_gpu

  subroutine begin_y_halo_pipeline_gpu()
    use commvar, only: im,jm,km,hm,numq
    use gpu_check, only: check_kernel_launch
    use parallel, only: mpidown,mpiup
    implicit none
    type(dim3) :: block,grid
    integer :: ncou,npack

    call ensure_y_buffers()
    npack=(hm+1)*(im+1)*(km+1)*numq
    ncou=size(y_send_down_h)
    block=dim3(256,1,1)
    grid=dim3((npack+block%x-1)/block%x,1,1)
    call begin_host_pair_pipeline(halo_axis_y,y_recv_up_h,y_recv_down_h,ncou, &
                                  mpidown,mpiup,tag_y_first,tag_y_second)
    call begin_host_pair_device_pack(halo_axis_y,y_solution_pipeline_stream)
    call pack_y_down_kernel<<<grid,block,0,y_solution_pipeline_stream>>>( &
         y_send_down_d,im,jm,km,hm,numq)
    call check_kernel_launch('pipeline_pack_y_down_kernel')
    call pack_y_up_kernel<<<grid,block,0,y_solution_pipeline_stream>>>( &
         y_send_up_d,im,jm,km,hm,numq)
    call check_kernel_launch('pipeline_pack_y_up_kernel')
    y_solution_pipeline_d2h_staged=.false.
    y_solution_pipeline_mpi_started=.false.
  end subroutine begin_y_halo_pipeline_gpu

  subroutine stage_y_solution_halo_d2h_gpu()
    use mpi
    implicit none
    integer :: ncou,code,ierr

    if(y_solution_pipeline_d2h_staged) then
      print *, 'GPU y solution halo D2H was staged more than once'
      call mpi_abort(MPI_COMM_WORLD,1,ierr)
      return
    endif
    ncou=size(y_send_down_h)
    code=cudaMemcpyAsync(y_send_down_h,y_send_down_d,ncou,cudaMemcpyDeviceToHost, &
                         y_solution_pipeline_stream)
    call check_pipeline_cuda('y solution down D2H',code)
    code=cudaMemcpyAsync(y_send_up_h,y_send_up_d,ncou,cudaMemcpyDeviceToHost, &
                         y_solution_pipeline_stream)
    call check_pipeline_cuda('y solution up D2H',code)
    y_solution_pipeline_d2h_staged=.true.
  end subroutine stage_y_solution_halo_d2h_gpu

  subroutine finish_y_halo_pipeline_gpu()
    use mpi
    use commvar, only: im,jm,km,hm,numq
    use gpu_check, only: check_kernel_launch
    use parallel, only: mpidown,mpiup
    implicit none
    type(dim3) :: block,grid
    integer(kind=cuda_stream_kind) :: pipeline_stream
    integer :: ncou,nunpack,code

    ncou=size(y_send_down_h)
    block=dim3(256,1,1)
    if(.not.y_solution_pipeline_d2h_staged) call stage_y_solution_halo_d2h_gpu()
    if(.not.y_solution_pipeline_mpi_started) then
      call start_host_pair_mpi(halo_axis_y,y_send_down_h,y_send_up_h)
      y_solution_pipeline_mpi_started=.true.
    endif
    call complete_host_pair_mpi(halo_axis_y)
    call begin_host_pair_device_upload(halo_axis_y,pipeline_stream)
    if(mpiup/=MPI_PROC_NULL) then
      code=cudaMemcpyAsync(y_recv_up_d,y_recv_up_h,ncou,cudaMemcpyHostToDevice,pipeline_stream)
      call check_pipeline_cuda('y solution up H2D',code)
    endif
    if(mpidown/=MPI_PROC_NULL) then
      code=cudaMemcpyAsync(y_recv_down_d,y_recv_down_h,ncou,cudaMemcpyHostToDevice,pipeline_stream)
      call check_pipeline_cuda('y solution down H2D',code)
    endif
    nunpack=(im+1)*(km+1)*numq
    grid=dim3((nunpack+block%x-1)/block%x,1,1)
    call unpack_y_kernel<<<grid,block,0,pipeline_stream>>>( &
         y_recv_up_d,y_recv_down_d,im,jm,km,hm,numq, &
         merge(1,0,mpiup/=MPI_PROC_NULL),merge(1,0,mpidown/=MPI_PROC_NULL))
    call check_kernel_launch('pipeline_unpack_y_kernel')
    call finish_host_pair_pipeline(halo_axis_y)
    y_solution_pipeline_d2h_staged=.false.
    y_solution_pipeline_mpi_started=.false.
    y_solution_pipeline_stream=0_cuda_stream_kind
  end subroutine finish_y_halo_pipeline_gpu

  subroutine begin_z_halo_pipeline_gpu()
    use commvar, only: im,jm,km,hm,numq
    use gpu_check, only: check_kernel_launch
    use parallel, only: mpiback,mpifront
    implicit none
    type(dim3) :: block,grid
    integer :: ncou,npack

    call ensure_z_buffers()
    npack=(hm+1)*(im+1)*(jm+1)*numq
    ncou=size(z_send_back_h)
    block=dim3(256,1,1)
    grid=dim3((npack+block%x-1)/block%x,1,1)
    call begin_host_pair_pipeline(halo_axis_z,z_recv_front_h,z_recv_back_h,ncou, &
                                  mpiback,mpifront,tag_z_first,tag_z_second)
    call begin_host_pair_device_pack(halo_axis_z,z_solution_pipeline_stream)
    call pack_z_back_kernel<<<grid,block,0,z_solution_pipeline_stream>>>( &
         z_send_back_d,im,jm,km,hm,numq)
    call check_kernel_launch('pipeline_pack_z_back_kernel')
    call pack_z_front_kernel<<<grid,block,0,z_solution_pipeline_stream>>>( &
         z_send_front_d,im,jm,km,hm,numq)
    call check_kernel_launch('pipeline_pack_z_front_kernel')
    z_solution_pipeline_d2h_staged=.false.
    z_solution_pipeline_mpi_started=.false.
  end subroutine begin_z_halo_pipeline_gpu

  subroutine stage_z_solution_halo_d2h_gpu()
    use mpi
    implicit none
    integer :: ncou,code,ierr

    if(z_solution_pipeline_d2h_staged) then
      print *, 'GPU z solution halo D2H was staged more than once'
      call mpi_abort(MPI_COMM_WORLD,1,ierr)
      return
    endif
    ncou=size(z_send_back_h)
    code=cudaMemcpyAsync(z_send_back_h,z_send_back_d,ncou,cudaMemcpyDeviceToHost, &
                         z_solution_pipeline_stream)
    call check_pipeline_cuda('z solution back D2H',code)
    code=cudaMemcpyAsync(z_send_front_h,z_send_front_d,ncou,cudaMemcpyDeviceToHost, &
                         z_solution_pipeline_stream)
    call check_pipeline_cuda('z solution front D2H',code)
    z_solution_pipeline_d2h_staged=.true.
  end subroutine stage_z_solution_halo_d2h_gpu

  subroutine finish_z_halo_pipeline_gpu()
    use mpi
    use commvar, only: im,jm,km,hm,numq
    use gpu_check, only: check_kernel_launch
    use parallel, only: mpiback,mpifront
    implicit none
    type(dim3) :: block,grid
    integer(kind=cuda_stream_kind) :: pipeline_stream
    integer :: ncou,nunpack,code

    ncou=size(z_send_back_h)
    block=dim3(256,1,1)
    if(.not.z_solution_pipeline_d2h_staged) call stage_z_solution_halo_d2h_gpu()
    if(.not.z_solution_pipeline_mpi_started) then
      call start_host_pair_mpi(halo_axis_z,z_send_back_h,z_send_front_h)
      z_solution_pipeline_mpi_started=.true.
    endif
    call complete_host_pair_mpi(halo_axis_z)
    call begin_host_pair_device_upload(halo_axis_z,pipeline_stream)
    if(mpifront/=MPI_PROC_NULL) then
      code=cudaMemcpyAsync(z_recv_front_d,z_recv_front_h,ncou,cudaMemcpyHostToDevice,pipeline_stream)
      call check_pipeline_cuda('z solution front H2D',code)
    endif
    if(mpiback/=MPI_PROC_NULL) then
      code=cudaMemcpyAsync(z_recv_back_d,z_recv_back_h,ncou,cudaMemcpyHostToDevice,pipeline_stream)
      call check_pipeline_cuda('z solution back H2D',code)
    endif
    nunpack=(im+1)*(jm+1)*numq
    grid=dim3((nunpack+block%x-1)/block%x,1,1)
    call unpack_z_kernel<<<grid,block,0,pipeline_stream>>>( &
         z_recv_front_d,z_recv_back_d,im,jm,km,hm,numq, &
         merge(1,0,mpifront/=MPI_PROC_NULL),merge(1,0,mpiback/=MPI_PROC_NULL))
    call check_kernel_launch('pipeline_unpack_z_kernel')
    call finish_host_pair_pipeline(halo_axis_z)
    z_solution_pipeline_d2h_staged=.false.
    z_solution_pipeline_mpi_started=.false.
    z_solution_pipeline_stream=0_cuda_stream_kind
  end subroutine finish_z_halo_pipeline_gpu

  subroutine exchange_y_halo_gpu()
    use mpi
    use commvar, only: im,jm,km,hm,numq
    use gpu_check, only: sync_after_kernel
    use parallel, only: mpidown,mpiup
    implicit none

    type(dim3) :: block,grid
    integer :: ncou,npack,nunpack

    call ensure_y_buffers()

    if(halo_pipeline_enabled) then
      call begin_y_halo_pipeline_gpu()
      call finish_y_halo_pipeline_gpu()
      return
    endif

    npack = (hm + 1) * (im + 1) * (km + 1) * numq
    block = dim3(256,1,1)
    grid = dim3((npack + block%x - 1)/block%x,1,1)

    call pack_y_down_kernel<<<grid,block>>>(y_send_down_d,im,jm,km,hm,numq)
    call sync_after_kernel('pack_y_down_kernel')
    call pack_y_up_kernel<<<grid,block>>>(y_send_up_d,im,jm,km,hm,numq)
    call sync_after_kernel('pack_y_up_kernel',.true.)

    if(device_aware_transport_enabled) then
      ncou = size(y_send_down_d)
      call exchange_device_pair(y_send_down_d,y_send_up_d,y_recv_up_d,y_recv_down_d, &
                                ncou,mpidown,mpiup,tag_y_first,tag_y_second)
    else
      y_send_down_h = y_send_down_d
      y_send_up_h = y_send_up_d
      ncou = size(y_send_down_h)
      call exchange_host_pair(y_send_down_h,y_send_up_h, &
                              y_recv_up_h,y_recv_down_h, &
                              ncou,mpidown,mpiup,tag_y_first,tag_y_second)
      if(mpiup /= MPI_PROC_NULL) y_recv_up_d = y_recv_up_h
      if(mpidown /= MPI_PROC_NULL) y_recv_down_d = y_recv_down_h
    endif

    nunpack = (im + 1) * (km + 1) * numq
    grid = dim3((nunpack + block%x - 1)/block%x,1,1)
    call unpack_y_kernel<<<grid,block>>>(y_recv_up_d,y_recv_down_d,im,jm,km,hm,numq, &
                                         merge(1,0,mpiup /= MPI_PROC_NULL), &
                                         merge(1,0,mpidown /= MPI_PROC_NULL))
    call sync_after_kernel('unpack_y_kernel')
  end subroutine exchange_y_halo_gpu

  subroutine exchange_z_halo_gpu()
    use mpi
    use commvar, only: im,jm,km,hm,numq
    use gpu_check, only: sync_after_kernel
    use parallel, only: mpiback,mpifront
    implicit none

    type(dim3) :: block,grid
    integer :: ncou,npack,nunpack

    call ensure_z_buffers()

    if(halo_pipeline_enabled) then
      call begin_z_halo_pipeline_gpu()
      call finish_z_halo_pipeline_gpu()
      return
    endif

    npack = (hm + 1) * (im + 1) * (jm + 1) * numq
    block = dim3(256,1,1)
    grid = dim3((npack + block%x - 1)/block%x,1,1)

    call pack_z_back_kernel<<<grid,block>>>(z_send_back_d,im,jm,km,hm,numq)
    call sync_after_kernel('pack_z_back_kernel')
    call pack_z_front_kernel<<<grid,block>>>(z_send_front_d,im,jm,km,hm,numq)
    call sync_after_kernel('pack_z_front_kernel',.true.)

    if(device_aware_transport_enabled) then
      ncou = size(z_send_back_d)
      call exchange_device_pair(z_send_back_d,z_send_front_d,z_recv_front_d,z_recv_back_d, &
                                ncou,mpiback,mpifront,tag_z_first,tag_z_second)
    else
      z_send_back_h = z_send_back_d
      z_send_front_h = z_send_front_d
      ncou = size(z_send_back_h)
      call exchange_host_pair(z_send_back_h,z_send_front_h, &
                              z_recv_front_h,z_recv_back_h, &
                              ncou,mpiback,mpifront,tag_z_first,tag_z_second)
      if(mpifront /= MPI_PROC_NULL) z_recv_front_d = z_recv_front_h
      if(mpiback /= MPI_PROC_NULL) z_recv_back_d = z_recv_back_h
    endif

    nunpack = (im + 1) * (jm + 1) * numq
    grid = dim3((nunpack + block%x - 1)/block%x,1,1)
    call unpack_z_kernel<<<grid,block>>>(z_recv_front_d,z_recv_back_d,im,jm,km,hm,numq, &
                                         merge(1,0,mpifront /= MPI_PROC_NULL), &
                                         merge(1,0,mpiback /= MPI_PROC_NULL))
    call sync_after_kernel('unpack_z_kernel')
  end subroutine exchange_z_halo_gpu

  subroutine exchange_x_filter_halo_gpu()
    use mpi
    use commvar, only: im,jm,km,hm,numq
    use gpu_check, only: sync_after_kernel
    use parallel, only: mpileft,mpiright
    implicit none

    type(dim3) :: block,grid
    integer :: ncou,npack,nunpack

    call ensure_x_filter_buffers()

    if(halo_pipeline_enabled) then
      call begin_x_filter_halo_pipeline_gpu()
      call finish_x_filter_halo_pipeline_gpu()
      return
    endif

    npack = hm * (jm + 1) * (km + 1) * numq
    block = dim3(256,1,1)
    grid = dim3((npack + block%x - 1)/block%x,1,1)

    call pack_x_halo_left_kernel<<<grid,block>>>(x_halo_send_left_d,im,jm,km,hm,numq)
    call sync_after_kernel('pack_x_halo_left_kernel')
    call pack_x_halo_right_kernel<<<grid,block>>>(x_halo_send_right_d,im,jm,km,hm,numq)
    call sync_after_kernel('pack_x_halo_right_kernel',.true.)

    ncou = size(x_halo_send_left_d)
    if(device_aware_transport_enabled) then
      call exchange_device_pair(x_halo_send_left_d,x_halo_send_right_d, &
                                x_halo_recv_right_d,x_halo_recv_left_d, &
                                ncou,mpileft,mpiright,tag_x_first,tag_x_second)
    else
      x_halo_send_left_h = x_halo_send_left_d
      x_halo_send_right_h = x_halo_send_right_d
      call exchange_host_pair(x_halo_send_left_h,x_halo_send_right_h, &
                              x_halo_recv_right_h,x_halo_recv_left_h, &
                              ncou,mpileft,mpiright,tag_x_first,tag_x_second)
      if(mpiright /= MPI_PROC_NULL) x_halo_recv_right_d = x_halo_recv_right_h
      if(mpileft /= MPI_PROC_NULL) x_halo_recv_left_d = x_halo_recv_left_h
    endif

    nunpack = (jm + 1) * (km + 1) * numq
    grid = dim3((nunpack + block%x - 1)/block%x,1,1)
    call unpack_x_halo_kernel<<<grid,block>>>(x_halo_recv_right_d,x_halo_recv_left_d, &
                                              im,jm,km,hm,numq, &
                                              merge(1,0,mpiright /= MPI_PROC_NULL), &
                                              merge(1,0,mpileft /= MPI_PROC_NULL))
    call sync_after_kernel('unpack_x_halo_kernel')
  end subroutine exchange_x_filter_halo_gpu

  subroutine begin_x_filter_halo_pipeline_gpu()
    use mpi
    use commvar, only: im,jm,km,hm,numq
    use gpu_check, only: check_kernel_launch
    use parallel, only: mpileft,mpiright
    implicit none

    type(dim3) :: block,grid
    integer :: ncou,npack

    call ensure_x_filter_buffers()
    npack=hm*(jm+1)*(km+1)*numq
    ncou=size(x_halo_send_left_h)
    block=dim3(256,1,1)
    grid=dim3((npack+block%x-1)/block%x,1,1)

    call begin_host_pair_pipeline(halo_axis_x,x_halo_recv_right_h,x_halo_recv_left_h,ncou, &
                                  mpileft,mpiright,tag_x_first,tag_x_second)
    call begin_host_pair_device_pack(halo_axis_x,x_filter_pipeline_stream)
    call pack_x_halo_left_kernel<<<grid,block,0,x_filter_pipeline_stream>>>( &
         x_halo_send_left_d,im,jm,km,hm,numq)
    call check_kernel_launch('pipeline_pack_x_filter_left_kernel')
    call pack_x_halo_right_kernel<<<grid,block,0,x_filter_pipeline_stream>>>( &
         x_halo_send_right_d,im,jm,km,hm,numq)
    call check_kernel_launch('pipeline_pack_x_filter_right_kernel')
    x_filter_pipeline_d2h_staged=.false.
  end subroutine begin_x_filter_halo_pipeline_gpu

  subroutine stage_x_filter_halo_d2h_gpu()
    use mpi
    implicit none
    integer :: ncou,code,ierr

    if(x_filter_pipeline_d2h_staged) then
      print *, 'GPU x filter halo D2H was staged more than once'
      call mpi_abort(MPI_COMM_WORLD,1,ierr)
      return
    endif
    ncou=size(x_halo_send_left_h)
    code=cudaMemcpyAsync(x_halo_send_left_h,x_halo_send_left_d,ncou, &
                         cudaMemcpyDeviceToHost,x_filter_pipeline_stream)
    call check_pipeline_cuda('x filter left D2H',code)
    code=cudaMemcpyAsync(x_halo_send_right_h,x_halo_send_right_d,ncou, &
                         cudaMemcpyDeviceToHost,x_filter_pipeline_stream)
    call check_pipeline_cuda('x filter right D2H',code)
    x_filter_pipeline_d2h_staged=.true.
  end subroutine stage_x_filter_halo_d2h_gpu

  subroutine finish_x_filter_halo_pipeline_gpu()
    use mpi
    use commvar, only: im,jm,km,hm,numq
    use gpu_check, only: check_kernel_launch
    use parallel, only: mpileft,mpiright
    implicit none

    type(dim3) :: block,grid
    integer(kind=cuda_stream_kind) :: pipeline_stream
    integer :: ncou,nunpack,code

    ncou=size(x_halo_send_left_h)
    block=dim3(256,1,1)
    if(.not.x_filter_pipeline_d2h_staged) call stage_x_filter_halo_d2h_gpu()
    call complete_host_pair_d2h(halo_axis_x,x_halo_send_left_h,x_halo_send_right_h)
    call begin_host_pair_device_upload(halo_axis_x,pipeline_stream)
    if(mpiright/=MPI_PROC_NULL) then
      code=cudaMemcpyAsync(x_halo_recv_right_d,x_halo_recv_right_h,ncou, &
                           cudaMemcpyHostToDevice,pipeline_stream)
      call check_pipeline_cuda('x filter right H2D',code)
    endif
    if(mpileft/=MPI_PROC_NULL) then
      code=cudaMemcpyAsync(x_halo_recv_left_d,x_halo_recv_left_h,ncou, &
                           cudaMemcpyHostToDevice,pipeline_stream)
      call check_pipeline_cuda('x filter left H2D',code)
    endif
    nunpack=(jm+1)*(km+1)*numq
    grid=dim3((nunpack+block%x-1)/block%x,1,1)
    call unpack_x_halo_kernel<<<grid,block,0,pipeline_stream>>>( &
         x_halo_recv_right_d,x_halo_recv_left_d,im,jm,km,hm,numq, &
         merge(1,0,mpiright/=MPI_PROC_NULL),merge(1,0,mpileft/=MPI_PROC_NULL))
    call check_kernel_launch('pipeline_unpack_x_filter_kernel')
    call finish_host_pair_pipeline(halo_axis_x)
    x_filter_pipeline_d2h_staged=.false.
    x_filter_pipeline_stream=0_cuda_stream_kind
  end subroutine finish_x_filter_halo_pipeline_gpu

  subroutine begin_y_filter_halo_pipeline_gpu()
    use commvar, only: im,jm,km,hm,numq
    use gpu_check, only: check_kernel_launch
    use parallel, only: mpidown,mpiup
    implicit none
    type(dim3) :: block,grid
    integer :: ncou,npack

    call ensure_y_filter_buffers()
    npack=hm*(im+1)*(km+1)*numq
    ncou=size(y_halo_send_down_h)
    block=dim3(256,1,1)
    grid=dim3((npack+block%x-1)/block%x,1,1)
    call begin_host_pair_pipeline(halo_axis_y,y_halo_recv_up_h,y_halo_recv_down_h,ncou, &
                                  mpidown,mpiup,tag_y_first,tag_y_second)
    call begin_host_pair_device_pack(halo_axis_y,y_filter_pipeline_stream)
    call pack_qwork_y_halo_down_kernel<<<grid,block,0,y_filter_pipeline_stream>>>( &
         y_halo_send_down_d,im,jm,km,hm,numq)
    call check_kernel_launch('pipeline_pack_y_filter_down_kernel')
    call pack_qwork_y_halo_up_kernel<<<grid,block,0,y_filter_pipeline_stream>>>( &
         y_halo_send_up_d,im,jm,km,hm,numq)
    call check_kernel_launch('pipeline_pack_y_filter_up_kernel')
    y_filter_pipeline_d2h_staged=.false.
  end subroutine begin_y_filter_halo_pipeline_gpu

  subroutine stage_y_filter_halo_d2h_gpu()
    use mpi
    implicit none
    integer :: ncou,code,ierr

    if(y_filter_pipeline_d2h_staged) then
      print *, 'GPU y filter halo D2H was staged more than once'
      call mpi_abort(MPI_COMM_WORLD,1,ierr)
      return
    endif
    ncou=size(y_halo_send_down_h)
    code=cudaMemcpyAsync(y_halo_send_down_h,y_halo_send_down_d,ncou, &
                         cudaMemcpyDeviceToHost,y_filter_pipeline_stream)
    call check_pipeline_cuda('y filter down D2H',code)
    code=cudaMemcpyAsync(y_halo_send_up_h,y_halo_send_up_d,ncou, &
                         cudaMemcpyDeviceToHost,y_filter_pipeline_stream)
    call check_pipeline_cuda('y filter up D2H',code)
    y_filter_pipeline_d2h_staged=.true.
  end subroutine stage_y_filter_halo_d2h_gpu

  subroutine finish_y_filter_halo_pipeline_gpu()
    use mpi
    use commvar, only: im,jm,km,hm,numq
    use gpu_check, only: check_kernel_launch
    use parallel, only: mpidown,mpiup
    implicit none
    type(dim3) :: block,grid
    integer(kind=cuda_stream_kind) :: pipeline_stream
    integer :: ncou,nunpack,code

    ncou=size(y_halo_send_down_h)
    block=dim3(256,1,1)
    if(.not.y_filter_pipeline_d2h_staged) call stage_y_filter_halo_d2h_gpu()
    call complete_host_pair_d2h(halo_axis_y,y_halo_send_down_h,y_halo_send_up_h)
    call begin_host_pair_device_upload(halo_axis_y,pipeline_stream)
    if(mpiup/=MPI_PROC_NULL) then
      code=cudaMemcpyAsync(y_halo_recv_up_d,y_halo_recv_up_h,ncou, &
                           cudaMemcpyHostToDevice,pipeline_stream)
      call check_pipeline_cuda('y filter up H2D',code)
    endif
    if(mpidown/=MPI_PROC_NULL) then
      code=cudaMemcpyAsync(y_halo_recv_down_d,y_halo_recv_down_h,ncou, &
                           cudaMemcpyHostToDevice,pipeline_stream)
      call check_pipeline_cuda('y filter down H2D',code)
    endif
    nunpack=(im+1)*(km+1)*numq
    grid=dim3((nunpack+block%x-1)/block%x,1,1)
    call unpack_qwork_y_halo_kernel<<<grid,block,0,pipeline_stream>>>( &
         y_halo_recv_up_d,y_halo_recv_down_d,im,jm,km,hm,numq, &
         merge(1,0,mpiup/=MPI_PROC_NULL),merge(1,0,mpidown/=MPI_PROC_NULL))
    call check_kernel_launch('pipeline_unpack_y_filter_kernel')
    call finish_host_pair_pipeline(halo_axis_y)
    y_filter_pipeline_d2h_staged=.false.
    y_filter_pipeline_stream=0_cuda_stream_kind
  end subroutine finish_y_filter_halo_pipeline_gpu

  subroutine begin_z_filter_halo_pipeline_gpu()
    use commvar, only: im,jm,km,hm,numq
    use gpu_check, only: check_kernel_launch
    use parallel, only: mpiback,mpifront
    implicit none
    type(dim3) :: block,grid
    integer :: ncou,npack

    call ensure_z_filter_buffers()
    npack=hm*(im+1)*(jm+1)*numq
    ncou=size(z_halo_send_back_h)
    block=dim3(256,1,1)
    grid=dim3((npack+block%x-1)/block%x,1,1)
    call begin_host_pair_pipeline(halo_axis_z,z_halo_recv_front_h,z_halo_recv_back_h,ncou, &
                                  mpiback,mpifront,tag_z_first,tag_z_second)
    call begin_host_pair_device_pack(halo_axis_z,z_filter_pipeline_stream)
    call pack_z_halo_back_kernel<<<grid,block,0,z_filter_pipeline_stream>>>( &
         z_halo_send_back_d,im,jm,km,hm,numq)
    call check_kernel_launch('pipeline_pack_z_filter_back_kernel')
    call pack_z_halo_front_kernel<<<grid,block,0,z_filter_pipeline_stream>>>( &
         z_halo_send_front_d,im,jm,km,hm,numq)
    call check_kernel_launch('pipeline_pack_z_filter_front_kernel')
    z_filter_pipeline_d2h_staged=.false.
  end subroutine begin_z_filter_halo_pipeline_gpu

  subroutine stage_z_filter_halo_d2h_gpu()
    use mpi
    implicit none
    integer :: ncou,code,ierr

    if(z_filter_pipeline_d2h_staged) then
      print *, 'GPU z filter halo D2H was staged more than once'
      call mpi_abort(MPI_COMM_WORLD,1,ierr)
      return
    endif
    ncou=size(z_halo_send_back_h)
    code=cudaMemcpyAsync(z_halo_send_back_h,z_halo_send_back_d,ncou, &
                         cudaMemcpyDeviceToHost,z_filter_pipeline_stream)
    call check_pipeline_cuda('z filter back D2H',code)
    code=cudaMemcpyAsync(z_halo_send_front_h,z_halo_send_front_d,ncou, &
                         cudaMemcpyDeviceToHost,z_filter_pipeline_stream)
    call check_pipeline_cuda('z filter front D2H',code)
    z_filter_pipeline_d2h_staged=.true.
  end subroutine stage_z_filter_halo_d2h_gpu

  subroutine finish_z_filter_halo_pipeline_gpu()
    use mpi
    use commvar, only: im,jm,km,hm,numq
    use gpu_check, only: check_kernel_launch
    use parallel, only: mpiback,mpifront
    implicit none
    type(dim3) :: block,grid
    integer(kind=cuda_stream_kind) :: pipeline_stream
    integer :: ncou,nunpack,code

    ncou=size(z_halo_send_back_h)
    block=dim3(256,1,1)
    if(.not.z_filter_pipeline_d2h_staged) call stage_z_filter_halo_d2h_gpu()
    call complete_host_pair_d2h(halo_axis_z,z_halo_send_back_h,z_halo_send_front_h)
    call begin_host_pair_device_upload(halo_axis_z,pipeline_stream)
    if(mpifront/=MPI_PROC_NULL) then
      code=cudaMemcpyAsync(z_halo_recv_front_d,z_halo_recv_front_h,ncou, &
                           cudaMemcpyHostToDevice,pipeline_stream)
      call check_pipeline_cuda('z filter front H2D',code)
    endif
    if(mpiback/=MPI_PROC_NULL) then
      code=cudaMemcpyAsync(z_halo_recv_back_d,z_halo_recv_back_h,ncou, &
                           cudaMemcpyHostToDevice,pipeline_stream)
      call check_pipeline_cuda('z filter back H2D',code)
    endif
    nunpack=(im+1)*(jm+1)*numq
    grid=dim3((nunpack+block%x-1)/block%x,1,1)
    call unpack_z_halo_kernel<<<grid,block,0,pipeline_stream>>>( &
         z_halo_recv_front_d,z_halo_recv_back_d,im,jm,km,hm,numq, &
         merge(1,0,mpifront/=MPI_PROC_NULL),merge(1,0,mpiback/=MPI_PROC_NULL))
    call check_kernel_launch('pipeline_unpack_z_filter_kernel')
    call finish_host_pair_pipeline(halo_axis_z)
    z_filter_pipeline_d2h_staged=.false.
    z_filter_pipeline_stream=0_cuda_stream_kind
  end subroutine finish_z_filter_halo_pipeline_gpu

  subroutine exchange_diffusion_flux_halo_gpu(work)
    use commarray_gpu, only: sigma_d,qflux_d
    use parallel, only: isize,jsize,ksize
    implicit none
    procedure(independent_host_pair_work),optional :: work
    logical :: work_used

    if(halo_pipeline_enabled) then
      work_used=.false.
      if(isize>1) then
        if(present(work)) then
          call exchange_diffusion_x_fused_pipeline_gpu(work)
          work_used=.true.
        else
          call exchange_diffusion_x_fused_pipeline_gpu()
        endif
      endif
      if(jsize>1) then
        if(present(work) .and. .not.work_used) then
          call exchange_diffusion_y_fused_pipeline_gpu(work)
          work_used=.true.
        else
          call exchange_diffusion_y_fused_pipeline_gpu()
        endif
      endif
      if(ksize>1) then
        if(present(work) .and. .not.work_used) then
          call exchange_diffusion_z_fused_pipeline_gpu(work)
          work_used=.true.
        else
          call exchange_diffusion_z_fused_pipeline_gpu()
        endif
      endif
      call refresh_diffusion_transverse_halos_gpu()
      return
    endif
    call exchange_field_halo_gpu(sigma_d,6,work)
    call exchange_field_halo_gpu(qflux_d,3)
  end subroutine exchange_diffusion_flux_halo_gpu

  subroutine exchange_diffusion_x_fused_pipeline_gpu(work)
    use mpi
    use commvar, only: im,jm,km,hm
    use gpu_check, only: check_kernel_launch
    use parallel, only: mpileft,mpiright
    implicit none
    procedure(independent_host_pair_work),optional :: work
    type(dim3) :: block,grid
    integer(kind=cuda_stream_kind) :: pipeline_stream
    integer :: code,ncou,nunpack

    call ensure_field_buffers(max_field_vars)
    ncou=hm*(jm+1)*(km+1)*max_field_vars
    call begin_host_pair_pipeline(halo_axis_x,field_recv_right_h,field_recv_left_h,ncou, &
                                  mpileft,mpiright,tag_x_first,tag_x_second)
    call begin_host_pair_device_pack(halo_axis_x,pipeline_stream)
    block=dim3(256,1,1)
    grid=dim3((ncou+block%x-1)/block%x,1,1)
    call pack_diffusion_x_fused_kernel<<<grid,block,0,pipeline_stream>>>( &
         field_send_left_d,field_send_right_d,im,jm,km,hm)
    call check_kernel_launch('pipeline_pack_diffusion_x_fused_kernel')
    code=cudaMemcpyAsync(field_send_left_h,field_send_left_d,ncou, &
                         cudaMemcpyDeviceToHost,pipeline_stream)
    call check_pipeline_cuda('x diffusion fused left D2H',code)
    code=cudaMemcpyAsync(field_send_right_h,field_send_right_d,ncou, &
                         cudaMemcpyDeviceToHost,pipeline_stream)
    call check_pipeline_cuda('x diffusion fused right D2H',code)
    call complete_host_pair_d2h(halo_axis_x,field_send_left_h,field_send_right_h,work)

    call begin_host_pair_device_upload(halo_axis_x,pipeline_stream)
    if(mpiright/=MPI_PROC_NULL) then
      code=cudaMemcpyAsync(field_recv_right_d,field_recv_right_h,ncou, &
                           cudaMemcpyHostToDevice,pipeline_stream)
      call check_pipeline_cuda('x diffusion fused right H2D',code)
    endif
    if(mpileft/=MPI_PROC_NULL) then
      code=cudaMemcpyAsync(field_recv_left_d,field_recv_left_h,ncou, &
                           cudaMemcpyHostToDevice,pipeline_stream)
      call check_pipeline_cuda('x diffusion fused left H2D',code)
    endif
    nunpack=(jm+1)*(km+1)*max_field_vars
    grid=dim3((nunpack+block%x-1)/block%x,1,1)
    call unpack_diffusion_x_fused_kernel<<<grid,block,0,pipeline_stream>>>( &
         field_recv_right_d,field_recv_left_d,im,jm,km,hm, &
         merge(1,0,mpiright/=MPI_PROC_NULL),merge(1,0,mpileft/=MPI_PROC_NULL))
    call check_kernel_launch('pipeline_unpack_diffusion_x_fused_kernel')
    call finish_host_pair_pipeline(halo_axis_x)
  end subroutine exchange_diffusion_x_fused_pipeline_gpu

  subroutine exchange_diffusion_y_fused_pipeline_gpu(work)
    use mpi
    use commvar, only: im,jm,km,hm
    use gpu_check, only: check_kernel_launch
    use parallel, only: mpidown,mpiup
    implicit none
    procedure(independent_host_pair_work),optional :: work
    type(dim3) :: block,grid
    integer(kind=cuda_stream_kind) :: pipeline_stream
    integer :: code,ncou,nunpack

    call ensure_field_y_buffers(max_field_vars)
    ncou=hm*(im+1)*(km+1)*max_field_vars
    call begin_host_pair_pipeline(halo_axis_y,field_recv_up_h,field_recv_down_h,ncou, &
                                  mpidown,mpiup,tag_y_first,tag_y_second)
    call begin_host_pair_device_pack(halo_axis_y,pipeline_stream)
    block=dim3(256,1,1)
    grid=dim3((ncou+block%x-1)/block%x,1,1)
    call pack_diffusion_y_fused_kernel<<<grid,block,0,pipeline_stream>>>( &
         field_send_down_d,field_send_up_d,im,jm,km,hm)
    call check_kernel_launch('pipeline_pack_diffusion_y_fused_kernel')
    code=cudaMemcpyAsync(field_send_down_h,field_send_down_d,ncou, &
                         cudaMemcpyDeviceToHost,pipeline_stream)
    call check_pipeline_cuda('y diffusion fused down D2H',code)
    code=cudaMemcpyAsync(field_send_up_h,field_send_up_d,ncou, &
                         cudaMemcpyDeviceToHost,pipeline_stream)
    call check_pipeline_cuda('y diffusion fused up D2H',code)
    call complete_host_pair_d2h(halo_axis_y,field_send_down_h,field_send_up_h,work)
    call begin_host_pair_device_upload(halo_axis_y,pipeline_stream)
    if(mpiup/=MPI_PROC_NULL) then
      code=cudaMemcpyAsync(field_recv_up_d,field_recv_up_h,ncou, &
                           cudaMemcpyHostToDevice,pipeline_stream)
      call check_pipeline_cuda('y diffusion fused up H2D',code)
    endif
    if(mpidown/=MPI_PROC_NULL) then
      code=cudaMemcpyAsync(field_recv_down_d,field_recv_down_h,ncou, &
                           cudaMemcpyHostToDevice,pipeline_stream)
      call check_pipeline_cuda('y diffusion fused down H2D',code)
    endif
    nunpack=(im+1)*(km+1)*max_field_vars
    grid=dim3((nunpack+block%x-1)/block%x,1,1)
    call unpack_diffusion_y_fused_kernel<<<grid,block,0,pipeline_stream>>>( &
         field_recv_up_d,field_recv_down_d,im,jm,km,hm, &
         merge(1,0,mpiup/=MPI_PROC_NULL),merge(1,0,mpidown/=MPI_PROC_NULL))
    call check_kernel_launch('pipeline_unpack_diffusion_y_fused_kernel')
    call finish_host_pair_pipeline(halo_axis_y)
  end subroutine exchange_diffusion_y_fused_pipeline_gpu

  subroutine exchange_diffusion_z_fused_pipeline_gpu(work)
    use mpi
    use commvar, only: im,jm,km,hm
    use gpu_check, only: check_kernel_launch
    use parallel, only: mpiback,mpifront
    implicit none
    procedure(independent_host_pair_work),optional :: work
