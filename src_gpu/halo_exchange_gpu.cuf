    call sync_after_kernel('pack_x_halo_right_kernel')

    x_halo_send_left_h = x_halo_send_left_d
    x_halo_send_right_h = x_halo_send_right_d

    ncou = size(x_halo_send_left_h)
    call mpi_sendrecv(x_halo_send_left_h,ncou,mpi_real8,mpileft, tag_x_first, &
                      x_halo_recv_right_h,ncou,mpi_real8,mpiright,tag_x_first, &
                      mpi_comm_world,status,ierr)
    call mpi_sendrecv(x_halo_send_right_h,ncou,mpi_real8,mpiright,tag_x_second, &
                      x_halo_recv_left_h, ncou,mpi_real8,mpileft, tag_x_second, &
                      mpi_comm_world,status,ierr)

    x_halo_recv_right_d = x_halo_recv_right_h
    x_halo_recv_left_d = x_halo_recv_left_h

    nunpack = (jm + 1) * (km + 1) * numq
    grid = dim3((nunpack + block%x - 1)/block%x,1,1)
    call unpack_x_halo_kernel<<<grid,block>>>(x_halo_recv_right_d,x_halo_recv_left_d, &
                                              im,jm,km,hm,numq, &
                                              merge(1,0,mpiright /= MPI_PROC_NULL), &
                                              merge(1,0,mpileft /= MPI_PROC_NULL))
