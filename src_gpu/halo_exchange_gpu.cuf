  end subroutine pack_z_halo_front_kernel

  attributes(global) subroutine unpack_z_halo_kernel(recv_front,recv_back,im,jm,km,hm,numq,has_front,has_back)
    use commarray_gpu, only: q_d
    implicit none
    integer,value :: im,jm,km,hm,numq,has_front,has_back
    real(8),device :: recv_front(0:im,0:jm,0:hm-1,1:numq)
    real(8),device :: recv_back(0:im,0:jm,0:hm-1,1:numq)
    integer :: id,i,j,h,m,nplane

    nplane = (im + 1) * (jm + 1) * numq
    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    if(id >= nplane) return

    i = mod(id,im+1)
    j = mod(id/(im+1),jm+1)
    m = id/((im+1)*(jm+1)) + 1

    do h=0,hm-1
      if(has_front /= 0) q_d(i,j,km+1+h,m) = recv_front(i,j,h,m)
      if(has_back /= 0) q_d(i,j,-hm+h,m) = recv_back(i,j,h,m)
    enddo
  end subroutine unpack_z_halo_kernel

  attributes(global) subroutine q_halo_local_x_kernel(im,jm,km,hm,numq)
    use commarray_gpu, only: q_d
    implicit none
    integer,value :: im,jm,km,hm,numq
    integer :: id,j,k,m,h,nplane

    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    nplane = (jm + 1) * (km + 1) * numq
    if(id >= nplane) return
    j = mod(id,jm+1)
    k = mod(id/(jm+1),km+1)
    m = id/((jm+1)*(km+1)) + 1

    do h=1,hm
      q_d(-h,j,k,m) = q_d(im-h,j,k,m)
      q_d(im+h,j,k,m) = q_d(h,j,k,m)
    enddo
  end subroutine q_halo_local_x_kernel

  attributes(global) subroutine pack_field_x_left_kernel(field,sendbuf,im,jm,km,hm,nvar)
    implicit none
    integer,value :: im,jm,km,hm,nvar
    real(8),device :: field(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:nvar)
    real(8),device :: sendbuf(0:hm-1,0:jm,0:km,1:nvar)
    integer :: id,h,j,k,m,n1,n2,n3

    n1 = hm
    n2 = jm + 1
    n3 = km + 1
    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    if(id >= n1*n2*n3*nvar) return

    h = mod(id,n1)
    j = mod(id/n1,n2)
    k = mod(id/(n1*n2),n3)
    m = id/(n1*n2*n3) + 1
    sendbuf(h,j,k,m) = field(h+1,j,k,m)
  end subroutine pack_field_x_left_kernel

  attributes(global) subroutine pack_field_x_right_kernel(field,sendbuf,im,jm,km,hm,nvar)
    implicit none
    integer,value :: im,jm,km,hm,nvar
    real(8),device :: field(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:nvar)
    real(8),device :: sendbuf(0:hm-1,0:jm,0:km,1:nvar)
    integer :: id,h,j,k,m,n1,n2,n3

    n1 = hm
    n2 = jm + 1
    n3 = km + 1
    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    if(id >= n1*n2*n3*nvar) return

    h = mod(id,n1)
    j = mod(id/n1,n2)
    k = mod(id/(n1*n2),n3)
    m = id/(n1*n2*n3) + 1
    sendbuf(h,j,k,m) = field(im-hm+h,j,k,m)
  end subroutine pack_field_x_right_kernel

  attributes(global) subroutine unpack_field_x_kernel(field,recv_right,recv_left,im,jm,km,hm,nvar,has_right,has_left)
    implicit none
    integer,value :: im,jm,km,hm,nvar,has_right,has_left
    real(8),device :: field(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:nvar)
    real(8),device :: recv_right(0:hm-1,0:jm,0:km,1:nvar)
    real(8),device :: recv_left(0:hm-1,0:jm,0:km,1:nvar)
    integer :: id,h,j,k,m,nplane

    nplane = (jm + 1) * (km + 1) * nvar
    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    if(id >= nplane) return

    j = mod(id,jm+1)
    k = mod(id/(jm+1),km+1)
    m = id/((jm+1)*(km+1)) + 1

    if(has_right /= 0) then
      do h=0,hm-1
        field(im+1+h,j,k,m) = recv_right(h,j,k,m)
      enddo
    endif

    if(has_left /= 0) then
      do h=0,hm-1
        field(-hm+h,j,k,m) = recv_left(h,j,k,m)
      enddo
    endif
  end subroutine unpack_field_x_kernel

  attributes(global) subroutine pack_diffusion_x_fused_kernel(send_left,send_right,im,jm,km,hm)
    use commarray_gpu, only: sigma_d,qflux_d
    implicit none
    integer,value :: im,jm,km,hm
    real(8),device :: send_left(0:hm-1,0:jm,0:km,1:max_field_vars)
    real(8),device :: send_right(0:hm-1,0:jm,0:km,1:max_field_vars)
    integer :: id,h,j,k,m,n1,n2,n3

    n1=hm
    n2=jm+1
    n3=km+1
    id=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    if(id>=n1*n2*n3*max_field_vars) return

    h=mod(id,n1)
    j=mod(id/n1,n2)
    k=mod(id/(n1*n2),n3)
    m=id/(n1*n2*n3)+1
    if(m<=6) then
      send_left(h,j,k,m)=sigma_d(h+1,j,k,m)
      send_right(h,j,k,m)=sigma_d(im-hm+h,j,k,m)
    else
      send_left(h,j,k,m)=qflux_d(h+1,j,k,m-6)
      send_right(h,j,k,m)=qflux_d(im-hm+h,j,k,m-6)
    endif
  end subroutine pack_diffusion_x_fused_kernel

  attributes(global) subroutine unpack_diffusion_x_fused_kernel(recv_right,recv_left, &
                                                                 im,jm,km,hm,has_right,has_left)
    use commarray_gpu, only: sigma_d,qflux_d
    implicit none
    integer,value :: im,jm,km,hm,has_right,has_left
    real(8),device :: recv_right(0:hm-1,0:jm,0:km,1:max_field_vars)
    real(8),device :: recv_left(0:hm-1,0:jm,0:km,1:max_field_vars)
    integer :: id,h,j,k,m,nplane

    nplane=(jm+1)*(km+1)*max_field_vars
    id=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    if(id>=nplane) return

    j=mod(id,jm+1)
    k=mod(id/(jm+1),km+1)
    m=id/((jm+1)*(km+1))+1
    do h=0,hm-1
      if(m<=6) then
        if(has_right/=0) sigma_d(im+1+h,j,k,m)=recv_right(h,j,k,m)
        if(has_left/=0) sigma_d(-hm+h,j,k,m)=recv_left(h,j,k,m)
      else
        if(has_right/=0) qflux_d(im+1+h,j,k,m-6)=recv_right(h,j,k,m)
        if(has_left/=0) qflux_d(-hm+h,j,k,m-6)=recv_left(h,j,k,m)
      endif
    enddo
  end subroutine unpack_diffusion_x_fused_kernel

  attributes(global) subroutine pack_diffusion_y_fused_kernel(send_down,send_up,im,jm,km,hm)
    use commarray_gpu, only: sigma_d,qflux_d
    implicit none
    integer,value :: im,jm,km,hm
    real(8),device :: send_down(0:im,0:hm-1,0:km,1:max_field_vars)
    real(8),device :: send_up(0:im,0:hm-1,0:km,1:max_field_vars)
    integer :: id,i,h,k,m,n1,n2,n3

    n1=im+1
    n2=hm
    n3=km+1
