    call complete_host_pair_d2h(halo_axis_z,field_send_back_h,field_send_front_h,work)
    call begin_host_pair_device_upload(halo_axis_z,pipeline_stream)
    if(mpifront/=MPI_PROC_NULL) then
      code=cudaMemcpyAsync(field_recv_front_d,field_recv_front_h,ncou, &
                           cudaMemcpyHostToDevice,pipeline_stream)
      call check_pipeline_cuda('z diffusion fused front H2D',code)
    endif
    if(mpiback/=MPI_PROC_NULL) then
      code=cudaMemcpyAsync(field_recv_back_d,field_recv_back_h,ncou, &
                           cudaMemcpyHostToDevice,pipeline_stream)
      call check_pipeline_cuda('z diffusion fused back H2D',code)
    endif
    nunpack=(im+1)*(jm+1)*max_field_vars
    grid=dim3((nunpack+block%x-1)/block%x,1,1)
    call unpack_diffusion_z_fused_kernel<<<grid,block,0,pipeline_stream>>>( &
         field_recv_front_d,field_recv_back_d,im,jm,km,hm, &
         merge(1,0,mpifront/=MPI_PROC_NULL),merge(1,0,mpiback/=MPI_PROC_NULL))
    call check_kernel_launch('pipeline_unpack_diffusion_z_fused_kernel')
    call finish_host_pair_pipeline(halo_axis_z)
  end subroutine exchange_diffusion_z_fused_pipeline_gpu

  subroutine refresh_diffusion_transverse_halos_gpu()
    use commarray_gpu, only: sigma_d,qflux_d
    use commvar, only: im,jm,km,hm
    use gpu_check, only: sync_after_kernel
    use parallel, only: isize,jsize,ksize
    implicit none
    type(dim3) :: block,grid
    integer :: n

    block=dim3(256,1,1)
    if(isize==1) then
      n=(jm+1)*(km+1)*6
      grid=dim3((n+block%x-1)/block%x,1,1)
      call field_qswap_x_kernel<<<grid,block>>>(sigma_d,im,jm,km,hm,6)
      call sync_after_kernel('pipeline_sigma_qswap_x_kernel')
      n=(jm+1)*(km+1)*3
      grid=dim3((n+block%x-1)/block%x,1,1)
      call field_qswap_x_kernel<<<grid,block>>>(qflux_d,im,jm,km,hm,3)
      call sync_after_kernel('pipeline_qflux_qswap_x_kernel')
    endif
    if(jsize==1) then
      n=(im+1)*(km+1)*6
      grid=dim3((n+block%x-1)/block%x,1,1)
      call field_qswap_y_kernel<<<grid,block>>>(sigma_d,im,jm,km,hm,6)
      call sync_after_kernel('pipeline_sigma_qswap_y_kernel')
      n=(im+1)*(km+1)*3
      grid=dim3((n+block%x-1)/block%x,1,1)
      call field_qswap_y_kernel<<<grid,block>>>(qflux_d,im,jm,km,hm,3)
      call sync_after_kernel('pipeline_qflux_qswap_y_kernel')
    endif
    if(ksize==1) then
      n=(im+1)*(jm+1)*6
      grid=dim3((n+block%x-1)/block%x,1,1)
      call field_qswap_z_kernel<<<grid,block>>>(sigma_d,im,jm,km,hm,6)
      call sync_after_kernel('pipeline_sigma_qswap_z_kernel')
      n=(im+1)*(jm+1)*3
      grid=dim3((n+block%x-1)/block%x,1,1)
      call field_qswap_z_kernel<<<grid,block>>>(qflux_d,im,jm,km,hm,3)
      call sync_after_kernel('pipeline_qflux_qswap_z_kernel')
    endif
  end subroutine refresh_diffusion_transverse_halos_gpu

  subroutine exchange_field_halo_gpu(field,nvar,work)
    use commvar, only: im,jm,km,hm
    use gpu_check, only: sync_after_kernel
    use parallel, only: isize,jsize,ksize
    use boundary_gpu, only: gpu_axis_is_physical
    implicit none

    integer,intent(in) :: nvar
    procedure(independent_host_pair_work),optional :: work
    real(8),device :: field(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:nvar)
    type(dim3) :: block,grid
    integer :: n

    block = dim3(256,1,1)

    if(isize>1) then
      call exchange_field_x_halo_gpu(field,nvar,work)
    elseif(.not.gpu_axis_is_physical(1)) then
      n = (jm + 1) * (km + 1) * nvar
      grid = dim3((n + block%x - 1)/block%x,1,1)
      call field_qswap_x_kernel<<<grid,block>>>(field,im,jm,km,hm,nvar)
      call sync_after_kernel('field_qswap_x_kernel')
    endif

    if(jsize>1) then
      if(isize==1) then
        call exchange_field_y_halo_gpu(field,nvar,work)
      else
        call exchange_field_y_halo_gpu(field,nvar)
      endif
    elseif(.not.gpu_axis_is_physical(2)) then
      n = (im + 1) * (km + 1) * nvar
      grid = dim3((n + block%x - 1)/block%x,1,1)
      call field_qswap_y_kernel<<<grid,block>>>(field,im,jm,km,hm,nvar)
      call sync_after_kernel('field_qswap_y_kernel')
    endif

    if(ksize>1) then
      if(isize==1 .and. jsize==1) then
        call exchange_field_z_halo_gpu(field,nvar,work)
      else
        call exchange_field_z_halo_gpu(field,nvar)
      endif
    elseif(.not.gpu_axis_is_physical(3)) then
      n = (im + 1) * (jm + 1) * nvar
      grid = dim3((n + block%x - 1)/block%x,1,1)
      call field_qswap_z_kernel<<<grid,block>>>(field,im,jm,km,hm,nvar)
      call sync_after_kernel('field_qswap_z_kernel')
    endif
  end subroutine exchange_field_halo_gpu

  subroutine exchange_field_x_halo_gpu(field,nvar,work)
    use mpi
    use commvar, only: im,jm,km,hm
    use gpu_check, only: sync_after_kernel
    use parallel, only: mpileft,mpiright
    implicit none

    integer,intent(in) :: nvar
    procedure(independent_host_pair_work),optional :: work
    real(8),device :: field(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:nvar)
    type(dim3) :: block,grid
    integer :: ncou,npack,nunpack

    call ensure_field_buffers(nvar)

    npack = hm * (jm + 1) * (km + 1) * nvar
    block = dim3(256,1,1)
    grid = dim3((npack + block%x - 1)/block%x,1,1)

    call pack_field_x_left_kernel<<<grid,block>>>(field,field_send_left_d,im,jm,km,hm,nvar)
    call sync_after_kernel('pack_field_x_left_kernel')
    call pack_field_x_right_kernel<<<grid,block>>>(field,field_send_right_d,im,jm,km,hm,nvar)
    call sync_after_kernel('pack_field_x_right_kernel',.true.)

    ncou = hm * (jm + 1) * (km + 1) * nvar
    if(device_aware_transport_enabled) then
      call exchange_device_pair(field_send_left_d(:,:,:,1:nvar),field_send_right_d(:,:,:,1:nvar), &
                                field_recv_right_d(:,:,:,1:nvar),field_recv_left_d(:,:,:,1:nvar), &
                                ncou,mpileft,mpiright,tag_x_first,tag_x_second,work)
    else
      field_send_left_h(:,:,:,1:nvar) = field_send_left_d(:,:,:,1:nvar)
      field_send_right_h(:,:,:,1:nvar) = field_send_right_d(:,:,:,1:nvar)
      call exchange_host_pair(field_send_left_h(:,:,:,1:nvar),field_send_right_h(:,:,:,1:nvar), &
                              field_recv_right_h(:,:,:,1:nvar),field_recv_left_h(:,:,:,1:nvar), &
                              ncou,mpileft,mpiright,tag_x_first,tag_x_second,work)
      if(mpiright /= MPI_PROC_NULL) &
        field_recv_right_d(:,:,:,1:nvar) = field_recv_right_h(:,:,:,1:nvar)
      if(mpileft /= MPI_PROC_NULL) &
        field_recv_left_d(:,:,:,1:nvar) = field_recv_left_h(:,:,:,1:nvar)
    endif

    nunpack = (jm + 1) * (km + 1) * nvar
    grid = dim3((nunpack + block%x - 1)/block%x,1,1)
    call unpack_field_x_kernel<<<grid,block>>>(field,field_recv_right_d,field_recv_left_d, &
                                               im,jm,km,hm,nvar, &
                                               merge(1,0,mpiright /= MPI_PROC_NULL), &
                                               merge(1,0,mpileft /= MPI_PROC_NULL))
    call sync_after_kernel('unpack_field_x_kernel')
  end subroutine exchange_field_x_halo_gpu

  subroutine exchange_field_y_halo_gpu(field,nvar,work)
    use mpi
    use commvar, only: im,jm,km,hm
    use gpu_check, only: sync_after_kernel
    use parallel, only: mpidown,mpiup
    implicit none

    integer,intent(in) :: nvar
    procedure(independent_host_pair_work),optional :: work
    real(8),device :: field(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:nvar)
    type(dim3) :: block,grid
    integer :: ncou,npack,nunpack

    call ensure_field_y_buffers(nvar)

    npack = hm * (im + 1) * (km + 1) * nvar
    block = dim3(256,1,1)
    grid = dim3((npack + block%x - 1)/block%x,1,1)

    call pack_field_y_down_kernel<<<grid,block>>>(field,field_send_down_d,im,jm,km,hm,nvar)
    call sync_after_kernel('pack_field_y_down_kernel')
    call pack_field_y_up_kernel<<<grid,block>>>(field,field_send_up_d,im,jm,km,hm,nvar)
    call sync_after_kernel('pack_field_y_up_kernel',.true.)

    ncou = hm * (im + 1) * (km + 1) * nvar
    if(device_aware_transport_enabled) then
      call exchange_device_pair(field_send_down_d(:,:,:,1:nvar),field_send_up_d(:,:,:,1:nvar), &
                                field_recv_up_d(:,:,:,1:nvar),field_recv_down_d(:,:,:,1:nvar), &
                                ncou,mpidown,mpiup,tag_y_first,tag_y_second,work)
    else
      field_send_down_h(:,:,:,1:nvar) = field_send_down_d(:,:,:,1:nvar)
      field_send_up_h(:,:,:,1:nvar) = field_send_up_d(:,:,:,1:nvar)
      call exchange_host_pair(field_send_down_h(:,:,:,1:nvar),field_send_up_h(:,:,:,1:nvar), &
                              field_recv_up_h(:,:,:,1:nvar),field_recv_down_h(:,:,:,1:nvar), &
                              ncou,mpidown,mpiup,tag_y_first,tag_y_second,work)
      if(mpiup /= MPI_PROC_NULL) &
        field_recv_up_d(:,:,:,1:nvar) = field_recv_up_h(:,:,:,1:nvar)
      if(mpidown /= MPI_PROC_NULL) &
        field_recv_down_d(:,:,:,1:nvar) = field_recv_down_h(:,:,:,1:nvar)
    endif

    nunpack = (im + 1) * (km + 1) * nvar
    grid = dim3((nunpack + block%x - 1)/block%x,1,1)
    call unpack_field_y_kernel<<<grid,block>>>(field,field_recv_up_d,field_recv_down_d, &
                                               im,jm,km,hm,nvar, &
                                               merge(1,0,mpiup /= MPI_PROC_NULL), &
                                               merge(1,0,mpidown /= MPI_PROC_NULL))
    call sync_after_kernel('unpack_field_y_kernel')
  end subroutine exchange_field_y_halo_gpu

  subroutine exchange_field_z_halo_gpu(field,nvar,work)
    use mpi
    use commvar, only: im,jm,km,hm
    use gpu_check, only: sync_after_kernel
    use parallel, only: mpiback,mpifront
    implicit none

    integer,intent(in) :: nvar
    procedure(independent_host_pair_work),optional :: work
    real(8),device :: field(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:nvar)
    type(dim3) :: block,grid
    integer :: ncou,npack,nunpack

    call ensure_field_z_buffers(nvar)

    npack = hm * (im + 1) * (jm + 1) * nvar
    block = dim3(256,1,1)
    grid = dim3((npack + block%x - 1)/block%x,1,1)

    call pack_field_z_back_kernel<<<grid,block>>>(field,field_send_back_d,im,jm,km,hm,nvar)
    call sync_after_kernel('pack_field_z_back_kernel')
    call pack_field_z_front_kernel<<<grid,block>>>(field,field_send_front_d,im,jm,km,hm,nvar)
    call sync_after_kernel('pack_field_z_front_kernel',.true.)

    ncou = hm * (im + 1) * (jm + 1) * nvar
    if(device_aware_transport_enabled) then
      call exchange_device_pair(field_send_back_d(:,:,:,1:nvar),field_send_front_d(:,:,:,1:nvar), &
                                field_recv_front_d(:,:,:,1:nvar),field_recv_back_d(:,:,:,1:nvar), &
                                ncou,mpiback,mpifront,tag_z_first,tag_z_second,work)
    else
      field_send_back_h(:,:,:,1:nvar) = field_send_back_d(:,:,:,1:nvar)
      field_send_front_h(:,:,:,1:nvar) = field_send_front_d(:,:,:,1:nvar)
      call exchange_host_pair(field_send_back_h(:,:,:,1:nvar),field_send_front_h(:,:,:,1:nvar), &
                              field_recv_front_h(:,:,:,1:nvar),field_recv_back_h(:,:,:,1:nvar), &
                              ncou,mpiback,mpifront,tag_z_first,tag_z_second,work)
      if(mpifront /= MPI_PROC_NULL) &
        field_recv_front_d(:,:,:,1:nvar) = field_recv_front_h(:,:,:,1:nvar)
      if(mpiback /= MPI_PROC_NULL) &
        field_recv_back_d(:,:,:,1:nvar) = field_recv_back_h(:,:,:,1:nvar)
    endif

    nunpack = (im + 1) * (jm + 1) * nvar
    grid = dim3((nunpack + block%x - 1)/block%x,1,1)
    call unpack_field_z_kernel<<<grid,block>>>(field,field_recv_front_d,field_recv_back_d, &
                                               im,jm,km,hm,nvar, &
                                               merge(1,0,mpifront /= MPI_PROC_NULL), &
                                               merge(1,0,mpiback /= MPI_PROC_NULL))
    call sync_after_kernel('unpack_field_z_kernel')
  end subroutine exchange_field_z_halo_gpu

  subroutine exchange_diffusion_flux_sp_halo_gpu(work)
    use commarray_gpu, only: sigma_sp_d,qflux_sp_d
    use parallel, only: lio
    implicit none
    procedure(independent_host_pair_work),optional :: work

    if(.not.viscous_flux_sp_halo_reported) then
      if(lio) write(*,'(A)') 'ASTR_GPU_VISCOUS_FLUX_HALO_PAYLOAD=fp64'
      viscous_flux_sp_halo_reported=.true.
    endif
    call exchange_field_sp_halo_gpu(sigma_sp_d,6,work)
    call exchange_field_sp_halo_gpu(qflux_sp_d,3)
  end subroutine exchange_diffusion_flux_sp_halo_gpu

  subroutine exchange_field_sp_halo_gpu(field,nvar,work)
    use commvar, only: im,jm,km,hm
    use gpu_check, only: sync_after_kernel
    use parallel, only: isize,jsize,ksize
    use boundary_gpu, only: gpu_axis_is_physical
    implicit none

    integer,intent(in) :: nvar
    procedure(independent_host_pair_work),optional :: work
    real(4),device :: field(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:nvar)
    type(dim3) :: block,grid
    integer :: n

    block=dim3(256,1,1)

    if(isize>1) then
      call exchange_field_sp_x_halo_gpu(field,nvar,work)
    elseif(.not.gpu_axis_is_physical(1)) then
      n=(jm+1)*(km+1)*nvar
      grid=dim3((n+block%x-1)/block%x,1,1)
      call field_sp_qswap_x_kernel<<<grid,block>>>(field,im,jm,km,hm,nvar)
      call sync_after_kernel('field_sp_qswap_x_kernel')
    endif

    if(jsize>1) then
      if(isize==1) then
        call exchange_field_sp_y_halo_gpu(field,nvar,work)
      else
        call exchange_field_sp_y_halo_gpu(field,nvar)
      endif
    elseif(.not.gpu_axis_is_physical(2)) then
      n=(im+1)*(km+1)*nvar
      grid=dim3((n+block%x-1)/block%x,1,1)
      call field_sp_qswap_y_kernel<<<grid,block>>>(field,im,jm,km,hm,nvar)
      call sync_after_kernel('field_sp_qswap_y_kernel')
    endif

    if(ksize>1) then
      if(isize==1 .and. jsize==1) then
        call exchange_field_sp_z_halo_gpu(field,nvar,work)
      else
        call exchange_field_sp_z_halo_gpu(field,nvar)
      endif
    elseif(.not.gpu_axis_is_physical(3)) then
      n=(im+1)*(jm+1)*nvar
      grid=dim3((n+block%x-1)/block%x,1,1)
      call field_sp_qswap_z_kernel<<<grid,block>>>(field,im,jm,km,hm,nvar)
      call sync_after_kernel('field_sp_qswap_z_kernel')
    endif
  end subroutine exchange_field_sp_halo_gpu

  subroutine exchange_field_sp_x_halo_gpu(field,nvar,work)
    use mpi
    use commvar, only: im,jm,km,hm
    use gpu_check, only: sync_after_kernel
    use parallel, only: mpileft,mpiright
    implicit none

    integer,intent(in) :: nvar
    procedure(independent_host_pair_work),optional :: work
    real(4),device :: field(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:nvar)
    type(dim3) :: block,grid
    integer :: ncou,npack,nunpack

    call ensure_field_buffers(nvar)

    npack=hm*(jm+1)*(km+1)*nvar
    block=dim3(256,1,1)
    grid=dim3((npack+block%x-1)/block%x,1,1)

    call pack_field_sp_x_left_kernel<<<grid,block>>>(field,field_send_left_d,im,jm,km,hm,nvar)
    call sync_after_kernel('pack_field_sp_x_left_kernel')
    call pack_field_sp_x_right_kernel<<<grid,block>>>(field,field_send_right_d,im,jm,km,hm,nvar)
    call sync_after_kernel('pack_field_sp_x_right_kernel',.true.)

    ncou=hm*(jm+1)*(km+1)*nvar
    if(device_aware_transport_enabled) then
      call exchange_device_pair(field_send_left_d(:,:,:,1:nvar),field_send_right_d(:,:,:,1:nvar), &
                                field_recv_right_d(:,:,:,1:nvar),field_recv_left_d(:,:,:,1:nvar), &
                                ncou,mpileft,mpiright,tag_x_first,tag_x_second,work)
    else
      field_send_left_h(:,:,:,1:nvar)=field_send_left_d(:,:,:,1:nvar)
      field_send_right_h(:,:,:,1:nvar)=field_send_right_d(:,:,:,1:nvar)
      call exchange_host_pair(field_send_left_h(:,:,:,1:nvar),field_send_right_h(:,:,:,1:nvar), &
                              field_recv_right_h(:,:,:,1:nvar),field_recv_left_h(:,:,:,1:nvar), &
                              ncou,mpileft,mpiright,tag_x_first,tag_x_second,work)
      if(mpiright/=MPI_PROC_NULL) &
        field_recv_right_d(:,:,:,1:nvar)=field_recv_right_h(:,:,:,1:nvar)
      if(mpileft/=MPI_PROC_NULL) &
        field_recv_left_d(:,:,:,1:nvar)=field_recv_left_h(:,:,:,1:nvar)
    endif

    nunpack=(jm+1)*(km+1)*nvar
    grid=dim3((nunpack+block%x-1)/block%x,1,1)
    call unpack_field_sp_x_kernel<<<grid,block>>>(field,field_recv_right_d,field_recv_left_d, &
                                                  im,jm,km,hm,nvar, &
                                                  merge(1,0,mpiright/=MPI_PROC_NULL), &
                                                  merge(1,0,mpileft/=MPI_PROC_NULL))
    call sync_after_kernel('unpack_field_sp_x_kernel')
  end subroutine exchange_field_sp_x_halo_gpu

  subroutine exchange_field_sp_y_halo_gpu(field,nvar,work)
    use mpi
    use commvar, only: im,jm,km,hm
    use gpu_check, only: sync_after_kernel
    use parallel, only: mpidown,mpiup
    implicit none

    integer,intent(in) :: nvar
    procedure(independent_host_pair_work),optional :: work
    real(4),device :: field(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:nvar)
    type(dim3) :: block,grid
    integer :: ncou,npack,nunpack

    call ensure_field_y_buffers(nvar)

    npack=hm*(im+1)*(km+1)*nvar
    block=dim3(256,1,1)
    grid=dim3((npack+block%x-1)/block%x,1,1)

    call pack_field_sp_y_down_kernel<<<grid,block>>>(field,field_send_down_d,im,jm,km,hm,nvar)
    call sync_after_kernel('pack_field_sp_y_down_kernel')
    call pack_field_sp_y_up_kernel<<<grid,block>>>(field,field_send_up_d,im,jm,km,hm,nvar)
    call sync_after_kernel('pack_field_sp_y_up_kernel',.true.)

    ncou=hm*(im+1)*(km+1)*nvar
    if(device_aware_transport_enabled) then
      call exchange_device_pair(field_send_down_d(:,:,:,1:nvar),field_send_up_d(:,:,:,1:nvar), &
                                field_recv_up_d(:,:,:,1:nvar),field_recv_down_d(:,:,:,1:nvar), &
                                ncou,mpidown,mpiup,tag_y_first,tag_y_second,work)
    else
      field_send_down_h(:,:,:,1:nvar)=field_send_down_d(:,:,:,1:nvar)
      field_send_up_h(:,:,:,1:nvar)=field_send_up_d(:,:,:,1:nvar)
      call exchange_host_pair(field_send_down_h(:,:,:,1:nvar),field_send_up_h(:,:,:,1:nvar), &
                              field_recv_up_h(:,:,:,1:nvar),field_recv_down_h(:,:,:,1:nvar), &
                              ncou,mpidown,mpiup,tag_y_first,tag_y_second,work)
      if(mpiup/=MPI_PROC_NULL) &
        field_recv_up_d(:,:,:,1:nvar)=field_recv_up_h(:,:,:,1:nvar)
      if(mpidown/=MPI_PROC_NULL) &
        field_recv_down_d(:,:,:,1:nvar)=field_recv_down_h(:,:,:,1:nvar)
    endif

    nunpack=(im+1)*(km+1)*nvar
    grid=dim3((nunpack+block%x-1)/block%x,1,1)
    call unpack_field_sp_y_kernel<<<grid,block>>>(field,field_recv_up_d,field_recv_down_d, &
                                                  im,jm,km,hm,nvar, &
                                                  merge(1,0,mpiup/=MPI_PROC_NULL), &
                                                  merge(1,0,mpidown/=MPI_PROC_NULL))
    call sync_after_kernel('unpack_field_sp_y_kernel')
  end subroutine exchange_field_sp_y_halo_gpu

  subroutine exchange_field_sp_z_halo_gpu(field,nvar,work)
    use mpi
    use commvar, only: im,jm,km,hm
    use gpu_check, only: sync_after_kernel
    use parallel, only: mpiback,mpifront
    implicit none

    integer,intent(in) :: nvar
    procedure(independent_host_pair_work),optional :: work
    real(4),device :: field(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:nvar)
    type(dim3) :: block,grid
    integer :: ncou,npack,nunpack

    call ensure_field_z_buffers(nvar)

    npack=hm*(im+1)*(jm+1)*nvar
    block=dim3(256,1,1)
    grid=dim3((npack+block%x-1)/block%x,1,1)

    call pack_field_sp_z_back_kernel<<<grid,block>>>(field,field_send_back_d,im,jm,km,hm,nvar)
    call sync_after_kernel('pack_field_sp_z_back_kernel')
    call pack_field_sp_z_front_kernel<<<grid,block>>>(field,field_send_front_d,im,jm,km,hm,nvar)
    call sync_after_kernel('pack_field_sp_z_front_kernel',.true.)

    ncou=hm*(im+1)*(jm+1)*nvar
    if(device_aware_transport_enabled) then
      call exchange_device_pair(field_send_back_d(:,:,:,1:nvar),field_send_front_d(:,:,:,1:nvar), &
                                field_recv_front_d(:,:,:,1:nvar),field_recv_back_d(:,:,:,1:nvar), &
                                ncou,mpiback,mpifront,tag_z_first,tag_z_second,work)
    else
      field_send_back_h(:,:,:,1:nvar)=field_send_back_d(:,:,:,1:nvar)
      field_send_front_h(:,:,:,1:nvar)=field_send_front_d(:,:,:,1:nvar)
      call exchange_host_pair(field_send_back_h(:,:,:,1:nvar),field_send_front_h(:,:,:,1:nvar), &
                              field_recv_front_h(:,:,:,1:nvar),field_recv_back_h(:,:,:,1:nvar), &
                              ncou,mpiback,mpifront,tag_z_first,tag_z_second,work)
      if(mpifront/=MPI_PROC_NULL) &
        field_recv_front_d(:,:,:,1:nvar)=field_recv_front_h(:,:,:,1:nvar)
      if(mpiback/=MPI_PROC_NULL) &
        field_recv_back_d(:,:,:,1:nvar)=field_recv_back_h(:,:,:,1:nvar)
    endif

    nunpack=(im+1)*(jm+1)*nvar
    grid=dim3((nunpack+block%x-1)/block%x,1,1)
    call unpack_field_sp_z_kernel<<<grid,block>>>(field,field_recv_front_d,field_recv_back_d, &
                                                  im,jm,km,hm,nvar, &
                                                  merge(1,0,mpifront/=MPI_PROC_NULL), &
                                                  merge(1,0,mpiback/=MPI_PROC_NULL))
    call sync_after_kernel('unpack_field_sp_z_kernel')
  end subroutine exchange_field_sp_z_halo_gpu

  subroutine ensure_x_buffers()
    use commvar, only: jm,km,hm,numq
    implicit none

    if(allocated(x_send_left_d)) return

    allocate(x_send_left_d(0:hm,0:jm,0:km,1:numq))
    allocate(x_send_right_d(0:hm,0:jm,0:km,1:numq))
    allocate(x_recv_right_d(0:hm,0:jm,0:km,1:numq))
    allocate(x_recv_left_d(0:hm,0:jm,0:km,1:numq))

    allocate(x_send_left_h(0:hm,0:jm,0:km,1:numq))
    allocate(x_send_right_h(0:hm,0:jm,0:km,1:numq))
    allocate(x_recv_right_h(0:hm,0:jm,0:km,1:numq))
    allocate(x_recv_left_h(0:hm,0:jm,0:km,1:numq))
  end subroutine ensure_x_buffers

  subroutine ensure_x_filter_buffers()
    use commvar, only: jm,km,hm,numq
    implicit none

    if(allocated(x_halo_send_left_d)) return

    allocate(x_halo_send_left_d(0:hm-1,0:jm,0:km,1:numq))
    allocate(x_halo_send_right_d(0:hm-1,0:jm,0:km,1:numq))
    allocate(x_halo_recv_right_d(0:hm-1,0:jm,0:km,1:numq))
    allocate(x_halo_recv_left_d(0:hm-1,0:jm,0:km,1:numq))

    allocate(x_halo_send_left_h(0:hm-1,0:jm,0:km,1:numq))
    allocate(x_halo_send_right_h(0:hm-1,0:jm,0:km,1:numq))
    allocate(x_halo_recv_right_h(0:hm-1,0:jm,0:km,1:numq))
    allocate(x_halo_recv_left_h(0:hm-1,0:jm,0:km,1:numq))
  end subroutine ensure_x_filter_buffers

  subroutine ensure_field_buffers(nvar)
    use commvar, only: jm,km,hm
    implicit none
    integer,intent(in) :: nvar
    integer :: capacity

    if(nvar>max_field_vars) stop 'GPU field halo buffer nvar exceeds max_field_vars'
    capacity=6
    if(halo_pipeline_enabled) capacity=max_field_vars
    if(allocated(field_send_left_d)) then
      if(size(field_send_left_d,4)<nvar) stop 'GPU field x halo buffer is too small'
      return
    endif

    allocate(field_send_left_d(0:hm-1,0:jm,0:km,1:capacity))
    allocate(field_send_right_d(0:hm-1,0:jm,0:km,1:capacity))
    allocate(field_recv_right_d(0:hm-1,0:jm,0:km,1:capacity))
    allocate(field_recv_left_d(0:hm-1,0:jm,0:km,1:capacity))

    allocate(field_send_left_h(0:hm-1,0:jm,0:km,1:capacity))
    allocate(field_send_right_h(0:hm-1,0:jm,0:km,1:capacity))
    allocate(field_recv_right_h(0:hm-1,0:jm,0:km,1:capacity))
    allocate(field_recv_left_h(0:hm-1,0:jm,0:km,1:capacity))
  end subroutine ensure_field_buffers

  subroutine ensure_y_buffers()
    use commvar, only: im,km,hm,numq
    implicit none

    if(allocated(y_send_down_d)) return

    allocate(y_send_down_d(0:im,0:hm,0:km,1:numq))
    allocate(y_send_up_d(0:im,0:hm,0:km,1:numq))
    allocate(y_recv_up_d(0:im,0:hm,0:km,1:numq))
    allocate(y_recv_down_d(0:im,0:hm,0:km,1:numq))

    allocate(y_send_down_h(0:im,0:hm,0:km,1:numq))
    allocate(y_send_up_h(0:im,0:hm,0:km,1:numq))
    allocate(y_recv_up_h(0:im,0:hm,0:km,1:numq))
    allocate(y_recv_down_h(0:im,0:hm,0:km,1:numq))
  end subroutine ensure_y_buffers

  subroutine ensure_y_filter_buffers()
    use commvar, only: im,km,hm,numq
    implicit none

    if(allocated(y_halo_send_down_d)) return

    allocate(y_halo_send_down_d(0:im,0:hm-1,0:km,1:numq))
    allocate(y_halo_send_up_d(0:im,0:hm-1,0:km,1:numq))
    allocate(y_halo_recv_up_d(0:im,0:hm-1,0:km,1:numq))
    allocate(y_halo_recv_down_d(0:im,0:hm-1,0:km,1:numq))

    allocate(y_halo_send_down_h(0:im,0:hm-1,0:km,1:numq))
    allocate(y_halo_send_up_h(0:im,0:hm-1,0:km,1:numq))
    allocate(y_halo_recv_up_h(0:im,0:hm-1,0:km,1:numq))
    allocate(y_halo_recv_down_h(0:im,0:hm-1,0:km,1:numq))
  end subroutine ensure_y_filter_buffers

  subroutine ensure_z_buffers()
    use commvar, only: im,jm,hm,numq
    implicit none

    if(allocated(z_send_back_d)) return

    allocate(z_send_back_d(0:im,0:jm,0:hm,1:numq))
    allocate(z_send_front_d(0:im,0:jm,0:hm,1:numq))
    allocate(z_recv_front_d(0:im,0:jm,0:hm,1:numq))
    allocate(z_recv_back_d(0:im,0:jm,0:hm,1:numq))

    allocate(z_send_back_h(0:im,0:jm,0:hm,1:numq))
    allocate(z_send_front_h(0:im,0:jm,0:hm,1:numq))
    allocate(z_recv_front_h(0:im,0:jm,0:hm,1:numq))
    allocate(z_recv_back_h(0:im,0:jm,0:hm,1:numq))
  end subroutine ensure_z_buffers

  subroutine ensure_z_filter_buffers()
    use commvar, only: im,jm,hm,numq
    implicit none

    if(allocated(z_halo_send_back_d)) return

    allocate(z_halo_send_back_d(0:im,0:jm,0:hm-1,1:numq))
    allocate(z_halo_send_front_d(0:im,0:jm,0:hm-1,1:numq))
    allocate(z_halo_recv_front_d(0:im,0:jm,0:hm-1,1:numq))
    allocate(z_halo_recv_back_d(0:im,0:jm,0:hm-1,1:numq))

    allocate(z_halo_send_back_h(0:im,0:jm,0:hm-1,1:numq))
    allocate(z_halo_send_front_h(0:im,0:jm,0:hm-1,1:numq))
    allocate(z_halo_recv_front_h(0:im,0:jm,0:hm-1,1:numq))
    allocate(z_halo_recv_back_h(0:im,0:jm,0:hm-1,1:numq))
  end subroutine ensure_z_filter_buffers

  subroutine ensure_field_y_buffers(nvar)
    use commvar, only: im,km,hm
    implicit none
    integer,intent(in) :: nvar
    integer :: capacity

    if(nvar>max_field_vars) stop 'GPU field y halo buffer nvar exceeds max_field_vars'
    capacity=6
    if(halo_pipeline_enabled) capacity=max_field_vars
    if(allocated(field_send_down_d)) then
      if(size(field_send_down_d,4)<nvar) stop 'GPU field y halo buffer is too small'
      return
    endif

    allocate(field_send_down_d(0:im,0:hm-1,0:km,1:capacity))
    allocate(field_send_up_d(0:im,0:hm-1,0:km,1:capacity))
    allocate(field_recv_up_d(0:im,0:hm-1,0:km,1:capacity))
    allocate(field_recv_down_d(0:im,0:hm-1,0:km,1:capacity))

    allocate(field_send_down_h(0:im,0:hm-1,0:km,1:capacity))
    allocate(field_send_up_h(0:im,0:hm-1,0:km,1:capacity))
    allocate(field_recv_up_h(0:im,0:hm-1,0:km,1:capacity))
    allocate(field_recv_down_h(0:im,0:hm-1,0:km,1:capacity))
  end subroutine ensure_field_y_buffers

  subroutine ensure_field_z_buffers(nvar)
    use commvar, only: im,jm,hm
    implicit none
    integer,intent(in) :: nvar
    integer :: capacity

    if(nvar>max_field_vars) stop 'GPU field z halo buffer nvar exceeds max_field_vars'
    capacity=6
    if(halo_pipeline_enabled) capacity=max_field_vars
    if(allocated(field_send_back_d)) then
      if(size(field_send_back_d,4)<nvar) stop 'GPU field z halo buffer is too small'
      return
    endif

    allocate(field_send_back_d(0:im,0:jm,0:hm-1,1:capacity))
    allocate(field_send_front_d(0:im,0:jm,0:hm-1,1:capacity))
    allocate(field_recv_front_d(0:im,0:jm,0:hm-1,1:capacity))
    allocate(field_recv_back_d(0:im,0:jm,0:hm-1,1:capacity))

    allocate(field_send_back_h(0:im,0:jm,0:hm-1,1:capacity))
    allocate(field_send_front_h(0:im,0:jm,0:hm-1,1:capacity))
    allocate(field_recv_front_h(0:im,0:jm,0:hm-1,1:capacity))
    allocate(field_recv_back_h(0:im,0:jm,0:hm-1,1:capacity))
  end subroutine ensure_field_z_buffers
end module halo_exchange_gpu
