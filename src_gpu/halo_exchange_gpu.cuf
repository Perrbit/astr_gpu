                      y_recv_up_h,ncou,mpi_real8,mpiup,  tag_y_first, &
                      mpi_comm_world,status,ierr)
    call mpi_sendrecv(y_send_up_h,ncou,mpi_real8,mpiup,  tag_y_second, &
                      y_recv_down_h,ncou,mpi_real8,mpidown,tag_y_second, &
                      mpi_comm_world,status,ierr)

    y_recv_up_d = y_recv_up_h
    y_recv_down_d = y_recv_down_h

    nunpack = (im + 1) * (km + 1) * numq
    grid = dim3((nunpack + block%x - 1)/block%x,1,1)
    call unpack_y_kernel<<<grid,block>>>(y_recv_up_d,y_recv_down_d,im,jm,km,hm,numq, &
                                         merge(1,0,mpiup /= MPI_PROC_NULL), &
                                         merge(1,0,mpidown /= MPI_PROC_NULL))
