    i=mod(id,n1)
    h=mod(id/n1,n2)
    k=mod(id/(n1*n2),n3)
    m=id/(n1*n2*n3)+1
    if(m<=6) then
      send_down(i,h,k,m)=sigma_d(i,h+1,k,m)
      send_up(i,h,k,m)=sigma_d(i,jm-hm+h,k,m)
    else
      send_down(i,h,k,m)=qflux_d(i,h+1,k,m-6)
      send_up(i,h,k,m)=qflux_d(i,jm-hm+h,k,m-6)
    endif
  end subroutine pack_diffusion_y_fused_kernel

  attributes(global) subroutine unpack_diffusion_y_fused_kernel(recv_up,recv_down, &
                                                                 im,jm,km,hm,has_up,has_down)
    use commarray_gpu, only: sigma_d,qflux_d
    implicit none
    integer,value :: im,jm,km,hm,has_up,has_down
    real(8),device :: recv_up(0:im,0:hm-1,0:km,1:max_field_vars)
    real(8),device :: recv_down(0:im,0:hm-1,0:km,1:max_field_vars)
    integer :: id,i,h,k,m,nplane

    nplane=(im+1)*(km+1)*max_field_vars
