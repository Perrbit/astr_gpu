    i=mod(id,n1)
    j=mod(id/n1,n2)
    h=mod(id/(n1*n2),n3)
    m=id/(n1*n2*n3)+1
    if(m<=6) then
      send_back(i,j,h,m)=sigma_d(i,j,h+1,m)
      send_front(i,j,h,m)=sigma_d(i,j,km-hm+h,m)
    else
      send_back(i,j,h,m)=qflux_d(i,j,h+1,m-6)
      send_front(i,j,h,m)=qflux_d(i,j,km-hm+h,m-6)
    endif
  end subroutine pack_diffusion_z_fused_kernel

  attributes(global) subroutine unpack_diffusion_z_fused_kernel(recv_front,recv_back, &
