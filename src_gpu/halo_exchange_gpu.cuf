    call mpi_sendrecv(field_send_front_h(:,:,:,1:nvar),ncou,mpi_real8,mpifront,tag_z_second, &
                      field_recv_back_h(:,:,:,1:nvar), ncou,mpi_real8,mpiback, tag_z_second, &
