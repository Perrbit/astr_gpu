    j=mod(id/(im+1),jm+1)
    h=id/((im+1)*(jm+1))
    sendbuf(i,j,h,1)=q_d(i,j,km-hm+h,component)
  end subroutine pack_q_component_z_front_kernel

  attributes(global) subroutine unpack_q_component_z_kernel(recv_front,recv_back,im,jm,km,hm, &
                                                              component,has_front,has_back)
    use commarray_gpu, only: q_d
    implicit none
    integer,value :: im,jm,km,hm,component,has_front,has_back
    real(8),device :: recv_front(0:im,0:jm,0:hm-1,1:1)
    real(8),device :: recv_back(0:im,0:jm,0:hm-1,1:1)
    integer :: id,i,j,h,n

    n=(im+1)*(jm+1)*hm
    id=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    if(id>=n) return
    i=mod(id,im+1)
    j=mod(id/(im+1),jm+1)
    h=id/((im+1)*(jm+1))
    if(has_front/=0) q_d(i,j,km+1+h,component)=recv_front(i,j,h,1)
    if(has_back/=0) q_d(i,j,-hm+h,component)=recv_back(i,j,h,1)
  end subroutine unpack_q_component_z_kernel

  attributes(global) subroutine q_component_qswap_z_kernel(im,jm,km,hm,component)
    use commarray_gpu, only: q_d
    implicit none
    integer,value :: im,jm,km,hm,component
    integer :: id,i,j,h,n

    n=(im+1)*(jm+1)
    id=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    if(id>=n) return
    i=mod(id,im+1)
    j=id/(im+1)
    do h=1,hm
      q_d(i,j,-h,component)=q_d(i,j,km-h,component)
      q_d(i,j,km+h,component)=q_d(i,j,h,component)
    enddo
  end subroutine q_component_qswap_z_kernel

  attributes(global) subroutine pack_z_back_kernel(sendbuf,im,jm,km,hm,numq)
    use commarray_gpu, only: q_d
    implicit none
    integer,value :: im,jm,km,hm,numq
    real(8),device :: sendbuf(0:im,0:jm,0:hm,1:numq)
    integer :: id,i,j,h,m,n1,n2,n3

    n1 = im + 1
    n2 = jm + 1
    n3 = hm + 1
    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    if(id >= n1*n2*n3*numq) return

    i = mod(id,n1)
    j = mod(id/n1,n2)
    h = mod(id/(n1*n2),n3)
    m = id/(n1*n2*n3) + 1
    sendbuf(i,j,h,m) = q_d(i,j,h,m)
  end subroutine pack_z_back_kernel

  attributes(global) subroutine pack_z_front_kernel(sendbuf,im,jm,km,hm,numq)
    use commarray_gpu, only: q_d
    implicit none
    integer,value :: im,jm,km,hm,numq
    real(8),device :: sendbuf(0:im,0:jm,0:hm,1:numq)
    integer :: id,i,j,h,m,n1,n2,n3

    n1 = im + 1
    n2 = jm + 1
    n3 = hm + 1
    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    if(id >= n1*n2*n3*numq) return

    i = mod(id,n1)
    j = mod(id/n1,n2)
    h = mod(id/(n1*n2),n3)
    m = id/(n1*n2*n3) + 1
    sendbuf(i,j,h,m) = q_d(i,j,km-hm+h,m)
  end subroutine pack_z_front_kernel

  attributes(global) subroutine unpack_z_kernel(recv_front,recv_back,im,jm,km,hm,numq,has_front,has_back)
    use commarray_gpu, only: q_d
    implicit none
    integer,value :: im,jm,km,hm,numq,has_front,has_back
    real(8),device :: recv_front(0:im,0:jm,0:hm,1:numq)
    real(8),device :: recv_back(0:im,0:jm,0:hm,1:numq)
    integer :: id,i,j,h,m,nplane

    nplane = (im + 1) * (jm + 1) * numq
    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    if(id >= nplane) return

    i = mod(id,im+1)
    j = mod(id/(im+1),jm+1)
    m = id/((im+1)*(jm+1)) + 1

    do h=1,hm
      if(has_front /= 0) q_d(i,j,km+h,m) = recv_front(i,j,h,m)
    enddo
    if(has_front /= 0) q_d(i,j,km,m) = 0.5d0 * (q_d(i,j,km,m) + recv_front(i,j,0,m))

    do h=0,hm-1
      if(has_back /= 0) q_d(i,j,-hm+h,m) = recv_back(i,j,h,m)
    enddo
    if(has_back /= 0) q_d(i,j,0,m) = 0.5d0 * (q_d(i,j,0,m) + recv_back(i,j,hm,m))
  end subroutine unpack_z_kernel

  attributes(global) subroutine pack_z_halo_back_kernel(sendbuf,im,jm,km,hm,numq)
    use commarray_gpu, only: q_d
    implicit none
