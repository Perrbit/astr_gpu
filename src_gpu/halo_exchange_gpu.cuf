    if(id>=nplane) return
    i=mod(id,im+1)
    k=mod(id/(im+1),km+1)
    m=id/((im+1)*(km+1))+1
    do h=0,hm-1
      if(m<=6) then
        if(has_up/=0) sigma_d(i,jm+1+h,k,m)=recv_up(i,h,k,m)
        if(has_down/=0) sigma_d(i,-hm+h,k,m)=recv_down(i,h,k,m)
      else
        if(has_up/=0) qflux_d(i,jm+1+h,k,m-6)=recv_up(i,h,k,m)
        if(has_down/=0) qflux_d(i,-hm+h,k,m-6)=recv_down(i,h,k,m)
      endif
    enddo
  end subroutine unpack_diffusion_y_fused_kernel

  attributes(global) subroutine pack_diffusion_z_fused_kernel(send_back,send_front,im,jm,km,hm)
    use commarray_gpu, only: sigma_d,qflux_d
    implicit none
    integer,value :: im,jm,km,hm
    real(8),device :: send_back(0:im,0:jm,0:hm-1,1:max_field_vars)
    real(8),device :: send_front(0:im,0:jm,0:hm-1,1:max_field_vars)
    integer :: id,i,j,h,m,n1,n2,n3

    n1=im+1
