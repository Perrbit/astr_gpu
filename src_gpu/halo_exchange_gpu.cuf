  attributes(global) subroutine pack_field_sp_y_down_kernel(field,sendbuf,im,jm,km,hm,nvar)
    implicit none
    integer,value :: im,jm,km,hm,nvar
    real(4),device :: field(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:nvar)
    real(8),device :: sendbuf(0:im,0:hm-1,0:km,1:nvar)
    integer :: id,i,h,k,m,n1,n2,n3

    n1=im+1
