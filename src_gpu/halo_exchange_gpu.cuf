  attributes(global) subroutine pack_filter_scalar_y_down_kernel(sendbuf,im,jm,km,hm)
    use commarray_gpu, only: filter_work_d
    implicit none
    integer,value :: im,jm,km,hm
    real(8),device :: sendbuf(0:im,0:hm-1,0:km,1:1)
    integer :: id,i,h,k,n

    n=(im+1)*hm*(km+1)
    id=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    if(id>=n) return
    i=mod(id,im+1)
    h=mod(id/(im+1),hm)
    k=id/((im+1)*hm)
    sendbuf(i,h,k,1)=filter_work_d(i,h+1,k)
  end subroutine pack_filter_scalar_y_down_kernel

  attributes(global) subroutine pack_filter_scalar_y_up_kernel(sendbuf,im,jm,km,hm)
    use commarray_gpu, only: filter_work_d
    implicit none
    integer,value :: im,jm,km,hm
    real(8),device :: sendbuf(0:im,0:hm-1,0:km,1:1)
    integer :: id,i,h,k,n

    n=(im+1)*hm*(km+1)
    id=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    if(id>=n) return
    i=mod(id,im+1)
    h=mod(id/(im+1),hm)
    k=id/((im+1)*hm)
    sendbuf(i,h,k,1)=filter_work_d(i,jm-hm+h,k)
  end subroutine pack_filter_scalar_y_up_kernel

  attributes(global) subroutine unpack_filter_scalar_y_kernel(recv_up,recv_down,im,jm,km,hm,has_up,has_down)
    use commarray_gpu, only: filter_work_d
    implicit none
    integer,value :: im,jm,km,hm,has_up,has_down
    real(8),device :: recv_up(0:im,0:hm-1,0:km,1:1)
    real(8),device :: recv_down(0:im,0:hm-1,0:km,1:1)
    integer :: id,i,h,k,n

    n=(im+1)*hm*(km+1)
    id=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    if(id>=n) return
    i=mod(id,im+1)
    h=mod(id/(im+1),hm)
    k=id/((im+1)*hm)
    if(has_up/=0) filter_work_d(i,jm+1+h,k)=recv_up(i,h,k,1)
    if(has_down/=0) filter_work_d(i,-hm+h,k)=recv_down(i,h,k,1)
  end subroutine unpack_filter_scalar_y_kernel

  attributes(global) subroutine filter_scalar_qswap_y_kernel(im,jm,km,hm)
    use commarray_gpu, only: filter_work_d
    implicit none
    integer,value :: im,jm,km,hm
    integer :: id,i,k,h,n

    n=(im+1)*(km+1)
    id=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    if(id>=n) return
    i=mod(id,im+1)
    k=id/(im+1)
    do h=1,hm
      filter_work_d(i,-h,k)=filter_work_d(i,jm-h,k)
      filter_work_d(i,jm+h,k)=filter_work_d(i,h,k)
    enddo
  end subroutine filter_scalar_qswap_y_kernel

  attributes(global) subroutine copy_q_to_filter_scalar_y_halo_kernel(im,jm,km,hm,component)
    use commarray_gpu, only: q_d,filter_work_d
    implicit none
    integer,value :: im,jm,km,hm,component
    integer :: id,i,k,h,side,n

    n=(im+1)*(km+1)*2*hm
    id=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    if(id>=n) return
    i=mod(id,im+1)
    k=mod(id/(im+1),km+1)
    h=mod(id/((im+1)*(km+1)),hm)+1
    side=id/((im+1)*(km+1)*hm)
    if(side==0) then
      filter_work_d(i,-h,k)=q_d(i,-h,k,component)
    else
      filter_work_d(i,jm+h,k)=q_d(i,jm+h,k,component)
    endif
  end subroutine copy_q_to_filter_scalar_y_halo_kernel

  attributes(global) subroutine pack_q_component_z_back_kernel(sendbuf,im,jm,km,hm,component)
    use commarray_gpu, only: q_d
