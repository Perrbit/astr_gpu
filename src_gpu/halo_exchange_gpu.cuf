  subroutine ensure_x_buffers()
    use commvar, only: jm,km,hm,numq
    implicit none

    if(allocated(x_send_left_d)) return

    allocate(x_send_left_d(0:hm,0:jm,0:km,1:numq))
    allocate(x_send_right_d(0:hm,0:jm,0:km,1:numq))
    allocate(x_recv_right_d(0:hm,0:jm,0:km,1:numq))
    allocate(x_recv_left_d(0:hm,0:jm,0:km,1:numq))

    allocate(x_send_left_h(0:hm,0:jm,0:km,1:numq))
    allocate(x_send_right_h(0:hm,0:jm,0:km,1:numq))
    allocate(x_recv_right_h(0:hm,0:jm,0:km,1:numq))
    allocate(x_recv_left_h(0:hm,0:jm,0:km,1:numq))
  end subroutine ensure_x_buffers

  subroutine ensure_x_filter_buffers()
    use commvar, only: jm,km,hm,numq
    implicit none

    if(allocated(x_halo_send_left_d)) return

    allocate(x_halo_send_left_d(0:hm-1,0:jm,0:km,1:numq))
    allocate(x_halo_send_right_d(0:hm-1,0:jm,0:km,1:numq))
    allocate(x_halo_recv_right_d(0:hm-1,0:jm,0:km,1:numq))
    allocate(x_halo_recv_left_d(0:hm-1,0:jm,0:km,1:numq))

    allocate(x_halo_send_left_h(0:hm-1,0:jm,0:km,1:numq))
    allocate(x_halo_send_right_h(0:hm-1,0:jm,0:km,1:numq))
    allocate(x_halo_recv_right_h(0:hm-1,0:jm,0:km,1:numq))
    allocate(x_halo_recv_left_h(0:hm-1,0:jm,0:km,1:numq))
  end subroutine ensure_x_filter_buffers

  subroutine ensure_field_buffers(nvar)
    use commvar, only: jm,km,hm
    implicit none
    integer,intent(in) :: nvar
    integer,parameter :: max_field_vars = 6

    if(nvar>max_field_vars) stop 'GPU field halo buffer nvar exceeds max_field_vars'
    if(allocated(field_send_left_d)) return

    allocate(field_send_left_d(0:hm-1,0:jm,0:km,1:max_field_vars))
    allocate(field_send_right_d(0:hm-1,0:jm,0:km,1:max_field_vars))
    allocate(field_recv_right_d(0:hm-1,0:jm,0:km,1:max_field_vars))
    allocate(field_recv_left_d(0:hm-1,0:jm,0:km,1:max_field_vars))

    allocate(field_send_left_h(0:hm-1,0:jm,0:km,1:max_field_vars))
    allocate(field_send_right_h(0:hm-1,0:jm,0:km,1:max_field_vars))
    allocate(field_recv_right_h(0:hm-1,0:jm,0:km,1:max_field_vars))
    allocate(field_recv_left_h(0:hm-1,0:jm,0:km,1:max_field_vars))
  end subroutine ensure_field_buffers

  subroutine ensure_y_buffers()
    use commvar, only: im,km,hm,numq
    implicit none

    if(allocated(y_send_down_d)) return

    allocate(y_send_down_d(0:im,0:hm,0:km,1:numq))
    allocate(y_send_up_d(0:im,0:hm,0:km,1:numq))
    allocate(y_recv_up_d(0:im,0:hm,0:km,1:numq))
    allocate(y_recv_down_d(0:im,0:hm,0:km,1:numq))

    allocate(y_send_down_h(0:im,0:hm,0:km,1:numq))
    allocate(y_send_up_h(0:im,0:hm,0:km,1:numq))
    allocate(y_recv_up_h(0:im,0:hm,0:km,1:numq))
    allocate(y_recv_down_h(0:im,0:hm,0:km,1:numq))
  end subroutine ensure_y_buffers

  subroutine ensure_y_filter_buffers()
    use commvar, only: im,km,hm,numq
    implicit none

    if(allocated(y_halo_send_down_d)) return

    allocate(y_halo_send_down_d(0:im,0:hm-1,0:km,1:numq))
    allocate(y_halo_send_up_d(0:im,0:hm-1,0:km,1:numq))
    allocate(y_halo_recv_up_d(0:im,0:hm-1,0:km,1:numq))
    allocate(y_halo_recv_down_d(0:im,0:hm-1,0:km,1:numq))

    allocate(y_halo_send_down_h(0:im,0:hm-1,0:km,1:numq))
    allocate(y_halo_send_up_h(0:im,0:hm-1,0:km,1:numq))
    allocate(y_halo_recv_up_h(0:im,0:hm-1,0:km,1:numq))
    allocate(y_halo_recv_down_h(0:im,0:hm-1,0:km,1:numq))
  end subroutine ensure_y_filter_buffers

  subroutine ensure_z_buffers()
    use commvar, only: im,jm,hm,numq
    implicit none

    if(allocated(z_send_back_d)) return

    allocate(z_send_back_d(0:im,0:jm,0:hm,1:numq))
    allocate(z_send_front_d(0:im,0:jm,0:hm,1:numq))
    allocate(z_recv_front_d(0:im,0:jm,0:hm,1:numq))
    allocate(z_recv_back_d(0:im,0:jm,0:hm,1:numq))

    allocate(z_send_back_h(0:im,0:jm,0:hm,1:numq))
    allocate(z_send_front_h(0:im,0:jm,0:hm,1:numq))
    allocate(z_recv_front_h(0:im,0:jm,0:hm,1:numq))
    allocate(z_recv_back_h(0:im,0:jm,0:hm,1:numq))
  end subroutine ensure_z_buffers

  subroutine ensure_z_filter_buffers()
    use commvar, only: im,jm,hm,numq
    implicit none

    if(allocated(z_halo_send_back_d)) return

    allocate(z_halo_send_back_d(0:im,0:jm,0:hm-1,1:numq))
    allocate(z_halo_send_front_d(0:im,0:jm,0:hm-1,1:numq))
    allocate(z_halo_recv_front_d(0:im,0:jm,0:hm-1,1:numq))
    allocate(z_halo_recv_back_d(0:im,0:jm,0:hm-1,1:numq))

    allocate(z_halo_send_back_h(0:im,0:jm,0:hm-1,1:numq))
    allocate(z_halo_send_front_h(0:im,0:jm,0:hm-1,1:numq))
    allocate(z_halo_recv_front_h(0:im,0:jm,0:hm-1,1:numq))
    allocate(z_halo_recv_back_h(0:im,0:jm,0:hm-1,1:numq))
  end subroutine ensure_z_filter_buffers

  subroutine ensure_field_y_buffers(nvar)
    use commvar, only: im,km,hm
    implicit none
    integer,intent(in) :: nvar
    integer,parameter :: max_field_vars = 6

    if(nvar>max_field_vars) stop 'GPU field y halo buffer nvar exceeds max_field_vars'
    if(allocated(field_send_down_d)) return

    allocate(field_send_down_d(0:im,0:hm-1,0:km,1:max_field_vars))
    allocate(field_send_up_d(0:im,0:hm-1,0:km,1:max_field_vars))
    allocate(field_recv_up_d(0:im,0:hm-1,0:km,1:max_field_vars))
    allocate(field_recv_down_d(0:im,0:hm-1,0:km,1:max_field_vars))

    allocate(field_send_down_h(0:im,0:hm-1,0:km,1:max_field_vars))
    allocate(field_send_up_h(0:im,0:hm-1,0:km,1:max_field_vars))
    allocate(field_recv_up_h(0:im,0:hm-1,0:km,1:max_field_vars))
    allocate(field_recv_down_h(0:im,0:hm-1,0:km,1:max_field_vars))
  end subroutine ensure_field_y_buffers

  subroutine ensure_field_z_buffers(nvar)
    use commvar, only: im,jm,hm
    implicit none
    integer,intent(in) :: nvar
    integer,parameter :: max_field_vars = 6

    if(nvar>max_field_vars) stop 'GPU field z halo buffer nvar exceeds max_field_vars'
    if(allocated(field_send_back_d)) return

    allocate(field_send_back_d(0:im,0:jm,0:hm-1,1:max_field_vars))
    allocate(field_send_front_d(0:im,0:jm,0:hm-1,1:max_field_vars))
    allocate(field_recv_front_d(0:im,0:jm,0:hm-1,1:max_field_vars))
    allocate(field_recv_back_d(0:im,0:jm,0:hm-1,1:max_field_vars))

    allocate(field_send_back_h(0:im,0:jm,0:hm-1,1:max_field_vars))
    allocate(field_send_front_h(0:im,0:jm,0:hm-1,1:max_field_vars))
    allocate(field_recv_front_h(0:im,0:jm,0:hm-1,1:max_field_vars))
    allocate(field_recv_back_h(0:im,0:jm,0:hm-1,1:max_field_vars))
  end subroutine ensure_field_z_buffers
end module halo_exchange_gpu
