    if(allocated(x_send_right_d)) deallocate(x_send_right_d)
    if(allocated(x_recv_right_d)) deallocate(x_recv_right_d)
    if(allocated(x_recv_left_d)) deallocate(x_recv_left_d)
    if(allocated(x_send_left_h)) deallocate(x_send_left_h)
    if(allocated(x_send_right_h)) deallocate(x_send_right_h)
    if(allocated(x_recv_right_h)) deallocate(x_recv_right_h)
    if(allocated(x_recv_left_h)) deallocate(x_recv_left_h)
    if(allocated(x_halo_send_left_d)) deallocate(x_halo_send_left_d)
    if(allocated(x_halo_send_right_d)) deallocate(x_halo_send_right_d)
    if(allocated(x_halo_recv_right_d)) deallocate(x_halo_recv_right_d)
    if(allocated(x_halo_recv_left_d)) deallocate(x_halo_recv_left_d)
    if(allocated(x_halo_send_left_h)) deallocate(x_halo_send_left_h)
    if(allocated(x_halo_send_right_h)) deallocate(x_halo_send_right_h)
    if(allocated(x_halo_recv_right_h)) deallocate(x_halo_recv_right_h)
    if(allocated(x_halo_recv_left_h)) deallocate(x_halo_recv_left_h)
    if(allocated(y_send_down_d)) deallocate(y_send_down_d)
    if(allocated(y_send_up_d)) deallocate(y_send_up_d)
    if(allocated(y_recv_up_d)) deallocate(y_recv_up_d)
    if(allocated(y_recv_down_d)) deallocate(y_recv_down_d)
    if(allocated(y_send_down_h)) deallocate(y_send_down_h)
    if(allocated(y_send_up_h)) deallocate(y_send_up_h)
    if(allocated(y_recv_up_h)) deallocate(y_recv_up_h)
    if(allocated(y_recv_down_h)) deallocate(y_recv_down_h)
    if(allocated(y_halo_send_down_d)) deallocate(y_halo_send_down_d)
    if(allocated(y_halo_send_up_d)) deallocate(y_halo_send_up_d)
    if(allocated(y_halo_recv_up_d)) deallocate(y_halo_recv_up_d)
    if(allocated(y_halo_recv_down_d)) deallocate(y_halo_recv_down_d)
    if(allocated(y_halo_send_down_h)) deallocate(y_halo_send_down_h)
    if(allocated(y_halo_send_up_h)) deallocate(y_halo_send_up_h)
    if(allocated(y_halo_recv_up_h)) deallocate(y_halo_recv_up_h)
    if(allocated(y_halo_recv_down_h)) deallocate(y_halo_recv_down_h)
    if(allocated(z_send_back_d)) deallocate(z_send_back_d)
    if(allocated(z_send_front_d)) deallocate(z_send_front_d)
    if(allocated(z_recv_front_d)) deallocate(z_recv_front_d)
    if(allocated(z_recv_back_d)) deallocate(z_recv_back_d)
    if(allocated(z_send_back_h)) deallocate(z_send_back_h)
    if(allocated(z_send_front_h)) deallocate(z_send_front_h)
    if(allocated(z_recv_front_h)) deallocate(z_recv_front_h)
    if(allocated(z_recv_back_h)) deallocate(z_recv_back_h)
    if(allocated(z_halo_send_back_d)) deallocate(z_halo_send_back_d)
    if(allocated(z_halo_send_front_d)) deallocate(z_halo_send_front_d)
    if(allocated(z_halo_recv_front_d)) deallocate(z_halo_recv_front_d)
    if(allocated(z_halo_recv_back_d)) deallocate(z_halo_recv_back_d)
    if(allocated(z_halo_send_back_h)) deallocate(z_halo_send_back_h)
    if(allocated(z_halo_send_front_h)) deallocate(z_halo_send_front_h)
    if(allocated(z_halo_recv_front_h)) deallocate(z_halo_recv_front_h)
    if(allocated(z_halo_recv_back_h)) deallocate(z_halo_recv_back_h)
    if(allocated(field_send_left_d)) deallocate(field_send_left_d)
    if(allocated(field_send_right_d)) deallocate(field_send_right_d)
    if(allocated(field_recv_right_d)) deallocate(field_recv_right_d)
    if(allocated(field_recv_left_d)) deallocate(field_recv_left_d)
    if(allocated(field_send_left_h)) deallocate(field_send_left_h)
    if(allocated(field_send_right_h)) deallocate(field_send_right_h)
    if(allocated(field_recv_right_h)) deallocate(field_recv_right_h)
    if(allocated(field_recv_left_h)) deallocate(field_recv_left_h)
    if(allocated(field_send_down_d)) deallocate(field_send_down_d)
    if(allocated(field_send_up_d)) deallocate(field_send_up_d)
    if(allocated(field_recv_up_d)) deallocate(field_recv_up_d)
    if(allocated(field_recv_down_d)) deallocate(field_recv_down_d)
    if(allocated(field_send_down_h)) deallocate(field_send_down_h)
    if(allocated(field_send_up_h)) deallocate(field_send_up_h)
    if(allocated(field_recv_up_h)) deallocate(field_recv_up_h)
    if(allocated(field_recv_down_h)) deallocate(field_recv_down_h)
    if(allocated(field_send_back_d)) deallocate(field_send_back_d)
    if(allocated(field_send_front_d)) deallocate(field_send_front_d)
    if(allocated(field_recv_front_d)) deallocate(field_recv_front_d)
    if(allocated(field_recv_back_d)) deallocate(field_recv_back_d)
    if(allocated(field_send_back_h)) deallocate(field_send_back_h)
    if(allocated(field_send_front_h)) deallocate(field_send_front_h)
    if(allocated(field_recv_front_h)) deallocate(field_recv_front_h)
    if(allocated(field_recv_back_h)) deallocate(field_recv_back_h)
  end subroutine release_halo_exchange_buffers_gpu

  subroutine init_halo_transport_gpu()
    use mpi
    use parallel, only: isize,jsize,ksize
    use commvar, only: flowtype,ndims,lihomo,ljhomo,lkhomo
    use gpu_check, only: gpu_selective_sync_enabled,gpu_dependency_sync_enabled
    use halo_transport_gpu, only: begin_transport_setup,register_host_buffer,end_transport_setup
    logical :: pinned
    integer :: ierr,active_axes

    call begin_transport_setup(pinned)
    if(halo_pipeline_enabled) then
      if(gpu_selective_sync_enabled()) then
        print *, 'ASTR_GPU_HALO_TRANSPORT=pinned-pipeline does not support ASTR_GPU_SYNC_MODE=selective'
        call mpi_abort(MPI_COMM_WORLD,1,ierr)
      endif
      active_axes=merge(1,0,isize>1)+merge(1,0,jsize>1)+merge(1,0,ksize>1)
      if(trim(flowtype)/='tgv' .or. ndims/=3 .or. &
         .not.(lihomo .and. ljhomo .and. lkhomo) .or. active_axes<1) then
        print *, 'GPU halo pipeline currently requires periodic 3-D TGV with at least one MPI axis'
        call mpi_abort(MPI_COMM_WORLD,1,ierr)
      endif
      call configure_pipeline_axes((/isize>1,jsize>1,ksize>1/))
    elseif(gpu_dependency_sync_enabled()) then
      print *, 'ASTR_GPU_SYNC_MODE=dependency requires ASTR_GPU_HALO_TRANSPORT=pinned-pipeline'
      call mpi_abort(MPI_COMM_WORLD,1,ierr)
    endif
    if(pinned) then
      ! Allocate all transport families before collective registration admission.
      if(isize>1) then
        call ensure_x_buffers()
        call ensure_x_filter_buffers()
        if(halo_pipeline_enabled) then
          call ensure_field_buffers(max_field_vars)
        else
          call ensure_field_buffers(6)
        endif
        call register_host_buffer(x_send_left_h)
        call register_host_buffer(x_send_right_h)
        call register_host_buffer(x_recv_right_h)
        call register_host_buffer(x_recv_left_h)
        call register_host_buffer(x_halo_send_left_h)
        call register_host_buffer(x_halo_send_right_h)
        call register_host_buffer(x_halo_recv_right_h)
        call register_host_buffer(x_halo_recv_left_h)
        call register_host_buffer(field_send_left_h)
        call register_host_buffer(field_send_right_h)
        call register_host_buffer(field_recv_right_h)
        call register_host_buffer(field_recv_left_h)
      endif
      if(jsize>1) then
        call ensure_y_buffers()
        call ensure_y_filter_buffers()
        if(halo_pipeline_enabled) then
          call ensure_field_y_buffers(max_field_vars)
        else
          call ensure_field_y_buffers(6)
        endif
        call register_host_buffer(y_send_down_h)
        call register_host_buffer(y_send_up_h)
        call register_host_buffer(y_recv_up_h)
        call register_host_buffer(y_recv_down_h)
        call register_host_buffer(y_halo_send_down_h)
        call register_host_buffer(y_halo_send_up_h)
        call register_host_buffer(y_halo_recv_up_h)
        call register_host_buffer(y_halo_recv_down_h)
        call register_host_buffer(field_send_down_h)
        call register_host_buffer(field_send_up_h)
        call register_host_buffer(field_recv_up_h)
        call register_host_buffer(field_recv_down_h)
      endif
      if(ksize>1) then
        call ensure_z_buffers()
        call ensure_z_filter_buffers()
        if(halo_pipeline_enabled) then
          call ensure_field_z_buffers(max_field_vars)
        else
          call ensure_field_z_buffers(6)
        endif
        call register_host_buffer(z_send_back_h)
        call register_host_buffer(z_send_front_h)
        call register_host_buffer(z_recv_front_h)
        call register_host_buffer(z_recv_back_h)
        call register_host_buffer(z_halo_send_back_h)
        call register_host_buffer(z_halo_send_front_h)
        call register_host_buffer(z_halo_recv_front_h)
        call register_host_buffer(z_halo_recv_back_h)
        call register_host_buffer(field_send_back_h)
        call register_host_buffer(field_send_front_h)
        call register_host_buffer(field_recv_front_h)
        call register_host_buffer(field_recv_back_h)
      endif
    endif
    call end_transport_setup(pinned)
  end subroutine init_halo_transport_gpu

  attributes(global) subroutine pack_x_left_kernel(sendbuf,im,jm,km,hm,numq)
    use commarray_gpu, only: q_d
    implicit none
    integer,value :: im,jm,km,hm,numq
    real(8),device :: sendbuf(0:hm,0:jm,0:km,1:numq)
    integer :: id,h,j,k,m,n1,n2,n3

    n1 = hm + 1
    n2 = jm + 1
    n3 = km + 1
    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    if(id >= n1*n2*n3*numq) return

    h = mod(id,n1)
    j = mod(id/n1,n2)
    k = mod(id/(n1*n2),n3)
    m = id/(n1*n2*n3) + 1
    sendbuf(h,j,k,m) = q_d(h,j,k,m)
  end subroutine pack_x_left_kernel

  attributes(global) subroutine pack_x_right_kernel(sendbuf,im,jm,km,hm,numq)
    use commarray_gpu, only: q_d
    implicit none
    integer,value :: im,jm,km,hm,numq
    real(8),device :: sendbuf(0:hm,0:jm,0:km,1:numq)
    integer :: id,h,j,k,m,n1,n2,n3

    n1 = hm + 1
    n2 = jm + 1
    n3 = km + 1
    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    if(id >= n1*n2*n3*numq) return

    h = mod(id,n1)
    j = mod(id/n1,n2)
    k = mod(id/(n1*n2),n3)
    m = id/(n1*n2*n3) + 1
    sendbuf(h,j,k,m) = q_d(im-hm+h,j,k,m)
  end subroutine pack_x_right_kernel

  attributes(global) subroutine unpack_x_kernel(recv_right,recv_left,im,jm,km,hm,numq,has_right,has_left)
    use commarray_gpu, only: q_d
    implicit none
    integer,value :: im,jm,km,hm,numq,has_right,has_left
    real(8),device :: recv_right(0:hm,0:jm,0:km,1:numq)
    real(8),device :: recv_left(0:hm,0:jm,0:km,1:numq)
    integer :: id,h,j,k,m,nplane

    nplane = (jm + 1) * (km + 1) * numq
    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    if(id >= nplane) return

    j = mod(id,jm+1)
    k = mod(id/(jm+1),km+1)
    m = id/((jm+1)*(km+1)) + 1

    if(has_right /= 0) then
      do h=1,hm
        q_d(im+h,j,k,m) = recv_right(h,j,k,m)
      enddo
      q_d(im,j,k,m) = 0.5d0 * (q_d(im,j,k,m) + recv_right(0,j,k,m))
    endif

    if(has_left /= 0) then
      do h=0,hm-1
        q_d(-hm+h,j,k,m) = recv_left(h,j,k,m)
      enddo
      q_d(0,j,k,m) = 0.5d0 * (q_d(0,j,k,m) + recv_left(hm,j,k,m))
    endif
  end subroutine unpack_x_kernel

  attributes(global) subroutine pack_x_halo_left_kernel(sendbuf,im,jm,km,hm,numq)
    use commarray_gpu, only: q_d
    implicit none
    integer,value :: im,jm,km,hm,numq
    real(8),device :: sendbuf(0:hm-1,0:jm,0:km,1:numq)
    integer :: id,h,j,k,m,n1,n2,n3

    n1 = hm
    n2 = jm + 1
    n3 = km + 1
    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    if(id >= n1*n2*n3*numq) return

    h = mod(id,n1)
    j = mod(id/n1,n2)
    k = mod(id/(n1*n2),n3)
    m = id/(n1*n2*n3) + 1
    sendbuf(h,j,k,m) = q_d(h+1,j,k,m)
  end subroutine pack_x_halo_left_kernel

  attributes(global) subroutine pack_x_halo_right_kernel(sendbuf,im,jm,km,hm,numq)
    use commarray_gpu, only: q_d
    implicit none
    integer,value :: im,jm,km,hm,numq
    real(8),device :: sendbuf(0:hm-1,0:jm,0:km,1:numq)
    integer :: id,h,j,k,m,n1,n2,n3

    n1 = hm
    n2 = jm + 1
    n3 = km + 1
    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    if(id >= n1*n2*n3*numq) return

    h = mod(id,n1)
    j = mod(id/n1,n2)
    k = mod(id/(n1*n2),n3)
    m = id/(n1*n2*n3) + 1
    sendbuf(h,j,k,m) = q_d(im-hm+h,j,k,m)
  end subroutine pack_x_halo_right_kernel

  attributes(global) subroutine unpack_x_halo_kernel(recv_right,recv_left,im,jm,km,hm,numq,has_right,has_left)
    use commarray_gpu, only: q_d
    implicit none
    integer,value :: im,jm,km,hm,numq,has_right,has_left
    real(8),device :: recv_right(0:hm-1,0:jm,0:km,1:numq)
    real(8),device :: recv_left(0:hm-1,0:jm,0:km,1:numq)
    integer :: id,h,j,k,m,nplane

    nplane = (jm + 1) * (km + 1) * numq
    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    if(id >= nplane) return

    j = mod(id,jm+1)
    k = mod(id/(jm+1),km+1)
    m = id/((jm+1)*(km+1)) + 1

    do h=0,hm-1
      if(has_right /= 0) q_d(im+1+h,j,k,m) = recv_right(h,j,k,m)
      if(has_left /= 0) q_d(-hm+h,j,k,m) = recv_left(h,j,k,m)
    enddo
  end subroutine unpack_x_halo_kernel

  attributes(global) subroutine pack_y_down_kernel(sendbuf,im,jm,km,hm,numq)
    use commarray_gpu, only: q_d
    implicit none
    integer,value :: im,jm,km,hm,numq
    real(8),device :: sendbuf(0:im,0:hm,0:km,1:numq)
    integer :: id,i,h,k,m,n1,n2,n3

    n1 = im + 1
    n2 = hm + 1
    n3 = km + 1
    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    if(id >= n1*n2*n3*numq) return

    i = mod(id,n1)
    h = mod(id/n1,n2)
    k = mod(id/(n1*n2),n3)
    m = id/(n1*n2*n3) + 1
    sendbuf(i,h,k,m) = q_d(i,h,k,m)
  end subroutine pack_y_down_kernel

  attributes(global) subroutine pack_y_up_kernel(sendbuf,im,jm,km,hm,numq)
    use commarray_gpu, only: q_d
    implicit none
    integer,value :: im,jm,km,hm,numq
    real(8),device :: sendbuf(0:im,0:hm,0:km,1:numq)
    integer :: id,i,h,k,m,n1,n2,n3

    n1 = im + 1
    n2 = hm + 1
    n3 = km + 1
    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    if(id >= n1*n2*n3*numq) return

    i = mod(id,n1)
    h = mod(id/n1,n2)
    k = mod(id/(n1*n2),n3)
    m = id/(n1*n2*n3) + 1
    sendbuf(i,h,k,m) = q_d(i,jm-hm+h,k,m)
  end subroutine pack_y_up_kernel

  attributes(global) subroutine unpack_y_kernel(recv_up,recv_down,im,jm,km,hm,numq,has_up,has_down)
    use commarray_gpu, only: q_d
    implicit none
    integer,value :: im,jm,km,hm,numq,has_up,has_down
    real(8),device :: recv_up(0:im,0:hm,0:km,1:numq)
    real(8),device :: recv_down(0:im,0:hm,0:km,1:numq)
    integer :: id,i,h,k,m,nplane

    nplane = (im + 1) * (km + 1) * numq
    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    if(id >= nplane) return

    i = mod(id,im+1)
    k = mod(id/(im+1),km+1)
    m = id/((im+1)*(km+1)) + 1

    do h=1,hm
      if(has_up /= 0) q_d(i,jm+h,k,m) = recv_up(i,h,k,m)
    enddo
    if(has_up /= 0) q_d(i,jm,k,m) = 0.5d0 * (q_d(i,jm,k,m) + recv_up(i,0,k,m))

    do h=0,hm-1
      if(has_down /= 0) q_d(i,-hm+h,k,m) = recv_down(i,h,k,m)
    enddo
    if(has_down /= 0) q_d(i,0,k,m) = 0.5d0 * (q_d(i,0,k,m) + recv_down(i,hm,k,m))
  end subroutine unpack_y_kernel

