module halo_exchange_gpu
  use cudafor
  implicit none

  integer,parameter :: tag_x_first = 21001
  integer,parameter :: tag_x_second = 21002
  integer,parameter :: tag_y_first = 21003
  integer,parameter :: tag_y_second = 21004
  integer,parameter :: tag_z_first = 21005
  integer,parameter :: tag_z_second = 21006

  real(8),allocatable,device :: x_send_left_d(:,:,:,:),x_send_right_d(:,:,:,:)
  real(8),allocatable,device :: x_recv_right_d(:,:,:,:),x_recv_left_d(:,:,:,:)
  real(8),allocatable :: x_send_left_h(:,:,:,:),x_send_right_h(:,:,:,:)
  real(8),allocatable :: x_recv_right_h(:,:,:,:),x_recv_left_h(:,:,:,:)
  real(8),allocatable,device :: x_halo_send_left_d(:,:,:,:),x_halo_send_right_d(:,:,:,:)
  real(8),allocatable,device :: x_halo_recv_right_d(:,:,:,:),x_halo_recv_left_d(:,:,:,:)
  real(8),allocatable :: x_halo_send_left_h(:,:,:,:),x_halo_send_right_h(:,:,:,:)
  real(8),allocatable :: x_halo_recv_right_h(:,:,:,:),x_halo_recv_left_h(:,:,:,:)
  real(8),allocatable,device :: y_send_down_d(:,:,:,:),y_send_up_d(:,:,:,:)
  real(8),allocatable,device :: y_recv_up_d(:,:,:,:),y_recv_down_d(:,:,:,:)
  real(8),allocatable :: y_send_down_h(:,:,:,:),y_send_up_h(:,:,:,:)
  real(8),allocatable :: y_recv_up_h(:,:,:,:),y_recv_down_h(:,:,:,:)
  real(8),allocatable,device :: y_halo_send_down_d(:,:,:,:),y_halo_send_up_d(:,:,:,:)
  real(8),allocatable,device :: y_halo_recv_up_d(:,:,:,:),y_halo_recv_down_d(:,:,:,:)
  real(8),allocatable :: y_halo_send_down_h(:,:,:,:),y_halo_send_up_h(:,:,:,:)
  real(8),allocatable :: y_halo_recv_up_h(:,:,:,:),y_halo_recv_down_h(:,:,:,:)
  real(8),allocatable,device :: z_send_back_d(:,:,:,:),z_send_front_d(:,:,:,:)
  real(8),allocatable,device :: z_recv_front_d(:,:,:,:),z_recv_back_d(:,:,:,:)
  real(8),allocatable :: z_send_back_h(:,:,:,:),z_send_front_h(:,:,:,:)
  real(8),allocatable :: z_recv_front_h(:,:,:,:),z_recv_back_h(:,:,:,:)
  real(8),allocatable,device :: z_halo_send_back_d(:,:,:,:),z_halo_send_front_d(:,:,:,:)
  real(8),allocatable,device :: z_halo_recv_front_d(:,:,:,:),z_halo_recv_back_d(:,:,:,:)
  real(8),allocatable :: z_halo_send_back_h(:,:,:,:),z_halo_send_front_h(:,:,:,:)
  real(8),allocatable :: z_halo_recv_front_h(:,:,:,:),z_halo_recv_back_h(:,:,:,:)
  real(8),allocatable,device :: field_send_left_d(:,:,:,:),field_send_right_d(:,:,:,:)
  real(8),allocatable,device :: field_recv_right_d(:,:,:,:),field_recv_left_d(:,:,:,:)
  real(8),allocatable :: field_send_left_h(:,:,:,:),field_send_right_h(:,:,:,:)
  real(8),allocatable :: field_recv_right_h(:,:,:,:),field_recv_left_h(:,:,:,:)
  real(8),allocatable,device :: field_send_down_d(:,:,:,:),field_send_up_d(:,:,:,:)
  real(8),allocatable,device :: field_recv_up_d(:,:,:,:),field_recv_down_d(:,:,:,:)
  real(8),allocatable :: field_send_down_h(:,:,:,:),field_send_up_h(:,:,:,:)
  real(8),allocatable :: field_recv_up_h(:,:,:,:),field_recv_down_h(:,:,:,:)
  real(8),allocatable,device :: field_send_back_d(:,:,:,:),field_send_front_d(:,:,:,:)
  real(8),allocatable,device :: field_recv_front_d(:,:,:,:),field_recv_back_d(:,:,:,:)
  real(8),allocatable :: field_send_back_h(:,:,:,:),field_send_front_h(:,:,:,:)
  real(8),allocatable :: field_recv_front_h(:,:,:,:),field_recv_back_h(:,:,:,:)
contains
  attributes(global) subroutine pack_x_left_kernel(sendbuf,im,jm,km,hm,numq)
    use commarray_gpu, only: q_d
    implicit none
    integer,value :: im,jm,km,hm,numq
    real(8),device :: sendbuf(0:hm,0:jm,0:km,1:numq)
    integer :: id,h,j,k,m,n1,n2,n3

    n1 = hm + 1
    n2 = jm + 1
    n3 = km + 1
    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    if(id >= n1*n2*n3*numq) return

    h = mod(id,n1)
    j = mod(id/n1,n2)
    k = mod(id/(n1*n2),n3)
    m = id/(n1*n2*n3) + 1
    sendbuf(h,j,k,m) = q_d(h,j,k,m)
  end subroutine pack_x_left_kernel

  attributes(global) subroutine pack_x_right_kernel(sendbuf,im,jm,km,hm,numq)
    use commarray_gpu, only: q_d
    implicit none
    integer,value :: im,jm,km,hm,numq
    real(8),device :: sendbuf(0:hm,0:jm,0:km,1:numq)
    integer :: id,h,j,k,m,n1,n2,n3

    n1 = hm + 1
    n2 = jm + 1
    n3 = km + 1
    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    if(id >= n1*n2*n3*numq) return

    h = mod(id,n1)
    j = mod(id/n1,n2)
    k = mod(id/(n1*n2),n3)
    m = id/(n1*n2*n3) + 1
    sendbuf(h,j,k,m) = q_d(im-hm+h,j,k,m)
  end subroutine pack_x_right_kernel

  attributes(global) subroutine unpack_x_kernel(recv_right,recv_left,im,jm,km,hm,numq,has_right,has_left)
    use commarray_gpu, only: q_d
    implicit none
    integer,value :: im,jm,km,hm,numq,has_right,has_left
    real(8),device :: recv_right(0:hm,0:jm,0:km,1:numq)
    real(8),device :: recv_left(0:hm,0:jm,0:km,1:numq)
    integer :: id,h,j,k,m,nplane

    nplane = (jm + 1) * (km + 1) * numq
    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    if(id >= nplane) return

    j = mod(id,jm+1)
    k = mod(id/(jm+1),km+1)
    m = id/((jm+1)*(km+1)) + 1

    if(has_right /= 0) then
      do h=1,hm
        q_d(im+h,j,k,m) = recv_right(h,j,k,m)
      enddo
      q_d(im,j,k,m) = 0.5d0 * (q_d(im,j,k,m) + recv_right(0,j,k,m))
    endif

    if(has_left /= 0) then
      do h=0,hm-1
        q_d(-hm+h,j,k,m) = recv_left(h,j,k,m)
      enddo
      q_d(0,j,k,m) = 0.5d0 * (q_d(0,j,k,m) + recv_left(hm,j,k,m))
    endif
  end subroutine unpack_x_kernel

  attributes(global) subroutine pack_x_halo_left_kernel(sendbuf,im,jm,km,hm,numq)
    use commarray_gpu, only: q_d
    implicit none
    integer,value :: im,jm,km,hm,numq
    real(8),device :: sendbuf(0:hm-1,0:jm,0:km,1:numq)
    integer :: id,h,j,k,m,n1,n2,n3

    n1 = hm
    n2 = jm + 1
    n3 = km + 1
    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    if(id >= n1*n2*n3*numq) return

    h = mod(id,n1)
    j = mod(id/n1,n2)
    k = mod(id/(n1*n2),n3)
    m = id/(n1*n2*n3) + 1
    sendbuf(h,j,k,m) = q_d(h+1,j,k,m)
  end subroutine pack_x_halo_left_kernel

  attributes(global) subroutine pack_x_halo_right_kernel(sendbuf,im,jm,km,hm,numq)
    use commarray_gpu, only: q_d
    implicit none
    integer,value :: im,jm,km,hm,numq
    real(8),device :: sendbuf(0:hm-1,0:jm,0:km,1:numq)
    integer :: id,h,j,k,m,n1,n2,n3

    n1 = hm
    n2 = jm + 1
    n3 = km + 1
    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    if(id >= n1*n2*n3*numq) return

    h = mod(id,n1)
    j = mod(id/n1,n2)
    k = mod(id/(n1*n2),n3)
    m = id/(n1*n2*n3) + 1
    sendbuf(h,j,k,m) = q_d(im-hm+h,j,k,m)
  end subroutine pack_x_halo_right_kernel

  attributes(global) subroutine unpack_x_halo_kernel(recv_right,recv_left,im,jm,km,hm,numq,has_right,has_left)
    use commarray_gpu, only: q_d
    implicit none
    integer,value :: im,jm,km,hm,numq,has_right,has_left
    real(8),device :: recv_right(0:hm-1,0:jm,0:km,1:numq)
    real(8),device :: recv_left(0:hm-1,0:jm,0:km,1:numq)
    integer :: id,h,j,k,m,nplane

    nplane = (jm + 1) * (km + 1) * numq
    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    if(id >= nplane) return

    j = mod(id,jm+1)
    k = mod(id/(jm+1),km+1)
    m = id/((jm+1)*(km+1)) + 1

    do h=0,hm-1
      if(has_right /= 0) q_d(im+1+h,j,k,m) = recv_right(h,j,k,m)
      if(has_left /= 0) q_d(-hm+h,j,k,m) = recv_left(h,j,k,m)
    enddo
  end subroutine unpack_x_halo_kernel

  attributes(global) subroutine pack_y_down_kernel(sendbuf,im,jm,km,hm,numq)
    use commarray_gpu, only: q_d
    implicit none
    integer,value :: im,jm,km,hm,numq
    real(8),device :: sendbuf(0:im,0:hm,0:km,1:numq)
    integer :: id,i,h,k,m,n1,n2,n3

    n1 = im + 1
    n2 = hm + 1
    n3 = km + 1
    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    if(id >= n1*n2*n3*numq) return

    i = mod(id,n1)
    h = mod(id/n1,n2)
    k = mod(id/(n1*n2),n3)
    m = id/(n1*n2*n3) + 1
    sendbuf(i,h,k,m) = q_d(i,h,k,m)
  end subroutine pack_y_down_kernel

  attributes(global) subroutine pack_y_up_kernel(sendbuf,im,jm,km,hm,numq)
    use commarray_gpu, only: q_d
    implicit none
    integer,value :: im,jm,km,hm,numq
    real(8),device :: sendbuf(0:im,0:hm,0:km,1:numq)
    integer :: id,i,h,k,m,n1,n2,n3

    n1 = im + 1
    n2 = hm + 1
    n3 = km + 1
    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    if(id >= n1*n2*n3*numq) return

    i = mod(id,n1)
    h = mod(id/n1,n2)
    k = mod(id/(n1*n2),n3)
    m = id/(n1*n2*n3) + 1
    sendbuf(i,h,k,m) = q_d(i,jm-hm+h,k,m)
  end subroutine pack_y_up_kernel

  attributes(global) subroutine unpack_y_kernel(recv_up,recv_down,im,jm,km,hm,numq,has_up,has_down)
    use commarray_gpu, only: q_d
    implicit none
    integer,value :: im,jm,km,hm,numq,has_up,has_down
    real(8),device :: recv_up(0:im,0:hm,0:km,1:numq)
    real(8),device :: recv_down(0:im,0:hm,0:km,1:numq)
    integer :: id,i,h,k,m,nplane

    nplane = (im + 1) * (km + 1) * numq
    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    if(id >= nplane) return

    i = mod(id,im+1)
    k = mod(id/(im+1),km+1)
    m = id/((im+1)*(km+1)) + 1

    do h=1,hm
      if(has_up /= 0) q_d(i,jm+h,k,m) = recv_up(i,h,k,m)
    enddo
    if(has_up /= 0) q_d(i,jm,k,m) = 0.5d0 * (q_d(i,jm,k,m) + recv_up(i,0,k,m))

    do h=0,hm-1
      if(has_down /= 0) q_d(i,-hm+h,k,m) = recv_down(i,h,k,m)
    enddo
    if(has_down /= 0) q_d(i,0,k,m) = 0.5d0 * (q_d(i,0,k,m) + recv_down(i,hm,k,m))
  end subroutine unpack_y_kernel

  attributes(global) subroutine pack_y_halo_down_kernel(sendbuf,im,jm,km,hm,numq)
    use commarray_gpu, only: q_d
    implicit none
    integer,value :: im,jm,km,hm,numq
    real(8),device :: sendbuf(0:im,0:hm-1,0:km,1:numq)
    integer :: id,i,h,k,m,n1,n2,n3

    n1 = im + 1
    n2 = hm
    n3 = km + 1
    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    if(id >= n1*n2*n3*numq) return

    i = mod(id,n1)
    h = mod(id/n1,n2)
    k = mod(id/(n1*n2),n3)
    m = id/(n1*n2*n3) + 1
    sendbuf(i,h,k,m) = q_d(i,h+1,k,m)
  end subroutine pack_y_halo_down_kernel

  attributes(global) subroutine pack_y_halo_up_kernel(sendbuf,im,jm,km,hm,numq)
    use commarray_gpu, only: q_d
    implicit none
    integer,value :: im,jm,km,hm,numq
    real(8),device :: sendbuf(0:im,0:hm-1,0:km,1:numq)
    integer :: id,i,h,k,m,n1,n2,n3

    n1 = im + 1
    n2 = hm
    n3 = km + 1
    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    if(id >= n1*n2*n3*numq) return

    i = mod(id,n1)
    h = mod(id/n1,n2)
    k = mod(id/(n1*n2),n3)
    m = id/(n1*n2*n3) + 1
    sendbuf(i,h,k,m) = q_d(i,jm-hm+h,k,m)
  end subroutine pack_y_halo_up_kernel

  attributes(global) subroutine unpack_y_halo_kernel(recv_up,recv_down,im,jm,km,hm,numq,has_up,has_down)
    use commarray_gpu, only: q_d
    implicit none
    integer,value :: im,jm,km,hm,numq,has_up,has_down
    real(8),device :: recv_up(0:im,0:hm-1,0:km,1:numq)
    real(8),device :: recv_down(0:im,0:hm-1,0:km,1:numq)
    integer :: id,i,h,k,m,nplane

    nplane = (im + 1) * (km + 1) * numq
    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    if(id >= nplane) return

    i = mod(id,im+1)
    k = mod(id/(im+1),km+1)
    m = id/((im+1)*(km+1)) + 1

    do h=0,hm-1
      if(has_up /= 0) q_d(i,jm+1+h,k,m) = recv_up(i,h,k,m)
      if(has_down /= 0) q_d(i,-hm+h,k,m) = recv_down(i,h,k,m)
    enddo
  end subroutine unpack_y_halo_kernel

  attributes(global) subroutine pack_qwork_y_halo_down_kernel(sendbuf,im,jm,km,hm,numq)
    use commarray_gpu, only: qwork_d
    implicit none
    integer,value :: im,jm,km,hm,numq
    real(8),device :: sendbuf(0:im,0:hm-1,0:km,1:numq)
    integer :: id,i,h,k,m,n1,n2,n3

    n1 = im + 1
    n2 = hm
    n3 = km + 1
    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    if(id >= n1*n2*n3*numq) return

    i = mod(id,n1)
    h = mod(id/n1,n2)
    k = mod(id/(n1*n2),n3)
    m = id/(n1*n2*n3) + 1
    sendbuf(i,h,k,m) = qwork_d(i,h+1,k,m)
  end subroutine pack_qwork_y_halo_down_kernel

  attributes(global) subroutine pack_qwork_y_halo_up_kernel(sendbuf,im,jm,km,hm,numq)
    use commarray_gpu, only: qwork_d
    implicit none
    integer,value :: im,jm,km,hm,numq
    real(8),device :: sendbuf(0:im,0:hm-1,0:km,1:numq)
    integer :: id,i,h,k,m,n1,n2,n3

    n1 = im + 1
    n2 = hm
    n3 = km + 1
    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    if(id >= n1*n2*n3*numq) return

    i = mod(id,n1)
    h = mod(id/n1,n2)
    k = mod(id/(n1*n2),n3)
    m = id/(n1*n2*n3) + 1
    sendbuf(i,h,k,m) = qwork_d(i,jm-hm+h,k,m)
  end subroutine pack_qwork_y_halo_up_kernel

  attributes(global) subroutine unpack_qwork_y_halo_kernel(recv_up,recv_down,im,jm,km,hm,numq,has_up,has_down)
    use commarray_gpu, only: qwork_d
    implicit none
    integer,value :: im,jm,km,hm,numq,has_up,has_down
    real(8),device :: recv_up(0:im,0:hm-1,0:km,1:numq)
    real(8),device :: recv_down(0:im,0:hm-1,0:km,1:numq)
    integer :: id,i,h,k,m,nplane

    nplane = (im + 1) * (km + 1) * numq
    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    if(id >= nplane) return

    i = mod(id,im+1)
    k = mod(id/(im+1),km+1)
    m = id/((im+1)*(km+1)) + 1

    do h=0,hm-1
      if(has_up /= 0) qwork_d(i,jm+1+h,k,m) = recv_up(i,h,k,m)
      if(has_down /= 0) qwork_d(i,-hm+h,k,m) = recv_down(i,h,k,m)
    enddo
  end subroutine unpack_qwork_y_halo_kernel

  attributes(global) subroutine pack_z_back_kernel(sendbuf,im,jm,km,hm,numq)
    use commarray_gpu, only: q_d
    implicit none
    integer,value :: im,jm,km,hm,numq
    real(8),device :: sendbuf(0:im,0:jm,0:hm,1:numq)
    integer :: id,i,j,h,m,n1,n2,n3

    n1 = im + 1
    n2 = jm + 1
    n3 = hm + 1
    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    if(id >= n1*n2*n3*numq) return

    i = mod(id,n1)
    j = mod(id/n1,n2)
    h = mod(id/(n1*n2),n3)
    m = id/(n1*n2*n3) + 1
    sendbuf(i,j,h,m) = q_d(i,j,h,m)
  end subroutine pack_z_back_kernel

  attributes(global) subroutine pack_z_front_kernel(sendbuf,im,jm,km,hm,numq)
    use commarray_gpu, only: q_d
    implicit none
    integer,value :: im,jm,km,hm,numq
    real(8),device :: sendbuf(0:im,0:jm,0:hm,1:numq)
    integer :: id,i,j,h,m,n1,n2,n3

    n1 = im + 1
    n2 = jm + 1
    n3 = hm + 1
    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    if(id >= n1*n2*n3*numq) return

    i = mod(id,n1)
    j = mod(id/n1,n2)
    h = mod(id/(n1*n2),n3)
    m = id/(n1*n2*n3) + 1
    sendbuf(i,j,h,m) = q_d(i,j,km-hm+h,m)
  end subroutine pack_z_front_kernel

  attributes(global) subroutine unpack_z_kernel(recv_front,recv_back,im,jm,km,hm,numq,has_front,has_back)
    use commarray_gpu, only: q_d
    implicit none
    integer,value :: im,jm,km,hm,numq,has_front,has_back
    real(8),device :: recv_front(0:im,0:jm,0:hm,1:numq)
    real(8),device :: recv_back(0:im,0:jm,0:hm,1:numq)
    integer :: id,i,j,h,m,nplane

    nplane = (im + 1) * (jm + 1) * numq
    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    if(id >= nplane) return

    i = mod(id,im+1)
    j = mod(id/(im+1),jm+1)
    m = id/((im+1)*(jm+1)) + 1

    do h=1,hm
      if(has_front /= 0) q_d(i,j,km+h,m) = recv_front(i,j,h,m)
    enddo
    if(has_front /= 0) q_d(i,j,km,m) = 0.5d0 * (q_d(i,j,km,m) + recv_front(i,j,0,m))

    do h=0,hm-1
      if(has_back /= 0) q_d(i,j,-hm+h,m) = recv_back(i,j,h,m)
    enddo
    if(has_back /= 0) q_d(i,j,0,m) = 0.5d0 * (q_d(i,j,0,m) + recv_back(i,j,hm,m))
  end subroutine unpack_z_kernel

  attributes(global) subroutine pack_z_halo_back_kernel(sendbuf,im,jm,km,hm,numq)
    use commarray_gpu, only: q_d
    implicit none
    integer,value :: im,jm,km,hm,numq
    real(8),device :: sendbuf(0:im,0:jm,0:hm-1,1:numq)
    integer :: id,i,j,h,m,n1,n2,n3

    n1 = im + 1
    n2 = jm + 1
    n3 = hm
    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    if(id >= n1*n2*n3*numq) return

    i = mod(id,n1)
    j = mod(id/n1,n2)
    h = mod(id/(n1*n2),n3)
    m = id/(n1*n2*n3) + 1
    sendbuf(i,j,h,m) = q_d(i,j,h+1,m)
  end subroutine pack_z_halo_back_kernel

  attributes(global) subroutine pack_z_halo_front_kernel(sendbuf,im,jm,km,hm,numq)
    use commarray_gpu, only: q_d
    implicit none
    integer,value :: im,jm,km,hm,numq
    real(8),device :: sendbuf(0:im,0:jm,0:hm-1,1:numq)
    integer :: id,i,j,h,m,n1,n2,n3

    n1 = im + 1
    n2 = jm + 1
    n3 = hm
    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    if(id >= n1*n2*n3*numq) return

    i = mod(id,n1)
    j = mod(id/n1,n2)
    h = mod(id/(n1*n2),n3)
    m = id/(n1*n2*n3) + 1
    sendbuf(i,j,h,m) = q_d(i,j,km-hm+h,m)
  end subroutine pack_z_halo_front_kernel

  attributes(global) subroutine unpack_z_halo_kernel(recv_front,recv_back,im,jm,km,hm,numq,has_front,has_back)
    use commarray_gpu, only: q_d
    implicit none
    integer,value :: im,jm,km,hm,numq,has_front,has_back
    real(8),device :: recv_front(0:im,0:jm,0:hm-1,1:numq)
    real(8),device :: recv_back(0:im,0:jm,0:hm-1,1:numq)
    integer :: id,i,j,h,m,nplane

    nplane = (im + 1) * (jm + 1) * numq
    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    if(id >= nplane) return

    i = mod(id,im+1)
    j = mod(id/(im+1),jm+1)
    m = id/((im+1)*(jm+1)) + 1

    do h=0,hm-1
      if(has_front /= 0) q_d(i,j,km+1+h,m) = recv_front(i,j,h,m)
      if(has_back /= 0) q_d(i,j,-hm+h,m) = recv_back(i,j,h,m)
    enddo
  end subroutine unpack_z_halo_kernel

  attributes(global) subroutine q_halo_local_x_kernel(im,jm,km,hm,numq)
    use commarray_gpu, only: q_d
    implicit none
    integer,value :: im,jm,km,hm,numq
    integer :: id,j,k,m,h,nplane

    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    nplane = (jm + 1) * (km + 1) * numq
    if(id >= nplane) return
    j = mod(id,jm+1)
    k = mod(id/(jm+1),km+1)
    m = id/((jm+1)*(km+1)) + 1

    do h=1,hm
      q_d(-h,j,k,m) = q_d(im-h,j,k,m)
      q_d(im+h,j,k,m) = q_d(h,j,k,m)
    enddo
  end subroutine q_halo_local_x_kernel

  attributes(global) subroutine pack_field_x_left_kernel(field,sendbuf,im,jm,km,hm,nvar)
    implicit none
    integer,value :: im,jm,km,hm,nvar
    real(8),device :: field(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:nvar)
    real(8),device :: sendbuf(0:hm-1,0:jm,0:km,1:nvar)
    integer :: id,h,j,k,m,n1,n2,n3

    n1 = hm
    n2 = jm + 1
    n3 = km + 1
    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    if(id >= n1*n2*n3*nvar) return

    h = mod(id,n1)
    j = mod(id/n1,n2)
    k = mod(id/(n1*n2),n3)
    m = id/(n1*n2*n3) + 1
    sendbuf(h,j,k,m) = field(h+1,j,k,m)
  end subroutine pack_field_x_left_kernel

  attributes(global) subroutine pack_field_x_right_kernel(field,sendbuf,im,jm,km,hm,nvar)
    implicit none
    integer,value :: im,jm,km,hm,nvar
    real(8),device :: field(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:nvar)
    real(8),device :: sendbuf(0:hm-1,0:jm,0:km,1:nvar)
    integer :: id,h,j,k,m,n1,n2,n3

    n1 = hm
    n2 = jm + 1
    n3 = km + 1
    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    if(id >= n1*n2*n3*nvar) return

    h = mod(id,n1)
    j = mod(id/n1,n2)
    k = mod(id/(n1*n2),n3)
    m = id/(n1*n2*n3) + 1
    sendbuf(h,j,k,m) = field(im-hm+h,j,k,m)
  end subroutine pack_field_x_right_kernel

  attributes(global) subroutine unpack_field_x_kernel(field,recv_right,recv_left,im,jm,km,hm,nvar,has_right,has_left)
    implicit none
    integer,value :: im,jm,km,hm,nvar,has_right,has_left
    real(8),device :: field(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:nvar)
    real(8),device :: recv_right(0:hm-1,0:jm,0:km,1:nvar)
    real(8),device :: recv_left(0:hm-1,0:jm,0:km,1:nvar)
    integer :: id,h,j,k,m,nplane

    nplane = (jm + 1) * (km + 1) * nvar
    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    if(id >= nplane) return

    j = mod(id,jm+1)
    k = mod(id/(jm+1),km+1)
    m = id/((jm+1)*(km+1)) + 1

    if(has_right /= 0) then
      do h=0,hm-1
        field(im+1+h,j,k,m) = recv_right(h,j,k,m)
      enddo
    endif

    if(has_left /= 0) then
      do h=0,hm-1
        field(-hm+h,j,k,m) = recv_left(h,j,k,m)
      enddo
    endif
  end subroutine unpack_field_x_kernel

  attributes(global) subroutine pack_field_y_down_kernel(field,sendbuf,im,jm,km,hm,nvar)
    implicit none
    integer,value :: im,jm,km,hm,nvar
    real(8),device :: field(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:nvar)
    real(8),device :: sendbuf(0:im,0:hm-1,0:km,1:nvar)
    integer :: id,i,h,k,m,n1,n2,n3

    n1 = im + 1
    n2 = hm
    n3 = km + 1
    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    if(id >= n1*n2*n3*nvar) return

    i = mod(id,n1)
    h = mod(id/n1,n2)
    k = mod(id/(n1*n2),n3)
    m = id/(n1*n2*n3) + 1
    sendbuf(i,h,k,m) = field(i,h+1,k,m)
  end subroutine pack_field_y_down_kernel

  attributes(global) subroutine pack_field_y_up_kernel(field,sendbuf,im,jm,km,hm,nvar)
    implicit none
    integer,value :: im,jm,km,hm,nvar
    real(8),device :: field(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:nvar)
    real(8),device :: sendbuf(0:im,0:hm-1,0:km,1:nvar)
    integer :: id,i,h,k,m,n1,n2,n3

    n1 = im + 1
    n2 = hm
    n3 = km + 1
    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    if(id >= n1*n2*n3*nvar) return

    i = mod(id,n1)
    h = mod(id/n1,n2)
    k = mod(id/(n1*n2),n3)
    m = id/(n1*n2*n3) + 1
    sendbuf(i,h,k,m) = field(i,jm-hm+h,k,m)
  end subroutine pack_field_y_up_kernel

  attributes(global) subroutine unpack_field_y_kernel(field,recv_up,recv_down,im,jm,km,hm,nvar,has_up,has_down)
    implicit none
    integer,value :: im,jm,km,hm,nvar,has_up,has_down
    real(8),device :: field(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:nvar)
    real(8),device :: recv_up(0:im,0:hm-1,0:km,1:nvar)
    real(8),device :: recv_down(0:im,0:hm-1,0:km,1:nvar)
    integer :: id,i,h,k,m,nplane

    nplane = (im + 1) * (km + 1) * nvar
    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    if(id >= nplane) return

    i = mod(id,im+1)
    k = mod(id/(im+1),km+1)
    m = id/((im+1)*(km+1)) + 1

    do h=0,hm-1
      if(has_up /= 0) field(i,jm+1+h,k,m) = recv_up(i,h,k,m)
      if(has_down /= 0) field(i,-hm+h,k,m) = recv_down(i,h,k,m)
    enddo
  end subroutine unpack_field_y_kernel

  attributes(global) subroutine pack_field_z_back_kernel(field,sendbuf,im,jm,km,hm,nvar)
    implicit none
    integer,value :: im,jm,km,hm,nvar
    real(8),device :: field(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:nvar)
    real(8),device :: sendbuf(0:im,0:jm,0:hm-1,1:nvar)
    integer :: id,i,j,h,m,n1,n2,n3

    n1 = im + 1
    n2 = jm + 1
    n3 = hm
    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    if(id >= n1*n2*n3*nvar) return

    i = mod(id,n1)
    j = mod(id/n1,n2)
    h = mod(id/(n1*n2),n3)
    m = id/(n1*n2*n3) + 1
    sendbuf(i,j,h,m) = field(i,j,h+1,m)
  end subroutine pack_field_z_back_kernel

  attributes(global) subroutine pack_field_z_front_kernel(field,sendbuf,im,jm,km,hm,nvar)
    implicit none
    integer,value :: im,jm,km,hm,nvar
    real(8),device :: field(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:nvar)
    real(8),device :: sendbuf(0:im,0:jm,0:hm-1,1:nvar)
    integer :: id,i,j,h,m,n1,n2,n3

    n1 = im + 1
    n2 = jm + 1
    n3 = hm
    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    if(id >= n1*n2*n3*nvar) return

    i = mod(id,n1)
    j = mod(id/n1,n2)
    h = mod(id/(n1*n2),n3)
    m = id/(n1*n2*n3) + 1
    sendbuf(i,j,h,m) = field(i,j,km-hm+h,m)
  end subroutine pack_field_z_front_kernel

  attributes(global) subroutine unpack_field_z_kernel(field,recv_front,recv_back,im,jm,km,hm,nvar,has_front,has_back)
    implicit none
    integer,value :: im,jm,km,hm,nvar,has_front,has_back
    real(8),device :: field(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:nvar)
    real(8),device :: recv_front(0:im,0:jm,0:hm-1,1:nvar)
    real(8),device :: recv_back(0:im,0:jm,0:hm-1,1:nvar)
    integer :: id,i,j,h,m,nplane

    nplane = (im + 1) * (jm + 1) * nvar
    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    if(id >= nplane) return

    i = mod(id,im+1)
    j = mod(id/(im+1),jm+1)
    m = id/((im+1)*(jm+1)) + 1

    do h=0,hm-1
      if(has_front /= 0) field(i,j,km+1+h,m) = recv_front(i,j,h,m)
      if(has_back /= 0) field(i,j,-hm+h,m) = recv_back(i,j,h,m)
    enddo
  end subroutine unpack_field_z_kernel

  attributes(global) subroutine field_qswap_x_kernel(field,im,jm,km,hm,nvar)
    implicit none
    integer,value :: im,jm,km,hm,nvar
    real(8),device :: field(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:nvar)
    integer :: id,j,k,m,h,nplane

    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    nplane = (jm + 1) * (km + 1) * nvar
    if(id >= nplane) return
    j = mod(id,jm+1)
    k = mod(id/(jm+1),km+1)
    m = id/((jm+1)*(km+1)) + 1

    do h=1,hm
      field(-h,j,k,m) = field(im-h,j,k,m)
      field(im+h,j,k,m) = field(h,j,k,m)
    enddo
  end subroutine field_qswap_x_kernel

  attributes(global) subroutine field_qswap_y_kernel(field,im,jm,km,hm,nvar)
    implicit none
    integer,value :: im,jm,km,hm,nvar
    real(8),device :: field(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:nvar)
    integer :: id,i,k,m,h,nplane

    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    nplane = (im + 1) * (km + 1) * nvar
    if(id >= nplane) return
    i = mod(id,im+1)
    k = mod(id/(im+1),km+1)
    m = id/((im+1)*(km+1)) + 1

    do h=1,hm
      field(i,-h,k,m) = field(i,jm-h,k,m)
      field(i,jm+h,k,m) = field(i,h,k,m)
    enddo
  end subroutine field_qswap_y_kernel

  attributes(global) subroutine field_qswap_z_kernel(field,im,jm,km,hm,nvar)
    implicit none
    integer,value :: im,jm,km,hm,nvar
    real(8),device :: field(-hm:im+hm,-hm:jm+hm,-hm:km+hm,1:nvar)
    integer :: id,i,j,m,h,nplane

    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    nplane = (im + 1) * (jm + 1) * nvar
    if(id >= nplane) return
    i = mod(id,im+1)
    j = mod(id/(im+1),jm+1)
    m = id/((im+1)*(jm+1)) + 1

    do h=1,hm
      field(i,j,-h,m) = field(i,j,km-h,m)
      field(i,j,km+h,m) = field(i,j,h,m)
    enddo
  end subroutine field_qswap_z_kernel

  attributes(global) subroutine copy_q_to_qwork_y_halo_kernel(im,jm,km,hm,numq)
    use commarray_gpu, only: q_d,qwork_d
    implicit none
    integer,value :: im,jm,km,hm,numq
    integer :: id,i,k,m,h,side,nplane

    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    nplane = (im + 1) * (km + 1) * numq * 2 * hm
    if(id >= nplane) return

    i = mod(id,im+1)
    k = mod(id/(im+1),km+1)
    m = mod(id/((im+1)*(km+1)),numq) + 1
    h = mod(id/((im+1)*(km+1)*numq),hm) + 1
    side = id/((im+1)*(km+1)*numq*hm)

    if(side == 0) then
      qwork_d(i,-h,k,m) = q_d(i,-h,k,m)
    else
      qwork_d(i,jm+h,k,m) = q_d(i,jm+h,k,m)
    endif
  end subroutine copy_q_to_qwork_y_halo_kernel

  subroutine exchange_solution_halo_gpu(preserve_interior_primitives)
    use commvar, only: lihomo,ljhomo,lkhomo
    use parallel, only: isize,jsize,ksize
    use boundary_gpu, only: gpu_physical_boundary_axis
    use qswap_gpu, only: qswap_single_rank_gpu,qswap_local_x_gpu, &
                         qswap_local_y_gpu,qswap_local_z_gpu, &
                         refresh_primitive_halo_gpu, &
                         refresh_primitive_x_periodic_boundary_gpu, &
                         refresh_primitive_y_periodic_boundary_gpu, &
                         refresh_primitive_z_periodic_boundary_gpu
    implicit none
    logical,intent(in),optional :: preserve_interior_primitives
    integer :: zero_axis
    logical :: preserve_primitives

    zero_axis = gpu_physical_boundary_axis()
    preserve_primitives = .false.
    if(present(preserve_interior_primitives)) preserve_primitives = preserve_interior_primitives

    if(isize==1 .and. jsize==1 .and. ksize==1 .and. &
       lihomo .and. ljhomo .and. lkhomo) then
      if(preserve_primitives) stop 'preserved primitive refresh is not implemented for fully periodic GPU qswap'
      call qswap_single_rank_gpu()
      return
    endif

    if(preserve_primitives .and. zero_axis == 0) &
      stop 'preserved primitive refresh requires finite physical boundary case'

    if(isize>1) then
      call exchange_x_halo_gpu()
      if(preserve_primitives) call refresh_primitive_x_periodic_boundary_gpu()
    elseif(lihomo) then
      call qswap_local_x_gpu()
      if(preserve_primitives) call refresh_primitive_x_periodic_boundary_gpu()
    elseif(zero_axis == 1) then
      continue
    else
      stop 'GPU halo exchange requires x MPI or homogeneous x direction'
    endif

    if(jsize>1) then
      call exchange_y_halo_gpu()
      if(preserve_primitives) call refresh_primitive_y_periodic_boundary_gpu()
    elseif(ljhomo) then
      call qswap_local_y_gpu()
      if(preserve_primitives) call refresh_primitive_y_periodic_boundary_gpu()
    elseif(zero_axis == 2) then
      continue
    else
      stop 'GPU halo exchange requires y MPI or homogeneous y direction'
    endif

    if(ksize>1) then
      call exchange_z_halo_gpu()
      if(preserve_primitives) call refresh_primitive_z_periodic_boundary_gpu()
    elseif(lkhomo) then
      call qswap_local_z_gpu()
      if(preserve_primitives) call refresh_primitive_z_periodic_boundary_gpu()
    elseif(zero_axis == 3) then
      continue
    else
      stop 'GPU halo exchange requires z MPI or homogeneous z direction'
    endif

    if(.not.preserve_primitives) call refresh_primitive_halo_gpu()
  end subroutine exchange_solution_halo_gpu

  subroutine exchange_solution_filter_halo_gpu()
    use commvar, only: im,jm,km,hm,numq,lihomo
    use gpu_check, only: sync_after_kernel
    use parallel, only: isize,jsize,ksize
    implicit none
    type(dim3) :: block,grid
    integer :: n

    if(isize>1) then
      call exchange_x_filter_halo_gpu()
    elseif(lihomo) then
      block = dim3(256,1,1)
      n = (jm + 1) * (km + 1) * numq
      grid = dim3((n + block%x - 1)/block%x,1,1)
      call q_halo_local_x_kernel<<<grid,block>>>(im,jm,km,hm,numq)
      call sync_after_kernel('q_halo_local_x_kernel')
    endif
  end subroutine exchange_solution_filter_halo_gpu

  subroutine exchange_filter_y_work_halo_gpu()
    use mpi
    use commvar, only: im,jm,km,hm,numq
    use gpu_check, only: sync_after_kernel
    use parallel, only: jsize,mpidown,mpiup,status
    implicit none

    type(dim3) :: block,grid
    integer :: ncou,ierr,npack,nunpack

    if(jsize<=1) return

    call ensure_y_filter_buffers()

    npack = hm * (im + 1) * (km + 1) * numq
    block = dim3(256,1,1)
    grid = dim3((npack + block%x - 1)/block%x,1,1)

    call pack_qwork_y_halo_down_kernel<<<grid,block>>>(y_halo_send_down_d,im,jm,km,hm,numq)
    call sync_after_kernel('pack_qwork_y_halo_down_kernel')
    call pack_qwork_y_halo_up_kernel<<<grid,block>>>(y_halo_send_up_d,im,jm,km,hm,numq)
    call sync_after_kernel('pack_qwork_y_halo_up_kernel')

    y_halo_send_down_h = y_halo_send_down_d
    y_halo_send_up_h = y_halo_send_up_d

    ncou = size(y_halo_send_down_h)
    call mpi_sendrecv(y_halo_send_down_h,ncou,mpi_real8,mpidown,tag_y_first, &
                      y_halo_recv_up_h,ncou,mpi_real8,mpiup,  tag_y_first, &
                      mpi_comm_world,status,ierr)
    call mpi_sendrecv(y_halo_send_up_h,ncou,mpi_real8,mpiup,  tag_y_second, &
                      y_halo_recv_down_h,ncou,mpi_real8,mpidown,tag_y_second, &
                      mpi_comm_world,status,ierr)

    y_halo_recv_up_d = y_halo_recv_up_h
    y_halo_recv_down_d = y_halo_recv_down_h

    nunpack = (im + 1) * (km + 1) * numq
    grid = dim3((nunpack + block%x - 1)/block%x,1,1)
    call unpack_qwork_y_halo_kernel<<<grid,block>>>(y_halo_recv_up_d,y_halo_recv_down_d, &
                                                    im,jm,km,hm,numq, &
                                                    merge(1,0,mpiup /= MPI_PROC_NULL), &
                                                    merge(1,0,mpidown /= MPI_PROC_NULL))
    call sync_after_kernel('unpack_qwork_y_halo_kernel')
  end subroutine exchange_filter_y_work_halo_gpu

  subroutine refresh_filter_y_work_local_halo_gpu()
    use commarray_gpu, only: qwork_d
    use commvar, only: im,jm,km,hm,numq,ljhomo
    use gpu_check, only: sync_after_kernel
    use boundary_gpu, only: gpu_physical_boundary_axis
    implicit none

    type(dim3) :: block,grid
    integer :: n

    block = dim3(256,1,1)
    if(ljhomo) then
      n = (im + 1) * (km + 1) * numq
      grid = dim3((n + block%x - 1)/block%x,1,1)
      call field_qswap_y_kernel<<<grid,block>>>(qwork_d,im,jm,km,hm,numq)
      call sync_after_kernel('filter_qwork_local_y_halo_kernel')
    elseif(gpu_physical_boundary_axis() == 2) then
      n = (im + 1) * (km + 1) * numq * 2 * hm
      grid = dim3((n + block%x - 1)/block%x,1,1)
      call copy_q_to_qwork_y_halo_kernel<<<grid,block>>>(im,jm,km,hm,numq)
      call sync_after_kernel('copy_q_to_qwork_y_halo_kernel')
    else
      stop 'GPU filter y local halo requires homogeneous y or y-zeroextrap direction'
    endif
  end subroutine refresh_filter_y_work_local_halo_gpu

  subroutine exchange_filter_z_halo_gpu()
    use mpi
    use commvar, only: im,jm,km,hm,numq
    use gpu_check, only: sync_after_kernel
    use parallel, only: ksize,mpiback,mpifront,status
    implicit none

    type(dim3) :: block,grid
    integer :: ncou,ierr,npack,nunpack

    if(ksize<=1) return

    call ensure_z_filter_buffers()

    npack = hm * (im + 1) * (jm + 1) * numq
    block = dim3(256,1,1)
    grid = dim3((npack + block%x - 1)/block%x,1,1)

    call pack_z_halo_back_kernel<<<grid,block>>>(z_halo_send_back_d,im,jm,km,hm,numq)
    call sync_after_kernel('pack_z_halo_back_kernel')
    call pack_z_halo_front_kernel<<<grid,block>>>(z_halo_send_front_d,im,jm,km,hm,numq)
    call sync_after_kernel('pack_z_halo_front_kernel')

    z_halo_send_back_h = z_halo_send_back_d
    z_halo_send_front_h = z_halo_send_front_d

    ncou = size(z_halo_send_back_h)
    call mpi_sendrecv(z_halo_send_back_h,ncou,mpi_real8,mpiback, tag_z_first, &
                      z_halo_recv_front_h,ncou,mpi_real8,mpifront,tag_z_first, &
                      mpi_comm_world,status,ierr)
    call mpi_sendrecv(z_halo_send_front_h,ncou,mpi_real8,mpifront,tag_z_second, &
                      z_halo_recv_back_h, ncou,mpi_real8,mpiback, tag_z_second, &
                      mpi_comm_world,status,ierr)

    z_halo_recv_front_d = z_halo_recv_front_h
    z_halo_recv_back_d = z_halo_recv_back_h

    nunpack = (im + 1) * (jm + 1) * numq
    grid = dim3((nunpack + block%x - 1)/block%x,1,1)
    call unpack_z_halo_kernel<<<grid,block>>>(z_halo_recv_front_d,z_halo_recv_back_d, &
                                              im,jm,km,hm,numq, &
                                              merge(1,0,mpifront /= MPI_PROC_NULL), &
                                              merge(1,0,mpiback /= MPI_PROC_NULL))
    call sync_after_kernel('unpack_z_halo_kernel')
  end subroutine exchange_filter_z_halo_gpu

  subroutine refresh_filter_z_local_halo_gpu()
    use commarray_gpu, only: q_d
    use commvar, only: im,jm,km,hm,numq,lkhomo
    use gpu_check, only: sync_after_kernel
    implicit none

    type(dim3) :: block,grid
    integer :: n

    if(.not.lkhomo) return

    block = dim3(256,1,1)
    n = (im + 1) * (jm + 1) * numq
    grid = dim3((n + block%x - 1)/block%x,1,1)
    call field_qswap_z_kernel<<<grid,block>>>(q_d,im,jm,km,hm,numq)
    call sync_after_kernel('filter_q_local_z_halo_kernel')
  end subroutine refresh_filter_z_local_halo_gpu

  subroutine exchange_x_halo_gpu()
    use mpi
    use commvar, only: im,jm,km,hm,numq
    use gpu_check, only: sync_after_kernel
    use parallel, only: mpileft,mpiright,status
    implicit none

    type(dim3) :: block,grid
    integer :: ncou,ierr,npack,nunpack

    call ensure_x_buffers()

    npack = (hm + 1) * (jm + 1) * (km + 1) * numq
    block = dim3(256,1,1)
    grid = dim3((npack + block%x - 1)/block%x,1,1)

    call pack_x_left_kernel<<<grid,block>>>(x_send_left_d,im,jm,km,hm,numq)
    call sync_after_kernel('pack_x_left_kernel')
    call pack_x_right_kernel<<<grid,block>>>(x_send_right_d,im,jm,km,hm,numq)
    call sync_after_kernel('pack_x_right_kernel')

    x_send_left_h = x_send_left_d
    x_send_right_h = x_send_right_d

    ncou = size(x_send_left_h)
    call mpi_sendrecv(x_send_left_h,ncou,mpi_real8,mpileft, tag_x_first, &
                      x_recv_right_h,ncou,mpi_real8,mpiright,tag_x_first, &
                      mpi_comm_world,status,ierr)
    call mpi_sendrecv(x_send_right_h,ncou,mpi_real8,mpiright,tag_x_second, &
                      x_recv_left_h, ncou,mpi_real8,mpileft, tag_x_second, &
                      mpi_comm_world,status,ierr)

    x_recv_right_d = x_recv_right_h
    x_recv_left_d = x_recv_left_h

    nunpack = (jm + 1) * (km + 1) * numq
    grid = dim3((nunpack + block%x - 1)/block%x,1,1)
    call unpack_x_kernel<<<grid,block>>>(x_recv_right_d,x_recv_left_d,im,jm,km,hm,numq, &
                                         merge(1,0,mpiright /= MPI_PROC_NULL), &
                                         merge(1,0,mpileft /= MPI_PROC_NULL))
    call sync_after_kernel('unpack_x_kernel')
  end subroutine exchange_x_halo_gpu

