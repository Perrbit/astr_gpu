    npack = hm * (im + 1) * (km + 1) * nvar
    block = dim3(256,1,1)
    grid = dim3((npack + block%x - 1)/block%x,1,1)

    call pack_field_y_down_kernel<<<grid,block>>>(field,field_send_down_d,im,jm,km,hm,nvar)
    call sync_after_kernel('pack_field_y_down_kernel')
    call pack_field_y_up_kernel<<<grid,block>>>(field,field_send_up_d,im,jm,km,hm,nvar)
    call sync_after_kernel('pack_field_y_up_kernel')

    field_send_down_h(:,:,:,1:nvar) = field_send_down_d(:,:,:,1:nvar)
    field_send_up_h(:,:,:,1:nvar) = field_send_up_d(:,:,:,1:nvar)

    ncou = hm * (im + 1) * (km + 1) * nvar
    call mpi_sendrecv(field_send_down_h(:,:,:,1:nvar),ncou,mpi_real8,mpidown,tag_y_first, &
                      field_recv_up_h(:,:,:,1:nvar),ncou,mpi_real8,mpiup,  tag_y_first, &
                      mpi_comm_world,status,ierr)
    call mpi_sendrecv(field_send_up_h(:,:,:,1:nvar),ncou,mpi_real8,mpiup,  tag_y_second, &
                      field_recv_down_h(:,:,:,1:nvar),ncou,mpi_real8,mpidown,tag_y_second, &
                      mpi_comm_world,status,ierr)

    field_recv_up_d(:,:,:,1:nvar) = field_recv_up_h(:,:,:,1:nvar)
    field_recv_down_d(:,:,:,1:nvar) = field_recv_down_h(:,:,:,1:nvar)

    nunpack = (im + 1) * (km + 1) * nvar
    grid = dim3((nunpack + block%x - 1)/block%x,1,1)
    call unpack_field_y_kernel<<<grid,block>>>(field,field_recv_up_d,field_recv_down_d, &
                                               im,jm,km,hm,nvar, &
                                               merge(1,0,mpiup /= MPI_PROC_NULL), &
                                               merge(1,0,mpidown /= MPI_PROC_NULL))
    call sync_after_kernel('unpack_field_y_kernel')
  end subroutine exchange_field_y_halo_gpu

  subroutine exchange_field_z_halo_gpu(field,nvar)
    use mpi
    use commvar, only: im,jm,km,hm
    use gpu_check, only: sync_after_kernel
    use parallel, only: mpiback,mpifront,status
    implicit none

    integer,intent(in) :: nvar
