module crashfix_gpu
  use iso_fortran_env, only: int64
  use astr_precision, only: real_kind,clock_kind
  use astr_precision_mpi, only: mpi_real_type
  use cudafor
  implicit none
  private :: real_kind,clock_kind,mpi_real_type
  private
  public :: repair_crashfix_state_gpu,check_crashfix_state_gpu,release_crashfix_gpu
  public :: repair_reconciled_state_gpu
  integer(1),allocatable,device :: fluid_d(:,:,:)
  integer,allocatable,device :: first_d(:,:),last_d(:,:)
  real(real_kind),allocatable,device :: partial_d(:,:)
  real(real_kind),device :: minima_d(5),change_d(5)
  integer,device :: candidates_d=0,repaired_d=0,invalid_d=0
  integer,device :: donor_present_d=0,expanded_round_d=0,expanded_radius_d=0,single_donor_d=0
  real(real_kind),save :: eps_prs
  integer,save :: step_normal=0
  integer(int64),save :: report_visits=0,report_calls=0
  real(real_kind),save :: report_changes(5)=0.e0_real_kind,report_minima(4)=huge(0.e0_real_kind)
contains
  subroutine initialize_crashfix_gpu()
    use commvar, only: im,jm,km,nondimen,spcinf
    use commarray, only: nodestat
    use commarray_gpu, only: crinod_d,sync_crashfix_mask_to_gpu
    use fludyna, only: thermal
    implicit none
    if(allocated(fluid_d)) return
    allocate(fluid_d(0:im,0:jm,0:km),first_d(0:jm,0:km),last_d(0:jm,0:km))
    allocate(partial_d(5,((im+1)*(jm+1)*(km+1)+255)/256))
    fluid_d=int(merge(1,0,nodestat(0:im,0:jm,0:km)<=0),1)
    if(.not.allocated(crinod_d)) call sync_crashfix_mask_to_gpu()
    if(nondimen) then
      eps_prs=thermal(density=1.e-5_real_kind,temperature=1.e-5_real_kind)
    else
      eps_prs=thermal(density=1.e-5_real_kind,temperature=1.e-5_real_kind,species=spcinf)
    endif
  end subroutine initialize_crashfix_gpu

  attributes(device) subroutine refresh_point(i,j,k,const2,const6,nondimen,rgas,valid)
    use commarray_gpu, only: q_d,rho_d,vel_d,prs_d,tmp_d
    use mp_positivity_gpu, only: admissible_mp_state
    use qswap_gpu, only: q_to_primitive_point
    implicit none
    integer,value :: i,j,k
    real(real_kind),value :: const2,const6,rgas
    logical,value :: nondimen
    logical,intent(out) :: valid
    real(real_kind) :: state(5)
    state=q_d(i,j,k,:)
    valid=admissible_mp_state(state)
    if(valid) then
      call q_to_primitive_point(i,j,k,const2,const6)
      if(.not.nondimen) tmp_d(i,j,k)=prs_d(i,j,k)/rho_d(i,j,k)/rgas
      valid=abs(prs_d(i,j,k))<=huge(1.e0_real_kind).and.abs(tmp_d(i,j,k))<=huge(1.e0_real_kind).and. &
        prs_d(i,j,k)>0.e0_real_kind.and.tmp_d(i,j,k)>0.e0_real_kind
    else
      ! Mark unusable caches without dividing by an invalid density or editing q.
      rho_d(i,j,k)=state(1); vel_d(i,j,k,:)=0.e0_real_kind
      prs_d(i,j,k)=-1.e0_real_kind; tmp_d(i,j,k)=-1.e0_real_kind
    endif
  end subroutine refresh_point

  attributes(global) subroutine inspect_kernel(im,jm,km,const2,const6,nondimen,rgas,epsp,collect)
    use commarray_gpu, only: q_d,rho_d,prs_d,tmp_d,crinod_d
    implicit none
    integer,value :: im,jm,km
    real(real_kind),value :: const2,const6,rgas,epsp
    logical,value :: nondimen,collect
    real(real_kind),shared :: values(5,256)
    real(real_kind) :: eint
    integer :: id,i,j,k,t,stride,ignored
    logical :: valid,bad
    t=threadIdx%x
    id=(blockIdx%x-1)*blockDim%x+t-1
    values(1:4,t)=huge(1.e0_real_kind); values(5,t)=0.e0_real_kind
    if(id<(im+1)*(jm+1)*(km+1)) then
      i=mod(id,im+1); j=mod(id/(im+1),jm+1); k=id/((im+1)*(jm+1))
      call refresh_point(i,j,k,const2,const6,nondimen,rgas,valid)
      if(fluid_d(i,j,k)/=0) then
        if(valid) then
          eint=q_d(i,j,k,5)-sum(0.5e0_real_kind*q_d(i,j,k,2:4)*(q_d(i,j,k,2:4)/q_d(i,j,k,1)))
          valid=abs(eint)<=huge(1.e0_real_kind).and.eint>0.e0_real_kind
          if(valid) values(1:4,t)=[rho_d(i,j,k),prs_d(i,j,k),tmp_d(i,j,k),eint]
        endif
        if(.not.valid) ignored=atomicexch(invalid_d,1)
        bad=.not.(rho_d(i,j,k)>=1.e-5_real_kind.and.prs_d(i,j,k)>=epsp.and.tmp_d(i,j,k)>=1.e-5_real_kind)
        if(collect.and.bad) then
          ignored=atomicadd(candidates_d,1)
          ignored=atomicmin(first_d(j,k),i)
          ignored=atomicmax(last_d(j,k),i)
        endif
        if(crinod_d(i,j,k)) values(5,t)=1.e0_real_kind
      endif
    endif
    call syncthreads()
    stride=128
    do while(stride>0)
      if(t<=stride) then
        values(1:4,t)=min(values(1:4,t),values(1:4,t+stride))
        values(5,t)=values(5,t)+values(5,t+stride)
      endif
      call syncthreads()
      stride=stride/2
    enddo
    if(t==1) partial_d(:,blockIdx%x)=values(:,1)
  end subroutine inspect_kernel

  attributes(global) subroutine ordered_repair_kernel(im,jm,km,ig0,jg0,ia,ja, &
                                                     const2,const6,nondimen,rgas,epsp)
    use commarray_gpu, only: q_d,rho_d,prs_d,tmp_d,crinod_d
    implicit none
    integer,value :: im,jm,km,ig0,jg0,ia,ja
    real(real_kind),value :: const2,const6,rgas,epsp
    logical,value :: nondimen
    real(real_kind) :: average(5),previous(5)
    integer :: i,j,k,ii,jj,kk,norm
    logical :: valid
    ! Only exceptional rows are visited. In-place k/j/i and kk/jj/ii order
    ! matches the CPU: later bad nodes may use an already repaired neighbor.
    do k=0,km
    do j=0,jm
    do i=first_d(j,k),last_d(j,k)
      if(fluid_d(i,j,k)==0) cycle
      if(rho_d(i,j,k)>=1.e-5_real_kind.and.prs_d(i,j,k)>=epsp.and.tmp_d(i,j,k)>=1.e-5_real_kind) cycle
      crinod_d(i,j,k)=.true.
      average=0.e0_real_kind; norm=0
      do kk=-1,1
      do jj=-1,1
      do ii=-1,1
        if(ii==0.and.jj==0.and.kk==0) cycle
        if(ig0+i+ii<0.or.ig0+i+ii>ia.or.jg0+j+jj<0.or.jg0+j+jj>ja) cycle
        if(rho_d(i+ii,j+jj,k+kk)>=0.e0_real_kind.and.prs_d(i+ii,j+jj,k+kk)>=0.e0_real_kind.and. &
           tmp_d(i+ii,j+jj,k+kk)>=0.e0_real_kind) then
          average=average+q_d(i+ii,j+jj,k+kk,:)
          norm=norm+1
        endif
      enddo
      enddo
      enddo
      if(norm<1) cycle
      previous=q_d(i,j,k,:)
      q_d(i,j,k,:)=average/dble(norm)
      call refresh_point(i,j,k,const2,const6,nondimen,rgas,valid)
      if(valid) then
        average=q_d(i,j,k,:)
        call record_repair_change(previous,average)
        repaired_d=repaired_d+1
      endif
    enddo
    enddo
    enddo
  end subroutine ordered_repair_kernel

  attributes(device) subroutine record_repair_change(previous,current)
    real(real_kind),intent(in) :: previous(5),current(5)
    real(real_kind) :: baseline(5),difference(5)
    ! A difference from NaN/Inf is undefined; report the replacement magnitude.
    baseline=previous
    where(.not.(abs(baseline)<=huge(1.e0_real_kind))) baseline=0.e0_real_kind
    difference=abs(current-baseline)
    where(.not.(difference<=huge(1.e0_real_kind))) difference=huge(1.e0_real_kind)
    change_d=max(change_d,difference)
  end subroutine record_repair_change

  attributes(device) logical function recovery_state_valid(state,const2,const6,nondimen,rgas)
    use mp_positivity_gpu, only: admissible_mp_state
    real(real_kind),intent(in) :: state(5)
    real(real_kind),value :: const2,const6,rgas
    logical,value :: nondimen
    real(real_kind) :: u1,u2,u3,pressure,temperature
    recovery_state_valid=.false.
    if(.not.admissible_mp_state(state)) return
    u1=state(2)/state(1); u2=state(3)/state(1); u3=state(4)/state(1)
    pressure=(state(5)-0.5e0_real_kind*state(1)*(u1*u1+u2*u2+u3*u3))/const6
    temperature=pressure/state(1)*const2
    if(.not.nondimen) temperature=pressure/state(1)/rgas
    recovery_state_valid=pressure>0.e0_real_kind.and.temperature>0.e0_real_kind.and. &
      abs(pressure)<=huge(1.e0_real_kind).and.abs(temperature)<=huge(1.e0_real_kind)
  end function recovery_state_valid

  attributes(device) logical function usable_recovery_donor(i,j,k,im,jm,km,const2,const6,nondimen,rgas)
    use commarray_gpu, only: q_d
    integer,value :: i,j,k,im,jm,km
    real(real_kind),value :: const2,const6,rgas
    logical,value :: nondimen
    real(real_kind) :: state(5)
    usable_recovery_donor=.false.
    if(i>=0.and.i<=im.and.j>=0.and.j<=jm.and.k>=0.and.k<=km) then
      if(fluid_d(i,j,k)==0) return
    endif
    ! Halo-only exchanges supply faces, not arbitrary diagonal halo corners.
    if(count([i<0.or.i>im,j<0.or.j>jm,k<0.or.k>km])>1) return
    state=q_d(i,j,k,:)
    usable_recovery_donor=recovery_state_valid(state,const2,const6,nondimen,rgas)
  end function usable_recovery_donor

  attributes(global) subroutine find_recovery_donor_kernel(im,jm,km,ilo,ihi,jlo,jhi,klo,khi, &
                                                           const2,const6,nondimen,rgas)
    integer,value :: im,jm,km,ilo,ihi,jlo,jhi,klo,khi
    real(real_kind),value :: const2,const6,rgas
    logical,value :: nondimen
    integer :: id,i,j,k,ni,nj,nk,ignored
    ni=ihi-ilo+1; nj=jhi-jlo+1; nk=khi-klo+1
    id=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    if(id>=ni*nj*nk) return
    i=ilo+mod(id,ni); j=jlo+mod(id/ni,nj); k=klo+id/(ni*nj)
    if(usable_recovery_donor(i,j,k,im,jm,km,const2,const6,nondimen,rgas)) &
      ignored=atomicexch(donor_present_d,1)
  end subroutine find_recovery_donor_kernel

  attributes(device) subroutine add_recovery_donor(i,j,k,im,jm,km,const2,const6,nondimen,rgas,average,first,n)
    use commarray_gpu, only: q_d
    integer,value :: i,j,k,im,jm,km
    real(real_kind),value :: const2,const6,rgas
    logical,value :: nondimen
    real(real_kind),intent(inout) :: average(5),first(5)
    integer,intent(inout) :: n
    real(real_kind) :: weight
    if(.not.usable_recovery_donor(i,j,k,im,jm,km,const2,const6,nondimen,rgas)) return
    n=n+1
    if(n==1) first=q_d(i,j,k,:)
    weight=1.e0_real_kind/real(n,real_kind)
    average=(1.e0_real_kind-weight)*average+weight*q_d(i,j,k,:)
  end subroutine add_recovery_donor

  attributes(global) subroutine expanded_repair_kernel(im,jm,km,ilo,ihi,jlo,jhi,klo,khi, &
                                                       const2,const6,nondimen,rgas)
    use commarray_gpu, only: q_d,crinod_d
    integer,value :: im,jm,km,ilo,ihi,jlo,jhi,klo,khi
    real(real_kind),value :: const2,const6,rgas
    logical,value :: nondimen
    real(real_kind) :: average(5),first(5),previous(5)
    integer :: i,j,k,ii,jj,kk,n,radius,max_radius,used_radius
    logical :: valid
    if(donor_present_d==0) return
    do k=0,km
    do j=0,jm
    do i=first_d(j,k),last_d(j,k)
      if(fluid_d(i,j,k)==0) cycle
      previous=q_d(i,j,k,:)
      if(recovery_state_valid(previous,const2,const6,nondimen,rgas)) cycle
      average=0.e0_real_kind; first=0.e0_real_kind; n=0; valid=.false.
      max_radius=max(i-ilo,ihi-i,j-jlo,jhi-j,k-klo,khi-k)
      used_radius=0
      do radius=1,max_radius
        used_radius=radius
        ! Visit each new cube shell once; do not rescan its interior.
        do kk=max(klo,k-radius),min(khi,k+radius)
        do jj=max(jlo,j-radius),min(jhi,j+radius)
          if(abs(kk-k)==radius.or.abs(jj-j)==radius) then
            do ii=max(ilo,i-radius),min(ihi,i+radius)
              call add_recovery_donor(ii,jj,kk,im,jm,km,const2,const6,nondimen,rgas,average,first,n)
            enddo
          else
            ii=i-radius
            if(ii>=ilo) call add_recovery_donor(ii,jj,kk,im,jm,km,const2,const6,nondimen,rgas,average,first,n)
            ii=i+radius
            if(ii<=ihi) call add_recovery_donor(ii,jj,kk,im,jm,km,const2,const6,nondimen,rgas,average,first,n)
          endif
        enddo
        enddo
        if(n==0) cycle
        if(.not.recovery_state_valid(average,const2,const6,nondimen,rgas)) cycle
        q_d(i,j,k,:)=average
        call refresh_point(i,j,k,const2,const6,nondimen,rgas,valid)
        if(valid) exit
        q_d(i,j,k,:)=previous
      enddo
      if(.not.valid.and.n>0) then
        ! Last resort: the one-point mean of the nearest admissible shell.
        q_d(i,j,k,:)=first
        call refresh_point(i,j,k,const2,const6,nondimen,rgas,valid)
        if(valid) single_donor_d=single_donor_d+1
      endif
      if(valid) then
        crinod_d(i,j,k)=.true.
        average=q_d(i,j,k,:)
        call record_repair_change(previous,average)
        repaired_d=repaired_d+1
        expanded_round_d=expanded_round_d+1
        expanded_radius_d=max(expanded_radius_d,used_radius)
      else
        q_d(i,j,k,:)=previous
        call refresh_point(i,j,k,const2,const6,nondimen,rgas,valid)
      endif
    enddo
    enddo
    enddo
  end subroutine expanded_repair_kernel

  subroutine expand_crashfix_gpu(stage,global_invalid)
    use mpi
    use commvar, only: im,jm,km,hm,ia,ja,ka,lihomo,ljhomo,lkhomo,const2,const6,nondimen,rgas,nstep
    use parallel, only: ig0,jg0,kg0,lio
    use commarray_gpu, only: q_d
    use halo_exchange_gpu, only: exchange_field_halo_gpu
    use gpu_check, only: sync_after_kernel
    use benchmark_runtime, only: benchmark_buffered_output_enabled
    integer,intent(in) :: stage
    integer,intent(inout) :: global_invalid
    integer :: lo(3),hi(3),n,local,progress,ierr,rounds,total,diagnostics(2)
    lo=max([-hm,-hm,-hm],-[ig0,jg0,kg0])
    hi=min([im+hm,jm+hm,km+hm],[ia,ja,ka]-[ig0,jg0,kg0])
    if(lihomo) then
      lo(1)=-hm; hi(1)=im+hm
    endif
    if(ljhomo) then
      lo(2)=-hm; hi(2)=jm+hm
    endif
    if(lkhomo) then
      lo(3)=-hm; hi(3)=km+hm
    endif
    rounds=0; total=0; expanded_radius_d=0; single_donor_d=0
    do while(global_invalid/=0)
      rounds=rounds+1
      ! Do not average shared nodes while a replica may still contain NaN.
      call exchange_field_halo_gpu(q_d,5)
      call inspect_state(.true.)
      donor_present_d=0; expanded_round_d=0
      n=product(hi-lo+1)
      call find_recovery_donor_kernel<<<(n+255)/256,256>>>(im,jm,km,lo(1),hi(1),lo(2),hi(2),lo(3),hi(3), &
        const2,const6,nondimen,rgas)
      call sync_after_kernel('crashfix_find_expanded_donor',.true.)
      call expanded_repair_kernel<<<1,1>>>(im,jm,km,lo(1),hi(1),lo(2),hi(2),lo(3),hi(3), &
        const2,const6,nondimen,rgas)
      call sync_after_kernel('crashfix_expanded_repair_kernel',.true.)
      call inspect_state(.false.)
      local=invalid_d
      call MPI_Allreduce(local,global_invalid,1,MPI_INTEGER,MPI_MAX,MPI_COMM_WORLD,ierr)
      local=expanded_round_d
      call MPI_Allreduce(local,progress,1,MPI_INTEGER,MPI_SUM,MPI_COMM_WORLD,ierr)
      total=total+progress
      ! Each successful round repairs at least one node; no arbitrary retry cap.
      if(progress==0) exit
    enddo
    diagnostics=[expanded_radius_d,single_donor_d]
    call MPI_Allreduce(MPI_IN_PLACE,diagnostics,2,MPI_INTEGER,MPI_MAX,MPI_COMM_WORLD,ierr)
    if(lio.and..not.benchmark_buffered_output_enabled()) write(*,'(a,6(1x,i0))') &
      'ASTR_GPU_CRASHFIX_EXPANDED',nstep,stage,rounds,total,diagnostics
    if(global_invalid/=0.and.lio) print *, 'Expanded GPU crashfix cannot find further admissible donor averages'
  end subroutine expand_crashfix_gpu

  attributes(global) subroutine reduce_kernel(n)
    implicit none
    integer,value :: n
    real(real_kind),shared :: values(5,256)
    integer :: t,b,stride
    t=threadIdx%x
    values(1:4,t)=huge(1.e0_real_kind); values(5,t)=0.e0_real_kind
    do b=t,n,256
      values(1:4,t)=min(values(1:4,t),partial_d(1:4,b))
      values(5,t)=values(5,t)+partial_d(5,b)
    enddo
    call syncthreads()
    stride=128
    do while(stride>0)
      if(t<=stride) then
        values(1:4,t)=min(values(1:4,t),values(1:4,t+stride))
        values(5,t)=values(5,t)+values(5,t+stride)
      endif
      call syncthreads()
      stride=stride/2
    enddo
    if(t==1) minima_d=values(:,1)
  end subroutine reduce_kernel

  subroutine inspect_state(collect)
    use commvar, only: im,jm,km,const2,const6,nondimen,rgas
    use gpu_check, only: sync_after_kernel
    implicit none
    logical,intent(in) :: collect
    call initialize_crashfix_gpu()
    invalid_d=0
    if(collect) then
      candidates_d=0; first_d=im+1; last_d=-1
    endif
    call inspect_kernel<<<size(partial_d,2),256>>>(im,jm,km,const2,const6,nondimen,rgas,eps_prs,collect)
    call sync_after_kernel('crashfix_inspect_kernel',.true.)
  end subroutine inspect_state

  attributes(global) subroutine refresh_recovery_halos_kernel(im,jm,km,hm,const2,const6,nondimen,rgas)
    use commarray_gpu, only: rho_d,vel_d,prs_d,tmp_d
    integer,value :: im,jm,km,hm
    real(real_kind),value :: const2,const6,rgas
    logical,value :: nondimen
    integer :: id,i,j,k,ni,nj,nk,outside
    logical :: valid
    ni=im+2*hm+1; nj=jm+2*hm+1; nk=km+2*hm+1
    id=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    if(id>=ni*nj*nk) return
    i=mod(id,ni)-hm; j=mod(id/ni,nj)-hm; k=id/(ni*nj)-hm
    outside=count([i<0.or.i>im,j<0.or.j>jm,k<0.or.k>km])
    if(outside==0) return
    if(outside>1) then
      ! Face exchanges do not establish diagonal halo donors.
      rho_d(i,j,k)=-1.e0_real_kind; vel_d(i,j,k,:)=0.e0_real_kind
      prs_d(i,j,k)=-1.e0_real_kind; tmp_d(i,j,k)=-1.e0_real_kind
    else
      call refresh_point(i,j,k,const2,const6,nondimen,rgas,valid)
    endif
  end subroutine refresh_recovery_halos_kernel

  subroutine repair_reconciled_state_gpu(stage,already_repaired)
    use commvar, only: im,jm,km,hm,const2,const6,nondimen,rgas
    use commarray_gpu, only: q_d
    use halo_exchange_gpu, only: exchange_field_halo_gpu,exchange_solution_halo_gpu
    use mp_positivity_gpu, only: mp_inputs_need_repair_gpu
    use gpu_check, only: sync_after_kernel
    integer,intent(in) :: stage
    logical,intent(in),optional :: already_repaired
    logical :: repair_required
    integer :: n
    n=(im+2*hm+1)*(jm+2*hm+1)*(km+2*hm+1)
    repair_required=.true.
    if(present(already_repaired)) repair_required=.not.already_repaired
    do
      ! Preserve valid shared replicas until all physical states are repaired.
      if(repair_required) then
        call exchange_field_halo_gpu(q_d,5)
        call refresh_recovery_halos_kernel<<<(n+255)/256,256>>>(im,jm,km,hm,const2,const6,nondimen,rgas)
        call sync_after_kernel('crashfix_refresh_recovery_halos',.true.)
        call repair_crashfix_state_gpu(stage)
      endif
      call exchange_solution_halo_gpu()
      if(.not.mp_inputs_need_repair_gpu()) exit
      repair_required=.true.
    enddo
  end subroutine repair_reconciled_state_gpu

  subroutine check_crashfix_state_gpu()
    use mpi
    use commvar, only: numq,num_species,lcomb
    implicit none
    integer :: local,global,ierr
    if(lcomb.or.numq/=5.or.num_species/=0) error stop 'GPU crashfix supports only non-reacting five-variable flow'
    call inspect_state(.false.)
    local=invalid_d
    call MPI_Allreduce(local,global,1,MPI_INTEGER,MPI_MAX,MPI_COMM_WORLD,ierr)
    if(global/=0) then
      call repair_reconciled_state_gpu(0)
    endif
  end subroutine check_crashfix_state_gpu

  subroutine repair_crashfix_state_gpu(stage,repaired)
    use benchmark_runtime, only: benchmark_buffered_output_enabled
    use mpi
    use commvar, only: im,jm,km,ia,ja,const2,const6,nondimen,rgas,nstep,ctime,lreport
    use parallel, only: ig0,jg0,lio,ptime
    use gpu_check, only: sync_after_kernel
    implicit none
    integer,intent(in) :: stage
    logical,intent(out),optional :: repaired
    integer :: count,local,global,ierr,counter,critical
    real(clock_kind) :: started
    real(real_kind) :: changes(5),lower(5)
    started=ptime()
    call inspect_state(.true.)
    count=candidates_d
    repaired_d=0; change_d=0.e0_real_kind
    if(count>0) then
      call ordered_repair_kernel<<<1,1>>>(im,jm,km,ig0,jg0,ia,ja,const2,const6,nondimen,rgas,eps_prs)
      call sync_after_kernel('crashfix_ordered_repair_kernel',.true.)
      call inspect_state(.false.)
    endif
    local=invalid_d
    call MPI_Allreduce(local,global,1,MPI_INTEGER,MPI_MAX,MPI_COMM_WORLD,ierr)
    if(global/=0) call expand_crashfix_gpu(stage,global)
    call reduce_kernel<<<1,256>>>(size(partial_d,2))
    call sync_after_kernel('crashfix_reduce_kernel',.true.)
    count=repaired_d
    call MPI_Allreduce(count,counter,1,MPI_INTEGER,MPI_SUM,MPI_COMM_WORLD,ierr)
    if(present(repaired)) repaired=counter>0
    changes=change_d; lower=minima_d
    call MPI_Allreduce(MPI_IN_PLACE,changes,5,mpi_real_type,MPI_MAX,MPI_COMM_WORLD,ierr)
    critical=nint(lower(5))
    call MPI_Allreduce(MPI_IN_PLACE,lower,4,mpi_real_type,MPI_MIN,MPI_COMM_WORLD,ierr)
    if(counter==0) then
      step_normal=step_normal+1
    else
      step_normal=0
    endif
    if(lio) then
      if(benchmark_buffered_output_enabled()) then
        report_visits=report_visits+int(counter,int64)
        if(counter>0) report_calls=report_calls+1
        report_changes=max(report_changes,changes)
        report_minima=min(report_minima,lower(1:4))
      else
        write(*,'(A,3(1X,I0),9(1X,ES24.16E3))') &
          'ASTR_GPU_CRASHFIX',nstep,stage,counter,changes,lower(1:4)
      endif
    endif
    if(lreport.and..not.benchmark_buffered_output_enabled()) then
      call MPI_Allreduce(MPI_IN_PLACE,critical,1,MPI_INTEGER,MPI_SUM,MPI_COMM_WORLD,ierr)
      if(lio.and.step_normal>0) write(*,'(A,I0,A)') '  ** the comput. been normal for: ',step_normal,' steps'
      if(lio) write(*,'(A,I0,A)') '  ** ',critical,' critical nodes'
    endif
    ctime(16)=ctime(16)+ptime()-started
    if(global/=0) then
      print *, 'GPU crashfix left a nonfinite or non-positive physical state'
      call MPI_Abort(MPI_COMM_WORLD,92,ierr)
    endif
  end subroutine repair_crashfix_state_gpu

  subroutine release_crashfix_gpu()
    use benchmark_runtime, only: benchmark_buffered_output_enabled
    use parallel, only: lio
    implicit none
    if(allocated(fluid_d).and.lio.and.benchmark_buffered_output_enabled()) then
      write(*,'(A,2(1X,I0),9(1X,ES24.16E3))') &
        'ASTR_GPU_CRASHFIX_TOTAL',report_visits,report_calls,report_changes,report_minima
    endif
    if(allocated(fluid_d)) deallocate(fluid_d,first_d,last_d,partial_d)
    step_normal=0
    report_visits=0;report_calls=0;report_changes=0;report_minima=huge(0.e0_real_kind)
  end subroutine release_crashfix_gpu
end module crashfix_gpu
