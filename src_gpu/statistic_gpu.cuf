      open(hand,file='gpu_enstophy.dat',status='replace',action='write')
      write(hand,'(A)') 'nstep time enstophy_gpu'
      linit = .false.
    endif

    write(hand,'(I20,1X,ES24.16,1X,ES24.16)') nstep,time,enstophy_gpu
    flush(hand)
  end subroutine gpu_write_enstophy

  subroutine gpu_write_dissipation()
    use commvar, only: nstep,time,maxstep
    use parallel, only: lio
    use stlaio, only: get_unit
