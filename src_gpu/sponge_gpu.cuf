module sponge_gpu
  use cudafor
  implicit none
  real(8),allocatable,device :: sponge_im_coef_d(:,:,:)
  real(8),allocatable,device :: sponge_jm_coef_d(:,:,:)
  integer,save :: sponge_im_beg_gpu=-1,sponge_im_end_gpu=-1
  integer,save :: sponge_jm_beg_gpu=-1,sponge_jm_end_gpu=-1
contains
  subroutine release_sponge_gpu()
    implicit none

    if(allocated(sponge_im_coef_d)) deallocate(sponge_im_coef_d)
    if(allocated(sponge_jm_coef_d)) deallocate(sponge_jm_coef_d)
    sponge_im_beg_gpu=-1
    sponge_im_end_gpu=-1
    sponge_jm_beg_gpu=-1
    sponge_jm_end_gpu=-1
  end subroutine release_sponge_gpu

  subroutine init_sponge_gpu()
    use sponge_layer, only: spg_im_beg,spg_im_end,sponge_damp_coef_im, &
         spg_jm_beg,spg_jm_end,sponge_damp_coef_jm
    implicit none

    call release_sponge_gpu()
    if(allocated(sponge_damp_coef_im).and.spg_im_beg>=0) then
      sponge_im_beg_gpu = spg_im_beg
      sponge_im_end_gpu = spg_im_end
      allocate(sponge_im_coef_d(sponge_im_beg_gpu:sponge_im_end_gpu, &
                                0:ubound(sponge_damp_coef_im,2),0:ubound(sponge_damp_coef_im,3)))
      sponge_im_coef_d = sponge_damp_coef_im
    endif
    if(allocated(sponge_damp_coef_jm).and.spg_jm_beg>=0) then
      sponge_jm_beg_gpu = spg_jm_beg
      sponge_jm_end_gpu = spg_jm_end
      allocate(sponge_jm_coef_d(0:ubound(sponge_damp_coef_jm,1), &
                                sponge_jm_beg_gpu:sponge_jm_end_gpu,0:ubound(sponge_damp_coef_jm,3)))
      sponge_jm_coef_d = sponge_damp_coef_jm
    endif
  end subroutine init_sponge_gpu

  logical function gpu_xmax_sponge_active()
    implicit none

    gpu_xmax_sponge_active = sponge_im_beg_gpu >= 0
  end function gpu_xmax_sponge_active

  logical function gpu_ymax_sponge_active()
    implicit none
    gpu_ymax_sponge_active = sponge_jm_beg_gpu >= 0
  end function gpu_ymax_sponge_active

  attributes(global) subroutine sponge_xmax_to_work_kernel(im,jm,km,hm,spg_beg,spg_end,js,je,ks,ke)
    use commarray_gpu, only: q_d,qwork_d
    implicit none
    integer,value :: im,jm,km,hm,spg_beg,spg_end,js,je,ks,ke
    integer :: id,i,j,k,m,ni,nj,nk,n
    real(8) :: sigma

    id = (blockIdx%x-1)*blockDim%x + threadIdx%x - 1
    ni = spg_end-spg_beg+1
    nj = je-js+1
    nk = ke-ks+1
    n = ni*nj*nk*5
    if(id >= n) return
    i = spg_beg + mod(id,ni)
    j = js + mod(id/ni,nj)
    k = ks + mod(id/(ni*nj),nk)
    m = id/(ni*nj*nk) + 1
    sigma = sponge_im_coef_d(i,j,k)
    qwork_d(i,j,k,m) = (1.d0-sigma)*q_d(i,j,k,m) + sigma/6.d0*( &
         q_d(i+1,j,k,m)+q_d(i-1,j,k,m)+q_d(i,j+1,k,m)+q_d(i,j-1,k,m)+ &
         q_d(i,j,k+1,m)+q_d(i,j,k-1,m))
  end subroutine sponge_xmax_to_work_kernel

  attributes(global) subroutine sponge_xmax_copy_kernel(im,jm,km,spg_beg,spg_end,js,je,ks,ke)
    use commarray_gpu, only: q_d,qwork_d
    implicit none
    integer,value :: im,jm,km,spg_beg,spg_end,js,je,ks,ke
    integer :: id,i,j,k,m,ni,nj,nk,n

    id = (blockIdx%x-1)*blockDim%x + threadIdx%x - 1
    ni = spg_end-spg_beg+1
    nj = je-js+1
    nk = ke-ks+1
    n = ni*nj*nk*5
    if(id >= n) return
    i = spg_beg + mod(id,ni)
    j = js + mod(id/ni,nj)
    k = ks + mod(id/(ni*nj),nk)
    m = id/(ni*nj*nk) + 1
    q_d(i,j,k,m) = qwork_d(i,j,k,m)
  end subroutine sponge_xmax_copy_kernel

  attributes(global) subroutine sponge_ymax_to_work_kernel(im,jm,km,spg_beg,spg_end,is,ie,ks,ke)
    use commarray_gpu, only: q_d,qwork_d
    use constdef, only: num1d6
    implicit none
    integer,value :: im,jm,km,spg_beg,spg_end,is,ie,ks,ke
    integer :: id,i,j,k,m,ni,nj,nk,n
    real(8) :: sigma

    id = (blockIdx%x-1)*blockDim%x + threadIdx%x - 1
    ni = ie-is+1
    nj = spg_end-spg_beg+1
    nk = ke-ks+1
    n = ni*nj*nk*5
    if(id >= n) return
    i = is + mod(id,ni)
    j = spg_beg + mod(id/ni,nj)
    k = ks + mod(id/(ni*nj),nk)
    m = id/(ni*nj*nk) + 1
    sigma = sponge_jm_coef_d(i,j,k)
    qwork_d(i,j,k,m) = (1.d0-sigma)*q_d(i,j,k,m) + num1d6*sigma*( &
         q_d(i+1,j,k,m)+q_d(i-1,j,k,m)+q_d(i,j+1,k,m)+q_d(i,j-1,k,m)+ &
         q_d(i,j,k+1,m)+q_d(i,j,k-1,m))
  end subroutine sponge_ymax_to_work_kernel

  attributes(global) subroutine sponge_ymax_copy_kernel(im,jm,km,spg_beg,spg_end,is,ie,ks,ke)
    use commarray_gpu, only: q_d,qwork_d
    implicit none
    integer,value :: im,jm,km,spg_beg,spg_end,is,ie,ks,ke
    integer :: id,i,j,k,m,ni,nj,nk,n

    id = (blockIdx%x-1)*blockDim%x + threadIdx%x - 1
    ni = ie-is+1
    nj = spg_end-spg_beg+1
    nk = ke-ks+1
    n = ni*nj*nk*5
    if(id >= n) return
    i = is + mod(id,ni)
    j = spg_beg + mod(id/ni,nj)
    k = ks + mod(id/(ni*nj),nk)
    m = id/(ni*nj*nk) + 1
    q_d(i,j,k,m) = qwork_d(i,j,k,m)
  end subroutine sponge_ymax_copy_kernel

  subroutine apply_xmax_sponge_gpu()
    use commvar, only: im,jm,km,hm,is,ie,js,je,ks,ke
    use halo_exchange_gpu, only: exchange_solution_sponge_halo_gpu
    use gpu_check, only: sync_after_kernel
    implicit none
    type(dim3) :: block,grid
    integer :: n,ni,nj,nk,spg_beg,spg_end

    call exchange_solution_sponge_halo_gpu()
    if(.not.gpu_xmax_sponge_active()) return
    spg_beg = max(sponge_im_beg_gpu,is)
    spg_end = min(sponge_im_end_gpu,ie)
    if(spg_end < spg_beg) return
    ni = spg_end-spg_beg+1
    nj = je-js+1
    nk = ke-ks+1
    block = dim3(256,1,1)
    n = ni*nj*nk*5
    grid = dim3((n+block%x-1)/block%x,1,1)
    call sponge_xmax_to_work_kernel<<<grid,block>>>(im,jm,km,hm,spg_beg,spg_end,js,je,ks,ke)
    call sync_after_kernel('sponge_xmax_to_work_kernel')
    call sponge_xmax_copy_kernel<<<grid,block>>>(im,jm,km,spg_beg,spg_end,js,je,ks,ke)
    call sync_after_kernel('sponge_xmax_copy_kernel')
  end subroutine apply_xmax_sponge_gpu

  subroutine apply_ymax_sponge_gpu()
    use commvar, only: im,jm,km,is,ie,js,je,ks,ke
    use halo_exchange_gpu, only: exchange_solution_sponge_halo_gpu
    use gpu_check, only: sync_after_kernel
    implicit none
    type(dim3) :: block,grid
    integer :: n,spg_beg,spg_end

    ! Every rank participates, even when the sponge is absent locally.
    call exchange_solution_sponge_halo_gpu()
    if(.not.gpu_ymax_sponge_active()) return
    spg_beg = max(sponge_jm_beg_gpu,js)
    spg_end = min(sponge_jm_end_gpu,je)
    if(spg_end < spg_beg) return
    block = dim3(256,1,1)
    n = (ie-is+1)*(spg_end-spg_beg+1)*(ke-ks+1)*5
    grid = dim3((n+block%x-1)/block%x,1,1)
    call sponge_ymax_to_work_kernel<<<grid,block>>>(im,jm,km,spg_beg,spg_end,is,ie,ks,ke)
    call sync_after_kernel('sponge_ymax_to_work_kernel')
    call sponge_ymax_copy_kernel<<<grid,block>>>(im,jm,km,spg_beg,spg_end,is,ie,ks,ke)
    call sync_after_kernel('sponge_ymax_copy_kernel')
  end subroutine apply_ymax_sponge_gpu

end module sponge_gpu
