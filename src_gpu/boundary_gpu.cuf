module boundary_gpu
  use cudafor
  implicit none
  integer,parameter :: GPU_BC_NONE=0, GPU_BC_WALL_ISOTHERMAL_NOSLIP=41, &
                       GPU_BC_WALL_ADIABATIC_NOSLIP=42, &
                       GPU_BC_WALL_SLIP_ISOTHERMAL=411, &
                       GPU_BC_WALL_SLIP_ADIABATIC=421, &
                       GPU_BC_ZEROEXTRAP=50, GPU_BC_SYMMETRY=60, &
                       GPU_BC_FIXED=31, GPU_BC_INFLOW=11, GPU_BC_OUTFLOW=21, &
                       GPU_BC_NSCBC_INFLOW=12, GPU_BC_NSCBC_OUTFLOW=22, &
                       GPU_BC_FARFIELD=51, GPU_BC_NSCBC_FARFIELD=52
  real(8),allocatable,device :: s1_bl_rho_prof_d(:),s1_bl_tmp_prof_d(:), &
                                      s1_bl_prs_prof_d(:),s1_bl_vel_prof_d(:,:)
  logical,save :: s1_bl_profile_ready = .false.
contains
  integer function gpu_bc_kind_for_axis(axis)
    use bc, only: bctype
    implicit none
    integer,intent(in) :: axis

    select case(axis)
    case(1)
      gpu_bc_kind_for_axis = bctype(1)
    case(2)
      gpu_bc_kind_for_axis = bctype(3)
    case(3)
      gpu_bc_kind_for_axis = bctype(5)
    case default
      gpu_bc_kind_for_axis = GPU_BC_NONE
    end select
  end function gpu_bc_kind_for_axis

  integer function gpu_bc_lower_kind_for_axis(axis)
    use bc, only: bctype
    implicit none
    integer,intent(in) :: axis

    select case(axis)
    case(1)
      gpu_bc_lower_kind_for_axis = bctype(1)
    case(2)
      gpu_bc_lower_kind_for_axis = bctype(3)
    case(3)
      gpu_bc_lower_kind_for_axis = bctype(5)
    case default
      gpu_bc_lower_kind_for_axis = GPU_BC_NONE
    end select
  end function gpu_bc_lower_kind_for_axis

  integer function gpu_bc_upper_kind_for_axis(axis)
    use bc, only: bctype
    implicit none
    integer,intent(in) :: axis

    select case(axis)
    case(1)
      gpu_bc_upper_kind_for_axis = bctype(2)
    case(2)
      gpu_bc_upper_kind_for_axis = bctype(4)
    case(3)
      gpu_bc_upper_kind_for_axis = bctype(6)
    case default
      gpu_bc_upper_kind_for_axis = GPU_BC_NONE
    end select
  end function gpu_bc_upper_kind_for_axis

  logical function gpu_bc_supported_on_axis(kind,axis)
    implicit none
    integer,intent(in) :: kind,axis

    gpu_bc_supported_on_axis = .false.
    select case(kind)
    case(GPU_BC_ZEROEXTRAP,GPU_BC_SYMMETRY,GPU_BC_WALL_ISOTHERMAL_NOSLIP)
      gpu_bc_supported_on_axis = axis >= 1 .and. axis <= 3
    case(GPU_BC_WALL_ADIABATIC_NOSLIP)
      gpu_bc_supported_on_axis = axis == 1 .or. axis == 2
    case(GPU_BC_WALL_SLIP_ISOTHERMAL)
      gpu_bc_supported_on_axis = axis == 2
    case(GPU_BC_WALL_SLIP_ADIABATIC)
      gpu_bc_supported_on_axis = axis == 2
    case(GPU_BC_FIXED)
      gpu_bc_supported_on_axis = axis == 2
    end select
  end function gpu_bc_supported_on_axis

  logical function gpu_periodic_boundary_case()
    use bc, only: bctype
    use commvar, only: lihomo,ljhomo,lkhomo
    implicit none

    gpu_periodic_boundary_case = lihomo .and. ljhomo .and. lkhomo .and. all(bctype(1:6) == 1)
  end function gpu_periodic_boundary_case

  logical function gpu_axis_is_physical(axis)
    use commvar, only: lihomo,ljhomo,lkhomo
    implicit none
    integer,intent(in) :: axis

    gpu_axis_is_physical = .false.
    select case(axis)
    case(1)
      gpu_axis_is_physical = .not.lihomo
    case(2)
      gpu_axis_is_physical = .not.ljhomo
    case(3)
      gpu_axis_is_physical = .not.lkhomo
    end select
  end function gpu_axis_is_physical

  logical function gpu_ldc_boundary_case_pending()
    use bc, only: bctype
    use commvar, only: flowtype,lihomo,ljhomo,lkhomo
    implicit none

    gpu_ldc_boundary_case_pending = trim(flowtype) == 'ldcavity' .and. &
         (.not.lihomo) .and. (.not.ljhomo) .and. lkhomo .and. &
         bctype(1) == GPU_BC_WALL_ISOTHERMAL_NOSLIP .and. &
         bctype(2) == GPU_BC_WALL_ISOTHERMAL_NOSLIP .and. &
         bctype(3) == GPU_BC_WALL_ISOTHERMAL_NOSLIP .and. &
         bctype(4) == GPU_BC_NONE .and. &
         bctype(5) == 1 .and. bctype(6) == 1
  end function gpu_ldc_boundary_case_pending

  logical function gpu_s1_flatplate_boundary_case_pending()
    use bc, only: bctype,turbinf
    use commvar, only: flowtype,lihomo,ljhomo,lkhomo
    implicit none

    gpu_s1_flatplate_boundary_case_pending = trim(flowtype) == 'bl' .and. &
         (.not.lihomo) .and. (.not.ljhomo) .and. lkhomo .and. &
         ((bctype(1) == GPU_BC_INFLOW .and. trim(turbinf) == 'prof') .or. &
          bctype(1) == GPU_BC_NSCBC_INFLOW) .and. &
         bctype(2) == GPU_BC_OUTFLOW .and. &
         bctype(3) == GPU_BC_WALL_ISOTHERMAL_NOSLIP .and. &
         (bctype(4) == GPU_BC_FARFIELD .or. bctype(4) == GPU_BC_NSCBC_FARFIELD) .and. &
         all(bctype(5:6) == 1)
  end function gpu_s1_flatplate_boundary_case_pending

  logical function gpu_s1_flatplate_nscbc_farfield_case()
    use bc, only: bctype
    implicit none

    gpu_s1_flatplate_nscbc_farfield_case = gpu_s1_flatplate_boundary_case_pending() .and. &
         bctype(4) == GPU_BC_NSCBC_FARFIELD
  end function gpu_s1_flatplate_nscbc_farfield_case

  logical function gpu_physical_boundary_axis_supported(axis)
    use bc, only: bctype
    use commvar, only: lihomo,ljhomo,lkhomo
    implicit none
    integer,intent(in) :: axis
    integer :: kind

    gpu_physical_boundary_axis_supported = .false.
    kind = gpu_bc_kind_for_axis(axis)

    select case(axis)
    case(1)
      gpu_physical_boundary_axis_supported = (.not.lihomo) .and. ljhomo .and. lkhomo .and. &
           ((bctype(1) == bctype(2) .and. gpu_bc_supported_on_axis(kind,axis)) .or. &
            (bctype(1) == GPU_BC_INFLOW .and. bctype(2) == GPU_BC_OUTFLOW) .or. &
            (bctype(1) == GPU_BC_NSCBC_INFLOW .and. bctype(2) == GPU_BC_NSCBC_OUTFLOW)) .and. &
           all(bctype(3:6) == 1)
    case(2)
      gpu_physical_boundary_axis_supported = lihomo .and. (.not.ljhomo) .and. lkhomo .and. &
           bctype(3) == bctype(4) .and. gpu_bc_supported_on_axis(kind,axis) .and. &
           all(bctype(1:2) == 1) .and. all(bctype(5:6) == 1)
    case(3)
      gpu_physical_boundary_axis_supported = lihomo .and. ljhomo .and. (.not.lkhomo) .and. &
           bctype(5) == bctype(6) .and. gpu_bc_supported_on_axis(kind,axis) .and. &
           all(bctype(1:4) == 1)
    end select
  end function gpu_physical_boundary_axis_supported

  integer function gpu_physical_boundary_axis()
    implicit none
    integer :: axis

    gpu_physical_boundary_axis = 0
    do axis=1,3
      if(gpu_physical_boundary_axis_supported(axis)) then
        gpu_physical_boundary_axis = axis
        return
      endif
    enddo
  end function gpu_physical_boundary_axis

  integer function gpu_physical_boundary_kind()
    implicit none
    integer :: axis

    axis = gpu_physical_boundary_axis()
    gpu_physical_boundary_kind = gpu_bc_kind_for_axis(axis)
  end function gpu_physical_boundary_kind

  logical function gpu_uses_physical_boundary()
    implicit none

    gpu_uses_physical_boundary = gpu_physical_boundary_axis() /= 0 .or. &
         gpu_s1_flatplate_boundary_case_pending()
  end function gpu_uses_physical_boundary

  logical function gpu_boundary_case_supported()
    implicit none

    gpu_boundary_case_supported = gpu_periodic_boundary_case() .or. gpu_uses_physical_boundary()
  end function gpu_boundary_case_supported

  subroutine gpu_physical_boundary_apply_mask(axis,apply_lower,apply_upper)
    use mpi, only: MPI_PROC_NULL
    use parallel, only: mpileft,mpiright,mpidown,mpiup,mpiback,mpifront
    implicit none
    integer,intent(in) :: axis
    integer,intent(out) :: apply_lower,apply_upper

    apply_lower = 0
    apply_upper = 0
    select case(axis)
    case(1)
      apply_lower = merge(1,0,mpileft == MPI_PROC_NULL)
      apply_upper = merge(1,0,mpiright == MPI_PROC_NULL)
    case(2)
      apply_lower = merge(1,0,mpidown == MPI_PROC_NULL)
      apply_upper = merge(1,0,mpiup == MPI_PROC_NULL)
    case(3)
      apply_lower = merge(1,0,mpiback == MPI_PROC_NULL)
      apply_upper = merge(1,0,mpifront == MPI_PROC_NULL)
    end select
  end subroutine gpu_physical_boundary_apply_mask

  integer function gpu_zeroextrap_axis()
    implicit none

    gpu_zeroextrap_axis = 0
    if(gpu_physical_boundary_kind() == GPU_BC_ZEROEXTRAP) then
      gpu_zeroextrap_axis = gpu_physical_boundary_axis()
    endif
  end function gpu_zeroextrap_axis

  logical function gpu_uses_x_zeroextrap()
    implicit none

    gpu_uses_x_zeroextrap = gpu_zeroextrap_axis() == 1
  end function gpu_uses_x_zeroextrap

  logical function gpu_uses_zeroextrap()
    implicit none

    gpu_uses_zeroextrap = gpu_zeroextrap_axis() /= 0
  end function gpu_uses_zeroextrap

  logical function gpu_uses_x_nscbc()
    use bc, only: bctype
    implicit none

    gpu_uses_x_nscbc = gpu_physical_boundary_axis() == 1 .and. &
         bctype(1) == GPU_BC_NSCBC_INFLOW .and. bctype(2) == GPU_BC_NSCBC_OUTFLOW
  end function gpu_uses_x_nscbc

  attributes(device) real(8) function extrap2(v1,v2)
    implicit none
    real(8),value :: v1,v2

    extrap2 = (4.d0*v1 - v2)/3.d0
  end function extrap2

  attributes(device) subroutine set_q_from_primitive(i,j,k,rho,uu,vv,ww,prs,const6)
    use commarray_gpu, only: q_d,rho_d,vel_d,prs_d,tmp_d
    implicit none
    integer,value :: i,j,k
    real(8),value :: rho,uu,vv,ww,prs,const6
    real(8) :: ke

    rho_d(i,j,k) = rho
    vel_d(i,j,k,1) = uu
    vel_d(i,j,k,2) = vv
    vel_d(i,j,k,3) = ww
    prs_d(i,j,k) = prs
    ke = 0.5d0*rho*(uu*uu + vv*vv + ww*ww)
    q_d(i,j,k,1) = rho
    q_d(i,j,k,2) = rho*uu
    q_d(i,j,k,3) = rho*vv
    q_d(i,j,k,4) = rho*ww
    q_d(i,j,k,5) = prs*const6 + ke
  end subroutine set_q_from_primitive

  attributes(device) subroutine set_qrhs_zero(i,j,k)
    use commarray_gpu, only: qrhs_d
    implicit none
    integer,value :: i,j,k
    integer :: m

    do m=1,5
      qrhs_d(i,j,k,m) = 0.d0
    enddo
  end subroutine set_qrhs_zero

  subroutine init_s1_flatplate_profile_gpu()
    use bc, only: bctype,rho_prof,vel_prof,tmp_prof,prs_prof
    implicit none

    s1_bl_profile_ready = .false.
    if(bctype(1) /= GPU_BC_INFLOW) return
    if(.not.gpu_s1_flatplate_boundary_case_pending()) return
    if(.not.allocated(rho_prof) .or. .not.allocated(vel_prof) .or. &
       .not.allocated(tmp_prof) .or. .not.allocated(prs_prof)) &
      stop 'GPU S1 flatplate profile is not initialized'
    if(.not.allocated(s1_bl_rho_prof_d)) allocate(s1_bl_rho_prof_d(lbound(rho_prof,1):ubound(rho_prof,1)))
    if(.not.allocated(s1_bl_tmp_prof_d)) allocate(s1_bl_tmp_prof_d(lbound(tmp_prof,1):ubound(tmp_prof,1)))
    if(.not.allocated(s1_bl_prs_prof_d)) allocate(s1_bl_prs_prof_d(lbound(prs_prof,1):ubound(prs_prof,1)))
    if(.not.allocated(s1_bl_vel_prof_d)) allocate(s1_bl_vel_prof_d(lbound(vel_prof,1):ubound(vel_prof,1),1:3))
    s1_bl_rho_prof_d = rho_prof
    s1_bl_tmp_prof_d = tmp_prof
    s1_bl_prs_prof_d = prs_prof
    s1_bl_vel_prof_d = vel_prof(:,1:3)
    s1_bl_profile_ready = .true.
  end subroutine init_s1_flatplate_profile_gpu

  attributes(global) subroutine s1_bl_profile_inflow_x_kernel(im,jm,km,const6,apply_left)
    use commarray_gpu, only: qrhs_d
    implicit none
    integer,value :: im,jm,km,apply_left
    real(8),value :: const6
    integer :: id,j,k,nplane

    if(apply_left == 0) return
    id = (blockIdx%x-1)*blockDim%x + threadIdx%x - 1
    nplane = (jm+1)*(km+1)
    if(id >= nplane) return
    j = mod(id,jm+1)
    k = id/(jm+1)
    call set_q_from_primitive(0,j,k,s1_bl_rho_prof_d(j),s1_bl_vel_prof_d(j,1), &
                              s1_bl_vel_prof_d(j,2),s1_bl_vel_prof_d(j,3), &
                              s1_bl_prs_prof_d(j),const6)
    qrhs_d(0,j,k,:) = 0.d0
  end subroutine s1_bl_profile_inflow_x_kernel

  attributes(global) subroutine s1_bl_farfield_y_upper_kernel(im,jm,km,const2,const6,apply_up)
    use commarray_gpu, only: rho_d,vel_d,prs_d,tmp_d
    implicit none
    integer,value :: im,jm,km,apply_up
    real(8),value :: const2,const6
    integer :: id,i,k,nplane
    real(8) :: rho,uu,vv,ww,prs,tmp

    if(apply_up == 0) return
    id = (blockIdx%x-1)*blockDim%x + threadIdx%x - 1
    nplane = (im+1)*(km+1)
    if(id >= nplane) return
    i = mod(id,im+1)
    k = id/(im+1)
    uu = extrap2(vel_d(i,jm-1,k,1),vel_d(i,jm-2,k,1))
    vv = extrap2(vel_d(i,jm-1,k,2),vel_d(i,jm-2,k,2))
    ww = extrap2(vel_d(i,jm-1,k,3),vel_d(i,jm-2,k,3))
    prs = extrap2(prs_d(i,jm-1,k),prs_d(i,jm-2,k))
    rho = extrap2(rho_d(i,jm-1,k),rho_d(i,jm-2,k))
    tmp = prs/rho*const2
    tmp_d(i,jm,k) = tmp
    call set_q_from_primitive(i,jm,k,rho,uu,vv,ww,prs,const6)
    call set_qrhs_zero(i,jm,k)
  end subroutine s1_bl_farfield_y_upper_kernel

  attributes(global) subroutine zeroextrap_x_kernel(im,jm,km,hm,const2,const6,apply_left,apply_right)
    use commarray_gpu, only: q_d,rho_d,vel_d,prs_d,tmp_d
    implicit none
    integer,value :: im,jm,km,hm,apply_left,apply_right
    real(8),value :: const2,const6
    integer :: id,j,k,nplane
    real(8) :: rho,uu,vv,ww,prs,tmp

    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    nplane = (jm + 1) * (km + 1)
    if(id >= nplane) return
    j = mod(id,jm+1)
    k = id/(jm+1)

    if(apply_left /= 0) then
      uu  = extrap2(vel_d(1,j,k,1),vel_d(2,j,k,1))
      vv  = extrap2(vel_d(1,j,k,2),vel_d(2,j,k,2))
      ww  = extrap2(vel_d(1,j,k,3),vel_d(2,j,k,3))
      prs = extrap2(prs_d(1,j,k),prs_d(2,j,k))
      tmp = extrap2(tmp_d(1,j,k),tmp_d(2,j,k))
      rho = prs/tmp*const2
      tmp_d(0,j,k) = tmp
      call set_q_from_primitive(0,j,k,rho,uu,vv,ww,prs,const6)
      call set_qrhs_zero(0,j,k)
    endif

    if(apply_right /= 0) then
      uu  = extrap2(vel_d(im-1,j,k,1),vel_d(im-2,j,k,1))
      vv  = extrap2(vel_d(im-1,j,k,2),vel_d(im-2,j,k,2))
      ww  = extrap2(vel_d(im-1,j,k,3),vel_d(im-2,j,k,3))
      prs = extrap2(prs_d(im-1,j,k),prs_d(im-2,j,k))
      tmp = extrap2(tmp_d(im-1,j,k),tmp_d(im-2,j,k))
      rho = prs/tmp*const2
      tmp_d(im,j,k) = tmp
      call set_q_from_primitive(im,j,k,rho,uu,vv,ww,prs,const6)
      call set_qrhs_zero(im,j,k)
    endif

  end subroutine zeroextrap_x_kernel

  attributes(global) subroutine inflow_x_kernel(im,jm,km,hm,const2,const6, &
                                                 uinf,vinf,winf,pinf,apply_left)
    use commarray_gpu, only: q_d,qrhs_d,rho_d,vel_d,prs_d,tmp_d
    implicit none
    integer,value :: im,jm,km,hm,apply_left
    real(8),value :: const2,const6,uinf,vinf,winf,pinf
    integer :: id,j,k,nplane,m
    real(8) :: rho,tmp,ke

    if(apply_left == 0) return
    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    nplane = (jm + 1) * (km + 1)
    if(id >= nplane) return
    j = mod(id,jm+1)
    k = id/(jm+1)

    rho = rho_d(0,j,k)
    vel_d(0,j,k,1) = uinf
    vel_d(0,j,k,2) = vinf
    vel_d(0,j,k,3) = winf
    prs_d(0,j,k) = pinf
    tmp = pinf/rho*const2
    tmp_d(0,j,k) = tmp
    ke = 0.5d0*rho*(uinf*uinf + vinf*vinf + winf*winf)
    q_d(0,j,k,1) = rho
    q_d(0,j,k,2) = rho*uinf
    q_d(0,j,k,3) = rho*vinf
    q_d(0,j,k,4) = rho*winf
    q_d(0,j,k,5) = pinf*const6 + ke
    do m=1,5
      qrhs_d(0,j,k,m) = 0.d0
    enddo
  end subroutine inflow_x_kernel

  attributes(global) subroutine outflow_x_kernel(im,jm,km,hm,const2,const6, &
                                                  gamma,mach,pinf,pout,apply_right)
    use commarray_gpu, only: q_d,qrhs_d,rho_d,vel_d,prs_d,tmp_d
    implicit none
    integer,value :: im,jm,km,hm,apply_right
    real(8),value :: const2,const6,gamma,mach,pinf,pout
    integer :: id,j,k,nplane,m
    real(8) :: css,ub,ue,ve,we,pe,te,roe,csse,rho,prs,tmp,ke

    if(apply_right == 0) return
    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    nplane = (jm + 1) * (km + 1)
    if(id >= nplane) return
    j = mod(id,jm+1)
    k = id/(jm+1)

    css = sqrt(tmp_d(im,j,k))/mach
    ub = vel_d(im,j,k,1)
    ue = extrap2(vel_d(im-1,j,k,1),vel_d(im-2,j,k,1))
    ve = extrap2(vel_d(im-1,j,k,2),vel_d(im-2,j,k,2))
    we = extrap2(vel_d(im-1,j,k,3),vel_d(im-2,j,k,3))
    pe = extrap2(prs_d(im-1,j,k),prs_d(im-2,j,k))
    te = extrap2(tmp_d(im-1,j,k),tmp_d(im-2,j,k))
    roe = extrap2(rho_d(im-1,j,k),rho_d(im-2,j,k))
    csse = extrap2(sqrt(tmp_d(im-1,j,k))/mach,sqrt(tmp_d(im-2,j,k))/mach)

    if(ub >= css) then
      prs = pe
      tmp = te
      rho = prs/tmp*const2
    else
      prs = pinf*pout
      rho = roe + (prs-pe)/(csse*csse)
      tmp = tmp_d(im,j,k)
      rho = prs/tmp*const2
    endif
    vel_d(im,j,k,1) = merge(ue,ue + (pe-prs)/(roe*csse),ub >= css)
    vel_d(im,j,k,2) = ve
    vel_d(im,j,k,3) = we
    prs_d(im,j,k) = prs
    rho_d(im,j,k) = rho
    tmp_d(im,j,k) = tmp
    ke = 0.5d0*rho*(vel_d(im,j,k,1)**2 + ve*ve + we*we)
    q_d(im,j,k,1) = rho
    q_d(im,j,k,2) = rho*vel_d(im,j,k,1)
    q_d(im,j,k,3) = rho*ve
    q_d(im,j,k,4) = rho*we
    q_d(im,j,k,5) = prs*const6 + ke
    do m=1,5
      qrhs_d(im,j,k,m) = 0.d0
    enddo
  end subroutine outflow_x_kernel

  attributes(global) subroutine zeroextrap_y_kernel(im,jm,km,hm,const2,const6,apply_down,apply_up)
    use commarray_gpu, only: rho_d,vel_d,prs_d,tmp_d
    implicit none
    integer,value :: im,jm,km,hm,apply_down,apply_up
    real(8),value :: const2,const6
    integer :: id,i,k,nplane
    real(8) :: rho,uu,vv,ww,prs,tmp

    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    nplane = (im + 1) * (km + 1)
    if(id >= nplane) return
    i = mod(id,im+1)
    k = id/(im+1)

    if(apply_down /= 0) then
      uu  = extrap2(vel_d(i,1,k,1),vel_d(i,2,k,1))
      vv  = extrap2(vel_d(i,1,k,2),vel_d(i,2,k,2))
      ww  = extrap2(vel_d(i,1,k,3),vel_d(i,2,k,3))
      prs = extrap2(prs_d(i,1,k),prs_d(i,2,k))
      rho = extrap2(rho_d(i,1,k),rho_d(i,2,k))
      tmp = prs/rho*const2
      tmp_d(i,0,k) = tmp
      call set_q_from_primitive(i,0,k,rho,uu,vv,ww,prs,const6)
      call set_qrhs_zero(i,0,k)
    endif

    if(apply_up /= 0) then
      uu  = extrap2(vel_d(i,jm-1,k,1),vel_d(i,jm-2,k,1))
      vv  = extrap2(vel_d(i,jm-1,k,2),vel_d(i,jm-2,k,2))
      ww  = extrap2(vel_d(i,jm-1,k,3),vel_d(i,jm-2,k,3))
      prs = extrap2(prs_d(i,jm-1,k),prs_d(i,jm-2,k))
      rho = extrap2(rho_d(i,jm-1,k),rho_d(i,jm-2,k))
      tmp = prs/rho*const2
      tmp_d(i,jm,k) = tmp
      call set_q_from_primitive(i,jm,k,rho,uu,vv,ww,prs,const6)
      call set_qrhs_zero(i,jm,k)
    endif
  end subroutine zeroextrap_y_kernel

  attributes(global) subroutine zeroextrap_z_kernel(im,jm,km,hm,const2,const6,apply_back,apply_front)
    use commarray_gpu, only: rho_d,vel_d,prs_d,tmp_d
    implicit none
    integer,value :: im,jm,km,hm,apply_back,apply_front
    real(8),value :: const2,const6
    integer :: id,i,j,nplane
    real(8) :: rho,uu,vv,ww,prs,tmp

    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    nplane = (im + 1) * (jm + 1)
    if(id >= nplane) return
    i = mod(id,im+1)
    j = id/(im+1)

    if(apply_back /= 0) then
      uu  = extrap2(vel_d(i,j,1,1),vel_d(i,j,2,1))
      vv  = extrap2(vel_d(i,j,1,2),vel_d(i,j,2,2))
      ww  = extrap2(vel_d(i,j,1,3),vel_d(i,j,2,3))
      prs = extrap2(prs_d(i,j,1),prs_d(i,j,2))
      rho = extrap2(rho_d(i,j,1),rho_d(i,j,2))
      tmp = prs/rho*const2
      tmp_d(i,j,0) = tmp
      call set_q_from_primitive(i,j,0,rho,uu,vv,ww,prs,const6)
      call set_qrhs_zero(i,j,0)
    endif

    if(apply_front /= 0) then
      uu  = extrap2(vel_d(i,j,km-1,1),vel_d(i,j,km-2,1))
      vv  = extrap2(vel_d(i,j,km-1,2),vel_d(i,j,km-2,2))
      ww  = extrap2(vel_d(i,j,km-1,3),vel_d(i,j,km-2,3))
      prs = extrap2(prs_d(i,j,km-1),prs_d(i,j,km-2))
      rho = extrap2(rho_d(i,j,km-1),rho_d(i,j,km-2))
      tmp = prs/rho*const2
      tmp_d(i,j,km) = tmp
      call set_q_from_primitive(i,j,km,rho,uu,vv,ww,prs,const6)
      call set_qrhs_zero(i,j,km)
    endif
  end subroutine zeroextrap_z_kernel

  attributes(global) subroutine symmetry_x_kernel(im,jm,km,hm,const2,const6,apply_left,apply_right)
    use commarray_gpu, only: rho_d,vel_d,prs_d,tmp_d
    implicit none
    integer,value :: im,jm,km,hm,apply_left,apply_right
    real(8),value :: const2,const6
    integer :: id,j,k,nplane
    real(8) :: rho,uu,vv,ww,prs,tmp

    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    nplane = (jm + 1) * (km + 1)
    if(id >= nplane) return
    j = mod(id,jm+1)
    k = id/(jm+1)

    if(apply_left /= 0) then
      uu  = 0.d0
      vv  = extrap2(vel_d(1,j,k,2),vel_d(2,j,k,2))
      ww  = extrap2(vel_d(1,j,k,3),vel_d(2,j,k,3))
      prs = extrap2(prs_d(1,j,k),prs_d(2,j,k))
      tmp = extrap2(tmp_d(1,j,k),tmp_d(2,j,k))
      rho = prs/tmp*const2
      tmp_d(0,j,k) = tmp
      call set_q_from_primitive(0,j,k,rho,uu,vv,ww,prs,const6)
      call set_qrhs_zero(0,j,k)
    endif

    if(apply_right /= 0) then
      uu  = 0.d0
      vv  = extrap2(vel_d(im-1,j,k,2),vel_d(im-2,j,k,2))
      ww  = extrap2(vel_d(im-1,j,k,3),vel_d(im-2,j,k,3))
      prs = extrap2(prs_d(im-1,j,k),prs_d(im-2,j,k))
      tmp = extrap2(tmp_d(im-1,j,k),tmp_d(im-2,j,k))
      rho = prs/tmp*const2
      tmp_d(im,j,k) = tmp
      call set_q_from_primitive(im,j,k,rho,uu,vv,ww,prs,const6)
      call set_qrhs_zero(im,j,k)
    endif
  end subroutine symmetry_x_kernel

  attributes(global) subroutine symmetry_y_kernel(im,jm,km,hm,const2,const6,apply_down,apply_up)
    use commarray_gpu, only: vel_d,prs_d,tmp_d
    implicit none
    integer,value :: im,jm,km,hm,apply_down,apply_up
    real(8),value :: const2,const6
    integer :: id,i,k,nplane
    real(8) :: rho,uu,vv,ww,prs,tmp

    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    nplane = (im + 1) * (km + 1)
    if(id >= nplane) return
    i = mod(id,im+1)
    k = id/(im+1)

    if(apply_down /= 0) then
      uu  = extrap2(vel_d(i,1,k,1),vel_d(i,2,k,1))
      vv  = 0.d0
      ww  = extrap2(vel_d(i,1,k,3),vel_d(i,2,k,3))
      prs = extrap2(prs_d(i,1,k),prs_d(i,2,k))
      tmp = extrap2(tmp_d(i,1,k),tmp_d(i,2,k))
      rho = prs/tmp*const2
      tmp_d(i,0,k) = tmp
      call set_q_from_primitive(i,0,k,rho,uu,vv,ww,prs,const6)
      call set_qrhs_zero(i,0,k)
    endif

    if(apply_up /= 0) then
      uu  = extrap2(vel_d(i,jm-1,k,1),vel_d(i,jm-2,k,1))
      vv  = 0.d0
      ww  = extrap2(vel_d(i,jm-1,k,3),vel_d(i,jm-2,k,3))
      prs = extrap2(prs_d(i,jm-1,k),prs_d(i,jm-2,k))
      tmp = extrap2(tmp_d(i,jm-1,k),tmp_d(i,jm-2,k))
      rho = prs/tmp*const2
      tmp_d(i,jm,k) = tmp
      call set_q_from_primitive(i,jm,k,rho,uu,vv,ww,prs,const6)
      call set_qrhs_zero(i,jm,k)
    endif
  end subroutine symmetry_y_kernel

  attributes(global) subroutine wall_isothermal_noslip_x_kernel(im,jm,km,hm,const2,const6, &
                                                                twall_left,twall_right, &
                                                                apply_left,apply_right)
    use commarray_gpu, only: prs_d,tmp_d
    implicit none
    integer,value :: im,jm,km,hm,apply_left,apply_right
    real(8),value :: const2,const6,twall_left,twall_right
    integer :: id,j,k,nplane
    real(8) :: rho,prs

    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    nplane = (jm + 1) * (km + 1)
    if(id >= nplane) return
    j = mod(id,jm+1)
    k = id/(jm+1)

    if(apply_left /= 0) then
      prs = extrap2(prs_d(1,j,k),prs_d(2,j,k))
      rho = prs/twall_left*const2
      tmp_d(0,j,k) = twall_left
      call set_q_from_primitive(0,j,k,rho,0.d0,0.d0,0.d0,prs,const6)
      call set_qrhs_zero(0,j,k)
    endif

    if(apply_right /= 0) then
      prs = extrap2(prs_d(im-1,j,k),prs_d(im-2,j,k))
      rho = prs/twall_right*const2
      tmp_d(im,j,k) = twall_right
      call set_q_from_primitive(im,j,k,rho,0.d0,0.d0,0.d0,prs,const6)
      call set_qrhs_zero(im,j,k)
    endif
  end subroutine wall_isothermal_noslip_x_kernel

  attributes(global) subroutine wall_isothermal_noslip_y_kernel(im,jm,km,hm,const2,const6, &
                                                                twall_down,twall_up, &
                                                                apply_down,apply_up,preserve_inflow_rhs)
    use commarray_gpu, only: prs_d,tmp_d
    implicit none
    integer,value :: im,jm,km,hm,apply_down,apply_up,preserve_inflow_rhs
    real(8),value :: const2,const6,twall_down,twall_up
    integer :: id,i,k,nplane
    real(8) :: rho,prs

    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    nplane = (im + 1) * (km + 1)
    if(id >= nplane) return
    i = mod(id,im+1)
    k = id/(im+1)

    if(apply_down /= 0) then
      prs = extrap2(prs_d(i,1,k),prs_d(i,2,k))
      rho = prs/twall_down*const2
      tmp_d(i,0,k) = twall_down
      call set_q_from_primitive(i,0,k,rho,0.d0,0.d0,0.d0,prs,const6)
      if(preserve_inflow_rhs == 0 .or. i /= 0) call set_qrhs_zero(i,0,k)
    endif

    if(apply_up /= 0) then
      prs = extrap2(prs_d(i,jm-1,k),prs_d(i,jm-2,k))
      rho = prs/twall_up*const2
      tmp_d(i,jm,k) = twall_up
      call set_q_from_primitive(i,jm,k,rho,0.d0,0.d0,0.d0,prs,const6)
      call set_qrhs_zero(i,jm,k)
    endif
  end subroutine wall_isothermal_noslip_y_kernel

  attributes(global) subroutine ldc_top_lid_y_kernel(im,jm,km,hm,const2,const6,apply_up)
    use commarray_gpu, only: prs_d,tmp_d
    implicit none
    integer,value :: im,jm,km,hm,apply_up
    real(8),value :: const2,const6
    integer :: id,i,k,nplane
    real(8) :: rho,prs

    if(apply_up == 0) return
    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    nplane = (im + 1) * (km + 1)
    if(id >= nplane) return
    i = mod(id,im+1)
    k = id/(im+1)

    prs = extrap2(prs_d(i,jm-1,k),prs_d(i,jm-2,k))
    rho = prs*const2
    tmp_d(i,jm,k) = 1.d0
    call set_q_from_primitive(i,jm,k,rho,1.d0,0.d0,0.d0,prs,const6)
    call set_qrhs_zero(i,jm,k)
  end subroutine ldc_top_lid_y_kernel

  attributes(global) subroutine wall_adiabatic_noslip_x_kernel(im,jm,km,hm,const2,const6, &
                                                               apply_left,apply_right)
    use commarray_gpu, only: prs_d,tmp_d
    implicit none
    integer,value :: im,jm,km,hm,apply_left,apply_right
    real(8),value :: const2,const6
    integer :: id,j,k,nplane
    real(8) :: rho,prs,tmp

    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    nplane = (jm + 1) * (km + 1)
    if(id >= nplane) return
    j = mod(id,jm+1)
    k = id/(jm+1)

    if(apply_left /= 0) then
      prs = extrap2(prs_d(1,j,k),prs_d(2,j,k))
      tmp = extrap2(tmp_d(1,j,k),tmp_d(2,j,k))
      rho = prs/tmp*const2
      tmp_d(0,j,k) = tmp
      call set_q_from_primitive(0,j,k,rho,0.d0,0.d0,0.d0,prs,const6)
      call set_qrhs_zero(0,j,k)
    endif

    if(apply_right /= 0) then
      prs = extrap2(prs_d(im-1,j,k),prs_d(im-2,j,k))
      tmp = extrap2(tmp_d(im-1,j,k),tmp_d(im-2,j,k))
      rho = prs/tmp*const2
      tmp_d(im,j,k) = tmp
      call set_q_from_primitive(im,j,k,rho,0.d0,0.d0,0.d0,prs,const6)
      call set_qrhs_zero(im,j,k)
    endif
  end subroutine wall_adiabatic_noslip_x_kernel

  attributes(global) subroutine wall_adiabatic_noslip_y_kernel(im,jm,km,hm,const2,const6, &
                                                               apply_down,apply_up)
    use commarray_gpu, only: prs_d,tmp_d
    implicit none
    integer,value :: im,jm,km,hm,apply_down,apply_up
    real(8),value :: const2,const6
    integer :: id,i,k,nplane
    real(8) :: rho,prs,tmp

    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    nplane = (im + 1) * (km + 1)
    if(id >= nplane) return
    i = mod(id,im+1)
    k = id/(im+1)

    if(apply_down /= 0) then
      prs = extrap2(prs_d(i,1,k),prs_d(i,2,k))
      tmp = extrap2(tmp_d(i,1,k),tmp_d(i,2,k))
      rho = prs/tmp*const2
      tmp_d(i,0,k) = tmp
      call set_q_from_primitive(i,0,k,rho,0.d0,0.d0,0.d0,prs,const6)
      call set_qrhs_zero(i,0,k)
    endif

    if(apply_up /= 0) then
      prs = extrap2(prs_d(i,jm-1,k),prs_d(i,jm-2,k))
      tmp = extrap2(tmp_d(i,jm-1,k),tmp_d(i,jm-2,k))
      rho = prs/tmp*const2
      tmp_d(i,jm,k) = tmp
      call set_q_from_primitive(i,jm,k,rho,0.d0,0.d0,0.d0,prs,const6)
      call set_qrhs_zero(i,jm,k)
    endif
  end subroutine wall_adiabatic_noslip_y_kernel

  attributes(global) subroutine wall_slip_isothermal_y_kernel(im,jm,km,hm,const2,const6, &
                                                              xslip,twall_down,twall_up, &
                                                              apply_down,apply_up)
    use commarray_gpu, only: vel_d,prs_d,tmp_d,x_d
    implicit none
    integer,value :: im,jm,km,hm,apply_down,apply_up
    real(8),value :: const2,const6,xslip,twall_down,twall_up
    integer :: id,i,k,nplane
    real(8) :: rho,uu,vv,ww,prs,tmp

    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    nplane = (im + 1) * (km + 1)
    if(id >= nplane) return
    i = mod(id,im+1)
    k = id/(im+1)

    if(apply_down /= 0) then
      prs = extrap2(prs_d(i,1,k),prs_d(i,2,k))
      if(x_d(i,0,k,1) <= xslip) then
        uu = extrap2(vel_d(i,1,k,1),vel_d(i,2,k,1))
        vv = 0.d0
        ww = 0.d0
        tmp = extrap2(tmp_d(i,1,k),tmp_d(i,2,k))
      else
        uu = 0.d0
        vv = 0.d0
        ww = 0.d0
        tmp = twall_down
      endif
      rho = prs/tmp*const2
      tmp_d(i,0,k) = tmp
      call set_q_from_primitive(i,0,k,rho,uu,vv,ww,prs,const6)
      call set_qrhs_zero(i,0,k)
    endif

    if(apply_up /= 0) then
      prs = extrap2(prs_d(i,jm-1,k),prs_d(i,jm-2,k))
      rho = prs/twall_up*const2
      tmp_d(i,jm,k) = twall_up
      call set_q_from_primitive(i,jm,k,rho,0.d0,0.d0,0.d0,prs,const6)
      call set_qrhs_zero(i,jm,k)
    endif
  end subroutine wall_slip_isothermal_y_kernel

  attributes(global) subroutine wall_slip_adiabatic_y_kernel(im,jm,km,hm,const2,const6, &
                                                             apply_down,apply_up)
    use commarray_gpu, only: vel_d,prs_d,tmp_d
    implicit none
    integer,value :: im,jm,km,hm,apply_down,apply_up
    real(8),value :: const2,const6
    integer :: id,i,k,nplane
    real(8) :: rho,uu,vv,ww,prs,tmp

    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    nplane = (im + 1) * (km + 1)
    if(id >= nplane) return
    i = mod(id,im+1)
    k = id/(im+1)

    if(apply_down /= 0) then
      prs = extrap2(prs_d(i,1,k),prs_d(i,2,k))
      tmp = extrap2(tmp_d(i,1,k),tmp_d(i,2,k))
      uu = extrap2(vel_d(i,1,k,1),vel_d(i,2,k,1))
      vv = 0.d0
      ww = 0.d0
      rho = prs/tmp*const2
      tmp_d(i,0,k) = tmp
      call set_q_from_primitive(i,0,k,rho,uu,vv,ww,prs,const6)
      call set_qrhs_zero(i,0,k)
    endif

    if(apply_up /= 0) then
      prs = extrap2(prs_d(i,jm-1,k),prs_d(i,jm-2,k))
      tmp = extrap2(tmp_d(i,jm-1,k),tmp_d(i,jm-2,k))
      uu = extrap2(vel_d(i,jm-1,k,1),vel_d(i,jm-2,k,1))
      vv = extrap2(vel_d(i,jm-1,k,2),vel_d(i,jm-2,k,2))
      ww = 0.d0
      rho = prs/tmp*const2
      tmp_d(i,jm,k) = tmp
      call set_q_from_primitive(i,jm,k,rho,uu,vv,ww,prs,const6)
      call set_qrhs_zero(i,jm,k)
    endif
  end subroutine wall_slip_adiabatic_y_kernel

  attributes(global) subroutine fixed_rti_y_kernel(im,jm,km,hm,const2,const6,apply_down,apply_up)
    use commarray_gpu, only: tmp_d
    implicit none
    integer,value :: im,jm,km,hm,apply_down,apply_up
    real(8),value :: const2,const6
    integer :: id,i,k,nplane
    real(8) :: rho,prs,tmp

    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    nplane = (im + 1) * (km + 1)
    if(id >= nplane) return
    i = mod(id,im+1)
    k = id/(im+1)

    if(apply_down /= 0) then
      rho = 2.d0
      prs = 1.d0
      tmp = prs/rho*const2
      tmp_d(i,0,k) = tmp
      call set_q_from_primitive(i,0,k,rho,0.d0,0.d0,0.d0,prs,const6)
      call set_qrhs_zero(i,0,k)
    endif

    if(apply_up /= 0) then
      rho = 1.d0
      prs = 2.5d0
      tmp = prs/rho*const2
      tmp_d(i,jm,k) = tmp
      call set_q_from_primitive(i,jm,k,rho,0.d0,0.d0,0.d0,prs,const6)
      call set_qrhs_zero(i,jm,k)
    endif
  end subroutine fixed_rti_y_kernel

  attributes(global) subroutine wall_isothermal_noslip_z_kernel(im,jm,km,hm,const2,const6, &
                                                                twall_back,twall_front, &
                                                                apply_back,apply_front)
    use commarray_gpu, only: prs_d,tmp_d
    implicit none
    integer,value :: im,jm,km,hm,apply_back,apply_front
    real(8),value :: const2,const6,twall_back,twall_front
    integer :: id,i,j,nplane
    real(8) :: rho,prs

    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    nplane = (im + 1) * (jm + 1)
    if(id >= nplane) return
    i = mod(id,im+1)
    j = id/(im+1)

    if(apply_back /= 0) then
      prs = extrap2(prs_d(i,j,1),prs_d(i,j,2))
      rho = prs/twall_back*const2
      tmp_d(i,j,0) = twall_back
      call set_q_from_primitive(i,j,0,rho,0.d0,0.d0,0.d0,prs,const6)
      call set_qrhs_zero(i,j,0)
    endif

    if(apply_front /= 0) then
      prs = extrap2(prs_d(i,j,km-1),prs_d(i,j,km-2))
      rho = prs/twall_front*const2
      tmp_d(i,j,km) = twall_front
      call set_q_from_primitive(i,j,km,rho,0.d0,0.d0,0.d0,prs,const6)
      call set_qrhs_zero(i,j,km)
    endif
  end subroutine wall_isothermal_noslip_z_kernel

  attributes(global) subroutine symmetry_z_kernel(im,jm,km,hm,const2,const6,apply_back,apply_front)
    use commarray_gpu, only: rho_d,vel_d,prs_d,tmp_d
    implicit none
    integer,value :: im,jm,km,hm,apply_back,apply_front
    real(8),value :: const2,const6
    integer :: id,i,j,nplane
    real(8) :: rho,uu,vv,ww,prs,tmp

    id = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    nplane = (im + 1) * (jm + 1)
    if(id >= nplane) return
    i = mod(id,im+1)
    j = id/(im+1)

    if(apply_back /= 0) then
      uu  = extrap2(vel_d(i,j,1,1),vel_d(i,j,2,1))
      vv  = extrap2(vel_d(i,j,1,2),vel_d(i,j,2,2))
      ww  = 0.d0
      prs = extrap2(prs_d(i,j,1),prs_d(i,j,2))
      tmp = extrap2(tmp_d(i,j,1),tmp_d(i,j,2))
      rho = prs/tmp*const2
      tmp_d(i,j,0) = tmp
      call set_q_from_primitive(i,j,0,rho,uu,vv,ww,prs,const6)
      call set_qrhs_zero(i,j,0)
    endif

    if(apply_front /= 0) then
      uu  = extrap2(vel_d(i,j,km-1,1),vel_d(i,j,km-2,1))
      vv  = extrap2(vel_d(i,j,km-1,2),vel_d(i,j,km-2,2))
      ww  = 0.d0
      prs = extrap2(prs_d(i,j,km-1),prs_d(i,j,km-2))
      rho = extrap2(rho_d(i,j,km-1),rho_d(i,j,km-2))
      tmp = prs/rho*const2
      tmp_d(i,j,km) = tmp
      call set_q_from_primitive(i,j,km,rho,uu,vv,ww,prs,const6)
      call set_qrhs_zero(i,j,km)
    endif
  end subroutine symmetry_z_kernel

  attributes(device) subroutine nscbc_pmatrix(rho,uu,vv,ww,tmp,ddi,gamma,mach,inv,pmat)
    implicit none
    real(8),value :: rho,uu,vv,ww,tmp,gamma,mach
    real(8),intent(in) :: ddi(3)
    logical,value :: inv
    real(8) :: pmat(5,5)
    real(8) :: var1,nx,ny,nz,a1,a2,a3,a4,a5,a6,css,vn,phi

    css = sqrt(tmp)/mach
    var1 = 1.d0/sqrt(ddi(1)*ddi(1)+ddi(2)*ddi(2)+ddi(3)*ddi(3))
    nx = ddi(1)*var1
    ny = ddi(2)*var1
    nz = ddi(3)*var1
    phi = 0.5d0*(gamma-1.d0)*(uu*uu+vv*vv+ww*ww)
    vn = nx*uu+ny*vv+nz*ww
    a1 = gamma-1.d0
    a2 = 1.d0/(sqrt(2.d0)*rho*css)
    a3 = rho/(css*sqrt(2.d0))
    a4 = (phi+css*css)/(gamma-1.d0)
    a5 = 1.d0-phi/(css*css)
    a6 = phi/(gamma-1.d0)

    if(inv) then
      pmat(1,1)= nx*a5-(nz*vv-ny*ww)/rho
      pmat(1,2)= nx*a1*uu/(css*css)
      pmat(1,3)= nx*a1*vv/(css*css)+nz/rho
      pmat(1,4)= nx*a1*ww/(css*css)-ny/rho
      pmat(1,5)=-nx*a1/(css*css)
      pmat(2,1)= ny*a5-(nx*ww-nz*uu)/rho
      pmat(2,2)= ny*a1*uu/(css*css)-nz/rho
      pmat(2,3)= ny*a1*vv/(css*css)
      pmat(2,4)= ny*a1*ww/(css*css)+nx/rho
      pmat(2,5)=-ny*a1/(css*css)
      pmat(3,1)= nz*a5-(ny*uu-nx*vv)/rho
      pmat(3,2)= nz*a1*uu/(css*css)+ny/rho
      pmat(3,3)= nz*a1*vv/(css*css)-nx/rho
      pmat(3,4)= nz*a1*ww/(css*css)
      pmat(3,5)=-nz*a1/(css*css)
      pmat(4,1)= a2*(phi-css*vn)
      pmat(4,2)=-a2*(a1*uu-nx*css)
      pmat(4,3)=-a2*(a1*vv-ny*css)
      pmat(4,4)=-a2*(a1*ww-nz*css)
      pmat(4,5)= a1*a2
      pmat(5,1)= a2*(phi+css*vn)
      pmat(5,2)=-a2*(a1*uu+nx*css)
      pmat(5,3)=-a2*(a1*vv+ny*css)
      pmat(5,4)=-a2*(a1*ww+nz*css)
      pmat(5,5)= a1*a2
    else
      pmat(1,1)=nx;             pmat(1,2)=ny;             pmat(1,3)=nz
      pmat(1,4)=a3;             pmat(1,5)=a3
      pmat(2,1)=nx*uu;          pmat(2,2)=ny*uu-nz*rho;  pmat(2,3)=nz*uu+ny*rho
      pmat(2,4)=a3*(uu+nx*css); pmat(2,5)=a3*(uu-nx*css)
      pmat(3,1)=nx*vv+nz*rho;  pmat(3,2)=ny*vv;          pmat(3,3)=nz*vv-nx*rho
      pmat(3,4)=a3*(vv+ny*css); pmat(3,5)=a3*(vv-ny*css)
      pmat(4,1)=nx*ww-ny*rho;  pmat(4,2)=ny*ww+nx*rho;  pmat(4,3)=nz*ww
      pmat(4,4)=a3*(ww+nz*css); pmat(4,5)=a3*(ww-nz*css)
      pmat(5,1)=nx*a6+rho*(nz*vv-ny*ww)
      pmat(5,2)=ny*a6+rho*(nx*ww-nz*uu)
      pmat(5,3)=nz*a6+rho*(ny*uu-nx*vv)
      pmat(5,4)=a3*(a4+css*vn); pmat(5,5)=a3*(a4-css*vn)
    endif
  end subroutine nscbc_pmatrix

  attributes(device) subroutine nscbc_flux(i,j,k,idir,flux)
    use commarray_gpu, only: q_d,vel_d,prs_d,jacob_d,dxi_d
    implicit none
    integer,value :: i,j,k,idir
    real(8) :: flux(5)
    real(8) :: un

    un = dxi_d(i,j,k,idir,1)*vel_d(i,j,k,1) + &
         dxi_d(i,j,k,idir,2)*vel_d(i,j,k,2) + &
         dxi_d(i,j,k,idir,3)*vel_d(i,j,k,3)
    flux(1) = jacob_d(i,j,k)*q_d(i,j,k,1)*un
    flux(2) = jacob_d(i,j,k)*(q_d(i,j,k,2)*un+dxi_d(i,j,k,idir,1)*prs_d(i,j,k))
    flux(3) = jacob_d(i,j,k)*(q_d(i,j,k,3)*un+dxi_d(i,j,k,idir,2)*prs_d(i,j,k))
    flux(4) = jacob_d(i,j,k)*(q_d(i,j,k,4)*un+dxi_d(i,j,k,idir,3)*prs_d(i,j,k))
    flux(5) = jacob_d(i,j,k)*(q_d(i,j,k,5)+prs_d(i,j,k))*un
  end subroutine nscbc_flux

  attributes(device) subroutine nscbc_cartesian_flux(i,j,k,idir,flux)
    use commarray_gpu, only: q_d,vel_d,prs_d
    implicit none
    integer,value :: i,j,k,idir
    real(8) :: flux(5)
    real(8) :: un

    un = vel_d(i,j,k,idir)
    flux(1) = q_d(i,j,k,idir+1)
    flux(2) = q_d(i,j,k,2)*un
    flux(3) = q_d(i,j,k,3)*un
    flux(4) = q_d(i,j,k,4)*un
    flux(idir+1) = flux(idir+1) + prs_d(i,j,k)
    flux(5) = (q_d(i,j,k,5)+prs_d(i,j,k))*un
  end subroutine nscbc_cartesian_flux

  attributes(device) subroutine nscbc_tangential_x_rhs(i,j,k,jm,km,npdcj,npdck,dq)
    implicit none
    integer,value :: i,j,k,jm,km,npdcj,npdck
    real(8) :: dq(5),fm(5),fp(5),gm(5),gp(5)

    if(.not.(((npdcj == 1 .or. npdcj == 4) .and. j == 0) .or. &
             ((npdcj == 2 .or. npdcj == 4) .and. j == jm))) then
      call nscbc_flux(i,j-1,k,2,fm)
      call nscbc_flux(i,j+1,k,2,fp)
      dq(:) = dq(:) + 0.5d0*(fp(:)-fm(:))
    endif

    if(.not.(((npdck == 1 .or. npdck == 4) .and. k == 0) .or. &
             ((npdck == 2 .or. npdck == 4) .and. k == km))) then
      call nscbc_flux(i,j,k-1,3,gm)
      call nscbc_flux(i,j,k+1,3,gp)
      dq(:) = dq(:) + 0.5d0*(gp(:)-gm(:))
    endif
  end subroutine nscbc_tangential_x_rhs

  attributes(global) subroutine nscbc_mach2_partial_kernel(partial,im,jm,km,hm,mach)
    use commarray_gpu, only: vel_d,tmp_d,dxi_d
    implicit none
    integer,value :: im,jm,km,hm
    real(8),value :: mach
    real(8),device :: partial(:)
    real(8),shared :: scratch(256)
    integer :: tid,id,stride,ncell,i,j,k
    real(8) :: local,css

    tid = threadIdx%x
    id = (blockIdx%x-1)*blockDim%x + tid - 1
    stride = gridDim%x*blockDim%x
    ncell = (im+1)*(jm+1)*(km+1)
    local = -huge(1.d0)
    do while(id < ncell)
      i = mod(id,im+1)
      j = mod(id/(im+1),jm+1)
      k = id/((im+1)*(jm+1))
      css = sqrt(tmp_d(i,j,k))/mach
      local = max(local,sum(vel_d(i,j,k,:)**2)/(css*css))
      id = id + stride
    enddo
    scratch(tid) = local
    call syncthreads()
    stride = blockDim%x/2
    do while(stride > 0)
      if(tid <= stride) scratch(tid) = max(scratch(tid),scratch(tid+stride))
      call syncthreads()
      stride = stride/2
    enddo
    if(tid == 1) partial(blockIdx%x) = scratch(1)
  end subroutine nscbc_mach2_partial_kernel

  subroutine gpu_nscbc_global_mach2(gmachmax2)
    use mpi
    use commvar, only: im,jm,km,hm,mach
    use gpu_check, only: sync_after_kernel
    use parallel, only: mpisize
    implicit none
    real(8),intent(out) :: gmachmax2
    integer,parameter :: block_size=256
    integer :: ncell,nblocks,ierr
    real(8) :: local_max
    real(8),allocatable,device :: partial_d(:)
    real(8),allocatable :: partial_h(:)

    ncell = (im+1)*(jm+1)*(km+1)
    nblocks = max(1,(ncell+block_size-1)/block_size)
    allocate(partial_d(nblocks),partial_h(nblocks))
    call nscbc_mach2_partial_kernel<<<nblocks,block_size>>>(partial_d,im,jm,km,hm,mach)
    call sync_after_kernel('nscbc_mach2_partial_kernel')
    partial_h = partial_d
    local_max = maxval(partial_h)
    if(mpisize > 1) then
      call mpi_allreduce(local_max,gmachmax2,1,mpi_real8,mpi_max,mpi_comm_world,ierr)
    else
      gmachmax2 = local_max
    endif
    deallocate(partial_d,partial_h)
  end subroutine gpu_nscbc_global_mach2

  attributes(global) subroutine nscbc_outflow_mach2_partial_kernel(partial,im,jm,km,hm,mach)
    use commarray_gpu, only: vel_d,tmp_d,dxi_d
    implicit none
    integer,value :: im,jm,km,hm
    real(8),value :: mach
    real(8),device :: partial(:)
    real(8),shared :: scratch(256)
    integer :: tid,id,stride,ncell,j,k
    real(8) :: local,css,norm2,un

    tid = threadIdx%x
    id = (blockIdx%x-1)*blockDim%x + tid - 1
    stride = gridDim%x*blockDim%x
    ncell = (jm+1)*(km+1)
    local = -huge(1.d0)
    do while(id < ncell)
      j = mod(id,jm+1)
      k = id/(jm+1)
      css = sqrt(tmp_d(im,j,k))/mach
      norm2 = dxi_d(im,j,k,1,1)**2 + dxi_d(im,j,k,1,2)**2 + dxi_d(im,j,k,1,3)**2
      un = dxi_d(im,j,k,1,1)*vel_d(im,j,k,1) + dxi_d(im,j,k,1,2)*vel_d(im,j,k,2) + &
           dxi_d(im,j,k,1,3)*vel_d(im,j,k,3)
      local = max(local,un*un/(norm2*css*css))
      id = id + stride
    enddo
    scratch(tid) = local
    call syncthreads()
    stride = blockDim%x/2
    do while(stride > 0)
      if(tid <= stride) scratch(tid) = max(scratch(tid),scratch(tid+stride))
      call syncthreads()
      stride = stride/2
    enddo
    if(tid == 1) partial(blockIdx%x) = scratch(1)
  end subroutine nscbc_outflow_mach2_partial_kernel

  subroutine gpu_nscbc_outflow_mach2(gmachmax2)
    use mpi
    use commvar, only: im,jm,km,hm,mach
    use gpu_check, only: sync_after_kernel
    use parallel, only: mpisize
    implicit none
    real(8),intent(out) :: gmachmax2
    integer,parameter :: block_size=256
    integer :: ncell,nblocks,ierr
    real(8) :: local_max
    real(8),allocatable,device :: partial_d(:)
    real(8),allocatable :: partial_h(:)

    ncell = (jm+1)*(km+1)
    nblocks = max(1,(ncell+block_size-1)/block_size)
    allocate(partial_d(nblocks),partial_h(nblocks))
    call nscbc_outflow_mach2_partial_kernel<<<nblocks,block_size>>>(partial_d,im,jm,km,hm,mach)
    call sync_after_kernel('nscbc_outflow_mach2_partial_kernel')
    partial_h = partial_d
    local_max = maxval(partial_h)
    if(mpisize > 1) then
      call mpi_allreduce(local_max,gmachmax2,1,mpi_real8,mpi_max,mpi_comm_world,ierr)
    else
      gmachmax2 = local_max
    endif
    deallocate(partial_d,partial_h)
  end subroutine gpu_nscbc_outflow_mach2

  attributes(global) subroutine nscbc_outflow_filter_y_kernel(im,jm,km,hm,apply_right)
    use commarray_gpu, only: q_d,qwork_d
    implicit none
    integer,value :: im,jm,km,hm,apply_right
    integer :: id,j,k,m,n
    real(8) :: ff

    if(apply_right == 0) return
    id = (blockIdx%x-1)*blockDim%x + threadIdx%x - 1
    n = (jm+1)*(km+1)*5
    if(id >= n) return
    j = mod(id,jm+1)
    k = mod(id/(jm+1),km+1)
    m = id/((jm+1)*(km+1)) + 1
    ff = 11.d0/16.d0*q_d(im,j,k,m) + 15.d0/64.d0*(q_d(im,j-1,k,m)+q_d(im,j+1,k,m)) - &
         3.d0/32.d0*(q_d(im,j-2,k,m)+q_d(im,j+2,k,m)) + &
         1.d0/64.d0*(q_d(im,j-3,k,m)+q_d(im,j+3,k,m))
    qwork_d(im,j,k,m) = ff
  end subroutine nscbc_outflow_filter_y_kernel

  attributes(global) subroutine nscbc_copy_outflow_filter_y_kernel(im,jm,km,apply_right)
    use commarray_gpu, only: q_d,qwork_d
    implicit none
    integer,value :: im,jm,km,apply_right
    integer :: id,j,k,m,n

    if(apply_right == 0) return
    id = (blockIdx%x-1)*blockDim%x + threadIdx%x - 1
    n = (jm+1)*(km+1)*5
    if(id >= n) return
    j = mod(id,jm+1)
    k = mod(id/(jm+1),km+1)
    m = id/((jm+1)*(km+1)) + 1
    q_d(im,j,k,m) = qwork_d(im,j,k,m)
  end subroutine nscbc_copy_outflow_filter_y_kernel

  subroutine apply_nscbc_outflow_filter_gpu()
    use commvar, only: im,jm,km,hm
    use gpu_check, only: sync_after_kernel
    implicit none
    type(dim3) :: block,grid
    integer :: apply_left,apply_right,n

    call gpu_physical_boundary_apply_mask(1,apply_left,apply_right)
    block = dim3(256,1,1)
    n = (jm+1)*(km+1)*5
    grid = dim3((n+block%x-1)/block%x,1,1)
    call nscbc_outflow_filter_y_kernel<<<grid,block>>>(im,jm,km,hm,apply_right)
    call sync_after_kernel('nscbc_outflow_filter_y_kernel')
    call nscbc_copy_outflow_filter_y_kernel<<<grid,block>>>(im,jm,km,apply_right)
    call sync_after_kernel('nscbc_copy_outflow_filter_y_kernel')
  end subroutine apply_nscbc_outflow_filter_gpu

  attributes(global) subroutine nscbc_inflow_x_rhs_kernel(im,jm,km,hm,npdcj,npdck,gamma,mach,xmin,xmax, &
                                                           uinf,vinf,winf,pinf,gmachmax2,apply_left)
    use commarray_gpu, only: rho_d,vel_d,prs_d,tmp_d,qrhs_d,jacob_d,dxi_d
    implicit none
    integer,value :: im,jm,km,hm,npdcj,npdck,apply_left
    real(8),value :: gamma,mach,xmin,xmax,uinf,vinf,winf,pinf,gmachmax2
    integer :: id,j,k,ii,m,n
    real(8) :: pnor(5,5),pinv(5,5),ecs(0:2,5),decs(5),rest(5),lodi(5),lodi1(5), &
               ddi(3),flux(5),metric0,metric1,metric2,css,kin,var1

    if(apply_left == 0) return
    id = (blockIdx%x-1)*blockDim%x + threadIdx%x - 1
    n = (jm+1)*(km+1)
    if(id >= n) return
    j = mod(id,jm+1)
    k = id/(jm+1)
    ddi(:) = dxi_d(0,j,k,1,:)
    call nscbc_pmatrix(rho_d(0,j,k),vel_d(0,j,k,1),vel_d(0,j,k,2),vel_d(0,j,k,3), &
                       tmp_d(0,j,k),ddi,gamma,mach,.false.,pnor)
    call nscbc_pmatrix(rho_d(0,j,k),vel_d(0,j,k,1),vel_d(0,j,k,2),vel_d(0,j,k,3), &
                       tmp_d(0,j,k),ddi,gamma,mach,.true.,pinv)
    do ii=0,2
      call nscbc_flux(ii,j,k,1,flux)
      ecs(ii,:) = flux(:)
    enddo
    decs(:) = ecs(1,:)-ecs(0,:)
    metric0 = dxi_d(0,j,k,1,1)*jacob_d(0,j,k)
    metric1 = dxi_d(1,j,k,1,1)*jacob_d(1,j,k)
    metric2 = dxi_d(2,j,k,1,1)*jacob_d(2,j,k)
    rest(:) = 0.d0
    call nscbc_cartesian_flux(0,j,k,1,flux); rest(:) = rest(:) + flux(:)*(metric1-metric0)
    call nscbc_cartesian_flux(0,j,k,2,flux); rest(:) = rest(:) + flux(:)*(dxi_d(1,j,k,1,2)*jacob_d(1,j,k) - &
                                                                   dxi_d(0,j,k,1,2)*jacob_d(0,j,k))
    call nscbc_cartesian_flux(0,j,k,3,flux); rest(:) = rest(:) + flux(:)*(dxi_d(1,j,k,1,3)*jacob_d(1,j,k) - &
                                                                   dxi_d(0,j,k,1,3)*jacob_d(0,j,k))
    lodi1(:) = decs(:)-rest(:)
    do m=1,5
      lodi(m) = sum(pinv(m,:)*lodi1(:))/jacob_d(0,j,k)
    enddo
    css = sqrt(tmp_d(0,j,k))/mach
    kin = 0.25d0*(1.d0-gmachmax2)*css/(xmax-xmin)
    var1 = 1.d0/sqrt(sum(ddi(:)*ddi(:)))
    lodi(1) = 0.d0
    lodi(2) = kin*0.5d0*(ddi(1)*var1*(vel_d(0,j,k,3)-winf)-ddi(3)*var1*(vel_d(0,j,k,1)-uinf))
    lodi(3) = kin*0.5d0*(-ddi(1)*var1*(vel_d(0,j,k,2)-vinf)+ddi(2)*var1*(vel_d(0,j,k,1)-uinf))
    lodi(4) = kin*(ddi(1)*var1*(vel_d(0,j,k,1)-uinf)+ddi(2)*var1*(vel_d(0,j,k,2)-vinf)+ &
                   ddi(3)*var1*(vel_d(0,j,k,3)-winf)+(prs_d(0,j,k)-pinf)/rho_d(0,j,k)/css)
    do m=1,5
      lodi1(m) = sum(pnor(m,:)*lodi(:))*jacob_d(0,j,k)
    enddo
    decs(:) = lodi1(:)+rest(:)
    call nscbc_tangential_x_rhs(0,j,k,jm,km,npdcj,npdck,decs)
    ! CPU accumulates boundary flux derivatives before rhscal negates qrhs.
    ! GPU convection writes the final RHS sign directly.
    qrhs_d(0,j,k,:) = qrhs_d(0,j,k,:) - decs(:)
  end subroutine nscbc_inflow_x_rhs_kernel

  attributes(global) subroutine nscbc_outflow_x_rhs_kernel(im,jm,km,hm,npdcj,npdck,gamma,mach,xmin,xmax,pinf,pout, &
                                                            gmachmax2,apply_right)
    use commarray_gpu, only: rho_d,vel_d,prs_d,tmp_d,qrhs_d,jacob_d,dxi_d
    implicit none
    integer,value :: im,jm,km,hm,npdcj,npdck,apply_right
    real(8),value :: gamma,mach,xmin,xmax,pinf,pout,gmachmax2
    integer :: id,j,k,ii,m,n
    real(8) :: pnor(5,5),pinv(5,5),ecs(0:2,5),decs(5),rest(5),lodi(5),lodi1(5), &
               ddi(3),flux(5),css,kinout

    if(apply_right == 0) return
    id = (blockIdx%x-1)*blockDim%x + threadIdx%x - 1
    n = (jm+1)*(km+1)
    if(id >= n) return
    j = mod(id,jm+1)
    k = id/(jm+1)
    ddi(:) = dxi_d(im,j,k,1,:)
    call nscbc_pmatrix(rho_d(im,j,k),vel_d(im,j,k,1),vel_d(im,j,k,2),vel_d(im,j,k,3), &
                       tmp_d(im,j,k),ddi,gamma,mach,.false.,pnor)
    call nscbc_pmatrix(rho_d(im,j,k),vel_d(im,j,k,1),vel_d(im,j,k,2),vel_d(im,j,k,3), &
                       tmp_d(im,j,k),ddi,gamma,mach,.true.,pinv)
    do ii=0,2
      call nscbc_flux(im-ii,j,k,1,flux)
      ecs(ii,:) = flux(:)
    enddo
    decs(:) = 1.5d0*ecs(0,:) - 2.d0*ecs(1,:) + 0.5d0*ecs(2,:)
    rest(:) = 0.d0
    call nscbc_cartesian_flux(im,j,k,1,flux); rest(:) = rest(:) + flux(:)*(1.5d0*dxi_d(im,j,k,1,1)*jacob_d(im,j,k) - &
         2.d0*dxi_d(im-1,j,k,1,1)*jacob_d(im-1,j,k) + 0.5d0*dxi_d(im-2,j,k,1,1)*jacob_d(im-2,j,k))
    call nscbc_cartesian_flux(im,j,k,2,flux); rest(:) = rest(:) + flux(:)*(1.5d0*dxi_d(im,j,k,1,2)*jacob_d(im,j,k) - &
         2.d0*dxi_d(im-1,j,k,1,2)*jacob_d(im-1,j,k) + 0.5d0*dxi_d(im-2,j,k,1,2)*jacob_d(im-2,j,k))
    call nscbc_cartesian_flux(im,j,k,3,flux); rest(:) = rest(:) + flux(:)*(1.5d0*dxi_d(im,j,k,1,3)*jacob_d(im,j,k) - &
         2.d0*dxi_d(im-1,j,k,1,3)*jacob_d(im-1,j,k) + 0.5d0*dxi_d(im-2,j,k,1,3)*jacob_d(im-2,j,k))
    lodi1(:) = decs(:)-rest(:)
    do m=1,5
      lodi(m) = sum(pinv(m,:)*lodi1(:))/jacob_d(im,j,k)
    enddo
    css = sqrt(tmp_d(im,j,k))/mach
    kinout = 3.75d0*(1.d0-gmachmax2)*css/(xmax-xmin)
    lodi(5) = kinout*(prs_d(im,j,k)-pinf*pout)
    do m=1,5
      lodi1(m) = sum(pnor(m,:)*lodi(:))*jacob_d(im,j,k)
    enddo
    decs(:) = lodi1(:)+rest(:)
    call nscbc_tangential_x_rhs(im,j,k,jm,km,npdcj,npdck,decs)
    qrhs_d(im,j,k,:) = qrhs_d(im,j,k,:) + decs(:)
  end subroutine nscbc_outflow_x_rhs_kernel

  subroutine apply_nscbc_x_rhs_gpu(gmachmax2_in,gmachmax2_out)
    use commvar, only: im,jm,km,hm,npdcj,npdck,gamma,mach,xmin,xmax,uinf,vinf,winf,pinf
    use bc, only: pout
    use gpu_check, only: sync_after_kernel
    implicit none
    real(8),intent(in) :: gmachmax2_in,gmachmax2_out
    type(dim3) :: block,grid
    integer :: apply_left,apply_right,n

    call gpu_physical_boundary_apply_mask(1,apply_left,apply_right)
    block = dim3(256,1,1)
    n = (jm+1)*(km+1)
    grid = dim3((n+block%x-1)/block%x,1,1)
    call nscbc_inflow_x_rhs_kernel<<<grid,block>>>(im,jm,km,hm,npdcj,npdck,gamma,mach,xmin,xmax, &
         uinf,vinf,winf,pinf,gmachmax2_in,apply_left)
    call sync_after_kernel('nscbc_inflow_x_rhs_kernel')
    call nscbc_outflow_x_rhs_kernel<<<grid,block>>>(im,jm,km,hm,npdcj,npdck,gamma,mach,xmin,xmax, &
         pinf,pout,gmachmax2_out,apply_right)
    call sync_after_kernel('nscbc_outflow_x_rhs_kernel')
  end subroutine apply_nscbc_x_rhs_gpu

  subroutine apply_nscbc_inflow_x_rhs_gpu(gmachmax2_in)
    use commvar, only: im,jm,km,hm,npdcj,npdck,gamma,mach,xmin,xmax,uinf,vinf,winf,pinf
    use gpu_check, only: sync_after_kernel
    implicit none
    real(8),intent(in) :: gmachmax2_in
    type(dim3) :: block,grid
    integer :: apply_left,apply_right,n

    call gpu_physical_boundary_apply_mask(1,apply_left,apply_right)
    block = dim3(256,1,1)
    n = (jm+1)*(km+1)
    grid = dim3((n+block%x-1)/block%x,1,1)
    call nscbc_inflow_x_rhs_kernel<<<grid,block>>>(im,jm,km,hm,npdcj,npdck,gamma,mach,xmin,xmax, &
         uinf,vinf,winf,pinf,gmachmax2_in,apply_left)
    call sync_after_kernel('nscbc_inflow_x_rhs_kernel')
  end subroutine apply_nscbc_inflow_x_rhs_gpu

  attributes(device) real(8) function nscbc_filter6_value_axis(value_m5,value_m4,value_m3, &
                                                               value_m2,value_m1,value_0, &
                                                               value_p1,value_p2,value_p3, &
                                                               value_p4,value_p5,idx,dim,ntype)
    implicit none
    integer,value :: idx,dim,ntype
    real(8),value :: value_m5,value_m4,value_m3,value_m2,value_m1,value_0
    real(8),value :: value_p1,value_p2,value_p3,value_p4,value_p5

    select case(ntype)
    case(1)
      if(idx == 0) then
        nscbc_filter6_value_axis = 15.d0/16.d0*value_0 + 0.25d0*value_p1 - &
             3.d0/8.d0*value_p2 + 0.25d0*value_p3 - 1.d0/16.d0*value_p4
      elseif(idx == 1) then
        nscbc_filter6_value_axis = 1.d0/16.d0*value_m1 + 0.75d0*value_0 + &
             3.d0/8.d0*value_p1 - 0.25d0*value_p2 + 1.d0/16.d0*value_p3
      elseif(idx == 2) then
        nscbc_filter6_value_axis = 5.d0/8.d0*value_0 + 0.25d0*(value_m1+value_p1) - &
             1.d0/16.d0*(value_m2+value_p2)
      else
        nscbc_filter6_value_axis = 11.d0/16.d0*value_0 + &
             15.d0/64.d0*(value_m1+value_p1) - &
              3.d0/32.d0*(value_m2+value_p2) + &
              1.d0/64.d0*(value_m3+value_p3)
      endif
    case(2)
      if(idx == dim-2) then
        nscbc_filter6_value_axis = 5.d0/8.d0*value_0 + 0.25d0*(value_m1+value_p1) - &
             1.d0/16.d0*(value_m2+value_p2)
      elseif(idx == dim-1) then
        nscbc_filter6_value_axis = 1.d0/16.d0*value_p1 + 0.75d0*value_0 + &
             3.d0/8.d0*value_m1 - 0.25d0*value_m2 + 1.d0/16.d0*value_m3
      elseif(idx == dim) then
        nscbc_filter6_value_axis = 15.d0/16.d0*value_0 + 0.25d0*value_m1 - &
             3.d0/8.d0*value_m2 + 0.25d0*value_m3 - 1.d0/16.d0*value_m4
      else
        nscbc_filter6_value_axis = 11.d0/16.d0*value_0 + &
             15.d0/64.d0*(value_m1+value_p1) - &
              3.d0/32.d0*(value_m2+value_p2) + &
              1.d0/64.d0*(value_m3+value_p3)
      endif
    case(3)
      nscbc_filter6_value_axis = 11.d0/16.d0*value_0 + &
           15.d0/64.d0*(value_m1+value_p1) - &
            3.d0/32.d0*(value_m2+value_p2) + &
            1.d0/64.d0*(value_m3+value_p3)
    case(4)
      if(idx == 0) then
        nscbc_filter6_value_axis = 15.d0/16.d0*value_0 + 0.25d0*value_p1 - &
             3.d0/8.d0*value_p2 + 0.25d0*value_p3 - 1.d0/16.d0*value_p4
      elseif(idx == 1) then
        nscbc_filter6_value_axis = 1.d0/16.d0*value_m1 + 0.75d0*value_0 + &
             3.d0/8.d0*value_p1 - 0.25d0*value_p2 + 1.d0/16.d0*value_p3
      elseif(idx == 2) then
        nscbc_filter6_value_axis = 5.d0/8.d0*value_0 + 0.25d0*(value_m1+value_p1) - &
             1.d0/16.d0*(value_m2+value_p2)
      elseif(idx == dim-2) then
        nscbc_filter6_value_axis = 5.d0/8.d0*value_0 + 0.25d0*(value_m1+value_p1) - &
             1.d0/16.d0*(value_m2+value_p2)
      elseif(idx == dim-1) then
        nscbc_filter6_value_axis = 1.d0/16.d0*value_p1 + 0.75d0*value_0 + &
             3.d0/8.d0*value_m1 - 0.25d0*value_m2 + 1.d0/16.d0*value_m3
      elseif(idx == dim) then
        nscbc_filter6_value_axis = 15.d0/16.d0*value_0 + 0.25d0*value_m1 - &
             3.d0/8.d0*value_m2 + 0.25d0*value_m3 - 1.d0/16.d0*value_m4
      else
        nscbc_filter6_value_axis = 11.d0/16.d0*value_0 + &
             15.d0/64.d0*(value_m1+value_p1) - &
              3.d0/32.d0*(value_m2+value_p2) + &
              1.d0/64.d0*(value_m3+value_p3)
      endif
    case default
      nscbc_filter6_value_axis = value_0
    end select
  end function nscbc_filter6_value_axis

  attributes(global) subroutine nscbc_farfield_y_upper_filter_x_kernel(im,jm,km,npdci,apply_up)
    use commarray_gpu, only: q_d,qwork_d
    implicit none
    integer,value :: im,jm,km,npdci,apply_up
    integer :: id,i,k,m,n,km5,km4,km3,km2,km1,kp1,kp2,kp3,kp4,kp5

    if(apply_up == 0) return
    id = (blockIdx%x-1)*blockDim%x + threadIdx%x - 1
    n = (im+1)*(km+1)*5
    if(id >= n) return
    i = mod(id,im+1)
    k = mod(id/(im+1),km+1)
    m = id/((im+1)*(km+1)) + 1
    qwork_d(i,jm,k,m) = nscbc_filter6_value_axis( &
         q_d(i-5,jm,k,m),q_d(i-4,jm,k,m),q_d(i-3,jm,k,m),q_d(i-2,jm,k,m), &
         q_d(i-1,jm,k,m),q_d(i,jm,k,m),q_d(i+1,jm,k,m),q_d(i+2,jm,k,m), &
         q_d(i+3,jm,k,m),q_d(i+4,jm,k,m),q_d(i+5,jm,k,m),i,im,npdci)
  end subroutine nscbc_farfield_y_upper_filter_x_kernel

  attributes(global) subroutine nscbc_farfield_y_upper_filter_copy_kernel(im,jm,km,apply_up)
    use commarray_gpu, only: q_d,qwork_d
    implicit none
    integer,value :: im,jm,km,apply_up
    integer :: id,i,k,m,n

    if(apply_up == 0) return
    id = (blockIdx%x-1)*blockDim%x + threadIdx%x - 1
    n = (im+1)*(km+1)*5
    if(id >= n) return
    i = mod(id,im+1)
    k = mod(id/(im+1),km+1)
    m = id/((im+1)*(km+1)) + 1
    q_d(i,jm,k,m) = qwork_d(i,jm,k,m)
  end subroutine nscbc_farfield_y_upper_filter_copy_kernel

  attributes(global) subroutine nscbc_farfield_y_upper_filter_z_kernel(im,jm,km,npdck,apply_up)
    use commarray_gpu, only: q_d,qwork_d
    implicit none
    integer,value :: im,jm,km,npdck,apply_up
    integer :: id,i,k,m,n

    if(apply_up == 0) return
    id = (blockIdx%x-1)*blockDim%x + threadIdx%x - 1
    n = (im+1)*(km+1)*5
    if(id >= n) return
    i = mod(id,im+1)
    k = mod(id/(im+1),km+1)
    m = id/((im+1)*(km+1)) + 1
    qwork_d(i,jm,k,m) = nscbc_filter6_value_axis( &
         q_d(i,jm,k-5,m),q_d(i,jm,k-4,m),q_d(i,jm,k-3,m),q_d(i,jm,k-2,m), &
         q_d(i,jm,k-1,m),q_d(i,jm,k,m),q_d(i,jm,k+1,m),q_d(i,jm,k+2,m), &
         q_d(i,jm,k+3,m),q_d(i,jm,k+4,m),q_d(i,jm,k+5,m),k,km,npdck)
  end subroutine nscbc_farfield_y_upper_filter_z_kernel

  subroutine apply_nscbc_farfield_y_upper_filter_x_gpu()
    use commvar, only: im,jm,km,lfilter,npdci
    use gpu_check, only: sync_after_kernel
    implicit none
    type(dim3) :: block,grid
    integer :: apply_down,apply_up,n

    if(lfilter) return
    call gpu_physical_boundary_apply_mask(2,apply_down,apply_up)
    block = dim3(256,1,1)
    n = (im+1)*(km+1)*5
    grid = dim3((n+block%x-1)/block%x,1,1)
    call nscbc_farfield_y_upper_filter_x_kernel<<<grid,block>>>(im,jm,km,npdci,apply_up)
    call sync_after_kernel('nscbc_farfield_y_upper_filter_x_kernel')
    call nscbc_farfield_y_upper_filter_copy_kernel<<<grid,block>>>(im,jm,km,apply_up)
    call sync_after_kernel('nscbc_farfield_y_upper_filter_x_copy_kernel')
  end subroutine apply_nscbc_farfield_y_upper_filter_x_gpu

  subroutine apply_nscbc_farfield_y_upper_filter_z_gpu()
    use commvar, only: im,jm,km,lfilter,npdck
    use gpu_check, only: sync_after_kernel
    implicit none
    type(dim3) :: block,grid
    integer :: apply_down,apply_up,n

    if(lfilter) return
    call gpu_physical_boundary_apply_mask(2,apply_down,apply_up)
    block = dim3(256,1,1)
    n = (im+1)*(km+1)*5
    grid = dim3((n+block%x-1)/block%x,1,1)
    call nscbc_farfield_y_upper_filter_z_kernel<<<grid,block>>>(im,jm,km,npdck,apply_up)
    call sync_after_kernel('nscbc_farfield_y_upper_filter_z_kernel')
    call nscbc_farfield_y_upper_filter_copy_kernel<<<grid,block>>>(im,jm,km,apply_up)
    call sync_after_kernel('nscbc_farfield_y_upper_filter_z_copy_kernel')
  end subroutine apply_nscbc_farfield_y_upper_filter_z_gpu

  attributes(global) subroutine nscbc_farfield_y_upper_mach2_partial_kernel(partial,im,jm,km,hm,mach)
    use commarray_gpu, only: vel_d,tmp_d,dxi_d
    implicit none
    integer,value :: im,jm,km,hm
    real(8),value :: mach
    real(8),device :: partial(:)
    real(8),shared :: scratch(256)
    integer :: tid,id,stride,ncell,i,k
    real(8) :: local,css,norm2,un

    tid = threadIdx%x
    id = (blockIdx%x-1)*blockDim%x + tid - 1
    stride = gridDim%x*blockDim%x
    ncell = (im+1)*(km+1)
    local = -huge(1.d0)
    do while(id < ncell)
      i = mod(id,im+1)
      k = id/(im+1)
      css = sqrt(tmp_d(i,jm,k))/mach
      norm2 = dxi_d(i,jm,k,2,1)**2 + dxi_d(i,jm,k,2,2)**2 + dxi_d(i,jm,k,2,3)**2
      un = dxi_d(i,jm,k,2,1)*vel_d(i,jm,k,1) + dxi_d(i,jm,k,2,2)*vel_d(i,jm,k,2) + &
           dxi_d(i,jm,k,2,3)*vel_d(i,jm,k,3)
      local = max(local,un*un/(norm2*css*css))
      id = id + stride
    enddo
    scratch(tid) = local
    call syncthreads()
    stride = blockDim%x/2
    do while(stride > 0)
      if(tid <= stride) scratch(tid) = max(scratch(tid),scratch(tid+stride))
      call syncthreads()
      stride = stride/2
    enddo
    if(tid == 1) partial(blockIdx%x) = scratch(1)
  end subroutine nscbc_farfield_y_upper_mach2_partial_kernel

  subroutine gpu_nscbc_farfield_y_upper_mach2(gmachmax2)
    use mpi
    use commvar, only: im,jm,km,hm,mach
    use gpu_check, only: sync_after_kernel
    use parallel, only: mpisize
    implicit none
    real(8),intent(out) :: gmachmax2
    integer,parameter :: block_size=256
    integer :: ncell,nblocks,ierr,apply_down,apply_up
    real(8) :: local_max
    real(8),allocatable,device :: partial_d(:)
    real(8),allocatable :: partial_h(:)

    ncell = (im+1)*(km+1)
    nblocks = max(1,(ncell+block_size-1)/block_size)
    allocate(partial_d(nblocks),partial_h(nblocks))
    call gpu_physical_boundary_apply_mask(2,apply_down,apply_up)
    if(apply_up /= 0) then
      call nscbc_farfield_y_upper_mach2_partial_kernel<<<nblocks,block_size>>>(partial_d,im,jm,km,hm,mach)
      call sync_after_kernel('nscbc_farfield_y_upper_mach2_partial_kernel')
      partial_h = partial_d
      local_max = maxval(partial_h)
    else
      ! CPU farfield_nscbc contributes only from the true upper-y face.
      local_max = -huge(1.d0)
    endif
    if(mpisize > 1) then
      call mpi_allreduce(local_max,gmachmax2,1,mpi_real8,mpi_max,mpi_comm_world,ierr)
    else
      gmachmax2 = local_max
    endif
    deallocate(partial_d,partial_h)
  end subroutine gpu_nscbc_farfield_y_upper_mach2

  attributes(global) subroutine nscbc_farfield_y_upper_rhs_kernel(im,jm,km,hm,npdci,npdck,gamma,mach,ymin,ymax,pinf, &
                                                                  gmachmax2,apply_up)
    use commarray_gpu, only: rho_d,vel_d,prs_d,tmp_d,qrhs_d,jacob_d,dxi_d
    implicit none
    integer,value :: im,jm,km,hm,npdci,npdck,apply_up
    real(8),value :: gamma,mach,ymin,ymax,pinf,gmachmax2
    integer :: id,i,k,ii,m,n
    real(8) :: pnor(5,5),pinv(5,5),ecs(0:2,5),decs(5),rest(5),lodi(5),lodi1(5), &
               ddi(3),flux(5),css,kinout,metric
    real(8) :: flux_m(5),flux_p(5)

    if(apply_up == 0) return
    id = (blockIdx%x-1)*blockDim%x + threadIdx%x - 1
    n = (im+1)*(km+1)
    if(id >= n) return
    i = mod(id,im+1)
    k = id/(im+1)
    ddi(:) = dxi_d(i,jm,k,2,:)
    call nscbc_pmatrix(rho_d(i,jm,k),vel_d(i,jm,k,1),vel_d(i,jm,k,2),vel_d(i,jm,k,3), &
                       tmp_d(i,jm,k),ddi,gamma,mach,.false.,pnor)
    call nscbc_pmatrix(rho_d(i,jm,k),vel_d(i,jm,k,1),vel_d(i,jm,k,2),vel_d(i,jm,k,3), &
                       tmp_d(i,jm,k),ddi,gamma,mach,.true.,pinv)

    do ii=0,2
      call nscbc_flux(i,jm-ii,k,2,flux)
      ecs(ii,:) = flux(:)
    enddo
    decs(:) = 1.5d0*ecs(0,:) - 2.d0*ecs(1,:) + 0.5d0*ecs(2,:)

    rest(:) = 0.d0
    call nscbc_cartesian_flux(i,jm,k,1,flux)
    metric = 1.5d0*dxi_d(i,jm,k,2,1)*jacob_d(i,jm,k) - &
             2.d0*dxi_d(i,jm-1,k,2,1)*jacob_d(i,jm-1,k) + &
             0.5d0*dxi_d(i,jm-2,k,2,1)*jacob_d(i,jm-2,k)
    rest(:) = rest(:) + flux(:)*metric
    call nscbc_cartesian_flux(i,jm,k,2,flux)
    metric = 1.5d0*dxi_d(i,jm,k,2,2)*jacob_d(i,jm,k) - &
             2.d0*dxi_d(i,jm-1,k,2,2)*jacob_d(i,jm-1,k) + &
             0.5d0*dxi_d(i,jm-2,k,2,2)*jacob_d(i,jm-2,k)
    rest(:) = rest(:) + flux(:)*metric
    call nscbc_cartesian_flux(i,jm,k,3,flux)
    metric = 1.5d0*dxi_d(i,jm,k,2,3)*jacob_d(i,jm,k) - &
             2.d0*dxi_d(i,jm-1,k,2,3)*jacob_d(i,jm-1,k) + &
             0.5d0*dxi_d(i,jm-2,k,2,3)*jacob_d(i,jm-2,k)
    rest(:) = rest(:) + flux(:)*metric

    lodi1(:) = decs(:)-rest(:)
    do m=1,5
      lodi(m) = sum(pinv(m,:)*lodi1(:))/jacob_d(i,jm,k)
    enddo
    css = sqrt(tmp_d(i,jm,k))/mach
    kinout = 0.25d0*(1.d0-gmachmax2)*css/(ymax-ymin)
    lodi(5) = kinout*(prs_d(i,jm,k)-pinf)
    do m=1,5
      lodi1(m) = sum(pnor(m,:)*lodi(:))*jacob_d(i,jm,k)
    enddo
    decs(:) = lodi1(:)+rest(:)

    if(.not.(((npdci == 1 .or. npdci == 4) .and. i == 0) .or. &
             ((npdci == 2 .or. npdci == 4) .and. i == im))) then
      call nscbc_flux(i-1,jm,k,1,flux_m)
      call nscbc_flux(i+1,jm,k,1,flux_p)
      do m=1,5
        decs(m) = decs(m) + 0.5d0*(flux_p(m)-flux_m(m))
      enddo
    endif

    if(.not.(((npdck == 1 .or. npdck == 4) .and. k == 0) .or. &
             ((npdck == 2 .or. npdck == 4) .and. k == km))) then
      call nscbc_flux(i,jm,k-1,3,flux_m)
      call nscbc_flux(i,jm,k+1,3,flux_p)
      decs(:) = decs(:) + 0.5d0*(flux_p(:)-flux_m(:))
    endif
    ! CPU forms this boundary flux derivative before rhscal negates qrhs.
    qrhs_d(i,jm,k,:) = qrhs_d(i,jm,k,:) - decs(:)
  end subroutine nscbc_farfield_y_upper_rhs_kernel

  subroutine apply_nscbc_farfield_y_upper_rhs_gpu(gmachmax2)
    use commvar, only: im,jm,km,hm,npdci,npdck,gamma,mach,ymin,ymax,pinf
    use gpu_check, only: sync_after_kernel
    implicit none
    real(8),intent(in) :: gmachmax2
    type(dim3) :: block,grid
    integer :: apply_down,apply_up,n

    call gpu_physical_boundary_apply_mask(2,apply_down,apply_up)
    block = dim3(256,1,1)
    n = (im+1)*(km+1)
    grid = dim3((n+block%x-1)/block%x,1,1)
    call nscbc_farfield_y_upper_rhs_kernel<<<grid,block>>>(im,jm,km,hm,npdci,npdck,gamma,mach,ymin,ymax, &
         pinf,gmachmax2,apply_up)
    call sync_after_kernel('nscbc_farfield_y_upper_rhs_kernel')
  end subroutine apply_nscbc_farfield_y_upper_rhs_gpu

  subroutine apply_s1_flatplate_boundary_conditions_gpu(preserve_inflow_rhs)
    use commvar, only: im,jm,km,hm,const2,const6,gamma,mach,pinf
    use bc, only: bctype,twall,pout
    use gpu_check, only: sync_after_kernel
    implicit none
    logical,intent(in),optional :: preserve_inflow_rhs
    type(dim3) :: block,grid_x,grid_y
    integer :: apply_left,apply_right,apply_down,apply_up,nx,ny,preserve_rhs

    if(bctype(1) == GPU_BC_INFLOW .and. (.not.s1_bl_profile_ready)) &
      stop 'GPU S1 flatplate profile has not been uploaded'
    call gpu_physical_boundary_apply_mask(1,apply_left,apply_right)
    call gpu_physical_boundary_apply_mask(2,apply_down,apply_up)
    preserve_rhs=0
    if(present(preserve_inflow_rhs)) then
      if(preserve_inflow_rhs .and. apply_left /= 0) preserve_rhs=1
    endif
    block = dim3(256,1,1)
    nx = (jm+1)*(km+1)
    ny = (im+1)*(km+1)
    grid_x = dim3((nx+block%x-1)/block%x,1,1)
    grid_y = dim3((ny+block%x-1)/block%x,1,1)
    if(bctype(1) == GPU_BC_INFLOW) then
      call s1_bl_profile_inflow_x_kernel<<<grid_x,block>>>(im,jm,km,const6,apply_left)
      call sync_after_kernel('s1_bl_profile_inflow_x_kernel')
    endif
    call outflow_x_kernel<<<grid_x,block>>>(im,jm,km,hm,const2,const6, &
                                             gamma,mach,pinf,pout,apply_right)
    call sync_after_kernel('s1_bl_outflow_x_kernel')
    call wall_isothermal_noslip_y_kernel<<<grid_y,block>>>(im,jm,km,hm,const2,const6, &
                                                           twall(3),twall(3),apply_down,0,preserve_rhs)
    call sync_after_kernel('s1_bl_wall_isothermal_noslip_y_kernel')
    if(bctype(4) /= GPU_BC_NSCBC_FARFIELD) then
      call s1_bl_farfield_y_upper_kernel<<<grid_y,block>>>(im,jm,km,const2,const6,apply_up)
      call sync_after_kernel('s1_bl_farfield_y_upper_kernel')
    endif
  end subroutine apply_s1_flatplate_boundary_conditions_gpu

  subroutine apply_boundary_conditions_gpu()
    use commvar, only: im,jm,km,hm,const2,const6,uinf,vinf,winf,pinf,gamma,mach
    use bc, only: twall,xslip,pout
    use gpu_check, only: sync_after_kernel
    implicit none
    type(dim3) :: block,grid
    integer :: n,axis,kind,lower_kind,upper_kind,apply_lower,apply_upper

    axis = gpu_physical_boundary_axis()
    kind = gpu_physical_boundary_kind()
    lower_kind = gpu_bc_lower_kind_for_axis(axis)
    upper_kind = gpu_bc_upper_kind_for_axis(axis)
    call gpu_physical_boundary_apply_mask(axis,apply_lower,apply_upper)

    select case(axis)
    case(0)
      return
    case(1)
      block = dim3(256,1,1)
      n = (jm + 1) * (km + 1)
      grid = dim3((n + block%x - 1)/block%x,1,1)
      if(lower_kind == GPU_BC_INFLOW .and. upper_kind == GPU_BC_OUTFLOW) then
        call inflow_x_kernel<<<grid,block>>>(im,jm,km,hm,const2,const6, &
                                              uinf,vinf,winf,pinf,apply_lower)
        call sync_after_kernel('inflow_x_kernel')
        call outflow_x_kernel<<<grid,block>>>(im,jm,km,hm,const2,const6, &
                                               gamma,mach,pinf,pout,apply_upper)
        call sync_after_kernel('outflow_x_kernel')
      elseif(kind == GPU_BC_ZEROEXTRAP) then
        call zeroextrap_x_kernel<<<grid,block>>>(im,jm,km,hm,const2,const6, &
                                                 apply_lower,apply_upper)
        call sync_after_kernel('zeroextrap_x_kernel')
      elseif(kind == GPU_BC_SYMMETRY) then
        call symmetry_x_kernel<<<grid,block>>>(im,jm,km,hm,const2,const6, &
                                               apply_lower,apply_upper)
        call sync_after_kernel('symmetry_x_kernel')
      elseif(kind == GPU_BC_WALL_ISOTHERMAL_NOSLIP) then
        call wall_isothermal_noslip_x_kernel<<<grid,block>>>(im,jm,km,hm,const2,const6, &
                                                             twall(1),twall(2), &
                                                             apply_lower,apply_upper)
        call sync_after_kernel('wall_isothermal_noslip_x_kernel')
      elseif(kind == GPU_BC_WALL_ADIABATIC_NOSLIP) then
        call wall_adiabatic_noslip_x_kernel<<<grid,block>>>(im,jm,km,hm,const2,const6, &
                                                            apply_lower,apply_upper)
        call sync_after_kernel('wall_adiabatic_noslip_x_kernel')
      endif
    case(2)
      block = dim3(256,1,1)
      n = (im + 1) * (km + 1)
      grid = dim3((n + block%x - 1)/block%x,1,1)
      if(kind == GPU_BC_ZEROEXTRAP) then
        call zeroextrap_y_kernel<<<grid,block>>>(im,jm,km,hm,const2,const6, &
                                                 apply_lower,apply_upper)
        call sync_after_kernel('zeroextrap_y_kernel')
      elseif(kind == GPU_BC_SYMMETRY) then
        call symmetry_y_kernel<<<grid,block>>>(im,jm,km,hm,const2,const6, &
                                               apply_lower,apply_upper)
        call sync_after_kernel('symmetry_y_kernel')
      elseif(kind == GPU_BC_WALL_ISOTHERMAL_NOSLIP) then
        call wall_isothermal_noslip_y_kernel<<<grid,block>>>(im,jm,km,hm,const2,const6, &
                                                             twall(3),twall(4), &
                                                             apply_lower,apply_upper,0)
        call sync_after_kernel('wall_isothermal_noslip_y_kernel')
      elseif(kind == GPU_BC_WALL_ADIABATIC_NOSLIP) then
        call wall_adiabatic_noslip_y_kernel<<<grid,block>>>(im,jm,km,hm,const2,const6, &
                                                            apply_lower,apply_upper)
        call sync_after_kernel('wall_adiabatic_noslip_y_kernel')
      elseif(kind == GPU_BC_WALL_SLIP_ISOTHERMAL) then
        call wall_slip_isothermal_y_kernel<<<grid,block>>>(im,jm,km,hm,const2,const6, &
                                                           xslip,twall(3),twall(4), &
                                                           apply_lower,apply_upper)
        call sync_after_kernel('wall_slip_isothermal_y_kernel')
      elseif(kind == GPU_BC_WALL_SLIP_ADIABATIC) then
        call wall_slip_adiabatic_y_kernel<<<grid,block>>>(im,jm,km,hm,const2,const6, &
                                                          apply_lower,apply_upper)
        call sync_after_kernel('wall_slip_adiabatic_y_kernel')
      elseif(kind == GPU_BC_FIXED) then
        call fixed_rti_y_kernel<<<grid,block>>>(im,jm,km,hm,const2,const6, &
                                                apply_lower,apply_upper)
        call sync_after_kernel('fixed_rti_y_kernel')
      endif
    case(3)
      block = dim3(256,1,1)
      n = (im + 1) * (jm + 1)
      grid = dim3((n + block%x - 1)/block%x,1,1)
      if(kind == GPU_BC_ZEROEXTRAP) then
        call zeroextrap_z_kernel<<<grid,block>>>(im,jm,km,hm,const2,const6, &
                                                 apply_lower,apply_upper)
        call sync_after_kernel('zeroextrap_z_kernel')
      elseif(kind == GPU_BC_SYMMETRY) then
        call symmetry_z_kernel<<<grid,block>>>(im,jm,km,hm,const2,const6, &
                                               apply_lower,apply_upper)
        call sync_after_kernel('symmetry_z_kernel')
      elseif(kind == GPU_BC_WALL_ISOTHERMAL_NOSLIP) then
        call wall_isothermal_noslip_z_kernel<<<grid,block>>>(im,jm,km,hm,const2,const6, &
                                                             twall(5),twall(6), &
                                                             apply_lower,apply_upper)
        call sync_after_kernel('wall_isothermal_noslip_z_kernel')
      endif
    end select
  end subroutine apply_boundary_conditions_gpu

  subroutine apply_ldc_boundary_conditions_gpu()
    use commvar, only: im,jm,km,hm,const2,const6
    use bc, only: twall
    use gpu_check, only: sync_after_kernel
    implicit none
    type(dim3) :: block,grid
    integer :: n,apply_left,apply_right,apply_down,apply_up

    call gpu_physical_boundary_apply_mask(1,apply_left,apply_right)
    call gpu_physical_boundary_apply_mask(2,apply_down,apply_up)

    block = dim3(256,1,1)
    n = (jm + 1) * (km + 1)
    grid = dim3((n + block%x - 1)/block%x,1,1)
    call wall_isothermal_noslip_x_kernel<<<grid,block>>>(im,jm,km,hm,const2,const6, &
                                                         twall(1),twall(2), &
                                                         apply_left,apply_right)
    call sync_after_kernel('ldc_wall_isothermal_noslip_x_kernel')

    n = (im + 1) * (km + 1)
    grid = dim3((n + block%x - 1)/block%x,1,1)
    call wall_isothermal_noslip_y_kernel<<<grid,block>>>(im,jm,km,hm,const2,const6, &
                                                         twall(3),twall(4), &
                                                         apply_down,0,0)
    call sync_after_kernel('ldc_wall_isothermal_noslip_y_down_kernel')

    call ldc_top_lid_y_kernel<<<grid,block>>>(im,jm,km,hm,const2,const6,apply_up)
    call sync_after_kernel('ldc_top_lid_y_kernel')
  end subroutine apply_ldc_boundary_conditions_gpu
end module boundary_gpu
