module inflow_interpolation_gpu
  use astr_precision, only: real_kind
  implicit none
  private :: real_kind
contains
  attributes(device) real(real_kind) function cubic_uniform_gpu(y1,y2,y3,y4,x1,delta,xx)
    implicit none
    real(real_kind),value :: y1,y2,y3,y4,x1,delta,xx
    real(real_kind) :: a,b,c,varx,inv_delta

    inv_delta=1.e0_real_kind/delta
    a=(y4-3.e0_real_kind*y3+3.e0_real_kind*y2-y1)*inv_delta**3/6.e0_real_kind
    b=((y3-2.e0_real_kind*y2+y1)-6.e0_real_kind*a*delta**3)*inv_delta**2/2.e0_real_kind
    c=(y2-y1-a*delta**3-b*delta**2)*inv_delta
    varx=xx-x1
    cubic_uniform_gpu=((a*varx+b)*varx+c)*varx+y1
  end function cubic_uniform_gpu
end module inflow_interpolation_gpu
