module chemistry_relaxation_gpu
  use iso_fortran_env, only: real64
  use chemistry_air5_data, only: air5_num_species, air5_molar_mass, air5_theta_v, &
    air5_mw_a, air5_mw_b, air5_collision_sigma0, air5_collision_sigma_power, &
    air5_ru, air5_temperature_min_k, air5_temperature_max_k, &
    air5_relaxation_uses_relaxing_species_density
  use chemistry_model, only: chemistry_status_ok, chemistry_status_out_of_domain, &
    chemistry_status_nonfinite
  use chemistry_model_gpu, only: air5_finite_gpu, &
    air5_validate_partial_densities_gpu, air5_pressure_is_in_domain_gpu
  use chemistry_thermo_gpu, only: air5_species_gas_constant_gpu, &
    air5_species_vibrational_energy_gpu, air5_species_vibrational_cv_gpu, &
    air5_pressure_gpu
  implicit none
  private

  real(real64), parameter :: avogadro = 6.02214076e23_real64
  real(real64), parameter :: pressure_atmosphere_pa = 101325.0_real64
  real(real64), parameter :: pi = 3.1415926535897932384626433832795_real64

  public :: air5_vt_relaxation_source_derivatives_gpu

contains

  attributes(device) subroutine air5_vt_relaxation_source_derivatives_gpu( &
      rho_species,temperature,tv,dtemperature,dtv,source,derivatives,status)
    real(real64), intent(in) :: rho_species(air5_num_species), temperature, tv
    real(real64), intent(in) :: dtemperature(6), dtv(6)
    real(real64), intent(out) :: source, derivatives(6)
    integer, intent(out) :: status
    real(real64) :: concentration(air5_num_species), mole_fraction(air5_num_species)
    real(real64) :: concentration_sum, pressure, gas_density, pressure_derivative
    real(real64) :: pair_rate(air5_num_species), park_weight(air5_num_species)
    real(real64) :: mw_weight(air5_num_species), density_derivative(air5_num_species)
    real(real64) :: mw_time, sigma, reduced_mass, mean_speed
    real(real64) :: inverse_time, inverse_derivative, dx
    real(real64) :: equilibrium_energy, current_energy, energy_difference
    real(real64) :: energy_derivative, collision_coefficient, collision_rate, product, denominator
    real(real64) :: dlog_mw, dlog_collision, pair_rate_derivative
    integer :: molecule, partner, variable, local_status

    source = 0.0_real64
    derivatives = 0.0_real64
    call air5_validate_partial_densities_gpu(rho_species,status)
    if (status /= chemistry_status_ok) return
    if (.not.air5_finite_gpu(temperature) .or. .not.air5_finite_gpu(tv)) then
      status = chemistry_status_nonfinite
      return
    end if
    do variable = 1, 6
      if (.not.air5_finite_gpu(dtemperature(variable)) .or. &
          .not.air5_finite_gpu(dtv(variable))) then
        status = chemistry_status_nonfinite
        return
      end if
    end do
    if (temperature < air5_temperature_min_k .or. &
        temperature > air5_temperature_max_k .or. &
        tv < air5_temperature_min_k .or. tv > air5_temperature_max_k) then
      status = chemistry_status_out_of_domain
      return
    end if
    call air5_pressure_gpu(rho_species,temperature,pressure,local_status)
    if (local_status /= chemistry_status_ok) then
      status = local_status
      return
    end if
    if (.not.air5_pressure_is_in_domain_gpu(pressure)) then
      status = chemistry_status_out_of_domain
      return
    end if
    if (.not.air5_relaxation_uses_relaxing_species_density) then
      status = chemistry_status_out_of_domain
      return
    end if

    concentration_sum = 0.0_real64
    gas_density = 0.0_real64
    do partner = 1, air5_num_species
      concentration(partner) = rho_species(partner)/air5_molar_mass(partner)
      concentration_sum = concentration_sum+concentration(partner)
      gas_density = gas_density+rho_species(partner)* &
        air5_species_gas_constant_gpu(partner)
    end do
    do partner = 1, air5_num_species
      mole_fraction(partner) = concentration(partner)/concentration_sum
    end do

    do molecule = 1, air5_num_species
      if (air5_theta_v(molecule) <= 0.0_real64) cycle
      if (rho_species(molecule) <= 0.0_real64) cycle
      do partner = 1, air5_num_species
        mw_time = pressure_atmosphere_pa/pressure*exp(air5_mw_a(molecule,partner)* &
          (temperature**(-1.0_real64/3.0_real64)-air5_mw_b(molecule,partner))-18.42_real64)
        if (.not.air5_finite_gpu(mw_time)) then
          status=chemistry_status_nonfinite
          return
        end if
        if (mw_time<=0.0_real64) then
          status=chemistry_status_out_of_domain
          return
        end if
        park_weight(partner)=0.0_real64
        mw_weight(partner)=1.0_real64
        density_derivative(partner)=0.0_real64
        if (air5_collision_sigma0(molecule,partner)>0.0_real64) then
          sigma=air5_collision_sigma0(molecule,partner)* &
            temperature**air5_collision_sigma_power(molecule,partner)
          reduced_mass=air5_molar_mass(molecule)*air5_molar_mass(partner)/ &
            (air5_molar_mass(molecule)+air5_molar_mass(partner))
          mean_speed=sqrt(8.0_real64*air5_ru*temperature/(pi*reduced_mass))
          ! Form the finite coefficient before multiplying by a trace density.
          collision_coefficient=((avogadro/air5_molar_mass(molecule))*sigma)*mean_speed
          if (.not.air5_finite_gpu(sigma) .or. &
              .not.air5_finite_gpu(mean_speed) .or. &
              .not.air5_finite_gpu(collision_coefficient)) then
            status=chemistry_status_nonfinite
            return
          end if
          collision_rate=collision_coefficient*rho_species(molecule)
          if (.not.air5_finite_gpu(collision_rate)) then
            status=chemistry_status_nonfinite
            return
          end if
          product=mw_time*collision_rate
          if (.not.air5_finite_gpu(product)) then
            status=chemistry_status_nonfinite
            return
          end if
          denominator=1.0_real64+product
          if (.not.air5_finite_gpu(denominator)) then
            status=chemistry_status_nonfinite
            return
          end if
          park_weight(partner)=1.0_real64/denominator
          pair_rate(partner)=collision_rate/denominator
          mw_weight(partner)=product/denominator
          ! Do not form denominator squared or divide by the trace density.
          density_derivative(partner)=(collision_coefficient/denominator)/denominator
        else
          pair_rate(partner)=1.0_real64/mw_time
        end if
        if (.not.air5_finite_gpu(pair_rate(partner)) .or. &
            .not.air5_finite_gpu(density_derivative(partner))) then
          status=chemistry_status_nonfinite
          return
        end if
      end do
      inverse_time=0.0_real64
      do partner=1,air5_num_species
        inverse_time=inverse_time+mole_fraction(partner)*pair_rate(partner)
      end do
      equilibrium_energy = air5_species_vibrational_energy_gpu(molecule,temperature)
      current_energy = air5_species_vibrational_energy_gpu(molecule,tv)
      energy_difference = equilibrium_energy-current_energy
      source = source+rho_species(molecule)*energy_difference*inverse_time

      do variable = 1, 6
        pressure_derivative = gas_density*dtemperature(variable)
        if (variable <= air5_num_species) then
          pressure_derivative = pressure_derivative+ &
            air5_species_gas_constant_gpu(variable)*temperature
        end if
        if (.not.air5_finite_gpu(pressure_derivative)) then
          status=chemistry_status_nonfinite
          return
        end if
        inverse_derivative = 0.0_real64
        do partner = 1, air5_num_species
          dx = 0.0_real64
          if (variable <= air5_num_species) then
            dx = -mole_fraction(partner)/(air5_molar_mass(variable)*concentration_sum)
            if (variable == partner) dx = dx+ &
              1.0_real64/(air5_molar_mass(variable)*concentration_sum)
          end if
          dlog_mw=-pressure_derivative/pressure- &
            (air5_mw_a(molecule,partner)*temperature**(-1.0_real64/3.0_real64)/3.0_real64)* &
            (dtemperature(variable)/temperature)
          dlog_collision=(air5_collision_sigma_power(molecule,partner)+0.5_real64)* &
            (dtemperature(variable)/temperature)
          pair_rate_derivative=pair_rate(partner)*(park_weight(partner)*dlog_collision- &
            mw_weight(partner)*dlog_mw)
          if(variable==molecule) pair_rate_derivative=pair_rate_derivative+density_derivative(partner)
          if (.not.air5_finite_gpu(dlog_mw) .or. .not.air5_finite_gpu(dlog_collision) .or. &
              .not.air5_finite_gpu(pair_rate_derivative)) then
            status=chemistry_status_nonfinite
            return
          end if
          inverse_derivative=inverse_derivative+dx*pair_rate(partner)+ &
            mole_fraction(partner)*pair_rate_derivative
        end do
        energy_derivative = air5_species_vibrational_cv_gpu(molecule,temperature)* &
          dtemperature(variable)-air5_species_vibrational_cv_gpu(molecule,tv)* &
          dtv(variable)
        if (variable == molecule) derivatives(variable) = derivatives(variable)+ &
          energy_difference*inverse_time
        derivatives(variable) = derivatives(variable)+rho_species(molecule)*( &
          energy_derivative*inverse_time+energy_difference*inverse_derivative)
      end do
    end do
    if (.not.air5_finite_gpu(source)) then
      status = chemistry_status_nonfinite
      return
    end if
    do variable = 1, 6
      if (.not.air5_finite_gpu(derivatives(variable))) then
        status = chemistry_status_nonfinite
        return
      end if
    end do
    status = chemistry_status_ok
  end subroutine air5_vt_relaxation_source_derivatives_gpu

end module chemistry_relaxation_gpu
