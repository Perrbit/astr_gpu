module shock_sensor_gpu
  use cudafor
  implicit none
contains
  attributes(global) subroutine raw_shock_sensor_kernel(im,jm,km, &
                                                        apply_left_x,apply_right_x, &
                                                        apply_down_y,apply_up_y)
    use commarray_gpu, only: dvel_d,prs_d,shock_sensor_d
    implicit none
    integer,value :: im,jm,km,apply_left_x,apply_right_x,apply_down_y,apply_up_y
    integer :: i,j,k,ip1,im1,jp1,jm1
    real(8) :: div2,vort,vortx,vorty,vortz,dpdi,dpdj,dpdk

    i = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    j = (blockIdx%y - 1) * blockDim%y + threadIdx%y - 1
    k = (blockIdx%z - 1) * blockDim%z + threadIdx%z - 1
    if(i < 0 .or. i > im .or. j < 0 .or. j > jm .or. k < 0 .or. k > km) return

    div2 = (dvel_d(i,j,k,1,1) + dvel_d(i,j,k,2,2) + dvel_d(i,j,k,3,3))**2
    vortx = dvel_d(i,j,k,3,2) - dvel_d(i,j,k,2,3)
    vorty = dvel_d(i,j,k,1,3) - dvel_d(i,j,k,3,1)
    vortz = dvel_d(i,j,k,2,1) - dvel_d(i,j,k,1,2)
    vort = vortx*vortx + vorty*vorty + vortz*vortz

    ip1 = i + 1
    im1 = i - 1
    jp1 = j + 1
    jm1 = j - 1
    if(apply_left_x /= 0 .and. im1 < 0) im1 = 0
    if(apply_right_x /= 0 .and. ip1 > im) ip1 = im
    if(apply_down_y /= 0 .and. jm1 < 0) jm1 = 0
    if(apply_up_y /= 0 .and. jp1 > jm) jp1 = jm
    dpdi = abs(prs_d(ip1,j,k) - 2.d0*prs_d(i,j,k) + prs_d(im1,j,k)) / &
           (prs_d(ip1,j,k) + 2.d0*prs_d(i,j,k) + prs_d(im1,j,k))
    dpdj = abs(prs_d(i,jp1,k) - 2.d0*prs_d(i,j,k) + prs_d(i,jm1,k)) / &
           (prs_d(i,jp1,k) + 2.d0*prs_d(i,j,k) + prs_d(i,jm1,k))
    dpdk = abs(prs_d(i,j,k+1) - 2.d0*prs_d(i,j,k) + prs_d(i,j,k-1)) / &
           (prs_d(i,j,k+1) + 2.d0*prs_d(i,j,k) + prs_d(i,j,k-1))
    shock_sensor_d(i,j,k,1) = div2/(div2 + vort + 1.d-30) * max(dpdi,dpdj,dpdk)
  end subroutine raw_shock_sensor_kernel

  attributes(global) subroutine shock_sensor_x_periodic_halo_kernel(im,jm,km,hm)
    use commarray_gpu, only: shock_sensor_d
    implicit none
    integer,value :: im,jm,km,hm
    integer :: h,j,k

    h = (blockIdx%x - 1) * blockDim%x + threadIdx%x
    j = blockIdx%y - 1
    k = blockIdx%z - 1
    if(h < 1 .or. h > hm .or. j < 0 .or. j > jm .or. k < 0 .or. k > km) return
    shock_sensor_d(-h,j,k,1) = shock_sensor_d(im-h,j,k,1)
    shock_sensor_d(im+h,j,k,1) = shock_sensor_d(h,j,k,1)
  end subroutine shock_sensor_x_periodic_halo_kernel

  attributes(global) subroutine shock_sensor_y_periodic_halo_kernel(im,jm,km,hm)
    use commarray_gpu, only: shock_sensor_d
    implicit none
    integer,value :: im,jm,km,hm
    integer :: i,h,k

    i = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    h = (blockIdx%y - 1) * blockDim%y + threadIdx%y
    k = blockIdx%z - 1
    if(i < 0 .or. i > im .or. h < 1 .or. h > hm .or. k < 0 .or. k > km) return
    shock_sensor_d(i,-h,k,1) = shock_sensor_d(i,jm-h,k,1)
    shock_sensor_d(i,jm+h,k,1) = shock_sensor_d(i,h,k,1)
  end subroutine shock_sensor_y_periodic_halo_kernel

  attributes(global) subroutine shock_sensor_z_periodic_halo_kernel(im,jm,km,hm)
    use commarray_gpu, only: shock_sensor_d
    implicit none
    integer,value :: im,jm,km,hm
    integer :: i,j,h

    i = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    j = blockIdx%y - 1
    h = (blockIdx%z - 1) * blockDim%z + threadIdx%z
    if(i < 0 .or. i > im .or. j < 0 .or. j > jm .or. h < 1 .or. h > hm) return
    shock_sensor_d(i,j,-h,1) = shock_sensor_d(i,j,km-h,1)
    shock_sensor_d(i,j,km+h,1) = shock_sensor_d(i,j,h,1)
  end subroutine shock_sensor_z_periodic_halo_kernel

  attributes(global) subroutine expand_shock_sensor_kernel(im,jm,km,hm,threshold, &
                                                            apply_left_x,apply_right_x, &
                                                            apply_down_y,apply_up_y)
    use commarray_gpu, only: shock_sensor_d,shock_mask_d
    implicit none
    integer,value :: im,jm,km,hm,apply_left_x,apply_right_x,apply_down_y,apply_up_y
    real(8),value :: threshold
    integer :: i,j,k,offset,ii,jj
    real(8) :: local_maximum

    i = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    j = (blockIdx%y - 1) * blockDim%y + threadIdx%y - 1
    k = (blockIdx%z - 1) * blockDim%z + threadIdx%z - 1
    if(i < 0 .or. i > im .or. j < 0 .or. j > jm .or. k < 0 .or. k > km) return

    local_maximum = 0.d0
    do offset=-hm+1,hm
      ii = i + offset
      if(apply_left_x /= 0 .and. ii < 0) ii = 0
      if(apply_right_x /= 0 .and. ii > im) ii = im
      jj = j + offset
      if(apply_down_y /= 0 .and. jj < 0) jj = 0
      if(apply_up_y /= 0 .and. jj > jm) jj = jm
      local_maximum = max(local_maximum,shock_sensor_d(ii,j,k,1))
      local_maximum = max(local_maximum,shock_sensor_d(i,jj,k,1))
      local_maximum = max(local_maximum,shock_sensor_d(i,j,k+offset,1))
    enddo
    if(local_maximum > threshold) then
      shock_mask_d(i,j,k) = 1_1
    else
      shock_mask_d(i,j,k) = 0_1
    endif
  end subroutine expand_shock_sensor_kernel

  subroutine dump_shock_sensor_gpu_validation()
    use commvar, only: im,jm,km
    use commarray_gpu, only: shock_sensor_d,shock_mask_d
    use parallel, only: lio,mpirank,mpisize,ig0,jg0,kg0
    implicit none
    logical,save :: dumped=.false.
    character(len=1024) :: dump_path,output_path
    character(len=32) :: rank_suffix
    integer :: status,path_length,fh,i,j,k
    real(8),allocatable :: sensor_host(:,:,:)
    integer(1),allocatable :: mask_host(:,:,:)

    if(dumped) return
    call get_environment_variable('ASTR_SHOCK_SENSOR_DUMP',dump_path, &
                                  length=path_length,status=status)
    if(status /= 0 .or. path_length <= 0) return

    allocate(sensor_host(0:im,0:jm,0:km),mask_host(0:im,0:jm,0:km))
    sensor_host = shock_sensor_d(0:im,0:jm,0:km,1)
    mask_host = shock_mask_d
    output_path=trim(dump_path(1:path_length))
    if(mpisize>1) then
      write(rank_suffix,'(".rank",I0)') mpirank
      output_path=trim(output_path)//trim(rank_suffix)
    endif
    open(newunit=fh,file=trim(output_path),status='replace',action='write')
    write(fh,'(A,6(1X,I0))') '# shock_sensor',im,jm,km,ig0,jg0,kg0
    do k=0,km
    do j=0,jm
    do i=0,im
      write(fh,'(3(I0,1X),ES24.16E3,1X,I1)') i,j,k,sensor_host(i,j,k), &
           merge(1,0,mask_host(i,j,k) /= 0_1)
    enddo
    enddo
    enddo
    close(fh)
    if(lio) print *,'GPU shock sensor min/max/avg/nodes=',minval(sensor_host),maxval(sensor_host), &
         sum(sensor_host)/real(size(sensor_host),8),count(mask_host /= 0_1)
    deallocate(sensor_host,mask_host)
    dumped=.true.
  end subroutine dump_shock_sensor_gpu_validation

  subroutine compute_shock_sensor_gpu()
    use commvar, only: im,jm,km,hm,shkcrt,lchardecomp,npdci,npdcj
    use commcal, only: shock_sensor_validation_enabled
    use gradcal_gpu, only: compute_gradcal_gpu
    use gpu_check, only: sync_after_kernel
    use halo_exchange_gpu, only: exchange_field_halo_gpu
    use commarray_gpu, only: shock_sensor_d
    use boundary_gpu, only: gpu_axis_is_physical
    use parallel, only: isize,jsize,ksize
    implicit none
    type(dim3) :: block3,grid3,block_x,grid_x,block_y,grid_y,block_z,grid_z
    integer :: apply_left_x,apply_right_x,apply_down_y,apply_up_y

    if((.not.shock_sensor_validation_enabled()) .and. (.not.lchardecomp)) return
    call compute_gradcal_gpu()
    apply_left_x = merge(1,0,npdci == 1 .or. npdci == 4)
    apply_right_x = merge(1,0,npdci == 2 .or. npdci == 4)
    apply_down_y = merge(1,0,npdcj == 1)
    apply_up_y = merge(1,0,npdcj == 2)

    block3 = dim3(8,8,8)
    grid3 = dim3((im + block3%x)/block3%x, &
                 (jm + block3%y)/block3%y, &
                 (km + block3%z)/block3%z)
    call raw_shock_sensor_kernel<<<grid3,block3>>>(im,jm,km, &
                                                    apply_left_x,apply_right_x, &
                                                    apply_down_y,apply_up_y)
    call sync_after_kernel('raw_shock_sensor_kernel')

    if(isize==1 .and. jsize==1 .and. ksize==1) then
      if(.not.gpu_axis_is_physical(1)) then
        block_x = dim3(512,1,1)
        grid_x = dim3((hm + block_x%x - 1)/block_x%x,jm+1,km+1)
        call shock_sensor_x_periodic_halo_kernel<<<grid_x,block_x>>>(im,jm,km,hm)
        call sync_after_kernel('shock_sensor_x_periodic_halo_kernel')
      endif

      if(.not.gpu_axis_is_physical(2)) then
        block_y = dim3(32,16,1)
        grid_y = dim3((im + block_y%x)/block_y%x, &
                      (hm + block_y%y - 1)/block_y%y,km+1)
        call shock_sensor_y_periodic_halo_kernel<<<grid_y,block_y>>>(im,jm,km,hm)
        call sync_after_kernel('shock_sensor_y_periodic_halo_kernel')
      endif

      if(.not.gpu_axis_is_physical(3)) then
        block_z = dim3(64,1,8)
        grid_z = dim3((im + block_z%x)/block_z%x,jm+1, &
                      (hm + block_z%z - 1)/block_z%z)
        call shock_sensor_z_periodic_halo_kernel<<<grid_z,block_z>>>(im,jm,km,hm)
        call sync_after_kernel('shock_sensor_z_periodic_halo_kernel')
      endif
    else
      call exchange_field_halo_gpu(shock_sensor_d,1)
    endif

    call expand_shock_sensor_kernel<<<grid3,block3>>>(im,jm,km,hm,shkcrt, &
                                                        apply_left_x,apply_right_x, &
                                                        apply_down_y,apply_up_y)
    call sync_after_kernel('expand_shock_sensor_kernel')
    call dump_shock_sensor_gpu_validation()
  end subroutine compute_shock_sensor_gpu
end module shock_sensor_gpu
