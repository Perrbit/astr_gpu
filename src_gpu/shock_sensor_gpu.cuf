module shock_sensor_gpu
  use astr_precision, only: real_kind
  use cudafor
  implicit none
  private :: real_kind
  integer(1),allocatable,device,private :: mask_send_d(:,:),mask_recv_d(:,:)
  integer(1),allocatable,pinned,private :: mask_send_h(:,:),mask_recv_h(:,:)
  real(real_kind),allocatable,device,private :: snapshot_sensor_d(:)
  integer(1),allocatable,device,private :: snapshot_mask_d(:)
contains
  attributes(global) subroutine pack_shock_snapshot_kernel(im,jm,km,n)
    use commarray_gpu, only: shock_sensor_d,shock_mask_d
    integer,value :: im,jm,km,n
    integer :: id,i,j,k
    id=(blockIdx%x-1)*blockDim%x+threadIdx%x
    if(id>n) return
    i=mod(id-1,im+1); j=mod((id-1)/(im+1),jm+1); k=(id-1)/((im+1)*(jm+1))
    snapshot_sensor_d(id)=shock_sensor_d(i,j,k,1)
    snapshot_mask_d(id)=shock_mask_d(i,j,k)
  end subroutine

  subroutine read_shock_physical_snapshot_gpu(sensor,mask)
    use commvar, only: im,jm,km
    use gpu_check, only: sync_after_kernel
    real(real_kind),intent(out) :: sensor(0:im,0:jm,0:km)
    integer(1),intent(out) :: mask(0:im,0:jm,0:km)
    integer :: n,status
    n=(im+1)*(jm+1)*(km+1)
    if(.not.allocated(snapshot_sensor_d)) allocate(snapshot_sensor_d(n),snapshot_mask_d(n))
    ! NVHPC slicing can copy the full parent, including unused halo corners.
    call pack_shock_snapshot_kernel<<<(n+255)/256,256>>>(im,jm,km,n)
    call sync_after_kernel('pack_shock_snapshot')
    status=cudaMemcpy(sensor(0,0,0),snapshot_sensor_d(1),n,cudaMemcpyDeviceToHost)
    if(status/=cudaSuccess) error stop 'Shock sensor physical snapshot copy failed'
    status=cudaMemcpy(mask(0,0,0),snapshot_mask_d(1),n,cudaMemcpyDeviceToHost)
    if(status/=cudaSuccess) error stop 'Shock mask physical snapshot copy failed'
  end subroutine

  attributes(global) subroutine shock_mask_face_kernel(im,jm,km,n,axis,ntype,unpack)
    use commarray_gpu, only: shock_mask_d
    integer,value :: im,jm,km,n,axis,ntype,unpack
    integer :: id,i,j,k,lo(3),hi(3),a(3),b(3),dims(3)
    id=(blockIdx%x-1)*blockDim%x+threadIdx%x
    if(id>n) return
    select case(axis)
    case(1)
      i=0; j=mod(id-1,jm+1); k=(id-1)/(jm+1)
    case(2)
      i=mod(id-1,im+1); j=0; k=(id-1)/(im+1)
    case(3)
      i=mod(id-1,im+1); j=(id-1)/(im+1); k=0
    end select
    dims=[im,jm,km]
    lo=[i,j,k]; hi=lo
    hi(axis)=dims(axis)
    if(unpack==0) then
      a=lo; b=hi; a(axis)=1; b(axis)=hi(axis)-1
      mask_send_d(id,1)=shock_mask_d(a(1),a(2),a(3))
      mask_send_d(id,2)=shock_mask_d(b(1),b(2),b(3))
    else
      a=lo; b=hi; a(axis)=-1; b(axis)=hi(axis)+1
      shock_mask_d(a(1),a(2),a(3))=shock_mask_d(lo(1),lo(2),lo(3))
      shock_mask_d(b(1),b(2),b(3))=shock_mask_d(hi(1),hi(2),hi(3))
      if(ntype==2.or.ntype==3) shock_mask_d(a(1),a(2),a(3))=mask_recv_d(id,1)
      if(ntype==1.or.ntype==3) shock_mask_d(b(1),b(2),b(3))=mask_recv_d(id,2)
    endif
  end subroutine

  subroutine refresh_expanded_shock_mask_gpu()
    use commvar, only: im,jm,km,npdci,npdcj,npdck
    use parallel, only: exchange_shock_mask_faces
    use gpu_check, only: sync_after_kernel
    integer :: n,axis,ntype,side,status,counts(3),types(3)
    logical :: pinned_ok
    counts=[(jm+1)*(km+1),(im+1)*(km+1),(im+1)*(jm+1)]
    types=[npdci,npdcj,npdck]
    if(.not.allocated(mask_send_d)) then
      n=maxval(counts)
      allocate(mask_send_d(n,2),mask_recv_d(n,2))
      allocate(mask_send_h(n,2),pinned=pinned_ok)
      if(.not.pinned_ok) error stop 'Expanded shock-mask send buffer is not pinned'
      allocate(mask_recv_h(n,2),pinned=pinned_ok)
      if(.not.pinned_ok) error stop 'Expanded shock-mask receive buffer is not pinned'
    endif
    do axis=1,3
      n=counts(axis); ntype=types(axis)
      call shock_mask_face_kernel<<<(n+255)/256,256>>>(im,jm,km,n,axis,ntype,0)
      call sync_after_kernel('pack_expanded_shock_mask')
      do side=1,2
        status=cudaMemcpy(mask_send_h(1,side),mask_send_d(1,side),n,cudaMemcpyDeviceToHost)
        if(status/=cudaSuccess) error stop 'Expanded shock-mask download failed'
      enddo
      call exchange_shock_mask_faces(mask_send_h(:n,:),mask_recv_h(:n,:),n,axis)
      do side=1,2
        status=cudaMemcpy(mask_recv_d(1,side),mask_recv_h(1,side),n,cudaMemcpyHostToDevice)
        if(status/=cudaSuccess) error stop 'Expanded shock-mask upload failed'
      enddo
      call shock_mask_face_kernel<<<(n+255)/256,256>>>(im,jm,km,n,axis,ntype,1)
      call sync_after_kernel('unpack_expanded_shock_mask')
    enddo
  end subroutine

  subroutine release_shock_mask_buffers_gpu()
    if(allocated(mask_send_d)) deallocate(mask_send_d,mask_recv_d,mask_send_h,mask_recv_h)
    if(allocated(snapshot_sensor_d)) deallocate(snapshot_sensor_d,snapshot_mask_d)
  end subroutine

  attributes(global) subroutine raw_shock_sensor_kernel(im,jm,km, &
                                                        apply_left_x,apply_right_x, &
                                                        apply_down_y,apply_up_y, &
                                                        apply_back_z,apply_front_z)
    use commarray_gpu, only: dvel_d,prs_d,shock_sensor_d
    implicit none
    integer,value :: im,jm,km,apply_left_x,apply_right_x,apply_down_y,apply_up_y, &
                     apply_back_z,apply_front_z
    integer :: i,j,k,ip1,im1,jp1,jm1,kp1,km1
    real(real_kind) :: div2,vort,vortx,vorty,vortz,dpdi,dpdj,dpdk

    i = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    j = (blockIdx%y - 1) * blockDim%y + threadIdx%y - 1
    k = (blockIdx%z - 1) * blockDim%z + threadIdx%z - 1
    if(i < 0 .or. i > im .or. j < 0 .or. j > jm .or. k < 0 .or. k > km) return

    div2 = (dvel_d(i,j,k,1,1) + dvel_d(i,j,k,2,2) + dvel_d(i,j,k,3,3))**2
    vortx = dvel_d(i,j,k,3,2) - dvel_d(i,j,k,2,3)
    vorty = dvel_d(i,j,k,1,3) - dvel_d(i,j,k,3,1)
    vortz = dvel_d(i,j,k,2,1) - dvel_d(i,j,k,1,2)
    vort = vortx*vortx + vorty*vorty + vortz*vortz

    ip1 = i + 1
    im1 = i - 1
    jp1 = j + 1
    jm1 = j - 1
    kp1 = k + 1
    km1 = k - 1
    if(apply_left_x /= 0 .and. im1 < 0) im1 = 0
    if(apply_right_x /= 0 .and. ip1 > im) ip1 = im
    if(apply_down_y /= 0 .and. jm1 < 0) jm1 = 0
    if(apply_up_y /= 0 .and. jp1 > jm) jp1 = jm
    if(apply_back_z /= 0 .and. km1 < 0) km1 = 0
    if(apply_front_z /= 0 .and. kp1 > km) kp1 = km
    dpdi = abs(prs_d(ip1,j,k) - 2.e0_real_kind*prs_d(i,j,k) + prs_d(im1,j,k)) / &
           (prs_d(ip1,j,k) + 2.e0_real_kind*prs_d(i,j,k) + prs_d(im1,j,k))
    dpdj = abs(prs_d(i,jp1,k) - 2.e0_real_kind*prs_d(i,j,k) + prs_d(i,jm1,k)) / &
           (prs_d(i,jp1,k) + 2.e0_real_kind*prs_d(i,j,k) + prs_d(i,jm1,k))
    dpdk = abs(prs_d(i,j,kp1) - 2.e0_real_kind*prs_d(i,j,k) + prs_d(i,j,km1)) / &
           (prs_d(i,j,kp1) + 2.e0_real_kind*prs_d(i,j,k) + prs_d(i,j,km1))
    shock_sensor_d(i,j,k,1) = div2/(div2 + vort + 1.e-30_real_kind) * max(dpdi,dpdj,dpdk)
  end subroutine raw_shock_sensor_kernel

  attributes(global) subroutine shock_sensor_x_periodic_halo_kernel(im,jm,km,hm)
    use commarray_gpu, only: shock_sensor_d
    implicit none
    integer,value :: im,jm,km,hm
    integer :: h,j,k

    h = (blockIdx%x - 1) * blockDim%x + threadIdx%x
    j = blockIdx%y - 1
    k = blockIdx%z - 1
    if(h < 1 .or. h > hm .or. j < 0 .or. j > jm .or. k < 0 .or. k > km) return
    shock_sensor_d(-h,j,k,1) = shock_sensor_d(im-h,j,k,1)
    shock_sensor_d(im+h,j,k,1) = shock_sensor_d(h,j,k,1)
  end subroutine shock_sensor_x_periodic_halo_kernel

  attributes(global) subroutine shock_sensor_y_periodic_halo_kernel(im,jm,km,hm)
    use commarray_gpu, only: shock_sensor_d
    implicit none
    integer,value :: im,jm,km,hm
    integer :: i,h,k

    i = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    h = (blockIdx%y - 1) * blockDim%y + threadIdx%y
    k = blockIdx%z - 1
    if(i < 0 .or. i > im .or. h < 1 .or. h > hm .or. k < 0 .or. k > km) return
    shock_sensor_d(i,-h,k,1) = shock_sensor_d(i,jm-h,k,1)
    shock_sensor_d(i,jm+h,k,1) = shock_sensor_d(i,h,k,1)
  end subroutine shock_sensor_y_periodic_halo_kernel

  attributes(global) subroutine shock_sensor_z_periodic_halo_kernel(im,jm,km,hm)
    use commarray_gpu, only: shock_sensor_d
    implicit none
    integer,value :: im,jm,km,hm
    integer :: i,j,h

    i = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    j = blockIdx%y - 1
    h = (blockIdx%z - 1) * blockDim%z + threadIdx%z
    if(i < 0 .or. i > im .or. j < 0 .or. j > jm .or. h < 1 .or. h > hm) return
    shock_sensor_d(i,j,-h,1) = shock_sensor_d(i,j,km-h,1)
    shock_sensor_d(i,j,km+h,1) = shock_sensor_d(i,j,h,1)
  end subroutine shock_sensor_z_periodic_halo_kernel

  attributes(global) subroutine expand_shock_sensor_kernel(im,jm,km,hm,threshold, &
                                                            apply_left_x,apply_right_x, &
                                                            apply_down_y,apply_up_y, &
                                                            apply_back_z,apply_front_z)
    use commarray_gpu, only: shock_sensor_d,shock_mask_d
    implicit none
    integer,value :: im,jm,km,hm,apply_left_x,apply_right_x,apply_down_y,apply_up_y, &
                     apply_back_z,apply_front_z
    real(real_kind),value :: threshold
    integer :: i,j,k,offset,ii,jj,kk
    real(real_kind) :: local_maximum

    i = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    j = (blockIdx%y - 1) * blockDim%y + threadIdx%y - 1
    k = (blockIdx%z - 1) * blockDim%z + threadIdx%z - 1
    if(i < 0 .or. i > im .or. j < 0 .or. j > jm .or. k < 0 .or. k > km) return

    local_maximum = 0.e0_real_kind
    do offset=-hm+1,hm
      ii = i + offset
      if(apply_left_x /= 0 .and. ii < 0) ii = 0
      if(apply_right_x /= 0 .and. ii > im) ii = im
      jj = j + offset
      if(apply_down_y /= 0 .and. jj < 0) jj = 0
      if(apply_up_y /= 0 .and. jj > jm) jj = jm
      kk = k + offset
      if(apply_back_z /= 0 .and. kk < 0) kk = 0
      if(apply_front_z /= 0 .and. kk > km) kk = km
      local_maximum = max(local_maximum,shock_sensor_d(ii,j,k,1))
      local_maximum = max(local_maximum,shock_sensor_d(i,jj,k,1))
      local_maximum = max(local_maximum,shock_sensor_d(i,j,kk,1))
    enddo
    if(local_maximum > threshold) then
      shock_mask_d(i,j,k) = 1_1
    else
      shock_mask_d(i,j,k) = 0_1
    endif
  end subroutine expand_shock_sensor_kernel

  subroutine dump_shock_sensor_gpu_validation()
    use commvar, only: im,jm,km
    use commarray_gpu, only: shock_sensor_d,shock_mask_d
    use gpu_check, only: sync_gpu_boundary
    use parallel, only: lio,mpirank,mpisize,ig0,jg0,kg0
    implicit none
    logical,save :: dumped=.false.
    character(len=1024) :: dump_path,output_path
    character(len=32) :: rank_suffix
    integer :: status,path_length,fh,i,j,k
    real(real_kind),allocatable :: sensor_host(:,:,:)
    integer(1),allocatable :: mask_host(:,:,:)

    if(dumped) return
    call get_environment_variable('ASTR_SHOCK_SENSOR_DUMP',dump_path, &
                                  length=path_length,status=status)
    if(status /= 0 .or. path_length <= 0) return

    call sync_gpu_boundary('write_shock_sensor_dump')
    allocate(sensor_host(0:im,0:jm,0:km),mask_host(0:im,0:jm,0:km))
    call read_shock_physical_snapshot_gpu(sensor_host,mask_host)
    output_path=trim(dump_path(1:path_length))
    if(mpisize>1) then
      write(rank_suffix,'(".rank",I0)') mpirank
      output_path=trim(output_path)//trim(rank_suffix)
    endif
    open(newunit=fh,file=trim(output_path),status='replace',action='write')
    write(fh,'(A,6(1X,I0))') '# shock_sensor',im,jm,km,ig0,jg0,kg0
    do k=0,km
    do j=0,jm
    do i=0,im
      write(fh,'(3(I0,1X),ES24.16E3,1X,I1)') i,j,k,sensor_host(i,j,k), &
           merge(1,0,mask_host(i,j,k) /= 0_1)
    enddo
    enddo
    enddo
    close(fh)
    if(lio) print *,'GPU shock sensor min/max/avg/nodes=',minval(sensor_host),maxval(sensor_host), &
         sum(sensor_host)/real(size(sensor_host),real_kind),count(mask_host /= 0_1)
    deallocate(sensor_host,mask_host)
    dumped=.true.
  end subroutine dump_shock_sensor_gpu_validation

  subroutine compute_shock_sensor_gpu(stage_index,force_active)
    use commvar, only: im,jm,km,hm,shkcrt,lchardecomp,npdci,npdcj,npdck,nstep
    use commcal, only: shock_sensor_validation_enabled,compact_expanded_mask_enabled
    use gradcal_gpu, only: compute_gradcal_gpu
    use gpu_check, only: sync_after_kernel
    use halo_exchange_gpu, only: exchange_field_halo_gpu
    use commarray_gpu, only: shock_sensor_d,shock_mask_d,dvel_d,prs_d,expanded_shock_halo_d
    use boundary_gpu, only: gpu_axis_is_physical
    use parallel, only: isize,jsize,ksize
    use validation_io, only: rhs_validation_requested,write_sensor_validation_snapshot, &
      sensor_detail_requested,write_sensor_detail_validation_snapshot
    implicit none
    integer,intent(in),optional :: stage_index
    logical,intent(in),optional :: force_active
    type(dim3) :: block3,grid3,block_x,grid_x,block_y,grid_y,block_z,grid_z
    integer :: apply_left_x,apply_right_x,apply_down_y,apply_up_y,apply_back_z,apply_front_z
    real(real_kind),allocatable :: sensor_host(:,:,:)
    real(real_kind),allocatable :: gradient_host(:,:,:,:,:),pressure_host(:,:,:)
    integer(1),allocatable :: mask_host(:,:,:)
    logical :: active

    active=shock_sensor_validation_enabled() .or. lchardecomp
    if(present(force_active)) active=active .or. force_active
    if(.not.active) return
    call compute_gradcal_gpu()
    apply_left_x = merge(1,0,npdci == 1 .or. npdci == 4)
    apply_right_x = merge(1,0,npdci == 2 .or. npdci == 4)
    apply_down_y = merge(1,0,npdcj == 1 .or. npdcj == 4)
    apply_up_y = merge(1,0,npdcj == 2 .or. npdcj == 4)
    apply_back_z = merge(1,0,npdck == 1 .or. npdck == 4)
    apply_front_z = merge(1,0,npdck == 2 .or. npdck == 4)

    block3 = dim3(8,8,8)
    grid3 = dim3((im + block3%x)/block3%x, &
                 (jm + block3%y)/block3%y, &
                 (km + block3%z)/block3%z)
    call raw_shock_sensor_kernel<<<grid3,block3>>>(im,jm,km, &
                                                    apply_left_x,apply_right_x, &
                                                    apply_down_y,apply_up_y, &
                                                    apply_back_z,apply_front_z)
    call sync_after_kernel('raw_shock_sensor_kernel')

    if(isize==1 .and. jsize==1 .and. ksize==1) then
      if(.not.gpu_axis_is_physical(1)) then
        block_x = dim3(512,1,1)
        grid_x = dim3((hm + block_x%x - 1)/block_x%x,jm+1,km+1)
        call shock_sensor_x_periodic_halo_kernel<<<grid_x,block_x>>>(im,jm,km,hm)
        call sync_after_kernel('shock_sensor_x_periodic_halo_kernel')
      endif

      if(.not.gpu_axis_is_physical(2)) then
        block_y = dim3(32,16,1)
        grid_y = dim3((im + block_y%x)/block_y%x, &
                      (hm + block_y%y - 1)/block_y%y,km+1)
        call shock_sensor_y_periodic_halo_kernel<<<grid_y,block_y>>>(im,jm,km,hm)
        call sync_after_kernel('shock_sensor_y_periodic_halo_kernel')
      endif

      if(.not.gpu_axis_is_physical(3)) then
        block_z = dim3(64,1,8)
        grid_z = dim3((im + block_z%x)/block_z%x,jm+1, &
                      (hm + block_z%z - 1)/block_z%z)
        call shock_sensor_z_periodic_halo_kernel<<<grid_z,block_z>>>(im,jm,km,hm)
        call sync_after_kernel('shock_sensor_z_periodic_halo_kernel')
      endif
    else
      call exchange_field_halo_gpu(shock_sensor_d,1)
    endif

    call expand_shock_sensor_kernel<<<grid3,block3>>>(im,jm,km,hm,shkcrt, &
                                                        apply_left_x,apply_right_x, &
                                                        apply_down_y,apply_up_y, &
                                                        apply_back_z,apply_front_z)
    call sync_after_kernel('expand_shock_sensor_kernel')
    expanded_shock_halo_d=compact_expanded_mask_enabled()
    if(compact_expanded_mask_enabled()) call refresh_expanded_shock_mask_gpu()
    if(rhs_validation_requested()) then
      allocate(sensor_host(0:im,0:jm,0:km),mask_host(0:im,0:jm,0:km))
      call read_shock_physical_snapshot_gpu(sensor_host,mask_host)
      call write_sensor_validation_snapshot('sensor',sensor_host,mask_host,nstep,stage_index)
      deallocate(sensor_host,mask_host)
    endif
    if(sensor_detail_requested(stage_index)) then
      allocate(gradient_host(0:im,0:jm,0:km,3,3),pressure_host(-hm:im+hm,-hm:jm+hm,-hm:km+hm))
      gradient_host=dvel_d
      pressure_host=prs_d
      call write_sensor_detail_validation_snapshot(gradient_host,pressure_host,stage_index)
      deallocate(gradient_host,pressure_host)
    endif
    call dump_shock_sensor_gpu_validation()
  end subroutine compute_shock_sensor_gpu
end module shock_sensor_gpu
