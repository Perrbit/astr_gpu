module insitu_statistics_gpu
  use astr_precision, only: real_kind,real_bytes,clock_kind,real_to_word,word_to_real
  use astr_precision_mpi, only: mpi_real_type
  use cudafor
  use insitu_time_integral, only: clipped_trapezoid
  use iso_fortran_env, only: int32,int64
  use ieee_arithmetic, only: ieee_is_finite
  use insitu_resource_budget, only: resource_budget,configure_budget,reserve_bytes,checked_bytes
  use iso_c_binding, only: c_int,c_char,c_size_t
  use insitu_fields, only: insitu_owned_counts,insitu_node_weights,insitu_volume_weights
  implicit none
  private :: real_kind,real_bytes,clock_kind,real_to_word,word_to_real,mpi_real_type
  private
  public :: accumulate_statistics_gpu,release_statistics_gpu
  public :: write_statistics_gpu_state,restore_statistics_gpu_state
  public :: pack_statistics_gpu_state,unpack_statistics_gpu_state
  public :: configure_statistics_device_budget
  public :: spatial_statistics_gpu
  public :: statistics_transfer_counts
  public :: download_statistics_gpu_means
  public :: sample_statistics_gpu_mean_vectors
  public :: slice_statistics_gpu_info,slice_statistics_gpu_value
#ifdef ASTR_BUILD_TESTING
  public :: check_device_statistics_gpu_means
  public :: begin_preview_statistics_check,end_preview_statistics_check
  real(real_kind),allocatable,device,save :: preview_state_d(:,:,:,:)
  real(real_kind),save :: preview_previous_time=0.e0_real_kind,preview_window(2)=0.e0_real_kind
  logical,save :: preview_has_previous=.false.,preview_had_state=.false.
  integer(int64),save :: preview_samples=0,preview_downloads=0
#endif
  public :: download_statistics_gpu_output
  public :: statistics_device_bytes
  public :: admit_statistics_device_allocation
  integer(int64),save :: sample_calls=0,output_downloads=0
  integer(int64),save :: device_budget=0,device_headroom=0
  interface
    integer(c_int) function pci_bus_id(name,length,device) bind(C,name='cudaDeviceGetPCIBusId')
      import c_char,c_int
      character(c_char),intent(out) :: name(*)
      integer(c_int),value :: length,device
    end function
  end interface
  ! State: previous rho/u, time/mass weights, two means, two symmetric central matrices.
  ! Owned nodes include a nonperiodic upper wall; solver halos/duplicates are untouched.
  real(real_kind),allocatable,device,save :: state_d(:,:,:,:),output_d(:,:,:,:)
  real(real_kind),allocatable,device,save :: spatial_d(:)
  real(real_kind),allocatable,device,save :: node_weight_d(:)
  real(real_kind),allocatable,device,save :: curve_weight_d(:,:,:)
  real(real_kind),save :: curve_local_volume=0.e0_real_kind
  integer,allocatable,device,save :: invalid_d(:)
  real(real_kind),save :: previous_time=0.e0_real_kind,saved_window(2)=0.e0_real_kind
  logical,save :: has_previous=.false.
contains
  subroutine slice_statistics_gpu_info(active,covered,window,duration)
    logical,intent(out) :: active,covered
    real(real_kind),intent(out) :: window(2),duration
    active=has_previous;covered=allocated(state_d);window=saved_window;duration=0
    if(covered) duration=state_d(0,0,0,5)
    covered=covered.and.duration>0
  end subroutine

  attributes(device) function slice_statistics_gpu_value(i,j,k,field,favre) result(value)
    integer,value :: i,j,k,field
    logical,value :: favre
    real(real_kind) :: value
    if(field==1) then
      value=state_d(i,j,k,6)/state_d(i,j,k,5)
    else
      value=state_d(i,j,k,field+5+merge(3,0,favre))
    endif
  end function

#ifdef ASTR_BUILD_TESTING
  subroutine begin_preview_statistics_check()
    integer :: status
    preview_previous_time=previous_time;preview_window=saved_window;preview_has_previous=has_previous
    preview_samples=sample_calls;preview_downloads=output_downloads
    preview_had_state=allocated(state_d)
    if(preview_had_state) then
      allocate(preview_state_d(size(state_d,1),size(state_d,2),size(state_d,3),size(state_d,4)),stat=status)
      call require_cuda(merge(cudaSuccess,cudaErrorMemoryAllocation,status==0),'preview statistics snapshot allocation')
      preview_state_d=state_d
      call require_cuda(cudaDeviceSynchronize(),'preview statistics snapshot')
    endif
  end subroutine

  attributes(global) subroutine compare_preview_statistics(n1,n2,n3,n4,current,saved,bad)
    integer,value :: n1,n2,n3,n4
    real(real_kind),device,intent(in) :: current(n1,n2,n3,n4),saved(n1,n2,n3,n4)
    integer,device :: bad(*)
    integer :: n,i,j,k,c,old
    n=(blockidx%x-1)*blockdim%x+threadidx%x-1
    if(n>=n1*n2*n3) return
    i=mod(n,n1)+1;j=mod(n/n1,n2)+1;k=n/(n1*n2)+1
    do c=1,n4
      if(current(i,j,k,c)/=saved(i,j,k,c)) then
        old=atomicadd(bad(1),1)
        return
      endif
    enddo
  end subroutine

  subroutine end_preview_statistics_check(mismatches)
    integer,intent(out) :: mismatches
    integer,device :: bad(1)
    integer :: n
    mismatches=0
    if(previous_time/=preview_previous_time.or.any(saved_window/=preview_window).or. &
      (has_previous.neqv.preview_has_previous).or.sample_calls/=preview_samples.or. &
      output_downloads/=preview_downloads.or.(allocated(state_d).neqv.preview_had_state)) mismatches=1
    if(preview_had_state.and.allocated(state_d)) then
      if(any(shape(state_d)/=shape(preview_state_d))) then
        mismatches=mismatches+1
      else
        bad=0;n=size(state_d,1)*size(state_d,2)*size(state_d,3)
        call compare_preview_statistics<<<(n+255)/256,256>>>(size(state_d,1),size(state_d,2), &
          size(state_d,3),size(state_d,4),state_d,preview_state_d,bad)
        call require_cuda(cudaDeviceSynchronize(),'preview statistics comparison')
        mismatches=mismatches+bad(1)
      endif
      deallocate(preview_state_d)
    endif
  end subroutine
#endif
  integer function owned_ny() result(ny)
    integer :: extent(3)
    extent=insitu_owned_counts()
    ny=extent(2)
  end function

  subroutine initialize_node_weights()
    use commvar, only: im,jm,km,flowtype,lreadgrid
    real(real_kind) :: weights(0:jm)
    real(real_kind),allocatable :: physical(:,:,:)
    integer :: status
    weights=1.e0_real_kind
    if(.not.lreadgrid) then
      call insitu_node_weights(weights)
      if(trim(flowtype)/='channel') weights=1.e0_real_kind
    endif
    allocate(node_weight_d(0:owned_ny()-1),stat=status)
    call require_cuda(merge(cudaSuccess,cudaErrorMemoryAllocation,status==0),'statistics node weights allocation')
    node_weight_d=weights(0:owned_ny()-1)
    call require_cuda(cudaGetLastError(),'statistics node weights copy')
    if(lreadgrid) then
      allocate(physical(0:im,0:jm,0:km),stat=status)
      call require_cuda(merge(cudaSuccess,cudaErrorMemoryAllocation,status==0),'CURVE host weights allocation')
      call insitu_volume_weights(physical)
      curve_local_volume=sum(physical)
      allocate(curve_weight_d(0:im-1,0:owned_ny()-1,0:km-1),stat=status)
      call require_cuda(merge(cudaSuccess,cudaErrorMemoryAllocation,status==0),'CURVE device weights allocation')
      curve_weight_d=physical(0:im-1,0:owned_ny()-1,0:km-1)
      call require_cuda(cudaGetLastError(),'CURVE device weights upload')
    endif
  end subroutine

  integer(int64) function statistics_device_bytes() result(bytes)
    bytes=0
    if(allocated(state_d)) bytes=bytes+real_bytes*size(state_d,kind=int64)
    if(allocated(output_d)) bytes=bytes+real_bytes*size(output_d,kind=int64)
    if(allocated(spatial_d)) bytes=bytes+real_bytes*size(spatial_d,kind=int64)
    if(allocated(node_weight_d)) bytes=bytes+real_bytes*size(node_weight_d,kind=int64)
    if(allocated(curve_weight_d)) bytes=bytes+real_bytes*size(curve_weight_d,kind=int64)
    if(allocated(invalid_d)) bytes=bytes+4*size(invalid_d,kind=int64)
  end function

  subroutine pack_statistics_gpu_state(values,ok)
    use commvar, only: im,jm,km
    real(real_kind),intent(out) :: values(:,:,:,:)
    logical,intent(out) :: ok
    ok=.false.
    if(.not.is_contiguous(values)) return
    if(any(shape(values)/=[im,owned_ny(),km,34])) return
    if(.not.allocated(state_d).or..not.has_previous) return
    call require_cuda(cudaDeviceSynchronize(),'packed statistics save synchronization')
    values(:,:,:,1)=saved_window(1)
    values(:,:,:,2)=saved_window(2)
    values(:,:,:,3)=previous_time
    values(:,:,:,4:33)=state_d
    values(:,:,:,34)=1.e0_real_kind
    call require_cuda(cudaGetLastError(),'packed statistics save copy')
    ok=.true.
  end subroutine

  subroutine unpack_statistics_gpu_state(values,time,window,ok)
    use commvar, only: im,jm,km
    real(real_kind),intent(in) :: values(:,:,:,:),time,window(2)
    logical,intent(out) :: ok
    real(real_kind) :: sample_time
    ok=.false.
    if(.not.is_contiguous(values)) return
    if(any(shape(values)/=[im,owned_ny(),km,34])) return
    if(.not.all(ieee_is_finite([time,window])).or.window(2)<=window(1)) return
    sample_time=values(1,1,1,3)
    if(.not.ieee_is_finite(sample_time).or.sample_time>time) return
    if(any(values(:,:,:,1)/=window(1)).or.any(values(:,:,:,2)/=window(2))) return
    if(any(values(:,:,:,3)/=sample_time).or.any(values(:,:,:,34)/=1.e0_real_kind)) return
    call restore_statistics_values_gpu(values(:,:,:,4:33),sample_time,window,ok)
  end subroutine

  subroutine configure_statistics_device_budget(limit,headroom,ok)
    integer(int64),intent(in) :: limit,headroom
    logical,intent(out) :: ok
    ok=.false.
    if(allocated(state_d).or.limit<=0.or.headroom<0) return
    device_budget=limit
    device_headroom=headroom
    ok=.true.
  end subroutine

  subroutine admit_statistics_device_allocation(extra_bytes)
    use mpi
    use commvar, only: im,jm,km,lreadgrid
    use insitu_sample_gpu, only: sampling_geometry_device_bytes
    integer :: node,rank,nrank,i,ierr,device,status
    character(kind=c_char,len=32) :: pci
    character(kind=c_char,len=32),allocatable :: identities(:)
    integer(int64) :: request,total_request,available
    integer(int64),allocatable :: requests(:),free_values(:)
    integer(c_size_t) :: free_memory,total_memory
    type(resource_budget) :: budget
    logical :: ok
    integer(int64),optional,intent(in) :: extra_bytes
    if(device_budget==0) return
    call checked_bytes(int([im,owned_ny(),km],int64), &
      int((30+merge(1,0,lreadgrid))*storage_size(0.e0_real_kind)/8+storage_size(0)/8,int64),request,ok)
    call guard(ok,'statistics byte count overflow')
    call guard(request<=huge(request)-6_int64*real_bytes-int(real_bytes,int64)*owned_ny(),'statistics reduction byte count overflow')
    request=request+6_int64*real_bytes+int(real_bytes,int64)*owned_ny()
    request=request+sampling_geometry_device_bytes()
    if(present(extra_bytes)) then
      call guard(extra_bytes>=0.and.extra_bytes<=huge(request)-request,'statistics extra byte count overflow')
      request=request+extra_bytes
    endif
    call require_cuda(cudaGetDevice(device),'budget device query')
    pci=repeat(achar(0,kind=c_char),32)
    status=pci_bus_id(pci,32_c_int,int(device,c_int))
    call require_cuda(status,'budget PCI identity query')
    call require_cuda(cudaMemGetInfo(free_memory,total_memory),'budget free memory query')
    call MPI_Comm_split_type(MPI_COMM_WORLD,MPI_COMM_TYPE_SHARED,0,MPI_INFO_NULL,node,ierr)
    call guard(ierr==MPI_SUCCESS,'budget node communicator')
    call MPI_Comm_rank(node,rank,ierr)
    call guard(ierr==MPI_SUCCESS,'budget node rank')
    call MPI_Comm_size(node,nrank,ierr)
    call guard(ierr==MPI_SUCCESS,'budget node size')
    allocate(identities(nrank),requests(nrank),free_values(nrank),stat=status)
    call guard(status==0,'budget metadata allocation')
    call MPI_Allgather(pci,32,MPI_CHARACTER,identities,32,MPI_CHARACTER,node,ierr)
    call guard(ierr==MPI_SUCCESS,'budget identity gather')
    call MPI_Allgather(request,1,MPI_INTEGER8,requests,1,MPI_INTEGER8,node,ierr)
    call guard(ierr==MPI_SUCCESS,'budget demand gather')
    available=int(free_memory,int64)
    call MPI_Allgather(available,1,MPI_INTEGER8,free_values,1,MPI_INTEGER8,node,ierr)
    call guard(ierr==MPI_SUCCESS,'budget free memory gather')
    total_request=0
    do i=1,nrank
      if(identities(i)/=pci) cycle
      call guard(requests(i)<=huge(total_request)-total_request,'budget aggregate overflow')
      total_request=total_request+requests(i)
      available=min(available,free_values(i))
    enddo
    call MPI_Comm_free(node,ierr)
    call guard(ierr==MPI_SUCCESS,'budget node communicator release')
    call configure_budget(budget,device_budget,device_headroom,ok)
    call guard(ok,'statistics budget configuration')
    call reserve_bytes(budget,1,total_request,available,ok)
    call guard(ok,'statistics device allocation exceeds budget or free-memory headroom')
  contains
    subroutine guard(condition,message)
      logical,intent(in) :: condition
      character(*),intent(in) :: message
      integer :: ignored
      if(condition) return
      write(*,'(A)') 'ASTR INSITU RESOURCE ERROR: '//message
      call MPI_Abort(MPI_COMM_WORLD,1,ignored)
    end subroutine
  end subroutine

  function state_header() result(header)
    use commvar, only: ia,ja,ka,im,jm,km
    use parallel, only: mpirank,isize,jsize,ksize,irk,jrk,krk,ig0,jg0,kg0
    integer(int32) :: header(17)
    header=int([1,ia,ja,ka,isize,jsize,ksize,mpirank,irk,jrk,krk,ig0,jg0,kg0,im,jm,km],int32)
  end function

  subroutine write_statistics_gpu_state(unit,batch,step,time,ok)
    use commvar, only: im,jm,km
    integer,intent(in) :: unit
    character(*),intent(in) :: batch
    integer(int64),intent(in) :: step
    real(real_kind),intent(in) :: time
    logical,intent(out) :: ok
    real(real_kind),allocatable :: state(:,:,:,:)
    character(64) :: identity
    integer :: status
    ok=.false.
    if(.not.allocated(state_d).or..not.has_previous) return
    if(len_trim(batch)==0.or.len_trim(batch)>64.or.step<0) return
    if(.not.ieee_is_finite(time).or.previous_time>time) return
    allocate(state(0:im-1,0:owned_ny()-1,0:km-1,30),stat=status)
    if(status/=0) return
    call require_cuda(cudaDeviceSynchronize(),'state save synchronization')
    state=state_d
    call require_cuda(cudaGetLastError(),'state save copy')
    identity=batch
    write(unit,iostat=status) 'ASTRGS01',state_header(),identity,step,time,previous_time,saved_window,state
    ok=status==0
  end subroutine

  subroutine restore_statistics_gpu_state(unit,batch,step,time,window,ok)
    use commvar, only: im,jm,km
    use mpi
    integer,intent(in) :: unit
    character(*),intent(in) :: batch
    integer(int64),intent(in) :: step
    real(real_kind),intent(in) :: time,window(2)
    logical,intent(out) :: ok
    real(real_kind),allocatable :: state(:,:,:,:)
    real(real_kind) :: clock,sample_time,interval(2)
    character(8) :: magic
    character(64) :: identity
    integer(int32) :: header(17)
    integer(int64) :: saved_step
    integer :: status
    ok=.false.
    if(len_trim(batch)==0.or.len_trim(batch)>64.or.step<0) return
    if(.not.all(ieee_is_finite([time,window])).or.window(2)<=window(1)) return
    read(unit,iostat=status) magic,header,identity,saved_step,clock,sample_time,interval
    if(status/=0) return
    if(magic/='ASTRGS01'.or.any(header/=state_header()).or.identity/=batch.or.saved_step/=step) return
    if(.not.all(ieee_is_finite([clock,sample_time,interval]))) return
    if(clock/=time.or.sample_time>time.or.any(interval/=window)) return
    allocate(state(0:im-1,0:owned_ny()-1,0:km-1,30),stat=status)
    if(status/=0) return
    read(unit,iostat=status) state
    if(status/=0) return
    call restore_statistics_values_gpu(state,sample_time,interval,ok)
  end subroutine

  subroutine restore_statistics_values_gpu(state,sample_time,interval,ok)
    use commvar, only: im,jm,km
    use mpi
    real(real_kind),intent(in) :: state(:,:,:,:),sample_time,interval(2)
    logical,intent(out) :: ok
    integer :: status,a,b,base,ierr
    ok=.false.
    if(any(shape(state)/=[im,owned_ny(),km,30])) return
    if(.not.all(ieee_is_finite(state))) return
    if(any(state(:,:,:,1)<=0.e0_real_kind).or.any(state(:,:,:,5:6)<0.e0_real_kind)) return
    if(any((state(:,:,:,5)==0.e0_real_kind).neqv.(state(:,:,:,6)==0.e0_real_kind))) return
    do base=13,22,9
      do b=1,3
        if(any(state(:,:,:,base+4*(b-1))<0.e0_real_kind)) return
        do a=1,b
          if(any(state(:,:,:,base+(b-1)*3+a-1)/=state(:,:,:,base+(a-1)*3+b-1))) return
        enddo
      enddo
    enddo
    do a=7,30
      if(any(state(:,:,:,5)==0.e0_real_kind.and.state(:,:,:,a)/=0.e0_real_kind)) return
    enddo
    ! File validation is complete before modifying any existing device state.
    if(allocated(state_d)) then
      if(any(shape(state_d)/=[im,owned_ny(),km,30])) return
    else
      call admit_statistics_device_allocation()
      allocate(state_d(0:im-1,0:owned_ny()-1,0:km-1,30), &
               invalid_d(1),spatial_d(6),stat=status)
      if(status/=0) call MPI_Abort(MPI_COMM_WORLD,1,ierr)
      call initialize_node_weights()
    endif
    state_d=state
    call require_cuda(cudaGetLastError(),'state restore copy')
    call require_cuda(cudaDeviceSynchronize(),'state restore synchronization')
    previous_time=sample_time
    saved_window=interval
    has_previous=.true.
    ok=.true.
  end subroutine

  subroutine require_cuda(status,where)
    use mpi
    integer,intent(in) :: status
    character(*),intent(in) :: where
    integer :: ierr
    if(status==cudaSuccess) return
    write(*,*) 'in-situ statistics CUDA failure: ',where,': ',trim(cudaGetErrorString(status))
    call MPI_Abort(MPI_COMM_WORLD,1,ierr)
  end subroutine
  attributes(global) launch_bounds(512) subroutine statistics_kernel(im,jm,km,w0,w1,previous)
    use commarray_gpu, only: q_d
    integer,value :: im,jm,km
    real(real_kind),value :: w0,w1
    logical,value :: previous
    integer :: i,j,k,a,b,m,e,f,offset,total_slot,mean_slot,central_slot,ignored
    real(real_kind) :: s(30),u(3),delta(3),rho,w,total,new_total,factor,ratio,entry,r(41)
    i=(blockidx%x-1)*blockdim%x+threadidx%x-1
    j=blockidx%y-1
    k=blockidx%z-1
    if(i>=im.or.j>=jm.or.k>=km) return
    rho=q_d(i,j,k,1)
    if(.not.(rho>0.e0_real_kind.and.rho<=huge(rho))) then
      ignored=atomicAdd(invalid_d(1),1)
      return
    endif
    s=0.e0_real_kind
    if(previous) s=state_d(i,j,k,:)
    do e=1,2
      w=w0
      if(e==2) w=w1
      if(w==0.e0_real_kind) cycle
      rho=s(1)
      u=s(2:4)
      if(e==2) then
        rho=q_d(i,j,k,1)
        u=q_d(i,j,k,2:4)/rho
      endif
      do f=1,2
        total_slot=4+f
        mean_slot=7+3*(f-1)
        central_slot=13+9*(f-1)
        if(f==2) w=w*rho
        total=s(total_slot)
        new_total=total+w
        if(.not.(w>0.e0_real_kind.and.new_total>0.e0_real_kind.and.new_total<=huge(w))) then
          ignored=atomicAdd(invalid_d(1),1)
          return
        endif
        if(total==0.e0_real_kind) then
          s(mean_slot:mean_slot+2)=u
        else
          delta=u-s(mean_slot:mean_slot+2)
          ratio=w/new_total
          factor=(total/new_total)*w
          s(mean_slot:mean_slot+2)=s(mean_slot:mean_slot+2)+ratio*delta
          do b=1,3
          do a=1,b
            offset=central_slot+(b-1)*3+a-1
            entry=s(offset)+(factor*delta(a))*delta(b)
            s(offset)=entry
            s(central_slot+(a-1)*3+b-1)=entry
          enddo
          enddo
        endif
        s(total_slot)=new_total
      enddo
    enddo
    s(1)=q_d(i,j,k,1)
    s(2:4)=q_d(i,j,k,2:4)/s(1)
    do m=1,30
      if(.not.(abs(s(m))<=huge(w))) then
        ignored=atomicAdd(invalid_d(1),1)
        return
      endif
    enddo
    do a=1,3
      if(s(13+4*(a-1))<0.e0_real_kind.or.s(22+4*(a-1))<0.e0_real_kind) then
        ignored=atomicAdd(invalid_d(1),1)
        return
      endif
    enddo
    call statistics_result(s,r)
    do m=1,41
      if(.not.(abs(r(m))<=huge(w))) then
        ignored=atomicAdd(invalid_d(1),1)
        return
      endif
    enddo
    state_d(i,j,k,:)=s
  end subroutine

  attributes(device) subroutine statistics_result(s,r)
    real(real_kind),intent(in) :: s(30)
    real(real_kind),intent(out) :: r(41)
    integer :: a
    r=0.e0_real_kind
    if(s(5)>0.e0_real_kind) then
      r(1)=s(5)
      r(2)=s(6)/s(5)
      r(3:5)=s(7:9)
      r(6:8)=s(10:12)
      r(15:23)=s(13:21)/s(5)
      r(24:32)=s(22:30)/s(6)
      r(33:41)=s(22:30)/s(5)
      do a=1,3
        r(8+a)=sqrt(r(15+4*(a-1)))
        r(11+a)=sqrt(r(24+4*(a-1)))
      enddo
    endif
  end subroutine

  attributes(global) launch_bounds(512) subroutine refresh_results_kernel(im,jm,km)
    integer,value :: im,jm,km
    integer :: i,j,k
    real(real_kind) :: s(30),r(41)
    i=(blockidx%x-1)*blockdim%x+threadidx%x-1
    j=blockidx%y-1
    k=blockidx%z-1
    if(i>=im.or.j>=jm.or.k>=km) return
    s=state_d(i,j,k,:)
    call statistics_result(s,r)
    output_d(i,j,k,:)=r
  end subroutine

  subroutine materialize_statistics_gpu_output()
    use commvar, only: im,jm,km
    integer(int64) :: request
    integer :: status
    logical :: ok
    call checked_bytes(int([im,owned_ny(),km],int64),41_int64*real_bytes,request,ok)
    call require_cuda(merge(cudaSuccess,cudaErrorInvalidValue,ok),'statistics result byte count')
    call admit_statistics_device_allocation(request)
    allocate(output_d(0:im-1,0:owned_ny()-1,0:km-1,41),stat=status)
    call require_cuda(merge(cudaSuccess,cudaErrorMemoryAllocation,status==0),'statistics result allocation')
    call refresh_results_kernel<<<dim3((im+511)/512,owned_ny(),km),dim3(512,1,1)>>>(im,owned_ny(),km)
    call require_cuda(cudaGetLastError(),'requested result launch')
    call require_cuda(cudaDeviceSynchronize(),'requested result completion')
  end subroutine

  subroutine sample_statistics_gpu_mean_vectors(reynolds,favre,covered,duration,want_reynolds,want_favre,retained_other)
    use commvar, only: im,jm,km,ia,ja,ka,lreadgrid,numq,flowtype
    use bc, only: bctype
    use mpi
    use checkpoint_state_io, only: checkpoint_state_require
    use insitu_device_velocity, only: complete_sample_fields_gpu,velocity_transport_usage_gpu
    real(real_kind),device,allocatable,intent(out) :: reynolds(:,:),favre(:,:)
    logical,intent(out) :: covered
    real(real_kind),intent(out) :: duration
    logical,optional,intent(in) :: want_reynolds,want_favre
    integer(int64),optional,intent(in) :: retained_other
    logical :: need_r,need_f
    real(real_kind),device,allocatable :: canonical(:,:,:,:)
    integer,device,allocatable :: invalid(:)
    integer :: nodes,status,ierr,bad,generation,has_state,lowest,highest,nf,nr
    integer(int64) :: host_bytes,transport_bytes,d2h,h2d,exchanges,required,free_bytes,total_bytes,extra
    covered=.false.; duration=0.e0_real_kind
    need_r=.true.; need_f=.true.
    if(present(want_reynolds)) need_r=want_reynolds
    if(present(want_favre)) need_f=want_favre
    call checkpoint_state_require(need_r.or.need_f,MPI_COMM_WORLD,'mean vectors need an explicit requested field')
    nr=merge(3,0,need_r); nf=nr+merge(3,0,need_f)
    call checkpoint_state_require((all(bctype==1).or.(lreadgrid.and.all(bctype==[1,1,41,41,1,1]))).and.numq==5.and. &
      all([ia,ja,ka]==32).and.trim(flowtype)=='tgv',MPI_COMM_WORLD,'device mean vectors require admitted 32^3 TGV')
    has_state=merge(1,0,allocated(state_d))
    call MPI_Allreduce(has_state,lowest,1,MPI_INTEGER,MPI_MIN,MPI_COMM_WORLD,ierr)
    call checkpoint_state_require(ierr==MPI_SUCCESS,MPI_COMM_WORLD,'device mean state consensus')
    call MPI_Allreduce(has_state,highest,1,MPI_INTEGER,MPI_MAX,MPI_COMM_WORLD,ierr)
    call checkpoint_state_require(ierr==MPI_SUCCESS.and.lowest==highest,MPI_COMM_WORLD,'device mean state coverage differs')
    if(has_state==0) return
    duration=state_d(0,0,0,5)
    call require_cuda(cudaGetLastError(),'device mean coverage scalar')
    call checkpoint_state_require(ieee_is_finite(duration).and.duration>=0.e0_real_kind,MPI_COMM_WORLD,'invalid device mean coverage')
    nodes=(im+1)*(jm+1)*(km+1)
    required=int(nodes,int64)*int(2*nf,int64)*real_bytes+6*real_bytes+4
    extra=0
    if(present(retained_other)) extra=retained_other
    call checkpoint_state_require(extra>=0.and.extra<=huge(extra)-required,MPI_COMM_WORLD,'mean retained byte count')
    call velocity_transport_usage_gpu(host_bytes,transport_bytes,d2h,h2d,exchanges,generation)
    call checkpoint_state_require(transport_bytes>0,MPI_COMM_WORLD,'device mean vectors require initialized transport')
    call checkpoint_state_require(transport_bytes<=huge(extra)-extra-required,MPI_COMM_WORLD,'mean transport byte count')
    call admit_statistics_device_allocation(required+transport_bytes+extra)
    free_bytes=0; total_bytes=0
    status=cudaMemGetInfo(free_bytes,total_bytes)
    call checkpoint_state_require(status==cudaSuccess.and.free_bytes>=max(device_headroom,1073741824_int64), &
      MPI_COMM_WORLD,'device mean vectors reserve')
    call checkpoint_state_require(required<=free_bytes-max(device_headroom,1073741824_int64), &
      MPI_COMM_WORLD,'device mean vectors allocation budget')
    allocate(canonical(0:im,0:jm,0:km,nf),invalid(1),stat=status)
    call checkpoint_state_require(status==0,MPI_COMM_WORLD,'device mean vectors allocation')
    invalid=0
    call mean_vectors_kernel<<<(nodes+255)/256,256>>>(canonical,invalid,im,jm,km,owned_ny(),duration,nf,nr)
    call require_cuda(cudaDeviceSynchronize(),'device mean vectors pack')
    bad=invalid(1)
    call checkpoint_state_require(bad==0,MPI_COMM_WORLD,'nonfinite or inconsistent device mean coverage/values')
    ! Zero coverage is valid; do not substitute an instantaneous flow field.
    has_state=merge(1,0,duration>0.e0_real_kind)
    call MPI_Allreduce(has_state,lowest,1,MPI_INTEGER,MPI_MIN,MPI_COMM_WORLD,ierr)
    call checkpoint_state_require(ierr==MPI_SUCCESS,MPI_COMM_WORLD,'device mean coverage consensus')
    call MPI_Allreduce(has_state,highest,1,MPI_INTEGER,MPI_MAX,MPI_COMM_WORLD,ierr)
    call checkpoint_state_require(ierr==MPI_SUCCESS.and.lowest==highest,MPI_COMM_WORLD,'device mean coverage differs')
    if(duration<=0.e0_real_kind) then
      deallocate(canonical,invalid)
      return
    endif
    call complete_sample_fields_gpu(canonical,[im,jm,km],nf,MPI_COMM_WORLD)
    allocate(reynolds(3,merge(nodes,1,need_r)),favre(3,merge(nodes,1,need_f)),stat=status)
    call checkpoint_state_require(status==0,MPI_COMM_WORLD,'device mean vector output allocation')
    call split_mean_vectors_kernel<<<(nodes+255)/256,256>>>(canonical,reynolds,favre,im,jm,km,nf,nr,need_f)
    call require_cuda(cudaDeviceSynchronize(),'device mean vector split')
    deallocate(canonical,invalid)
    covered=.true.
  end subroutine

  attributes(global) subroutine mean_vectors_kernel(canonical,invalid,im,jm,km,ny,duration,nf,nr)
    integer,value :: im,jm,km,ny,nf,nr
    real(real_kind),value :: duration
    real(real_kind),device,intent(out) :: canonical(0:im,0:jm,0:km,nf)
    integer,device,intent(inout) :: invalid(*)
    integer :: node,i,j,k,c,ignored,source
    node=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    if(node>=(im+1)*(jm+1)*(km+1)) return
    i=mod(node,im+1); j=mod(node/(im+1),jm+1); k=node/((im+1)*(jm+1))
    canonical(i,j,k,:)=0.e0_real_kind
    if(i==im.or.j>=ny.or.k==km) return
    if(.not.ieee_is_finite(state_d(i,j,k,5)).or.state_d(i,j,k,5)/=duration) ignored=atomicExch(invalid(1),1)
    if(duration<=0.e0_real_kind) return
    do c=1,nf
      source=c+6
      if(nr==0) source=source+3
      if(.not.ieee_is_finite(state_d(i,j,k,source))) ignored=atomicExch(invalid(1),1)
      canonical(i,j,k,c)=state_d(i,j,k,source)
    enddo
  end subroutine

  attributes(global) subroutine split_mean_vectors_kernel(canonical,reynolds,favre,im,jm,km,nf,nr,need_f)
    integer,value :: im,jm,km,nf,nr
    logical,value :: need_f
    real(real_kind),device,intent(in) :: canonical(0:im,0:jm,0:km,nf)
    real(real_kind),device,intent(out) :: reynolds(3,*),favre(3,*)
    integer :: node,i,j,k
    node=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    if(node>=(im+1)*(jm+1)*(km+1)) return
    i=mod(node,im+1); j=mod(node/(im+1),jm+1); k=node/((im+1)*(jm+1))
    if(nr>0) reynolds(:,node+1)=canonical(i,j,k,1:3)
    if(need_f) favre(:,node+1)=canonical(i,j,k,nr+1:nr+3)
  end subroutine

#ifdef ASTR_BUILD_TESTING
  subroutine check_device_statistics_gpu_means(means,covered,want_reynolds,want_favre)
    use mpi
    use commvar, only: im,jm,km
    use parallel, only: mpirank
    use checkpoint_state_io, only: checkpoint_state_require
    real(real_kind),intent(in) :: means(0:,0:,0:,:)
    logical,intent(in) :: covered
    logical,optional,intent(in) :: want_reynolds,want_favre
    real(real_kind),device,allocatable :: reynolds_d(:,:),favre_d(:,:)
    real(real_kind),allocatable :: reynolds(:,:),favre(:,:)
    logical :: device_covered,need_r,need_f
    character(16) :: mode,root
    real(real_kind) :: duration,difference,maximum
    integer :: status,ierr,nodes,node,i,j,k
    call get_environment_variable('ASTR_INSITU_TEST_DEVICE_TRANSPORT',mode,status=status)
    call checkpoint_state_require(status==0.or.status==1,MPI_COMM_WORLD,'invalid device mean diagnostic transport')
    root=mode
    call MPI_Bcast(root,len(root),MPI_CHARACTER,0,MPI_COMM_WORLD,ierr)
    call checkpoint_state_require(ierr==MPI_SUCCESS.and.mode==root,MPI_COMM_WORLD,'device mean diagnostic transports differ')
    if(mode=='') return
    need_r=.true.; need_f=.true.
    if(present(want_reynolds)) need_r=want_reynolds
    if(present(want_favre)) need_f=want_favre
    call sample_statistics_gpu_mean_vectors(reynolds_d,favre_d,device_covered,duration,need_r,need_f)
    call checkpoint_state_require(device_covered.eqv.covered,MPI_COMM_WORLD,'device mean diagnostic coverage differs')
    if(.not.covered) then
      if(mpirank==0) print *, 'ASTR_INSITU_DEVICE_MEAN_CHECK uncovered'
      return
    endif
    nodes=(im+1)*(jm+1)*(km+1)
    allocate(reynolds(3,merge(nodes,1,need_r)),favre(3,merge(nodes,1,need_f)))
    ! Independent oracle download is restricted to testing builds and this flag.
    reynolds=reynolds_d; favre=favre_d
    difference=0.e0_real_kind
    do node=0,nodes-1
      i=mod(node,im+1); j=mod(node/(im+1),jm+1); k=node/((im+1)*(jm+1))
      if(need_r) difference=max(difference,maxval(abs(reynolds(:,node+1)-means(i,j,k,1:3))))
      if(need_f) difference=max(difference,maxval(abs(favre(:,node+1)-means(i,j,k,4:6))))
      difference=max(difference,abs(duration-means(i,j,k,7)))
    enddo
    call MPI_Allreduce(difference,maximum,1,mpi_real_type,MPI_MAX,MPI_COMM_WORLD,ierr)
    call checkpoint_state_require(ierr==MPI_SUCCESS.and.ieee_is_finite(maximum).and.maximum<=2.e-10_real_kind, &
      MPI_COMM_WORLD,'device mean diagnostic mismatch')
    write(*,'(a,i0,a,es24.16)') 'ASTR_INSITU_DEVICE_MEAN_CHECK rank=',mpirank,' maxabs=',maximum
    deallocate(reynolds_d,favre_d,reynolds,favre)
  end subroutine
#endif

  subroutine download_statistics_gpu_means(means,covered,want_reynolds,want_favre)
    use commvar, only: im,jm,km
    use mpi
    real(real_kind),intent(out) :: means(0:,0:,0:,:)
    logical,intent(out) :: covered
    logical,optional,intent(in) :: want_reynolds,want_favre
    logical :: need_r,need_f
    real(real_kind) :: duration
    integer :: ierr
    covered=.false.
    need_r=.true.; need_f=.true.
    if(present(want_reynolds)) need_r=want_reynolds
    if(present(want_favre)) need_f=want_favre
    call require_cuda(merge(cudaSuccess,cudaErrorInvalidValue, &
      all(shape(means)==[im,owned_ny(),km,7])),'statistics mean download shape')
    means=0.e0_real_kind
    if(.not.allocated(state_d)) return
    duration=state_d(0,0,0,5)
    call require_cuda(cudaGetLastError(),'statistics duration copy')
    if(.not.ieee_is_finite(duration).or.duration<0.e0_real_kind) call MPI_Abort(MPI_COMM_WORLD,1,ierr)
    if(duration<=0.e0_real_kind) return
    if(need_r) means(:,:,:,1:3)=state_d(:,:,:,7:9)
    if(need_f) means(:,:,:,4:6)=state_d(:,:,:,10:12)
    means(:,:,:,7)=duration
    call require_cuda(cudaGetLastError(),'mean fields copy')
    if(.not.all(ieee_is_finite(means))) call MPI_Abort(MPI_COMM_WORLD,1,ierr)
    covered=.true.
  end subroutine

  subroutine accumulate_statistics_gpu(t,window,output)
    use commvar, only: im,jm,km
    use mpi
#ifdef ASTR_BUILD_TESTING
    use insitu_device_velocity, only: trace_sample_memory_gpu
#endif
    real(real_kind),intent(in) :: t,window(2)
    real(real_kind),optional,intent(out) :: output(0:,0:,0:,:)
    real(real_kind) :: weights(2),duration
    integer :: status,ierr
    integer :: invalid
    logical :: ok
#ifdef ASTR_INSITU_DEVICE_PRODUCTS
    interface
      subroutine range_push(stage) bind(C,name='astr_insitu_device_range_push')
        import c_int
        integer(c_int),value :: stage
      end subroutine
      subroutine range_pop() bind(C,name='astr_insitu_device_range_pop')
      end subroutine
    end interface
#endif
    if(.not.allocated(state_d)) then
      call admit_statistics_device_allocation()
      allocate(state_d(0:im-1,0:owned_ny()-1,0:km-1,30), &
               invalid_d(1),spatial_d(6),stat=status)
      if(status/=0) call MPI_Abort(MPI_COMM_WORLD,1,ierr)
      call initialize_node_weights()
      saved_window=window
    endif
    if(any(window/=saved_window)) call MPI_Abort(MPI_COMM_WORLD,1,ierr)
    weights=0.e0_real_kind
    if(has_previous) then
      call clipped_trapezoid(previous_time,t,[1.e0_real_kind,0.e0_real_kind],[0.e0_real_kind,1.e0_real_kind],window(1),window(2),weights,duration,ok)
      if(.not.ok) call MPI_Abort(MPI_COMM_WORLD,1,ierr)
    endif
#ifdef ASTR_INSITU_DEVICE_PRODUCTS
    call range_push(9_c_int)
#endif
    invalid_d=0
    call statistics_kernel<<<dim3((im+511)/512,owned_ny(),km),dim3(512,1,1)>>>(im,owned_ny(),km, &
      weights(1),weights(2),has_previous)
    status=cudaGetLastError()
    call require_cuda(status,'kernel launch')
    status=cudaDeviceSynchronize()
    call require_cuda(status,'kernel completion')
    invalid=invalid_d(1)
    call require_cuda(cudaGetLastError(),'statistics status download')
    if(invalid/=0) then
      write(*,*) 'in-situ statistics invalid state at time ',t,' nodes: ',invalid
      call MPI_Abort(MPI_COMM_WORLD,1,ierr)
    endif
#ifdef ASTR_INSITU_DEVICE_PRODUCTS
    call range_pop()
#endif
    ! Only the explicit independent-oracle caller requests the full device result.
    if(present(output)) then
      call require_cuda(merge(cudaSuccess,cudaErrorInvalidValue, &
        all(shape(output)==[im,owned_ny(),km,41])),'statistics oracle output shape')
      call materialize_statistics_gpu_output()
      output=output_d
      status=cudaGetLastError()
      call require_cuda(status,'result copy')
      deallocate(output_d)
      output_downloads=output_downloads+1
    endif
    sample_calls=sample_calls+1
    previous_time=t
    has_previous=.true.
#ifdef ASTR_BUILD_TESTING
    call trace_sample_memory_gpu('statistics-persistent',statistics_device_bytes(),MPI_COMM_WORLD)
#endif
  end subroutine

  subroutine statistics_transfer_counts(samples,downloads)
    integer(int64),intent(out) :: samples,downloads
    samples=sample_calls
    downloads=output_downloads
  end subroutine

  subroutine download_statistics_gpu_output(output)
    use commvar, only: im,jm,km
    real(real_kind),intent(out) :: output(0:,0:,0:,:)
    call require_cuda(merge(cudaSuccess,cudaErrorInvalidValue, &
      all(shape(output)==[im,owned_ny(),km,41])),'statistics final output shape')
    call materialize_statistics_gpu_output()
    output=output_d
    call require_cuda(cudaGetLastError(),'requested statistics output copy')
    deallocate(output_d)
    output_downloads=output_downloads+1
  end subroutine

  attributes(global) launch_bounds(256) subroutine spatial_kernel(im,jm,km,curve)
    integer,value :: im,jm,km
    logical,value :: curve
    real(real_kind),shared :: scratch(256)
    real(real_kind) :: value,weight,variance
    integer :: lane,component,n,i,j,k,stride
    lane=threadidx%x
    component=blockidx%x
    value=0.e0_real_kind
    ! The half-open owned box excludes duplicate MPI and periodic planes.
    do n=lane-1,im*jm*km-1,256
      i=mod(n,im)
      j=mod(n/im,jm)
      k=n/(im*jm)
      weight=node_weight_d(j)
      if(curve) weight=curve_weight_d(i,j,k)
      if(component<=3) then
        value=value+state_d(i,j,k,component+1)*weight
      else
        variance=0.e0_real_kind
        if(state_d(i,j,k,5)>0.e0_real_kind) variance=state_d(i,j,k,13+4*(component-4))/state_d(i,j,k,5)
        value=value+variance*weight
      endif
    enddo
    scratch(lane)=value
    call syncthreads()
    stride=128
    do while(stride>0)
      if(lane<=stride) scratch(lane)=scratch(lane)+scratch(lane+stride)
      call syncthreads()
      stride=stride/2
    enddo
    if(lane==1) spatial_d(component)=scratch(1)
  end subroutine

  subroutine spatial_statistics_gpu(cell_volume,volume,velocity,variance,ok)
    use commvar, only: im,jm,km,flowtype,lreadgrid
    use mpi
    real(real_kind),intent(in) :: cell_volume
    real(real_kind),intent(out) :: volume,velocity(3),variance(3)
    logical,intent(out) :: ok
    real(real_kind) :: local(7),global(7)
    integer :: ierr,bad,any_bad
    ok=.false.
    volume=0.e0_real_kind; velocity=0.e0_real_kind; variance=0.e0_real_kind
    bad=merge(0,1,allocated(state_d).and.has_previous.and. &
      ieee_is_finite(cell_volume).and.cell_volume>0.e0_real_kind)
    call MPI_Allreduce(bad,any_bad,1,MPI_INTEGER,MPI_MAX,MPI_COMM_WORLD,ierr)
    if(ierr/=MPI_SUCCESS) call MPI_Abort(MPI_COMM_WORLD,1,ierr)
    if(any_bad/=0) return
    ! Preserve the established uniform-grid reduction ordering outside Channel.
    call spatial_kernel<<<6,256>>>(im,owned_ny(),km,lreadgrid)
    call require_cuda(cudaGetLastError(),'spatial reduction launch')
    call require_cuda(cudaDeviceSynchronize(),'spatial reduction completion')
    local(2:7)=spatial_d
    call require_cuda(cudaGetLastError(),'spatial reduction copy')
    if(lreadgrid) then
      local(1)=curve_local_volume
    else if(trim(flowtype)=='channel') then
      block
        real(real_kind) :: weights(0:jm)
        call insitu_node_weights(weights)
        local(1)=real(im,8)*real(km,8)*sum(weights(0:owned_ny()-1))
      end block
    else
      local(1)=real(im,8)*real(jm,8)*real(km,8)
      local=local*cell_volume
    endif
    bad=merge(0,1,all(ieee_is_finite(local)))
    call MPI_Allreduce(bad,any_bad,1,MPI_INTEGER,MPI_MAX,MPI_COMM_WORLD,ierr)
    if(ierr/=MPI_SUCCESS) call MPI_Abort(MPI_COMM_WORLD,1,ierr)
    if(any_bad/=0) return
    call MPI_Allreduce(local,global,7,mpi_real_type,MPI_SUM,MPI_COMM_WORLD,ierr)
    if(ierr/=MPI_SUCCESS) call MPI_Abort(MPI_COMM_WORLD,1,ierr)
    if(.not.all(ieee_is_finite(global)).or.global(1)<=0.e0_real_kind) return
    volume=global(1)
    velocity=global(2:4)/volume
    variance=global(5:7)/volume
    ok=all(ieee_is_finite(velocity)).and.all(ieee_is_finite(variance)).and.all(variance>=0.e0_real_kind)
  end subroutine

  subroutine release_statistics_gpu()
    if(allocated(state_d)) deallocate(state_d,invalid_d,spatial_d,node_weight_d)
    if(allocated(output_d)) deallocate(output_d)
    if(allocated(curve_weight_d)) deallocate(curve_weight_d)
    curve_local_volume=0.e0_real_kind
    has_previous=.false.
  end subroutine
end module
