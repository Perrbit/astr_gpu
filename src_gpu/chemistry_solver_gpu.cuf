module chemistry_flow_solver_gpu
  use cudafor
  use iso_fortran_env, only: real64,int64
  use constdef, only: num1d60,num1d12,num2d3
  use chemistry_air5_data, only: air5_num_species,air5_species_name,air5_molar_mass, &
    air5_atom_count,air5_temperature_min_k,air5_formation_energy
  use chemistry_model, only: chemistry_status_ok,chemistry_status_invalid_density, &
    chemistry_status_invalid_composition,chemistry_status_nonfinite, &
    air5_ratio_bisection_iterations
  use chemistry_state_layout, only: air5_num_conservative,air5_idx_density, &
    air5_idx_momentum_first,air5_idx_momentum_last,air5_idx_total_energy, &
    air5_idx_species_first,air5_idx_species_last,air5_idx_ev
  use chemistry_flow_state_gpu, only: air5_conservative_to_primitive_gpu
  use chemistry_thermo, only: air5_species_vibrational_energy
  use chemistry_thermo_gpu, only: air5_species_gas_constant_gpu, &
    air5_species_cv_tr_gpu
  use chemistry_transport_gpu, only: air5_diffusive_flux_gpu
  implicit none
  private

  integer, device, save :: air5_flow_status_d
  integer, device, save :: air5_limited_points_d
  integer, parameter :: air5_limiter_constraint_species=1
  integer, parameter :: air5_limiter_constraint_vibrational=2
  integer, parameter :: air5_limiter_constraint_density=3
  integer, parameter :: air5_limiter_constraint_translational=4
  integer, parameter :: air5_limiter_constraint_count=4
  integer, device, save :: air5_constraint_active_points_d( &
    air5_limiter_constraint_count)
  integer, device, save :: air5_species_constraint_active_points_d(air5_num_species)
  integer, device, save :: air5_diffusion_failure_claim_d
  integer, device, save :: air5_diffusion_failure_location_d(4)
  integer(int64), device, save :: air5_minimum_ratio_bits_d
  integer(int64), device, save :: air5_constraint_minimum_ratio_bits_d( &
    air5_limiter_constraint_count)
  integer(int64), device, save :: air5_species_constraint_minimum_ratio_bits_d( &
    air5_num_species)
  real(real64), device, save :: air5_diffusion_failure_values_d(5)
  real(real64), device, save :: air5_vibrational_floor_energy_d(air5_num_species)
  real(real64), device, save :: air5_conservation_totals_d(air5_num_conservative)
  real(real64), save :: air5_conservation_baseline(air5_num_conservative)
  logical, save :: air5_conservation_configured=.false.
  logical, save :: air5_conservation_enabled=.false.
  logical, save :: air5_conservation_baseline_set=.false.
  logical, save :: air5_conservation_file_open=.false.
  integer, save :: air5_conservation_unit=-1
  logical, save :: air5_vibrational_floor_configured=.false.

  public :: air5_prepare_spatial_state_gpu
  public :: air5_transport_rk3_step_gpu
  public :: launch_air5_interior_primitive_gpu
  public :: launch_air5_face_primitives_gpu
  public :: validate_air5_transport_gpu

contains

  subroutine configure_air5_vibrational_floor_gpu()
    real(real64) :: floor_energy(air5_num_species)
    integer :: species

    if(air5_vibrational_floor_configured) return
    do species=1,air5_num_species
      floor_energy(species)= &
        air5_species_vibrational_energy(species,air5_temperature_min_k)
    enddo
    air5_vibrational_floor_energy_d=floor_energy
    air5_vibrational_floor_configured=.true.
  end subroutine configure_air5_vibrational_floor_gpu

  attributes(device) real(real64) function air5_interior_ratio_gpu(value)
    real(real64), value :: value

    air5_interior_ratio_gpu=max(0.0_real64,min(1.0_real64,value))
    if(air5_interior_ratio_gpu>0.0_real64 .and. &
       air5_interior_ratio_gpu<1.0_real64) &
      air5_interior_ratio_gpu=nearest(air5_interior_ratio_gpu,-1.0_real64)
  end function air5_interior_ratio_gpu

  attributes(device) real(real64) function air5_vibrational_excess_gpu(ev,rho_species)
    real(real64), value :: ev
    real(real64), intent(in) :: rho_species(air5_num_species)
    integer :: species

    air5_vibrational_excess_gpu=ev
    do species=1,air5_num_species
      air5_vibrational_excess_gpu=air5_vibrational_excess_gpu- &
        air5_vibrational_floor_energy_d(species)*rho_species(species)
    enddo
  end function air5_vibrational_excess_gpu

  attributes(device) real(real64) function air5_translational_margin_gpu(state)
    real(real64), intent(in) :: state(air5_num_conservative)
    real(real64) :: thermal_energy
    integer :: species,component

    if(state(air5_idx_density)<=0.0_real64) then
      air5_translational_margin_gpu=-huge(1.0_real64)
      return
    endif
    thermal_energy=state(air5_idx_total_energy)-state(air5_idx_ev)
    do species=1,air5_num_species
      component=air5_idx_species_first+species-1
      thermal_energy=thermal_energy-state(component)*(air5_formation_energy(species)+ &
        air5_temperature_min_k*air5_species_cv_tr_gpu(species))
    enddo
    air5_translational_margin_gpu=thermal_energy- &
      (state(air5_idx_momentum_first)**2+ &
       state(air5_idx_momentum_first+1)**2+ &
       state(air5_idx_momentum_first+2)**2)/ &
      (2.0_real64*state(air5_idx_density))
  end function air5_translational_margin_gpu

  attributes(device) logical function air5_state_is_admissible_gpu(state)
    real(real64), intent(in) :: state(air5_num_conservative)
    real(real64) :: rho_species(air5_num_species)
    integer :: species,component

    do species=1,air5_num_species
      component=air5_idx_species_first+species-1
      rho_species(species)=state(component)
      if(rho_species(species)<0.0_real64) then
        air5_state_is_admissible_gpu=.false.
        return
      endif
    enddo
    air5_state_is_admissible_gpu=state(air5_idx_density)>0.0_real64 .and. &
      air5_vibrational_excess_gpu(state(air5_idx_ev),rho_species)>=0.0_real64 .and. &
      air5_translational_margin_gpu(state)>=0.0_real64
  end function air5_state_is_admissible_gpu

  attributes(device) integer function air5_state_constraint_mask_gpu(state,species_mask)
    real(real64), intent(in) :: state(air5_num_conservative)
    real(real64) :: rho_species(air5_num_species)
    integer, intent(out) :: species_mask
    integer :: species,component

    do species=1,air5_num_species
      component=air5_idx_species_first+species-1
      rho_species(species)=state(component)
    enddo
    air5_state_constraint_mask_gpu=0
    species_mask=0
    do species=1,air5_num_species
      if(rho_species(species)<0.0_real64) species_mask=ibset(species_mask,species-1)
    enddo
    if(species_mask/=0) air5_state_constraint_mask_gpu=ibset( &
      air5_state_constraint_mask_gpu,air5_limiter_constraint_species-1)
    if(air5_vibrational_excess_gpu(state(air5_idx_ev),rho_species)<0.0_real64) &
      air5_state_constraint_mask_gpu=ibset(air5_state_constraint_mask_gpu, &
        air5_limiter_constraint_vibrational-1)
    if(state(air5_idx_density)<=0.0_real64) air5_state_constraint_mask_gpu= &
      ibset(air5_state_constraint_mask_gpu,air5_limiter_constraint_density-1)
    if(air5_translational_margin_gpu(state)<0.0_real64) &
      air5_state_constraint_mask_gpu=ibset(air5_state_constraint_mask_gpu, &
        air5_limiter_constraint_translational-1)
  end function air5_state_constraint_mask_gpu

  attributes(device) real(real64) function air5_admissible_face_ratio_gpu( &
      low_state,face_correction,collect_diagnostics,constraint_mask,species_mask)
    real(real64), intent(in) :: low_state(air5_num_conservative)
    real(real64), intent(in) :: face_correction(air5_num_conservative)
    integer, value :: collect_diagnostics
    integer, intent(out) :: constraint_mask,species_mask
    real(real64) :: lower,upper,middle
    real(real64) :: trial_state(air5_num_conservative)
    integer :: iteration,component

    do component=1,air5_num_conservative
      trial_state(component)=low_state(component)+6.0_real64*face_correction(component)
    enddo
    if(air5_state_is_admissible_gpu(trial_state)) then
      air5_admissible_face_ratio_gpu=1.0_real64
      constraint_mask=0
      species_mask=0
      return
    endif
    lower=0.0_real64
    upper=1.0_real64
    do iteration=1,air5_ratio_bisection_iterations
      middle=0.5_real64*(lower+upper)
      do component=1,air5_num_conservative
        trial_state(component)=low_state(component)+ &
          6.0_real64*middle*face_correction(component)
      enddo
      if(air5_state_is_admissible_gpu(trial_state)) then
        lower=middle
      else
        upper=middle
      endif
    enddo
    air5_admissible_face_ratio_gpu=air5_interior_ratio_gpu(lower)
    constraint_mask=0
    species_mask=0
    if(collect_diagnostics/=0) then
      do component=1,air5_num_conservative
        trial_state(component)=low_state(component)+ &
          6.0_real64*upper*face_correction(component)
      enddo
      constraint_mask=air5_state_constraint_mask_gpu(trial_state,species_mask)
    endif
  end function air5_admissible_face_ratio_gpu

  attributes(global) subroutine air5_save_filter_species_base_kernel(im,jm,km)
    use commarray_gpu, only: q_d,qrhs_d
    integer, value :: im,jm,km
    integer :: id,ntot,i,j,k,component

    id=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    ntot=(im+1)*(jm+1)*(km+1)
    if(id>=ntot) return
    i=mod(id,im+1)
    j=mod(id/(im+1),jm+1)
    k=id/((im+1)*(jm+1))
    qrhs_d(i,j,k,air5_idx_density)=q_d(i,j,k,air5_idx_density)
    do component=air5_idx_species_first,air5_idx_species_last
      qrhs_d(i,j,k,component)=q_d(i,j,k,component)
    enddo
  end subroutine air5_save_filter_species_base_kernel

  attributes(global) subroutine air5_limit_filtered_state_kernel(im,jm,km)
    use commarray_gpu, only: q_d,qrhs_d
    integer, value :: im,jm,km
    integer :: id,ntot,i,j,k,component,species,closure_species
    real(real64) :: state(air5_num_conservative)
    real(real64) :: base_species(air5_num_species)
    real(real64) :: filtered_species(air5_num_species)
    real(real64) :: low_species(air5_num_species)
    real(real64) :: candidate_species(air5_num_species)
    real(real64) :: rho_base,rho_filtered,base_sum,base_tolerance
    real(real64) :: other_sum,direction,theta
    logical :: resolved_undershoot

    id=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    ntot=(im+1)*(jm+1)*(km+1)
    if(id>=ntot) return
    i=mod(id,im+1)
    j=mod(id/(im+1),jm+1)
    k=id/((im+1)*(jm+1))
    do component=1,air5_num_conservative
      state(component)=q_d(i,j,k,component)
    enddo

    rho_base=qrhs_d(i,j,k,air5_idx_density)
    rho_filtered=state(air5_idx_density)
    if(rho_base/=rho_base .or. rho_filtered/=rho_filtered .or. &
       abs(rho_base)>huge(1.0_real64) .or. &
       abs(rho_filtered)>huge(1.0_real64)) then
      call record_air5_status(chemistry_status_nonfinite)
      return
    endif
    if(rho_base<=0.0_real64 .or. rho_filtered<=0.0_real64) then
      call record_air5_status(chemistry_status_invalid_density)
      return
    endif

    base_sum=0.0_real64
    do species=1,air5_num_species
      component=air5_idx_species_first+species-1
      base_species(species)=qrhs_d(i,j,k,component)
      filtered_species(species)=state(component)
      if(base_species(species)/=base_species(species) .or. &
         filtered_species(species)/=filtered_species(species) .or. &
         abs(base_species(species))>huge(1.0_real64) .or. &
         abs(filtered_species(species))>huge(1.0_real64)) then
        call record_air5_status(chemistry_status_nonfinite)
        return
      endif
      if(base_species(species)<0.0_real64) then
        call record_air5_status(chemistry_status_invalid_composition)
        return
      endif
      base_sum=base_sum+base_species(species)
    enddo

    base_tolerance=1.0e-10_real64*max(rho_base,1.0_real64)
    if(base_sum<=tiny(1.0_real64) .or. abs(base_sum-rho_base)>base_tolerance) then
      call record_air5_status(chemistry_status_invalid_composition)
      return
    endif
    closure_species=1
    do species=2,air5_num_species
      if(base_species(species)>base_species(closure_species)) closure_species=species
    enddo
    other_sum=0.0_real64
    do species=1,air5_num_species
      if(species/=closure_species) other_sum=other_sum+filtered_species(species)
    enddo
    filtered_species(closure_species)=rho_filtered-other_sum

    resolved_undershoot=.false.
    do species=1,air5_num_species
      if(filtered_species(species)<0.0_real64) resolved_undershoot=.true.
    enddo

    if(resolved_undershoot) then
      theta=1.0_real64
      do species=1,air5_num_species
        low_species(species)=rho_filtered*base_species(species)/base_sum
        direction=filtered_species(species)-low_species(species)
        if(direction<0.0_real64) theta=min(theta, &
          low_species(species)/(low_species(species)-filtered_species(species)))
      enddo
      theta=air5_interior_ratio_gpu(theta)
      do species=1,air5_num_species
        candidate_species(species)=low_species(species)+ &
          theta*(filtered_species(species)-low_species(species))
      enddo
    else
      do species=1,air5_num_species
        candidate_species(species)=filtered_species(species)
      enddo
    endif

    other_sum=0.0_real64
    do species=1,air5_num_species
      if(species/=closure_species) other_sum=other_sum+candidate_species(species)
    enddo
    candidate_species(closure_species)=rho_filtered-other_sum
    do species=1,air5_num_species
      if(candidate_species(species)<0.0_real64) then
        call record_air5_status(chemistry_status_invalid_composition)
        return
      endif
    enddo

    do species=1,air5_num_species
      component=air5_idx_species_first+species-1
      state(component)=candidate_species(species)
      q_d(i,j,k,component)=candidate_species(species)
    enddo
    if(.not.air5_state_is_admissible_gpu(state)) then
      call record_air5_status(chemistry_status_invalid_composition)
    endif
  end subroutine air5_limit_filtered_state_kernel

  attributes(device) real(real64) function air5_minmod2_gpu(first,second)
    real(real64), value :: first,second

    if(first>0.0_real64 .and. second>0.0_real64) then
      air5_minmod2_gpu=min(abs(first),abs(second))
    elseif(first<0.0_real64 .and. second<0.0_real64) then
      air5_minmod2_gpu=-min(abs(first),abs(second))
    else
      air5_minmod2_gpu=0.0_real64
    endif
  end function air5_minmod2_gpu

  attributes(device) real(real64) function air5_minmod4_gpu(first,second,third,fourth)
    real(real64), value :: first,second,third,fourth

    if(first>0.0_real64 .and. second>0.0_real64 .and. &
       third>0.0_real64 .and. fourth>0.0_real64) then
      air5_minmod4_gpu=min(abs(first),abs(second),abs(third),abs(fourth))
    elseif(first<0.0_real64 .and. second<0.0_real64 .and. &
           third<0.0_real64 .and. fourth<0.0_real64) then
      air5_minmod4_gpu=-min(abs(first),abs(second),abs(third),abs(fourth))
    else
      air5_minmod4_gpu=0.0_real64
    endif
  end function air5_minmod4_gpu

  attributes(device) real(real64) function air5_suw3_gpu(values)
    real(real64) :: values(7)

    air5_suw3_gpu=(-values(1)+5.0_real64*values(2)+2.0_real64*values(3))/6.0_real64
  end function air5_suw3_gpu

  attributes(device) real(real64) function air5_mp5_gpu(values)
    real(real64) :: values(7)
    real(real64) :: linear,mp,upper_limit,average,median,large_curvature
    real(real64) :: lower,upper,dm1,d0,d1,dhm1,dh0

    linear=(2.0_real64*values(1)-13.0_real64*values(2)+ &
      47.0_real64*values(3)+27.0_real64*values(4)-3.0_real64*values(5))/60.0_real64
    mp=values(3)+air5_minmod2_gpu(values(4)-values(3), &
      4.0_real64*(values(3)-values(2)))
    if((linear-values(3))*(linear-mp)<1.0e-10_real64) then
      air5_mp5_gpu=linear
      return
    endif
    dm1=values(1)-2.0_real64*values(2)+values(3)
    d0=values(2)-2.0_real64*values(3)+values(4)
    d1=values(3)-2.0_real64*values(4)+values(5)
    dhm1=air5_minmod4_gpu(4.0_real64*dm1-d0,4.0_real64*d0-dm1,dm1,d0)
    dh0=air5_minmod4_gpu(4.0_real64*d0-d1,4.0_real64*d1-d0,d0,d1)
    upper_limit=values(3)+4.0_real64*(values(3)-values(2))
    average=0.5_real64*(values(3)+values(4))
    median=average-0.5_real64*dh0
    large_curvature=values(3)+0.5_real64*(values(3)-values(2))+ &
      (4.0_real64/3.0_real64)*dhm1
    lower=max(min(values(3),values(4),median), &
      min(values(3),upper_limit,large_curvature))
    upper=min(max(values(3),values(4),median), &
      max(values(3),upper_limit,large_curvature))
    air5_mp5_gpu=linear+air5_minmod2_gpu(lower-linear,upper-linear)
  end function air5_mp5_gpu

  attributes(device) real(real64) function air5_mp7_gpu(values)
    real(real64) :: values(7)
    real(real64) :: linear,mp,upper_limit,average,median,large_curvature
    real(real64) :: lower,upper,dm1,d0,d1,dhm1,dh0

    linear=(-3.0_real64*values(1)+25.0_real64*values(2)- &
      101.0_real64*values(3)+319.0_real64*values(4)+ &
      214.0_real64*values(5)-38.0_real64*values(6)+ &
      4.0_real64*values(7))/420.0_real64
    mp=values(4)+air5_minmod2_gpu(values(5)-values(4), &
      4.0_real64*(values(4)-values(3)))
    if((linear-values(4))*(linear-mp)<1.0e-10_real64) then
      air5_mp7_gpu=linear
      return
    endif
    dm1=values(2)-2.0_real64*values(3)+values(4)
    d0=values(3)-2.0_real64*values(4)+values(5)
    d1=values(4)-2.0_real64*values(5)+values(6)
    dhm1=air5_minmod4_gpu(4.0_real64*dm1-d0,4.0_real64*d0-dm1,dm1,d0)
    dh0=air5_minmod4_gpu(4.0_real64*d0-d1,4.0_real64*d1-d0,d0,d1)
    upper_limit=values(4)+4.0_real64*(values(4)-values(3))
    average=0.5_real64*(values(4)+values(5))
    median=average-0.5_real64*dh0
    large_curvature=values(4)+0.5_real64*(values(4)-values(3))+ &
      (4.0_real64/3.0_real64)*dhm1
    lower=max(min(values(4),values(5),median), &
      min(values(4),upper_limit,large_curvature))
    upper=min(max(values(4),values(5),median), &
      max(values(4),upper_limit,large_curvature))
    air5_mp7_gpu=linear+air5_minmod2_gpu(lower-linear,upper-linear)
  end function air5_mp7_gpu

  attributes(device) real(real64) function air5_deriv6(fm3,fm2,fm1,fp1,fp2,fp3)
    real(real64), value :: fm3,fm2,fm1,fp1,fp2,fp3

    air5_deriv6=0.75_real64*(fp1-fm1)-0.15_real64*(fp2-fm2)+ &
      num1d60*(fp3-fm3)
  end function air5_deriv6

  attributes(device) real(real64) function air5_deriv6_boundary(index,dim,ntype, &
      fm3,fm2,fm1,fp1,fp2,fp3) result(derivative)
    integer, value :: index,dim,ntype
    real(real64), value :: fm3,fm2,fm1,fp1,fp2,fp3

    if((ntype==1 .or. ntype==4) .and. index==1) then
      derivative=0.5_real64*(fp1-fm1)
    elseif((ntype==1 .or. ntype==4) .and. index==2) then
      derivative=num2d3*(fp1-fm1)-num1d12*(fp2-fm2)
    elseif((ntype==2 .or. ntype==4) .and. index==dim-1) then
      derivative=0.5_real64*(fp1-fm1)
    elseif((ntype==2 .or. ntype==4) .and. index==dim-2) then
      derivative=num2d3*(fp1-fm1)-num1d12*(fp2-fm2)
    else
      derivative=air5_deriv6(fm3,fm2,fm1,fp1,fp2,fp3)
    endif
  end function air5_deriv6_boundary

  attributes(device) real(real64) function air5_deriv6_full_boundary(index,dim, &
      ntype,f0,fm3,fm2,fm1,fp1,fp2,fp3) result(derivative)
    integer, value :: index,dim,ntype
    real(real64), value :: f0,fm3,fm2,fm1,fp1,fp2,fp3

    if((ntype==1 .or. ntype==4) .and. index==0) then
      derivative=-0.5_real64*fp2+2.0_real64*fp1-1.5_real64*f0
    elseif((ntype==2 .or. ntype==4) .and. index==dim) then
      derivative=0.5_real64*fm2-2.0_real64*fm1+1.5_real64*f0
    else
      derivative=air5_deriv6_boundary(index,dim,ntype,fm3,fm2,fm1,fp1,fp2,fp3)
    endif
  end function air5_deriv6_full_boundary

  attributes(device) real(real64) function air5_diffusion_rhs_sign(component)
    integer, value :: component

    ! Physical species flux Js=-rho*Ds*grad(Ys) enters the conservative RHS as -div(Js).
    air5_diffusion_rhs_sign=1.0_real64
    if(component>=air5_idx_species_first .and. &
       component<=air5_idx_species_last) air5_diffusion_rhs_sign=-1.0_real64
  end function air5_diffusion_rhs_sign

  attributes(device) subroutine record_air5_status(status)
    integer, value :: status
    integer :: previous

    if(status/=chemistry_status_ok) previous=atomicMax(air5_flow_status_d,status)
  end subroutine record_air5_status

  attributes(device) subroutine air5_store_primitive_point(i,j,k,im,jm,km,hm)
    use commarray_gpu, only: q_d,rho_d,vel_d,prs_d,tmp_d,spc_d,tve_d
    integer, value :: i,j,k,im,jm,km,hm
    real(real64) :: qlocal(air5_num_conservative),rho,velocity(3),temperature
    real(real64) :: mass_fraction(air5_num_species),tv,pressure
    integer :: status

    qlocal=q_d(i,j,k,1:air5_num_conservative)
    call air5_conservative_to_primitive_gpu(qlocal,rho,velocity,temperature, &
      mass_fraction,tv,pressure,status)
    if(status/=chemistry_status_ok) then
      call record_air5_status(status)
      return
    endif
    rho_d(i,j,k)=rho
    vel_d(i,j,k,:)=velocity
    prs_d(i,j,k)=pressure
    tmp_d(i,j,k)=temperature
    spc_d(i,j,k,:)=mass_fraction
    tve_d(i,j,k)=tv
  end subroutine air5_store_primitive_point

  attributes(global) subroutine air5_q_to_primitive_interior_kernel(im,jm,km,hm)
    integer, value :: im,jm,km,hm
    integer :: i,j,k

    i=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    j=(blockIdx%y-1)*blockDim%y+threadIdx%y-1
    k=(blockIdx%z-1)*blockDim%z+threadIdx%z-1
    if(i>im .or. j>jm .or. k>km) return
    call air5_store_primitive_point(i,j,k,im,jm,km,hm)
  end subroutine air5_q_to_primitive_interior_kernel

  attributes(global) subroutine air5_q_to_primitive_face_kernel(im,jm,km,hm,axis)
    integer, value :: im,jm,km,hm,axis
    integer :: id,n1,n2,h,side,i,j,k

    id=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    select case(axis)
    case(1)
      n1=jm+1
      n2=km+1
      if(id>=n1*n2*2*(hm+1)) return
      j=mod(id,n1)
      k=mod(id/n1,n2)
      h=mod(id/(n1*n2),hm+1)
      side=id/(n1*n2*(hm+1))
      i=merge(-hm+h,im+h,side==0)
    case(2)
      n1=im+1
      n2=km+1
      if(id>=n1*n2*2*(hm+1)) return
      i=mod(id,n1)
      k=mod(id/n1,n2)
      h=mod(id/(n1*n2),hm+1)
      side=id/(n1*n2*(hm+1))
      j=merge(-hm+h,jm+h,side==0)
    case default
      n1=im+1
      n2=jm+1
      if(id>=n1*n2*2*(hm+1)) return
      i=mod(id,n1)
      j=mod(id/n1,n2)
      h=mod(id/(n1*n2),hm+1)
      side=id/(n1*n2*(hm+1))
      k=merge(-hm+h,km+h,side==0)
    end select
    call air5_store_primitive_point(i,j,k,im,jm,km,hm)
  end subroutine air5_q_to_primitive_face_kernel

  attributes(global) subroutine air5_zero_rhs_kernel(im,jm,km)
    use commarray_gpu, only: qrhs_d
    integer, value :: im,jm,km
    integer :: id,ntot,i,j,k

    id=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    ntot=(im+1)*(jm+1)*(km+1)
    if(id>=ntot) return
    i=mod(id,im+1)
    j=mod(id/(im+1),jm+1)
    k=id/((im+1)*(jm+1))
    qrhs_d(i,j,k,1:air5_num_conservative)=0.0_real64
  end subroutine air5_zero_rhs_kernel

  attributes(global) subroutine air5_zero_conservation_totals_kernel()
    integer :: component

    component=(blockIdx%x-1)*blockDim%x+threadIdx%x
    if(component>air5_num_conservative) return
    air5_conservation_totals_d(component)=0.0_real64
  end subroutine air5_zero_conservation_totals_kernel

  attributes(global) subroutine air5_integrate_unique_cells_kernel(im,jm,km)
    use commarray_gpu, only: q_d,jacob_d
    integer, value :: im,jm,km
    integer :: id,ntot,i,j,k,di,dj,dk,component
    real(real64) :: cell_total,ignored

    id=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    ntot=im*jm*km
    if(id>=ntot) return
    i=mod(id,im)
    j=mod(id/im,jm)
    k=id/(im*jm)
    do component=1,air5_num_conservative
      cell_total=0.0_real64
      do dk=0,1
        do dj=0,1
          do di=0,1
            cell_total=cell_total+q_d(i+di,j+dj,k+dk,component)* &
              jacob_d(i+di,j+dj,k+dk)
          enddo
        enddo
      enddo
      ignored=atomicAdd(air5_conservation_totals_d(component),0.125_real64*cell_total)
    enddo
  end subroutine air5_integrate_unique_cells_kernel

  subroutine configure_air5_conservation_gpu()
    use mpi
    character(len=32) :: value
    integer :: status,length,local_flag,minimum_flag,maximum_flag,ierr
    logical :: local_enabled

    if(air5_conservation_configured) return
    value=''
    call get_environment_variable('ASTR_AIR5_C4_CONSERVATION',value, &
      length=length,status=status)
    local_enabled=.false.
    if(status==0 .and. length>0) then
      select case(trim(adjustl(value)))
      case('1','t','T','true','TRUE','yes','YES','on','ON')
        local_enabled=.true.
      end select
    endif
    local_flag=merge(1,0,local_enabled)
    call mpi_allreduce(local_flag,minimum_flag,1,MPI_INTEGER,MPI_MIN,MPI_COMM_WORLD,ierr)
    if(ierr/=MPI_SUCCESS) call mpi_abort(MPI_COMM_WORLD,ierr,status)
    call mpi_allreduce(local_flag,maximum_flag,1,MPI_INTEGER,MPI_MAX,MPI_COMM_WORLD,ierr)
    if(ierr/=MPI_SUCCESS) call mpi_abort(MPI_COMM_WORLD,ierr,status)
    if(minimum_flag/=maximum_flag) then
      write(*,'(A)') 'ASTR_AIR5_C4_CONSERVATION must be identical on every MPI rank'
      call mpi_abort(MPI_COMM_WORLD,1,ierr)
    endif
    air5_conservation_enabled=maximum_flag==1
    air5_conservation_configured=.true.
  end subroutine configure_air5_conservation_gpu

  subroutine calculate_air5_conservation_totals_gpu(global_totals)
    use mpi
    use commvar, only: im,jm,km
    use gpu_check, only: sync_after_kernel
    real(real64), intent(out) :: global_totals(air5_num_conservative)
    real(real64) :: local_totals(air5_num_conservative)
    integer :: ntot,ierr
    type(dim3) :: block,grid

    block=dim3(256,1,1)
    grid=dim3(1,1,1)
    call air5_zero_conservation_totals_kernel<<<grid,block>>>()
    call sync_after_kernel('air5_zero_conservation_totals_kernel',.true.)
    ntot=im*jm*km
    grid=dim3((ntot+block%x-1)/block%x,1,1)
    call air5_integrate_unique_cells_kernel<<<grid,block>>>(im,jm,km)
    call sync_after_kernel('air5_integrate_unique_cells_kernel',.true.)
    local_totals=air5_conservation_totals_d
    call mpi_allreduce(local_totals,global_totals,air5_num_conservative, &
      MPI_DOUBLE_PRECISION,MPI_SUM,MPI_COMM_WORLD,ierr)
    if(ierr/=MPI_SUCCESS) call mpi_abort(MPI_COMM_WORLD,ierr,ntot)
  end subroutine calculate_air5_conservation_totals_gpu

  subroutine write_air5_conservation_record(step,phase,global_totals)
    use ieee_arithmetic, only: ieee_is_finite
    use parallel, only: mpirank
    integer, intent(in) :: step,phase
    real(real64), intent(in) :: global_totals(air5_num_conservative)
    real(real64) :: elements(2),baseline_elements(2),species_closure
    real(real64) :: relative_mass,relative_energy,relative_elements(2)
    real(real64) :: max_species_drift
    integer :: element,species

    if(.not.all(ieee_is_finite(global_totals))) &
      error stop 'non-finite fixed air5 global conservation record'
    elements=0.0_real64
    baseline_elements=0.0_real64
    do element=1,2
      do species=1,air5_num_species
        elements(element)=elements(element)+ &
          global_totals(air5_idx_species_first+species-1)* &
          real(air5_atom_count(element,species),real64)/air5_molar_mass(species)
        baseline_elements(element)=baseline_elements(element)+ &
          air5_conservation_baseline(air5_idx_species_first+species-1)* &
          real(air5_atom_count(element,species),real64)/air5_molar_mass(species)
      enddo
    enddo
    species_closure=sum(global_totals(air5_idx_species_first:air5_idx_species_last))- &
      global_totals(air5_idx_density)
    relative_mass=(global_totals(air5_idx_density)- &
      air5_conservation_baseline(air5_idx_density))/ &
      max(abs(air5_conservation_baseline(air5_idx_density)),tiny(1.0_real64))
    relative_energy=(global_totals(air5_idx_total_energy)- &
      air5_conservation_baseline(air5_idx_total_energy))/ &
      max(abs(air5_conservation_baseline(air5_idx_total_energy)),tiny(1.0_real64))
    relative_elements=(elements-baseline_elements)/ &
      max(abs(baseline_elements),tiny(1.0_real64))
    max_species_drift=maxval(abs( &
      global_totals(air5_idx_species_first:air5_idx_species_last)- &
      air5_conservation_baseline(air5_idx_species_first:air5_idx_species_last)))
    if(mpirank==0) then
      if(.not.air5_conservation_file_open) then
        open(newunit=air5_conservation_unit,file='air5_c4_conservation.dat', &
          status='replace',action='write')
        air5_conservation_file_open=.true.
        write(air5_conservation_unit,'(A)') &
          '# step phase q1 q2 q3 q4 q5 q6 q7 q8 q9 q10 q11 element_n element_o '// &
          'species_mass_closure rel_mass rel_energy rel_element_n rel_element_o '// &
          'max_species_abs_drift'
      endif
      write(air5_conservation_unit,'(I10,1X,I1,1X,19(ES24.16E3,1X))') &
        step,phase,global_totals,elements,species_closure,relative_mass, &
        relative_energy,relative_elements,max_species_drift
      flush(air5_conservation_unit)
    endif
  end subroutine write_air5_conservation_record

  subroutine initialize_air5_conservation_gpu(step)
    integer, intent(in) :: step
    real(real64) :: global_totals(air5_num_conservative)

    call configure_air5_conservation_gpu()
    if(.not.air5_conservation_enabled .or. air5_conservation_baseline_set) return
    call calculate_air5_conservation_totals_gpu(global_totals)
    air5_conservation_baseline=global_totals
    air5_conservation_baseline_set=.true.
    call write_air5_conservation_record(step,0,global_totals)
  end subroutine initialize_air5_conservation_gpu

  subroutine record_air5_conservation_gpu(step)
    integer, intent(in) :: step
    real(real64) :: global_totals(air5_num_conservative)

    call configure_air5_conservation_gpu()
    if(.not.air5_conservation_enabled) return
    if(.not.air5_conservation_baseline_set) &
      error stop 'fixed air5 conservation baseline is not initialized'
    call calculate_air5_conservation_totals_gpu(global_totals)
    call write_air5_conservation_record(step,1,global_totals)
  end subroutine record_air5_conservation_gpu

  attributes(device) subroutine air5_convective_flux_at(i,j,k,idir,f)
    use commarray_gpu, only: q_d,vel_d,prs_d,jacob_d,dxi_d
    integer, value :: i,j,k,idir
    real(real64), intent(out) :: f(air5_num_conservative)
    real(real64) :: normal_velocity,metric_jacobian
    integer :: component

    normal_velocity=dxi_d(i,j,k,idir,1)*vel_d(i,j,k,1)+ &
      dxi_d(i,j,k,idir,2)*vel_d(i,j,k,2)+ &
      dxi_d(i,j,k,idir,3)*vel_d(i,j,k,3)
    metric_jacobian=jacob_d(i,j,k)
    f(air5_idx_density)=metric_jacobian*q_d(i,j,k,air5_idx_density)*normal_velocity
    do component=air5_idx_momentum_first,air5_idx_momentum_last
      f(component)=metric_jacobian*(q_d(i,j,k,component)*normal_velocity+ &
        dxi_d(i,j,k,idir,component-air5_idx_momentum_first+1)*prs_d(i,j,k))
    enddo
    f(air5_idx_total_energy)=metric_jacobian* &
      (q_d(i,j,k,air5_idx_total_energy)+prs_d(i,j,k))*normal_velocity
    do component=air5_idx_species_first,air5_idx_species_last
      f(component)=metric_jacobian*q_d(i,j,k,component)*normal_velocity
    enddo
    f(air5_idx_ev)=metric_jacobian*q_d(i,j,k,air5_idx_ev)*normal_velocity
  end subroutine air5_convective_flux_at

  attributes(device) real(real64) function air5_frozen_spectral_radius_gpu( &
      i,j,k,direction,index)
    use commarray_gpu, only: rho_d,vel_d,prs_d,spc_d,dxi_d
    integer, value :: i,j,k,direction,index
    integer :: ii,jj,kk,species
    real(real64) :: mixture_r,mixture_cv,gamma_tr,metric_norm,normal_velocity

    ii=i; jj=j; kk=k
    select case(direction)
    case(1); ii=index
    case(2); jj=index
    case default; kk=index
    end select
    if(rho_d(ii,jj,kk)<=0.0_real64 .or. prs_d(ii,jj,kk)<=0.0_real64) then
      call record_air5_status(chemistry_status_invalid_composition)
      air5_frozen_spectral_radius_gpu=0.0_real64
      return
    endif
    mixture_r=0.0_real64
    mixture_cv=0.0_real64
    do species=1,air5_num_species
      mixture_r=mixture_r+spc_d(ii,jj,kk,species)* &
        air5_species_gas_constant_gpu(species)
      mixture_cv=mixture_cv+spc_d(ii,jj,kk,species)* &
        air5_species_cv_tr_gpu(species)
    enddo
    if(mixture_r<=0.0_real64 .or. mixture_cv<=0.0_real64) then
      call record_air5_status(chemistry_status_invalid_composition)
      air5_frozen_spectral_radius_gpu=0.0_real64
      return
    endif
    gamma_tr=1.0_real64+mixture_r/mixture_cv
    metric_norm=sqrt(sum(dxi_d(ii,jj,kk,direction,:)**2))
    normal_velocity=sum(dxi_d(ii,jj,kk,direction,:)*vel_d(ii,jj,kk,:))
    air5_frozen_spectral_radius_gpu=abs(normal_velocity)+ &
      sqrt(gamma_tr*prs_d(ii,jj,kk)/rho_d(ii,jj,kk))*metric_norm
  end function air5_frozen_spectral_radius_gpu

  attributes(device) subroutine air5_llf_split_flux_gpu(i,j,k,direction,index, &
      alpha,fplus,fminus)
    use commarray_gpu, only: q_d,jacob_d
    integer, value :: i,j,k,direction,index
    real(real64), value :: alpha
    real(real64), intent(out) :: fplus(air5_num_conservative)
    real(real64), intent(out) :: fminus(air5_num_conservative)
    real(real64) :: flux(air5_num_conservative),state(air5_num_conservative)
    real(real64) :: metric_jacobian
    integer :: ii,jj,kk

    ii=i; jj=j; kk=k
    select case(direction)
    case(1); ii=index
    case(2); jj=index
    case default; kk=index
    end select
    call air5_convective_flux_at(ii,jj,kk,direction,flux)
    state=q_d(ii,jj,kk,1:air5_num_conservative)
    metric_jacobian=jacob_d(ii,jj,kk)
    fplus=0.5_real64*(flux+alpha*metric_jacobian*state)
    fminus=0.5_real64*(flux-alpha*metric_jacobian*state)
  end subroutine air5_llf_split_flux_gpu

  attributes(device) logical function air5_shock_interface_active_gpu( &
      i,j,k,direction,face,dim,ntype)
    use commarray_gpu, only: shock_mask_d
    integer, value :: i,j,k,direction,face,dim,ntype

    air5_shock_interface_active_gpu=.false.
    select case(direction)
    case(1)
      if(face<0 .or. (face==0 .and. (ntype==2 .or. ntype==3))) then
        air5_shock_interface_active_gpu=shock_mask_d(0,j,k)/=0_1
      elseif(face>=dim .or. (face==dim-1 .and. (ntype==1 .or. ntype==3))) then
        air5_shock_interface_active_gpu=shock_mask_d(dim,j,k)/=0_1
      else
        air5_shock_interface_active_gpu=shock_mask_d(face,j,k)/=0_1 .or. &
          shock_mask_d(face+1,j,k)/=0_1
      endif
    case(2)
      if(face<0 .or. (face==0 .and. (ntype==2 .or. ntype==3))) then
        air5_shock_interface_active_gpu=shock_mask_d(i,0,k)/=0_1
      elseif(face>=dim .or. (face==dim-1 .and. (ntype==1 .or. ntype==3))) then
        air5_shock_interface_active_gpu=shock_mask_d(i,dim,k)/=0_1
      else
        air5_shock_interface_active_gpu=shock_mask_d(i,face,k)/=0_1 .or. &
          shock_mask_d(i,face+1,k)/=0_1
      endif
    case default
      if(face<0 .or. (face==0 .and. (ntype==2 .or. ntype==3))) then
        air5_shock_interface_active_gpu=shock_mask_d(i,j,0)/=0_1
      elseif(face>=dim .or. (face==dim-1 .and. (ntype==1 .or. ntype==3))) then
        air5_shock_interface_active_gpu=shock_mask_d(i,j,dim)/=0_1
      else
        air5_shock_interface_active_gpu=shock_mask_d(i,j,face)/=0_1 .or. &
          shock_mask_d(i,j,face+1)/=0_1
      endif
    end select
  end function air5_shock_interface_active_gpu

  attributes(device) subroutine air5_convective_line_flux(i,j,k,direction,index,f)
    integer, value :: i,j,k,direction,index
    real(real64), intent(out) :: f(air5_num_conservative)

    select case(direction)
    case(1)
      call air5_convective_flux_at(index,j,k,direction,f)
    case(2)
      call air5_convective_flux_at(i,index,k,direction,f)
    case(3)
      call air5_convective_flux_at(i,j,index,direction,f)
    end select
  end subroutine air5_convective_line_flux

  attributes(device) subroutine air5_centered_convective_face_flux(i,j,k, &
      direction,face,f)
    integer, value :: i,j,k,direction,face
    real(real64), intent(out) :: f(air5_num_conservative)
    real(real64) :: fm2(air5_num_conservative),fm1(air5_num_conservative)
    real(real64) :: f0(air5_num_conservative),fp1(air5_num_conservative)
    real(real64) :: fp2(air5_num_conservative),fp3(air5_num_conservative)

    call air5_convective_line_flux(i,j,k,direction,face-2,fm2)
    call air5_convective_line_flux(i,j,k,direction,face-1,fm1)
    call air5_convective_line_flux(i,j,k,direction,face,f0)
    call air5_convective_line_flux(i,j,k,direction,face+1,fp1)
    call air5_convective_line_flux(i,j,k,direction,face+2,fp2)
    call air5_convective_line_flux(i,j,k,direction,face+3,fp3)
    f=(37.0_real64*num1d60)*(f0+fp1)-(2.0_real64/15.0_real64)*(fm1+fp2)+ &
      num1d60*(fm2+fp3)
  end subroutine air5_centered_convective_face_flux

  attributes(device) subroutine air5_shock_convective_face_flux_gpu(i,j,k, &
      direction,face,dim,ntype,f)
    integer, value :: i,j,k,direction,face,dim,ntype
    real(real64), intent(out) :: f(air5_num_conservative)
    real(real64) :: fplus(air5_num_conservative,7)
    real(real64) :: fminus(air5_num_conservative,7)
    real(real64) :: unused(air5_num_conservative)
    real(real64) :: stencil_plus(7),stencil_minus(7)
    real(real64) :: alpha
    integer :: order,first_node,last_node,node,n,component

    order=7
    if((ntype==1 .or. ntype==4) .and. face==0) then
      order=1
    elseif((ntype==1 .or. ntype==4) .and. face==1) then
      order=3
    elseif((ntype==1 .or. ntype==4) .and. face==2) then
      order=5
    elseif((ntype==2 .or. ntype==4) .and. face==dim-1) then
      order=1
    elseif((ntype==2 .or. ntype==4) .and. face==dim-2) then
      order=3
    elseif((ntype==2 .or. ntype==4) .and. face==dim-3) then
      order=5
    endif
    select case(order)
    case(1); first_node=face;   last_node=face+1
    case(3); first_node=face-1; last_node=face+2
    case(5); first_node=face-2; last_node=face+3
    case default; first_node=face-3; last_node=face+4
    end select
    alpha=0.0_real64
    do node=first_node,last_node
      alpha=max(alpha,air5_frozen_spectral_radius_gpu(i,j,k,direction,node))
    enddo
    if(alpha<=0.0_real64) then
      call record_air5_status(chemistry_status_invalid_composition)
      f=0.0_real64
      return
    endif

    if(order==1) then
      call air5_llf_split_flux_gpu(i,j,k,direction,face,alpha,fplus(:,1),unused)
      call air5_llf_split_flux_gpu(i,j,k,direction,face+1,alpha,unused,fminus(:,1))
      f=fplus(:,1)+fminus(:,1)
    else
      do n=1,order
        select case(order)
        case(3)
          call air5_llf_split_flux_gpu(i,j,k,direction,face+n-2,alpha, &
            fplus(:,n),unused)
          call air5_llf_split_flux_gpu(i,j,k,direction,face+3-n,alpha, &
            unused,fminus(:,n))
        case(5)
          call air5_llf_split_flux_gpu(i,j,k,direction,face+n-3,alpha, &
            fplus(:,n),unused)
          call air5_llf_split_flux_gpu(i,j,k,direction,face+4-n,alpha, &
            unused,fminus(:,n))
        case default
          call air5_llf_split_flux_gpu(i,j,k,direction,face+n-4,alpha, &
            fplus(:,n),unused)
          call air5_llf_split_flux_gpu(i,j,k,direction,face+5-n,alpha, &
            unused,fminus(:,n))
        end select
      enddo
      do component=1,air5_num_conservative
        stencil_plus=fplus(component,:)
        stencil_minus=fminus(component,:)
        select case(order)
        case(3)
          f(component)=air5_suw3_gpu(stencil_plus)+air5_suw3_gpu(stencil_minus)
        case(5)
          f(component)=air5_mp5_gpu(stencil_plus)+air5_mp5_gpu(stencil_minus)
        case default
          f(component)=air5_mp7_gpu(stencil_plus)+air5_mp7_gpu(stencil_minus)
        end select
      enddo
    endif
    f(air5_idx_species_first)=f(air5_idx_density)- &
      sum(f(air5_idx_species_first+1:air5_idx_species_last))
  end subroutine air5_shock_convective_face_flux_gpu

  attributes(device) subroutine air5_high_order_convective_face_flux(i,j,k, &
      direction,face,dim,ntype,f)
    integer, value :: i,j,k,direction,face,dim,ntype
    real(real64), intent(out) :: f(air5_num_conservative)
    real(real64) :: fn(air5_num_conservative,0:5)
    real(real64) :: anchor(air5_num_conservative),d0(air5_num_conservative)
    real(real64) :: d1(air5_num_conservative),d2(air5_num_conservative)
    integer :: offset,species,component

    if((ntype==1 .or. ntype==4) .and. face<=1) then
      do offset=0,5
        call air5_convective_line_flux(i,j,k,direction,offset,fn(:,offset))
      enddo
      anchor=(37.0_real64*num1d60)*(fn(:,2)+fn(:,3))- &
        (2.0_real64/15.0_real64)*(fn(:,1)+fn(:,4))+num1d60*(fn(:,0)+fn(:,5))
      d0=-0.5_real64*fn(:,2)+2.0_real64*fn(:,1)-1.5_real64*fn(:,0)
      d1=0.5_real64*(fn(:,2)-fn(:,0))
      d2=num2d3*(fn(:,3)-fn(:,1))-num1d12*(fn(:,4)-fn(:,0))
      select case(face)
      case(1);  f=anchor-d2
      case(0);  f=anchor-d2-d1
      case(-1); f=anchor-d2-d1-d0
      end select
    elseif((ntype==2 .or. ntype==4) .and. face>=dim-2) then
      do offset=0,5
        call air5_convective_line_flux(i,j,k,direction,dim-5+offset,fn(:,offset))
      enddo
      anchor=(37.0_real64*num1d60)*(fn(:,2)+fn(:,3))- &
        (2.0_real64/15.0_real64)*(fn(:,1)+fn(:,4))+num1d60*(fn(:,0)+fn(:,5))
      d0=num2d3*(fn(:,4)-fn(:,2))-num1d12*(fn(:,5)-fn(:,1))
      d1=0.5_real64*(fn(:,5)-fn(:,3))
      d2=0.5_real64*fn(:,3)-2.0_real64*fn(:,4)+1.5_real64*fn(:,5)
      select case(face-(dim-3))
      case(1); f=anchor+d0
      case(2); f=anchor+d0+d1
      case(3); f=anchor+d0+d1+d2
      end select
    else
      call air5_centered_convective_face_flux(i,j,k,direction,face,f)
    endif
    f(air5_idx_species_first)=f(air5_idx_density)
    do species=2,air5_num_species
      component=air5_idx_species_first+species-1
      f(air5_idx_species_first)=f(air5_idx_species_first)-f(component)
    enddo
  end subroutine air5_high_order_convective_face_flux

  attributes(device) subroutine air5_selective_convective_face_flux_gpu(i,j,k, &
      direction,face,dim,ntype,im,jm,km,shock_capturing,f)
    integer, value :: i,j,k,direction,face,dim,ntype,im,jm,km,shock_capturing
    real(real64), intent(out) :: f(air5_num_conservative)

    if(shock_capturing/=0 .and. &
       air5_shock_interface_active_gpu(i,j,k,direction,face,dim,ntype)) then
      call air5_shock_convective_face_flux_gpu(i,j,k,direction,face,dim,ntype,f)
    else
      call air5_high_order_convective_face_flux(i,j,k,direction,face,dim,ntype,f)
    endif
  end subroutine air5_selective_convective_face_flux_gpu

  attributes(device) subroutine air5_low_order_convective_face_flux(i,j,k, &
      direction,face,f)
    integer, value :: i,j,k,direction,face
    real(real64), intent(out) :: f(air5_num_conservative)
    real(real64) :: fplus(air5_num_conservative),fminus(air5_num_conservative)
    real(real64) :: unused(air5_num_conservative),alpha
    integer :: species,component

    alpha=max(air5_frozen_spectral_radius_gpu(i,j,k,direction,face), &
      air5_frozen_spectral_radius_gpu(i,j,k,direction,face+1))
    if(alpha<=0.0_real64) then
      f=0.0_real64
      call record_air5_status(chemistry_status_invalid_composition)
      return
    endif
    call air5_llf_split_flux_gpu(i,j,k,direction,face,alpha,fplus,unused)
    call air5_llf_split_flux_gpu(i,j,k,direction,face+1,alpha,unused,fminus)
    f=fplus+fminus
    f(air5_idx_species_first)=f(air5_idx_density)
    do species=2,air5_num_species
      component=air5_idx_species_first+species-1
      f(air5_idx_species_first)=f(air5_idx_species_first)-f(component)
    enddo
  end subroutine air5_low_order_convective_face_flux

  attributes(device) subroutine air5_full_state_node_face_fluxes(i,j,k,im,jm,km, &
      npdci,npdcj,npdck,shock_capturing,high_left,high_right,low_left,low_right)
    integer, value :: i,j,k,im,jm,km,npdci,npdcj,npdck,shock_capturing
    real(real64), intent(out) :: high_left(air5_num_conservative,3)
    real(real64), intent(out) :: high_right(air5_num_conservative,3)
    real(real64), intent(out) :: low_left(air5_num_conservative,3)
    real(real64), intent(out) :: low_right(air5_num_conservative,3)
    integer :: direction,index,dim,ntype

    do direction=1,3
      select case(direction)
      case(1); index=i; dim=im; ntype=npdci
      case(2); index=j; dim=jm; ntype=npdcj
      case(3); index=k; dim=km; ntype=npdck
      end select
      call air5_selective_convective_face_flux_gpu(i,j,k,direction,index-1, &
        dim,ntype,im,jm,km,shock_capturing,high_left(:,direction))
      call air5_selective_convective_face_flux_gpu(i,j,k,direction,index, &
        dim,ntype,im,jm,km,shock_capturing,high_right(:,direction))
      call air5_low_order_convective_face_flux(i,j,k,direction,index-1, &
        low_left(:,direction))
      call air5_low_order_convective_face_flux(i,j,k,direction,index, &
        low_right(:,direction))
    enddo
  end subroutine air5_full_state_node_face_fluxes

  attributes(global) subroutine air5_full_state_convection_ratio_kernel(deltat,a,b,c, &
      rkstep,collect_diagnostics,im,jm,km,npdci,npdcj,npdck,is,ie,js,je,ks,ke, &
      shock_capturing)
    use commarray_gpu, only: q_d,qsave_d,jacob_d,diffusion_ratio_d
    real(real64), value :: deltat,a,b,c
    integer, value :: rkstep,collect_diagnostics,im,jm,km,npdci,npdcj,npdck
    integer, value :: is,ie,js,je,ks,ke,shock_capturing
    real(real64) :: high_left(air5_num_conservative,3)
    real(real64) :: high_right(air5_num_conservative,3)
    real(real64) :: low_left(air5_num_conservative,3)
    real(real64) :: low_right(air5_num_conservative,3)
    real(real64) :: low_rhs(air5_num_conservative),low_state(air5_num_conservative)
    real(real64) :: face_correction(air5_num_conservative)
    real(real64) :: low_species(air5_num_species)
    real(real64) :: pminus,base,origin,current,ratio,candidate_ratio,cdt
    real(real64) :: constraint_min_ratio(air5_limiter_constraint_count)
    real(real64) :: species_constraint_min_ratio(air5_num_species)
    real(real64) :: correction_left,correction_right
    integer :: id,ntot,i,j,k,species,component,direction,previous,ignored
    integer :: constraint,constraint_mask,node_constraint_mask
    integer :: face_species_mask,node_species_mask
    integer(int64) :: bits,ignored_bits

    id=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    ntot=(im+1)*(jm+1)*(km+1)
    if(id>=ntot) return
    i=mod(id,im+1); j=mod(id/(im+1),jm+1); k=id/((im+1)*(jm+1))
    if(i<is .or. i>ie .or. j<js .or. j>je .or. k<ks .or. k>ke) return
    call air5_full_state_node_face_fluxes(i,j,k,im,jm,km,npdci,npdcj,npdck, &
      shock_capturing,high_left,high_right,low_left,low_right)
    cdt=c*deltat
    low_rhs=0.0_real64
    do component=1,air5_num_conservative
      do direction=1,3
        low_rhs(component)=low_rhs(component)+low_left(component,direction)- &
          low_right(component,direction)
      enddo
      current=q_d(i,j,k,component)*jacob_d(i,j,k)
      if(rkstep==1) then
        origin=current
      else
        origin=qsave_d(i,j,k,component)
      endif
      low_state(component)=a*origin+b*current+cdt*low_rhs(component)
    enddo
    ratio=1.0_real64
    node_constraint_mask=0
    node_species_mask=0
    constraint_min_ratio=1.0_real64
    species_constraint_min_ratio=1.0_real64
    if(.not.air5_state_is_admissible_gpu(low_state)) then
      call record_air5_status(chemistry_status_invalid_composition)
      previous=atomicCAS(air5_diffusion_failure_claim_d,0,1)
      if(previous==0) then
        air5_diffusion_failure_location_d=(/i,j,k,air5_num_species+2/)
        do species=1,air5_num_species
          low_species(species)=low_state(air5_idx_species_first+species-1)
        enddo
        air5_diffusion_failure_values_d=(/low_state(air5_idx_density), &
          minval(low_species), &
          air5_vibrational_excess_gpu(low_state(air5_idx_ev),low_species), &
          air5_translational_margin_gpu(low_state),0.0_real64/)
      endif
    endif
    do species=1,air5_num_species
      component=air5_idx_species_first+species-1
      pminus=0.0_real64
      do direction=1,3
        correction_left=cdt*(high_left(component,direction)-low_left(component,direction))
        correction_right=-cdt*(high_right(component,direction)-low_right(component,direction))
        pminus=pminus+min(0.0_real64,correction_left)+min(0.0_real64,correction_right)
      enddo
      base=low_state(component)
      if(base<0.0_real64) then
        call record_air5_status(chemistry_status_invalid_composition)
        previous=atomicCAS(air5_diffusion_failure_claim_d,0,1)
        if(previous==0) then
          air5_diffusion_failure_location_d=(/i,j,k,species/)
          air5_diffusion_failure_values_d=(/base,pminus,0.0_real64,0.0_real64,0.0_real64/)
        endif
      elseif(pminus<0.0_real64) then
        candidate_ratio=air5_interior_ratio_gpu(base/(-pminus))
        ratio=min(ratio,candidate_ratio)
        if(collect_diagnostics/=0 .and. candidate_ratio<1.0_real64) then
          node_constraint_mask=ibset(node_constraint_mask, &
            air5_limiter_constraint_species-1)
          node_species_mask=ibset(node_species_mask,species-1)
          constraint_min_ratio(air5_limiter_constraint_species)=min( &
            constraint_min_ratio(air5_limiter_constraint_species),candidate_ratio)
          species_constraint_min_ratio(species)=min( &
            species_constraint_min_ratio(species),candidate_ratio)
        endif
      endif
    enddo
    pminus=0.0_real64
    do direction=1,3
      correction_left=high_left(air5_idx_ev,direction)-low_left(air5_idx_ev,direction)
      correction_right=high_right(air5_idx_ev,direction)-low_right(air5_idx_ev,direction)
      do species=1,air5_num_species
        component=air5_idx_species_first+species-1
        correction_left=correction_left-air5_vibrational_floor_energy_d(species)* &
          (high_left(component,direction)-low_left(component,direction))
        correction_right=correction_right-air5_vibrational_floor_energy_d(species)* &
          (high_right(component,direction)-low_right(component,direction))
      enddo
      correction_left=cdt*correction_left
      correction_right=-cdt*correction_right
      pminus=pminus+min(0.0_real64,correction_left)+min(0.0_real64,correction_right)
    enddo
    do species=1,air5_num_species
      low_species(species)=low_state(air5_idx_species_first+species-1)
    enddo
    base=air5_vibrational_excess_gpu(low_state(air5_idx_ev),low_species)
    if(base<0.0_real64) then
      call record_air5_status(chemistry_status_invalid_composition)
      previous=atomicCAS(air5_diffusion_failure_claim_d,0,1)
      if(previous==0) then
        air5_diffusion_failure_location_d=(/i,j,k,air5_num_species+1/)
        air5_diffusion_failure_values_d=(/base,pminus,0.0_real64,0.0_real64,0.0_real64/)
      endif
    elseif(pminus<0.0_real64) then
      candidate_ratio=air5_interior_ratio_gpu(base/(-pminus))
      ratio=min(ratio,candidate_ratio)
      if(collect_diagnostics/=0 .and. candidate_ratio<1.0_real64) then
        node_constraint_mask=ibset(node_constraint_mask, &
          air5_limiter_constraint_vibrational-1)
        constraint_min_ratio(air5_limiter_constraint_vibrational)=min( &
          constraint_min_ratio(air5_limiter_constraint_vibrational),candidate_ratio)
      endif
    endif
    do direction=1,3
      face_correction=cdt*(high_left(:,direction)-low_left(:,direction))
      candidate_ratio=air5_admissible_face_ratio_gpu(low_state,face_correction, &
        collect_diagnostics,constraint_mask,face_species_mask)
      ratio=min(ratio,candidate_ratio)
      if(collect_diagnostics/=0 .and. candidate_ratio<1.0_real64) then
        node_constraint_mask=ior(node_constraint_mask,constraint_mask)
        node_species_mask=ior(node_species_mask,face_species_mask)
        do constraint=1,air5_limiter_constraint_count
          if(btest(constraint_mask,constraint-1)) &
            constraint_min_ratio(constraint)=min(constraint_min_ratio(constraint), &
              candidate_ratio)
        enddo
        do species=1,air5_num_species
          if(btest(face_species_mask,species-1)) &
            species_constraint_min_ratio(species)=min( &
              species_constraint_min_ratio(species),candidate_ratio)
        enddo
      endif
      face_correction=-cdt*(high_right(:,direction)-low_right(:,direction))
      candidate_ratio=air5_admissible_face_ratio_gpu(low_state,face_correction, &
        collect_diagnostics,constraint_mask,face_species_mask)
      ratio=min(ratio,candidate_ratio)
      if(collect_diagnostics/=0 .and. candidate_ratio<1.0_real64) then
        node_constraint_mask=ior(node_constraint_mask,constraint_mask)
        node_species_mask=ior(node_species_mask,face_species_mask)
        do constraint=1,air5_limiter_constraint_count
          if(btest(constraint_mask,constraint-1)) &
            constraint_min_ratio(constraint)=min(constraint_min_ratio(constraint), &
              candidate_ratio)
        enddo
        do species=1,air5_num_species
          if(btest(face_species_mask,species-1)) &
            species_constraint_min_ratio(species)=min( &
              species_constraint_min_ratio(species),candidate_ratio)
        enddo
      endif
    enddo
    ratio=max(0.0_real64,min(1.0_real64,ratio))
    diffusion_ratio_d(i,j,k,1)=ratio
    if(collect_diagnostics/=0 .and. ratio<1.0_real64-1.0e-14_real64) then
      ignored=atomicAdd(air5_limited_points_d,1)
      bits=transfer(ratio,bits)
      ignored_bits=atomicMin(air5_minimum_ratio_bits_d,bits)
    endif
    if(collect_diagnostics/=0) then
      do constraint=1,air5_limiter_constraint_count
        if(.not.btest(node_constraint_mask,constraint-1)) cycle
        ignored=atomicAdd(air5_constraint_active_points_d(constraint),1)
        bits=transfer(constraint_min_ratio(constraint),bits)
        ignored_bits=atomicMin(air5_constraint_minimum_ratio_bits_d(constraint),bits)
      enddo
      do species=1,air5_num_species
        if(.not.btest(node_species_mask,species-1)) cycle
        ignored=atomicAdd(air5_species_constraint_active_points_d(species),1)
        bits=transfer(species_constraint_min_ratio(species),bits)
        ignored_bits=atomicMin( &
          air5_species_constraint_minimum_ratio_bits_d(species),bits)
      enddo
    endif
  end subroutine air5_full_state_convection_ratio_kernel

  attributes(global) subroutine air5_limit_full_state_convection_kernel(im,jm,km, &
      npdci,npdcj,npdck,is,ie,js,je,ks,ke,shock_capturing)
    use commarray_gpu, only: qrhs_d,diffusion_ratio_d
    integer, value :: im,jm,km,npdci,npdcj,npdck,is,ie,js,je,ks,ke,shock_capturing
    real(real64) :: high_left(air5_num_conservative,3)
    real(real64) :: high_right(air5_num_conservative,3)
    real(real64) :: low_left(air5_num_conservative,3)
    real(real64) :: low_right(air5_num_conservative,3)
    real(real64) :: theta_left,theta_right,rhs(air5_num_conservative)
    integer :: id,ntot,i,j,k,component,direction

    id=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    ntot=(im+1)*(jm+1)*(km+1)
    if(id>=ntot) return
    i=mod(id,im+1); j=mod(id/(im+1),jm+1); k=id/((im+1)*(jm+1))
    if(i<is .or. i>ie .or. j<js .or. j>je .or. k<ks .or. k>ke) return
    call air5_full_state_node_face_fluxes(i,j,k,im,jm,km,npdci,npdcj,npdck, &
      shock_capturing,high_left,high_right,low_left,low_right)
    rhs=0.0_real64
    do component=1,air5_num_conservative
      do direction=1,3
        select case(direction)
        case(1)
          theta_left=min(diffusion_ratio_d(i,j,k,1),diffusion_ratio_d(i-1,j,k,1))
          theta_right=min(diffusion_ratio_d(i,j,k,1),diffusion_ratio_d(i+1,j,k,1))
        case(2)
          theta_left=min(diffusion_ratio_d(i,j,k,1),diffusion_ratio_d(i,j-1,k,1))
          theta_right=min(diffusion_ratio_d(i,j,k,1),diffusion_ratio_d(i,j+1,k,1))
        case(3)
          theta_left=min(diffusion_ratio_d(i,j,k,1),diffusion_ratio_d(i,j,k-1,1))
          theta_right=min(diffusion_ratio_d(i,j,k,1),diffusion_ratio_d(i,j,k+1,1))
        end select
        rhs(component)=rhs(component)+low_left(component,direction)- &
          low_right(component,direction)+ &
          theta_left*(high_left(component,direction)-low_left(component,direction))- &
          theta_right*(high_right(component,direction)-low_right(component,direction))
      enddo
    enddo
    do component=1,air5_num_conservative
      qrhs_d(i,j,k,component)=rhs(component)
    enddo
  end subroutine air5_limit_full_state_convection_kernel

  attributes(global) subroutine air5_convective_rhs_x_kernel(im,jm,km,npdci, &
      is,ie,js,je,ks,ke)
    use commarray_gpu, only: qrhs_d
    integer, value :: im,jm,km,npdci,is,ie,js,je,ks,ke
    integer :: id,ntot,i,j,k,component
    real(real64) :: fp1(air5_num_conservative),fm1(air5_num_conservative)
    real(real64) :: fp2(air5_num_conservative),fm2(air5_num_conservative)
    real(real64) :: fp3(air5_num_conservative),fm3(air5_num_conservative)

    id=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    ntot=(im+1)*(jm+1)*(km+1)
    if(id>=ntot) return
    i=mod(id,im+1)
    j=mod(id/(im+1),jm+1)
    k=id/((im+1)*(jm+1))
    if(i<is .or. i>ie .or. j<js .or. j>je .or. k<ks .or. k>ke) return
    call air5_convective_flux_at(i+1,j,k,1,fp1)
    call air5_convective_flux_at(i-1,j,k,1,fm1)
    call air5_convective_flux_at(i+2,j,k,1,fp2)
    call air5_convective_flux_at(i-2,j,k,1,fm2)
    call air5_convective_flux_at(i+3,j,k,1,fp3)
    call air5_convective_flux_at(i-3,j,k,1,fm3)
    do component=1,air5_num_conservative
      qrhs_d(i,j,k,component)=qrhs_d(i,j,k,component)- &
        air5_deriv6_boundary(i,im,npdci,fm3(component),fm2(component), &
                    fm1(component),fp1(component),fp2(component),fp3(component))
    enddo
  end subroutine air5_convective_rhs_x_kernel

  attributes(global) subroutine air5_convective_rhs_y_kernel(im,jm,km,npdcj, &
      is,ie,js,je,ks,ke)
    use commarray_gpu, only: qrhs_d
    integer, value :: im,jm,km,npdcj,is,ie,js,je,ks,ke
    integer :: id,ntot,i,j,k,component
    real(real64) :: fp1(air5_num_conservative),fm1(air5_num_conservative)
    real(real64) :: fp2(air5_num_conservative),fm2(air5_num_conservative)
    real(real64) :: fp3(air5_num_conservative),fm3(air5_num_conservative)

    id=(blockIdx%x-1)*blockDim%x*blockDim%y+ &
      (threadIdx%y-1)*blockDim%x+threadIdx%x-1
    ntot=(im+1)*(jm+1)
    if(id>=ntot) return
    i=mod(id,im+1)
    j=id/(im+1)
    k=blockIdx%z-1
    if(i<is .or. i>ie .or. j<js .or. j>je .or. k<ks .or. k>ke) return
    call air5_convective_flux_at(i,j+1,k,2,fp1)
    call air5_convective_flux_at(i,j-1,k,2,fm1)
    call air5_convective_flux_at(i,j+2,k,2,fp2)
    call air5_convective_flux_at(i,j-2,k,2,fm2)
    call air5_convective_flux_at(i,j+3,k,2,fp3)
    call air5_convective_flux_at(i,j-3,k,2,fm3)
    do component=1,air5_num_conservative
      qrhs_d(i,j,k,component)=qrhs_d(i,j,k,component)- &
        air5_deriv6_boundary(j,jm,npdcj,fm3(component),fm2(component), &
                    fm1(component),fp1(component),fp2(component),fp3(component))
    enddo
  end subroutine air5_convective_rhs_y_kernel

  attributes(global) subroutine air5_convective_rhs_z_kernel(im,jm,km,npdck, &
      is,ie,js,je,ks,ke)
    use commarray_gpu, only: qrhs_d
    integer, value :: im,jm,km,npdck,is,ie,js,je,ks,ke
    integer :: id,ntot,i,j,k,component
    real(real64) :: fp1(air5_num_conservative),fm1(air5_num_conservative)
    real(real64) :: fp2(air5_num_conservative),fm2(air5_num_conservative)
    real(real64) :: fp3(air5_num_conservative),fm3(air5_num_conservative)

    id=(blockIdx%x-1)*blockDim%x*blockDim%z+ &
      (threadIdx%z-1)*blockDim%x+threadIdx%x-1
    ntot=(im+1)*(km+1)
    if(id>=ntot) return
    i=mod(id,im+1)
    j=blockIdx%y-1
    k=id/(im+1)
    if(i<is .or. i>ie .or. j<js .or. j>je .or. k<ks .or. k>ke) return
    call air5_convective_flux_at(i,j,k+1,3,fp1)
    call air5_convective_flux_at(i,j,k-1,3,fm1)
    call air5_convective_flux_at(i,j,k+2,3,fp2)
    call air5_convective_flux_at(i,j,k-2,3,fm2)
    call air5_convective_flux_at(i,j,k+3,3,fp3)
    call air5_convective_flux_at(i,j,k-3,3,fm3)
    do component=1,air5_num_conservative
      qrhs_d(i,j,k,component)=qrhs_d(i,j,k,component)- &
        air5_deriv6_boundary(k,km,npdck,fm3(component),fm2(component), &
                    fm1(component),fp1(component),fp2(component),fp3(component))
    enddo
  end subroutine air5_convective_rhs_z_kernel

  attributes(global) subroutine air5_selective_convective_rhs_x_kernel( &
      im,jm,km,npdci,is,ie,js,je,ks,ke)
    use commarray_gpu, only: qrhs_d
    integer, value :: im,jm,km,npdci,is,ie,js,je,ks,ke
    integer :: id,ntot,i,j,k,component
    real(real64) :: left_flux(air5_num_conservative)
    real(real64) :: right_flux(air5_num_conservative)

    id=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    ntot=(im+1)*(jm+1)*(km+1)
    if(id>=ntot) return
    i=mod(id,im+1); j=mod(id/(im+1),jm+1); k=id/((im+1)*(jm+1))
    if(i<is .or. i>ie .or. j<js .or. j>je .or. k<ks .or. k>ke) return
    call air5_selective_convective_face_flux_gpu(i,j,k,1,i-1,im,npdci, &
      im,jm,km,1,left_flux)
    call air5_selective_convective_face_flux_gpu(i,j,k,1,i,im,npdci, &
      im,jm,km,1,right_flux)
    do component=1,air5_num_conservative
      qrhs_d(i,j,k,component)=qrhs_d(i,j,k,component)+ &
        left_flux(component)-right_flux(component)
    enddo
  end subroutine air5_selective_convective_rhs_x_kernel

  attributes(global) subroutine air5_selective_convective_rhs_y_kernel( &
      im,jm,km,npdcj,is,ie,js,je,ks,ke)
    use commarray_gpu, only: qrhs_d
    integer, value :: im,jm,km,npdcj,is,ie,js,je,ks,ke
    integer :: id,ntot,i,j,k,component
    real(real64) :: left_flux(air5_num_conservative)
    real(real64) :: right_flux(air5_num_conservative)

    id=(blockIdx%x-1)*blockDim%x*blockDim%y+ &
      (threadIdx%y-1)*blockDim%x+threadIdx%x-1
    ntot=(im+1)*(jm+1)
    if(id>=ntot) return
    i=mod(id,im+1); j=id/(im+1); k=blockIdx%z-1
    if(i<is .or. i>ie .or. j<js .or. j>je .or. k<ks .or. k>ke) return
    call air5_selective_convective_face_flux_gpu(i,j,k,2,j-1,jm,npdcj, &
      im,jm,km,1,left_flux)
    call air5_selective_convective_face_flux_gpu(i,j,k,2,j,jm,npdcj, &
      im,jm,km,1,right_flux)
    do component=1,air5_num_conservative
      qrhs_d(i,j,k,component)=qrhs_d(i,j,k,component)+ &
        left_flux(component)-right_flux(component)
    enddo
  end subroutine air5_selective_convective_rhs_y_kernel

  attributes(global) subroutine air5_selective_convective_rhs_z_kernel( &
      im,jm,km,npdck,is,ie,js,je,ks,ke)
    use commarray_gpu, only: qrhs_d
    integer, value :: im,jm,km,npdck,is,ie,js,je,ks,ke
    integer :: id,ntot,i,j,k,component
    real(real64) :: left_flux(air5_num_conservative)
    real(real64) :: right_flux(air5_num_conservative)

    id=(blockIdx%x-1)*blockDim%x*blockDim%z+ &
      (threadIdx%z-1)*blockDim%x+threadIdx%x-1
    ntot=(im+1)*(km+1)
    if(id>=ntot) return
    i=mod(id,im+1); j=blockIdx%y-1; k=id/(im+1)
    if(i<is .or. i>ie .or. j<js .or. j>je .or. k<ks .or. k>ke) return
    call air5_selective_convective_face_flux_gpu(i,j,k,3,k-1,km,npdck, &
      im,jm,km,1,left_flux)
    call air5_selective_convective_face_flux_gpu(i,j,k,3,k,km,npdck, &
      im,jm,km,1,right_flux)
    do component=1,air5_num_conservative
      qrhs_d(i,j,k,component)=qrhs_d(i,j,k,component)+ &
        left_flux(component)-right_flux(component)
    enddo
  end subroutine air5_selective_convective_rhs_z_kernel

  attributes(global) subroutine air5_species_tv_gradient_kernel(im,jm,km,npdci,npdcj,npdck, &
      zero_species_flux_lower_y)
    use commarray_gpu, only: spc_d,tve_d,dxi_d,dspc_d,dtve_d
    integer, value :: im,jm,km,npdci,npdcj,npdck,zero_species_flux_lower_y
    integer :: i,j,k,species,physical_direction
    real(real64) :: derivative_species(3),derivative_tv(3)

    i=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    j=(blockIdx%y-1)*blockDim%y+threadIdx%y-1
    k=(blockIdx%z-1)*blockDim%z+threadIdx%z-1
    if(i>im .or. j>jm .or. k>km) return
    derivative_tv(1)=air5_deriv6_full_boundary(i,im,npdci,tve_d(i,j,k), &
      tve_d(i-3,j,k),tve_d(i-2,j,k),tve_d(i-1,j,k),tve_d(i+1,j,k), &
      tve_d(i+2,j,k),tve_d(i+3,j,k))
    derivative_tv(2)=air5_deriv6_full_boundary(j,jm,npdcj,tve_d(i,j,k), &
      tve_d(i,j-3,k),tve_d(i,j-2,k),tve_d(i,j-1,k),tve_d(i,j+1,k), &
      tve_d(i,j+2,k),tve_d(i,j+3,k))
    derivative_tv(3)=air5_deriv6_full_boundary(k,km,npdck,tve_d(i,j,k), &
      tve_d(i,j,k-3),tve_d(i,j,k-2),tve_d(i,j,k-1),tve_d(i,j,k+1), &
      tve_d(i,j,k+2),tve_d(i,j,k+3))
    do physical_direction=1,3
      dtve_d(i,j,k,physical_direction)=sum(derivative_tv* &
        dxi_d(i,j,k,1:3,physical_direction))
    enddo
    do species=1,air5_num_species
      derivative_species(1)=air5_deriv6_full_boundary(i,im,npdci, &
        spc_d(i,j,k,species),spc_d(i-3,j,k,species),spc_d(i-2,j,k,species), &
        spc_d(i-1,j,k,species),spc_d(i+1,j,k,species),spc_d(i+2,j,k,species), &
        spc_d(i+3,j,k,species))
      derivative_species(2)=air5_deriv6_full_boundary(j,jm,npdcj, &
        spc_d(i,j,k,species),spc_d(i,j-3,k,species),spc_d(i,j-2,k,species), &
        spc_d(i,j-1,k,species),spc_d(i,j+1,k,species),spc_d(i,j+2,k,species), &
        spc_d(i,j+3,k,species))
      derivative_species(3)=air5_deriv6_full_boundary(k,km,npdck, &
        spc_d(i,j,k,species),spc_d(i,j,k-3,species),spc_d(i,j,k-2,species), &
        spc_d(i,j,k-1,species),spc_d(i,j,k+1,species),spc_d(i,j,k+2,species), &
        spc_d(i,j,k+3,species))
      do physical_direction=1,3
        dspc_d(i,j,k,species,physical_direction)=sum(derivative_species* &
          dxi_d(i,j,k,1:3,physical_direction))
      enddo
      if(zero_species_flux_lower_y/=0 .and. j==0) &
        dspc_d(i,j,k,species,2)=0.0_real64
    enddo
  end subroutine air5_species_tv_gradient_kernel

  attributes(global) subroutine air5_diffusion_flux_kernel(im,jm,km)
    use commarray_gpu, only: rho_d,vel_d,tmp_d,tve_d,prs_d,spc_d,dvel_d, &
      dtmp_d,dspc_d,dtve_d,sigma_d,qflux_d,species_flux_d,ev_flux_d
    integer, value :: im,jm,km
    integer :: i,j,k,status
    real(real64) :: velocity(3),mass_fraction(air5_num_species)
    real(real64) :: grad_velocity(3,3),grad_temperature(3),grad_tv(3)
    real(real64) :: grad_mass_fraction(air5_num_species,3)
    real(real64) :: momentum_flux(3,3),species_flux(air5_num_species,3)
    real(real64) :: energy_flux(3),ev_flux(3)

    i=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    j=(blockIdx%y-1)*blockDim%y+threadIdx%y-1
    k=(blockIdx%z-1)*blockDim%z+threadIdx%z-1
    if(i>im .or. j>jm .or. k>km) return
    velocity=vel_d(i,j,k,:)
    mass_fraction=spc_d(i,j,k,:)
    grad_velocity=dvel_d(i,j,k,:,:)
    grad_temperature=dtmp_d(i,j,k,:)
    grad_tv=dtve_d(i,j,k,:)
    grad_mass_fraction=dspc_d(i,j,k,:,:)
    call air5_diffusive_flux_gpu(rho_d(i,j,k),velocity,tmp_d(i,j,k), &
      tve_d(i,j,k),prs_d(i,j,k),mass_fraction,grad_velocity, &
      grad_temperature,grad_tv,grad_mass_fraction,momentum_flux, &
      species_flux,energy_flux,ev_flux,status)
    if(status/=chemistry_status_ok) then
      call record_air5_status(status)
      return
    endif
    sigma_d(i,j,k,1)=momentum_flux(1,1)
    sigma_d(i,j,k,2)=momentum_flux(1,2)
    sigma_d(i,j,k,3)=momentum_flux(1,3)
    sigma_d(i,j,k,4)=momentum_flux(2,2)
    sigma_d(i,j,k,5)=momentum_flux(2,3)
    sigma_d(i,j,k,6)=momentum_flux(3,3)
    qflux_d(i,j,k,:)=energy_flux
    species_flux_d(i,j,k,:,:)=species_flux
    ev_flux_d(i,j,k,:)=ev_flux
  end subroutine air5_diffusion_flux_kernel

  attributes(device) subroutine air5_diffusive_flux_at(i,j,k,idir,f)
    use commarray_gpu, only: sigma_d,qflux_d,species_flux_d,ev_flux_d,dxi_d,jacob_d
    integer, value :: i,j,k,idir
    real(real64), intent(out) :: f(air5_num_conservative)
    real(real64) :: metric(3),metric_jacobian
    integer :: species

    f=0.0_real64
    metric=dxi_d(i,j,k,idir,:)
    metric_jacobian=jacob_d(i,j,k)
    f(2)=metric_jacobian*dot_product([sigma_d(i,j,k,1),sigma_d(i,j,k,2), &
      sigma_d(i,j,k,3)],metric)
    f(3)=metric_jacobian*dot_product([sigma_d(i,j,k,2),sigma_d(i,j,k,4), &
      sigma_d(i,j,k,5)],metric)
    f(4)=metric_jacobian*dot_product([sigma_d(i,j,k,3),sigma_d(i,j,k,5), &
      sigma_d(i,j,k,6)],metric)
    f(air5_idx_total_energy)=metric_jacobian*dot_product(qflux_d(i,j,k,:),metric)
    do species=1,air5_num_species
      f(air5_idx_species_first+species-1)=metric_jacobian* &
        dot_product(species_flux_d(i,j,k,species,:),metric)
    enddo
    f(air5_idx_ev)=metric_jacobian*dot_product(ev_flux_d(i,j,k,:),metric)
  end subroutine air5_diffusive_flux_at

  attributes(device) subroutine air5_diffusive_line_flux_at(i,j,k,direction,index,f)
    integer, value :: i,j,k,direction,index
    real(real64), intent(out) :: f(air5_num_conservative)

    select case(direction)
    case(1)
      call air5_diffusive_flux_at(index,j,k,direction,f)
    case(2)
      call air5_diffusive_flux_at(i,index,k,direction,f)
    case default
      call air5_diffusive_flux_at(i,j,index,direction,f)
    end select
  end subroutine air5_diffusive_line_flux_at

  attributes(device) subroutine air5_centered_diffusive_face_flux(i,j,k,direction,face,f)
    integer, value :: i,j,k,direction,face
    real(real64), intent(out) :: f(air5_num_conservative)
    real(real64) :: fm2(air5_num_conservative),fm1(air5_num_conservative)
    real(real64) :: f0(air5_num_conservative),fp1(air5_num_conservative)
    real(real64) :: fp2(air5_num_conservative),fp3(air5_num_conservative)

    call air5_diffusive_line_flux_at(i,j,k,direction,face-2,fm2)
    call air5_diffusive_line_flux_at(i,j,k,direction,face-1,fm1)
    call air5_diffusive_line_flux_at(i,j,k,direction,face,f0)
    call air5_diffusive_line_flux_at(i,j,k,direction,face+1,fp1)
    call air5_diffusive_line_flux_at(i,j,k,direction,face+2,fp2)
    call air5_diffusive_line_flux_at(i,j,k,direction,face+3,fp3)
    f=(37.0_real64*num1d60)*(f0+fp1)-(2.0_real64/15.0_real64)*(fm1+fp2)+ &
      num1d60*(fm2+fp3)
  end subroutine air5_centered_diffusive_face_flux

  attributes(device) subroutine air5_diffusive_face_flux(i,j,k,direction,face,dim,ntype,f)
    integer, value :: i,j,k,direction,face,dim,ntype
    real(real64), intent(out) :: f(air5_num_conservative)
    real(real64) :: fn(air5_num_conservative,0:5)
    real(real64) :: anchor(air5_num_conservative),d0(air5_num_conservative)
    real(real64) :: d1(air5_num_conservative),d2(air5_num_conservative)
    integer :: offset

    if((ntype==1 .or. ntype==4) .and. face<=1) then
      do offset=0,5
        call air5_diffusive_line_flux_at(i,j,k,direction,offset,fn(:,offset))
      enddo
      anchor=(37.0_real64*num1d60)*(fn(:,2)+fn(:,3))- &
        (2.0_real64/15.0_real64)*(fn(:,1)+fn(:,4))+ &
        num1d60*(fn(:,0)+fn(:,5))
      d0=-0.5_real64*fn(:,2)+2.0_real64*fn(:,1)-1.5_real64*fn(:,0)
      d1=0.5_real64*(fn(:,2)-fn(:,0))
      d2=num2d3*(fn(:,3)-fn(:,1))-num1d12*(fn(:,4)-fn(:,0))
      select case(face)
      case(1)
        f=anchor-d2
      case(0)
        f=anchor-d2-d1
      case default
        f=anchor-d2-d1-d0
      end select
    elseif((ntype==2 .or. ntype==4) .and. face>=dim-2) then
      do offset=0,5
        call air5_diffusive_line_flux_at(i,j,k,direction,dim-5+offset,fn(:,offset))
      enddo
      anchor=(37.0_real64*num1d60)*(fn(:,2)+fn(:,3))- &
        (2.0_real64/15.0_real64)*(fn(:,1)+fn(:,4))+ &
        num1d60*(fn(:,0)+fn(:,5))
      d0=num2d3*(fn(:,4)-fn(:,2))-num1d12*(fn(:,5)-fn(:,1))
      d1=0.5_real64*(fn(:,5)-fn(:,3))
      d2=0.5_real64*fn(:,3)-2.0_real64*fn(:,4)+1.5_real64*fn(:,5)
      select case(face-(dim-3))
      case(1)
        f=anchor+d0
      case(2)
        f=anchor+d0+d1
      case default
        f=anchor+d0+d1+d2
      end select
    else
      call air5_centered_diffusive_face_flux(i,j,k,direction,face,f)
    endif
  end subroutine air5_diffusive_face_flux

  attributes(device) subroutine air5_diffusive_node_faces(i,j,k,im,jm,km, &
      npdci,npdcj,npdck,left_flux,right_flux)
    integer, value :: i,j,k,im,jm,km,npdci,npdcj,npdck
    real(real64), intent(out) :: left_flux(air5_num_conservative,3)
    real(real64), intent(out) :: right_flux(air5_num_conservative,3)

    call air5_diffusive_face_flux(i,j,k,1,i-1,im,npdci,left_flux(:,1))
    call air5_diffusive_face_flux(i,j,k,1,i,im,npdci,right_flux(:,1))
    call air5_diffusive_face_flux(i,j,k,2,j-1,jm,npdcj,left_flux(:,2))
    call air5_diffusive_face_flux(i,j,k,2,j,jm,npdcj,right_flux(:,2))
    call air5_diffusive_face_flux(i,j,k,3,k-1,km,npdck,left_flux(:,3))
    call air5_diffusive_face_flux(i,j,k,3,k,km,npdck,right_flux(:,3))
  end subroutine air5_diffusive_node_faces

  attributes(global) subroutine air5_reset_diffusion_ratio_kernel(im,jm,km,hm)
    use commarray_gpu, only: diffusion_ratio_d
    integer, value :: im,jm,km,hm
    integer :: id,ni,nj,ntot,i,j,k

    id=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    ni=im+2*hm+1
    nj=jm+2*hm+1
    ntot=ni*nj*(km+2*hm+1)
    if(id>=ntot) return
    i=mod(id,ni)-hm
    j=mod(id/ni,nj)-hm
    k=id/(ni*nj)-hm
    diffusion_ratio_d(i,j,k,1)=1.0_real64
  end subroutine air5_reset_diffusion_ratio_kernel

  attributes(global) subroutine air5_diffusion_ratio_kernel(deltat,a,b,c,rkstep, &
      collect_diagnostics,im,jm,km,npdci,npdcj,npdck,is,ie,js,je,ks,ke)
    use commarray_gpu, only: q_d,qsave_d,qrhs_d,jacob_d,diffusion_ratio_d
    real(real64), value :: deltat,a,b,c
    integer, value :: rkstep,collect_diagnostics,im,jm,km,npdci,npdcj,npdck
    integer, value :: is,ie,js,je,ks,ke
    real(real64) :: left_flux(air5_num_conservative,3)
    real(real64) :: right_flux(air5_num_conservative,3)
    real(real64) :: base_state(air5_num_conservative)
    real(real64) :: face_correction(air5_num_conservative)
    real(real64) :: pminus,base,origin,ratio,cdt
    real(real64) :: left_excess_flux,right_excess_flux
    real(real64) :: origin_excess,current_excess,rhs_excess
    real(real64) :: current_species(air5_num_species)
    real(real64) :: origin_species(air5_num_species)
    integer :: id,ntot,i,j,k,species,component,direction,ignored,previous
    integer :: constraint_mask,species_mask
    integer(int64) :: bits,ignored_bits

    id=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    ntot=(im+1)*(jm+1)*(km+1)
    if(id>=ntot) return
    i=mod(id,im+1); j=mod(id/(im+1),jm+1); k=id/((im+1)*(jm+1))
    if(i<is .or. i>ie .or. j<js .or. j>je .or. k<ks .or. k>ke) return
    call air5_diffusive_node_faces(i,j,k,im,jm,km,npdci,npdcj,npdck, &
      left_flux,right_flux)
    cdt=c*deltat
    do component=1,air5_num_conservative
      if(rkstep==1) then
        origin=q_d(i,j,k,component)*jacob_d(i,j,k)
      else
        origin=qsave_d(i,j,k,component)
      endif
      base_state(component)=a*origin+b*q_d(i,j,k,component)*jacob_d(i,j,k)+ &
        cdt*qrhs_d(i,j,k,component)
    enddo
    ratio=1.0_real64
    if(.not.air5_state_is_admissible_gpu(base_state)) then
      call record_air5_status(chemistry_status_invalid_composition)
      previous=atomicCAS(air5_diffusion_failure_claim_d,0,1)
      if(previous==0) then
        air5_diffusion_failure_location_d=(/i,j,k,air5_num_species+2/)
        air5_diffusion_failure_values_d=(/base_state(air5_idx_density), &
          air5_translational_margin_gpu(base_state),0.0_real64,0.0_real64,0.0_real64/)
      endif
    endif
    do species=1,air5_num_species
      component=air5_idx_species_first+species-1
      pminus=0.0_real64
      do direction=1,3
        pminus=pminus+min(0.0_real64,cdt*left_flux(component,direction))+ &
          min(0.0_real64,-cdt*right_flux(component,direction))
      enddo
      if(rkstep==1) then
        origin=q_d(i,j,k,component)*jacob_d(i,j,k)
      else
        origin=qsave_d(i,j,k,component)
      endif
      base=a*origin+b*q_d(i,j,k,component)*jacob_d(i,j,k)+ &
        cdt*qrhs_d(i,j,k,component)
      if(base<0.0_real64) then
        call record_air5_status(chemistry_status_invalid_composition)
        previous=atomicCAS(air5_diffusion_failure_claim_d,0,1)
        if(previous==0) then
          air5_diffusion_failure_location_d=(/i,j,k,species/)
          air5_diffusion_failure_values_d=(/origin, &
            q_d(i,j,k,component)*jacob_d(i,j,k),cdt*qrhs_d(i,j,k,component), &
            base,pminus/)
        endif
      elseif(pminus<0.0_real64) then
        ratio=min(ratio,air5_interior_ratio_gpu(base/(-pminus)))
      endif
    enddo
    pminus=0.0_real64
    do direction=1,3
      left_excess_flux=left_flux(air5_idx_ev,direction)
      right_excess_flux=right_flux(air5_idx_ev,direction)
      do species=1,air5_num_species
        component=air5_idx_species_first+species-1
        left_excess_flux=left_excess_flux+ &
          air5_vibrational_floor_energy_d(species)*left_flux(component,direction)
        right_excess_flux=right_excess_flux+ &
          air5_vibrational_floor_energy_d(species)*right_flux(component,direction)
      enddo
      pminus=pminus+min(0.0_real64,-cdt*left_excess_flux)+ &
        min(0.0_real64,cdt*right_excess_flux)
    enddo
    do species=1,air5_num_species
      component=air5_idx_species_first+species-1
      current_species(species)=q_d(i,j,k,component)
    enddo
    current_excess=air5_vibrational_excess_gpu(q_d(i,j,k,air5_idx_ev), &
      current_species)*jacob_d(i,j,k)
    if(rkstep==1) then
      origin_excess=current_excess
    else
      do species=1,air5_num_species
        component=air5_idx_species_first+species-1
        origin_species(species)=qsave_d(i,j,k,component)
      enddo
      origin_excess=air5_vibrational_excess_gpu(qsave_d(i,j,k,air5_idx_ev), &
        origin_species)
    endif
    rhs_excess=qrhs_d(i,j,k,air5_idx_ev)
    do species=1,air5_num_species
      component=air5_idx_species_first+species-1
      rhs_excess=rhs_excess- &
        air5_vibrational_floor_energy_d(species)*qrhs_d(i,j,k,component)
    enddo
    base=a*origin_excess+b*current_excess+cdt*rhs_excess
    if(base<0.0_real64) then
      call record_air5_status(chemistry_status_invalid_composition)
      previous=atomicCAS(air5_diffusion_failure_claim_d,0,1)
      if(previous==0) then
        air5_diffusion_failure_location_d=(/i,j,k,air5_num_species+1/)
        air5_diffusion_failure_values_d=(/origin_excess,current_excess, &
          cdt*rhs_excess,base,pminus/)
      endif
    elseif(pminus<0.0_real64) then
      ratio=min(ratio,air5_interior_ratio_gpu(base/(-pminus)))
    endif
    do direction=1,3
      face_correction=0.0_real64
      do component=2,air5_num_conservative
        face_correction(component)=-cdt*air5_diffusion_rhs_sign(component)* &
          left_flux(component,direction)
      enddo
      ratio=min(ratio,air5_admissible_face_ratio_gpu(base_state,face_correction, &
        0,constraint_mask,species_mask))
      face_correction=0.0_real64
      do component=2,air5_num_conservative
        face_correction(component)=cdt*air5_diffusion_rhs_sign(component)* &
          right_flux(component,direction)
      enddo
      ratio=min(ratio,air5_admissible_face_ratio_gpu(base_state,face_correction, &
        0,constraint_mask,species_mask))
    enddo
    ratio=max(0.0_real64,min(1.0_real64,ratio))
    diffusion_ratio_d(i,j,k,1)=ratio
    if(collect_diagnostics/=0 .and. ratio<1.0_real64-1.0e-14_real64) then
      ignored=atomicAdd(air5_limited_points_d,1)
      bits=transfer(ratio,bits)
      ignored_bits=atomicMin(air5_minimum_ratio_bits_d,bits)
    endif
  end subroutine air5_diffusion_ratio_kernel

  attributes(global) subroutine air5_diffusion_rhs_x_kernel(im,jm,km,npdci,is,ie,js,je,ks,ke)
    use commarray_gpu, only: qrhs_d,diffusion_ratio_d
    integer, value :: im,jm,km,npdci,is,ie,js,je,ks,ke
    integer :: id,ntot,i,j,k,component
    real(real64) :: left_flux(air5_num_conservative),right_flux(air5_num_conservative)
    real(real64) :: theta_left,theta_right

    id=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    ntot=(im+1)*(jm+1)*(km+1)
    if(id>=ntot) return
    i=mod(id,im+1); j=mod(id/(im+1),jm+1); k=id/((im+1)*(jm+1))
    if(i<is .or. i>ie .or. j<js .or. j>je .or. k<ks .or. k>ke) return
    call air5_diffusive_face_flux(i,j,k,1,i-1,im,npdci,left_flux)
    call air5_diffusive_face_flux(i,j,k,1,i,im,npdci,right_flux)
    theta_left=min(diffusion_ratio_d(i,j,k,1),diffusion_ratio_d(i-1,j,k,1))
    theta_right=min(diffusion_ratio_d(i,j,k,1),diffusion_ratio_d(i+1,j,k,1))
    do component=2,air5_num_conservative
      qrhs_d(i,j,k,component)=qrhs_d(i,j,k,component)+ &
        air5_diffusion_rhs_sign(component)*(theta_right*right_flux(component)- &
        theta_left*left_flux(component))
    enddo
  end subroutine air5_diffusion_rhs_x_kernel

  attributes(global) subroutine air5_diffusion_rhs_y_kernel(im,jm,km,npdcj,is,ie,js,je,ks,ke)
    use commarray_gpu, only: qrhs_d,diffusion_ratio_d
    integer, value :: im,jm,km,npdcj,is,ie,js,je,ks,ke
    integer :: id,ntot,i,j,k,component
    real(real64) :: left_flux(air5_num_conservative),right_flux(air5_num_conservative)
    real(real64) :: theta_left,theta_right

    id=(blockIdx%x-1)*blockDim%x*blockDim%y+ &
      (threadIdx%y-1)*blockDim%x+threadIdx%x-1
    ntot=(im+1)*(jm+1)
    if(id>=ntot) return
    i=mod(id,im+1); j=id/(im+1); k=blockIdx%z-1
    if(i<is .or. i>ie .or. j<js .or. j>je .or. k<ks .or. k>ke) return
    call air5_diffusive_face_flux(i,j,k,2,j-1,jm,npdcj,left_flux)
    call air5_diffusive_face_flux(i,j,k,2,j,jm,npdcj,right_flux)
    theta_left=min(diffusion_ratio_d(i,j,k,1),diffusion_ratio_d(i,j-1,k,1))
    theta_right=min(diffusion_ratio_d(i,j,k,1),diffusion_ratio_d(i,j+1,k,1))
    do component=2,air5_num_conservative
      qrhs_d(i,j,k,component)=qrhs_d(i,j,k,component)+ &
        air5_diffusion_rhs_sign(component)*(theta_right*right_flux(component)- &
        theta_left*left_flux(component))
    enddo
  end subroutine air5_diffusion_rhs_y_kernel

  attributes(global) subroutine air5_diffusion_rhs_z_kernel(im,jm,km,npdck,is,ie,js,je,ks,ke)
    use commarray_gpu, only: qrhs_d,diffusion_ratio_d
    integer, value :: im,jm,km,npdck,is,ie,js,je,ks,ke
    integer :: id,ntot,i,j,k,component
    real(real64) :: left_flux(air5_num_conservative),right_flux(air5_num_conservative)
    real(real64) :: theta_left,theta_right

    id=(blockIdx%x-1)*blockDim%x*blockDim%z+ &
      (threadIdx%z-1)*blockDim%x+threadIdx%x-1
    ntot=(im+1)*(km+1)
    if(id>=ntot) return
    i=mod(id,im+1); j=blockIdx%y-1; k=id/(im+1)
    if(i<is .or. i>ie .or. j<js .or. j>je .or. k<ks .or. k>ke) return
    call air5_diffusive_face_flux(i,j,k,3,k-1,km,npdck,left_flux)
    call air5_diffusive_face_flux(i,j,k,3,k,km,npdck,right_flux)
    theta_left=min(diffusion_ratio_d(i,j,k,1),diffusion_ratio_d(i,j,k-1,1))
    theta_right=min(diffusion_ratio_d(i,j,k,1),diffusion_ratio_d(i,j,k+1,1))
    do component=2,air5_num_conservative
      qrhs_d(i,j,k,component)=qrhs_d(i,j,k,component)+ &
        air5_diffusion_rhs_sign(component)*(theta_right*right_flux(component)- &
        theta_left*left_flux(component))
    enddo
  end subroutine air5_diffusion_rhs_z_kernel

  attributes(global) subroutine air5_rk3_first_update_kernel(deltat,im,jm,km, &
      is,ie,js,je,ks,ke)
    use commarray_gpu, only: q_d,qsave_d,qrhs_d,jacob_d
    real(real64), value :: deltat
    integer, value :: im,jm,km,is,ie,js,je,ks,ke
    integer :: id,ntot,i,j,k,component
    real(real64) :: saved

    id=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    ntot=(im+1)*(jm+1)*(km+1)
    if(id>=ntot) return
    i=mod(id,im+1); j=mod(id/(im+1),jm+1); k=id/((im+1)*(jm+1))
    if(i<is .or. i>ie .or. j<js .or. j>je .or. k<ks .or. k>ke) return
    do component=1,air5_num_conservative
      saved=q_d(i,j,k,component)*jacob_d(i,j,k)
      qsave_d(i,j,k,component)=saved
      q_d(i,j,k,component)=(saved+deltat*qrhs_d(i,j,k,component))/jacob_d(i,j,k)
    enddo
  end subroutine air5_rk3_first_update_kernel

  attributes(global) subroutine air5_rk3_update_kernel(deltat,a,b,c,im,jm,km, &
      is,ie,js,je,ks,ke)
    use commarray_gpu, only: q_d,qsave_d,qrhs_d,jacob_d
    real(real64), value :: deltat,a,b,c
    integer, value :: im,jm,km,is,ie,js,je,ks,ke
    integer :: id,ntot,i,j,k,component

    id=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    ntot=(im+1)*(jm+1)*(km+1)
    if(id>=ntot) return
    i=mod(id,im+1); j=mod(id/(im+1),jm+1); k=id/((im+1)*(jm+1))
    if(i<is .or. i>ie .or. j<js .or. j>je .or. k<ks .or. k>ke) return
    do component=1,air5_num_conservative
      q_d(i,j,k,component)=(a*qsave_d(i,j,k,component)+ &
        b*q_d(i,j,k,component)*jacob_d(i,j,k)+ &
        c*deltat*qrhs_d(i,j,k,component))/jacob_d(i,j,k)
    enddo
  end subroutine air5_rk3_update_kernel

  subroutine reset_air5_status()
    air5_flow_status_d=chemistry_status_ok
  end subroutine reset_air5_status

  subroutine check_air5_status(label)
    use mpi
    character(len=*), intent(in) :: label
    integer :: local_status,global_status,ierr

    local_status=air5_flow_status_d
    call mpi_allreduce(local_status,global_status,1,MPI_INTEGER,MPI_MAX,MPI_COMM_WORLD,ierr)
    if(ierr/=MPI_SUCCESS) call mpi_abort(MPI_COMM_WORLD,ierr,local_status)
    if(global_status/=chemistry_status_ok) then
      write(*,'(A,A,A,I0)') 'fixed air5 GPU ',trim(label),' failed, status=',global_status
      call mpi_abort(MPI_COMM_WORLD,global_status,ierr)
    endif
  end subroutine check_air5_status

  subroutine reset_air5_diffusion_failure()
    air5_diffusion_failure_claim_d=0
    air5_diffusion_failure_location_d=0
    air5_diffusion_failure_values_d=0.0_real64
  end subroutine reset_air5_diffusion_failure

  subroutine check_air5_diffusion_baseline(nstep,rkstep)
    use mpi
    integer, intent(in) :: nstep,rkstep
    integer :: local_status,global_status,local_claim,rank,ierr
    integer :: location(4)
    real(real64) :: values(5)

    local_status=air5_flow_status_d
    call mpi_allreduce(local_status,global_status,1,MPI_INTEGER,MPI_MAX,MPI_COMM_WORLD,ierr)
    if(ierr/=MPI_SUCCESS) call mpi_abort(MPI_COMM_WORLD,ierr,local_status)
    if(global_status/=chemistry_status_ok) then
      call mpi_comm_rank(MPI_COMM_WORLD,rank,ierr)
      if(ierr/=MPI_SUCCESS) call mpi_abort(MPI_COMM_WORLD,ierr,local_status)
      local_claim=air5_diffusion_failure_claim_d
      if(local_status/=chemistry_status_ok) write(*,'(A,I0,A,I0,A,I0)') &
        'AIR5_DIFFUSION_BASELINE_STATUS rank=',rank,' status=',local_status, &
        ' claim=',local_claim
      if(local_status/=chemistry_status_ok .and. local_claim/=0) then
        location=air5_diffusion_failure_location_d
        values=air5_diffusion_failure_values_d
        write(*,'(A,I0,A,I0,A,I0,A,4(I0,1X))') &
          'AIR5_DIFFUSION_BASELINE_FAILURE rank=',rank,' step=',nstep, &
          ' stage=',rkstep,' i/j/k/species=',location
        write(*,'(A,5(ES24.16,1X))') &
          'AIR5_DIFFUSION_BASELINE_VALUES origin/current/conv_increment/base/pminus=',values
      endif
      write(*,'(A,I0)') 'fixed air5 GPU diffusion baseline failed, status=',global_status
      call mpi_abort(MPI_COMM_WORLD,global_status,ierr)
    endif
  end subroutine check_air5_diffusion_baseline

  subroutine check_air5_convection_baseline(nstep,rkstep)
    use mpi
    integer, intent(in) :: nstep,rkstep
    integer :: local_status,global_status,local_claim,rank,ierr
    integer :: location(4)
    real(real64) :: values(5)

    local_status=air5_flow_status_d
    call mpi_allreduce(local_status,global_status,1,MPI_INTEGER,MPI_MAX,MPI_COMM_WORLD,ierr)
    if(ierr/=MPI_SUCCESS) call mpi_abort(MPI_COMM_WORLD,ierr,local_status)
    if(global_status/=chemistry_status_ok) then
      call mpi_comm_rank(MPI_COMM_WORLD,rank,ierr)
      if(ierr/=MPI_SUCCESS) call mpi_abort(MPI_COMM_WORLD,ierr,local_status)
      local_claim=air5_diffusion_failure_claim_d
      if(local_status/=chemistry_status_ok) write(*,'(A,I0,A,I0,A,I0)') &
        'AIR5_CONVECTION_BASELINE_STATUS rank=',rank,' status=',local_status, &
        ' claim=',local_claim
      if(local_status/=chemistry_status_ok .and. local_claim/=0) then
        location=air5_diffusion_failure_location_d
        values=air5_diffusion_failure_values_d
        write(*,'(A,I0,A,I0,A,I0,A,4(I0,1X))') &
          'AIR5_CONVECTION_BASELINE_FAILURE rank=',rank,' step=',nstep, &
          ' stage=',rkstep,' i/j/k/species=',location
        write(*,'(A,5(ES24.16,1X))') &
          'AIR5_CONVECTION_BASELINE_VALUES origin/current/low_increment/base/pminus=',values
      endif
      write(*,'(A,I0)') 'fixed air5 GPU convection baseline failed, status=',global_status
      call mpi_abort(MPI_COMM_WORLD,global_status,ierr)
    endif
  end subroutine check_air5_convection_baseline

  subroutine report_air5_diffusion_limiter(rkstep)
    use mpi
    use parallel, only: lio
    integer, intent(in) :: rkstep
    integer :: local_limited,global_limited,ierr
    integer(int64) :: minimum_bits
    real(real64) :: local_minimum,global_minimum

    local_limited=air5_limited_points_d
    minimum_bits=air5_minimum_ratio_bits_d
    local_minimum=transfer(minimum_bits,local_minimum)
    call MPI_Allreduce(local_limited,global_limited,1,MPI_INTEGER,MPI_SUM, &
      MPI_COMM_WORLD,ierr)
    if(ierr/=MPI_SUCCESS) call MPI_Abort(MPI_COMM_WORLD,ierr,local_limited)
    call MPI_Allreduce(local_minimum,global_minimum,1,MPI_DOUBLE_PRECISION,MPI_MIN, &
      MPI_COMM_WORLD,ierr)
    if(ierr/=MPI_SUCCESS) call MPI_Abort(MPI_COMM_WORLD,ierr,local_limited)
    if(lio .and. global_limited>0) write(*,'(A,I0,A,I0,A,ES12.4)') &
      'AIR5_DIFFUSION_LIMITER stage=',rkstep,' limited_points=',global_limited, &
      ' min_ratio=',global_minimum
  end subroutine report_air5_diffusion_limiter

  subroutine report_air5_full_state_convection_limiter(rkstep)
    use mpi
    use parallel, only: lio
    integer, intent(in) :: rkstep
    integer :: local_limited,global_limited,ierr,constraint,species
    integer :: local_constraint_active(air5_limiter_constraint_count)
    integer :: global_constraint_active(air5_limiter_constraint_count)
    integer :: local_species_constraint_active(air5_num_species)
    integer :: global_species_constraint_active(air5_num_species)
    integer(int64) :: minimum_bits
    integer(int64) :: constraint_minimum_bits(air5_limiter_constraint_count)
    integer(int64) :: species_constraint_minimum_bits(air5_num_species)
    real(real64) :: local_minimum,global_minimum
    real(real64) :: local_constraint_minimum(air5_limiter_constraint_count)
    real(real64) :: global_constraint_minimum(air5_limiter_constraint_count)
    real(real64) :: local_species_constraint_minimum(air5_num_species)
    real(real64) :: global_species_constraint_minimum(air5_num_species)

    local_limited=air5_limited_points_d
    minimum_bits=air5_minimum_ratio_bits_d
    local_minimum=transfer(minimum_bits,local_minimum)
    call MPI_Allreduce(local_limited,global_limited,1,MPI_INTEGER,MPI_SUM, &
      MPI_COMM_WORLD,ierr)
    if(ierr/=MPI_SUCCESS) call MPI_Abort(MPI_COMM_WORLD,ierr,local_limited)
    call MPI_Allreduce(local_minimum,global_minimum,1,MPI_DOUBLE_PRECISION,MPI_MIN, &
      MPI_COMM_WORLD,ierr)
    if(ierr/=MPI_SUCCESS) call MPI_Abort(MPI_COMM_WORLD,ierr,local_limited)
    local_constraint_active=air5_constraint_active_points_d
    constraint_minimum_bits=air5_constraint_minimum_ratio_bits_d
    do constraint=1,air5_limiter_constraint_count
      local_constraint_minimum(constraint)=transfer( &
        constraint_minimum_bits(constraint),local_constraint_minimum(constraint))
    enddo
    call MPI_Allreduce(local_constraint_active,global_constraint_active, &
      air5_limiter_constraint_count,MPI_INTEGER,MPI_SUM,MPI_COMM_WORLD,ierr)
    if(ierr/=MPI_SUCCESS) call MPI_Abort(MPI_COMM_WORLD,ierr,local_limited)
    call MPI_Allreduce(local_constraint_minimum,global_constraint_minimum, &
      air5_limiter_constraint_count,MPI_DOUBLE_PRECISION,MPI_MIN,MPI_COMM_WORLD,ierr)
    if(ierr/=MPI_SUCCESS) call MPI_Abort(MPI_COMM_WORLD,ierr,local_limited)
    local_species_constraint_active=air5_species_constraint_active_points_d
    species_constraint_minimum_bits=air5_species_constraint_minimum_ratio_bits_d
    do species=1,air5_num_species
      local_species_constraint_minimum(species)=transfer( &
        species_constraint_minimum_bits(species), &
        local_species_constraint_minimum(species))
    enddo
    call MPI_Allreduce(local_species_constraint_active, &
      global_species_constraint_active,air5_num_species,MPI_INTEGER,MPI_SUM, &
      MPI_COMM_WORLD,ierr)
    if(ierr/=MPI_SUCCESS) call MPI_Abort(MPI_COMM_WORLD,ierr,local_limited)
    call MPI_Allreduce(local_species_constraint_minimum, &
      global_species_constraint_minimum,air5_num_species,MPI_DOUBLE_PRECISION, &
      MPI_MIN,MPI_COMM_WORLD,ierr)
    if(ierr/=MPI_SUCCESS) call MPI_Abort(MPI_COMM_WORLD,ierr,local_limited)
    if(lio .and. global_limited>0) write(*,'(A,I0,A,I0,A,ES12.4)') &
      'AIR5_FULL_STATE_CONVECTION_LIMITER stage=',rkstep, &
      ' limited_points=',global_limited, &
      ' min_ratio=',global_minimum
    if(lio) then
      do constraint=1,air5_limiter_constraint_count
        if(global_constraint_active(constraint)<=0) cycle
        select case(constraint)
        case(air5_limiter_constraint_species)
          write(*,'(A,I0,A,A,A,I0,A,ES12.4)') &
            'AIR5_FULL_STATE_CONVECTION_CONSTRAINT stage=',rkstep, &
            ' constraint=','species',' active_points=', &
            global_constraint_active(constraint),' min_ratio=', &
            global_constraint_minimum(constraint)
        case(air5_limiter_constraint_vibrational)
          write(*,'(A,I0,A,A,A,I0,A,ES12.4)') &
            'AIR5_FULL_STATE_CONVECTION_CONSTRAINT stage=',rkstep, &
            ' constraint=','vibrational',' active_points=', &
            global_constraint_active(constraint),' min_ratio=', &
            global_constraint_minimum(constraint)
        case(air5_limiter_constraint_density)
          write(*,'(A,I0,A,A,A,I0,A,ES12.4)') &
            'AIR5_FULL_STATE_CONVECTION_CONSTRAINT stage=',rkstep, &
            ' constraint=','density',' active_points=', &
            global_constraint_active(constraint),' min_ratio=', &
            global_constraint_minimum(constraint)
        case(air5_limiter_constraint_translational)
          write(*,'(A,I0,A,A,A,I0,A,ES12.4)') &
            'AIR5_FULL_STATE_CONVECTION_CONSTRAINT stage=',rkstep, &
            ' constraint=','translational',' active_points=', &
            global_constraint_active(constraint),' min_ratio=', &
            global_constraint_minimum(constraint)
        end select
      enddo
      do species=1,air5_num_species
        if(global_species_constraint_active(species)<=0) cycle
        write(*,'(A,I0,A,A,A,I0,A,ES12.4)') &
          'AIR5_FULL_STATE_CONVECTION_SPECIES_CONSTRAINT stage=',rkstep, &
          ' species=',trim(air5_species_name(species)),' active_points=', &
          global_species_constraint_active(species),' min_ratio=', &
          global_species_constraint_minimum(species)
      enddo
    endif
  end subroutine report_air5_full_state_convection_limiter

  subroutine launch_air5_interior_primitive_gpu()
    use commvar, only: im,jm,km,hm
    use gpu_check, only: sync_after_kernel
    type(dim3) :: block,grid

    call reset_air5_status()
    block=dim3(32,4,4)
    grid=dim3((im+block%x)/block%x,(jm+block%y)/block%y,(km+block%z)/block%z)
    call air5_q_to_primitive_interior_kernel<<<grid,block>>>(im,jm,km,hm)
    call sync_after_kernel('air5_q_to_primitive_interior_kernel',.true.)
    call check_air5_status('conservative-to-primitive')
  end subroutine launch_air5_interior_primitive_gpu

  subroutine launch_air5_face_primitives_gpu()
    use commvar, only: im,jm,km,hm
    use gpu_check, only: sync_after_kernel
    type(dim3) :: block,grid
    integer :: axis,n

    call reset_air5_status()
    block=dim3(256,1,1)
    do axis=1,3
      select case(axis)
      case(1)
        n=(jm+1)*(km+1)*2*(hm+1)
      case(2)
        n=(im+1)*(km+1)*2*(hm+1)
      case default
        n=(im+1)*(jm+1)*2*(hm+1)
      end select
      grid=dim3((n+block%x-1)/block%x,1,1)
      call air5_q_to_primitive_face_kernel<<<grid,block>>>(im,jm,km,hm,axis)
      call sync_after_kernel('air5_q_to_primitive_face_kernel',.true.)
    enddo
    call check_air5_status('halo conservative-to-primitive')
  end subroutine launch_air5_face_primitives_gpu

  subroutine air5_prepare_spatial_state_gpu()
    use commvar, only: im,jm,km,hm
    use gpu_check, only: sync_after_kernel
    use halo_exchange_gpu, only: exchange_solution_halo_gpu
    use chemistry_postshock_boundary_gpu, only: apply_air5_postshock_boundary_gpu
    use chemistry_hbl_boundary_gpu, only: apply_air5_hbl_boundary_gpu
    type(dim3) :: block,grid

    call apply_air5_postshock_boundary_gpu()
    call apply_air5_hbl_boundary_gpu()
    call reset_air5_status()
    block=dim3(32,4,4)
    grid=dim3((im+block%x)/block%x,(jm+block%y)/block%y,(km+block%z)/block%z)
    call air5_q_to_primitive_interior_kernel<<<grid,block>>>(im,jm,km,hm)
    call sync_after_kernel('air5_q_to_primitive_interior_kernel',.true.)
    call check_air5_status('conservative-to-primitive')
    call exchange_solution_halo_gpu(.true.)
    call launch_air5_face_primitives_gpu()
  end subroutine air5_prepare_spatial_state_gpu

  subroutine validate_air5_transport_gpu()
    use commvar, only: numq,num_species,num_modequ,ndims,turbmode,rkscheme, &
      conschm,difschm,nondimen,lfilter,lchardecomp,recon_schem,lihomo,ljhomo,lkhomo, &
      im,jm,km,hm,lcomb,flowtype
    use chemistry_flow_runtime, only: air5_open_x_flowtype,air5_hbl_flowtype
    use chemistry_flow_runtime, only: air5_shock_capturing_enabled
    use commarray, only: jacob
    use parallel, only: mpisize,isize,jsize,ksize,pmin
    real(real64) :: minimum_jacobian

    call configure_air5_vibrational_floor_gpu()
    if(.not.lcomb) error stop 'fixed air5 GPU transport requires lcomb=t'
    if(numq/=air5_num_conservative .or. num_species/=air5_num_species .or. &
       num_modequ/=1) error stop 'fixed air5 GPU transport layout mismatch'
    if(nondimen) error stop 'fixed air5 GPU transport currently requires dimensional state'
    if(ndims/=3 .or. trim(turbmode)/='none' .or. trim(rkscheme)/='rk3') &
      error stop 'fixed air5 GPU transport requires 3D laminar RK3'
    if(trim(conschm)/='643e' .or. trim(difschm)/='643e') &
      error stop 'fixed air5 GPU transport requires explicit 643e convection and diffusion'
    if(lchardecomp) &
      error stop 'fixed air5 C4 transport does not support characteristic reconstruction'
    if(recon_schem/=0 .and. recon_schem/=3 .and. recon_schem/=5) &
      error stop 'fixed air5 transport requires recon_schem=0, 3, or 5'
    if(air5_shock_capturing_enabled() .and. hm<4) &
      error stop 'air5 shock capturing requires hm>=4'
    if(air5_open_x_flowtype(flowtype)) then
      if(lihomo .or. .not.(ljhomo .and. lkhomo)) &
        error stop 'fixed air5 post-shock transport requires physical x and periodic y/z'
    elseif(air5_hbl_flowtype(flowtype)) then
      if(lihomo .or. ljhomo .or. .not.lkhomo) &
        error stop 'fixed air5 HBL transport requires physical x/y and periodic z'
    elseif(.not.(lihomo .and. ljhomo .and. lkhomo)) then
      error stop 'fixed air5 periodic transport requires three periodic directions'
    endif
    if(hm<3 .or. min(im,jm,km)<6) &
      error stop 'fixed air5 C4 transport requires a valid sixth-order local stencil'
    if(mpisize/=isize*jsize*ksize) &
      error stop 'fixed air5 C4 MPI topology is inconsistent'
    minimum_jacobian=pmin(minval(jacob(0:im,0:jm,0:km)))
    if(minimum_jacobian<=0.0_real64) &
      error stop 'fixed air5 C4 transport requires positive grid Jacobian'
  end subroutine validate_air5_transport_gpu

  subroutine air5_transport_rk3_step_gpu(first_stage_prepared,copy_back)
    use mpi, only: MPI_PROC_NULL
    use commvar, only: im,jm,km,hm,is,ie,js,je,ks,ke,npdci,npdcj,npdck, &
      deltat,diffterm,nstep,feqchkpt,flowtype,lfilter,lihomo,ljhomo,lkhomo
    use commarray_gpu, only: sigma_d,qflux_d,species_flux_d,ev_flux_d, &
      diffusion_ratio_d, &
      copy_flow_from_gpu,copy_rhs_from_gpu
    use gradcal_gpu, only: gradcal_dvel_kernel,gradcal_dvel_xphysical_kernel, &
      gradcal_dvel_yphysical_kernel,gradcal_dvel_xyphysical_kernel
    use halo_exchange_gpu, only: exchange_field_halo_gpu
    use parallel, only: mpidown
    use chemistry_flow_runtime, only: air5_hbl_flowtype,air5_shock_capturing_enabled
    use chemistry_postshock_boundary_gpu, only: apply_air5_postshock_boundary_gpu
    use chemistry_hbl_boundary_gpu, only: apply_air5_hbl_boundary_gpu
    use shock_sensor_gpu, only: compute_shock_sensor_gpu
    use solver_gpu, only: apply_explicit_filter_gpu
    use gpu_check, only: sync_after_kernel
    use validation_io, only: rhs_validation_requested,write_q_validation_snapshot, &
      write_rhs_validation_snapshot,write_primitive_validation_snapshot
    logical, intent(in), optional :: first_stage_prepared,copy_back
    logical :: prepared,need_copy_back,periodic_filter_case
    integer :: ntot,ratio_ntot,rkstep,direction,apply_left_x,apply_right_x
    integer :: apply_down_y,apply_up_y,zero_species_flux_lower_y
    integer :: collect_limiter_diagnostics,shock_mode
    logical :: shock_capturing
    real(real64), parameter :: rk_a(3)=[1.0_real64,0.75_real64,1.0_real64/3.0_real64]
    real(real64), parameter :: rk_b(3)=[0.0_real64,0.25_real64,2.0_real64/3.0_real64]
    real(real64), parameter :: rk_c(3)=[1.0_real64,0.25_real64,2.0_real64/3.0_real64]
    type(dim3) :: block1,grid1,block3,grid3,block_x,grid_x,block_y,grid_y,block_z,grid_z

    call validate_air5_transport_gpu()
    shock_capturing=air5_shock_capturing_enabled()
    shock_mode=merge(1,0,shock_capturing)
    call initialize_air5_conservation_gpu(nstep)
    prepared=.false.
    if(present(first_stage_prepared)) prepared=first_stage_prepared
    need_copy_back=.false.
    if(present(copy_back)) need_copy_back=copy_back
    ntot=(im+1)*(jm+1)*(km+1)
    ratio_ntot=(im+2*hm+1)*(jm+2*hm+1)*(km+2*hm+1)
    apply_left_x=merge(1,0,npdci==1 .or. npdci==4)
    apply_right_x=merge(1,0,npdci==2 .or. npdci==4)
    apply_down_y=merge(1,0,npdcj==1 .or. npdcj==4)
    apply_up_y=merge(1,0,npdcj==2 .or. npdcj==4)
    zero_species_flux_lower_y=merge(1,0, &
      air5_hbl_flowtype(flowtype) .and. mpidown==MPI_PROC_NULL)
    collect_limiter_diagnostics=merge(1,0,nstep==0 .or. &
      (feqchkpt>0 .and. mod(nstep,feqchkpt)==0))
    periodic_filter_case=lihomo .and. ljhomo .and. lkhomo
    block1=dim3(256,1,1)
    grid1=dim3((ntot+block1%x-1)/block1%x,1,1)
    block3=dim3(8,8,8)
    grid3=dim3((im+block3%x)/block3%x,(jm+block3%y)/block3%y, &
      (km+block3%z)/block3%z)
    block_x=dim3(512,1,1)
    grid_x=dim3((ntot+block_x%x-1)/block_x%x,1,1)
    block_y=dim3(32,16,1)
    grid_y=dim3(((im+1)*(jm+1)+block_y%x*block_y%y-1)/ &
      (block_y%x*block_y%y),1,km+1)
    block_z=dim3(64,1,8)
    grid_z=dim3(((im+1)*(km+1)+block_z%x*block_z%z-1)/ &
      (block_z%x*block_z%z),jm+1,1)

    do rkstep=1,3
      if(lfilter) then
        call air5_save_filter_species_base_kernel<<<grid1,block1>>>(im,jm,km)
        call sync_after_kernel('air5_save_filter_species_base_kernel',.true.)
        call apply_explicit_filter_gpu(periodic_filter_case,'air5_')
        call reset_air5_status()
        call air5_limit_filtered_state_kernel<<<grid1,block1>>>(im,jm,km)
        call sync_after_kernel('air5_limit_filtered_state_kernel',.true.)
        call check_air5_status('explicit filter')
      endif
      if(lfilter .or. .not.(prepared .and. rkstep==1)) call air5_prepare_spatial_state_gpu()
      if(rhs_validation_requested()) then
        call copy_flow_from_gpu()
        call write_q_validation_snapshot('pre_rhs',nstep,rkstep)
        call write_primitive_validation_snapshot('pre_rhs_primitives',nstep,rkstep)
      endif
      if(shock_capturing) call compute_shock_sensor_gpu(rkstep,.true.)
      call air5_zero_rhs_kernel<<<grid1,block1>>>(im,jm,km)
      call sync_after_kernel('air5_zero_rhs_kernel',.true.)
      if(shock_capturing) then
        call reset_air5_status()
        call air5_selective_convective_rhs_x_kernel<<<grid_x,block_x>>>( &
          im,jm,km,npdci,is,ie,js,je,ks,ke)
        call sync_after_kernel('air5_selective_convective_rhs_x_kernel',.true.)
        call air5_selective_convective_rhs_y_kernel<<<grid_y,block_y>>>( &
          im,jm,km,npdcj,is,ie,js,je,ks,ke)
        call sync_after_kernel('air5_selective_convective_rhs_y_kernel',.true.)
        call air5_selective_convective_rhs_z_kernel<<<grid_z,block_z>>>( &
          im,jm,km,npdck,is,ie,js,je,ks,ke)
        call sync_after_kernel('air5_selective_convective_rhs_z_kernel',.true.)
        call check_air5_status('selective LLF/MP7 convection')
      else
        call air5_convective_rhs_x_kernel<<<grid_x,block_x>>>(im,jm,km,npdci, &
          is,ie,js,je,ks,ke)
        call sync_after_kernel('air5_convective_rhs_x_kernel',.true.)
        call air5_convective_rhs_y_kernel<<<grid_y,block_y>>>(im,jm,km,npdcj, &
          is,ie,js,je,ks,ke)
        call sync_after_kernel('air5_convective_rhs_y_kernel',.true.)
        call air5_convective_rhs_z_kernel<<<grid_z,block_z>>>(im,jm,km,npdck, &
          is,ie,js,je,ks,ke)
        call sync_after_kernel('air5_convective_rhs_z_kernel',.true.)
      endif
      grid1=dim3((ratio_ntot+block1%x-1)/block1%x,1,1)
      call air5_reset_diffusion_ratio_kernel<<<grid1,block1>>>(im,jm,km,hm)
      call sync_after_kernel('air5_reset_convection_ratio_kernel',.true.)
      grid1=dim3((ntot+block1%x-1)/block1%x,1,1)
      call reset_air5_status()
      call reset_air5_diffusion_failure()
      air5_limited_points_d=0
      air5_minimum_ratio_bits_d=transfer(huge(1.0_real64),0_int64)
      air5_constraint_active_points_d=0
      air5_constraint_minimum_ratio_bits_d= &
        transfer(huge(1.0_real64),0_int64)
      air5_species_constraint_active_points_d=0
      air5_species_constraint_minimum_ratio_bits_d= &
        transfer(huge(1.0_real64),0_int64)
      call air5_full_state_convection_ratio_kernel<<<grid1,block1>>>(deltat, &
        rk_a(rkstep),rk_b(rkstep),rk_c(rkstep),rkstep,collect_limiter_diagnostics, &
        im,jm,km,npdci,npdcj,npdck,is,ie,js,je,ks,ke,shock_mode)
      call sync_after_kernel('air5_full_state_convection_ratio_kernel',.true.)
      call check_air5_convection_baseline(nstep,rkstep)
      if(collect_limiter_diagnostics/=0) &
        call report_air5_full_state_convection_limiter(rkstep)
      call exchange_field_halo_gpu(diffusion_ratio_d,1)
      call air5_limit_full_state_convection_kernel<<<grid1,block1>>>(im,jm,km, &
        npdci,npdcj,npdck,is,ie,js,je,ks,ke,shock_mode)
      call sync_after_kernel('air5_limit_full_state_convection_kernel',.true.)
      if(diffterm) then
        if((apply_left_x/=0 .or. apply_right_x/=0) .and. &
           (apply_down_y/=0 .or. apply_up_y/=0)) then
          call gradcal_dvel_xyphysical_kernel<<<grid3,block3>>>(im,jm,km,hm, &
            apply_left_x,apply_right_x,apply_down_y,apply_up_y)
        elseif(apply_left_x/=0 .or. apply_right_x/=0) then
          call gradcal_dvel_xphysical_kernel<<<grid3,block3>>>(im,jm,km,hm, &
            apply_left_x,apply_right_x)
        elseif(apply_down_y/=0 .or. apply_up_y/=0) then
          call gradcal_dvel_yphysical_kernel<<<grid3,block3>>>(im,jm,km,hm, &
            apply_down_y,apply_up_y)
        else
          call gradcal_dvel_kernel<<<grid3,block3>>>(im,jm,km,hm)
        endif
        call sync_after_kernel('air5_gradcal_dvel_kernel',.true.)
        call air5_species_tv_gradient_kernel<<<grid3,block3>>>(im,jm,km, &
          npdci,npdcj,npdck,zero_species_flux_lower_y)
        call sync_after_kernel('air5_species_tv_gradient_kernel',.true.)
        call reset_air5_status()
        call air5_diffusion_flux_kernel<<<grid3,block3>>>(im,jm,km)
        call sync_after_kernel('air5_diffusion_flux_kernel',.true.)
        call check_air5_status('diffusion flux')
        call exchange_field_halo_gpu(sigma_d,6)
        call exchange_field_halo_gpu(qflux_d,3)
        do direction=1,3
          call exchange_field_halo_gpu(species_flux_d(:,:,:,:,direction),air5_num_species)
        enddo
        call exchange_field_halo_gpu(ev_flux_d,3)
        grid1=dim3((ratio_ntot+block1%x-1)/block1%x,1,1)
        call air5_reset_diffusion_ratio_kernel<<<grid1,block1>>>(im,jm,km,hm)
        call sync_after_kernel('air5_reset_diffusion_ratio_kernel',.true.)
        grid1=dim3((ntot+block1%x-1)/block1%x,1,1)
        call reset_air5_status()
        call reset_air5_diffusion_failure()
        air5_limited_points_d=0
        air5_minimum_ratio_bits_d=transfer(huge(1.0_real64),0_int64)
        call air5_diffusion_ratio_kernel<<<grid1,block1>>>(deltat,rk_a(rkstep), &
          rk_b(rkstep),rk_c(rkstep),rkstep,collect_limiter_diagnostics,im,jm,km, &
          npdci,npdcj,npdck,is,ie,js,je,ks,ke)
        call sync_after_kernel('air5_diffusion_ratio_kernel',.true.)
        call check_air5_diffusion_baseline(nstep,rkstep)
        if(collect_limiter_diagnostics/=0) call report_air5_diffusion_limiter(rkstep)
        call exchange_field_halo_gpu(diffusion_ratio_d,1)
        call air5_diffusion_rhs_x_kernel<<<grid_x,block_x>>>(im,jm,km,npdci, &
          is,ie,js,je,ks,ke)
        call sync_after_kernel('air5_diffusion_rhs_x_kernel',.true.)
        call air5_diffusion_rhs_y_kernel<<<grid_y,block_y>>>(im,jm,km,npdcj, &
          is,ie,js,je,ks,ke)
        call sync_after_kernel('air5_diffusion_rhs_y_kernel',.true.)
        call air5_diffusion_rhs_z_kernel<<<grid_z,block_z>>>(im,jm,km,npdck, &
          is,ie,js,je,ks,ke)
        call sync_after_kernel('air5_diffusion_rhs_z_kernel',.true.)
      endif
      if(rhs_validation_requested()) then
        call copy_rhs_from_gpu()
        call write_rhs_validation_snapshot('full',nstep,rkstep)
      endif
      if(rkstep==1) then
        call air5_rk3_first_update_kernel<<<grid1,block1>>>(deltat,im,jm,km, &
          is,ie,js,je,ks,ke)
        call sync_after_kernel('air5_rk3_first_update_kernel',.true.)
      else
        call air5_rk3_update_kernel<<<grid1,block1>>>(deltat,rk_a(rkstep), &
          rk_b(rkstep),rk_c(rkstep),im,jm,km,is,ie,js,je,ks,ke)
        call sync_after_kernel('air5_rk3_update_kernel',.true.)
      endif
      call apply_air5_postshock_boundary_gpu()
      call apply_air5_hbl_boundary_gpu()
      if(rhs_validation_requested()) then
        call copy_flow_from_gpu()
        call write_q_validation_snapshot('post_update',nstep,rkstep)
      endif
    enddo
    call record_air5_conservation_gpu(nstep+1)
    call launch_air5_interior_primitive_gpu()
    if(need_copy_back) call copy_flow_from_gpu()
  end subroutine air5_transport_rk3_step_gpu

end module chemistry_flow_solver_gpu
