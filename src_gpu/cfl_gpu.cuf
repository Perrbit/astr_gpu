module cfl_gpu
  use cudafor
  use iso_fortran_env, only: int64
  use cfl_spectrum, only: spectral_rates
  implicit none
  private
  public :: collect_cfl_gpu
contains
  attributes(global) subroutine cfl_partial_kernel(partial,keys,im,jm,km,hm, &
      ia,ja,i0,j0,k0,by_plane,reacting,nondimensional,mach,gamma,rgas)
    use commarray_gpu, only: q_d,vel_d,tmp_d,dxi_d
#ifdef ASTR_AIR5_CHEMISTRY
    use chemistry_thermo_gpu, only: air5_temperature_from_q5_gpu, &
      air5_species_gas_constant_gpu,air5_species_cv_tr_gpu
#endif
    integer,value :: im,jm,km,hm,ia,ja,i0,j0,k0
    logical,value :: by_plane,reacting,nondimensional
    real(8),value :: mach,gamma,rgas
    real(8),device :: partial(4,*)
    integer(int64),device :: keys(4,*)
    real(8),shared :: values_s(4,256)
    integer(int64),shared :: keys_s(4,256)
    real(8) :: rates(4),best(4),velocity(3),sound,temp,rden,cvden,metric(3,3)
    real(8) :: momentum(3),partial_density(5)
    integer(int64) :: ids(4),key,id,ncell,stride
    integer :: tid,i,j,k,s,axis,n,slot,status
    logical :: valid

    tid=threadIdx%x
    id=int(blockIdx%x-1,int64)*blockDim%x+tid-1
    stride=int(gridDim%x,int64)*blockDim%x
    ncell=int(im+1,int64)*(km+1)
    if(.not.by_plane) ncell=ncell*(jm+1)
    best=0.d0
    ids=huge(0_int64)
    do while(id<ncell)
      i=int(mod(id,int(im+1,int64)))
      if(by_plane) then
        j=blockIdx%y-1
        k=int(id/(im+1))
      else
        j=int(mod(id/(im+1),int(jm+1,int64)))
        k=int(id/(int(im+1,int64)*(jm+1)))
      endif
      velocity=vel_d(i,j,k,:)
      temp=tmp_d(i,j,k)
      status=0
#ifdef ASTR_AIR5_CHEMISTRY
      if(reacting) then
        momentum=q_d(i,j,k,2:4)
        partial_density=q_d(i,j,k,6:10)
        call air5_temperature_from_q5_gpu(q_d(i,j,k,1),momentum, &
          partial_density,q_d(i,j,k,11),q_d(i,j,k,5),temp,status)
        sound=-1.d0
        if(status==0) then
          velocity=q_d(i,j,k,2:4)/q_d(i,j,k,1)
          rden=0.d0
          cvden=0.d0
          do s=1,5
            rden=rden+q_d(i,j,k,5+s)*air5_species_gas_constant_gpu(s)
            cvden=cvden+q_d(i,j,k,5+s)*air5_species_cv_tr_gpu(s)
          enddo
          sound=sqrt((1.d0+rden/cvden)*rden*temp/q_d(i,j,k,1))
        endif
      else
#endif
        if(nondimensional) then
          sound=sqrt(temp)/mach
        else
          sound=sqrt(gamma*rgas*temp)
        endif
#ifdef ASTR_AIR5_CHEMISTRY
      endif
#endif
      metric=dxi_d(i,j,k,:,:)
      call spectral_rates(velocity,sound,metric,rates,valid)
      ! A finite sentinel propagates invalid state through every max reduction.
      if(.not.valid.or.status/=0) rates=huge(1.d0)
      key=(int(k+k0,int64)*(ja+1)+j+j0)*(ia+1)+i+i0
      do axis=1,4
        if(rates(axis)>best(axis).or. &
          (rates(axis)==best(axis).and.key<ids(axis))) then
          best(axis)=rates(axis)
          ids(axis)=key
        endif
      enddo
      id=id+stride
    enddo
    values_s(:,tid)=best
    keys_s(:,tid)=ids
    call syncthreads()
    n=blockDim%x/2
    do while(n>0)
      if(tid<=n) then
        do axis=1,4
          if(values_s(axis,tid+n)>values_s(axis,tid).or. &
            (values_s(axis,tid+n)==values_s(axis,tid).and.keys_s(axis,tid+n)<keys_s(axis,tid))) then
            values_s(axis,tid)=values_s(axis,tid+n)
            keys_s(axis,tid)=keys_s(axis,tid+n)
          endif
        enddo
      endif
      call syncthreads()
      n=n/2
    enddo
    if(tid==1) then
      slot=(blockIdx%y-1)*gridDim%x+blockIdx%x
      partial(:,slot)=values_s(:,1)
      keys(:,slot)=keys_s(:,1)
    endif
  end subroutine cfl_partial_kernel

  attributes(global) subroutine cfl_finish_kernel(partial,keys,values_out,keys_out,nb)
    integer,value :: nb
    real(8),device :: partial(4,*),values_out(4,*)
    integer(int64),device :: keys(4,*),keys_out(4,*)
    integer :: axis,b,slot
    real(8) :: best
    integer(int64) :: key
    axis=threadIdx%x
    if(axis>4) return
    best=0.d0
    key=huge(0_int64)
    do b=1,nb
      slot=(blockIdx%x-1)*nb+b
      if(partial(axis,slot)>best.or.(partial(axis,slot)==best.and.keys(axis,slot)<key)) then
        best=partial(axis,slot)
        key=keys(axis,slot)
      endif
    enddo
    values_out(axis,blockIdx%x)=best
    keys_out(axis,blockIdx%x)=key
  end subroutine cfl_finish_kernel

  subroutine collect_cfl_gpu(values,keys,yvalues,by_plane,nprofile)
    use commvar, only: im,jm,km,hm,ia,ja,nondimen,lcomb,mach,gamma,rgas
    use parallel, only: ig0,jg0,kg0
    use gpu_check, only: sync_after_kernel
    integer,intent(in) :: nprofile
    real(8),intent(out) :: values(4),yvalues(4,0:nprofile-1)
    integer(int64),intent(out) :: keys(4)
    logical,intent(in) :: by_plane
    real(8),allocatable,device :: partial_d(:,:),values_d(:,:)
    integer(int64),allocatable,device :: keys_d(:,:),out_keys_d(:,:)
    real(8),allocatable :: host(:,:)
    integer(int64),allocatable :: host_keys(:,:)
    integer :: nb,ny,j,axis

    nb=128
    ny=1
    if(by_plane) then
      nb=8
      ny=jm+1
    endif
    allocate(partial_d(4,nb*ny),keys_d(4,nb*ny),values_d(4,ny),out_keys_d(4,ny))
    allocate(host(4,ny),host_keys(4,ny))
    call cfl_partial_kernel<<<dim3(nb,ny,1),256>>>(partial_d,keys_d,im,jm,km,hm, &
      ia,ja,ig0,jg0,kg0,by_plane,lcomb,nondimen,mach,gamma,rgas)
    call sync_after_kernel('cfl_partial_kernel',.true.)
    call cfl_finish_kernel<<<ny,32>>>(partial_d,keys_d,values_d,out_keys_d,nb)
    call sync_after_kernel('cfl_finish_kernel',.true.)
    host=values_d
    host_keys=out_keys_d
    values=maxval(host,dim=2)
    do axis=1,4
      keys(axis)=minval(host_keys(axis,:),mask=host(axis,:)==values(axis))
    enddo
    yvalues=0.d0
    if(by_plane) then
      do j=0,jm
        yvalues(:,jg0+j)=host(:,j+1)
      enddo
    endif
    deallocate(partial_d,keys_d,values_d,out_keys_d,host,host_keys)
  end subroutine collect_cfl_gpu
end module cfl_gpu
