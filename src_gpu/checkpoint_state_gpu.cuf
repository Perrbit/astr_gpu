module checkpoint_state_gpu
  use iso_fortran_env, only: int64,real64
  use cudafor
  use mpi
  use commarray_gpu, only: q_d,rho_d,vel_d,prs_d,tmp_d
#ifdef ASTR_AIR5_CHEMISTRY
  use commarray_gpu, only: tve_d,spc_d
  use chemistry_compensation, only: air5_compensated
  use chemistry_compensation_gpu, only: air5_carry_d
#endif
  use gpu_check, only: sync_gpu_boundary
  use checkpoint_state_io, only: checkpoint_state_identity, checkpoint_state_transfer, &
    allocate_checkpoint_buffer, checkpoint_state_require,checkpoint_halo_refresh
  implicit none
  private
  public :: checkpoint_perfect_gas_gpu
#ifdef ASTR_AIR5_CHEMISTRY
  public :: checkpoint_air5_gpu
#endif
contains
#ifdef ASTR_AIR5_CHEMISTRY
  subroutine checkpoint_air5_gpu(path,writing,global_shape,origin,cells,halo,identity,budget,comm)
    character(*),intent(in) :: path
    logical,intent(in) :: writing
    integer,intent(in) :: global_shape(3),origin(3),cells(3),halo,comm
    type(checkpoint_state_identity),intent(inout) :: identity
    integer(int64),intent(in) :: budget
    real(real64),allocatable :: buffer(:,:,:,:),carry_stage(:,:,:,:)
    integer(int64) :: remaining,metadata(2),expected(2),carry_bytes,nodes
    integer :: extents(3),h,err,d
    call checkpoint_state_require(allocated(q_d).and.allocated(rho_d).and.allocated(vel_d).and. &
      allocated(prs_d).and.allocated(tmp_d).and.allocated(tve_d).and.allocated(spc_d), &
      comm,'AIR5 device state not initialized')
    call allocate_checkpoint_buffer(cells,halo,34,budget,buffer,remaining,comm)
    extents=shape(buffer(:,:,:,1)); h=halo+1
    call checkpoint_state_require(all(shape(q_d)==[extents,11]).and.all(shape(rho_d)==extents).and. &
      all(shape(vel_d)==[extents,3]).and.all(shape(prs_d)==extents).and. &
      all(shape(tmp_d)==extents).and.all(shape(tve_d)==extents).and. &
      all(shape(spc_d)==[extents,5]),comm,'AIR5 device cache shape')
    if(air5_compensated) then
      call checkpoint_state_require(allocated(air5_carry_d),comm,'AIR5 device carry not initialized')
      call checkpoint_state_require(all(shape(air5_carry_d)==[cells+1,11]),comm,'AIR5 device carry shape')
      nodes=1
      do d=1,3
        call checkpoint_state_require(nodes<=remaining/88/(int(cells(d),int64)+1),comm,'AIR5 carry buffer budget')
        nodes=nodes*(int(cells(d),int64)+1)
      enddo
      carry_bytes=nodes*88
      remaining=remaining-carry_bytes
      allocate(carry_stage(cells(1)+1,cells(2)+1,cells(3)+1,11),stat=err)
      call checkpoint_state_require(err==0,comm,'AIR5 carry buffer allocation')
    endif
    metadata=[1_int64,int(merge(1,0,air5_compensated),int64)]; expected=metadata
    call sync_gpu_boundary('AIR5 complete-state transfer entry')
    if(writing) then
      buffer(:,:,:,1:11)=q_d
      buffer(:,:,:,12:22)=0.0_real64
      if(air5_compensated) then
        ! Download to a contiguous allocation before placing it inside halo storage.
        carry_stage=air5_carry_d
        buffer(h:h+cells(1),h:h+cells(2),h:h+cells(3),12:22)=carry_stage
      endif
      buffer(:,:,:,23)=rho_d
      buffer(:,:,:,24:26)=vel_d
      buffer(:,:,:,27)=prs_d
      buffer(:,:,:,28)=tmp_d
      buffer(:,:,:,29)=tve_d
      buffer(:,:,:,30:34)=spc_d
    endif
    call checkpoint_state_transfer(path,writing,.true.,global_shape,origin,cells,halo, &
      buffer,identity,remaining,comm,role=7,metadata=metadata)
    call checkpoint_state_require(all(metadata==expected),comm,'AIR5 device compensation contract mismatch')
    if(.not.writing) then
      q_d=buffer(:,:,:,1:11)
      if(air5_compensated) then
        carry_stage=buffer(h:h+cells(1),h:h+cells(2),h:h+cells(3),12:22)
        air5_carry_d=carry_stage
      endif
      rho_d=buffer(:,:,:,23)
      vel_d=buffer(:,:,:,24:26)
      prs_d=buffer(:,:,:,27)
      tmp_d=buffer(:,:,:,28)
      tve_d=buffer(:,:,:,29)
      spc_d=buffer(:,:,:,30:34)
      call sync_gpu_boundary('AIR5 complete-state transfer restore')
    endif
  end subroutine
#endif
  subroutine checkpoint_perfect_gas_gpu(path,writing,global_shape,origin,cells,halo,identity,budget,comm, &
                                       allow_repartition,restored_exact,refresh_halos)
    character(*),intent(in) :: path
    logical,intent(in) :: writing
    logical,optional,intent(in) :: allow_repartition
    logical,optional,intent(out) :: restored_exact
    procedure(checkpoint_halo_refresh),optional :: refresh_halos
    integer,intent(in) :: global_shape(3),origin(3),cells(3),halo,comm
    type(checkpoint_state_identity),intent(inout) :: identity
    integer(int64),intent(in) :: budget
    real(real64),allocatable :: buffer(:,:,:,:)
    integer(int64) :: remaining
    integer :: extents(3)
    logical :: permit,matched
    permit=.false.
    if(present(allow_repartition)) permit=allow_repartition
    call checkpoint_state_require(allocated(q_d).and.allocated(rho_d).and.allocated(vel_d).and. &
      allocated(prs_d).and.allocated(tmp_d),comm,'device state not initialized')
    call allocate_checkpoint_buffer(cells,halo,11,budget,buffer,remaining,comm)
    extents=shape(buffer(:,:,:,1))
    call checkpoint_state_require(all(shape(q_d)==[extents,5]).and.all(shape(rho_d)==extents).and. &
      all(shape(vel_d)==[extents,3]).and.all(shape(prs_d)==extents).and. &
      all(shape(tmp_d)==extents),comm,'device perfect-gas cache shape')
    call sync_gpu_boundary('complete-state transfer entry')
    if (writing) then
      buffer(:,:,:,1:5)=q_d
      buffer(:,:,:,6)=rho_d
      buffer(:,:,:,7:9)=vel_d
      buffer(:,:,:,10)=prs_d
      buffer(:,:,:,11)=tmp_d
    else
      buffer=0.d0
    endif
    call checkpoint_state_transfer(path,writing,.true.,global_shape,origin,cells,halo, &
      buffer,identity,remaining,comm,role=2,allow_repartition=permit,restored_exact=matched)
    if(present(restored_exact)) restored_exact=matched
    if (.not.writing) then
      if(.not.matched) then
        call checkpoint_state_require(present(refresh_halos),comm,'device repartition halo provider missing')
        call refresh_halos(buffer,cells,halo,remaining,comm)
      endif
      q_d=buffer(:,:,:,1:5)
      rho_d=buffer(:,:,:,6)
      vel_d=buffer(:,:,:,7:9)
      prs_d=buffer(:,:,:,10)
      tmp_d=buffer(:,:,:,11)
      call sync_gpu_boundary('complete-state transfer restore')
    endif
  end subroutine
end module
