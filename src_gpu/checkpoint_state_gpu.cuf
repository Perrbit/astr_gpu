module checkpoint_state_gpu
  use iso_fortran_env, only: int64
  use astr_precision, only: real_kind,real_bytes
  use cudafor
  use mpi
  use commarray_gpu, only: q_d,rho_d,vel_d,prs_d,tmp_d
#ifdef ASTR_AIR5_CHEMISTRY
  use commarray_gpu, only: tve_d,spc_d
  use chemistry_compensation, only: air5_compensated
  use chemistry_compensation_gpu, only: air5_carry_d
  use chemistry_flow_runtime, only: air5_history_enabled
  use chemistry_coupling_gpu, only: air5_step_history_d
#endif
  use gpu_check, only: sync_gpu_boundary
  use checkpoint_state_io, only: checkpoint_state_identity, checkpoint_state_transfer, &
    allocate_checkpoint_buffer, checkpoint_state_require,checkpoint_halo_refresh,checkpoint_crashfix_words
  implicit none
  private
  public :: checkpoint_perfect_gas_gpu
  public :: checkpoint_crashfix_gpu
  public :: checkpoint_lean_perfect_gas_gpu,rebuild_checkpoint_primitives_gpu
#ifdef ASTR_AIR5_CHEMISTRY
  public :: checkpoint_air5_gpu
#endif
contains
  attributes(global) subroutine checkpoint_component_kernel(stage,im,jm,km,component,packing)
    real(real_kind),device :: stage(:,:,:)
    integer,value :: im,jm,km,component
    logical,value :: packing
    integer :: i,j,k
    i=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    j=(blockIdx%y-1)*blockDim%y+threadIdx%y-1
    k=(blockIdx%z-1)*blockDim%z+threadIdx%z-1
    if(i>im.or.j>jm.or.k>km) return
    if(packing) then
      stage(i+1,j+1,k+1)=q_d(i,j,k,component)
    else
      q_d(i,j,k,component)=stage(i+1,j+1,k+1)
    endif
  end subroutine checkpoint_component_kernel

  subroutine rebuild_checkpoint_primitives_gpu()
    use commvar, only: im,jm,km,hm,const2,const6
    use solver_gpu, only: q_to_primitive_kernel
    use halo_exchange_gpu, only: exchange_solution_halo_gpu
    use gpu_check, only: sync_after_kernel
    type(dim3) :: block,grid
    block=dim3(32,4,4)
    grid=dim3((im+32)/32,(jm+4)/4,(km+4)/4)
    call q_to_primitive_kernel<<<grid,block>>>(q_d,rho_d,vel_d,prs_d,tmp_d,const2,const6,im,jm,km,hm)
    call sync_after_kernel('checkpoint_rebuild_primitives',.true.)
    ! Halo exchange only: do not reapply walls or draw new blowing randomness.
    call exchange_solution_halo_gpu()
  end subroutine rebuild_checkpoint_primitives_gpu

  subroutine checkpoint_lean_perfect_gas_gpu(path,writing,global_shape,origin,cells,identity,budget,device_budget,comm, &
                                            allow_repartition,restored_exact,repartition_axes)
    character(*),intent(in) :: path
    logical,intent(in) :: writing,allow_repartition,repartition_axes(3)
    logical,intent(out) :: restored_exact
    integer,intent(in) :: global_shape(3),origin(3),cells(3),comm
    type(checkpoint_state_identity),intent(inout) :: identity
    integer(int64),intent(in) :: budget,device_budget
    real(real_kind),allocatable :: buffer(:,:,:,:)
    real(real_kind),allocatable,device :: stage(:,:,:)
    integer(int64) :: remaining,stage_bytes
    integer :: component,err
    type(dim3) :: block,grid
    call allocate_checkpoint_buffer(cells,0,5,budget,buffer,remaining,comm)
    stage_bytes=int(real_bytes,int64)*product(int(cells,int64)+1)
    if(device_budget>0) call checkpoint_state_require(stage_bytes<=device_budget,comm,'lean checkpoint device pack budget')
    allocate(stage(cells(1)+1,cells(2)+1,cells(3)+1),stat=err)
    call checkpoint_state_require(err==0,comm,'lean checkpoint device pack allocation')
    block=dim3(32,4,4); grid=dim3((cells(1)+32)/32,(cells(2)+4)/4,(cells(3)+4)/4)
    if(writing) then
      do component=1,5
        call checkpoint_component_kernel<<<grid,block>>>(stage,cells(1),cells(2),cells(3),component,.true.)
        call sync_gpu_boundary('lean checkpoint component pack')
        buffer(:,:,:,component)=stage
      enddo
    else
      buffer=0.e0_real_kind
    endif
    call checkpoint_state_transfer(path,writing,.false.,global_shape,origin,cells,0,buffer,identity,remaining,comm, &
      role=11,allow_repartition=allow_repartition,restored_exact=restored_exact,repartition_axes=repartition_axes, &
      physical_only=.true.)
    if(.not.writing) then
      q_d=0.e0_real_kind
      do component=1,5
        stage=buffer(:,:,:,component)
        call checkpoint_component_kernel<<<grid,block>>>(stage,cells(1),cells(2),cells(3),component,.false.)
        call sync_gpu_boundary('lean checkpoint component restore')
      enddo
    endif
    deallocate(stage)
    if(.not.writing) call rebuild_checkpoint_primitives_gpu()
  end subroutine checkpoint_lean_perfect_gas_gpu

  attributes(global) subroutine pack_crashfix_kernel(words,nodes,nx,ny,halo)
    use commarray_gpu, only: crinod_d
    integer(int64),device :: words(:)
    integer(int64),value :: nodes
    integer,value :: nx,ny,halo
    integer(int64) :: word,id,value
    integer :: bit,i,j,k
    word=int(blockIdx%x-1,int64)*blockDim%x+threadIdx%x
    if(word>size(words,kind=int64)) return
    value=0
    do bit=0,63
      id=(word-1)*64+bit
      if(id>=nodes) exit
      i=int(mod(id,int(nx,int64)))-halo
      j=int(mod(id/nx,int(ny,int64)))-halo
      k=int(id/(int(nx,int64)*ny))-halo
      if(crinod_d(i,j,k)) value=ibset(value,bit)
    enddo
    words(word)=value
  end subroutine pack_crashfix_kernel

  attributes(global) subroutine unpack_crashfix_kernel(words,nodes,nx,ny,halo)
    use commarray_gpu, only: crinod_d
    integer(int64),device :: words(:)
    integer(int64),value :: nodes
    integer,value :: nx,ny,halo
    integer(int64) :: id
    integer :: i,j,k
    id=int(blockIdx%x-1,int64)*blockDim%x+threadIdx%x-1
    if(id>=nodes) return
    i=int(mod(id,int(nx,int64)))-halo
    j=int(mod(id/nx,int(ny,int64)))-halo
    k=int(id/(int(nx,int64)*ny))-halo
    crinod_d(i,j,k)=btest(words(id/64+1),int(mod(id,64_int64)))
  end subroutine unpack_crashfix_kernel

  subroutine checkpoint_crashfix_gpu(path,writing,budget,device_budget,comm,restored_exact,allow_inexact)
    use commvar, only: im,jm,km,hm,lcracon
    use commarray_gpu, only: crinod_d,crashfix_enabled_d,sync_crashfix_mask_to_gpu
    use gpu_check, only: sync_after_kernel
    character(*),intent(in) :: path
    logical,intent(in) :: writing,restored_exact
    logical,optional,intent(in) :: allow_inexact
    integer(int64),intent(in) :: budget,device_budget
    integer,intent(in) :: comm
    integer(int64),allocatable :: words(:)
    integer(int64),allocatable,device :: words_d(:)
    integer(int64) :: nodes,nwords
    integer :: extents(3),err
    logical :: active
    extents=[im,jm,km]+2*hm+1
    nodes=product(int(extents,int64)); nwords=(nodes+63)/64
    active=lcracon.or.allocated(crinod_d)
    call MPI_Allreduce(MPI_IN_PLACE,active,1,MPI_LOGICAL,MPI_LOR,comm,err)
    call checkpoint_state_require(err==MPI_SUCCESS,comm,'device crashfix history activation')
    if(writing.and.active) then
      if(.not.allocated(crinod_d)) call sync_crashfix_mask_to_gpu()
      if(.not.allocated(crinod_d)) then
        allocate(crinod_d(-hm:im+hm,-hm:jm+hm,-hm:km+hm))
        crinod_d=.false.
      endif
      crashfix_enabled_d=.true.
      call checkpoint_state_require(nwords<=min(budget,device_budget)/8.and.nwords<=huge(1), &
        comm,'device crashfix pack budget')
      allocate(words(int(nwords)),words_d(int(nwords)),stat=err)
      call checkpoint_state_require(err==0,comm,'device crashfix pack allocation')
      call pack_crashfix_kernel<<<int((nwords+255)/256),256>>>(words_d,nodes,extents(1),extents(2),hm)
      call sync_after_kernel('pack_crashfix_history',.true.)
      words=words_d
    endif
    call checkpoint_crashfix_words(path,writing,lcracon,active,nodes,budget,comm,words,restored_exact,allow_inexact)
    if(.not.writing) then
      if(active) then
        call checkpoint_state_require(nwords<=device_budget/8,comm,'device crashfix restore budget')
        allocate(words_d(int(nwords)),stat=err)
        call checkpoint_state_require(err==0,comm,'device crashfix restore allocation')
        if(.not.allocated(crinod_d)) allocate(crinod_d(-hm:im+hm,-hm:jm+hm,-hm:km+hm))
        words_d=words
        call unpack_crashfix_kernel<<<int((nodes+255)/256),256>>>(words_d,nodes,extents(1),extents(2),hm)
        call sync_after_kernel('unpack_crashfix_history',.true.)
      else
        if(allocated(crinod_d)) deallocate(crinod_d)
      endif
      crashfix_enabled_d=active
    endif
    if(allocated(words_d)) deallocate(words_d)
  end subroutine checkpoint_crashfix_gpu

#ifdef ASTR_AIR5_CHEMISTRY
  subroutine checkpoint_air5_gpu(path,writing,global_shape,origin,cells,halo,identity,budget,comm, &
                                 allow_repartition,restored_exact,refresh_halos,repartition_axes)
    use ieee_arithmetic, only: ieee_is_finite
    character(*),intent(in) :: path
    logical,intent(in) :: writing
    logical,optional,intent(in) :: allow_repartition,repartition_axes(3)
    logical,optional,intent(out) :: restored_exact
    procedure(checkpoint_halo_refresh),optional :: refresh_halos
    integer,intent(in) :: global_shape(3),origin(3),cells(3),halo,comm
    type(checkpoint_state_identity),intent(inout) :: identity
    integer(int64),intent(in) :: budget
    real(real_kind),allocatable :: buffer(:,:,:,:),carry_stage(:,:,:,:)
    real(real_kind),allocatable :: history_stage(:,:,:)
    integer(int64) :: remaining,metadata(2),expected(2),carry_bytes,nodes
    integer :: extents(3),h,err,d,bytes_per_node
    logical :: permit,matched
    permit=.false.
    if(present(allow_repartition)) permit=allow_repartition
    call checkpoint_state_require(allocated(q_d).and.allocated(rho_d).and.allocated(vel_d).and. &
      allocated(prs_d).and.allocated(tmp_d).and.allocated(tve_d).and.allocated(spc_d), &
      comm,'AIR5 device state not initialized')
    call allocate_checkpoint_buffer(cells,halo,34+merge(1,0,air5_history_enabled),budget,buffer,remaining,comm)
    extents=shape(buffer(:,:,:,1)); h=halo+1
    call checkpoint_state_require(all(shape(q_d)==[extents,11]).and.all(shape(rho_d)==extents).and. &
      all(shape(vel_d)==[extents,3]).and.all(shape(prs_d)==extents).and. &
      all(shape(tmp_d)==extents).and.all(shape(tve_d)==extents).and. &
      all(shape(spc_d)==[extents,5]),comm,'AIR5 device cache shape')
    if(air5_compensated) then
      call checkpoint_state_require(allocated(air5_carry_d),comm,'AIR5 device carry not initialized')
      call checkpoint_state_require(all(shape(air5_carry_d)==[cells+1,11]),comm,'AIR5 device carry shape')
    endif
    if(air5_history_enabled) then
      call checkpoint_state_require(allocated(air5_step_history_d),comm,'AIR5 device history not initialized')
      call checkpoint_state_require(all(shape(air5_step_history_d)==cells+1),comm,'AIR5 device history shape')
    endif
    bytes_per_node=merge(88,0,air5_compensated)+merge(8,0,air5_history_enabled)
    if(bytes_per_node>0) then
      nodes=1
      do d=1,3
        call checkpoint_state_require(nodes<=remaining/bytes_per_node/(int(cells(d),int64)+1), &
          comm,'AIR5 auxiliary buffer budget')
        nodes=nodes*(int(cells(d),int64)+1)
      enddo
      carry_bytes=nodes*bytes_per_node
      remaining=remaining-carry_bytes
    endif
    if(air5_compensated) then
      allocate(carry_stage(cells(1)+1,cells(2)+1,cells(3)+1,11),stat=err)
      call checkpoint_state_require(err==0,comm,'AIR5 carry buffer allocation')
    endif
    if(air5_history_enabled) then
      allocate(history_stage(cells(1)+1,cells(2)+1,cells(3)+1),stat=err)
      call checkpoint_state_require(err==0,comm,'AIR5 history buffer allocation')
    endif
    metadata=[1_int64,int(merge(1,0,air5_compensated),int64)]; expected=metadata
    call sync_gpu_boundary('AIR5 complete-state transfer entry')
    if(writing) then
      buffer(:,:,:,1:11)=q_d
      buffer(:,:,:,12:22)=0.0_real_kind
      if(air5_compensated) then
        ! Download to a contiguous allocation before placing it inside halo storage.
        carry_stage=air5_carry_d
        buffer(h:h+cells(1),h:h+cells(2),h:h+cells(3),12:22)=carry_stage
      endif
      buffer(:,:,:,23)=rho_d
      buffer(:,:,:,24:26)=vel_d
      buffer(:,:,:,27)=prs_d
      buffer(:,:,:,28)=tmp_d
      buffer(:,:,:,29)=tve_d
      buffer(:,:,:,30:34)=spc_d
      if(air5_history_enabled) then
        history_stage=air5_step_history_d
        call checkpoint_state_require(all(ieee_is_finite(history_stage)).and.all(history_stage>=0.0_real_kind), &
          comm,'AIR5 invalid device step history')
        buffer(:,:,:,35)=0.0_real_kind
        buffer(h:h+cells(1),h:h+cells(2),h:h+cells(3),35)=history_stage
      endif
    else
      buffer=0.0_real_kind
    endif
    call checkpoint_state_transfer(path,writing,.true.,global_shape,origin,cells,halo, &
      buffer,identity,remaining,comm,role=7,metadata=metadata,allow_repartition=permit,restored_exact=matched, &
      repartition_axes=repartition_axes)
    if(present(restored_exact)) restored_exact=matched
    call checkpoint_state_require(all(metadata==expected),comm,'AIR5 device compensation contract mismatch')
    if(.not.writing) then
      if(.not.matched) then
        call checkpoint_state_require(present(refresh_halos),comm,'AIR5 device repartition halo provider missing')
        call refresh_halos(buffer,cells,halo,remaining,comm)
      endif
      q_d=buffer(:,:,:,1:11)
      if(air5_compensated) then
        carry_stage=buffer(h:h+cells(1),h:h+cells(2),h:h+cells(3),12:22)
        air5_carry_d=carry_stage
      endif
      rho_d=buffer(:,:,:,23)
      vel_d=buffer(:,:,:,24:26)
      prs_d=buffer(:,:,:,27)
      tmp_d=buffer(:,:,:,28)
      tve_d=buffer(:,:,:,29)
      spc_d=buffer(:,:,:,30:34)
      if(air5_history_enabled) then
        history_stage=buffer(h:h+cells(1),h:h+cells(2),h:h+cells(3),35)
        call checkpoint_state_require(all(ieee_is_finite(history_stage)).and.all(history_stage>=0.0_real_kind), &
          comm,'AIR5 invalid restored step history')
        air5_step_history_d=history_stage
      endif
      call sync_gpu_boundary('AIR5 complete-state transfer restore')
    endif
  end subroutine
#endif
  subroutine checkpoint_perfect_gas_gpu(path,writing,global_shape,origin,cells,halo,identity,budget,comm, &
                                       allow_repartition,restored_exact,refresh_halos,repartition_axes,exact)
    character(*),intent(in) :: path
    logical,intent(in) :: writing
    logical,optional,intent(in) :: allow_repartition
    logical,optional,intent(in) :: exact
    logical,optional,intent(in) :: repartition_axes(3)
    logical,optional,intent(out) :: restored_exact
    procedure(checkpoint_halo_refresh),optional :: refresh_halos
    integer,intent(in) :: global_shape(3),origin(3),cells(3),halo,comm
    type(checkpoint_state_identity),intent(inout) :: identity
    integer(int64),intent(in) :: budget
    real(real_kind),allocatable :: buffer(:,:,:,:)
    integer(int64) :: remaining
    integer :: extents(3)
    logical :: permit,matched,restore_exact
    permit=.false.
    if(present(allow_repartition)) permit=allow_repartition
    restore_exact=.true.
    if(present(exact)) restore_exact=exact
    call checkpoint_state_require(allocated(q_d).and.allocated(rho_d).and.allocated(vel_d).and. &
      allocated(prs_d).and.allocated(tmp_d),comm,'device state not initialized')
    call allocate_checkpoint_buffer(cells,halo,11,budget,buffer,remaining,comm)
    extents=shape(buffer(:,:,:,1))
    call checkpoint_state_require(all(shape(q_d)==[extents,5]).and.all(shape(rho_d)==extents).and. &
      all(shape(vel_d)==[extents,3]).and.all(shape(prs_d)==extents).and. &
      all(shape(tmp_d)==extents),comm,'device perfect-gas cache shape')
    call sync_gpu_boundary('complete-state transfer entry')
    if (writing) then
      buffer(:,:,:,1:5)=q_d
      buffer(:,:,:,6)=rho_d
      buffer(:,:,:,7:9)=vel_d
      buffer(:,:,:,10)=prs_d
      buffer(:,:,:,11)=tmp_d
    else
      buffer=0.e0_real_kind
    endif
    call checkpoint_state_transfer(path,writing,restore_exact,global_shape,origin,cells,halo, &
      buffer,identity,remaining,comm,role=2,allow_repartition=permit,restored_exact=matched, &
      repartition_axes=repartition_axes)
    if(present(restored_exact)) restored_exact=matched
    if (.not.writing) then
      if(.not.matched) then
        call checkpoint_state_require(present(refresh_halos),comm,'device repartition halo provider missing')
        call refresh_halos(buffer,cells,halo,remaining,comm)
      endif
      q_d=buffer(:,:,:,1:5)
      rho_d=buffer(:,:,:,6)
      vel_d=buffer(:,:,:,7:9)
      prs_d=buffer(:,:,:,10)
      tmp_d=buffer(:,:,:,11)
      call sync_gpu_boundary('complete-state transfer restore')
    endif
  end subroutine
end module
