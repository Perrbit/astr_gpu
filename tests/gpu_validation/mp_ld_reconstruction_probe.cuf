module mp_ld_probe_kernels
  use astr_precision, only: real_kind,real_bytes
  use cudafor
  use solver_gpu, only: reconstruct_mp_ld_stencil
  use, intrinsic :: ieee_arithmetic, only: ieee_is_finite
  implicit none
contains
  attributes(global) subroutine evaluate(stencils,result,weight,shock)
    real(real_kind),device :: stencils(8,12),result(-1:16,4,12)
    real(real_kind),value :: weight
    logical,value :: shock
    integer :: inode,ntype,sample
    inode=threadIdx%x-2
    ntype=blockIdx%x
    sample=blockIdx%y
    if(inode>16) return
    result(inode,ntype,sample)=reconstruct_mp_ld_stencil( &
      stencils(:,sample),inode,16,ntype,weight,shock)
  end subroutine evaluate

  attributes(global) subroutine evaluate_budget(base,correction,result)
    use mp_positivity_gpu, only: mp_face_budget
    real(real_kind),device :: base(5,4),correction(5,4),result(4)
    integer :: n
    n=threadIdx%x
    if(n<=4) result(n)=mp_face_budget(base(:,n),correction(:,n))
  end subroutine evaluate_budget

  function face_energy(g,axis) result(value)
    integer,intent(in) :: g(3),axis
    real(real_kind) :: value
    value=2.e0_real_kind*sin((real(modulo(g(axis),24),real_kind)+0.5e0_real_kind)* &
      2.e0_real_kind*acos(-1.e0_real_kind)/24.e0_real_kind)
  end function face_energy

  function node_ratio(g,dt,q0) result(theta)
    integer,intent(in) :: g(3)
    real(real_kind),intent(in) :: dt,q0(5)
    integer :: axis,left(3)
    real(real_kind) :: d(5),theta
    theta=1.e0_real_kind
    do axis=1,3
      left=g; left(axis)=left(axis)-1
      d=0.e0_real_kind; d(5)=6.e0_real_kind*dt/fixture_jacob(g)*face_energy(left,axis)
      theta=min(theta,host_budget(q0,d))
      d(5)=-6.e0_real_kind*dt/fixture_jacob(g)*face_energy(g,axis)
      theta=min(theta,host_budget(q0,d))
    enddo
  end function node_ratio

  function fixture_jacob(g) result(value)
    integer,intent(in) :: g(3)
    real(real_kind) :: value
    value=1.e0_real_kind+0.1e0_real_kind*sin(real(sum(modulo(g,24)),real_kind)* &
      2.e0_real_kind*acos(-1.e0_real_kind)/24.e0_real_kind)
  end function fixture_jacob

  logical function host_admissible(q)
    real(real_kind),intent(in) :: q(5)
    real(real_kind) :: conservative_kinetic,primitive_kinetic
    host_admissible=.false.
    if(.not.all(ieee_is_finite(q)).or.q(1)<=0.e0_real_kind) return
    conservative_kinetic=0.5e0_real_kind*sum(q(2:4)*(q(2:4)/q(1)))
    primitive_kinetic=0.5e0_real_kind*q(1)*sum((q(2:4)/q(1))**2)
    host_admissible=q(5)>conservative_kinetic.and.q(5)>primitive_kinetic
  end function host_admissible

  function host_budget(base,correction) result(theta)
    real(real_kind),intent(in) :: base(5),correction(5)
    real(real_kind) :: lo,hi,mid,theta
    integer :: iteration
    if(host_admissible(base+correction)) then
      theta=1.e0_real_kind
      return
    endif
    lo=0.e0_real_kind; hi=1.e0_real_kind
    do iteration=1,64
      mid=0.5e0_real_kind*(lo+hi)
      if(mid==lo.or.mid==hi) exit
      if(host_admissible(base+mid*correction)) then
        lo=mid
      else
        hi=mid
      endif
    enddo
    theta=lo*(1.e0_real_kind-256.e0_real_kind*epsilon(1.e0_real_kind))
  end function host_budget


end module mp_ld_probe_kernels

program mp_ld_reconstruction_probe
  use astr_precision, only: real_kind,real_bytes
  use astr_precision_mpi, only: mpi_real_type
  use mpi
  use, intrinsic :: ieee_arithmetic, only: ieee_is_finite,ieee_value,ieee_quiet_nan
  use cudafor
  use flux, only: recons_exp
  use commvar, only: bfacmpld
  use mp_ld_probe_kernels, only: evaluate,evaluate_budget,face_energy,node_ratio, &
    fixture_jacob,host_admissible,host_budget
  implicit none
  real(real_kind) :: samples(8,12),expected(-1:16,4,12),actual(-1:16,4,12)
  real(real_kind),allocatable,device :: samples_d(:,:),result_d(:,:,:)
  real(real_kind) :: weights(3)=[0.e0_real_kind,0.5e0_real_kind,1.e0_real_kind],error,max_error
  integer :: device,status,i,sample,ntype,inode,w,flag,ierr,nranks,rank,devices
  integer(8) :: free_bytes,total_bytes
  logical :: shock
  character(len=16) :: argument,mode_argument

  call MPI_Init(ierr)
  call MPI_Comm_size(MPI_COMM_WORLD,nranks,ierr)
  call MPI_Comm_rank(MPI_COMM_WORLD,rank,ierr)
  if(nranks/=1.and.nranks/=2.and.nranks/=4) error stop 'MP-LD probe admits NP=1/2/4'
  call get_command_argument(1,argument)
  if(trim(argument)=='rank') then
    status=cudaGetDeviceCount(devices)
    if(status/=cudaSuccess.or.devices<1) error stop 'MP-LD probe has no GPU'
    device=mod(rank,devices)
  else
    if(nranks/=1) error stop 'MPI probe requires rank device binding'
    read(argument,*) device
  endif
  status=cudaSetDevice(device)
  if(status/=cudaSuccess) error stop 'MP-LD device selection failed'
  status=cudaMemGetInfo(free_bytes,total_bytes)
  if(status/=cudaSuccess.or.free_bytes<1073741824_8) &
    error stop 'MP-LD free memory is below the approved floor'
  call get_command_argument(2,mode_argument)
  if(trim(mode_argument)=='wall-blowing'.or.trim(mode_argument)=='crashfix-order'.or. &
     trim(mode_argument)=='crashfix-expand'.or.trim(mode_argument)=='crashfix-check'.or. &
     trim(mode_argument)=='crashfix-filter') then
    call check_wall_blowing_repair()
    call MPI_Finalize(ierr)
    stop
  endif
  allocate(samples_d(8,12),result_d(-1:16,4,12))
  do i=1,8
    samples(i,1)=2.e0_real_kind
    samples(i,2)=0.125e0_real_kind*real(i-4,real_kind)
    samples(i,3)=sin(0.23e0_real_kind*real(i-4,real_kind))
    samples(i,4)=merge(-1.e0_real_kind,2.e0_real_kind,i<=4)
    samples(i,5)=merge(3.e0_real_kind,-2.e0_real_kind,mod(i,2)==0)
    samples(i,6)=exp(-0.5e0_real_kind*real(i-4,real_kind)**2)
  enddo
  do sample=1,6
    samples(:,sample+6)=samples(8:1:-1,sample)
  enddo
  samples_d=samples
  max_error=0.e0_real_kind
  do w=1,3
    bfacmpld=weights(w)
    do flag=0,1
      shock=flag==1
      do sample=1,12
        do ntype=1,4
          do inode=-1,16
            expected(inode,ntype,sample)=recons_exp( &
              samples(:,sample),inode,16,ntype,5,shock,.false.)
          enddo
        enddo
      enddo
      if(.not.all(ieee_is_finite(expected))) error stop 'MP-LD CPU reference is not finite'
      call evaluate<<<dim3(4,12,1),dim3(32,1,1)>>>(samples_d,result_d,bfacmpld,shock)
      status=cudaDeviceSynchronize()
      if(status/=cudaSuccess) error stop 'MP-LD reconstruction kernel failed'
      actual=result_d
      if(.not.all(ieee_is_finite(actual))) error stop 'MP-LD result is not finite'
      error=maxval(abs(actual-expected))
      max_error=max(error,max_error)
      if(real_bytes==8.and.error>2.e-10_real_kind) error stop 'MP-LD CPU/GPU reconstruction gate failed'
    enddo
  enddo
  deallocate(samples_d,result_d)
  print '(A,I0,A,ES12.4)', 'MP-LD GPU ',device,': PASS; max absolute error=',max_error
  if(nranks==1) call check_full_flux()
  call check_sponge()
  call check_mp_positivity()
  call MPI_Finalize(ierr)
contains

  subroutine check_wall_blowing_repair()
    use commvar, only: im,jm,km,hm,ia,ja,ka,numq,num_species,num_modequ,ndims, &
      flowtype,nondimen,lcomb,lfilter,lcracon,lkhomo,lihomo,ljhomo,lreport,lrestart, &
      gamma,mach,const2,const6,uinf,zmin,zmax,conschm,difschm,rkscheme,recon_schem, &
      lchardecomp,turbmode,npdci,npdcj,npdck,is,ie,js,je,ks,ke,nstep,ctime
    use commarray, only: q,rho,vel,prs,tmp,spc,x,bnorm_j0,nodestat,crinod
    use commarray_gpu, only: q_d,qsave_d,qrhs_d,rho_d,vel_d,prs_d,tmp_d,x_d, &
      jacob_d,dxi_d,shock_mask_d,bnorm_j0_d,crinod_d,sync_crashfix_mask_to_gpu
    use commvar_gpu, only: copy_commvar_to_gpu
    use parallel, only: mpirank,lio,jrk,jrkm,ig0,jg0,kg0,isize,jsize,ksize, &
      mpileft,mpiright,mpidown,mpiup,mpiback,mpifront
    use bc, only: noslip,bctype,wall_blowing_configured,wall_blowing_legacy_random, &
      wall_blowing_amplitude,wall_blowing_beta,wall_blowing_xa,wall_blowing_xb, &
      wall_blowing_xc,wall_blowing_nmod_t,wall_blowing_nmod_z,wall_blowing_phase
    use boundary_gpu, only: init_wall_blowing_gpu,prepare_legacy_wall_blowing_gpu, &
      wall_isothermal_noslip_y_kernel,release_boundary_gpu
    use wall_blowing_random, only: legacy_random_state_size,get_legacy_random_state,put_legacy_random_state
    use mp_positivity_gpu, only: configure_mp_positivity_gpu,mp_positivity_enabled,mp_inputs_need_repair_gpu, &
      build_mp_convection_gpu,release_mp_positivity_gpu
    use mainloop_gpu, only: repair_mp_stage_inputs_gpu
    use mainloop, only: fhand_err,crashfix
    use crashfix_gpu, only: repair_crashfix_state_gpu,release_crashfix_gpu
    use fludyna, only: q2fvar
    use halo_exchange_gpu, only: init_halo_transport_gpu,release_halo_exchange_buffers_gpu
    use halo_transport_gpu, only: release_host_buffers
    implicit none
    real(real_kind),parameter :: ratios(4)=[1.e0_real_kind,3.9e0_real_kind,4.e0_real_kind,4.1e0_real_kind], &
      p1=1.e-3_real_kind,tw=10.e0_real_kind
    real(real_kind),allocatable :: actual(:,:,:,:),field(:,:,:),velocity(:,:,:,:)
    integer,allocatable :: rng_before(:),rng_cpu(:),rng_gpu(:)
    real(real_kind) :: error,global_error,wall_min(3),vmin,vmax,global_vmin,global_vmax,pressure_ratio
    integer :: i,j,k,m,forcing,pressure_case,expected_calls,err,repaired_nodes,scenario
    logical,allocatable :: mask(:,:,:)
    logical :: ok,invalid,repaired,detect_only
    character(16) :: forcing_name,repair_option
    type(dim3) :: block,grid

    im=16; jm=8; km=16; numq=5; num_species=0; num_modequ=0; ndims=3
    ia=im*nranks; ja=jm; ka=km
    is=0; ie=im; js=0; je=jm; ks=0; ke=km
    mpirank=rank; lio=rank==0; jrk=0; jrkm=0
    ig0=rank*im; jg0=0; kg0=0
    isize=nranks; jsize=1; ksize=1
    mpileft=rank-1; mpiright=rank+1
    if(rank==0) mpileft=MPI_PROC_NULL
    if(rank==nranks-1) mpiright=MPI_PROC_NULL
    mpidown=MPI_PROC_NULL; mpiup=MPI_PROC_NULL; mpiback=rank; mpifront=rank
    npdci=0
    if(rank==0) npdci=1
    if(rank==nranks-1) npdci=2
    if(nranks==1) npdci=4
    npdcj=4; npdck=0
    flowtype='bl'; nondimen=.true.; lcomb=.false.; lfilter=.false.; lcracon=.true.
    call get_command_argument(3,repair_option)
    detect_only=trim(repair_option)=='detect-only'
    if(detect_only) lcracon=.false.
    lihomo=.false.; ljhomo=.false.; lkhomo=.true.; lrestart=.false.; lreport=.false.
    conschm='743e'; difschm='643e'; rkscheme='rk3'; recon_schem=5; lchardecomp=.true.
    turbmode='none'; gamma=1.4e0_real_kind; mach=12.e0_real_kind; bfacmpld=0.5e0_real_kind
    const2=gamma*mach**2; const6=1.e0_real_kind/(gamma-1.e0_real_kind)
    uinf=1.e0_real_kind; zmin=0.e0_real_kind; zmax=16.e0_real_kind; nstep=0; ctime=0.e0_real_kind
    bctype=[11,22,41,52,1,1]
    wall_blowing_configured=.true.; wall_blowing_legacy_random=.true.
    wall_blowing_beta=0.e0_real_kind; wall_blowing_xa=20.e0_real_kind
    wall_blowing_xb=40.e0_real_kind; wall_blowing_xc=60.e0_real_kind
    wall_blowing_nmod_t=1; wall_blowing_nmod_z=3; wall_blowing_phase=0.e0_real_kind
    call copy_commvar_to_gpu()
    call configure_mp_positivity_gpu()
    call init_halo_transport_gpu()
    open(newunit=fhand_err,status='scratch',form='formatted',action='write')
    allocate(q(-hm:im+hm,-hm:jm+hm,-hm:km+hm,5),vel(-hm:im+hm,-hm:jm+hm,-hm:km+hm,3))
    allocate(rho(-hm:im+hm,-hm:jm+hm,-hm:km+hm),prs(-hm:im+hm,-hm:jm+hm,-hm:km+hm))
    allocate(tmp(-hm:im+hm,-hm:jm+hm,-hm:km+hm),spc(-hm:im+hm,-hm:jm+hm,-hm:km+hm,0))
    allocate(x(-hm:im+hm,-hm:jm+hm,-hm:km+hm,3),bnorm_j0(0:im,0:km,3))
    allocate(nodestat(-hm:im+hm,-hm:jm+hm,-hm:km+hm),crinod(-hm:im+hm,-hm:jm+hm,-hm:km+hm))
    allocate(q_d(-hm:im+hm,-hm:jm+hm,-hm:km+hm,5),qsave_d(0:im,0:jm,0:km,5))
    allocate(qrhs_d(0:im,0:jm,0:km,5),vel_d(-hm:im+hm,-hm:jm+hm,-hm:km+hm,3))
    allocate(rho_d(-hm:im+hm,-hm:jm+hm,-hm:km+hm),prs_d(-hm:im+hm,-hm:jm+hm,-hm:km+hm))
    allocate(tmp_d(-hm:im+hm,-hm:jm+hm,-hm:km+hm),x_d(-hm:im+hm,-hm:jm+hm,-hm:km+hm,3))
    allocate(jacob_d(-hm:im+hm,-hm:jm+hm,-hm:km+hm))
    allocate(dxi_d(-hm:im+hm,-hm:jm+hm,-hm:km+hm,3,3),shock_mask_d(0:im,0:jm,0:km))
    allocate(bnorm_j0_d(0:im,0:km,3))
    allocate(actual,mold=q); allocate(field,mold=rho); allocate(velocity,mold=vel)
    allocate(rng_before(legacy_random_state_size()),rng_cpu(legacy_random_state_size()), &
      rng_gpu(legacy_random_state_size()))
    rng_before=0
    call put_legacy_random_state(rng_before,ok)
    if(.not.ok) error stop 'wall fixture RNG reset failed'
    bnorm_j0=0.e0_real_kind; bnorm_j0(:,:,2)=1.e0_real_kind; bnorm_j0_d=bnorm_j0
    do k=-hm,km+hm
    do j=-hm,jm+hm
    do i=-hm,im+hm
      x(i,j,k,:)=[20.e0_real_kind+40.e0_real_kind*real(ig0+i,real_kind)/real(ia,real_kind), &
        0.01e0_real_kind*real(j,real_kind),real(k,real_kind)]
    enddo
    enddo
    enddo
    x_d=x; jacob_d=1.e0_real_kind; dxi_d=0.e0_real_kind; shock_mask_d=0_1
    do m=1,3
      dxi_d(:,:,:,m,m)=1.e0_real_kind
    enddo
    if(trim(mode_argument)=='crashfix-expand'.or.trim(mode_argument)=='crashfix-check'.or. &
       trim(mode_argument)=='crashfix-filter') then
      call check_expanding_crashfix(actual)
      call release_crashfix_gpu()
      close(fhand_err)
      return
    endif
    if(trim(mode_argument)=='crashfix-order') then
      allocate(mask,mold=crinod)
      do scenario=1,4
        rho=1.e0_real_kind; prs=1.e-3_real_kind; tmp=prs*const2; vel=0.e0_real_kind; vel(:,:,:,1)=0.2e0_real_kind
        q(:,:,:,1)=rho; q(:,:,:,2)=rho*0.2e0_real_kind; q(:,:,:,3:4)=0.e0_real_kind
        q(:,:,:,5)=prs*const6+0.5e0_real_kind*rho*0.2e0_real_kind**2
        ! Asymmetric neighbors make an accidentally simultaneous average fail.
        do k=-hm,km+hm
        do j=-hm,jm+hm
        do i=-hm,im+hm
          q(i,j,k,5)=q(i,j,k,5)+1.e-5_real_kind*real(i+2*j+3*k+6*hm,real_kind)
        enddo
        enddo
        enddo
        nodestat=0; crinod=.false.; qsave_d=777.e0_real_kind
        q(2,2,2,1)=-1.e0_real_kind; q(3,2,2,1)=-2.e0_real_kind; q(3,3,2,5)=-1.e0_real_kind
        q(0,0,0,1)=-1.e0_real_kind; q(im,jm,km,1)=-1.e0_real_kind
        if(scenario==2) q(2,2,2,5)=ieee_value(0.e0_real_kind,ieee_quiet_nan)
        if(scenario==3) then
          q(2,2,2,:)=q(1,1,1,:)*1.e-6_real_kind
          q(2,2,2,5)=1.e-20_real_kind
          q(2,2,2,2:4)=0.e0_real_kind
        endif
        if(scenario==4) then
          nodestat(3,3,2)=1
          nodestat(1,2,2)=1
        endif
        do k=-hm,km+hm
        do j=-hm,jm+hm
        do i=-hm,im+hm
          if(.not.all(ieee_is_finite(q(i,j,k,:))).or.q(i,j,k,1)<=0.e0_real_kind.or.q(i,j,k,5)<=0.e0_real_kind) then
            rho(i,j,k)=q(i,j,k,1); vel(i,j,k,:)=0.e0_real_kind
            prs(i,j,k)=-1.e0_real_kind; tmp(i,j,k)=-1.e0_real_kind
          else
            call q2fvar(q(i,j,k,:),rho(i,j,k),vel(i,j,k,:),prs(i,j,k),tmp(i,j,k),spc(i,j,k,:))
          endif
        enddo
        enddo
        enddo
        q_d=q; rho_d=rho; vel_d=vel; prs_d=prs; tmp_d=tmp
        call sync_crashfix_mask_to_gpu()
        call release_crashfix_gpu()
        call crashfix(repaired_nodes=repaired_nodes)
        call repair_crashfix_state_gpu(scenario)
        actual=q_d; mask=crinod_d
        if(any(mask.neqv.crinod)) error stop 'GPU critical-node history differs from CPU'
        error=0.e0_real_kind
        do k=0,km
        do j=0,jm
        do i=0,im
          if(nodestat(i,j,k)>0) cycle
          if(.not.all(ieee_is_finite(actual(i,j,k,:)))) error stop 'GPU ordered repair left nonfinite q'
          error=max(error,maxval(abs(actual(i,j,k,:)-q(i,j,k,:))))
        enddo
        enddo
        enddo
        field=rho_d; error=max(error,maxval(abs(field-rho)))
        field=prs_d; error=max(error,maxval(abs(field-prs)))
        field=tmp_d; error=max(error,maxval(abs(field-tmp)))
        velocity=vel_d; error=max(error,maxval(abs(velocity-vel)))
        call MPI_Allreduce(error,global_error,1,mpi_real_type,MPI_MAX,MPI_COMM_WORLD,err)
        if(real_bytes==8.and.global_error>2.e-10_real_kind) error stop 'GPU ordered repair differs from original CPU crashfix'
        q=actual
        actual(0:im,0:jm,0:km,:)=qsave_d
        if(any(actual(0:im,0:jm,0:km,:)/=777.e0_real_kind)) error stop 'GPU repair changed RK origin'
        if(rank==0) write(*,'(a,2(1x,i0),1x,es15.7)') 'GPU_CRASHFIX_ORDER',scenario,repaired_nodes,global_error
        ! A second call must not lose critical-node history or change healthy q.
        call repair_crashfix_state_gpu(scenario)
        actual=q_d; mask=crinod_d
        if(any(mask.neqv.crinod)) error stop 'GPU critical-node history was overwritten'
        if(any(actual/=q)) error stop 'GPU healthy repair changed the repaired state'
      enddo
      deallocate(mask)
      if(rank==0) print *, 'GPU ordered crashfix: PASS; cases=4 ranks=',nranks
      call release_crashfix_gpu()
      close(fhand_err)
      return
    endif
    block=dim3(256,1,1); grid=dim3(((im+1)*(km+1)+255)/256,1,1)
    do forcing=0,1
      forcing_name='off'
      wall_blowing_amplitude=0.e0_real_kind
      if(forcing==1) then
        forcing_name='legacy_random'; wall_blowing_amplitude=0.12e0_real_kind
      endif
      call init_wall_blowing_gpu()
      do pressure_case=1,size(ratios)
        pressure_ratio=1.e0_real_kind
        if(rank==0) pressure_ratio=ratios(pressure_case)
        prs=p1; prs(:,2,:)=pressure_ratio*p1; tmp=1.e0_real_kind; rho=prs*const2
        vel=0.e0_real_kind; vel(:,:,:,1)=uinf
        q(:,:,:,1)=rho; q(:,:,:,2)=rho*uinf; q(:,:,:,3:4)=0.e0_real_kind
        q(:,:,:,5)=prs*const6+0.5e0_real_kind*rho*uinf**2
        nodestat=0; crinod=.false.; qsave_d=777.e0_real_kind; qrhs_d=0.e0_real_kind
        q_d=q; rho_d=rho; prs_d=prs; tmp_d=tmp; vel_d=vel
        call sync_crashfix_mask_to_gpu()
        call get_legacy_random_state(rng_before)
        call noslip(3,tw)
        call get_legacy_random_state(rng_cpu)
        call put_legacy_random_state(rng_before,ok)
        if(.not.ok) error stop 'wall fixture RNG restore failed'
        call prepare_legacy_wall_blowing_gpu(1)
        call wall_isothermal_noslip_y_kernel<<<grid,block>>>(im,jm,km,hm,const2,const6,tw,tw,1,0,0,0.e0_real_kind)
        call synchronize('synthetic bc41 wall blowing')
        call get_legacy_random_state(rng_gpu)
        if(any(rng_cpu/=rng_gpu)) error stop 'CPU/GPU wall draw order differs'
        actual=q_d
        error=maxval(abs(actual-q))
        call MPI_Allreduce(error,global_error,1,mpi_real_type,MPI_MAX,MPI_COMM_WORLD,err)
        if(real_bytes==8.and.global_error>2.e-10_real_kind) error stop 'synthetic wall CPU/GPU mismatch'
        if(trim(repair_option)=='no-neighbor') then
          q_d=0.e0_real_kind; q_d(:,:,:,1)=-1.e0_real_kind; q_d(:,:,:,5)=-1.e0_real_kind
          rho_d=-1.e0_real_kind; prs_d=-1.e0_real_kind; tmp_d=-1.e0_real_kind
          call repair_mp_stage_inputs_gpu(1,'synthetic no valid neighbor')
          error stop 'unrepairable state was accepted'
        endif
        invalid=mp_inputs_need_repair_gpu()
        if(invalid.neqv.(ratios(pressure_case)>=4.e0_real_kind)) error stop 'synthetic wall did not reproduce input failure'
        if(rank==0) write(*,'(a,1x,a,1x,f5.2,2(1x,es15.7))') &
          'MP_WALL_INPUT',trim(forcing_name),ratios(pressure_case),minval(prs(:,0,:)),minval(rho(:,0,:))
        vmin=minval(vel(:,0,:,2)); vmax=maxval(vel(:,0,:,2))
        call MPI_Allreduce(vmin,global_vmin,1,mpi_real_type,MPI_MIN,MPI_COMM_WORLD,err)
        call MPI_Allreduce(vmax,global_vmax,1,mpi_real_type,MPI_MAX,MPI_COMM_WORLD,err)
        if(forcing==1.and.(global_vmin>=0.e0_real_kind.or.global_vmax<=0.e0_real_kind)) &
          error stop 'fixture must contain both blowing and suction'
        q=-777.e0_real_kind
        call repair_mp_stage_inputs_gpu(1,'synthetic bc41',repaired)
        if(any(q/=-777.e0_real_kind)) error stop 'GPU repair unexpectedly downloaded or used the host flow field'
        if(detect_only.and.invalid) call build_mp_convection_gpu()
        expected_calls=merge(1,0,ratios(pressure_case)>=4.e0_real_kind)
        if(merge(1,0,repaired)/=expected_calls.or.(repaired.neqv.invalid)) error stop 'MP repair trigger mismatch'
        if(mp_inputs_need_repair_gpu()) error stop 'MP input repair left an invalid physical state'
        actual=q_d; field=rho_d; wall_min(1)=minval(field(0:im,0,0:km))
        if(any(field/=actual(:,:,:,1))) error stop 'repaired density cache mismatch'
        velocity=vel_d
        do m=1,3
          if(real_bytes==8.and.maxval(abs(velocity(:,:,:,m)-actual(:,:,:,m+1)/field))>2.e-10_real_kind) &
            error stop 'repaired velocity cache mismatch'
        enddo
        field=prs_d; wall_min(2)=minval(field(0:im,0,0:km))
        if(real_bytes==8.and.maxval(abs(field-(actual(:,:,:,5)-0.5e0_real_kind*actual(:,:,:,1)* &
          sum(velocity*velocity,dim=4))/const6))>2.e-10_real_kind) error stop 'repaired pressure cache mismatch'
        field=tmp_d; wall_min(3)=minval(field(0:im,0,0:km))
        if(any(wall_min<=0.e0_real_kind)) error stop 'repaired wall state is not positive'
        call get_legacy_random_state(rng_before)
        if(any(rng_before/=rng_gpu)) error stop 'repair advanced wall RNG'
        if(mp_positivity_enabled) call build_mp_convection_gpu()
        actual(0:im,0:jm,0:km,:)=qsave_d
        if(any(actual(0:im,0:jm,0:km,:)/=777.e0_real_kind)) error stop 'input repair changed RK origin'
        if(rank==0) write(*,'(a,1x,a,1x,f5.2,1x,i0,6(1x,es15.7))') &
          'MP_WALL_REPAIR',trim(forcing_name),ratios(pressure_case),merge(1,0,repaired), &
          global_error,global_vmin,global_vmax,wall_min
        if(forcing==1.and.pressure_case==4.and.index(trim(repair_option),'history')==1) &
          call check_repaired_history(trim(repair_option))
      enddo
    enddo
    close(fhand_err)
    call release_boundary_gpu()
    call release_mp_positivity_gpu()
    call release_crashfix_gpu()
    call release_host_buffers()
    call release_halo_exchange_buffers_gpu()
    deallocate(q,rho,vel,prs,tmp,spc,x,bnorm_j0,nodestat,crinod)
    deallocate(q_d,qsave_d,qrhs_d,rho_d,vel_d,prs_d,tmp_d,x_d,jacob_d,dxi_d,shock_mask_d,bnorm_j0_d)
    if(rank==0) print *, 'MP wall blowing input repair: PASS; cases=8 ranks=',nranks
  end subroutine check_wall_blowing_repair

  subroutine check_expanding_crashfix(actual)
    use astr_precision, only: real_to_word
    use commvar, only: im,jm,km,hm,const2,const6
    use commarray, only: q,rho,vel,prs,tmp,spc,nodestat,crinod
    use commarray_gpu, only: q_d,qsave_d,rho_d,vel_d,prs_d,tmp_d,crinod_d,sync_crashfix_mask_to_gpu
    use crashfix_gpu, only: repair_crashfix_state_gpu,release_crashfix_gpu,check_crashfix_state_gpu
    use mainloop_gpu, only: repair_filtered_state_gpu
    real(real_kind),intent(inout) :: actual(-hm:im+hm,-hm:jm+hm,-hm:km+hm,5)
    real(real_kind) :: reference_state(5),error,global_error
    integer :: scenario,m,err,first_scenario,last_scenario
    logical,allocatable :: mask(:,:,:)
    allocate(mask,mold=crinod)
    first_scenario=1; last_scenario=3
    if(trim(mode_argument)=='crashfix-filter') then
      first_scenario=4; last_scenario=4
    endif
    do scenario=first_scenario,last_scenario
      if(scenario==2.and.nranks==1) cycle
      reference_state=[1.e0_real_kind,0.2e0_real_kind,0.e0_real_kind,0.e0_real_kind, &
        1.e-3_real_kind*const6+0.5e0_real_kind*0.2e0_real_kind**2]
      if(scenario==3) reference_state=[huge(1.e0_real_kind)/16.e0_real_kind, &
        huge(1.e0_real_kind)/80.e0_real_kind,0.e0_real_kind,0.e0_real_kind,huge(1.e0_real_kind)/16.e0_real_kind]
      if(scenario==3.and.trim(mode_argument)=='crashfix-check') reference_state=12.e0_real_kind*reference_state
      call seed_recovery_entry(scenario,reference_state)
      q_d=q; rho_d=rho; vel_d=vel; prs_d=prs; tmp_d=tmp
      call sync_crashfix_mask_to_gpu()
      call release_crashfix_gpu()
      q=-777.e0_real_kind
      select case(trim(mode_argument))
      case('crashfix-check')
        call check_crashfix_state_gpu()
      case('crashfix-filter')
        call repair_filtered_state_gpu(scenario)
      case default
        call repair_crashfix_state_gpu(scenario)
      end select
      if(any(q/=-777.e0_real_kind)) error stop 'expanded repair downloaded the host flow'
      actual=q_d; mask=crinod_d
      if(.not.all(ieee_is_finite(actual(0:im,0:jm,0:km,:)))) error stop 'expanded repair left nonfinite q'
      error=0.e0_real_kind
      do m=1,5
        error=max(error,maxval(abs((actual(0:im,0:jm,0:km,m)-reference_state(m))/ &
          max(1.e0_real_kind,abs(reference_state(m))))))
      enddo
      call MPI_Allreduce(error,global_error,1,mpi_real_type,MPI_MAX,MPI_COMM_WORLD,err)
      if(global_error>1000.e0_real_kind*epsilon(1.e0_real_kind)) error stop 'expanded repair differs from valid donor state'
      if(.not.mask(im+hm,jm+hm,km+hm)) error stop 'expanded repair lost previous critical history'
      q=actual
      if(trim(mode_argument)=='crashfix-check') then
        call check_crashfix_state_gpu()
      else
        call repair_crashfix_state_gpu(scenario)
      endif
      actual=q_d
      if(any(real_to_word(actual)/=real_to_word(q))) error stop 'expanded repair changes healthy q on a second call'
      actual(0:im,0:jm,0:km,:)=qsave_d
      if(any(actual(0:im,0:jm,0:km,:)/=777.e0_real_kind)) error stop 'expanded repair changed RK origin'
      if(rank==0) write(*,'(a,2(1x,i0),1x,es15.7)') 'GPU_CRASHFIX_EXPAND',scenario,nranks,global_error
    enddo
    if(rank==0) print *, 'GPU expanding crashfix: PASS; ranks=',nranks
  end subroutine check_expanding_crashfix

  subroutine seed_recovery_entry(scenario,reference_state)
    use commvar, only: im,jm,km,hm,const2,const6
    use commarray, only: q,rho,vel,prs,tmp,spc,nodestat,crinod
    use commarray_gpu, only: qsave_d
    use fludyna, only: q2fvar
    integer,intent(in) :: scenario
    real(real_kind),intent(in) :: reference_state(5)
    integer :: i,j,k,m
    do m=1,5
      q(:,:,:,m)=reference_state(m)
    enddo
    if(scenario==1) then
      q=ieee_value(0.e0_real_kind,ieee_quiet_nan)
      q(im-1,jm-1,km/2,:)=reference_state
    elseif(scenario==2) then
      if(rank<nranks-1) q=ieee_value(0.e0_real_kind,ieee_quiet_nan)
    elseif(scenario==4) then
      q=ieee_value(0.e0_real_kind,ieee_quiet_nan)
      if(rank==nranks-1) q(0,jm/2,km/2,:)=reference_state
    else
      q(im/2,jm/2,km/2,1)=-1.e0_real_kind
      q(im/2,jm/2,km/2,5)=-1.e0_real_kind
    endif
    nodestat=0; crinod=.false.; crinod(im+hm,jm+hm,km+hm)=.true.; qsave_d=777.e0_real_kind
    do k=-hm,km+hm
    do j=-hm,jm+hm
    do i=-hm,im+hm
      if(.not.all(ieee_is_finite(q(i,j,k,:))).or.q(i,j,k,1)<=0.e0_real_kind) then
        rho(i,j,k)=q(i,j,k,1); vel(i,j,k,:)=0.e0_real_kind
        prs(i,j,k)=-1.e0_real_kind; tmp(i,j,k)=-1.e0_real_kind
      else
        call q2fvar(q(i,j,k,:),rho(i,j,k),vel(i,j,k,:),prs(i,j,k),tmp(i,j,k),spc(i,j,k,:))
      endif
    enddo
    enddo
    enddo
  end subroutine seed_recovery_entry

  subroutine check_repaired_history(option)
    use iso_fortran_env, only: int64
    use commvar, only: im,jm,km,hm,lcracon
    use commarray_gpu, only: q_d,qrhs_d,crinod_d,crashfix_enabled_d
    use checkpoint_state_io, only: checkpoint_state_identity,checkpoint_crashfix_state
    use checkpoint_state_gpu, only: checkpoint_perfect_gas_gpu,checkpoint_crashfix_gpu
    use mp_positivity_gpu, only: build_mp_convection_gpu
    use parallel, only: ig0,jg0,kg0
    implicit none
    character(*),intent(in) :: option
    type(checkpoint_state_identity) :: identity
    real(real_kind),allocatable :: reference(:,:,:,:),actual(:,:,:,:),rhs(:,:,:,:)
    logical,allocatable :: history(:,:,:),actual_history(:,:,:)
    integer :: mode,id,i,j,k,nx,ny
    character(32) :: filename
    logical :: matched
    allocate(history(-hm:im+hm,-hm:jm+hm,-hm:km+hm),actual_history(-hm:im+hm,-hm:jm+hm,-hm:km+hm))
    history=crinod_d
    if(rank==0.and..not.any(history(0:im,0:jm,0:km))) error stop 'history test needs actual repaired nodes'
    ! Include all-ones words, word boundaries and the final padded word.
    nx=im+2*hm+1; ny=jm+2*hm+1
    do id=0,130
      i=mod(id,nx)-hm; j=mod(id/nx,ny)-hm; k=id/(nx*ny)-hm
      history(i,j,k)=.true.
    enddo
    history(im+hm,jm+hm,km+hm)=.true.
    crinod_d=history
    allocate(reference,mold=q_d); allocate(actual,mold=q_d); allocate(rhs,mold=qrhs_d)
    reference=q_d
    do mode=1,2
      lcracon=mode==1
      filename='history-enabled.h5'
      if(mode==2) filename='history-disabled.h5'
      identity=checkpoint_state_identity(1_int64,0.02e0_real_kind,0.02e0_real_kind,0.02e0_real_kind)
      qrhs_d=0.e0_real_kind
      call build_mp_convection_gpu()
      rhs=qrhs_d
      call checkpoint_perfect_gas_gpu(filename,.true.,[im*nranks,jm,km]+1,[ig0,jg0,kg0], &
        [im,jm,km],hm,identity,67108864_int64,MPI_COMM_WORLD,restored_exact=matched)
      if(option/='history-missing') call checkpoint_crashfix_gpu(filename,.true., &
        67108864_int64,67108864_int64,MPI_COMM_WORLD,matched)
      if(option=='history-mode') lcracon=.false.
      if(option=='history-topology') matched=.false.
      if(option/='history') then
        call checkpoint_crashfix_gpu(filename,.false.,67108864_int64,67108864_int64,MPI_COMM_WORLD,matched)
        error stop 'invalid history restart was accepted'
      endif
      actual_history=.false.
      call checkpoint_crashfix_state(filename,.false.,actual_history,lcracon,67108864_int64,MPI_COMM_WORLD,.true.)
      if(any(actual_history.neqv.history)) error stop 'CPU read of device crashfix history differs'
      q_d=-777.e0_real_kind; crinod_d=.false.; crashfix_enabled_d=.false.
      call checkpoint_perfect_gas_gpu(filename,.false.,[im*nranks,jm,km]+1,[ig0,jg0,kg0], &
        [im,jm,km],hm,identity,67108864_int64,MPI_COMM_WORLD,restored_exact=matched)
      call checkpoint_crashfix_gpu(filename,.false.,67108864_int64,67108864_int64,MPI_COMM_WORLD,matched)
      actual=q_d; actual_history=crinod_d
      if(any(actual/=reference).or.any(actual_history.neqv.history)) error stop 'GPU repaired checkpoint differs'
      qrhs_d=0.e0_real_kind
      call build_mp_convection_gpu()
      actual(0:im,0:jm,0:km,:)=qrhs_d
      if(any(actual(0:im,0:jm,0:km,:)/=rhs)) error stop 'history restart changed MP convection'
      if(rank==0) print *, 'GPU repaired history roundtrip: PASS; mode=',mode,' ranks=',nranks
    enddo
    lcracon=.true.
  end subroutine check_repaired_history

  subroutine check_mp_positivity()
    use commvar, only: im,jm,km,hm,is,ie,js,je,ks,ke,numq,ndims,lihomo,ljhomo,lkhomo
    use commarray_gpu, only: q_d,qsave_d,qrhs_d,jacob_d
    use parallel, only: isize,jsize,ksize,mpileft,mpiright,mpidown,mpiup,mpiback,mpifront,ig0,jg0,kg0
    use halo_exchange_gpu, only: init_halo_transport_gpu,release_halo_exchange_buffers_gpu
    use halo_transport_gpu, only: release_host_buffers
    use mp_positivity_gpu, only: high_d,delta_d,ratio_d,allocate_mp_positivity_gpu, &
      release_mp_positivity_gpu,exchange_mp_planes,limit_mp_update_gpu
    implicit none
    real(real_kind) :: base(5,4),correction(5,4),budgets(4),reference(4),dt
    real(real_kind) :: q0(5),tl,tr,theta,error,global_error,energy_sum,global_sum,scale
    real(real_kind),parameter :: a(3)=[1.e0_real_kind,0.75e0_real_kind,1.e0_real_kind/3.e0_real_kind], &
      b(3)=[0.e0_real_kind,0.25e0_real_kind,2.e0_real_kind/3.e0_real_kind], &
      c(3)=[1.e0_real_kind,0.25e0_real_kind,2.e0_real_kind/3.e0_real_kind]
    real(real_kind),allocatable,device :: bases_d(:,:),corrections_d(:,:),budgets_d(:)
    real(real_kind),allocatable :: values(:,:,:,:),expected(:,:,:,:),rhs(:,:,:,:),jac(:,:,:)
    real(real_kind),allocatable :: high(:,:,:,:,:),delta(:,:,:,:,:)
    integer :: ir,jr,kr,g(3),neighbor(3),axis,j,k,m,mode,stage,global_dim(3),local_dim(3)
    character(32) :: option

    base(:,1)=[1.e0_real_kind,2.e0_real_kind,-0.1e0_real_kind,0.3e0_real_kind,2.6e0_real_kind]
    base(:,2)=base(:,1); base(:,3)=base(:,1); base(:,4)=base(:,1)
    correction=0.e0_real_kind
    correction(5,1)=-1.e0_real_kind; correction(2,2)=2.e0_real_kind
    correction(1,3)=-2.e0_real_kind; correction(5,4)=1.e0_real_kind
    allocate(bases_d(5,4),corrections_d(5,4),budgets_d(4))
    bases_d=base; corrections_d=correction
    call evaluate_budget<<<dim3(1,1,1),dim3(32,1,1)>>>(bases_d,corrections_d,budgets_d)
    call synchronize('MP face budget')
    budgets=budgets_d
    do m=1,4
      reference(m)=host_budget(base(:,m),correction(:,m))
    enddo
    if(.not.all(ieee_is_finite(budgets))) error stop 'nonfinite MP face budgets'
    print '(A,ES15.7)', 'MP face budget CPU/GPU absolute difference=',maxval(abs(budgets-reference))
    if(real_bytes==8.and.maxval(abs(budgets-reference))>2.e-10_real_kind) &
      error stop 'MP density/pressure CPU/GPU budget mismatch'
    if(any(budgets(1:3)>=1.e0_real_kind).or.budgets(4)/=1.e0_real_kind) error stop 'MP budget fixture did not limit'
    deallocate(bases_d,corrections_d,budgets_d)

    global_dim=[24,24,24]
    local_dim=global_dim/[isize,jsize,ksize]
    im=local_dim(1); jm=local_dim(2); km=local_dim(3); numq=5; ndims=3
    if(min(im,jm,km)<hm) error stop 'MP positivity fixture local extent is smaller than halo'
    is=0; ie=im; js=0; je=jm; ks=0; ke=km
    ir=mod(rank,isize); jr=mod(rank/isize,jsize); kr=rank/(isize*jsize)
    ig0=ir*im; jg0=jr*jm; kg0=kr*km
    mpileft=mod(ir-1+isize,isize)+jr*isize+kr*isize*jsize
    mpiright=mod(ir+1,isize)+jr*isize+kr*isize*jsize
    mpidown=ir+mod(jr-1+jsize,jsize)*isize+kr*isize*jsize
    mpiup=ir+mod(jr+1,jsize)*isize+kr*isize*jsize
    mpiback=ir+jr*isize+mod(kr-1+ksize,ksize)*isize*jsize
    mpifront=ir+jr*isize+mod(kr+1,ksize)*isize*jsize
    lihomo=.true.; ljhomo=.true.; lkhomo=.true.
    call init_halo_transport_gpu()
    allocate(q_d(-hm:im+hm,-hm:jm+hm,-hm:km+hm,5),qsave_d(-hm:im+hm,-hm:jm+hm,-hm:km+hm,5))
    allocate(qrhs_d(-hm:im+hm,-hm:jm+hm,-hm:km+hm,5),jacob_d(-hm:im+hm,-hm:jm+hm,-hm:km+hm))
    allocate(values(-hm:im+hm,-hm:jm+hm,-hm:km+hm,5))
    allocate(expected,mold=values)
    allocate(rhs,mold=values)
    call allocate_mp_positivity_gpu()
    allocate(high(-1:im,-1:jm,-1:km,5,3))
    allocate(delta,mold=high)
    allocate(jac(-hm:im+hm,-hm:jm+hm,-hm:km+hm))
    do k=-hm,km+hm
    do j=-hm,jm+hm
    do i=-hm,im+hm
      jac(i,j,k)=fixture_jacob([i+ig0,j+jg0,k+kg0])
    enddo
    enddo
    enddo
    q0=[1.e0_real_kind,1.e0_real_kind,0.2e0_real_kind,-0.1e0_real_kind,0.625e0_real_kind]
    option=''
    call get_command_argument(3,option)
    do mode=1,2
    do stage=1,3
      dt=0.2e0_real_kind
      if(mode==2) dt=1.e-5_real_kind
      scale=c(stage)*dt
      do m=1,5
        values(:,:,:,m)=q0(m)
      enddo
      rhs=0.e0_real_kind; high=0.e0_real_kind
      do k=0,km
      do j=0,jm
      do i=0,im
        g=[i+ir*im,j+jr*jm,k+kr*km]
        do axis=1,3
          neighbor=g; neighbor(axis)=neighbor(axis)-1
          rhs(i,j,k,5)=rhs(i,j,k,5)-face_energy(g,axis)+face_energy(neighbor,axis)
        enddo
      enddo
      enddo
      enddo
      do axis=1,3
      do k=-1,km
      do j=-1,jm
      do i=-1,im
        g=[i+ir*im,j+jr*jm,k+kr*km]
        high(i,j,k,5,axis)=face_energy(g,axis)
      enddo
      enddo
      enddo
      enddo
      delta=high
      ! Deliberately corrupt ghost faces; the owning rank must replace them.
      high(-1,:,:,5,1)=99.e0_real_kind; delta(-1,:,:,5,1)=99.e0_real_kind
      high(:,-1,:,5,2)=99.e0_real_kind; delta(:,-1,:,5,2)=99.e0_real_kind
      high(:,:,-1,5,3)=99.e0_real_kind; delta(:,:,-1,5,3)=99.e0_real_kind
      q_d=values; jacob_d=jac
      do m=1,5
        values(:,:,:,m)=q0(m)*jac
      enddo
      qsave_d=values
      if(trim(option)=='baseline_bad') rhs(:,:,:,5)=rhs(:,:,:,5)-100.e0_real_kind
      qrhs_d=rhs; high_d=high; delta_d=delta
      do axis=1,3
        call exchange_mp_planes(axis,1)
      enddo
      call limit_mp_update_gpu(dt,a(stage),b(stage),c(stage),stage)
      values=qrhs_d
      expected=rhs
      do k=0,km
      do j=0,jm
      do i=0,im
        g=[i+ir*im,j+jr*jm,k+kr*km]
        theta=node_ratio(g,scale,q0)
        do axis=1,3
          neighbor=g; neighbor(axis)=neighbor(axis)+1
          tr=min(theta,node_ratio(neighbor,scale,q0))
          neighbor=g; neighbor(axis)=neighbor(axis)-1
          tl=min(theta,node_ratio(neighbor,scale,q0))
          expected(i,j,k,5)=expected(i,j,k,5)+(1.e0_real_kind-tr)*face_energy(g,axis)- &
            (1.e0_real_kind-tl)*face_energy(neighbor,axis)
        enddo
        if(.not.host_admissible(q0+scale*values(i,j,k,:)/jac(i,j,k))) &
          error stop 'MP limited fixture is not positive'
      enddo
      enddo
      enddo
      error=maxval(abs(values(0:im,0:jm,0:km,:)-expected(0:im,0:jm,0:km,:)))
      call MPI_Allreduce(error,global_error,1,mpi_real_type,MPI_MAX,MPI_COMM_WORLD,ierr)
      energy_sum=sum(values(0:im-1,0:jm-1,0:km-1,5))
      call MPI_Allreduce(energy_sum,global_sum,1,mpi_real_type,MPI_SUM,MPI_COMM_WORLD,ierr)
      if(.not.ieee_is_finite(global_error).or..not.ieee_is_finite(global_sum)) error stop 'nonfinite MP diagnostics'
      if(real_bytes==8.and.(global_error>2.e-10_real_kind.or.abs(global_sum)>2.e-10_real_kind)) &
        error stop 'MP conservation/reference gate failed'
      if(mode==2.and.any(values(0:im,0:jm,0:km,:)/=rhs(0:im,0:jm,0:km,:))) &
        error stop 'Inactive MP limiter changed RHS'
      if(rank==0) print '(A,I0,A,I0,A,ES12.4,A,ES12.4)', &
        'MP positivity mode=',mode,' stage=',stage,' CPU/GPU error=',global_error,' periodic energy sum=',global_sum
    enddo
    enddo
    call release_host_buffers()
    call release_halo_exchange_buffers_gpu()
    call release_mp_positivity_gpu()
    deallocate(q_d,qsave_d,qrhs_d,jacob_d,values,expected,rhs,high,delta,jac)
  end subroutine check_mp_positivity

  subroutine check_full_flux()
    use commvar, only: im,jm,km,hm,is,ie,js,je,ks,ke,npdci,npdcj,npdck, &
      numq,num_species,num_modequ,ndims,gamma,mach,nondimen,recon_schem,lchardecomp,lcracon
    use commarray, only: q,rho,vel,prs,tmp,spc,dxi,jacob,qrhs,lshock,crinod
    use commarray_gpu, only: q_d,rho_d,vel_d,prs_d,tmp_d,dxi_d,jacob_d,qrhs_d, &
      shock_mask_d,flux_characteristic_work_d,crinod_d,sync_crashfix_mask_to_gpu
    use commvar_gpu, only: copy_commvar_to_gpu
    use parallel, only: mpileft,mpiright,mpidown,mpiup,mpiback,mpifront
    use mp_positivity_gpu, only: build_mp_convection_gpu,release_mp_positivity_gpu
    use solver, only: convrsduwd
    use solver_gpu, only: characteristic_upwind_flux_x_xyphysical_global_kernel, &
      characteristic_upwind_flux_y_xyphysical_global_kernel,characteristic_upwind_flux_z_xyphysical_global_kernel, &
      characteristic_upwind_rhs_x_xyphysical_global_kernel,characteristic_upwind_rhs_y_xyphysical_global_kernel, &
      characteristic_upwind_rhs_z_xyphysical_global_kernel
    implicit none
    real(real_kind),allocatable :: rhs(:,:,:,:),delta(:,:,:,:),baseline_rhs(:,:,:,:,:)
    integer(1),allocatable :: mask(:,:,:)
    integer :: j,k,mode,layout,unit,header(5),point(3),snapshot_status
    character(1024) :: snapshot_path
    logical :: snapshot_mode
    real(real_kind) :: captured_rhs(5)
    type(dim3) :: bx,by,bz,gx,gy,gz,gxi,gyi,gzi

    im=16; jm=12; km=8
    numq=5; num_species=0; num_modequ=0; ndims=3
    gamma=1.4e0_real_kind; mach=12.e0_real_kind; nondimen=.true.
    recon_schem=5; lchardecomp=.true.; bfacmpld=0.5e0_real_kind
    allocate(q(-hm:im+hm,-hm:jm+hm,-hm:km+hm,5),vel(-hm:im+hm,-hm:jm+hm,-hm:km+hm,3))
    allocate(rho(-hm:im+hm,-hm:jm+hm,-hm:km+hm),prs(-hm:im+hm,-hm:jm+hm,-hm:km+hm))
    allocate(tmp(-hm:im+hm,-hm:jm+hm,-hm:km+hm),jacob(-hm:im+hm,-hm:jm+hm,-hm:km+hm))
    allocate(dxi(-hm:im+hm,-hm:jm+hm,-hm:km+hm,3,3),spc(-hm:im+hm,-hm:jm+hm,-hm:km+hm,0))
    allocate(qrhs(-hm:im+hm,-hm:jm+hm,-hm:km+hm,5))
    allocate(lshock(-hm:im+hm,-hm:jm+hm,-hm:km+hm),crinod(-hm:im+hm,-hm:jm+hm,-hm:km+hm))
    allocate(q_d,mold=q); allocate(vel_d,mold=vel)
    allocate(rho_d,mold=rho); allocate(prs_d,mold=prs); allocate(tmp_d,mold=tmp)
    allocate(dxi_d,mold=dxi); allocate(jacob_d,mold=jacob); allocate(qrhs_d,mold=qrhs)
    allocate(flux_characteristic_work_d,mold=q)
    allocate(shock_mask_d(0:im,0:jm,0:km),mask(0:im,0:jm,0:km))
    allocate(rhs(0:im,0:jm,0:km,5),delta(0:im,0:jm,0:km,5))
    allocate(baseline_rhs(0:im,0:jm,0:km,5,0:2))
    do k=-hm,km+hm
      do j=-hm,jm+hm
        do i=-hm,im+hm
          rho(i,j,k)=1.e0_real_kind+0.03e0_real_kind*sin(0.19e0_real_kind*i+0.13e0_real_kind*j-0.11e0_real_kind*k)
          tmp(i,j,k)=1.e0_real_kind+0.07e0_real_kind*cos(0.21e0_real_kind*i-0.17e0_real_kind*j+0.09e0_real_kind*k)
          vel(i,j,k,1)=0.8e0_real_kind+0.05e0_real_kind*sin(0.2e0_real_kind*i)
          vel(i,j,k,2)=0.07e0_real_kind*sin(0.3e0_real_kind*j)
          vel(i,j,k,3)=-0.06e0_real_kind*cos(0.27e0_real_kind*k)
          prs(i,j,k)=rho(i,j,k)*tmp(i,j,k)/(gamma*mach*mach)
          q(i,j,k,1)=rho(i,j,k)
          q(i,j,k,2:4)=rho(i,j,k)*vel(i,j,k,:)
          q(i,j,k,5)=prs(i,j,k)/(gamma-1.e0_real_kind)+0.5e0_real_kind*rho(i,j,k)*sum(vel(i,j,k,:)**2)
          jacob(i,j,k)=1.e0_real_kind+0.02e0_real_kind*cos(0.1e0_real_kind*(i+j+k))
          dxi(i,j,k,:,:)=0.e0_real_kind
          dxi(i,j,k,1,1)=0.7e0_real_kind+0.01e0_real_kind*i
          dxi(i,j,k,2,2)=0.8e0_real_kind+0.01e0_real_kind*j
          dxi(i,j,k,3,3)=0.9e0_real_kind+0.01e0_real_kind*k
        enddo
      enddo
    enddo
    call get_environment_variable('ASTR_MP_LD_SNAPSHOT',snapshot_path,status=snapshot_status)
    if(snapshot_status/=0.and.snapshot_status/=1) error stop 'MP-LD snapshot path is truncated'
    snapshot_mode=snapshot_status==0.and.len_trim(snapshot_path)>0
    if(snapshot_mode) then
      open(newunit=unit,file=trim(snapshot_path),access='stream',form='unformatted', &
        status='old',action='read',convert='little_endian')
      read(unit) header,point,bfacmpld,captured_rhs
      if(any(header/=[im,jm,km,hm,5]).or.point(1)<1.or.point(1)>im-5.or. &
         any(point(2:3)/=[6,4])) &
        error stop 'MP-LD snapshot requires the bounded inlet stencil tile'
      if(.not.all(ieee_is_finite(captured_rhs)).or.bfacmpld/=0.5e0_real_kind) &
        error stop 'MP-LD snapshot requires finite RHS and original reconstruction weight'
      read(unit) q,jacob,dxi,mask
      close(unit)
      do k=-hm,km+hm
        do j=-hm,jm+hm
          do i=-hm,im+hm
            rho(i,j,k)=q(i,j,k,1)
            ! Physical x- closures never sample the undefined exterior state.
            if(i<0) then
              vel(i,j,k,:)=0.e0_real_kind; prs(i,j,k)=1.e0_real_kind; tmp(i,j,k)=1.e0_real_kind
              cycle
            endif
            if(rho(i,j,k)<=0.e0_real_kind) error stop 'MP-LD snapshot density is not positive'
            vel(i,j,k,:)=q(i,j,k,2:4)/rho(i,j,k)
            prs(i,j,k)=(q(i,j,k,5)-0.5e0_real_kind*rho(i,j,k)*sum(vel(i,j,k,:)**2))*(gamma-1.e0_real_kind)
            tmp(i,j,k)=prs(i,j,k)/rho(i,j,k)*gamma*mach*mach
            if(tmp(i,j,k)<=0.e0_real_kind) error stop 'MP-LD snapshot temperature is not positive'
          enddo
        enddo
      enddo
    endif
    q_d=q; rho_d=rho; vel_d=vel; prs_d=prs; tmp_d=tmp; dxi_d=dxi; jacob_d=jacob
    crinod=.false.
    call copy_commvar_to_gpu()
    bx=dim3(512,1,1); by=dim3(32,16,1); bz=dim3(64,1,8)
    ! This nonperiodic analytic tile tests the local operator, not halo wrapping.
    mpileft=MPI_PROC_NULL; mpiright=MPI_PROC_NULL
    mpidown=MPI_PROC_NULL; mpiup=MPI_PROC_NULL
    mpiback=MPI_PROC_NULL; mpifront=MPI_PROC_NULL
    gx=dim3(1,jm+1,km+1); gy=dim3(1,1,km+1); gz=dim3(1,jm+1,2)
    gxi=gx; gyi=gy; gzi=gz
    do layout=1,4
      if(snapshot_mode.and.layout/=1) cycle
      npdci=layout; npdcj=layout; npdck=3
      is=0; ie=im; js=0; je=jm; ks=0; ke=km
      if(layout==1.or.layout==4) then
        is=1; js=1
      endif
      if(layout==2.or.layout==4) then
        ie=im-1; je=jm-1
      endif
      do mode=0,5
        if(snapshot_mode.and.mode/=1) cycle
        lshock=.false.
        if(mode==1.or.mode==4) lshock=.true.
        if(mode==2.or.mode==5) then
          do k=0,km
            do j=0,jm
              do i=0,im
                lshock(i,j,k)=mod(i+2*j+3*k,7)==0
              enddo
            enddo
          enddo
        endif
        if(snapshot_mode) then
          lshock(0:im,0:jm,0:km)=mask/=0
        else
          mask=merge(1_1,0_1,lshock(0:im,0:jm,0:km))
        endif
        shock_mask_d=mask
        lcracon=mode>=3
        crinod=.false.
        if(lcracon) then
          crinod(0,0,0)=.true.
          crinod(im,jm,km)=.true.
          crinod(im/2,jm/2,km/2)=.true.
        endif
        call sync_crashfix_mask_to_gpu()
        qrhs=0.e0_real_kind; qrhs_d=qrhs
        call convrsduwd()
        call characteristic_upwind_flux_x_xyphysical_global_kernel<<<gxi,bx>>>( &
          im,jm,km,hm,is,ie,js,je,ks,ke,npdci,5,gamma)
        call synchronize('MP-LD x flux')
        call characteristic_upwind_rhs_x_xyphysical_global_kernel<<<gx,bx>>>(im,jm,km,is,ie,js,je,ks,ke)
        call synchronize('MP-LD x difference')
        call characteristic_upwind_flux_y_xyphysical_global_kernel<<<gyi,by>>>( &
          im,jm,km,hm,is,ie,js,je,ks,ke,npdcj,5,gamma)
        call synchronize('MP-LD y flux')
        call characteristic_upwind_rhs_y_xyphysical_global_kernel<<<gy,by>>>(im,jm,km,is,ie,js,je,ks,ke)
        call synchronize('MP-LD y difference')
        call characteristic_upwind_flux_z_xyphysical_global_kernel<<<gzi,bz>>>( &
          im,jm,km,is,ie,js,je,ks,ke,5,gamma)
        call synchronize('MP-LD z flux')
        call characteristic_upwind_rhs_z_xyphysical_global_kernel<<<gz,bz>>>(im,jm,km,is,ie,js,je,ks,ke)
        call synchronize('MP-LD z difference')
        rhs=qrhs_d(0:im,0:jm,0:km,:)
        if(mode<=2) then
          baseline_rhs(:,:,:,:,mode)=rhs
        elseif(maxval(abs(rhs-baseline_rhs(:,:,:,:,mode-3)))<=1.e-12_real_kind) then
          error stop 'Critical-node flux fallback was not exercised'
        endif
        delta=rhs+qrhs(0:im,0:jm,0:km,:)
        if(.not.all(ieee_is_finite(rhs)).or..not.all(ieee_is_finite(delta))) &
          error stop 'MP-LD flux reference/result is not finite'
        error=maxval(abs(delta))
        if(snapshot_mode) then
          i=point(1); j=point(2); k=point(3)
          error=max(maxval(abs(delta(i,j,k,:))),maxval(abs(rhs(i,j,k,:)-captured_rhs)))
          print '(a,5(es24.16,1x))', 'MP-LD snapshot CPU RHS=',-qrhs(i,j,k,:)
          print '(a,5(es24.16,1x))', 'MP-LD snapshot GPU RHS=',rhs(i,j,k,:)
          print '(a,5(es24.16,1x))', 'MP-LD captured production RHS=',captured_rhs
        endif
        print '(A,2I3,A,ES12.4)', 'MP-LD flux layout/mask:',layout,mode,' error=',error
        if(real_bytes==8.and.error>2.e-10_real_kind) error stop 'MP-LD full flux CPU/GPU gate failed'
        if(mode<=2) then
          ! Undefined physical exterior halos must never enter a used face.
          if(layout==1.or.layout==4) then
            q_d(-hm:-1,:,:,:)=ieee_value(0.e0_real_kind,ieee_quiet_nan)
            q_d(:,-hm:-1,:,:)=ieee_value(0.e0_real_kind,ieee_quiet_nan)
          endif
          if(layout==2.or.layout==4) then
            q_d(im+1:im+hm,:,:,:)=ieee_value(0.e0_real_kind,ieee_quiet_nan)
            q_d(:,jm+1:jm+hm,:,:)=ieee_value(0.e0_real_kind,ieee_quiet_nan)
          endif
          qrhs_d=0.e0_real_kind
          call build_mp_convection_gpu()
          rhs=qrhs_d(0:im,0:jm,0:km,:)
          q_d=q
          error=maxval(abs(rhs+qrhs(0:im,0:jm,0:km,:)))
          print '(A,2I3,A,ES12.4)', 'MP stored flux layout/mask:',layout,mode,' error=',error
          if(.not.all(ieee_is_finite(rhs)).or.(real_bytes==8.and.error>2.e-10_real_kind)) &
            error stop 'MP stored high-order flux changed the original operator'
        endif
      enddo
    enddo
    lcracon=.false.
    call release_mp_positivity_gpu()
    call sync_crashfix_mask_to_gpu()
    if(allocated(crinod_d)) deallocate(crinod_d)
    deallocate(q_d,rho_d,vel_d,prs_d,tmp_d,dxi_d,jacob_d,qrhs_d,flux_characteristic_work_d,shock_mask_d)
    deallocate(q,rho,vel,prs,tmp,dxi,jacob,qrhs,spc,lshock,crinod,rhs,delta,mask,baseline_rhs)
  end subroutine check_full_flux

  subroutine check_sponge()
    use commvar, only: im,jm,km,hm,is,ie,js,je,ks,ke,numq,ja,ka,lihomo,ljhomo,lkhomo
    use commarray, only: q
    use commarray_gpu, only: q_d,qwork_d
    use parallel, only: isize,jsize,ksize,mpileft,mpiright,mpidown,mpiup,mpiback,mpifront, &
      mpirank,mpisize,mpitag
    use halo_exchange_gpu, only: release_halo_exchange_buffers_gpu
    use sponge_layer, only: spongefilter_layer,lspg_i0,lspg_im,lspg_jm,lspg_k0,lspg_km, &
      spg_im_beg,spg_im_end,spg_jm_beg,spg_jm_end,sponge_damp_coef_im,sponge_damp_coef_jm
    use sponge_gpu, only: init_sponge_gpu,release_sponge_gpu,apply_xmax_sponge_gpu,apply_ymax_sponge_gpu
    implicit none
    real(real_kind),allocatable :: initial(:,:,:,:),actual_sponge(:,:,:,:)
    integer :: j,k,m,mode,ir,jr,kr,bad,any_bad
    real(real_kind) :: global_error
    character(32) :: topology

    im=16; jm=12; km=8; numq=5
    isize=1; jsize=1; ksize=1
    topology=''
    call get_command_argument(2,topology)
    if(len_trim(topology)>0) read(topology,*) isize,jsize,ksize
    if(min(isize,jsize,ksize)<1.or.isize*jsize*ksize/=nranks) &
      error stop 'Sponge probe topology mismatch'
    mpirank=rank; mpisize=nranks; mpitag=100
    ir=mod(rank,isize); jr=mod(rank/isize,jsize); kr=rank/(isize*jsize)
    mpileft=MPI_PROC_NULL; mpiright=MPI_PROC_NULL
    if(ir>0) mpileft=rank-1
    if(ir<isize-1) mpiright=rank+1
    mpidown=MPI_PROC_NULL; mpiup=MPI_PROC_NULL
    if(jr>0) mpidown=rank-isize
    if(jr<jsize-1) mpiup=rank+isize
    mpiback=mod(kr-1+ksize,ksize)*isize*jsize+jr*isize+ir
    mpifront=mod(kr+1,ksize)*isize*jsize+jr*isize+ir
    lihomo=.false.; ljhomo=.false.; lkhomo=.true.
    ja=jm; ka=km
    is=1; ie=im-1; js=1; je=jm-1; ks=0; ke=km
    if(ir>0) is=0
    if(ir<isize-1) ie=im
    if(jr>0) js=0
    if(jr<jsize-1) je=jm
    lspg_i0=.false.; lspg_k0=.false.; lspg_km=.false.
    spg_im_beg=im-4; spg_im_end=ie
    spg_jm_beg=jm-4; spg_jm_end=je
    if(ir<isize-1) then
      spg_im_beg=-1; spg_im_end=-1
    endif
    if(jr<jsize-1) then
      spg_jm_beg=-1; spg_jm_end=-1
    endif
    allocate(q(-hm:im+hm,-hm:jm+hm,-hm:km+hm,5),initial(-hm:im+hm,-hm:jm+hm,-hm:km+hm,5))
    allocate(actual_sponge,mold=initial)
    allocate(q_d,mold=initial); allocate(qwork_d,mold=initial)
    do m=1,5
      do k=-hm,km+hm
        do j=-hm,jm+hm
          do i=-hm,im+hm
            initial(i,j,k,m)=real(m,real_kind)+sin(0.19e0_real_kind*(i+ir*im)+0.27e0_real_kind*(j+jr*jm)- &
              0.32e0_real_kind*(k+kr*km))+0.01e0_real_kind*rank
          enddo
        enddo
      enddo
    enddo
    do mode=1,3
      lspg_im=mode/=2; lspg_jm=mode/=1
      if(lspg_im) then
        allocate(sponge_damp_coef_im(spg_im_beg:spg_im_end,0:jm,0:km))
        sponge_damp_coef_im=0.04e0_real_kind
      endif
      if(lspg_jm) then
        allocate(sponge_damp_coef_jm(0:im,spg_jm_beg:spg_jm_end,0:km))
        sponge_damp_coef_jm=0.03e0_real_kind
      endif
      call init_sponge_gpu()
      q=initial; q_d=initial
      call spongefilter_layer()
      if(lspg_im) call apply_xmax_sponge_gpu()
      if(lspg_jm) call apply_ymax_sponge_gpu()
      actual_sponge=q_d
      bad=merge(0,1,all(ieee_is_finite(actual_sponge)).and.all(ieee_is_finite(q)))
      call MPI_Allreduce(bad,any_bad,1,MPI_INTEGER,MPI_MAX,MPI_COMM_WORLD,ierr)
      if(any_bad/=0) error stop 'Sponge reference/result is not finite'
      error=maxval(abs(actual_sponge-q))
      call MPI_Allreduce(error,global_error,1,mpi_real_type,MPI_MAX,MPI_COMM_WORLD,ierr)
      if(rank==0) print '(A,3I3,A,I0,A,ES12.4)', &
        'MP-LD sponge topology ',isize,jsize,ksize,' mode ',mode,' error=',global_error
      if(real_bytes==8.and.global_error>2.e-10_real_kind) error stop 'MP-LD sponge CPU/GPU gate failed'
      call release_sponge_gpu()
      if(allocated(sponge_damp_coef_im)) deallocate(sponge_damp_coef_im)
      if(allocated(sponge_damp_coef_jm)) deallocate(sponge_damp_coef_jm)
    enddo
    call release_halo_exchange_buffers_gpu()
    deallocate(q,q_d,qwork_d,initial,actual_sponge)
  end subroutine check_sponge

  subroutine synchronize(name)
    character(*),intent(in) :: name
    status=cudaDeviceSynchronize()
    if(status/=cudaSuccess) then
      print *,trim(name),': ',cudaGetErrorString(status)
      error stop 'MP-LD production kernel failed'
    endif
  end subroutine synchronize
end program mp_ld_reconstruction_probe
