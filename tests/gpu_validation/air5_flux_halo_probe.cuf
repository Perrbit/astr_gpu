program air5_flux_halo_probe
  use astr_precision, only: real_kind
  use iso_fortran_env, only: int64
  use cudafor
  use mpi
  use halo_transport_gpu, only: begin_transport_setup,end_transport_setup,release_host_buffers
  use chemistry_flux_exchange_gpu, only: packed_air5_flux_halo,exchange_air5_flux_halo,release_air5_flux_halo
  implicit none
  integer, parameter :: im=8,jm=8,km=8,hm=5
  integer :: ierr,rank,ranks,cart,axis,devices,code,components,iteration,m,i,j,k,h
  integer :: dims(3),low(3),high(3),coords(3),source(3),dest(3),extent(3)
  integer :: low_rank,high_rank,errors,total_errors
  logical :: periodic(3),pinned
  character(len=16) :: topology,boundary
  real(real_kind), allocatable :: initial(:,:,:,:),actual(:,:,:,:),expected(:,:,:,:)
  real(real_kind), allocatable, device :: sigma(:,:,:,:),qflux(:,:,:,:),species(:,:,:,:,:)
  real(real_kind), allocatable, device :: ev(:,:,:,:),energy(:,:,:,:)

  call MPI_Init(ierr)
  call MPI_Comm_rank(MPI_COMM_WORLD,rank,ierr)
  call MPI_Comm_size(MPI_COMM_WORLD,ranks,ierr)
  code=cudaGetDeviceCount(devices)
  if(code/=cudaSuccess.or.devices==0) call MPI_Abort(MPI_COMM_WORLD,1,ierr)
  code=cudaSetDevice(mod(rank,devices))
  if(code/=cudaSuccess) call MPI_Abort(MPI_COMM_WORLD,code,ierr)
  call get_command_argument(1,topology)
  call get_command_argument(2,boundary)
  dims=1
  select case(trim(topology))
  case('x'); dims(1)=ranks
  case('y'); dims(2)=ranks
  case('z'); dims(3)=ranks
  case('xy'); dims=[2,2,1]
  case('xz'); dims=[2,1,2]
  case('yz'); dims=[1,2,2]
  case('xyz'); dims=[2,2,2]
  case default; error stop 'unknown probe topology'
  end select
  if(product(dims)/=ranks) error stop 'probe topology does not match rank count'
  periodic=.true.
  if(trim(boundary)=='physical') periodic=[.false.,.false.,.true.]
  call MPI_Cart_create(MPI_COMM_WORLD,3,dims,periodic,.false.,cart,ierr)
  do axis=1,3
    call MPI_Cart_shift(cart,axis-1,1,low(axis),high(axis),ierr)
  enddo
  call begin_transport_setup(pinned)
  call end_transport_setup(pinned)
  allocate(initial(-hm:im+hm,-hm:jm+hm,-hm:km+hm,33),actual(-hm:im+hm,-hm:jm+hm,-hm:km+hm,33), &
    expected(-hm:im+hm,-hm:jm+hm,-hm:km+hm,33))
  allocate(sigma(-hm:im+hm,-hm:jm+hm,-hm:km+hm,6),qflux(-hm:im+hm,-hm:jm+hm,-hm:km+hm,3), &
    species(-hm:im+hm,-hm:jm+hm,-hm:km+hm,5,3),ev(-hm:im+hm,-hm:jm+hm,-hm:km+hm,3))
  extent=[im,jm,km]
  do iteration=1,2
    components=27+6*(iteration-1)
    if(.not.packed_air5_flux_halo()) error stop 'probe requires packed or packed-overlap'
    initial=-777777.0_real_kind
    do m=1,33
      do k=0,km
        do j=0,jm
          do i=0,im
            initial(i,j,k,m)=value(rank,[i,j,k],m)
          enddo
        enddo
      enddo
    enddo
    expected=initial
    do axis=1,3
      low_rank=low(axis); high_rank=high(axis)
      if(dims(axis)==1) then
        if(.not.periodic(axis)) cycle
        low_rank=rank; high_rank=rank
      endif
      do m=1,components
        do k=0,km
          do j=0,jm
            do i=0,im
              coords=[i,j,k]
              if(coords(axis)/=0) cycle
              do h=0,hm-1
                source=coords; dest=coords
                source(axis)=extent(axis)-hm+h; dest(axis)=-hm+h
                if(low_rank/=MPI_PROC_NULL) expected(dest(1),dest(2),dest(3),m)=value(low_rank,source,m)
                source(axis)=h+1; dest(axis)=extent(axis)+1+h
                if(high_rank/=MPI_PROC_NULL) expected(dest(1),dest(2),dest(3),m)=value(high_rank,source,m)
              enddo
            enddo
          enddo
        enddo
      enddo
    enddo
    sigma=initial(:,:,:,1:6); qflux=initial(:,:,:,7:9); ev=initial(:,:,:,25:27)
    if(iteration==2) then
      allocate(energy(-hm:im+hm,-hm:jm+hm,-hm:km+hm,6))
      energy=initial(:,:,:,28:33)
    endif
    do axis=1,3
      species(:,:,:,:,axis)=initial(:,:,:,10+5*(axis-1):14+5*(axis-1))
    enddo
    call exchange_air5_flux_halo(sigma,qflux,species,ev,energy,im,jm,km,hm,dims,low,high,periodic,iteration==2)
    actual(:,:,:,1:6)=sigma; actual(:,:,:,7:9)=qflux; actual(:,:,:,25:27)=ev
    if(allocated(energy)) actual(:,:,:,28:33)=energy
    do axis=1,3
      actual(:,:,:,10+5*(axis-1):14+5*(axis-1))=species(:,:,:,:,axis)
    enddo
    errors=0
    do m=1,components
      do k=-hm,km+hm
        do j=-hm,jm+hm
          do i=-hm,im+hm
            if(transfer(actual(i,j,k,m),0_int64)/=transfer(expected(i,j,k,m),0_int64)) errors=errors+1
          enddo
        enddo
      enddo
    enddo
    call MPI_Allreduce(errors,total_errors,1,MPI_INTEGER,MPI_SUM,MPI_COMM_WORLD,ierr)
    if(rank==0) write(*,'(a,i0,a,i0)') 'AIR5_FLUX_HALO_PROBE components=',components,' bit_mismatches=',total_errors
    if(total_errors/=0) call MPI_Abort(MPI_COMM_WORLD,1,ierr)
    call release_air5_flux_halo()
    if(allocated(energy)) deallocate(energy)
  enddo
  call release_host_buffers()
  deallocate(sigma,qflux,species,ev)
  call MPI_Comm_free(cart,ierr)
  call MPI_Finalize(ierr)
contains
  real(real_kind) function value(owner,index,component) result(v)
    integer, intent(in) :: owner,index(3),component
    v=real(100000*component+1000*owner+81*index(1)+9*index(2)+index(3),real_kind)
    if(component==1.and.index(1)==0) v=transfer(int(z'8000000000000000',int64),v)
    if(component==2.and.index(1)==2) v=transfer(int(owner+1,int64),v)
  end function value
end program air5_flux_halo_probe
