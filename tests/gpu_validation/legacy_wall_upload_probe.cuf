module legacy_wall_upload_test
  use astr_precision, only: real_kind
  use cudafor
  implicit none
contains
  attributes(global) subroutine consume_wall(im,km,wall,observed)
    integer,value :: im,km
    real(real_kind),device,intent(in) :: wall(0:im,0:km)
    real(real_kind),device,intent(out) :: observed(0:im,0:km)
    integer :: id,i,k
    id=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    if(id>=(im+1)*(km+1)) return
    i=mod(id,im+1)
    k=id/(im+1)
    observed(i,k)=wall(i,k)
  end subroutine consume_wall
end module legacy_wall_upload_test

program legacy_wall_upload_probe
  use astr_precision, only: real_kind
  use cudafor
  use legacy_wall_upload_test
  use wall_blowing_random, only: sample_legacy_wall_velocity
  implicit none
  integer,parameter :: im=64,km=24
  real(real_kind) :: xc(0:im,0:km),zc(0:im,0:km),result(0:im,0:km)
  real(real_kind),allocatable,pinned :: supplied(:,:)
  real(real_kind),allocatable,device :: wall(:,:),observed(:,:)
  integer :: rank,status,i,k,c
  integer(8) :: free_bytes,total_bytes
  character(len=16) :: argument
  type(dim3) :: block,grid

  call get_command_argument(1,argument)
  read(argument,*) rank
  status=cudaSetDevice(rank)
  if(status/=cudaSuccess) error stop 'CUDA device selection failed'
  status=cudaMemGetInfo(free_bytes,total_bytes)
  if(status/=cudaSuccess .or. free_bytes<1073741824_8) &
    error stop 'CUDA free memory is below the approved floor'
  allocate(supplied(0:im,0:km),wall(0:im,0:km),observed(0:im,0:km))
  do k=0,km
    do i=0,im
      xc(i,k)=real(i,real_kind)*80.e0_real_kind/real(im,real_kind)
      zc(i,k)=real(k,real_kind)*90.e0_real_kind/real(km,real_kind)
    enddo
  enddo
  block=dim3(256,1,1)
  grid=dim3(((im+1)*(km+1)+255)/256,1,1)
  do c=1,3
    call sample_legacy_wall_velocity(rank,xc,zc,90.e0_real_kind,1.e0_real_kind,0.12e0_real_kind, &
                                    20.e0_real_kind,40.e0_real_kind,60.e0_real_kind,3,supplied)
    wall=supplied
    call consume_wall<<<grid,block>>>(im,km,wall,observed)
    status=cudaDeviceSynchronize()
    if(status/=cudaSuccess) error stop 'wall consumption kernel failed'
    result=observed
    if(any(result/=supplied)) error stop 'GPU wall values differ from host supply'
  enddo
  deallocate(observed,wall,supplied)
  print '(A,I0,A)', 'legacy wall GPU ',rank,': PASS (3 calls, exact device consumption)'
end program legacy_wall_upload_probe
