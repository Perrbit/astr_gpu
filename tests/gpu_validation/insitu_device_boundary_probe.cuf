module insitu_device_boundary_fixture
  use cudafor
  implicit none
contains
  attributes(host,device) real(8) function sample_axis(node,periodic,degree) result(value)
    integer,value :: node,degree
    logical,value :: periodic
    integer :: wrapped
    real(8) :: x
    wrapped=node
    if(periodic) wrapped=modulo(node,16)
    x=dble(wrapped)/16.d0
    value=x*x+0.25d0*x*x*x
    if(degree/=3) value=x**degree
    if(periodic) value=sin(2.d0*acos(-1.d0)*x)
  end function

  attributes(host,device) subroutine sample_state(global,periodic,state,degree)
    integer,intent(in) :: global(3)
    logical,intent(in) :: periodic(3)
    real(8),intent(out) :: state(11)
    integer,value :: degree
    real(8) :: values(3),velocity,density
    integer :: a,c,wrapped(3)
    wrapped=global
    do a=1,3
      if(periodic(a)) wrapped(a)=modulo(global(a),16)
      values(a)=sample_axis(global(a),periodic(a),degree)
    enddo
    density=1.d0+dble(sum(wrapped))/1024.d0
    state(1)=density
    do c=1,3
      velocity=0.d0
      do a=1,3
        velocity=velocity+dble(c+a)*values(a)/16.d0
      enddo
      if(degree/=1) velocity=velocity+dble(c)*product(values)/32.d0
      state(c+1)=density*velocity
    enddo
    do c=5,11
      state(c)=dble(c)+dble(wrapped(1)+2*wrapped(2)+3*wrapped(3))/1024.d0
    enddo
  end subroutine

  attributes(global) subroutine initialize(q,canonical,metrics,coordinates,im,jm,km,coords,periodic,degree)
    integer,value :: im,jm,km,degree
    integer,device,intent(in) :: coords(3)
    logical,device,intent(in) :: periodic(3)
    real(8),device,intent(out) :: q(-3:im+3,-3:jm+3,-3:km+3,11)
    real(8),device,intent(out) :: canonical(0:im,0:jm,0:km,11)
    real(8),device,intent(out) :: metrics(-3:im+3,-3:jm+3,-3:km+3,3,3)
    real(8),device,intent(out) :: coordinates(-3:im+3,-3:jm+3,-3:km+3,3)
    integer :: node,i,j,k,c,a,ijk(3),extent(3),global(3)
    logical :: duplicate
    real(8) :: state(11)
    node=(blockIdx%x-1)*blockDim%x+threadIdx%x-1
    if(node>=(im+7)*(jm+7)*(km+7)) return
    i=mod(node,im+7)-3; j=mod(node/(im+7),jm+7)-3; k=node/((im+7)*(jm+7))-3
    q(i,j,k,:)=-77.d0
    coordinates(i,j,k,:)=-77.d0
    do c=1,3
      do a=1,3
        metrics(i,j,k,a,c)=dble(a+c)/16.d0
        if(a==c) metrics(i,j,k,a,c)=16.d0
      enddo
    enddo
    ijk=[i,j,k]; extent=[im,jm,km]
    if(any(ijk<0).or.any(ijk>extent)) return
    global=coords*extent+ijk
    coordinates(i,j,k,:)=dble(global)/16.d0
    coordinates(i,j,k,2)=coordinates(i,j,k,2)+0.05d0* &
      sin(2.d0*acos(-1.d0)*coordinates(i,j,k,1))*sin(acos(-1.d0)*coordinates(i,j,k,2))
    call sample_state(global,periodic,state,degree)
    duplicate=.false.
    do a=1,3
      if(ijk(a)==extent(a).and.(periodic(a).or.global(a)<16)) duplicate=.true.
    enddo
    if(duplicate) state=-99.d0
    q(i,j,k,:)=state
    canonical(i,j,k,:)=state
  end subroutine
end module

program insitu_device_boundary_probe
  use cudafor
  use mpi
  use iso_fortran_env, only: int64
  use ieee_arithmetic, only: ieee_value,ieee_quiet_nan
  use insitu_device_velocity, only: begin_velocity_transport_gpu,end_velocity_transport_gpu, &
    velocity_transport_usage_gpu,complete_sample_fields_gpu,snapshot_sample_velocity_gpu, &
    extend_sample_velocity_gpu,derive_sample_velocity_gpu,snapshot_sample_coordinates_gpu
  use insitu_device_boundary_fixture
  implicit none
  integer :: status,ierr,rank,np,axis,comm,dims(3),coords(3),extent(3),neighbors(2,3), &
    local_rank,devices,nodes,i,j,k,a,c,d,frame,bad,all_bad,generation,last_generation, &
    global(3),ijk(3),shifted(3),ntype,side,source_errors,halo_errors,slot_errors,degree
  integer,device,allocatable :: coords_d(:)
  logical,device,allocatable :: periodic_d(:)
  logical :: periodic(3),outside
  real(8),device,allocatable :: q(:,:,:,:),canonical(:,:,:,:),metrics(:,:,:,:,:), &
    velocity(:,:),halo(:,:,:,:),derived(:,:),coordinates(:,:,:,:),points(:,:)
  real(8),allocatable :: source(:,:,:,:),source_before(:,:,:,:),completed(:,:,:,:),halo_h(:,:,:,:),derived_h(:,:), &
    points_h(:,:)
  real(8) :: state(11),samples(-3:3),directional(3),gradient(3,3),reference(14),value, &
    max_error,all_error,position(3),other_values(3),x
  integer(int64) :: hb,db,d2h,h2d,exchanges,expected_send,expected_receive,face,haloface
  character(32) :: argument,mode,fixture,scenario
  local_rank=0
  call get_environment_variable('OMPI_COMM_WORLD_LOCAL_RANK',argument,status=status)
  if(status==0) read(argument,*) local_rank
  status=cudaGetDeviceCount(devices)
  if(status/=cudaSuccess.or.local_rank>=devices) stop 1
  status=cudaSetDevice(local_rank)
  if(status/=cudaSuccess) stop 2
  call MPI_Init(ierr)
  call MPI_Comm_rank(MPI_COMM_WORLD,rank,ierr)
  call MPI_Comm_size(MPI_COMM_WORLD,np,ierr)
  if(np/=1.and.np/=2) call MPI_Abort(MPI_COMM_WORLD,3,ierr)
  call get_command_argument(1,argument); read(argument,*) axis
  if(axis<1.or.axis>3) call MPI_Abort(MPI_COMM_WORLD,4,ierr)
  call get_command_argument(2,mode)
  call get_command_argument(3,fixture)
  call get_command_argument(4,scenario)
  degree=3
  if(scenario=='wall-sixth') degree=6
  if(scenario=='wall-affine') degree=1
  periodic=.true.
  select case(fixture)
  case('channel'); periodic(2)=.false.
  case('air5'); periodic(1:2)=.false.
  case('physical'); periodic=.false.
  case default; call MPI_Abort(MPI_COMM_WORLD,5,ierr)
  end select
  dims=1; dims(axis)=np
  call MPI_Cart_create(MPI_COMM_WORLD,3,dims,periodic,.false.,comm,ierr)
  call MPI_Cart_coords(comm,rank,3,coords,ierr)
  do axis=1,3
    call MPI_Cart_shift(comm,axis-1,1,neighbors(1,axis),neighbors(2,axis),ierr)
    if(dims(axis)==1) neighbors(:,axis)=MPI_PROC_NULL
  enddo
  extent=16/dims
  allocate(coords_d(3),periodic_d(3))
  coords_d=coords; periodic_d=periodic
  if(scenario=='inconsistent-periodic'.and.rank==1) periodic(1)=.not.periodic(1)
  call begin_velocity_transport_gpu(trim(mode),extent,dims,neighbors,comm, &
    67108864_int64,67108864_int64,1073741824_int64,periodic=periodic,max_components=11)
  call velocity_transport_usage_gpu(hb,db,d2h,h2d,exchanges,last_generation)
  allocate(q(-3:extent(1)+3,-3:extent(2)+3,-3:extent(3)+3,11), &
    canonical(0:extent(1),0:extent(2),0:extent(3),11), &
    metrics(-3:extent(1)+3,-3:extent(2)+3,-3:extent(3)+3,3,3), &
    coordinates(-3:extent(1)+3,-3:extent(2)+3,-3:extent(3)+3,3),points_h(3,product(extent+1)), &
    source(-3:extent(1)+3,-3:extent(2)+3,-3:extent(3)+3,11), &
    source_before(-3:extent(1)+3,-3:extent(2)+3,-3:extent(3)+3,11), &
    completed(0:extent(1),0:extent(2),0:extent(3),11))
  bad=0; max_error=0.d0; expected_send=0; expected_receive=0
  source_errors=0; halo_errors=0; slot_errors=0
  do frame=1,2
    nodes=product(extent+7)
    call initialize<<<(nodes+255)/256,256>>>(q,canonical,metrics,coordinates, &
      extent(1),extent(2),extent(3),coords_d,periodic_d,degree)
    status=cudaDeviceSynchronize()
    if(status/=cudaSuccess) call MPI_Abort(comm,6,ierr)
    source_before=q
    if(scenario=='coordinate-nonfinite'.and.rank==0) coordinates(0,0,0,1)=ieee_value(0.d0,ieee_quiet_nan)
    if(scenario=='coordinate-budget') call snapshot_sample_coordinates_gpu(coordinates,points,extent,3,comm, &
      1_int64,1073741824_int64,0_int64)
    call snapshot_sample_coordinates_gpu(coordinates,points,extent,3,comm, &
      67108864_int64,1073741824_int64,0_int64)
    points_h=points
    deallocate(points)
    call complete_sample_fields_gpu(canonical,extent,11,comm)
    call snapshot_sample_velocity_gpu(q,velocity,extent,3,11,dims,neighbors,comm, &
      67108864_int64,1073741824_int64)
    call extend_sample_velocity_gpu(velocity,halo,extent,comm,67108864_int64,1073741824_int64)
    call derive_sample_velocity_gpu(halo,metrics,derived,extent,3,comm,67108864_int64,1073741824_int64, &
      wall_sixth=degree/=3)
    allocate(halo_h(-3:extent(1)+3,-3:extent(2)+3,-3:extent(3)+3,3),derived_h(14,product(extent+1)))
    ! Bounded test-only readbacks, not a production product path.
    source=q; completed=canonical; halo_h=halo; derived_h=derived
    if(any(source/=source_before)) source_errors=1
    do k=-3,extent(3)+3
      do j=-3,extent(2)+3
        do i=-3,extent(1)+3
          ijk=[i,j,k]; global=coords*extent+ijk
          outside=any(ijk<0).or.any(ijk>extent)
          if(outside) then
            if(any(source(i,j,k,:)/=-77.d0)) source_errors=1
          else
            call sample_state(global,periodic,state,degree)
            max_error=max(max_error,maxval(abs(completed(i,j,k,:)-state)))
          endif
          outside=.false.
          do a=1,3
            if(.not.periodic(a).and.(global(a)<0.or.global(a)>16)) outside=.true.
          enddo
          if(outside) then
            if(any(halo_h(i,j,k,:)/=0.d0)) halo_errors=1
          else
            call sample_state(global,periodic,state,degree)
            max_error=max(max_error,maxval(abs(halo_h(i,j,k,:)-state(2:4)/state(1))))
          endif
        enddo
      enddo
    enddo
    do k=0,extent(3)
      do j=0,extent(2)
        do i=0,extent(1)
          global=coords*extent+[i,j,k]
          position=dble(global)/16.d0
          position(2)=position(2)+0.05d0*sin(2.d0*acos(-1.d0)*position(1))*sin(acos(-1.d0)*position(2))
          nodes=i+(extent(1)+1)*(j+(extent(2)+1)*k)+1
          max_error=max(max_error,maxval(abs(points_h(:,nodes)-position)))
          do c=1,3
            do a=1,3
              do side=-3,3
                shifted=global; shifted(a)=shifted(a)+side
                call sample_state(shifted,periodic,state,degree)
                samples(side)=state(c+1)/state(1)
              enddo
              value=0.75d0*(samples(1)-samples(-1))-0.15d0*(samples(2)-samples(-2))+ &
                (samples(3)-samples(-3))/60.d0
              if(.not.periodic(a)) then
                ntype=global(a)
                if(degree/=3) then
                  ! Each nonperiodic factor is a polynomial of degree <=6. Its
                  ! analytic derivative is independent of the GPU stencil table.
                  do d=1,3
                    other_values(d)=sample_axis(global(d),periodic(d),degree)
                  enddo
                  other_values(a)=1.d0
                  x=dble(global(a))/16.d0
                  value=dble(c+a)/16.d0
                  if(degree/=1) value=value+dble(c)*product(other_values)/32.d0
                  value=value*dble(degree)*x**(degree-1)/16.d0
                else
                select case(ntype)
                case(0); value=-0.5d0*samples(2)+2.d0*samples(1)-1.5d0*samples(0)
                case(1,15); value=0.5d0*(samples(1)-samples(-1))
                case(2,14); value=2.d0/3.d0*(samples(1)-samples(-1))-(samples(2)-samples(-2))/12.d0
                case(16); value=0.5d0*samples(-2)-2.d0*samples(-1)+1.5d0*samples(0)
                end select
                endif
              endif
              directional(a)=value
            enddo
            do d=1,3
              gradient(c,d)=0.d0
              do a=1,3
                value=dble(a+d)/16.d0
                if(a==d) value=16.d0
                gradient(c,d)=gradient(c,d)+directional(a)*value
              enddo
              reference(c+3*(d-1))=gradient(c,d)
            enddo
          enddo
          reference(10)=-0.5d0*sum(gradient*transpose(gradient))
          reference(11)=gradient(1,1)+gradient(2,2)+gradient(3,3)
          reference(12)=gradient(3,2)-gradient(2,3)
          reference(13)=gradient(1,3)-gradient(3,1)
          reference(14)=gradient(2,1)-gradient(1,2)
          nodes=i+(extent(1)+1)*(j+(extent(2)+1)*k)+1
          max_error=max(max_error,maxval(abs(derived_h(:,nodes)-reference)))
        enddo
      enddo
    enddo
    do a=1,3
      if(dims(a)==1.or.mode/='pinned') cycle
      face=15_int64*product(int(extent+1,int64))/(extent(a)+1)
      haloface=9_int64*product(int(extent+7,int64))/(extent(a)+7)
      if(neighbors(1,a)/=MPI_PROC_NULL) expected_send=expected_send+(face+haloface)*8
      if(neighbors(2,a)/=MPI_PROC_NULL) expected_receive=expected_receive+(face+haloface)*8
      if(neighbors(2,a)/=MPI_PROC_NULL) expected_send=expected_send+haloface*8
      if(neighbors(1,a)/=MPI_PROC_NULL) expected_receive=expected_receive+haloface*8
    enddo
    call velocity_transport_usage_gpu(hb,db,d2h,h2d,exchanges,generation)
    if(d2h/=expected_send.or.h2d/=expected_receive.or.generation/=last_generation) slot_errors=1
    deallocate(velocity,halo,derived,halo_h,derived_h)
  enddo
  if(max_error>2.d-10.or.source_errors/=0.or.halo_errors/=0.or.slot_errors/=0) bad=1
  call MPI_Allreduce(bad,all_bad,1,MPI_INTEGER,MPI_MAX,comm,ierr)
  call MPI_Allreduce(max_error,all_error,1,MPI_DOUBLE_PRECISION,MPI_MAX,comm,ierr)
  write(*,'(a,i0,6a,3(i0,1x),a,es24.16,a,i0,2(a,i0))') 'Boundary rank=',rank, &
    ' fixture=',trim(fixture),' backend=',trim(mode),' topology=', ' ',dims, &
    ' max_error=',all_error,' errors=',all_bad,' d2h=',d2h,' h2d=',h2d
  write(*,'(a,i0,3(a,i0))') 'Boundary checks rank=',rank,' source_errors=',source_errors, &
    ' halo_errors=',halo_errors,' slot_errors=',slot_errors
  call end_velocity_transport_gpu(comm)
  call velocity_transport_usage_gpu(hb,db,d2h,h2d,exchanges,generation)
  if(hb/=0.or.db/=0) call MPI_Abort(comm,7,ierr)
  call begin_velocity_transport_gpu(trim(mode),extent,dims,neighbors,comm, &
    67108864_int64,67108864_int64,1073741824_int64,periodic=periodic,max_components=11)
  call velocity_transport_usage_gpu(hb,db,d2h,h2d,exchanges,generation)
  if(generation/=last_generation+1.or.d2h/=0.or.h2d/=0.or.exchanges/=0) call MPI_Abort(comm,8,ierr)
  call end_velocity_transport_gpu(comm)
  deallocate(q,canonical,metrics,source,source_before,completed,coords_d,periodic_d,coordinates,points_h)
  if(rank==0.and.all_bad==0) print *, 'PASS physical endpoints, halos, nine metrics, source and slot lifecycle'
  call MPI_Comm_free(comm,ierr)
  call MPI_Finalize(ierr)
  if(all_bad/=0) stop 9
end program
