module air5_flux_gpu_probe_wrappers
  use iso_fortran_env, only: real64
  use cudafor
  use chemistry_model, only: cpu_close=>air5_close_species_flux, &
    cpu_moment=>air5_close_species_flux_moment,chemistry_status_ok, &
    preserve_support=>air5_preserve_zero_flux_support
  use chemistry_model_gpu, only: air5_close_species_flux_gpu,air5_close_species_flux_moment_gpu
  implicit none
  private
  public :: air5_close_species_flux,air5_close_species_flux_moment
  public :: air5_preserve_zero_flux_support
contains
  attributes(global) subroutine zero_support_kernel(inputs)
    real(real64), device, intent(inout) :: inputs(5,8)
    if(threadIdx%x/=1.or.blockIdx%x/=1) return
    call preserve_support(inputs(:,1),inputs(:,2),inputs(:,3),inputs(:,4), &
      inputs(:,5),inputs(:,6),inputs(:,7),inputs(:,8))
  end subroutine zero_support_kernel

  subroutine air5_preserve_zero_flux_support(high,low,base_left,base_right,ql,qr,lower,upper)
    real(real64), intent(in) :: high(5),low(5),base_left(5),base_right(5),ql(5),qr(5)
    real(real64), intent(inout) :: lower(5),upper(5)
    real(real64), device :: inputs_d(5,8)
    real(real64) :: lo_ref(5),hi_ref(5)
    integer :: ierr
    inputs_d(:,1)=high; inputs_d(:,2)=low
    inputs_d(:,3)=base_left; inputs_d(:,4)=base_right
    inputs_d(:,5)=ql; inputs_d(:,6)=qr
    inputs_d(:,7)=lower; inputs_d(:,8)=upper
    lo_ref=lower; hi_ref=upper
    call preserve_support(high,low,base_left,base_right,ql,qr,lo_ref,hi_ref)
    call zero_support_kernel<<<1,1>>>(inputs_d)
    ierr=cudaGetLastError()
    if(ierr/=cudaSuccess) error stop 'zero-support kernel launch failed'
    ierr=cudaDeviceSynchronize()
    if(ierr/=cudaSuccess) error stop 'zero-support kernel failed'
    lower=inputs_d(:,7); upper=inputs_d(:,8)
    if(any(lower/=lo_ref).or.any(upper/=hi_ref)) error stop 'zero-support CPU/GPU mismatch'
  end subroutine air5_preserve_zero_flux_support

  attributes(global) subroutine projection_kernel(inputs,mass,moment,output,status_out,with_moment)
    real(real64), device, intent(in) :: inputs(5,4)
    real(real64), device, intent(out) :: output(5)
    integer, device, intent(out) :: status_out
    real(real64), value :: mass,moment
    logical, value :: with_moment
    if(threadIdx%x/=1 .or. blockIdx%x/=1) return
    if(with_moment) then
      call air5_close_species_flux_moment_gpu(inputs(:,1),inputs(:,2),inputs(:,3), &
        mass,inputs(:,4),moment,output,status_out)
    else
      call air5_close_species_flux_gpu(inputs(:,1),inputs(:,2),inputs(:,3),mass,output,status_out)
    endif
  end subroutine projection_kernel

  subroutine checked_projection(candidate,lower,upper,mass,weights,moment,flux,status,with_moment)
    real(real64), intent(in) :: candidate(5),lower(5),upper(5),weights(5),mass,moment
    real(real64), intent(out) :: flux(5)
    integer, intent(out) :: status
    logical, intent(in) :: with_moment
    real(real64), device :: inputs_d(5,4),output_d(5)
    integer, device :: status_d
    real(real64) :: reference(5),bound(5)
    integer :: expected,ierr
    inputs_d(:,1)=candidate; inputs_d(:,2)=lower; inputs_d(:,3)=upper; inputs_d(:,4)=weights
    call projection_kernel<<<1,1>>>(inputs_d,mass,moment,output_d,status_d,with_moment)
    ierr=cudaGetLastError()
    if(ierr/=cudaSuccess) error stop 'projection kernel launch failed'
    ierr=cudaDeviceSynchronize()
    if(ierr/=cudaSuccess) error stop 'projection kernel execution failed'
    flux=output_d; status=status_d
    if(with_moment) then
      call cpu_moment(candidate,lower,upper,mass,weights,moment,reference,expected)
    else
      call cpu_close(candidate,lower,upper,mass,reference,expected)
    endif
    if(status/=expected) then
      write(*,*) 'projection status CPU/GPU=',expected,status
      error stop 'projection backend status mismatch'
    endif
    if(status/=chemistry_status_ok) return
    bound=256*epsilon(mass)*max(abs(lower),abs(upper),abs(candidate),abs(reference))
    if(any(abs(flux-reference)>bound)) then
      write(*,*) 'projection CPU=',reference
      write(*,*) 'projection GPU=',flux
      error stop 'projection backend flux mismatch'
    endif
  end subroutine checked_projection

  subroutine air5_close_species_flux(candidate,lower,upper,mass_flux,flux,status)
    real(real64), intent(in) :: candidate(5),lower(5),upper(5),mass_flux
    real(real64), intent(out) :: flux(5)
    integer, intent(out) :: status
    call checked_projection(candidate,lower,upper,mass_flux, &
      [0.0_real64,0.0_real64,0.0_real64,0.0_real64,0.0_real64],0.0_real64,flux,status,.false.)
  end subroutine air5_close_species_flux

  subroutine air5_close_species_flux_moment(candidate,lower,upper,mass_flux,weights,moment_flux,flux,status)
    real(real64), intent(in) :: candidate(5),lower(5),upper(5),mass_flux,weights(5),moment_flux
    real(real64), intent(out) :: flux(5)
    integer, intent(out) :: status
    call checked_projection(candidate,lower,upper,mass_flux,weights,moment_flux,flux,status,.true.)
  end subroutine air5_close_species_flux_moment
end module air5_flux_gpu_probe_wrappers
