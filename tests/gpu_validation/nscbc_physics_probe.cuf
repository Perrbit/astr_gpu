module nscbc_physics_probe
  use astr_precision, only: real_kind
  use astr_precision_mpi, only: mpi_real_type
  use cudafor
  use commarray_gpu, only: q_d,rho_d,vel_d,prs_d,tmp_d,qrhs_d,jacob_d,dxi_d,flux_work_d,x_d
  implicit none
contains
  subroutine check_nscbc_physics_gpu()
    use mpi
    use commvar, only: im,jm,km,hm,gamma,mach,lihomo,ljhomo,lkhomo, &
                      npdci,npdcj,npdck,xmin,xmax,uinf,vinf,winf,roinf,pinf
    use parallel, only: mpirank,mpisize,mpileft,mpiright
    use gpu_check, only: sync_after_kernel
    use boundary_gpu, only: nscbc_outflow_x_rhs_kernel,gpu_nscbc_outflow_mach2, &
                           apply_nscbc_inflow_x_rhs_gpu,apply_nscbc_x_rhs_gpu, &
                           nscbc_farfield_y_upper_rhs_kernel
    use bc, only: pout
    use solver_gpu, only: explicit_upwind_rhs_y_physical_global_kernel, &
                          explicit_upwind_rhs_z_xyphysical_global_kernel
    use, intrinsic :: ieee_arithmetic, only: ieee_is_finite
    implicit none
    real(real_kind),allocatable :: state(:,:,:,:),density(:,:,:),velocity(:,:,:,:), &
                          pressure(:,:,:),temperature(:,:,:),metric(:,:,:,:,:), &
                          jacobian(:,:,:),rhs(:,:,:,:),flux(:,:,:),checked_state(:,:,:,:)
    real(real_kind) :: error,global_error,expected(5),u,v,w,r,p,reported,target_p,css,rate,enthalpy
    real(real_kind) :: qtarget(5),delta(5),plus(5),minus(5),normal_derivative(5),back_rate,plus_rate,local_p
    integer :: i,j,k,m,istat,nblocks,ierr,device_count,axis,apply_right
    logical :: inlet_mode,top_mode,outlet_mode,backflow_mode
    character(len=32) :: mode
    type(dim3) :: block,grid

    if(mpisize/=1 .and. mpisize/=2) error stop 'NSCBC physics probe supports NP1/2'
    call get_environment_variable('ASTR_NSCBC_PROBE',mode,status=istat)
    if(istat/=0) error stop 'Missing ASTR_NSCBC_PROBE'
    istat=cudaGetDeviceCount(device_count)
    if(istat/=cudaSuccess .or. device_count<1) error stop 'No CUDA device'
    istat=cudaSetDevice(mod(mpirank,device_count))
    if(istat/=cudaSuccess) error stop 'Cannot bind NSCBC probe device'
    im=8; jm=8; km=8; gamma=1.4e0_real_kind; mach=1.e0_real_kind
    lihomo=.false.; ljhomo=.true.; lkhomo=.true.
    mpileft=mpirank-1; mpiright=mpirank+1
    if(mpirank==0) mpileft=MPI_PROC_NULL
    if(mpirank==mpisize-1) mpiright=MPI_PROC_NULL
    allocate(state(-hm:im+hm,-hm:jm+hm,-hm:km+hm,5), &
             density(-hm:im+hm,-hm:jm+hm,-hm:km+hm), &
             velocity(-hm:im+hm,-hm:jm+hm,-hm:km+hm,3), &
             pressure(-hm:im+hm,-hm:jm+hm,-hm:km+hm), &
             temperature(-hm:im+hm,-hm:jm+hm,-hm:km+hm), &
             jacobian(-hm:im+hm,-hm:jm+hm,-hm:km+hm), &
             metric(-hm:im+hm,-hm:jm+hm,-hm:km+hm,3,3), &
             flux(-hm:im+hm,-hm:jm+hm,-hm:km+hm),rhs(0:im,0:jm,0:km,5))
    allocate(q_d(-hm:im+hm,-hm:jm+hm,-hm:km+hm,5), &
             rho_d(-hm:im+hm,-hm:jm+hm,-hm:km+hm), &
             vel_d(-hm:im+hm,-hm:jm+hm,-hm:km+hm,3), &
             prs_d(-hm:im+hm,-hm:jm+hm,-hm:km+hm), &
             tmp_d(-hm:im+hm,-hm:jm+hm,-hm:km+hm), &
             jacob_d(-hm:im+hm,-hm:jm+hm,-hm:km+hm), &
             dxi_d(-hm:im+hm,-hm:jm+hm,-hm:km+hm,3,3), &
             x_d(-hm:im+hm,-hm:jm+hm,-hm:km+hm,3), &
             flux_work_d(-hm:im+hm,-hm:jm+hm,-hm:km+hm), &
             qrhs_d(0:im,0:jm,0:km,5))
    metric=0.e0_real_kind; jacobian=1.e0_real_kind
    do m=1,3
      metric(:,:,:,m,m)=1.e0_real_kind
    enddo
    u=2.e0_real_kind; v=0.e0_real_kind; w=0.e0_real_kind; p=1.e0_real_kind/gamma
    target_p=p
    inlet_mode=index(trim(mode),'inlet_')==1
    top_mode=index(trim(mode),'top_')==1
    outlet_mode=index(trim(mode),'out_')==1
    backflow_mode=index(trim(mode),'out_backflow')==1
    if(inlet_mode .or. outlet_mode .or. top_mode) target_p=p-.01e0_real_kind
    if(index(trim(mode),'_uniform')>0) target_p=p
    select case(trim(mode))
    case('inlet_entropy')
      u=.2e0_real_kind; target_p=p
    case('inlet_sub','out_sub','out_uniform')
      u=.2e0_real_kind
    case('inlet_reverse')
      u=-.2e0_real_kind
    case('inlet_grazing','out_grazing')
      u=0.e0_real_kind
    case('inlet_out','inlet_out_gradient')
      u=-2.e0_real_kind
    case('out_backflow','out_backflow_uniform','out_backflow_gradient','out_backflow_pout')
      u=-.2e0_real_kind; v=.1e0_real_kind; w=-.05e0_real_kind
    case('out_backflow_sup')
      u=-2.e0_real_kind
    case('out_backflow_nearzero')
      u=-1.e-9_real_kind
    case('out_backflow_sonic')
      u=-1.e0_real_kind
    case('out_backflow_sonic_in')
      u=-1.e0_real_kind-1.e-9_real_kind
    case('out_backflow_sonic_out')
      u=-1.e0_real_kind+1.e-9_real_kind
    case('out_tangent')
      u=.2e0_real_kind; v=10.e0_real_kind
    case('top_sub','top_uniform')
      u=10.e0_real_kind; v=.2e0_real_kind
    case('top_sup','top_sup_gradient')
      u=10.e0_real_kind; v=2.e0_real_kind
    case('top_in')
      u=10.e0_real_kind; v=-2.e0_real_kind
    case('top_subin')
      u=10.e0_real_kind; v=-.2e0_real_kind
    case('top_grazing')
      u=10.e0_real_kind; v=0.e0_real_kind
    case('joint')
      u=2.e0_real_kind; v=2.e0_real_kind; w=.3e0_real_kind
    end select
    npdcj=3; npdck=3; xmin=0.e0_real_kind; xmax=8.e0_real_kind
    roinf=1.e0_real_kind; uinf=u; vinf=v; winf=w; pinf=target_p; pout=1.e0_real_kind
    if(backflow_mode.and.trim(mode)/='out_backflow_uniform') then
      uinf=.4e0_real_kind; vinf=.03e0_real_kind; winf=.02e0_real_kind
    endif
    if(trim(mode)=='out_backflow_pout') pout=.8e0_real_kind
    target_p=pinf*pout
    if(trim(mode)=='owner') then
      u=.5e0_real_kind
      if(mpirank<mpisize-1) u=10.e0_real_kind
    endif
    axis=0
    if(trim(mode)=='transverse_y') then
      axis=2; v=.3e0_real_kind
    elseif(trim(mode)=='transverse_z') then
      axis=3; w=.3e0_real_kind
    endif
    do k=-hm,km+hm
    do j=-hm,jm+hm
    do i=-hm,im+hm
      r=1.e0_real_kind
      if(trim(mode)=='inlet_entropy') r=1.01e0_real_kind
      if(trim(mode)=='sign') r=r+.01e0_real_kind*(i+im*mpirank)
      if(axis==2) r=r+.01e0_real_kind*j
      if(axis==3) r=r+.01e0_real_kind*k
      if(trim(mode)=='joint') r=r+.001e0_real_kind*(i+im*mpirank)+.002e0_real_kind*j+.003e0_real_kind*k
      density(i,j,k)=r; pressure(i,j,k)=p
      if(trim(mode)=='out_sup_gradient' .or. trim(mode)=='inlet_out_gradient' .or. &
         trim(mode)=='out_backflow_gradient') &
        pressure(i,j,k)=p+.001e0_real_kind*(i+im*mpirank)
      if(trim(mode)=='top_sup_gradient') pressure(i,j,k)=p+.001e0_real_kind*j
      temperature(i,j,k)=gamma*pressure(i,j,k)/r
      velocity(i,j,k,:)=[u,v,w]
      state(i,j,k,:)=[r,r*u,r*v,r*w,pressure(i,j,k)/(gamma-1.e0_real_kind)+.5e0_real_kind*r*(u*u+v*v+w*w)]
    enddo
    enddo
    enddo
    q_d=state; rho_d=density; vel_d=velocity; prs_d=pressure; tmp_d=temperature
    dxi_d=metric; jacob_d=jacobian; qrhs_d=0.e0_real_kind; x_d=0.e0_real_kind
    if(trim(mode)=='owner') then
      call gpu_nscbc_outflow_mach2(reported)
      error=abs(reported-.25e0_real_kind)
      write(*,'(A,I0,A,ES25.16)') 'NSCBC_OWNER rank=',mpirank,' mach2=',reported
    elseif(inlet_mode .or. outlet_mode .or. top_mode) then
      expected=0.e0_real_kind
      css=sqrt(gamma*p/density(0,0,0))
      enthalpy=css*css/(gamma-1.e0_real_kind)+.5e0_real_kind*(u*u+v*v+w*w)
      if(inlet_mode) then
        call apply_nscbc_inflow_x_rhs_gpu(100.e0_real_kind)
        rate=.25e0_real_kind*css/8.e0_real_kind
        select case(trim(mode))
        case('inlet_entropy')
          expected=-rate*.01e0_real_kind*[1.e0_real_kind,u,v,w,.5e0_real_kind*(u*u+v*v+w*w)]
        case('inlet_sup')
          expected(5)=-rate*(p-target_p)/(gamma-1.e0_real_kind)
        case('inlet_sub')
          ! Subsonic x- keeps the outgoing minus-acoustic contribution.
          expected=-rate*(p-target_p)/css**2* &
            ([-1.e0_real_kind,-u,-v,-w,-.5e0_real_kind*(u*u+v*v+w*w)] + &
             .5e0_real_kind*[1.e0_real_kind,u+css,v,w,enthalpy+css*u])
        case('inlet_out_gradient')
          expected=-.001e0_real_kind*[0.e0_real_kind,1.e0_real_kind,0.e0_real_kind,0.e0_real_kind,gamma*u/(gamma-1.e0_real_kind)]
        case('inlet_reverse','inlet_grazing')
          expected=-rate*(p-target_p)/css**2*.5e0_real_kind*[1.e0_real_kind,u+css,v,w,enthalpy+css*u]
        end select
        rhs=qrhs_d
        error=0.e0_real_kind
        if(mpirank==0) error=maxval(abs(rhs(0,jm/2,km/2,:)-expected))
      elseif(outlet_mode) then
        call apply_nscbc_x_rhs_gpu(100.e0_real_kind,100.e0_real_kind)
        local_p=pressure(im,jm/2,km/2)
        r=density(im,jm/2,km/2)
        css=sqrt(gamma*local_p/r)
        enthalpy=css*css/(gamma-1.e0_real_kind)+.5e0_real_kind*(u*u+v*v+w*w)
        if(u<css) then
          rate=3.75e0_real_kind*max(0.e0_real_kind,1.e0_real_kind-(u/css)**2)*css/8.e0_real_kind
          expected=-rate*(local_p-target_p)/css**2*[1.e0_real_kind,u-css,v,w,enthalpy-css*u]
        endif
        if(backflow_mode) then
          qtarget=[roinf*pout,roinf*pout*uinf,roinf*pout*vinf,roinf*pout*winf, &
            target_p/(gamma-1.e0_real_kind)+.5e0_real_kind*roinf*pout*(uinf*uinf+vinf*vinf+winf*winf)]
          delta=state(im,jm/2,km/2,:)-qtarget
          call acoustic_projections(delta,r,u,v,w,css,gamma,plus,minus)
          back_rate=.25e0_real_kind*max(-u,0.e0_real_kind)/8.e0_real_kind
          plus_rate=.25e0_real_kind*max(-u-css,0.e0_real_kind)/8.e0_real_kind
          expected=expected-back_rate*(delta-plus)-plus_rate*plus
          if(trim(mode)=='out_backflow_gradient') then
            normal_derivative=.001e0_real_kind*[0.e0_real_kind,1.e0_real_kind,0.e0_real_kind, &
              0.e0_real_kind,gamma*u/(gamma-1.e0_real_kind)]
            call acoustic_projections(normal_derivative,r,u,v,w,css,gamma,plus,minus)
            expected=expected-plus
          endif
        endif
        if(trim(mode)=='out_sup_gradient') &
          expected=-.001e0_real_kind*[0.e0_real_kind,1.e0_real_kind,0.e0_real_kind,0.e0_real_kind,gamma*u/(gamma-1.e0_real_kind)]
        rhs=qrhs_d
        error=0.e0_real_kind
        if(mpirank==mpisize-1) then
          do m=1,5
            error=max(error,maxval(abs(rhs(im,:,:,m)-expected(m))))
          enddo
        else
          error=maxval(abs(rhs(im,:,:,:)))
        endif
        allocate(checked_state,mold=state)
        checked_state=q_d
        if(any(checked_state/=state)) error=huge(1.e0_real_kind)
        deallocate(checked_state)
      else
        nblocks=((im+1)*(km+1)+255)/256
        r=1.e0_real_kind
        rate=target_p/(gamma-1.e0_real_kind)+.5e0_real_kind*(u*u+v*v+w*w)
        call nscbc_farfield_y_upper_rhs_kernel<<<nblocks,256>>>( &
          im,jm,km,hm,3,3,gamma,mach,0.e0_real_kind,8.e0_real_kind,target_p, &
          r,u,v,w,rate,r,u,v,w,rate,0.e0_real_kind,0,0,100.e0_real_kind,1)
        call sync_after_kernel('NSCBC uniform top policy')
        if(v<=-css) then
          expected(5)=-.25e0_real_kind*css/8.e0_real_kind*(p-target_p)/(gamma-1.e0_real_kind)
        elseif(v<0.e0_real_kind) then
          rate=.25e0_real_kind*css/8.e0_real_kind
          expected=-rate*(p-target_p)/css**2* &
            ([-1.e0_real_kind,-u,-v,-w,-.5e0_real_kind*(u*u+v*v+w*w)] + &
             .5e0_real_kind*[1.e0_real_kind,u,v-css,w,enthalpy-css*v])
        elseif(v<css) then
          rate=.25e0_real_kind*(1.e0_real_kind-(v/css)**2)*css/8.e0_real_kind
          expected=-rate*(p-target_p)/css**2*[1.e0_real_kind,u,v-css,w,enthalpy-css*v]
        endif
        if(trim(mode)=='top_sup_gradient') &
          expected=-.001e0_real_kind*[0.e0_real_kind,0.e0_real_kind,1.e0_real_kind,0.e0_real_kind,gamma*v/(gamma-1.e0_real_kind)]
        rhs=qrhs_d
        error=maxval(abs(rhs(im/2,jm,km/2,:)-expected))
      endif
    elseif(trim(mode)=='joint') then
      npdci=4
      if(mpisize==2) npdci=merge(1,2,mpirank==0)
      npdcj=4
      apply_right=merge(1,0,mpirank==mpisize-1)
      nblocks=((jm+1)*(km+1)+255)/256
      call nscbc_outflow_x_rhs_kernel<<<nblocks,256>>>(im,jm,km,hm,npdcj,3,gamma,mach, &
        0.e0_real_kind,8.e0_real_kind,roinf,uinf,vinf,winf,p,1.e0_real_kind,0.e0_real_kind,apply_right)
      call sync_after_kernel('NSCBC joint x face')
      rate=p/(gamma-1.e0_real_kind)+.5e0_real_kind*(u*u+v*v+w*w)
      nblocks=((im+1)*(km+1)+255)/256
      call nscbc_farfield_y_upper_rhs_kernel<<<nblocks,256>>>( &
        im,jm,km,hm,npdci,3,gamma,mach,0.e0_real_kind,8.e0_real_kind,p, &
        1.e0_real_kind,u,v,w,rate,1.e0_real_kind,u,v,w,rate,0.e0_real_kind,0,0,0.e0_real_kind,1)
      call sync_after_kernel('NSCBC joint y face')
      expected=-(.001e0_real_kind*u+.002e0_real_kind*v+.003e0_real_kind*w)*[1.e0_real_kind,u,v,w,.5e0_real_kind*(u*u+v*v+w*w)]
      rhs=qrhs_d
      error=maxval(abs(rhs(im/2,jm,km/2,:)-expected))
      if(apply_right/=0) then
        error=max(error,maxval(abs(rhs(im,jm/2,km/2,:)-expected)))
        error=max(error,maxval(abs(rhs(im,jm,km/2,:)-expected)))
      endif
    elseif(trim(mode)=='sign' .or. axis/=0) then
      nblocks=((jm+1)*(km+1)+255)/256
      call nscbc_outflow_x_rhs_kernel<<<nblocks,256>>>(im,jm,km,hm,3,3,gamma,mach, &
        0.e0_real_kind,8.e0_real_kind,roinf,uinf,vinf,winf,p,1.e0_real_kind,4.e0_real_kind,1)
      call sync_after_kernel('NSCBC physics outflow')
      rhs=qrhs_d
      if(axis==0) then
        expected=-.01e0_real_kind*u*[1.e0_real_kind,u,v,w,.5e0_real_kind*(u*u+v*v+w*w)]
      else
        expected=-.003e0_real_kind*[1.e0_real_kind,u,v,w,.5e0_real_kind*(u*u+v*v+w*w)]
      endif
      error=maxval(abs(rhs(im,jm/2,km/2,:)-expected))
      if(axis/=0 .and. error<=2.e-10_real_kind) then
        ! The bounded transverse kernels must not write a physical x face.
        do m=1,5
          do k=-hm,km+hm
          do j=-hm,jm+hm
            if(axis==2) flux(:,j,k)=expected(m)*(-real(j,real_kind)-.5e0_real_kind)
            if(axis==3) flux(:,j,k)=expected(m)*(-real(k,real_kind)-.5e0_real_kind)
          enddo
          enddo
          flux_work_d=flux
          if(axis==2) then
            block=dim3(32,16,1); grid=dim3(1,1,km+1)
            call explicit_upwind_rhs_y_physical_global_kernel<<<grid,block>>>( &
                 im,jm,km,1,im-1,0,jm,0,km,m)
          else
            block=dim3(64,1,8); grid=dim3(1,jm+1,(km+8)/8)
            call explicit_upwind_rhs_z_xyphysical_global_kernel<<<grid,block>>>( &
                 im,jm,km,1,im-1,0,jm,0,km,m)
          endif
          call sync_after_kernel('NSCBC transverse ownership')
        enddo
        rhs=qrhs_d
        error=max(error,maxval(abs(rhs(im,jm/2,km/2,:)-expected)))
        error=max(error,maxval(abs(rhs(im/2,jm/2,km/2,:)-expected)))
      endif
    else
      error stop 'Unknown NSCBC physics probe mode'
    endif
    if(.not.ieee_is_finite(error)) error=huge(1.e0_real_kind)
    call MPI_Allreduce(error,global_error,1,mpi_real_type,MPI_MAX,MPI_COMM_WORLD,ierr)
    if(mpirank==0) write(*,'(A,1X,A,1X,ES25.16)') 'NSCBC_PHYSICS_MAX_ABS',trim(mode),global_error
    if(global_error>2.e-10_real_kind) then
      call MPI_Abort(MPI_COMM_WORLD,1,ierr)
    endif
    if(mpirank==0) print*,'NSCBC_PHYSICS_PASS ',trim(mode)
    deallocate(q_d,rho_d,vel_d,prs_d,tmp_d,qrhs_d,jacob_d,dxi_d,flux_work_d,x_d)
  end subroutine check_nscbc_physics_gpu

  subroutine acoustic_projections(delta,r,u,v,w,a,gamma,plus,minus)
    real(real_kind),intent(in) :: delta(5),r,u,v,w,a,gamma
    real(real_kind),intent(out) :: plus(5),minus(5)
    real(real_kind) :: dp,du,h
    ! Independent primitive-variable projectors, not the production eigenmatrix.
    du=(delta(2)-u*delta(1))/r
    dp=(gamma-1.e0_real_kind)*(delta(5)-u*delta(2)-v*delta(3)-w*delta(4)+ &
      .5e0_real_kind*(u*u+v*v+w*w)*delta(1))
    h=a*a/(gamma-1.e0_real_kind)+.5e0_real_kind*(u*u+v*v+w*w)
    plus=(dp+r*a*du)/(2.e0_real_kind*a*a)*[1.e0_real_kind,u+a,v,w,h+a*u]
    minus=(dp-r*a*du)/(2.e0_real_kind*a*a)*[1.e0_real_kind,u-a,v,w,h-a*u]
  end subroutine acoustic_projections
end module nscbc_physics_probe
